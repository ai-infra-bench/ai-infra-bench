>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    \"\"\"Return the separator used between audio-chunk transcripts.\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    return \"\" if language and language.lower() in no_space_languages else \" \"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">def _join_asr_chunk_text(left: str, right: str, separator: str) -> str:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    \"\"\"Join adjacent audio chunks without duplicating existing whitespace.\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    if not left:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        return right</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    if not right:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        return left</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    if not separator or left[-1].isspace() or right[0].isspace():</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        return left + right</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    return left + separator + right</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">@@</span><s