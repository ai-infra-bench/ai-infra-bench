dev/null</span><span style=\"color:#686D67\">;</span><span style=\"color:#3F6D55\"> then</span><span style=\"color:#3F6D55\"> break</span><span style=\"color:#686D67\">;</span><span style=\"color:#3F6D55\"> fi</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">  if</span><span style=\"color:#806D1A\"> python</span><span style=\"color:#8D4B43\"> -</span><span style=\"color:#3F6D55\"> &#x3C;&#x3C;</span><span style=\"color:#8D4B43\">'PY'</span><span style=\"color:#3F6D55\"> ></span><span style=\"color:#8D4B43\">/dev/null</span><span style=\"color:#806D1A\"> 2</span><span style=\"color:#303638\">></span><span style=\"color:#686D67\">&#x26;</span><span style=\"color:#806D1A\">1</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">import httpx</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">raise SystemExit(</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    0 if httpx.get(\"http://127.0.0.1:18000/health\", timeout=0.5).status_code == 200</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    else 1</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">)</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">PY</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">  then</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    healthy</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">1</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    break</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">  fi</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  sleep</span><span style=\"color:#2D6F7A\"> 0.1</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">done</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#303638\">enoent</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A