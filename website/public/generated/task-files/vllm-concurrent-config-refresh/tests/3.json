s=\"line\"><span style=\"color:#8D4B43\">        \"temperature\": 0,</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    },</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    timeout=30,</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">)</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">assert response.status_code == 200, response.text</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">payload = response.json()</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">assert len(payload[\"choices\"]) == 1</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">assert payload[\"usage\"][\"completion_tokens\"] > 0</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">print({\"ready_workers\": 4, \"faults\": 2, \"http_status\": response.status_code})</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">PY</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#806D1A\">kill</span><span style=\"color:#8D4B43\"> -TERM</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$</span><span style=\"color:#8D4B43\">server_pid\"</span><span style=\"color:#3F6D55\"> 2></span><span style=\"color:#8D4B43\">/dev/null</span><span style=\"color:#3F6D55\"> ||</span><span style=\"color:#806D1A\"> true</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">wait</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$</span><span style=\"color:#8D4B43\">server_pid\"</span><span style=\"color:#3F6D55\"> 2></span><span style=\"color:#8D4B43\">/dev/null</span><span style=\"color:#3F6D55\"> ||</span><span style=\"color:#806D1A\"> true</span></span>\n<span class=\"line\"><span style=\"color:#303638\">server_pid</span><span style=\"color:#3F6D55\">=</span></span></code></pre>","lineCount":94}
