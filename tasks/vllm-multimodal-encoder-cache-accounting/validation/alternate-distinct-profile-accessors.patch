+@pytest.mark.parametrize("num_embeds", [0, 8])
+def test_profile_caches_only_encoder_outputs(monkeypatch, num_embeds):
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.supports_mm_inputs = True
+    runner.model_config = SimpleNamespace(multimodal_config=None)
+    runner.mm_budget = SimpleNamespace(
+        get_encoder_budget=lambda: 8,
+        get_modality_with_max_tokens=lambda: "image",
+        max_items_per_batch_by_modality={"image": int(num_embeds > 0)},
+        max_tokens_by_modality={"image": num_embeds},
+    )
+    runner.model = SimpleNamespace(
+        embed_multimodal=Mock(return_value=[torch.ones(num_embeds, 4)]),
+    )
+    runner._get_mm_dummy_batch = Mock(return_value={})
+    runner.encoder_cache = {}
+    runner.max_num_tokens = 128
+    runner._sync_device = Mock()
+
+    def count_elements(value):
+        if isinstance(value, torch.Tensor):
+            return value.numel()
+        values = value.values() if isinstance(value, dict) else value
+        return sum(count_elements(item) for item in values)
+
+    def dummy_run(*args, **kwargs):
+        assert count_elements(runner.encoder_cache) == num_embeds * 4
+        return None, None
+
+    runner._dummy_run = dummy_run
+    monkeypatch.setattr(
+        "vllm.v1.worker.gpu_model_runner.get_pp_group",
+        lambda: SimpleNamespace(is_last_rank=False),
+    )
+    GPUModelRunner.profile_run(runner)
+    assert runner.model.embed_multimodal.call_count == int(num_embeds > 0)
+
