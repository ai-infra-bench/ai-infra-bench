+@pytest.mark.parametrize("shift", [0, 1, 3])
+@pytest.mark.parametrize("empty_mask", [False, True])
+def test_encode_cache_and_partial_reads(monkeypatch, shift, empty_mask):
+    positions = [
+        PlaceholderRange(
+            offset=1,
+            length=0,
+            is_embed=torch.empty(0, dtype=torch.bool) if empty_mask else None,
+        ),
+        sparse_position(3),
+        PlaceholderRange(offset=105, length=3),
+        PlaceholderRange(
+            offset=110, length=5, is_embed=torch.zeros(5, dtype=torch.bool)
+        ),
+    ]
+    request = make_request(positions)
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.requests = {request.request_id: request}
+    runner.input_batch = SimpleNamespace(req_ids=[request.request_id])
+    runner.encoder_cache = {}
+    runner.is_multimodal_pruning_enabled = False
+    runner.device = torch.device("cpu")
+    runner.pin_memory = False
+    output_rows = [torch.arange(8).view(-1, 1), torch.arange(100, 103).view(-1, 1)]
+    runner.model = SimpleNamespace(embed_multimodal=Mock(return_value=output_rows))
+    runner.maybe_save_ec_to_connector = Mock()
+    runner._batch_mm_kwargs_from_scheduler = Mock(
+        return_value=(
+            [object(), object()],
+            [(request.mm_features[i].identifier, positions[i]) for i in (1, 2)],
+        )
+    )
+    monkeypatch.setattr(
+        "vllm.v1.worker.gpu_model_runner.group_mm_kwargs_by_modality",
+        lambda *args, **kwargs: [("image", 2, {})],
+    )
+    GPUModelRunner._execute_mm_encoder(runner, Mock())
+
+    # Construct expected prompt positions independently of the cache layout.
+    expected = {3 + p: row for row, p in enumerate([10, 11, 20, 40, 60, 70, 80, 90])}
+    expected.update({105 + i: 100 + i for i in range(3)})
+    buffer = torch.empty(256, dtype=torch.bool)
+    runner.is_mm_embed = SimpleNamespace(cpu=buffer, copy_to_gpu=lambda n: buffer[:n])
+    for computed, count in [(0, 10), (10, 9), (22, 25), (85, 30), (0, 120), (108, 10)]:
+        request.num_computed_tokens = computed
+        scheduled = SimpleNamespace(
+            total_num_scheduled_tokens=count,
+            num_scheduled_tokens={request.request_id: count},
+        )
+        embeds, mask = GPUModelRunner._gather_mm_embeddings(runner, scheduled, shift)
+        window = range(computed + shift, computed + shift + count)
+        assert mask.tolist() == [p in expected for p in window]
+        rows = torch.cat(embeds).flatten().tolist() if embeds else []
+        assert rows == [expected[p] for p in window if p in expected]
+    runner.model.embed_multimodal.assert_called_once()
+
+    runner.encoder_cache.clear()
+    request.num_computed_tokens = 0
+    scheduled = SimpleNamespace(
+        total_num_scheduled_tokens=10,
+        num_scheduled_tokens={request.request_id: 10},
+    )
+    embeds, mask = GPUModelRunner._gather_mm_embeddings(runner, scheduled, shift)
+    assert embeds == []
+    assert not mask.any()
+
