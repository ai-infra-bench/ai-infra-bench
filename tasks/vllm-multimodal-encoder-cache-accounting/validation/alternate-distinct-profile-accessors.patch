diff --git a/tests/v1/worker/test_mm_encoder.py b/tests/v1/worker/test_mm_encoder.py
new file mode 100644
--- /dev/null
+++ b/tests/v1/worker/test_mm_encoder.py
@@ -0,0 +1,362 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Encoder accounting and chunked reads with sparse prompt placeholders."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from vllm.multimodal.inputs import MultiModalFeatureSpec, PlaceholderRange
+from vllm.multimodal.profiling import MultiModalProfiler
+from vllm.multimodal.registry import MultiModalRegistry
+from vllm.sampling_params import SamplingParams
+from vllm.v1.core.encoder_cache_manager import (
+    EncoderCacheManager,
+    compute_encoder_budget,
+)
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.request import Request
+from vllm.v1.worker.gpu_model_runner import GPUModelRunner
+from vllm.v1.worker.utils import MultiModalBudget
+
+pytestmark = pytest.mark.cpu_test
+
+
+def make_request(positions, request_id="req"):
+    return Request(
+        request_id=request_id,
+        prompt_token_ids=[1] * 256,
+        sampling_params=SamplingParams(max_tokens=1),
+        pooling_params=None,
+        eos_token_id=None,
+        mm_features=[
+            MultiModalFeatureSpec(
+                data=None,
+                modality="image",
+                identifier=f"{request_id}-{i}",
+                mm_position=pos,
+            )
+            for i, pos in enumerate(positions)
+        ],
+    )
+
+
+def sparse_position(offset=0):
+    mask = torch.zeros(100, dtype=torch.bool)
+    mask[[10, 11, 20, 40, 60, 70, 80, 90]] = True
+    return PlaceholderRange(offset=offset, length=100, is_embed=mask)
+
+
+def make_scheduler(capacity, disable_chunked=False):
+    scheduler = Scheduler.__new__(Scheduler)
+    scheduler.encoder_cache_manager = EncoderCacheManager(capacity)
+    scheduler.ec_connector = None
+    scheduler.is_encoder_decoder = False
+    scheduler.scheduler_config = SimpleNamespace(
+        disable_chunked_mm_input=disable_chunked,
+    )
+    return scheduler
+
+
+def test_sparse_cache_capacity_reuse_and_eviction():
+    request = make_request([sparse_position()])
+    cache = EncoderCacheManager(8)
+    assert not cache.can_allocate(request, 0, 7, 0)
+    assert cache.can_allocate(request, 0, 8, 0)
+    cache.allocate(request, 0)
+    assert cache.num_free_slots == 0
+    assert cache.num_freeable_slots == 0
+    cache.free(request)
+    assert cache.num_freeable_slots == 8
+    assert cache.check_and_update_cache(request, 0)
+    assert cache.num_freeable_slots == 0
+    cache.free(request)
+
+    other = make_request([PlaceholderRange(offset=0, length=8)], "other")
+    assert cache.can_allocate(other, 0, 8, 0)
+    cache.allocate(other, 0)
+    assert cache.get_freed_mm_hashes() == [request.mm_features[0].identifier]
+    assert cache.num_free_slots == 0
+    cache.free(other)
+    assert cache.num_freeable_slots == 8
+
+
+@pytest.mark.parametrize("capacity,budget", [(0, 0), (8, 0), (0, 8), (8, 8)])
+@pytest.mark.parametrize("computed,new,shift", [(0, 10, 0), (21, 10, 5), (91, 9, 1)])
+@pytest.mark.parametrize("disable_chunked", [False, True])
+def test_text_only_windows_need_no_encoder(
+    capacity, budget, computed, new, shift, disable_chunked
+):
+    scheduler = make_scheduler(capacity, disable_chunked)
+    request = make_request([sparse_position()])
+    assert scheduler._try_schedule_encoder_inputs(
+        request, computed, new, budget, shift
+    ) == ([], new, budget, [])
+    assert scheduler.encoder_cache_manager.get_cached_input_ids(request) == set()
+
+
+@pytest.mark.parametrize("capacity,budget", [(0, 8), (8, 0), (7, 8), (8, 7)])
+def test_sparse_window_reserves_entire_output(capacity, budget):
+    scheduler = make_scheduler(capacity)
+    request = make_request([sparse_position()])
+    # This window consumes just one row, but all eight must fit.
+    assert scheduler._try_schedule_encoder_inputs(request, 0, 11, budget) == (
+        [],
+        10,
+        budget,
+        [],
+    )
+    assert scheduler._try_schedule_encoder_inputs(request, 10, 1, budget) == (
+        [],
+        0,
+        budget,
+        [],
+    )
+
+
+def test_later_windows_encode_once_and_reuse():
+    scheduler = make_scheduler(8)
+    request = make_request([sparse_position()])
+    assert scheduler._try_schedule_encoder_inputs(request, 0, 10, 0) == (
+        [],
+        10,
+        0,
+        [],
+    )
+    assert scheduler._try_schedule_encoder_inputs(request, 10, 1, 8) == (
+        [0],
+        1,
+        0,
+        [],
+    )
+    scheduler.encoder_cache_manager.allocate(request, 0)
+    for computed in (11, 20, 40, 90):
+        request.num_computed_tokens = computed
+        scheduler._free_encoder_inputs(request)
+        assert scheduler._try_schedule_encoder_inputs(request, computed, 1, 0) == (
+            [],
+            1,
+            0,
+            [],
+        )
