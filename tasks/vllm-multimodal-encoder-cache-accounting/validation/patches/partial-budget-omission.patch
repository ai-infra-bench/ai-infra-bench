@@ -170,11 +170,47 @@ class PlaceholderRange:
     """

     def get_num_embeds(self) -> int:
+        """The number of encoder embedding rows this placeholder consumes.
+
+        A placeholder spans `length` positions in the prompt, but only the
+        positions selected by `is_embed` are backed by a row of encoder
+        output. Without a mask, every position is backed by a row.
+        """
         if self.is_embed is None:
             return self.length

         return int(self.is_embed.sum().item())

+    def get_num_embeds_before(self, prompt_index: int) -> int:
+        """The number of embedding rows before prompt position `prompt_index`.
+
+        `prompt_index` is an absolute prompt position and is clamped to this
+        placeholder, so the result is always in `[0, get_num_embeds()]`.
+        """
+        num_positions = min(max(prompt_index - self.offset, 0), self.length)
+        if self.is_embed is None:
+            return num_positions
+
+        return int(self.is_embed[:num_positions].sum().item())
+
+    def get_embeds_range(self, prompt_start: int, prompt_end: int) -> tuple[int, int]:
+        """Map a prompt range to the embedding rows it is backed by.
+
+        Prompt space and embedding space are distinct coordinate systems: the
+        prompt subrange `[prompt_start, prompt_end)` (absolute positions,
+        clamped to this placeholder) selects the contiguous embedding subrange
+        `[start, end)` of this item's encoder output.
+
+        For example, `PlaceholderRange(offset=10, length=20)` with a mask whose
+        true positions are `10, 16, 17, 21` maps the prompt range `[15, 22)` to
+        the embedding range `(1, 4)`.
+
+        Empty prompt ranges map to an empty embedding range.
+        """
+        start = self.get_num_embeds_before(prompt_start)
+        end = self.get_num_embeds_before(max(prompt_end, prompt_start))
+        return start, end
+
