+
+# Valid transport and envelopes, but no connector operations are performed.
+import socket as _sock, sys as _sys, json as _json, os as _os
+_ch = _sock.socket(fileno=int(_sys.argv[1]))
+_ch.send(_json.dumps({"ready": True}).encode())
+while _packet := _ch.recv(1 << 20):
+    _request = _json.loads(_packet)
+    _value = ({"stored": _request["key"]} if _request["op"] == "config" else
+              {"instance": 42, "role": _request.get("role", "WORKER"), "plugin": True})
+    _ch.send(_json.dumps({"id": _request["id"], "value": _value, "error": None, "events": []}).encode())
+_os._exit(0)
