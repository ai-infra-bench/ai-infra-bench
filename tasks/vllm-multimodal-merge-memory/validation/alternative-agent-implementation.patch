+def _merge_multimodal_embeddings_by_index(
+    inputs_embeds: torch.Tensor,
+    mm_embeds_flat: torch.Tensor,
+    is_multimodal: torch.Tensor,
+    multimodal_embeddings: NestedTensors,
+) -> torch.Tensor:
+    """
+    Merge multimodal embeddings when the placeholder mask lives on a different
+    device than `inputs_embeds` (e.g. a CPU mask against CUDA embeddings).
+
+    The placeholder positions are resolved to indices on the mask's device
+    (typically CPU) so that only a compact index tensor is transferred to the
+    embedding device. This avoids copying the full request-length mask, avoids
+    a stream synchronization, and keeps temporary device storage proportional
+    to the number of placeholders rather than the request length.
+    """
+    # `nonzero` runs on the mask's device (CPU during GPU serving), so this
+    # does not synchronize the embedding device's stream.
+    placeholder_indices = is_multimodal.flatten().nonzero().squeeze(-1)
+
+    num_expected_tokens = placeholder_indices.numel()
+    num_actual_tokens = len(mm_embeds_flat)
+    if num_actual_tokens != num_expected_tokens:
+        expr = _embedding_count_expression(multimodal_embeddings)
+        raise ValueError(
+            f"Attempted to assign {expr} = {num_actual_tokens} "
+            f"multimodal tokens to {num_expected_tokens} placeholders"
+        )
+
+    # Pin the small index tensor when possible so the host-to-device copy is
+    # truly asynchronous and does not force a stream synchronization.
+    if placeholder_indices.device.type == "cpu" and is_pin_memory_available():
+        placeholder_indices = placeholder_indices.pin_memory()
+    placeholder_indices = placeholder_indices.to(
+        inputs_embeds.device, non_blocking=True
+    )
+
+    # `index_copy_` overwrites the placeholder rows in position order, matching
+    # the row-major order that `masked_scatter_` consumes `mm_embeds_flat` in.
+    inputs_embeds.index_copy_(0, placeholder_indices, mm_embeds_flat)
+
+    return inputs_embeds
+
+
