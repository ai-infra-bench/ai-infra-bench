+    @staticmethod
+    def _is_system_template_rejection(error: ValueError) -> bool:
+        """Return whether rendering rejected a non-leading system message."""
+        return "system message must be" in str(error).lower()
+
+    @staticmethod
+    def _retry_request_with_leading_system(
+        request: ChatCompletionRequest,
+    ) -> ChatCompletionRequest:
+        """Build a retry request with all system text in one leading message."""
+        payload = request.model_dump()
+        system_parts: list[str] = []
+        remaining_messages: list[dict[str, Any]] = []
+
+        for message in payload["messages"]:
+            if message["role"] != "system":
+                remaining_messages.append(message)
+                continue
+            content = message.get("content")
+            if isinstance(content, str) and content:
+                system_parts.append(content)
+
+        if not system_parts:
+            return request
+
+        payload["messages"] = [
+            {"role": "system", "content": "\n\n".join(system_parts)},
+            *remaining_messages,
+        ]
+        return ChatCompletionRequest.model_validate(payload)
+
