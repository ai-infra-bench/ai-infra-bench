+
+    async def render_chat_request(
+        self, request: ChatCompletionRequest,
+    ) -> "tuple[list[ConversationMessage], list[EngineInput]] | ErrorResponse":
+        # Keep adaptation at the Anthropic API boundary. Rendering retains the
+        # effective tokenizer template, runtime globals and request options.
+        try:
+            return await super().render_chat_request(request)
+        except ValueError:
+            messages = request.messages
+            if not any(msg["role"] == "system" for msg in messages[1:]):
+                raise
+            system = [msg for msg in messages if msg["role"] == "system"]
+            if not all(isinstance(msg.get("content", ""), str) for msg in system):
+                raise
+            leading = {
+                "role": "system",
+                "content": "\n\n".join(msg.get("content", "") for msg in system),
+            }
+            retry = request.model_copy(update={
+                "messages": [leading, *(msg for msg in messages if msg["role"] != "system")],
+            })
+            return await super().render_chat_request(retry)
 
