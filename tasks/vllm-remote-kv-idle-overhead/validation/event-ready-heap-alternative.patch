--- a/tests/v1/core/test_scheduler.py
+++ b/tests/v1/core/test_scheduler.py
@@ -3639,6 +3639,41 @@ def test_prepend_skipped_requests_order():
     assert list(scheduler.waiting) == expected_waiting_reqs
 
 
+def test_idle_tick_does_not_scale_with_remote_kv_blocked_requests():
+    scheduler = create_scheduler(max_num_seqs=16)
+    num_blocked = 32
+    requests = create_requests(num_requests=num_blocked + 1)
+    for request in requests:
+        scheduler.add_request(request)
+
+    # Simulate the state after async remote-KV loads have started for the
+    # leading requests: they remain in the public waiting queue but are no
+    # longer present in the ready heap. The last request, C, is runnable.
+    for request in requests[:num_blocked]:
+        popped = scheduler._pop_waiting_ready_request()
+        assert popped is request
+        request.status = RequestStatus.WAITING_FOR_REMOTE_KVS
+
+    runnable = requests[-1]
+    assert scheduler._ready_waiting_ids == {runnable.request_id}
+
+    update_mock = Mock(wraps=scheduler._update_waiting_for_remote_kv)
+    scheduler._update_waiting_for_remote_kv = update_mock
+
+    output = scheduler.schedule()
+
+    # A tick with no new remote-KV event must not poll every blocked request.
+    update_mock.assert_not_called()
+
+    # C makes progress while A and B retain their public FCFS positions and
+    # stay blocked until their transfer completion events arrive.
+    assert list(output.num_scheduled_tokens) == [runnable.request_id]
+    assert scheduler.running == [runnable]
+    assert [req.request_id for req in scheduler.waiting] == [
+        request.request_id for request in requests[:num_blocked]
+    ]
+
