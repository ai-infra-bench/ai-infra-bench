@@ -4048,3 +4048,64 @@ def test_eagle3_mm_encoder_cache_with_shift():
         f"shifted_end={scheduled_end_with_shift}) overlapping MM at "
         f"{start_pos}. The fix must schedule encoder inputs."
     )
+
+
+def test_idle_waiting_ticks_do_not_scan_remote_kv_blocked_requests(monkeypatch):
+    scheduler = create_scheduler(max_num_seqs=1)
+    blocked_requests = create_requests(
+        num_requests=32,
+        req_ids=[f"blocked-{i}" for i in range(32)],
+    )
+    runnable_request = create_requests(num_requests=1, req_ids=["runnable"])[0]
+
+    for request in blocked_requests:
+        scheduler.add_request(request)
+    scheduler.add_request(runnable_request)
+
+    # Put the remote-KV-blocked requests into the blocked view before the
+    # schedule tick so this test covers the steady-state idle path rather
+    # than the one-time lazy migration.
+    for request in blocked_requests:
+        request.status = RequestStatus.WAITING_FOR_REMOTE_KVS
+        scheduler.waiting.block_request(request)
+
+    update_calls = []
+
+    def fake_update_waiting_for_remote_kv(request):
+        update_calls.append(request.request_id)
+        return False
+
+    monkeypatch.setattr(
+        scheduler,
+        "_update_waiting_for_remote_kv",
+        fake_update_waiting_for_remote_kv,
+    )
+
+    scheduler.schedule()
+
+    assert update_calls == []
+    assert runnable_request.status == RequestStatus.RUNNING
+    assert scheduler.running == [runnable_request]
+
+
+def test_fcfs_order_preserved_across_remote_and_temporary_blockers():
+    scheduler = create_scheduler(max_num_seqs=1)
+    remote, temporary, runnable = create_requests(
+        num_requests=3,
+        req_ids=["remote", "temporary", "runnable"],
+    )
+
+    for request in (remote, temporary, runnable):
+        scheduler.add_request(request)
+
+    # The remote-KV blocker is older in FCFS order than the temporary blocker.
+    # If temporary blockers are reinserted with a new front order, they can
+    # incorrectly jump ahead of the remote-KV-blocked request.
+    remote.status = RequestStatus.WAITING_FOR_REMOTE_KVS
+    scheduler.waiting.block_request(remote)
+    temporary.status = RequestStatus.WAITING_FOR_FSM
+
+    scheduler.schedule()
+
+    assert runnable.status == RequestStatus.RUNNING
+    assert list(scheduler.waiting) == [remote, temporary]
