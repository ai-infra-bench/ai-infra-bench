+class RemoteKVAwareRequestQueue(RequestQueue):
+    """RequestQueue wrapper with a separate runnable view.
+
+    Remote-KV-blocked requests remain part of the queue's public ordering
+    and length, but are excluded from the runnable heap used by the
+    scheduler hot path.  Idle scheduler ticks therefore do not scan the
+    blocked population.
+    """
+
+    def __init__(self, policy: SchedulingPolicy) -> None:
+        if policy not in (SchedulingPolicy.FCFS, SchedulingPolicy.PRIORITY):
+            raise ValueError(f"Unknown scheduling policy: {policy}")
+        self.policy = policy
+        self._next_order = 0
+        self._next_entry_id = 0
+        self._all_requests: set[Request] = set()
+        self._runnable_requests: set[Request] = set()
+        self._blocked_requests: set[Request] = set()
+        self._order: dict[Request, int] = {}
+        self._entry_id: dict[Request, int] = {}
+        self._runnable_heap: list = []
+        self._blocked_heap: list = []
+
+    @property
+    def _is_fcfs(self) -> bool:
+        return self.policy == SchedulingPolicy.FCFS
+
+    def _new_tail_order(self) -> int:
+        self._next_order += 1
+        return self._next_order
+
+    def _new_front_order(self) -> int:
+        self._next_order -= 1
+        return self._next_order
+
+    def _ensure_order(self, request: Request, front: bool = False) -> None:
+        if request not in self._order:
+            self._order[request] = (
+                self._new_front_order() if front else self._new_tail_order()
+            )
+
+    def _make_entry(self, request: Request) -> tuple:
+        entry_id = self._next_entry_id
+        self._next_entry_id += 1
+        self._entry_id[request] = entry_id
+        if self._is_fcfs:
+            return (self._order[request], entry_id, request)
+        return (request, entry_id, request)
+
+    def _peek_member(self, runnable: bool) -> Request | None:
+        heap = self._runnable_heap if runnable else self._blocked_heap
+        members = (
+            self._runnable_requests if runnable else self._blocked_requests
+        )
+        while heap:
+            entry = heap[0]
+            request = entry[-1]
+            if request in members and self._entry_id.get(request) == entry[1]:
+                return request
+            heapq.heappop(heap)
+        return None
+
+    def _add_to_view(self, request: Request, runnable: bool) -> None:
+        self._all_requests.add(request)
+        self._ensure_order(request)
+        if runnable:
+            self._blocked_requests.discard(request)
+            self._runnable_requests.add(request)
+            heapq.heappush(self._runnable_heap, self._make_entry(request))
+        else:
+            self._runnable_requests.discard(request)
+            self._blocked_requests.add(request)
+            heapq.heappush(self._blocked_heap, self._make_entry(request))
+
+    def _remove(self, request: Request) -> None:
+        self._all_requests.discard(request)
+        self._runnable_requests.discard(request)
+        self._blocked_requests.discard(request)
+        self._order.pop(request, None)
+        self._entry_id.pop(request, None)
+
+    def _pop_member(self, runnable: bool) -> Request:
+        request = self._peek_member(runnable)
+        if request is None:
+            raise IndexError("pop from empty queue")
+        heap = self._runnable_heap if runnable else self._blocked_heap
+        heapq.heappop(heap)
+        self._remove(request)
+        return request
+
+    def _prepare_runnable_request(self) -> Request | None:
+        while True:
+            request = self._peek_member(runnable=True)
+            if request is None:
+                return None
+            if request.status == RequestStatus.WAITING_FOR_REMOTE_KVS:
+                self.block_request(request)
+                continue
+            return request
+
+    # Public queue API.
+
+    def add_request(self, request: Request) -> None:
+        self._add_to_view(request, runnable=True)
+
+    def pop_request(self) -> Request:
+        runnable = self._peek_member(runnable=True)
+        blocked = self._peek_member(runnable=False)
+        if runnable is None and blocked is None:
+            raise IndexError("pop from empty queue")
+        if blocked is None:
+            return self._pop_member(runnable=True)
+        if runnable is None:
+            return self._pop_member(runnable=False)
+        if self._is_fcfs:
+            if self._order[runnable] < self._order[blocked]:
+                return self._pop_member(runnable=True)
+            return self._pop_member(runnable=False)
+        if runnable < blocked:
+            return self._pop_member(runnable=True)
+        return self._pop_member(runnable=False)
+
+    def peek_request(self) -> Request:
+        runnable = self._peek_member(runnable=True)
+        blocked = self._peek_member(runnable=False)
+        if runnable is None and blocked is None:
+            raise IndexError("peek from empty queue")
+        if blocked is None:
+            return runnable
+        if runnable is None:
+            return blocked
+        if self._is_fcfs:
+            if self._order[runnable] < self._order[blocked]:
+                return runnable
+            return blocked
+        if runnable < blocked:
+            return runnable
+        return blocked
+
+    def prepend_request(self, request: Request) -> None:
+        self._all_requests.add(request)
+        self._order[request] = self._new_front_order()
+        self._blocked_requests.discard(request)
+        self._runnable_requests.add(request)
+        heapq.heappush(self._runnable_heap, self._make_entry(request))
+
+    def prepend_requests(self, requests: "RequestQueue") -> None:
+        for request in requests:
+            self._remove(request)
+            self.prepend_request(request)
+
+    def remove_request(self, request: Request) -> None:
+        self._remove(request)
+
+    def remove_requests(self, requests: Iterable[Request]) -> None:
+        for request in requests:
+            self._remove(request)
+
+    def __bool__(self) -> bool:
+        return bool(self._all_requests)
+
+    def __len__(self) -> int:
+        return len(self._all_requests)
+
+    def __iter__(self) -> Iterator[Request]:
+        if self._is_fcfs:
+            yield from sorted(self._all_requests, key=self._order.__getitem__)
+        else:
+            yield from sorted(self._all_requests)
+
+    def __getitem__(self, index):
+        return list(self)[index]
+
+    # Scheduler-facing runnable-only API.
+
+    def has_runnable_request(self) -> bool:
+        return self._prepare_runnable_request() is not None
+
+    def peek_runnable_request(self) -> Request:
+        request = self._prepare_runnable_request()
+        if request is None:
+            raise IndexError("peek from empty queue")
+        return request
+
+    def pop_runnable_request(self) -> Request:
+        request = self._prepare_runnable_request()
+        if request is None:
+            raise IndexError("pop from empty queue")
+        return self._pop_member(runnable=True)
+
+    def block_request(self, request: Request) -> None:
+        self._all_requests.add(request)
+        if request in self._blocked_requests:
+            return
+        self._ensure_order(request)
+        self._runnable_requests.discard(request)
+        self._blocked_requests.add(request)
+        heapq.heappush(self._blocked_heap, self._make_entry(request))
+
+    def unblock_request(self, request: Request) -> None:
+        self._all_requests.add(request)
+        if request in self._runnable_requests:
+            return
+        self._ensure_order(request)
+        self._blocked_requests.discard(request)
+        self._runnable_requests.add(request)
+        heapq.heappush(self._runnable_heap, self._make_entry(request))
