+    def reset_cache(self) -> bool:
+        """Reset the CPU prefix cache once all transfers have quiesced.
+
+        Store and load transfers hold references in the CPU/GPU block pools
+        until their completion is observed by the scheduler.  Resetting while
+        any such state is outstanding would either fail to clear the cache or
+        allow a late completion to repopulate it, so callers should retry when
+        this method returns ``False``.
+
+        Returns:
+            ``True`` when the CPU cache was reset, ``False`` when transfers or
+            temporary cache-hit pins are still outstanding.
+        """
+        if (
+            self._store_event_to_blocks
+            or self._store_event_pending_counts
+            or self._reqs_to_load
+            or self._pending_cpu_hits
+        ):
+            return False
+
+        # Keep scheduler state intact while any request still owns a GPU
+        # block.  The normal scheduler reset checks this first, but this guard
+        # also makes a direct connector reset safe.
+        if self._gpu_block_pool is not None:
+            num_used = self._gpu_block_pool.num_gpu_blocks - (
+                self._gpu_block_pool.get_num_free_blocks()
+            )
+            if num_used != 1:  # The null block is always marked as used.
+                return False
+
+        if not self.cpu_block_pool.reset_prefix_cache():
+            return False
+
+        # Drop scheduler state from the old cache generation.  Event counters
+        # intentionally remain monotonic: workers can still report completion
+        # for an event that was submitted before this reset, and reusing its
+        # index could make that stale completion apply to a new store.
+        self._load_event_to_reqs.clear()
+        self._store_event_to_reqs.clear()
+        self._reqs_to_store.clear()
+        self._in_flight_store_gpu_blocks.clear()
+        self._store_event_to_blocks.clear()
+        self._store_event_pending_counts.clear()
+        self._reqs_to_load.clear()
+        self._pending_cpu_hits.clear()
+        self._cursor = None
+        return True
 
