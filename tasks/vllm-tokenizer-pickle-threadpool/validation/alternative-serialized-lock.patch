+def _rebuild_locked_tokenizer(tokenizer):
+    """Rebuild a serializing thread-safe tokenizer after transport."""
+    if isinstance(tokenizer, ThreadSafeHFTokenizerMixin):
+        return tokenizer
+
+    original = copy.copy(tokenizer)
+    lock = threading.RLock()
+
+    class LockedTokenizer(tokenizer.__class__, ThreadSafeHFTokenizerMixin):  # type: ignore
+        def apply_chat_template(self, *args, **kwargs):
+            with lock:
+                return original.apply_chat_template(*args, **kwargs)
+
+        def batch_decode(self, *args, **kwargs):
+            with lock:
+                return original.batch_decode(*args, **kwargs)
+
+        def batch_encode(self, *args, **kwargs):
+            with lock:
+                return original.batch_encode(*args, **kwargs)
+
+        def convert_tokens_to_ids(self, *args, **kwargs):
+            with lock:
+                return original.convert_tokens_to_ids(*args, **kwargs)
+
+        def convert_ids_to_tokens(self, *args, **kwargs):
+            with lock:
+                return original.convert_ids_to_tokens(*args, **kwargs)
+
+        def convert_tokens_to_string(self, *args, **kwargs):
+            with lock:
+                return original.convert_tokens_to_string(*args, **kwargs)
+
+        def decode(self, *args, **kwargs):
+            with lock:
+                return original.decode(*args, **kwargs)
+
+        def encode(self, *args, **kwargs):
+            with lock:
+                return original.encode(*args, **kwargs)
+
+        def __call__(self, *args, **kwargs):
+            with lock:
+                return original(*args, **kwargs)
+
+        def __reduce__(self):
+            return _rebuild_locked_tokenizer, (original,)
+
+    LockedTokenizer.__name__ = f"LockedTokenizer{original.__class__.__name__}"
+    tokenizer.__class__ = LockedTokenizer
+    return tokenizer
+
+
