index 0000000000000000000000000000000000000000..a1a5886527f0e06847880a11e4dffe4b5a48e17a
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/fork/index.ts
@@ -0,0 +1,395 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, Message } from "@earendil-works/pi-ai";
+import {
+	buildSessionContext,
+	convertToLlm,
+	type ExtensionAPI,
+	type ExtensionContext,
+	SessionManager,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const CHILD = "PI_FORK_CHILD";
+const BOOTSTRAP = "fork-bootstrap";
+const RUN = "fork-run-internal";
+
+interface Bootstrap {
+	task: string;
+	systemPrompt: string;
+	tools: string[];
+}
+
+interface ResultDetails {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface Fork {
+	id: string;
+	child?: ChildProcess;
+	sessionFile?: string;
+	result?: { customType: string; content: string; display: boolean; details: ResultDetails };
+	queued: boolean;
+	seen: boolean;
+}
+
+interface Owner {
+	forks: Map<string, Fork>;
+	request: Message[];
+	requestResults: string[];
+	assistant?: AssistantMessage;
+	binding?: { pi: ExtensionAPI; ctx: ExtensionContext };
+	timer?: ReturnType<typeof setInterval>;
+	closed: boolean;
+}
+
+// Extension modules are re-evaluated on /reload. Keep process handles and delivery
+// acknowledgements outside the extension runtime, but never keep using its old API.
+const key = Symbol.for("pi.example.fork.owners");
+const globals = globalThis as typeof globalThis & { [key]?: Map<string, Owner> };
+globals[key] ??= new Map<string, Owner>();
+const owners = globals[key];
+
+function acknowledge(owner: Owner): void {
+	for (const id of owner.requestResults) {
+		const fork = owner.forks.get(id);
+		if (fork) {
+			fork.seen = true;
+			owner.forks.delete(id);
+		}
+	}
+	owner.requestResults = [];
+}
+
+function deliver(owner: Owner): void {
+	if (owner.closed || !owner.binding) return;
+	const pending = [...owner.forks.values()].filter((fork) => fork.result && !fork.seen && !fork.queued);
+	if (pending.length === 0) return;
+	const { pi, ctx } = owner.binding;
+	const recorded = new Set(
+		ctx.sessionManager
+			.getEntries()
+			.filter((entry) => entry.type === "custom_message" && entry.customType === "fork-result")
+			.map((entry) => (entry.type === "custom_message" ? (entry.details as ResultDetails).forkId : undefined)),
+	);
+	let wake = false;
+	for (const fork of pending) {
+		fork.queued = true;
+		if (recorded.has(fork.id)) {
+			// Escape can happen after persistence but before the next model request.
+			// Wake the loop without appending the same fork-result a second time.
+			wake = true;
+		} else {
+			pi.sendMessage(fork.result!, { triggerTurn: true, deliverAs: "steer" });
+		}
+	}
+	if (wake) {
+		pi.sendMessage({ customType: "fork-wake", content: [], display: false }, { triggerTurn: true });
+	}
+}
+
+function stop(owner: Owner): void {
+	owner.closed = true;
+	owner.binding = undefined;
+	clearInterval(owner.timer);
+	for (const fork of owner.forks.values()) {
+		// Kill immediately: an extension or tool may ignore graceful shutdown.
+		fork.child?.kill("SIGKILL");
+	}
+	owner.forks.clear();
+}
+
+function finish(owner: Owner, fork: Fork, error?: string): void {
+	if (owner.closed || fork.result) return;
+	let last: AssistantMessage | undefined;
+	if (fork.sessionFile && existsSync(fork.sessionFile)) {
+		try {
+			const session = SessionManager.open(fork.sessionFile);
+			// Exclude the inherited assistant when startup failed before any response.
+			let started = false;
+			for (const entry of session.getEntries()) {
+				if (entry.type === "custom" && entry.customType === BOOTSTRAP) started = true;
+				if (started && entry.type === "message" && entry.message.role === "assistant") last = entry.message;
+			}
+		} catch (cause) {
+			error ??= String(cause);
+		}
+	} else {
+		fork.sessionFile = undefined;
+	}
+	if (last?.stopReason === "error" || last?.stopReason === "aborted") {
+		error = last.errorMessage || `Model response ended with ${last.stopReason}`;
+	}
+	if (!last) error ??= "Fork exited without an assistant response";
+	const details: ResultDetails = {
+		forkId: fork.id,
+		status: error === undefined ? "completed" : "failed",
+		...(fork.sessionFile ? { sessionFile: fork.sessionFile } : {}),
+		...(error === undefined ? {} : { error }),
+	};
+	const text =
+		error ??
+		last!.content
+			.filter((part) => part.type === "text")
+			.map((part) => part.text)
+			.join("\n");
+	fork.result = {
+		customType: "fork-result",
+		display: true,
+		content: `Fork ${fork.id} ${details.status}:\n${text}`,
+		details,
+	};
+	fork.child = undefined;
+	deliver(owner);
+}
+
+function installChild(pi: ExtensionAPI): void {
+	let bootstrap: Bootstrap;
+	let inherited: AgentMessage[];
+	let firstRequest = true;
+	let taskMessage: AgentMessage;
+	pi.on("session_start", (_event, ctx) => {
+		const entry = ctx.sessionManager
+			.getEntries()
+			.find((item) => item.type === "custom" && item.customType === BOOTSTRAP);
+		if (!entry || entry.type !== "custom") throw new Error("Missing fork bootstrap");
+		bootstrap = entry.data as Bootstrap;
+		inherited = structuredClone(
+			buildSessionContext(ctx.sessionManager.getEntries(), ctx.sessionManager.getLeafId()).messages,
+		);
+		pi.setActiveTools(bootstrap.tools.filter((name) => name !== "fork"));
+	});
+	pi.on("before_agent_start", () => ({ systemPrompt: bootstrap.systemPrompt }));
+	// The inherited assistant's usage can trigger pre-prompt compaction. The
+	// first request must still use the snapshot; normal compaction resumes after it.
+	pi.on("session_before_compact", () => (firstRequest ? { cancel: true } : undefined));
+	// The leading newline prevents slash-command/skill/template expansion. Replace
+	// it before persistence; the model and the session both receive the literal task.
+	pi.on("input", () => ({ action: "transform", text: `\n${bootstrap.task}` }));
+	pi.on("message_end", (event) => {
+		if (event.message.role !== "user" || taskMessage) return;
+		taskMessage = { ...event.message, content: [{ type: "text", text: bootstrap.task }] };
+		return { message: taskMessage };
+	});
+	pi.on("context", () => {
+		if (!firstRequest) return;
+		firstRequest = false;
+		// Do not run the parent's inherited context through context transforms twice.
+		return { messages: [...inherited, taskMessage] };
+	});
+}
+
+export default function (pi: ExtensionAPI) {
+	if (process.env[CHILD]) {
+		installChild(pi);
+		return;
+	}
+
+	let owner: Owner | undefined;
+	let sessionId: string | undefined;
+	pi.on("session_start", (_event, ctx) => {
+		sessionId = ctx.sessionManager.getSessionId();
+		owner = owners.get(sessionId);
+		if (!owner) {
+			owner = { forks: new Map(), request: [], requestResults: [], closed: false };
+			owners.set(sessionId, owner);
+		}
+		owner.binding = { pi, ctx };
+		const current = owner;
+		// Also covers the gap between agent_end and idle, and completions during reload.
+		current.timer ??= setInterval(() => deliver(current), 100);
+		current.timer.unref();
+	});
+	pi.on("session_shutdown", (event) => {
+		if (!owner) return;
+		owner.binding = undefined;
+		if (event.reason === "reload") return;
+		stop(owner);
+		if (sessionId) owners.delete(sessionId);
+	});
+	pi.on("context", (event, ctx) => {
+		if (!owner) return;
+		if (ctx.signal?.aborted) return;
+		// Automatic compaction may summarize a result between its persistence and
+		// its first delivery. Preserve the exact answer in that first request.
+		for (const fork of owner.forks.values()) {
+			if (!fork.result || fork.seen) continue;
+			const recorded = ctx.sessionManager
+				.getEntries()
+				.some(
+					(entry) =>
+						entry.type === "custom_message" &&
+						entry.customType === "fork-result" &&
+						(entry.details as Partial<ResultDetails> | undefined)?.forkId === fork.id,
+				);
+			if (
+				recorded &&
+				!event.messages.some(
+					(message) =>
+						message.role === "custom" &&
+						message.customType === "fork-result" &&
+						(message.details as Partial<ResultDetails> | undefined)?.forkId === fork.id,
+				)
+			)
+				event.messages.push({ role: "custom", ...fork.result, timestamp: Date.now() });
+		}
+		owner.requestResults = [];
+		for (const message of event.messages) {
+			if (message.role !== "custom" || message.customType !== "fork-result") continue;
+			const id = (message.details as Partial<ResultDetails> | undefined)?.forkId;
+			if (id && owner.forks.has(id)) owner.requestResults.push(id);
+		}
+		owner.request = structuredClone(convertToLlm(event.messages));
+		return { messages: event.messages };
+	});
+	pi.on("after_provider_response", () => {
+		if (owner) acknowledge(owner);
+	});
+	pi.on("message_end", (event, ctx) => {
+		if (!owner || event.message.role !== "assistant") return;
+		owner.assistant = event.message;
+		// Custom providers need not emit HTTP response hooks. Their finalized
+		// response also acknowledges delivery, unless Escape aborted the request.
+		if (event.message.stopReason !== "aborted" && !ctx.signal?.aborted) acknowledge(owner);
+	});
+	pi.on("agent_settled", () => {
+		if (!owner) return;
+		owner.requestResults = [];
+		// A queued result may have been discarded by Escape. The session transcript
+		// tells deliver() whether it needs requeueing or only a new model request.
+		for (const fork of owner.forks.values()) fork.queued = false;
+	});
+
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description:
+			"Start a background investigation with a copy of this conversation. Its answer returns automatically.",
+		parameters: Type.Object({ task: Type.String() }),
+		async execute(toolCallId, { task }, _signal, _onUpdate, ctx) {
+			if (!task.trim()) throw new Error("Fork task must not be empty");
+			if (!owner || owner.closed || !owner.assistant || !ctx.model)
+				throw new Error("No active conversation to fork");
+			const parentSession = ctx.sessionManager.getSessionFile();
+			if (!parentSession) throw new Error("Fork requires a persisted parent session");
+			const current = owner;
+			const fork: Fork = { id: randomUUID(), queued: false, seen: false };
+			current.forks.set(fork.id, fork);
+			let temporary: string | undefined;
+			try {
+				const session = SessionManager.create(ctx.cwd, ctx.sessionManager.getSessionDir(), {
+					parentSession: resolve(parentSession),
+				});
+				fork.sessionFile = resolve(session.getSessionFile()!);
+				for (const message of structuredClone(current.request)) session.appendMessage(message);
+				const assistant = structuredClone(current.assistant!);
+				session.appendMessage(assistant);
+				for (const call of assistant.content) {
+					if (call.type !== "toolCall") continue;
+					session.appendMessage({
+						role: "toolResult",
+						toolCallId: call.id,
+						toolName: call.name,
+						content: [
+							{
+								type: "text",
+								text: call.id === toolCallId ? `Fork ${fork.id} started.` : "Not executed in this fork.",
+							},
+						],
+						isError: call.id !== toolCallId,
+						timestamp: Date.now(),
+					});
+				}
+				session.appendModelChange(ctx.model.provider, ctx.model.id);
+				session.appendThinkingLevelChange(pi.getThinkingLevel());
+				session.appendCustomEntry(BOOTSTRAP, {
+					task,
+					systemPrompt: ctx.getSystemPrompt(),
+					tools: pi.getActiveTools(),
+				} satisfies Bootstrap);
+
+				temporary = mkdtempSync(join(tmpdir(), "pi-fork-"));
+				const watchdog = join(temporary, "owner.cjs");
+				// Run before CLI imports/extensions, so even a slow startup cannot orphan
+				// the child. IPC EOF also works after SIGKILL and avoids PID reuse races.
+				writeFileSync(
+					watchdog,
+					`if (require("node:worker_threads").isMainThread) {
+  const cleanup = () => require("node:fs").rmSync(__dirname, { recursive: true, force: true });
+  const stop = () => { cleanup(); process.kill(process.pid, "SIGKILL"); };
+  process.on("exit", cleanup);
+  process.on("disconnect", stop);
+  if (!process.connected) stop();
+  process.channel?.unref();
+}
+`,
+				);
+				const child = spawn(
+					process.execPath,
+					[
+						"--require",
+						watchdog,
+						...process.execArgv,
+						resolve(process.argv[1]),
+						"--mode",
+						"json",
+						"--print",
+						"--session",
+						fork.sessionFile,
+						"--session-dir",
+						ctx.sessionManager.getSessionDir(),
+						"--provider",
+						ctx.model.provider,
+						"--model",
+						ctx.model.id,
+						"--thinking",
+						pi.getThinkingLevel(),
+						RUN,
+					],
+					{
+						cwd: ctx.cwd,
+						env: { ...process.env, [CHILD]: fork.id },
+						stdio: ["ignore", "ignore", "pipe", "ipc"],
+					},
+				);
+				fork.child = child;
+				let stderr = "";
+				child.stderr?.setEncoding("utf8");
+				child.stderr?.on("data", (data: string) => {
+					stderr = (stderr + data).slice(-16384);
+				});
+				const directory = temporary;
+				// Do not wait for stdio EOF: a subprocess may still hold an inherited pipe.
+				child.once("exit", (code, signal) => {
+					rmSync(directory, { recursive: true, force: true });
+					finish(
+						current,
+						fork,
+						signal
+							? `Fork killed by ${signal}`
+							: code !== 0
+								? `Fork exited with code ${code}${stderr ? `: ${stderr}` : ""}`
+								: undefined,
+					);
+				});
+				await new Promise<void>((resolveStarted, reject) => {
+					child.once("spawn", resolveStarted);
+					child.once("error", reject);
+				});
+			} catch (cause) {
+				if (temporary) rmSync(temporary, { recursive: true, force: true });
+				const reason = cause instanceof Error ? cause.message : String(cause);
+				finish(current, fork, reason);
+				throw new Error(`Fork ${fork.id} failed to start: ${reason}`);
+			}
+			return { content: [{ type: "text", text: `Fork ${fork.id} started.` }], details: { forkId: fork.id } };
+		},
+	});
+}
