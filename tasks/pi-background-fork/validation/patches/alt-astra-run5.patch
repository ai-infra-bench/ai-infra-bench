+import * as childProcess from "node:child_process";
+import { EventEmitter } from "node:events";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { PassThrough } from "node:stream";
+import { fileURLToPath } from "node:url";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { getModel } from "@earendil-works/pi-ai/compat";
+import { Type } from "typebox";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+import type {
+	ExtensionAPI,
+	ExtensionContext,
+	ExtensionEvent,
+	RegisteredCommand,
+	ToolDefinition,
+} from "../src/core/extensions/types.ts";
+import { convertToLlm } from "../src/core/messages.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { createHarness, getMessageText } from "./suite/harness.ts";
+
+vi.mock("node:child_process", async (original) => ({
+	...(await original<typeof childProcess>()),
+	spawn: vi.fn(),
+}));
+vi.mock("@earendil-works/pi-coding-agent", async () => ({
+	...(await vi.importActual("../src/core/session-manager.ts")),
+	...(await vi.importActual("../src/core/messages.ts")),
+}));
+
+const model = getModel("anthropic", "claude-sonnet-4-5");
+const assistant: AssistantMessage = {
+	role: "assistant",
+	content: [
+		{ type: "text", text: "I will check both paths." },
+		{ type: "toolCall", id: "fork-a", name: "fork", arguments: { task: "check A" } },
+		{ type: "toolCall", id: "read-b", name: "read", arguments: { path: "b.ts" } },
+		{ type: "toolCall", id: "fork-c", name: "fork", arguments: { task: "check C" } },
+	],
+	api: model.api,
+	provider: model.provider,
+	model: model.id,
+	stopReason: "toolUse",
+	usage: {
+		input: 10,
+		output: 10,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 20,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	},
+	timestamp: 10,
+};
+
+class FakeChild extends EventEmitter {
+	stderr = new PassThrough();
+	kill = vi.fn(() => true);
+}
+
+type SentMessage = Parameters<ExtensionAPI["sendMessage"]>[0];
+type Handler = (event: ExtensionEvent, ctx: ExtensionContext) => unknown;
+
+function harness(session: SessionManager) {
+	const handlers = new Map<string, Handler>();
+	const tools: ToolDefinition[] = [];
+	const commands = new Map<string, Omit<RegisteredCommand, "name" | "sourceInfo">>();
+	const queued: SentMessage[] = [];
+	let idle = false;
+	const ctx = {
+		cwd: dirname(session.getSessionDir()),
+		sessionManager: session,
+		model,
+		signal: undefined,
+		isIdle: () => idle,
+		getSystemPrompt: () => "Parent system prompt",
+	} as unknown as ExtensionContext;
+	const sendMessage = vi.fn((message: SentMessage) => {
+		queued.push(message);
+	});
+	const api = {
+		on: (name: string, handler: Handler) => handlers.set(name, handler),
+		registerTool: (tool: ToolDefinition) => tools.push(tool),
+		registerCommand: (name: string, command: Omit<RegisteredCommand, "name" | "sourceInfo">) =>
+			commands.set(name, command),
+		sendMessage,
+		sendUserMessage: vi.fn(),
+		getThinkingLevel: () => "high",
+		getActiveTools: () => ["read", "bash", "fork"],
+		setActiveTools: vi.fn(),
+	} as unknown as ExtensionAPI;
+	forkExtension(api);
+	const emit = (event: ExtensionEvent) => handlers.get(event.type)?.(event, ctx);
+	emit({ type: "session_start", reason: "startup" });
+	return {
+		api,
+		ctx,
+		tools,
+		commands,
+		queued,
+		sendMessage,
+		emit,
+		setIdle: (value: boolean) => {
+			idle = value;
+		},
+		start: (task = "check A", id = "fork-a") => tools[0].execute(id, { task }, undefined, undefined, ctx),
+		persist: () => {
+			for (const message of queued.splice(0)) {
+				session.appendCustomMessageEntry(message.customType, message.content, message.display, message.details);
+			}
+		},
+	};
+}
+
+describe("fork extension", () => {
+	let directory: string;
+	let session: SessionManager;
+	let parent: ReturnType<typeof harness>;
+	let children: FakeChild[];
+	let snapshots: AgentMessage[];
+
+	beforeEach(() => {
+		vi.mocked(childProcess.spawn).mockClear();
+		vi.useFakeTimers();
+		vi.stubEnv("PI_FORK_CHILD", undefined);
+		directory = mkdtempSync(join(tmpdir(), "fork-test-"));
+		session = SessionManager.create(directory, join(directory, "sessions"));
+		session.appendMessage({ role: "user", content: "original context", timestamp: 1 });
+		session.appendMessage(assistant);
+		children = [];
+		vi.mocked(childProcess.spawn).mockImplementation(() => {
+			const child = new FakeChild();
+			children.push(child);
+			Promise.resolve().then(() => child.emit("spawn"));
+			return child as unknown as childProcess.ChildProcess;
+		});
+		parent = harness(session);
+		snapshots = [
+			{ role: "compactionSummary", summary: "Older context compacted", tokensBefore: 100, timestamp: 1 },
+			{ role: "user", content: "current request", timestamp: 2 },
+		];
+		parent.emit({ type: "context", messages: snapshots });
+		parent.emit({ type: "message_end", message: structuredClone(assistant) });
+	});
+
+	afterEach(() => {
+		parent.emit({ type: "session_shutdown", reason: "quit" });
+		for (const child of children) child.emit("exit", 0, null);
