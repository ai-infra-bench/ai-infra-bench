@@ -0,0 +1,892 @@
+/**
+ * Fork
+ *
+ * Adds a `fork` tool: a background copy of the current conversation that
+ * investigates a task in its own pi process and reports its answer back.
+ *
+ * How a fork works:
+ *
+ * 1. The tool snapshots the conversation into a new session file. The snapshot
+ *    starts with the conversation the model saw, followed by the assistant
+ *    message that requested the fork and a tool result for every tool call of
+ *    that message. The file lives in the parent's session directory and its
+ *    header names the parent session file as `parentSession`.
+ * 2. It spawns `pi --session <fork session>` with the parent's environment,
+ *    model and thinking level. The task is handed to the child on stdin and is
+ *    the fork's only instruction. The child runs without a user and finishes
+ *    when its agent run ends.
+ * 3. The fork appends a `fork-completion` entry to its own session when its run
+ *    ends. The parent watches that file and adds a `fork-result` custom message
+ *    to its own conversation, exactly once.
+ *
+ * Forks are owned by the session that started them: quitting or switching
+ * sessions stops them, and a fork stops itself when its parent process dies.
+ * `/reload` keeps them running; the reloaded extension adopts them from the
+ * session entries.
+ */
+
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import {
+	closeSync,
+	existsSync,
+	mkdirSync,
+	openSync,
+	readFileSync,
+	readSync,
+	statSync,
+	unlinkSync,
+	writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { basename, dirname, join, resolve } from "node:path";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import type {
+	ExtensionAPI,
+	ExtensionContext,
+	SessionEntry,
+	SessionMessageEntry,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+/** Name of the tool. */
+const FORK_TOOL_NAME = "fork";
+
+/** Custom message type added to the parent session when a fork finishes. Exported for tests. */
+export const FORK_RESULT_CUSTOM_TYPE = "fork-result";
+
+/** Custom entry type a fork writes into its own session when its run ends. */
+const FORK_COMPLETION_CUSTOM_TYPE = "fork-completion";
+
+/** Custom entry type the parent writes to remember a running fork. Exported for tests. */
+export const FORK_TRACK_CUSTOM_TYPE = "fork";
+
+/** Session file format version written by this pi version (SessionManager.CURRENT_SESSION_VERSION). */
+const SESSION_FILE_VERSION = 3;
+
+/** How often running forks are checked for completion. */
+const POLL_INTERVAL_MS = 500;
+
+/** How often a fork checks that its parent process is still alive. */
+const PARENT_WATCH_INTERVAL_MS = 1000;
+
+/** How long a fork gets to exit after SIGTERM before it is killed. */
+const STOP_GRACE_MS = 2000;
+
+/** How much of the end of a session file is read when looking for a completion entry. */
+const SESSION_TAIL_BYTES = 256 * 1024;
+
+const ENV_FORK_CHILD = "PI_FORK_CHILD";
+const ENV_FORK_ID = "PI_FORK_ID";
+const ENV_FORK_PARENT_PID = "PI_FORK_PARENT_PID";
+/** Overrides the pi CLI used for forks. Mostly useful for tests. */
+const ENV_FORK_PI_CLI = "PI_FORK_CLI";
+
+/** Key of the per-process token on `globalThis`. */
+const PROCESS_TOKEN_KEY = "__piForkProcessToken";
+
+/** Key of the forks stopped because their session ended, on `globalThis`. */
+const STOPPED_FORK_IDS_KEY = "__piForkStoppedForkIds";
+
+/**
+ * Identity of this process. `/reload` re-evaluates this module, so the token is
+ * kept on `globalThis` to recognize forks of this exact process across a reload.
+ */
+const PROCESS_TOKEN = readProcessToken();
+
+function readProcessToken(): string {
+	const holder = globalThis as unknown as Record<string, unknown>;
+	const existing = holder[PROCESS_TOKEN_KEY];
+	if (typeof existing === "string") return existing;
+	const token = randomUUID();
+	holder[PROCESS_TOKEN_KEY] = token;
+	return token;
+}
+
+/**
+ * Forks this process stopped because their session ended. They must never
+ * deliver a result, not even when the user later resumes that session.
+ * Kept on `globalThis` so the set survives `/reload`.
+ */
+function stoppedForkIds(): Set<string> {
+	const holder = globalThis as unknown as Record<string, unknown>;
+	const existing = holder[STOPPED_FORK_IDS_KEY];
+	if (existing instanceof Set) return existing as Set<string>;
+	const created = new Set<string>();
+	holder[STOPPED_FORK_IDS_KEY] = created;
+	return created;
+}
+
+const STARTED_TEXT = (forkId: string): string => `Fork ${forkId} started in the background.`;
+
+const UNAVAILABLE_RESULT_TEXT =
+	"(This tool call was still running when the fork started, so its result is not available in the fork.)";
+
+type ForkStatus = "completed" | "failed";
+
+/** Details of the `fork-result` custom message. */
+interface ForkResultDetails {
+	forkId: string;
+	status: ForkStatus;
+	sessionFile?: string;
+	error?: string;
+}
+
+/** What a fork records about its own run. */
+interface ForkCompletionData {
+	forkId: string;
+	status: ForkStatus;
+	content: string;
+	error?: string;
+}
+
+/** What the parent records to find running forks after `/reload`. */
+interface ForkTrackingData {
+	forkId: string;
+	pid: number;
+	sessionFile: string;
+	task: string;
+	createdAt: string;
+	parentPid: number;
+	parentToken: string;
+}
+
+interface ForkResult {
+	status: ForkStatus;
+	content: string;
+	error?: string;
+}
+
+interface RunningFork {
+	forkId: string;
+	/** Undefined when the fork process could not be started. */
+	pid: number | undefined;
+	sessionFile: string;
+	/** Child process handle. Missing for forks adopted after `/reload`. */
+	child?: ChildProcess;
+	spawnError?: string;
+	result?: ForkResult;
+	/** True when the result was handed to a parent run but is not in the session yet. */
+	delivered?: boolean;
+}
+
+interface ForkEnvironment {
+	forkId: string;
+	parentPid: number;
+}
+
+export default function forkExtension(pi: ExtensionAPI): void {
+	const environment = readForkEnvironment();
+	if (environment) {
+		registerFork(pi, environment);
+		return;
+	}
+	new ForkManager(pi).register();
+}
+
+// ============================================================================
+// Fork side
+// ============================================================================
+
+/**
+ * Inside a fork: no `fork` tool (a fork cannot fork), report the run result in
+ * the fork's own session, and stop when the parent process is gone.
+ */
+function registerFork(pi: ExtensionAPI, environment: ForkEnvironment): void {
+	let finished = false;
+
+	const finish = (ctx: ExtensionContext, fallbackError: string): void => {
+		if (finished) return;
+		finished = true;
+		pi.appendEntry<ForkCompletionData>(
+			FORK_COMPLETION_CUSTOM_TYPE,
+			buildCompletion(environment.forkId, ctx.sessionManager.getEntries(), fallbackError),
+		);
+	};
+
+	pi.on("agent_settled", (_event, ctx) => {
+		finish(ctx, "The fork run ended without an assistant message.");
+	});
+
+	pi.on("session_shutdown", (_event, ctx) => {
+		finish(ctx, "The fork run did not finish.");
+	});
+
+	startParentWatchdog(environment.parentPid);
+}
+
+function startParentWatchdog(parentPid: number): void {
+	if (parentPid <= 1) return;
+	const watchdog = setInterval(() => {
+		if (process.ppid !== parentPid || !isProcessAlive(parentPid)) {
+			process.exit(0);
+		}
+	}, PARENT_WATCH_INTERVAL_MS);
+	watchdog.unref();
+}
+
+function buildCompletion(forkId: string, entries: readonly SessionEntry[], fallbackError: string): ForkCompletionData {
+	const assistant = findLastAssistantMessage(entries);
+	if (assistant && assistant.stopReason !== "error" && assistant.stopReason !== "aborted") {
+		return { forkId, status: "completed", content: textOf(assistant) || "(no output)" };
+	}
+	const reason = assistant
+		? assistant.errorMessage?.trim() ||
+			(assistant.stopReason === "aborted" ? "The fork run was aborted." : "The model request failed.")
+		: fallbackError;
+	return { forkId, status: "failed", content: reason, error: reason };
+}
+
+function findLastAssistantMessage(entries: readonly SessionEntry[]): AssistantMessage | undefined {
+	for (let index = entries.length - 1; index >= 0; index--) {
+		const entry = entries[index];
+		if (entry.type === "message" && entry.message.role === "assistant") {
+			return entry.message;
+		}
+	}
+	return undefined;
+}
+
+function textOf(message: AssistantMessage): string {
+	const parts: string[] = [];
+	for (const part of message.content) {
+		if (part.type === "text") parts.push(part.text);
+	}
+	return parts.join("\n").trim();
+}
+
+// ============================================================================
+// Parent side
+// ============================================================================
+
+class ForkManager {
+	private readonly pi: ExtensionAPI;
+	private readonly forks = new Map<string, RunningFork>();
+	private latestContext: ExtensionContext | undefined;
+	private pollTimer: NodeJS.Timeout | undefined;
+	private stopped = false;
+
+	constructor(pi: ExtensionAPI) {
+		this.pi = pi;
+	}
+
+	register(): void {
+		this.pi.registerTool({
+			name: FORK_TOOL_NAME,
+			label: "Fork",
+			description:
+				"Start a fork: a separate pi process that continues this conversation in the background with the given " +
+				"task and reports its answer back into this conversation. Use it for side investigations that should not " +
+				"block the current task. The fork inherits this conversation up to this point and the task is its only " +
+				"instruction. The result arrives later as a fork-result message in this conversation.",
+			promptSnippet:
+				"fork: start a background copy of this conversation to investigate a task and report back when it is done",
+			parameters: Type.Object({
+				task: Type.String({ description: "What the fork should investigate. It is the fork's only instruction." }),
+			}),
+			execute: async (toolCallId, params, _signal, _onUpdate, ctx) => {
+				this.latestContext = ctx;
+				const forkId = this.startFork(ctx, toolCallId, params.task);
+				return {
+					content: [{ type: "text" as const, text: STARTED_TEXT(forkId) }],
+					details: { forkId },
+				};
+			},
+		});
+
+		this.pi.on("session_start", (_event, ctx) => {
+			this.latestContext = ctx;
+			this.adoptRunningForks(ctx);
+			this.tick();
+		});
+
+		this.pi.on("agent_settled", (_event, ctx) => {
+			this.latestContext = ctx;
+			this.tick();
+		});
+
+		this.pi.on("session_compact", (_event, ctx) => {
+			this.latestContext = ctx;
+			this.tick();
+		});
+
+		this.pi.on("session_shutdown", async (event) => {
+			// This instance is done either way; on reload the next instance adopts the forks.
+			this.stopped = true;
+			this.stopPolling();
+			if (event.reason === "reload") {
+				// The session continues: the forks keep running for the reloaded extension.
+				return;
+			}
+			this.latestContext = undefined;
+			await this.stopForks();
+		});
+	}
+
+	/** Start a fork for `task` and return its id. Throws when nothing was started. */
+	private startFork(ctx: ExtensionContext, toolCallId: string, rawTask: string): string {
+		const task = rawTask.trim();
+		if (!task) {
+			throw new Error("The fork task is empty. Provide a task for the fork to work on.");
+		}
+
+		const entries = ctx.sessionManager.buildContextEntries();
+		const assistantIndex = findAssistantEntryIndex(entries, toolCallId);
+		if (assistantIndex < 0) {
+			throw new Error("Could not find the assistant message that requested this fork. Nothing was started.");
+		}
+		const assistantEntry = entries[assistantIndex];
+		if (assistantEntry?.type !== "message" || assistantEntry.message.role !== "assistant") {
+			throw new Error("Could not find the assistant message that requested this fork. Nothing was started.");
+		}
+
+		const forkId = createForkId(this.forks);
+		const sessionFile = writeForkSession(
+			ctx,
+			entries.slice(0, assistantIndex + 1),
+			assistantEntry,
+			toolCallId,
+			forkId,
+		);
+		const child = this.spawnFork(ctx, sessionFile, forkId, task);
+
+		const running: RunningFork = { forkId, pid: child.pid, sessionFile, child };
+		child.on("error", (error) => {
+			running.spawnError = `Failed to start the fork process: ${error.message}`;
+			this.tick();
+		});
+		child.on("exit", () => this.tick());
+		this.forks.set(forkId, running);
+
+		this.pi.appendEntry<ForkTrackingData>(FORK_TRACK_CUSTOM_TYPE, {
+			forkId,
+			pid: child.pid ?? -1,
+			sessionFile,
+			task,
+			createdAt: new Date().toISOString(),
+			parentPid: process.pid,
+			parentToken: PROCESS_TOKEN,
+		});
+
+		this.tick();
+		return forkId;
+	}
+
+	private spawnFork(ctx: ExtensionContext, sessionFile: string, forkId: string, task: string): ChildProcess {
+		const args = ["--mode", "json", "-p", "--session", sessionFile];
+		const model = ctx.model;
+		if (model) args.push("--model", `${model.provider}/${model.id}`);
+		args.push("--thinking", this.pi.getThinkingLevel());
+
+		const invocation = resolvePiInvocation(args);
+		let child: ChildProcess;
+		try {
+			child = spawn(invocation.command, invocation.args, {
+				cwd: ctx.cwd,
+				env: {
+					...process.env,
+					[ENV_FORK_CHILD]: "1",
+					[ENV_FORK_ID]: forkId,
+					[ENV_FORK_PARENT_PID]: String(process.pid),
+				},
+				shell: false,
+				stdio: ["pipe", "ignore", "ignore"],
+			});
+		} catch (error) {
+			removeFile(sessionFile);
+			throw error;
+		}
+
+		// The task is sent on stdin so it is never parsed as CLI flags or `@file` arguments.
+		child.stdin?.on("error", () => {});
+		child.stdin?.end(task);
+		return child;
+	}
+
+	/** Check every fork once and then deliver whatever is ready to deliver. */
+	private tick(): void {
+		if (this.stopped) return;
+		try {
+			this.pollForks();
+			this.deliverResults();
+			this.updatePolling();
+		} catch {
+			// The extension runner can be gone (for example after a session switch).
+		}
+	}
+
+	private pollForks(): void {
+		for (const fork of this.forks.values()) {
+			if (fork.result) continue;
+			const completion = findCompletion(readSessionTail(fork.sessionFile), fork.forkId);
+			if (completion) {
+				fork.result = completion;
+				continue;
+			}
+			if (this.hasExited(fork)) {
+				fork.result = failureResult(fork);
+			}
+		}
+	}
+
+	private hasExited(fork: RunningFork): boolean {
+		if (fork.spawnError !== undefined) return true;
+		if (fork.child) return fork.child.exitCode !== null || fork.child.signalCode !== null;
+		if (fork.pid === undefined || fork.pid <= 0) return true;
+		return !isForkProcessAlive(fork.pid, fork.sessionFile);
+	}
+
+	/** Add every finished fork result that is not in the session yet. */
+	private deliverResults(): void {
+		const ctx = this.latestContext;
+		if (!ctx) return;
+		for (const fork of this.forks.values()) {
+			const result = fork.result;
+			if (!result || sessionHasForkResult(ctx, fork.forkId)) continue;
+			if (!ctx.isIdle()) {
+				// Compacting or summarizing: the parent cannot take a run and has nothing queued.
+				if (ctx.signal === undefined) continue;
+				// Already queued into this run; the run appends it when it drains its queue.
+				if (fork.delivered) continue;
+			} else if (fork.delivered) {
+				// Handed to a run that settled without recording it, so it was discarded, for
+				// example by an abort. The parent is idle again, so deliver it once more.
+				fork.delivered = false;
+			}
+			this.pi.sendMessage(
+				{
+					customType: FORK_RESULT_CUSTOM_TYPE,
+					content: buildResultText(fork.forkId, result),
+					display: true,
+					details: buildResultDetails(fork.forkId, result, fork.sessionFile),
+				},
+				// Queues into the running conversation when busy, starts a run when idle.
+				{ triggerTurn: true, deliverAs: "followUp" },
+			);
+			fork.delivered = true;
+		}
+	}
+
+	/** Poll while forks run or results are still waiting to be delivered. */
+	private updatePolling(): void {
+		if (this.stopped) return;
+		const ctx = this.latestContext;
+		const busy =
+			[...this.forks.values()].some((fork) => !fork.result) ||
+			(ctx !== undefined && [...this.forks.values()].some((fork) => !sessionHasForkResult(ctx, fork.forkId)));
+		if (busy && this.pollTimer === undefined) {
+			this.pollTimer = setInterval(() => this.tick(), POLL_INTERVAL_MS);
+		} else if (!busy) {
+			this.stopPolling();
+		}
+	}
+
+	private stopPolling(): void {
+		if (this.pollTimer !== undefined) {
+			clearInterval(this.pollTimer);
+			this.pollTimer = undefined;
+		}
+	}
+
+	/** Adopt forks started by this process before `/reload`. */
+	private adoptRunningForks(ctx: ExtensionContext): void {
+		for (const entry of ctx.sessionManager.getEntries()) {
+			if (entry.type !== "custom" || entry.customType !== FORK_TRACK_CUSTOM_TYPE) continue;
+			const data = entry.data as ForkTrackingData | undefined;
+			if (!isAdoptableFork(data) || this.forks.has(data.forkId)) continue;
+			if (sessionHasForkResult(ctx, data.forkId)) continue;
+			this.forks.set(data.forkId, { forkId: data.forkId, pid: data.pid, sessionFile: data.sessionFile });
+		}
+	}
+
+	/** Stop every fork of this session. Nothing is delivered afterwards. */
+	private async stopForks(): Promise<void> {
+		const stopped = stoppedForkIds();
+		for (const fork of this.forks.values()) stopped.add(fork.forkId);
+		const running = [...this.forks.values()].filter((fork) => !fork.result && fork.spawnError === undefined);
+		for (const fork of running) signalFork(fork, "SIGTERM");
+
+		const deadline = Date.now() + STOP_GRACE_MS;
+		while (Date.now() < deadline && running.some(isForkRunning)) {
+			await delay(50);
+		}
+		for (const fork of running) {
+			if (isForkRunning(fork)) signalFork(fork, "SIGKILL");
+		}
+		this.forks.clear();
+	}
+}
+
+function isAdoptableFork(data: ForkTrackingData | undefined): data is ForkTrackingData {
+	return (
+		data !== undefined &&
+		typeof data.forkId === "string" &&
+		typeof data.pid === "number" &&
+		typeof data.sessionFile === "string" &&
+		data.parentPid === process.pid &&
+		data.parentToken === PROCESS_TOKEN &&
+		!stoppedForkIds().has(data.forkId)
+	);
+}
+
+function sessionHasForkResult(ctx: ExtensionContext, forkId: string): boolean {
+	return ctx.sessionManager
+		.getEntries()
+		.some(
+			(entry) =>
+				entry.type === "custom_message" &&
+				entry.customType === FORK_RESULT_CUSTOM_TYPE &&
+				(entry.details as ForkResultDetails | undefined)?.forkId === forkId,
+		);
+}
+
+function buildResultText(forkId: string, result: ForkResult): string {
+	if (result.status === "completed") {
+		return `Fork ${forkId} completed:\n\n${result.content}`;
+	}
+	return `Fork ${forkId} failed: ${result.error ?? result.content}`;
+}
+
+function buildResultDetails(forkId: string, result: ForkResult, sessionFile: string): ForkResultDetails {
+	const details: ForkResultDetails = { forkId, status: result.status, sessionFile };
+	if (result.status === "failed") details.error = result.error ?? result.content;
+	return details;
+}
+
+function failureResult(fork: RunningFork): ForkResult {
+	let reason: string;
+	if (fork.spawnError !== undefined) {
+		reason = fork.spawnError;
+	} else if (fork.child?.signalCode) {
+		reason = `The fork process was killed (${fork.child.signalCode}).`;
+	} else if (fork.child?.exitCode !== null && fork.child?.exitCode !== undefined) {
+		reason = `The fork process exited with code ${fork.child.exitCode} without recording a result.`;
+	} else {
+		reason = "The fork process is gone and never recorded a result.";
+	}
+	return { status: "failed", content: reason, error: reason };
+}
+
+async function delay(ms: number): Promise<void> {
+	await new Promise((resolveDelay) => setTimeout(resolveDelay, ms));
+}
+
+function isForkRunning(fork: RunningFork): boolean {
+	if (fork.child) return fork.child.exitCode === null && fork.child.signalCode === null;
+	if (fork.pid === undefined || fork.pid <= 0) return false;
+	return isForkProcessAlive(fork.pid, fork.sessionFile);
+}
+
+function signalFork(fork: RunningFork, signal: NodeJS.Signals): void {
+	if (fork.child && fork.child.exitCode === null && fork.child.signalCode === null) {
+		fork.child.kill(signal);
+		return;
+	}
+	if (fork.pid !== undefined && fork.pid > 0 && isForkProcessAlive(fork.pid, fork.sessionFile)) {
+		process.kill(fork.pid, signal);
+	}
+}
+
+// ============================================================================
+// Fork session file
+// ============================================================================
+
+/** Create the fork's session file. The file is the fork's whole starting point. */
+function writeForkSession(
+	ctx: ExtensionContext,
+	entries: readonly SessionEntry[],
+	assistantEntry: SessionMessageEntry,
+	toolCallId: string,
+	forkId: string,
+): string {
+	const parentSessionFile = ctx.sessionManager.getSessionFile();
+	const directory = ctx.sessionManager.getSessionDir() || join(tmpdir(), "pi-forks");
+	mkdirSync(directory, { recursive: true });
+
+	const timestamp = new Date().toISOString();
+	const sessionFile = join(directory, `${timestamp.replace(/[:.]/g, "-")}_${forkId}.jsonl`);
+
+	const header = {
+		type: "session",
+		version: SESSION_FILE_VERSION,
+		id: forkId,
+		timestamp,
+		cwd: resolve(ctx.cwd),
+		...(parentSessionFile ? { parentSession: parentSessionFile } : {}),
+	};
+
+	const lines = [JSON.stringify(header)];
+	const usedIds = new Set<string>();
+	for (const entry of entries) {
+		// Session metadata of the parent session does not belong to the fork.
+		if (entry.type === "session_info" || entry.type === "label") continue;
+		usedIds.add(entry.id);
+		lines.push(JSON.stringify(entry));
+	}
+
+	let parentId = entries[entries.length - 1]?.id ?? null;
+	const timestampMs = Date.now();
+	for (const toolResult of buildToolResults(assistantEntry, toolCallId, forkId, usedIds, timestampMs)) {
+		const entry: SessionMessageEntry = {
+			type: "message",
+			id: toolResult.id,
+			parentId,
+			timestamp: new Date(timestampMs).toISOString(),
+			message: toolResult.message,
+		};
+		parentId = entry.id;
+		lines.push(JSON.stringify(entry));
+	}
+
+	try {
+		writeFileSync(sessionFile, `${lines.join("\n")}\n`, { flag: "wx" });
+	} catch (error) {
+		removeFile(sessionFile);
+		throw error;
+	}
+	return sessionFile;
+}
+
+/**
+ * A result for every tool call of the forking assistant message, because the
+ * next request of the fork has to answer all of them. Sibling tool calls may
+ * still be running when the fork starts, so they get an explicit placeholder.
+ */
+function buildToolResults(
+	assistantEntry: SessionMessageEntry,
+	toolCallId: string,
+	forkId: string,
+	usedIds: Set<string>,
+	timestampMs: number,
+): { id: string; message: ToolResultMessage }[] {
+	const message = assistantEntry.message;
+	if (message.role !== "assistant") return [];
+
+	const results: { id: string; message: ToolResultMessage }[] = [];
+	for (const part of message.content) {
+		if (part.type !== "toolCall") continue;
+		const isForkCall = part.id === toolCallId && part.name === FORK_TOOL_NAME;
+		results.push({
+			id: createEntryId(usedIds),
+			message: {
+				role: "toolResult",
+				toolCallId: part.id,
+				toolName: part.name,
+				content: [{ type: "text", text: isForkCall ? STARTED_TEXT(forkId) : UNAVAILABLE_RESULT_TEXT }],
+				isError: false,
+				timestamp: timestampMs,
+			},
+		});
+	}
+	return results;
+}
+
+function findAssistantEntryIndex(entries: readonly SessionEntry[], toolCallId: string): number {
+	for (let index = entries.length - 1; index >= 0; index--) {
+		const entry = entries[index];
+		if (entry.type !== "message" || entry.message.role !== "assistant") continue;
+		const hasToolCall = entry.message.content.some((part) => part.type === "toolCall" && part.id === toolCallId);
+		if (hasToolCall) return index;
+	}
+	return -1;
+}
+
+function createForkId(forks: Map<string, RunningFork>): string {
+	for (let attempt = 0; attempt < 100; attempt++) {
+		const id = `fork-${randomUUID().replace(/-/g, "").slice(0, 8)}`;
+		if (!forks.has(id)) return id;
+	}
+	return `fork-${randomUUID()}`;
+}
+
+function createEntryId(usedIds: Set<string>): string {
+	for (let attempt = 0; attempt < 100; attempt++) {
+		const id = randomUUID().slice(0, 8);
+		if (!usedIds.has(id)) {
+			usedIds.add(id);
+			return id;
+		}
+	}
+	const id = randomUUID();
+	usedIds.add(id);
+	return id;
+}
+
+// ============================================================================
+// Session files
+// ============================================================================
+
+/** Find the completion a fork recorded in its own session. */
+function findCompletion(entries: readonly Record<string, unknown>[], forkId: string): ForkResult | undefined {
+	for (let index = entries.length - 1; index >= 0; index--) {
+		const entry = entries[index];
+		if (entry.type !== "custom" || entry.customType !== FORK_COMPLETION_CUSTOM_TYPE) continue;
+		const data = entry.data;
+		if (!isRecord(data) || data.forkId !== forkId) continue;
+		const status = data.status === "failed" ? "failed" : data.status === "completed" ? "completed" : undefined;
+		if (status === undefined) continue;
+		return {
+			status,
+			content: typeof data.content === "string" ? data.content : "",
+			error: typeof data.error === "string" ? data.error : undefined,
+		};
+	}
+	return undefined;
+}
+
+/** Parse the end of a session file. Lines cut in half by the read window are ignored. */
+function readSessionTail(sessionFile: string): Record<string, unknown>[] {
+	const text = readFileTail(sessionFile, SESSION_TAIL_BYTES);
+	if (!text) return [];
+	const entries: Record<string, unknown>[] = [];
+	for (const line of text.split("\n")) {
+		const entry = parseEntryLine(line);
+		if (entry) entries.push(entry);
+	}
+	return entries;
+}
+
+function readFileTail(filePath: string, maxBytes: number): string {
+	let fd: number | undefined;
+	try {
+		const size = statSync(filePath).size;
+		const start = Math.max(0, size - maxBytes);
+		const length = size - start;
+		if (length === 0) return "";
+		const buffer = Buffer.allocUnsafe(length);
+		fd = openSync(filePath, "r");
+		readSync(fd, buffer, 0, length, start);
+		return buffer.toString("utf8");
+	} catch {
+		return "";
+	} finally {
+		if (fd !== undefined) closeSync(fd);
+	}
+}
+
+function parseEntryLine(line: string): Record<string, unknown> | undefined {
+	const trimmed = line.trim();
+	if (!trimmed.startsWith("{")) return undefined;
+	try {
+		const parsed: unknown = JSON.parse(trimmed);
+		return isRecord(parsed) && typeof parsed.type === "string" ? parsed : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+function removeFile(filePath: string): void {
+	try {
+		unlinkSync(filePath);
+	} catch {
+		// The file is already gone.
+	}
+}
+
+// ============================================================================
+// Processes
+// ============================================================================
+
+function readForkEnvironment(): ForkEnvironment | undefined {
+	if (process.env[ENV_FORK_CHILD] !== "1") return undefined;
+	const parentPid = Number(process.env[ENV_FORK_PARENT_PID] ?? "0");
+	return {
+		forkId: process.env[ENV_FORK_ID] ?? "unknown",
+		parentPid: Number.isFinite(parentPid) ? parentPid : 0,
+	};
+}
+
+function isProcessAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (error) {
+		return (error as NodeJS.ErrnoException).code === "EPERM";
+	}
+}
+
+/**
+ * Whether `pid` still is the fork process for `sessionFile`. On Linux the
+ * command line is checked so a recycled pid is not mistaken for a live fork.
+ */
+function isForkProcessAlive(pid: number, sessionFile: string): boolean {
+	if (!isProcessAlive(pid)) return false;
+	if (process.platform !== "linux") return true;
+	try {
+		return readFileSync(`/proc/${pid}/cmdline`, "utf8").includes(sessionFile);
+	} catch {
+		return true;
+	}
+}
+
+/** Resolve the pi CLI to run, which is the CLI this process runs, unless overridden. */
+function resolvePiInvocation(args: string[]): { command: string; args: string[] } {
+	const override = process.env[ENV_FORK_PI_CLI]?.trim();
+	if (override) {
+		return { command: process.execPath, args: [override, ...args] };
+	}
+
+	const currentScript = process.argv[1];
+	if (currentScript && !currentScript.startsWith("/$bunfs/") && existsSync(currentScript)) {
+		const cliScript = resolveCliScript(currentScript);
+		if (cliScript) {
+			return { command: process.execPath, args: [...inheritedNodeArgs(), cliScript, ...args] };
+		}
+	}
+
+	const execName = basename(process.execPath).toLowerCase();
+	if (!/^(node|bun)(\.exe)?$/.test(execName)) {
+		// Compiled pi binary: the executable is the CLI.
+		return { command: process.execPath, args };
+	}
+
+	return { command: "pi", args };
+}
+
+/**
+ * Node flags this process was started with, minus debugger flags. Setups such as
+ * `tsx src/experimental/cli.ts` load the CLI through `--import`, and a fork
+ * needs the same flags to run the same CLI. Inspector flags are dropped because
+ * the fork would try to bind the parent's debugger port.
+ */
+function inheritedNodeArgs(): string[] {
+	return process.execArgv.filter((arg) => !/^--(inspect|debug)/.test(arg));
+}
+
+/** Map an entry script of this pi installation to its CLI entry script. */
+function resolveCliScript(script: string): string | undefined {
+	const name = basename(script).toLowerCase();
+	if (/^cli\.(js|cjs|mjs|ts)$/.test(name) && packageNameOf(script) === "@earendil-works/pi-coding-agent") {
+		return script;
+	}
+	if (name.startsWith("rpc-entry.")) {
+		const candidate = join(dirname(script), name.replace(/^rpc-entry/, "cli"));
+		return existsSync(candidate) ? candidate : undefined;
+	}
+	return undefined;
+}
+
+/** Name field of the nearest package.json above `script`, if any. */
+function packageNameOf(script: string): string | undefined {
+	let directory = dirname(resolve(script));
+	for (let depth = 0; depth < 5; depth++) {
+		const manifest = join(directory, "package.json");
+		if (existsSync(manifest)) {
+			try {
+				const parsed: unknown = JSON.parse(readFileSync(manifest, "utf8"));
+				if (isRecord(parsed) && typeof parsed.name === "string") return parsed.name;
+			} catch {
+				return undefined;
+			}
+			return undefined;
+		}
+		const parent = dirname(directory);
+		if (parent === directory) return undefined;
+		directory = parent;
+	}
+	return undefined;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null;
+}
