+		script,
+		[
+			'import { appendFileSync, writeFileSync } from "node:fs";',
+			"const args = process.argv.slice(2);",
+			"const value = (flag) => { const index = args.indexOf(flag); return index >= 0 ? args[index + 1] : undefined; };",
+			'const sessionFile = value("--session");',
+			'const forkId = process.env.PI_FORK_ID ?? "";',
+			`const records = ${JSON.stringify(records)};`,
+			'let task = "";',
+			'process.stdin.setEncoding("utf8");',
+			'process.stdin.on("data", (chunk) => { task += chunk; });',
+			'process.stdin.on("end", () => {',
+			"  writeFileSync(records + '/' + forkId + '.json', JSON.stringify({",
+			"    args,",
+			"    task,",
+			"    pid: process.pid,",
+			"    child: process.env.PI_FORK_CHILD,",
+			"    parentPid: process.env.PI_FORK_PARENT_PID,",
+			"  }));",
+			`  const report = () => {`,
+			`    const completion = ${JSON.stringify(completion)};`,
+			"    if (completion && sessionFile) {",
+			"      appendFileSync(sessionFile, JSON.stringify({",
+			'        type: "custom",',
+			'        id: "completion",',
+			"        parentId: null,",
+			"        timestamp: new Date().toISOString(),",
+			'        customType: "fork-completion",',
+			"        data: { forkId, ...completion },",
+			'      }) + "\\n");',
+			"    }",
+			"  };",
+			`  const heartbeat = ${JSON.stringify(heartbeat)};`,
+			"  if (heartbeat) {",
+			'    setInterval(() => appendFileSync(heartbeat, "."), 50);',
+			"    return;",
+			"  }",
+			`  const delay = ${JSON.stringify(delayMs)};`,
+			"  if (delay > 0) {",
+			`    setTimeout(() => { report(); process.exit(${exitCode}); }, delay);`,
+			"    return;",
+			"  }",
+			"  report();",
+			`  process.exit(${exitCode});`,
+			"});",
