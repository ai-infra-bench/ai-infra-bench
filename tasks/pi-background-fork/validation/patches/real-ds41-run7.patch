+		},
+		shutdown: async () => {
+			await handlers.get("session_shutdown")?.({ type: "session_shutdown", reason: "quit" }, ctx);
+		},
+	};
+}
+
+async function runFork(harness: ForkHarness, task: string, toolCallId = "tc-fork") {
+	const result = await harness.tool.execute(toolCallId, { task }, undefined, undefined, harness.ctx);
+	return result as { content: { type: string; text: string }[]; details: { forkId: string } };
+}
+
+async function waitFor(condition: () => boolean, timeoutMs = 8000): Promise<void> {
+	const deadline = Date.now() + timeoutMs;
+	while (Date.now() < deadline) {
+		if (condition()) return;
+		await new Promise((resolve) => setTimeout(resolve, 20));
+	}
+	throw new Error("Timed out waiting for condition");
+}
+
+function readJsonLines(file: string): Record<string, unknown>[] {
+	return readFileSync(file, "utf8")
+		.split("\n")
+		.filter((line) => line.trim().length > 0)
+		.map((line) => JSON.parse(line) as Record<string, unknown>);
+}
+
+function findForkSessionFile(dir: string, forkId: string): string {
+	const match = readdirSync(dir).find((name) => name.endsWith(`${forkId}.jsonl`));
+	if (!match) throw new Error(`no session file for ${forkId} in ${dir}: ${readdirSync(dir).join(", ")}`);
+	return join(dir, match);
+}
+
+interface FakeRecord {
+	args: string[];
+	task: string;
+	pid: number;
+	child?: string;
+	parentPid?: string;
+}
+
+function readRecord(records: string, forkId: string): FakeRecord {
+	return JSON.parse(readFileSync(join(records, `${forkId}.json`), "utf8")) as FakeRecord;
+}
