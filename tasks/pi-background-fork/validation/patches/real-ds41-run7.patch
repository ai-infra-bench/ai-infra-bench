+/**
+ * Tests for the `fork` example extension.
+ *
+ * The extension starts a separate pi process per fork. These tests replace that
+ * process with a small script (PI_FORK_CLI) that records how it was invoked and
+ * writes the same `fork-completion` entry a real fork writes, so the whole
+ * parent-side flow runs offline.
+ */
+
+import { mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import type { AssistantMessage, ToolCall, Usage } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from "../src/core/extensions/index.ts";
+import { type FileEntry, type SessionEntry, SessionManager } from "../src/core/session-manager.ts";
+
+const FORK_STARTED_TEXT = (forkId: string) => `Fork ${forkId} started in the background.`;
+const SIBLING_PLACEHOLDER =
+	"(This tool call was still running when the fork started, so its result is not available in the fork.)";
+
+const USAGE: Usage = {
+	input: 0,
+	output: 0,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 0,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+
+let tempDirs: string[] = [];
+
+afterEach(() => {
+	delete process.env.PI_FORK_CHILD;
+	for (const dir of tempDirs) rmSync(dir, { recursive: true, force: true });
+	tempDirs = [];
+});
+
+function createTempDir(): string {
+	const dir = mkdtempSync(join(tmpdir(), "pi-fork-test-"));
+	tempDirs.push(dir);
+	return dir;
+}
+
+function iso(ms: number): string {
+	return new Date(ms).toISOString();
+}
+
+function userEntry(id: string, parentId: string | null, text: string, at: number): SessionEntry {
+	return {
+		type: "message",
+		id,
+		parentId,
+		timestamp: iso(at),
+		message: { role: "user", content: text, timestamp: at },
+	};
+}
+
+function assistantEntry(
+	id: string,
+	parentId: string | null,
+	content: AssistantMessage["content"],
+	at: number,
+	stopReason: AssistantMessage["stopReason"] = "toolUse",
+): SessionEntry {
+	const message: AssistantMessage = {
+		role: "assistant",
+		content,
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "claude-sonnet-4-5",
+		usage: USAGE,
+		stopReason,
+		timestamp: at,
+	};
+	return { type: "message", id, parentId, timestamp: iso(at), message };
+}
+
+function toolCall(id: string, name: string, args: Record<string, unknown>): ToolCall {
+	return { type: "toolCall", id, name, arguments: args };
+}
+
+function text(value: string): { type: "text"; text: string } {
+	return { type: "text", text: value };
+}
+
+/** Parent session with a preceding conversation and one assistant message with tool calls. */
+function simpleParentEntries(forkToolCallId = "tc-fork"): SessionEntry[] {
+	return [
+		userEntry("u1", null, "refactor the parser", 1_000),
+		assistantEntry("a1", "u1", [text("Starting.")], 1_100, "stop"),
+		userEntry("u2", "a1", "also check the other call sites", 1_200),
+		assistantEntry(
