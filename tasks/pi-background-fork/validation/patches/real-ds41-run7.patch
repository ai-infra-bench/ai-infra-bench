+}
+
+function writeSessionFile(dir: string, name: string, entries: FileEntry[]): string {
+	const file = join(dir, name);
+	writeFileSync(file, `${entries.map((entry) => JSON.stringify(entry)).join("\n")}\n`);
+	return file;
+}
+
+function parentHeader(id: string, cwd: string, parentSession?: string): FileEntry {
+	return { type: "session", version: 3, id, timestamp: iso(0), cwd, ...(parentSession ? { parentSession } : {}) };
+}
+
+interface FakeCompletion {
+	status: "completed" | "failed";
+	content?: string;
+	error?: string;
+}
+
+/** Write the fake pi CLI: records its argv, reads the task from stdin, then reports. */
+function writeFakeCli(
+	dir: string,
