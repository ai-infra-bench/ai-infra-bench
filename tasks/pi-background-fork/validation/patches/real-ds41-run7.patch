+async function waitForRecord(records: string, forkId: string): Promise<FakeRecord> {
+	await waitFor(() => readdirSync(records).includes(`${forkId}.json`));
+	return readRecord(records, forkId);
+}
+
+async function countForkResults(harness: ForkHarness, forkId: string): Promise<number> {
+	return harness.sessionManager
+		.getEntries()
+		.filter(
+			(entry) =>
+				entry.type === "custom_message" &&
+				entry.customType === "fork-result" &&
+				(entry.details as { forkId?: string } | undefined)?.forkId === forkId,
+		).length;
+}
+
+function fileSize(file: string): number {
+	try {
+		return readFileSync(file).length;
+	} catch {
+		return 0;
+	}
+}
+
+function isProcessAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch {
+		return false;
+	}
+}
