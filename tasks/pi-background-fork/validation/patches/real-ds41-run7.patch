+}
+
+interface SentMessage {
+	customType: string;
+	content: string;
+	display: boolean;
+	details: { forkId: string; status: string; sessionFile?: string; error?: string };
+}
+
+interface ForkHarness {
+	tool: ToolDefinition;
+	handlers: Map<string, (event: unknown, ctx: ExtensionContext) => unknown>;
+	sent: SentMessage[];
+	sentOptions: unknown[];
+	sessionManager: SessionManager;
+	sessionFile: string;
+	parentCwd: string;
+	ctx: ExtensionContext;
+	appendEntry: ReturnType<typeof vi.fn>;
