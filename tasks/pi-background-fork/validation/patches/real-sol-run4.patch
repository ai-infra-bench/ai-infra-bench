@@ -0,0 +1,240 @@
+import { EventEmitter } from "node:events";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { PassThrough } from "node:stream";
+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+import { type ExtensionAPI, type ExtensionContext, SessionManager } from "../src/index.ts";
+
+const spawned: FakeChild[] = [];
+const spawnCalls: { args: string[]; env: NodeJS.ProcessEnv }[] = [];
+
+class FakeChild extends EventEmitter {
+	stdout = new PassThrough();
+	stderr = new PassThrough();
+	exitCode: number | null = null;
+	signalCode: NodeJS.Signals | null = null;
+	kill = vi.fn(() => true);
+}
+
+vi.mock("node:child_process", () => ({
+	spawn: (_command: string, args: string[], options: { env: NodeJS.ProcessEnv }) => {
+		const child = new FakeChild();
+		spawned.push(child);
+		spawnCalls.push({ args, env: options.env });
+		queueMicrotask(() => child.emit("spawn"));
+		return child;
+	},
+}));
+
+type ToolResult = { content: { type: string; text: string }[]; details?: { forkId: string }; isError?: boolean };
+type ForkTool = {
+	execute: (
+		id: string,
+		params: { task: string },
+		signal: undefined,
+		onUpdate: undefined,
+		ctx: ExtensionContext,
+	) => Promise<ToolResult>;
+};
+
+function assistant(calls: string[]): AssistantMessage {
+	return {
+		role: "assistant",
+		content: calls.map((id) => ({ type: "toolCall", id, name: "fork", arguments: { task: id } })),
+		stopReason: "toolUse",
+		timestamp: Date.now(),
+	} as unknown as AssistantMessage;
+}
+
+function setup(manager: SessionManager, start = true) {
+	const handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => void>();
+	let tool: ForkTool | undefined;
+	const sendMessage = vi.fn();
+	const api = {
+		on: (event: string, handler: (event: unknown, ctx: ExtensionContext) => void) => handlers.set(event, handler),
+		registerTool: (definition: ForkTool) => {
+			tool = definition;
+		},
+		sendMessage,
+	} as unknown as ExtensionAPI;
+	forkExtension(api);
+	const ctx = {
+		cwd: manager.getCwd(),
+		model: { provider: "test", id: "offline" },
+		thinkingLevel: "high",
+		sessionManager: manager,
+	} as unknown as ExtensionContext;
+	const emit = (name: string, event: unknown = {}) => handlers.get(name)?.(event, ctx);
+	if (start) emit("session_start", { type: "session_start", reason: "startup" });
+	return {
+		tool: () => {
+			if (!tool) throw new Error("fork tool missing");
+			return tool;
+		},
+		emit,
+		sendMessage,
+		ctx,
+	};
+}
+
+function finish(child: FakeChild, text: string, stopReason: "stop" | "error" = "stop", errorMessage?: string) {
+	child.stdout.write(
+		`${JSON.stringify({
+			type: "message_end",
+			message: { role: "assistant", content: [{ type: "text", text }], stopReason, errorMessage },
+		})}\n`,
+	);
+	child.emit("close", 0, null);
+}
+
+describe("fork example extension", () => {
+	let tempDir: string;
+	let manager: SessionManager;
+
+	beforeEach(() => {
+		tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "pi-fork-test-"));
+		manager = SessionManager.create(tempDir, tempDir);
+		spawned.length = 0;
+		spawnCalls.length = 0;
+	});
+
+	afterEach(() => {
+		const active = (globalThis as typeof globalThis & { __piExampleForkState?: { closed: boolean } })
+			.__piExampleForkState;
+		if (active) active.closed = true;
+		fs.rmSync(tempDir, { recursive: true, force: true });
+	});
+
+	test("rejects a blank task without starting a process", async () => {
+		const extension = setup(manager);
+		const result = await extension.tool().execute("call-1", { task: "  " }, undefined, undefined, extension.ctx);
+		expect(result.isError).toBe(true);
+		expect(spawned).toHaveLength(0);
+	});
+
+	test("starts concurrent forks with a compacted request snapshot and linked sessions", async () => {
+		const extension = setup(manager);
+		const request = {
+			role: "user" as const,
+			content: [{ type: "text" as const, text: "compacted context" }],
+			timestamp: 1,
+		};
+		extension.emit("context", { type: "context", messages: [request] });
+		manager.appendMessage(request);
+		manager.appendMessage(assistant(["call-1", "call-2"]));
+
+		const [first, second] = await Promise.all([
+			extension.tool().execute("call-1", { task: "investigate one" }, undefined, undefined, extension.ctx),
+			extension.tool().execute("call-2", { task: "investigate two" }, undefined, undefined, extension.ctx),
+		]);
+		expect(first.details?.forkId).toBeTruthy();
+		expect(second.details?.forkId).not.toBe(first.details?.forkId);
+		expect(spawnCalls).toHaveLength(2);
+		expect(spawnCalls[0].args).toContain("test/offline");
+		expect(spawnCalls[0].args).toContain("high");
+		expect(spawnCalls[0].env.PI_FORK_PARENT_PID).toBe(String(process.pid));
+		for (const call of spawnCalls) {
+			const sessionFile = call.args[call.args.indexOf("--session") + 1];
+			const lines = fs
+				.readFileSync(sessionFile, "utf8")
+				.trim()
+				.split("\n")
+				.map((line) => JSON.parse(line) as Record<string, unknown>);
+			expect(lines[0].parentSession).toBe(manager.getSessionFile());
+			expect((lines[1].message as { content: { text: string }[] }).content[0].text).toBe("compacted context");
+			expect(
+				lines.filter((line) => (line.message as { role?: string } | undefined)?.role === "toolResult"),
+			).toHaveLength(2);
+		}
+
+		finish(spawned[1], "answer two");
+		finish(spawned[0], "answer one");
+		expect(extension.sendMessage).toHaveBeenCalledTimes(2);
+		const messages = extension.sendMessage.mock.calls.map(
+			([message]) =>
+				message as {
+					customType: string;
+					content: string;
+					details: { forkId: string; status: string; sessionFile: string };
+				},
+		);
+		expect(messages.map((message) => message.details.forkId)).toEqual([
+			second.details?.forkId,
+			first.details?.forkId,
+		]);
+		expect(messages.map((message) => message.content)).toEqual(["answer two", "answer one"]);
+		expect(
+			messages.every((message) => message.customType === "fork-result" && message.details.status === "completed"),
+		).toBe(true);
+		extension.emit("session_shutdown", { type: "session_shutdown", reason: "quit" });
+	});
+
+	test("reports provider errors and stops a fork when the session changes", async () => {
+		const extension = setup(manager);
+		extension.emit("context", { type: "context", messages: [] });
+		manager.appendMessage(assistant(["call-1", "call-2"]));
+		await extension.tool().execute("call-1", { task: "one" }, undefined, undefined, extension.ctx);
+		await extension.tool().execute("call-2", { task: "two" }, undefined, undefined, extension.ctx);
+		finish(spawned[0], "", "error", "provider rejected request");
+		expect(extension.sendMessage.mock.calls[0][0]).toMatchObject({
+			content: "provider rejected request",
+			details: { status: "failed", error: "provider rejected request" },
+		});
+		extension.emit("session_shutdown", { type: "session_shutdown", reason: "new" });
+		expect(spawned[1].kill).toHaveBeenCalledWith("SIGTERM");
+		finish(spawned[1], "late answer");
+		expect(extension.sendMessage).toHaveBeenCalledTimes(1);
+	});
+
+	test("redelivers a result discarded by Escape and rebinds delivery after reload", async () => {
+		const extension = setup(manager);
+		extension.emit("context", { type: "context", messages: [] });
+		manager.appendMessage(assistant(["call-1"]));
+		const started = await extension
+			.tool()
+			.execute("call-1", { task: "inspect" }, undefined, undefined, extension.ctx);
+		extension.emit("session_shutdown", { type: "session_shutdown", reason: "reload" });
+		const reloaded = setup(manager, false);
+		reloaded.emit("session_start", { type: "session_start", reason: "reload" });
+		finish(spawned[0], "investigation result");
+		expect(reloaded.sendMessage).toHaveBeenCalledTimes(1);
+		expect(extension.sendMessage).not.toHaveBeenCalled();
+
+		// The first steering message is discarded by Escape. Once the run settles,
+		// the result is sent again. A later context request acknowledges delivery.
+		reloaded.emit("agent_settled", { type: "agent_settled" });
+		expect(reloaded.sendMessage).toHaveBeenCalledTimes(2);
+		reloaded.emit("context", {
+			type: "context",
+			messages: [
