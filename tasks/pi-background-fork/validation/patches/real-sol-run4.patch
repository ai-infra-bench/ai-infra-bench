+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync } from "node:fs";
+import { basename } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import {
+	convertToLlm,
+	type ExtensionAPI,
+	type ExtensionContext,
+	SessionManager,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const PARENT_PID_ENV = "PI_FORK_PARENT_PID";
+
+interface ForkResultDetails {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface PendingResult {
+	details: ForkResultDetails;
+	content: string;
+	seen: boolean;
+}
+
+interface ForkState {
+	sessionId: string;
+	api: ExtensionAPI;
+	context: AgentMessage[];
+	inNextRequest: Set<string>;
+	children: Map<string, ChildProcess>;
+	pending: Map<string, PendingResult>;
+	closed: boolean;
+}
+
+// The extension module is evaluated again on /reload. Keep running processes and
+// their delivery state in the pi process, then bind the new ExtensionAPI to them.
+const processState = globalThis as typeof globalThis & {
+	__piExampleForkState?: ForkState;
+	__piExampleForkExitInstalled?: boolean;
+};
+
+function stopForks(state: ForkState): void {
+	state.closed = true;
+	state.pending.clear();
+	for (const child of state.children.values()) {
+		child.kill("SIGTERM");
+		const timer = setTimeout(() => {
+			if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+		}, 3_000);
+		timer.unref();
+	}
+	state.children.clear();
+}
+
+function deliver(state: ForkState, result: PendingResult): void {
+	if (state.closed || result.seen) return;
+	state.api.sendMessage(
+		{
+			customType: "fork-result",
+			content: result.content,
+			display: true,
+			details: result.details,
+		},
+		{ triggerTurn: true, deliverAs: "steer" },
+	);
+}
+
+function report(state: ForkState, details: ForkResultDetails, content: string): void {
+	if (state.closed) return;
+	const result: PendingResult = { details, content, seen: false };
+	state.pending.set(details.forkId, result);
+	deliver(state, result);
+}
+
+function getInvocation(args: string[]): { command: string; args: string[] } {
+	const script = process.argv[1];
+	if (script && !script.startsWith("/$bunfs/root/") && existsSync(script)) {
+		return { command: process.execPath, args: [script, ...args] };
+	}
+	if (!/^(node|bun)(\.exe)?$/i.test(basename(process.execPath))) {
+		return { command: process.execPath, args };
+	}
+	return { command: "pi", args };
+}
+
+function seedSession(
+	ctx: ExtensionContext,
+	state: ForkState,
+	assistant: AssistantMessage,
+	toolCallId: string,
+	forkId: string,
+): string {
+	const parentSession = ctx.sessionManager.getSessionFile();
+	if (!parentSession) throw new Error("fork requires a saved parent session");
+	const manager = SessionManager.create(ctx.cwd, ctx.sessionManager.getSessionDir(), { parentSession });
+	for (const message of convertToLlm(state.context)) manager.appendMessage(message);
+	manager.appendMessage(assistant);
+	const recordedResults = new Map<string, ToolResultMessage>();
+	for (const entry of ctx.sessionManager.getEntries()) {
+		if (entry.type === "message" && entry.message.role === "toolResult") {
+			recordedResults.set(entry.message.toolCallId, entry.message);
+		}
+	}
+	for (const call of assistant.content) {
+		if (call.type !== "toolCall") continue;
+		const recorded = recordedResults.get(call.id);
+		if (recorded) {
+			manager.appendMessage(recorded);
+			continue;
+		}
+		const ownCall = call.id === toolCallId;
+		const result: ToolResultMessage = {
+			role: "toolResult",
+			toolCallId: call.id,
+			toolName: call.name,
+			content: [
+				{
+					type: "text",
+					text: ownCall ? `Fork ${forkId} started.` : "This tool's result was pending when the fork started.",
+				},
+			],
+			isError: false,
+			timestamp: Date.now(),
+		};
+		manager.appendMessage(result);
+	}
+	const file = manager.getSessionFile();
+	if (!file) throw new Error("fork could not create a session file");
+	return file;
+}
+
+export default function (pi: ExtensionAPI) {
+	// The same settings load this extension in every fork. A fork only watches its
+	// parent and never registers the tool, so recursion is impossible.
+	const parentPid = Number(process.env[PARENT_PID_ENV]);
+	if (Number.isSafeInteger(parentPid) && parentPid > 0) {
+		const timer = setInterval(() => {
+			if (process.ppid !== parentPid) process.exit(143);
+		}, 250);
+		timer.unref();
+		return;
+	}
+
+	let state = processState.__piExampleForkState;
+	if (state && !state.closed) state.api = pi;
+
+	pi.on("session_start", (event, ctx) => {
+		if (event.reason === "reload" && state && !state.closed) {
+			state.api = pi;
+			return;
+		}
+		if (state && !state.closed) stopForks(state);
+		state = {
+			sessionId: ctx.sessionManager.getSessionId(),
+			api: pi,
+			context: [],
+			inNextRequest: new Set(),
+			children: new Map(),
+			pending: new Map(),
+			closed: false,
+		};
+		processState.__piExampleForkState = state;
+	});
+
+	pi.on("session_shutdown", (event) => {
+		if (event.reason !== "reload" && state && !state.closed) stopForks(state);
+	});
+
+	pi.on("context", (event) => {
+		if (!state || state.closed) return;
+		state.context = structuredClone(event.messages);
+		state.inNextRequest.clear();
+		for (const message of event.messages) {
+			if (message.role !== "custom" || message.customType !== "fork-result") continue;
+			const details = message.details as ForkResultDetails | undefined;
+			if (details && state.pending.has(details.forkId)) state.inNextRequest.add(details.forkId);
+		}
+	});
+
+	pi.on("before_provider_request", () => {
+		if (!state || state.closed) return;
+		for (const id of state.inNextRequest) {
+			const result = state.pending.get(id);
+			if (result) result.seen = true;
+		}
+		state.inNextRequest.clear();
+	});
+
+	pi.on("agent_settled", (_event, ctx) => {
+		if (!state || state.closed || ctx.sessionManager.getSessionId() !== state.sessionId) return;
+		for (const result of state.pending.values()) {
+			if (result.seen) continue;
+			const persisted = ctx.sessionManager
+				.getEntries()
+				.some(
+					(entry) =>
+						entry.type === "custom_message" &&
+						entry.customType === "fork-result" &&
+						(entry.details as ForkResultDetails | undefined)?.forkId === result.details.forkId,
+				);
+			if (persisted) {
+				// Escape can stop a run after the result was recorded but before a model
+				// request. Wake the model without recording the result a second time.
+				state.api.sendMessage({ customType: "fork-resume", content: "", display: false }, { triggerTurn: true });
+			} else {
+				deliver(state, result);
+			}
+		}
+	});
+
+	if (!processState.__piExampleForkExitInstalled) {
+		processState.__piExampleForkExitInstalled = true;
+		process.once("exit", () => {
+			const active = processState.__piExampleForkState;
+			if (active && !active.closed) stopForks(active);
+		});
+	}
+
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description:
+			"Start a background pi process with this conversation and a separate task. Its result returns later.",
+		parameters: Type.Object({ task: Type.String() }),
+		executionMode: "parallel",
+		async execute(toolCallId, params, _signal, _onUpdate, ctx) {
+			if (!params.task.trim()) {
+				return { content: [{ type: "text", text: "Fork task must not be empty." }], details: {}, isError: true };
+			}
+			if (!state || state.closed || state.sessionId !== ctx.sessionManager.getSessionId()) {
+				return { content: [{ type: "text", text: "Fork session is unavailable." }], details: {}, isError: true };
+			}
+			if (!ctx.model) {
+				return { content: [{ type: "text", text: "Fork requires an active model." }], details: {}, isError: true };
+			}
+			const forkState = state;
+			const assistant = [...ctx.sessionManager.getEntries()]
+				.reverse()
+				.find(
+					(entry) =>
+						entry.type === "message" &&
+						entry.message.role === "assistant" &&
+						entry.message.content.some((part) => part.type === "toolCall" && part.id === toolCallId),
+				);
+			if (!assistant || assistant.type !== "message" || assistant.message.role !== "assistant") {
+				return {
+					content: [{ type: "text", text: "Fork could not find its assistant message." }],
+					details: {},
+					isError: true,
+				};
+			}
+			const forkId = randomUUID();
+			let sessionFile: string | undefined;
+			try {
+				sessionFile = seedSession(ctx, forkState, assistant.message, toolCallId, forkId);
+				const args = [
+					"--mode",
+					"json",
+					"--print",
+					"--session",
+					sessionFile,
+					"--model",
+					`${ctx.model.provider}/${ctx.model.id}`,
+					"--thinking",
+					ctx.thinkingLevel ?? "off",
+					params.task,
+				];
+				const invocation = getInvocation(args);
+				const child = spawn(invocation.command, invocation.args, {
+					cwd: ctx.cwd,
+					env: { ...process.env, [PARENT_PID_ENV]: String(process.pid) },
+					stdio: ["ignore", "pipe", "pipe"],
+				});
+				await new Promise<void>((resolve, reject) => {
+					child.once("spawn", resolve);
+					child.once("error", reject);
+				});
+				if (forkState.closed) {
+					child.kill("SIGTERM");
+					return {
+						content: [{ type: "text", text: "Fork session ended before the process started." }],
+						details: {},
+						isError: true,
+					};
+				}
+				forkState.children.set(forkId, child);
+				let stdout = "";
+				let stderr = "";
+				let lastAssistant: AssistantMessage | undefined;
+				child.stdout?.setEncoding("utf8");
+				child.stdout?.on("data", (chunk: string) => {
+					stdout += chunk;
+					let newline = stdout.indexOf("\n");
+					while (newline >= 0) {
+						const line = stdout.slice(0, newline);
+						stdout = stdout.slice(newline + 1);
+						try {
+							const event = JSON.parse(line) as { type?: string; message?: AssistantMessage };
+							if (event.type === "message_end" && event.message?.role === "assistant")
+								lastAssistant = event.message;
+						} catch {
+							/* ignore non-JSON output */
+						}
+						newline = stdout.indexOf("\n");
+					}
+				});
+				child.stderr?.setEncoding("utf8");
+				child.stderr?.on("data", (chunk: string) => {
+					stderr += chunk;
+				});
+				child.once("close", (code, signal) => {
+					forkState.children.delete(forkId);
+					if (forkState.closed) return;
+					const modelError = lastAssistant?.stopReason === "error" || lastAssistant?.stopReason === "aborted";
+					const failed = code !== 0 || signal !== null || modelError || !lastAssistant;
+					const reason = modelError
+						? lastAssistant?.errorMessage || `Model response ended with ${lastAssistant?.stopReason}`
+						: signal
+							? `Fork process was killed by ${signal}`
+							: code !== 0
+								? stderr.trim() || `Fork process exited with code ${code}`
+								: !lastAssistant
+									? stderr.trim() || "Fork produced no assistant response"
+									: undefined;
+					const content = failed
+						? reason || "Fork failed"
+						: (lastAssistant?.content ?? [])
+								.filter((part) => part.type === "text")
+								.map((part) => part.text)
+								.join("");
+					report(
+						forkState,
+						{
+							forkId,
+							status: failed ? "failed" : "completed",
+							sessionFile,
+							...(failed ? { error: content } : {}),
+						},
+						content,
+					);
+				});
+				return { content: [{ type: "text", text: `Fork ${forkId} started.` }], details: { forkId } };
+			} catch (error) {
+				return {
+					content: [{ type: "text", text: error instanceof Error ? error.message : String(error) }],
+					details: {},
+					isError: true,
+				};
+			}
+		},
+	});
+}
