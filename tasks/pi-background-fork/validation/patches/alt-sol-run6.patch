@@ -0,0 +1,251 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { EventEmitter } from "node:events";
+import { readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { PassThrough } from "node:stream";
+import type { AssistantMessage, UserMessage } from "@earendil-works/pi-ai";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import forkExtension, { writeForkSession } from "../examples/extensions/fork/index.ts";
+import { createCompactionSummaryMessage } from "../src/core/messages.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+vi.mock("node:child_process", () => ({ spawn: vi.fn() }));
+
+const usage: AssistantMessage["usage"] = {
+	input: 0,
+	output: 0,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 0,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+
+function assistant(
+	content: AssistantMessage["content"],
+	stopReason: AssistantMessage["stopReason"] = "toolUse",
+): AssistantMessage {
+	return {
+		role: "assistant",
+		api: "openai-responses",
+		provider: "openai",
+		model: "test-model",
+		content,
+		usage,
+		stopReason,
+		timestamp: Date.now(),
+	};
+}
+
+class FakeChild extends EventEmitter {
+	stdout = new PassThrough();
+	stderr = new PassThrough();
+	exitCode: number | null = null;
+	kill = vi.fn(() => true);
+}
+
+const dirs: string[] = [];
+afterEach(() => {
+	for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+	vi.clearAllMocks();
+});
+
+function parentSession(): { session: SessionManager; dir: string; user: UserMessage; call: AssistantMessage } {
+	const dir = join(tmpdir(), `pi-fork-test-${crypto.randomUUID()}`);
+	dirs.push(dir);
+	const session = SessionManager.create(dir, dir);
+	const user: UserMessage = { role: "user", content: "Investigate the bug", timestamp: Date.now() };
+	const call = assistant([
+		{ type: "toolCall", id: "fork-call", name: "fork", arguments: { task: "Check peers" } },
+		{ type: "toolCall", id: "read-call", name: "read", arguments: { path: "a.ts" } },
+		{ type: "toolCall", id: "peer-fork", name: "fork", arguments: { task: "Check another path" } },
+	]);
+	session.appendMessage(user);
+	session.appendMessage(call);
+	return { session, dir, user, call };
+}
+
+describe("fork extension", () => {
+	it("creates an independent session with the request, assistant, and one result per tool call", () => {
+		const { session, dir, user, call } = parentSession();
+		const compacted = createCompactionSummaryMessage("Earlier context", 100, new Date().toISOString());
+		const file = writeForkSession(dir, session.getSessionFile()!, dir, [compacted, user], call, "fork-call");
+		const lines = readFileSync(file, "utf8")
+			.trim()
+			.split("\n")
+			.map((line) => JSON.parse(line) as Record<string, unknown>);
+		expect(lines[0]).toMatchObject({ type: "session", parentSession: session.getSessionFile() });
+		const copy = SessionManager.open(file);
+		const messages = copy.buildSessionContext().messages;
+		expect(messages.map((message) => message.role)).toEqual([
+			"compactionSummary",
+			"user",
+			"assistant",
+			"toolResult",
+			"toolResult",
+			"toolResult",
+		]);
+		expect(messages[0]).toEqual(compacted);
+		expect(messages[1]).toEqual(user);
+		expect(messages[2]).toEqual(call);
+		expect(messages.slice(3).map((message) => (message.role === "toolResult" ? message.toolCallId : ""))).toEqual([
+			"fork-call",
+			"read-call",
+			"peer-fork",
+		]);
+	});
+
+	it("delivers after completion, retries a discarded queue, and stops active forks on switch", async () => {
+		const { session, dir, user } = parentSession();
+		const child = new FakeChild();
+		vi.mocked(spawn).mockReturnValue(child as unknown as ChildProcess);
+		const handlers = new Map<string, (event: never, ctx: ExtensionContext) => void>();
+		const sent: Array<{ message: { customType: string; content: string; details?: unknown }; options?: unknown }> =
+			[];
+		let tool: Parameters<ExtensionAPI["registerTool"]>[0] | undefined;
+		const pi = {
+			on: (name: string, handler: (event: never, ctx: ExtensionContext) => void) => handlers.set(name, handler),
+			registerTool: (definition: Parameters<ExtensionAPI["registerTool"]>[0]) => {
+				tool = definition;
+			},
+			sendMessage: (message: { customType: string; content: string; details?: unknown }, options?: unknown) =>
+				sent.push({ message, options }),
+		} as unknown as ExtensionAPI;
+		const ctx = {
+			sessionManager: session,
+			cwd: dir,
+			model: { provider: "openai", id: "test-model" },
+			thinkingLevel: "high",
+			isIdle: () => false,
+			signal: new AbortController().signal,
+		} as unknown as ExtensionContext;
+		forkExtension(pi);
+		handlers.get("session_start")?.({ type: "session_start", reason: "startup" } as never, ctx);
+		handlers.get("context")?.({ type: "context", messages: [user] } as never, ctx);
+		const started = tool!.execute("fork-call", { task: "Check peers" }, undefined, undefined, ctx);
+		child.emit("spawn");
+		const result = await started;
+		const forkId = (result.details as { forkId: string }).forkId;
+		expect(forkId).toBeTruthy();
+		expect(vi.mocked(spawn)).toHaveBeenCalledOnce();
+		const args = vi.mocked(spawn).mock.calls[0][1]!;
+		expect(args).toContain("--session");
+		expect(args).toContain("openai/test-model");
+		expect(args).toContain("high");
+		expect(args.at(-2)).toBe("--");
+		expect(args.at(-1)).toBe("Task:\nCheck peers");
+		const sessionFile = args[args.indexOf("--session") + 1];
+		expect(SessionManager.open(sessionFile).getHeader()?.parentSession).toBe(session.getSessionFile());
+		child.stdout.write(
+			`${JSON.stringify({ type: "message_end", message: assistant([{ type: "text", text: "Peer call has the same bug." }], "stop") })}\n`,
+		);
+		await new Promise((resolve) => setImmediate(resolve));
+		child.emit("close", 0, null);
+		expect(sent).toHaveLength(1);
+		expect(sent[0].message).toMatchObject({
+			customType: "fork-result",
+			content: expect.stringContaining("Peer call has the same bug."),
+			details: { forkId, status: "completed", sessionFile },
+		});
+		// Escape discards queued messages. An unsettled result is sent again.
+		handlers.get("agent_settled")?.({ type: "agent_settled" } as never, ctx);
+		expect(sent).toHaveLength(2);
+		expect(sent[1].message.details).toEqual(sent[0].message.details);
+		handlers.get("context")?.(
+			{
+				type: "context",
+				messages: [
+					{
+						role: "custom",
+						customType: "fork-result",
+						content: sent[1].message.content,
+						display: true,
+						details: sent[1].message.details,
+						timestamp: Date.now(),
+					},
+				],
+			} as never,
+			ctx,
+		);
+		handlers.get("before_provider_request")?.({ type: "before_provider_request", payload: {} } as never, ctx);
+		handlers.get("agent_settled")?.({ type: "agent_settled" } as never, ctx);
+		expect(sent).toHaveLength(2);
+
+		handlers.get("context")?.({ type: "context", messages: [user] } as never, ctx);
+		const failing = new FakeChild();
+		vi.mocked(spawn).mockReturnValueOnce(failing as unknown as ChildProcess);
+		const failedStart = tool!.execute("fork-call", { task: "Check failure" }, undefined, undefined, ctx);
+		failing.emit("spawn");
+		await failedStart;
+		failing.stdout.write(
+			`${JSON.stringify({ type: "message_end", message: { ...assistant([], "error"), errorMessage: "Provider quota exhausted" } })}\n`,
+		);
+		await new Promise((resolve) => setImmediate(resolve));
+		failing.emit("close", 0, null);
+		expect(sent[2].message).toMatchObject({
+			customType: "fork-result",
+			content: expect.stringContaining("Provider quota exhausted"),
+			details: { status: "failed", error: "Provider quota exhausted" },
+		});
+
+		handlers.get("context")?.({ type: "context", messages: [user] } as never, ctx);
+		const reloading = new FakeChild();
+		vi.mocked(spawn).mockReturnValueOnce(reloading as unknown as ChildProcess);
+		const reloadStart = tool!.execute("fork-call", { task: "Finish during reload" }, undefined, undefined, ctx);
