index 0000000000000000000000000000000000000000..fce0327d2afdbe26ce3e5234aae96058ac8aeb8e
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/fork/index.ts
@@ -0,0 +1,358 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { basename, resolve } from "node:path";
+import { createInterface } from "node:readline";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import { type ExtensionAPI, type ExtensionContext, SessionManager } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const CHILD_ENV = "PI_FORK_CHILD";
+const PARENT_PID_ENV = "PI_FORK_PARENT_PID";
+
+interface ForkResult {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface PendingResult {
+	details: ForkResult;
+	text: string;
+	queued: boolean;
+	seen: boolean;
+}
+
+interface ForkState {
+	sessionFile: string;
+	pi: ExtensionAPI;
+	ctx: ExtensionContext;
+	active: boolean;
+	reloading: boolean;
+	children: Set<ChildProcess>;
+	pending: Map<string, PendingResult>;
+	requestMessages?: AgentMessage[];
+	requestResultIds: Set<string>;
+}
+
+type ForkGlobal = typeof globalThis & { __piForkStates?: Map<string, ForkState> };
+
+function states(): Map<string, ForkState> {
+	const global = globalThis as ForkGlobal;
+	if (!global.__piForkStates) global.__piForkStates = new Map();
+	return global.__piForkStates;
+}
+
+function messageText(message: AssistantMessage): string {
+	return message.content
+		.filter((part) => part.type === "text")
+		.map((part) => part.text)
+		.join("");
+}
+
+function errorText(error: unknown): string {
+	return error instanceof Error ? error.message : String(error);
+}
+
+/** Write a frozen model context as an ordinary, independently owned pi session. */
+export function writeForkSession(
+	sessionDir: string,
+	parentSession: string,
+	cwd: string,
+	messages: AgentMessage[],
+	assistant: AssistantMessage,
+	forkToolCallId: string,
+): string {
+	const session = SessionManager.create(cwd, sessionDir, { parentSession });
+	const append = (message: AgentMessage): void => {
+		// The context can contain compaction/branch summaries. SessionManager stores
+		// them as messages and restores their original roles on this copied path.
+		session.appendMessage(message as Parameters<SessionManager["appendMessage"]>[0]);
+	};
+	for (const message of messages) append(message);
+	append(assistant);
+	for (const call of assistant.content) {
+		if (call.type !== "toolCall") continue;
+		const ownCall = call.name === "fork" && call.id === forkToolCallId;
+		const result: ToolResultMessage = {
+			role: "toolResult",
+			toolCallId: call.id,
+			toolName: call.name,
+			content: [
+				{
+					type: "text",
+					text: ownCall ? "Fork started in the parent session." : "Tool result is pending in the parent session.",
+				},
+			],
+			isError: false,
+			timestamp: Date.now(),
+		};
+		append(result);
+	}
+	const sessionFile = session.getSessionFile();
+	if (!sessionFile) throw new Error("Could not create fork session file");
+	return sessionFile;
+}
+
+function deliveredInSession(state: ForkState, forkId: string): boolean {
+	return state.ctx.sessionManager
+		.getEntries()
+		.some(
+			(entry) =>
+				entry.type === "custom_message" &&
+				entry.customType === "fork-result" &&
+				typeof entry.details === "object" &&
+				entry.details !== null &&
+				"forkId" in entry.details &&
+				entry.details.forkId === forkId,
+		);
+}
+
+function sendPending(state: ForkState, pending: PendingResult): void {
+	if (!state.active || state.reloading || pending.seen || pending.queued) return;
+	if (!state.ctx.isIdle() && !state.ctx.signal) {
+		const timer = setTimeout(() => sendPending(state, pending), 100);
+		timer.unref();
+		return;
+	}
+	if (deliveredInSession(state, pending.details.forkId)) {
+		// The result was persisted just before an abort. Start a turn so the model sees it.
+		state.pi.sendMessage({ customType: "fork-wakeup", content: "", display: false }, { triggerTurn: true });
+		pending.queued = true;
+		return;
+	}
+	pending.queued = true;
+	state.pi.sendMessage(
+		{ customType: "fork-result", content: pending.text, display: true, details: pending.details },
+		{ triggerTurn: true, deliverAs: "steer" },
+	);
+}
+
+function finish(state: ForkState, details: ForkResult, text: string): void {
+	if (!state.active || state.pending.has(details.forkId)) return;
+	const pending: PendingResult = { details, text, queued: false, seen: false };
+	state.pending.set(details.forkId, pending);
+	sendPending(state, pending);
+}
+
+function stop(state: ForkState): void {
+	state.active = false;
+	state.pending.clear();
+	states().delete(state.sessionFile);
+	for (const child of state.children) {
+		child.kill("SIGTERM");
+		const timer = setTimeout(() => {
+			if (child.exitCode === null) child.kill("SIGKILL");
+		}, 4000);
+		timer.unref();
+	}
+}
+
+function invocation(args: string[]): { command: string; args: string[] } {
+	const script = process.argv[1];
+	if (script && !script.startsWith("/$bunfs/root/")) {
+		return { command: process.execPath, args: [...process.execArgv, resolve(script), ...args] };
+	}
+	const executable = basename(process.execPath).toLowerCase();
+	return /^(node|bun)(\.exe)?$/.test(executable) ? { command: "pi", args } : { command: process.execPath, args };
+}
+
+export default function (pi: ExtensionAPI): void {
+	if (process.env[CHILD_ENV] === "1") {
+		const parentPid = Number(process.env[PARENT_PID_ENV]);
+		const watchdog = setInterval(() => {
+			if (!Number.isSafeInteger(parentPid) || process.ppid !== parentPid) process.exit(1);
+		}, 1000);
+		watchdog.unref();
+		return;
+	}
+
+	let state: ForkState | undefined;
+	pi.on("session_start", (_event, ctx) => {
+		const sessionFile = ctx.sessionManager.getSessionFile();
+		if (!sessionFile) return;
+		state = states().get(sessionFile);
+		if (state) {
+			state.pi = pi;
+			state.ctx = ctx;
+			state.reloading = false;
+		} else {
+			state = {
+				sessionFile,
+				pi,
+				ctx,
+				active: true,
+				reloading: false,
+				children: new Set(),
+				pending: new Map(),
+				requestResultIds: new Set(),
+			};
+			states().set(sessionFile, state);
+		}
+		for (const pending of state.pending.values()) {
+			pending.queued = false;
+			sendPending(state, pending);
+		}
+	});
+
+	pi.on("session_shutdown", (event) => {
+		if (event.reason === "reload") {
+			if (state) state.reloading = true;
+		} else if (state) {
+			stop(state);
+		}
+	});
+
+	pi.on("context", (event) => {
+		if (!state?.active) return;
+		state.requestResultIds.clear();
+		for (const message of event.messages) {
+			if (message.role !== "custom" || message.customType !== "fork-result") continue;
+			const details = message.details;
+			if (typeof details !== "object" || details === null || !("forkId" in details)) continue;
+			state.requestResultIds.add(String(details.forkId));
+		}
+		state.requestMessages = structuredClone(event.messages);
+	});
+
+	pi.on("before_provider_request", () => {
+		if (!state?.active) return;
+		for (const forkId of state.requestResultIds) {
+			const pending = state.pending.get(forkId);
+			if (pending) pending.seen = true;
+		}
+	});
+
+	pi.on("agent_settled", () => {
+		if (!state?.active) return;
+		for (const pending of state.pending.values()) {
+			if (pending.seen) {
+				state.pending.delete(pending.details.forkId);
+			} else {
+				pending.queued = false;
+				sendPending(state, pending);
+			}
+		}
+	});
+
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description:
+			"Run a side investigation in a separate pi process using the current conversation. The answer arrives later as a fork-result message.",
+		parameters: Type.Object({ task: Type.String() }),
+		executionMode: "parallel",
+		async execute(toolCallId, { task }, _signal, _onUpdate, ctx) {
+			if (!task.trim()) throw new Error("Fork task must not be empty.");
+			if (!state?.active || !state.requestMessages) {
+				throw new Error("Fork requires an active persisted session and model request.");
+			}
+			const assistantEntry = [...ctx.sessionManager.getBranch()]
+				.reverse()
+				.find((entry) => entry.type === "message" && entry.message.role === "assistant");
+			if (!assistantEntry || assistantEntry.type !== "message" || assistantEntry.message.role !== "assistant") {
+				throw new Error("Fork could not find the assistant message.");
+			}
+			const forkId = randomUUID();
+			const forkState = state;
+			const requestMessages = state.requestMessages;
+			let sessionFile: string;
+			try {
+				sessionFile = writeForkSession(
+					ctx.sessionManager.getSessionDir(),
+					forkState.sessionFile,
+					ctx.cwd,
+					requestMessages,
+					assistantEntry.message,
+					toolCallId,
+				);
+			} catch (error) {
+				throw new Error(`Fork could not create a session: ${errorText(error)}`);
+			}
+
+			const args = ["--mode", "json", "--session", sessionFile, "--session-dir", ctx.sessionManager.getSessionDir()];
+			if (ctx.model) args.push("--model", `${ctx.model.provider}/${ctx.model.id}`);
+			if (ctx.thinkingLevel) args.push("--thinking", ctx.thinkingLevel);
+			// The label keeps slash commands, @file syntax, and leading dashes in
+			// arbitrary task text from being interpreted as pi CLI syntax.
+			args.push("--", `Task:\n${task}`);
+			const command = invocation(args);
+			let child: ChildProcess;
+			try {
+				child = spawn(command.command, command.args, {
+					cwd: ctx.cwd,
+					env: { ...process.env, [CHILD_ENV]: "1", [PARENT_PID_ENV]: String(process.pid) },
+					stdio: ["ignore", "pipe", "pipe"],
+				});
+			} catch (error) {
+				finish(forkState, { forkId, status: "failed", sessionFile, error: errorText(error) }, errorText(error));
+				throw new Error(`Fork ${forkId} failed to start: ${errorText(error)}`);
+			}
+			forkState.children.add(child);
+			let lastAssistant: AssistantMessage | undefined;
+			let stderr = "";
+			if (child.stdout) {
+				const lines = createInterface({ input: child.stdout });
+				lines.on("line", (line) => {
+					try {
+						const event: unknown = JSON.parse(line);
+						if (
+							typeof event === "object" &&
+							event !== null &&
+							"type" in event &&
+							event.type === "message_end" &&
+							"message" in event
+						) {
+							const message = event.message;
+							if (
+								typeof message === "object" &&
+								message !== null &&
+								"role" in message &&
+								message.role === "assistant"
+							) {
+								lastAssistant = message as AssistantMessage;
+							}
+						}
+					} catch {
+						/* Ignore non-JSON diagnostic lines. */
+					}
+				});
+			}
+			child.stderr?.on("data", (chunk: Buffer) => {
+				stderr = (stderr + chunk.toString()).slice(-8192);
+			});
+			child.once("close", (code, signal) => {
+				forkState.children.delete(child);
+				if (!forkState.active) return;
+				const error =
+					lastAssistant?.stopReason === "error" || lastAssistant?.stopReason === "aborted"
+						? lastAssistant.errorMessage || `Model response ${lastAssistant.stopReason}`
+						: code !== 0 || signal
+							? `Fork process ${signal ? `was killed by ${signal}` : `exited with code ${code}`}${stderr.trim() ? `: ${stderr.trim()}` : ""}`
+							: !lastAssistant
+								? "Fork ended without an assistant response"
+								: undefined;
+				finish(
+					forkState,
+					{ forkId, status: error ? "failed" : "completed", sessionFile, ...(error ? { error } : {}) },
+					error
+						? `Fork ${forkId} failed: ${error}`
+						: `Fork ${forkId} completed:\n${lastAssistant ? messageText(lastAssistant) : ""}`,
+				);
+			});
+			child.once("error", (error) => {
+				stderr = error.message;
+			});
+			try {
+				await new Promise<void>((resolve, reject) => {
+					child.once("spawn", resolve);
+					child.once("error", reject);
+				});
+			} catch (error) {
+				throw new Error(`Fork ${forkId} failed to start: ${errorText(error)}`);
+			}
+			return { content: [{ type: "text", text: `Fork ${forkId} started.` }], details: { forkId } };
+		},
+	});
+}
