+++ b/packages/coding-agent/test/fork-extension.test.ts
@@ -0,0 +1,40 @@
+import { afterEach, describe, expect, it } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+
+type Tool = { name: string; execute: (...args: any[]) => Promise<unknown> };
+
+function load() {
+	const tools: Tool[] = [];
+	const handlers = new Map<string, unknown>();
+	const api = {
+		registerTool: (tool: Tool) => tools.push(tool),
+		on: (event: string, handler: unknown) => handlers.set(event, handler),
+		getThinkingLevel: () => "off",
+		sendMessage: () => {},
+	};
+	forkExtension(api as never);
+	return { tools, handlers };
+}
+
+describe("fork extension", () => {
+	afterEach(() => {
+		delete process.env.PI_FORK_PARENT_SESSION;
+	});
+
+	it("registers the fork tool and session handlers", () => {
+		const { tools, handlers } = load();
+		expect(tools.map((tool) => tool.name)).toEqual(["fork"]);
+		expect(handlers.has("session_shutdown")).toBe(true);
+	});
+
+	it("does not register the fork tool inside a fork", () => {
+		process.env.PI_FORK_PARENT_SESSION = "/tmp/parent.jsonl";
+		expect(load().tools).toEqual([]);
+	});
+
+	it("rejects an empty task without starting anything", async () => {
+		const [tool] = load().tools;
+		const ctx = { sessionManager: { getSessionFile: () => undefined } };
+		await expect(tool!.execute("call-1", { task: "   " }, undefined, undefined, ctx)).rejects.toThrow(/must not be empty/);
+	});
+});
