+import { type ChildProcess, spawn } from "node:child_process";
+import { EventEmitter } from "node:events";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from "../src/core/extensions/types.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+vi.mock("node:child_process", () => ({ spawn: vi.fn() }));
+
+class FakeChild extends EventEmitter {
+	stderr = new EventEmitter();
+	exitCode: number | null = null;
+	signalCode: NodeJS.Signals | null = null;
+	kill = vi.fn((signal: NodeJS.Signals) => {
+		this.signalCode = signal;
+		return true;
+	});
+	finish(code: number, signal: NodeJS.Signals | null = null): void {
+		this.exitCode = code;
+		this.signalCode = signal;
+		this.emit("close", code, signal);
+	}
+}
+
+const assistant = (
+	content: AssistantMessage["content"],
+	stopReason: AssistantMessage["stopReason"] = "toolUse",
+	errorMessage?: string,
+): AssistantMessage => ({
+	role: "assistant",
+	content,
+	api: "openai-responses",
+	provider: "openai",
+	model: "test-model",
+	usage: {
+		input: 0,
+		output: 0,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	},
+	stopReason,
+	...(errorMessage ? { errorMessage } : {}),
+	timestamp: Date.now(),
+});
+
+describe("fork extension", () => {
+	let dir: string;
+	let parent: SessionManager;
+	let ctx: ExtensionContext;
+	let tool: ToolDefinition;
+	let handlers: Map<string, (event: unknown, context: ExtensionContext) => void>;
+	let sent: Array<{
+		message: {
+			customType: string;
+			content: string;
+			details?: { forkId: string; status: string; sessionFile?: string; error?: string };
+		};
+		options?: { triggerTurn?: boolean; deliverAs?: string };
+	}>;
+	let children: FakeChild[];
+	let idle: boolean;
+
+	const emit = (name: string, event: unknown): void => handlers.get(name)?.(event, ctx);
+	const start = (): void => emit("session_start", { type: "session_start", reason: "startup" });
+	const prepare = (calls: AssistantMessage["content"]): void => {
+		emit("context", {
+			type: "context",
+			messages: [{ role: "user", content: [{ type: "text", text: "Original question" }], timestamp: 1 }],
+		});
+		emit("message_end", { type: "message_end", message: assistant(calls) });
+	};
+	const run = async (id: string, task: string) => tool.execute(id, { task }, undefined, undefined, ctx);
+
+	beforeEach(() => {
+		dir = mkdtempSync(join(tmpdir(), "pi-fork-test-"));
+		parent = SessionManager.create(dir, dir);
+		parent.appendMessage(assistant([{ type: "text", text: "Earlier reply" }], "stop"));
+		idle = false;
+		ctx = {
+			cwd: dir,
+			sessionManager: parent,
+			model: { provider: "openai", id: "test-model" },
+			thinkingLevel: "high",
+			isIdle: () => idle,
+		} as unknown as ExtensionContext;
+		handlers = new Map();
+		sent = [];
+		children = [];
+		vi.mocked(spawn).mockImplementation(() => {
+			const child = new FakeChild();
+			children.push(child);
+			queueMicrotask(() => child.emit("spawn"));
+			return child as unknown as ChildProcess;
+		});
+		const api = {
+			on: (name: string, handler: (event: unknown, context: ExtensionContext) => void) =>
+				handlers.set(name, handler),
+			registerTool: (definition: ToolDefinition) => {
+				tool = definition;
+			},
+			sendMessage: (message: (typeof sent)[number]["message"], options?: (typeof sent)[number]["options"]) => {
+				sent.push({ message, options });
+			},
+		} as unknown as ExtensionAPI;
+		forkExtension(api);
+		start();
+	});
+
+	afterEach(() => {
+		emit("session_shutdown", { type: "session_shutdown", reason: "quit" });
+		vi.mocked(spawn).mockReset();
+		rmSync(dir, { recursive: true, force: true });
+	});
+
+	it("rejects blank tasks without starting a process", async () => {
+		prepare([{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: " " } }]);
+		await expect(run("call-a", " \n")).rejects.toThrow("Fork task must not be empty");
+		expect(children).toHaveLength(0);
+	});
+
+	it("seeds a child with the request, assistant, matching results, and task", async () => {
+		prepare([
+			{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: "Inspect" } },
+			{ type: "toolCall", id: "call-b", name: "read", arguments: { path: "file" } },
+		]);
+		const result = await run("call-a", "Inspect");
+		const forkId = (result.details as { forkId: string }).forkId;
+		expect(forkId).toBeTruthy();
+		expect(children).toHaveLength(1);
+		const args = vi.mocked(spawn).mock.calls[0][1] as string[];
+		const sessionFile = args[args.indexOf("--session") + 1];
+		const entries = readFileSync(sessionFile, "utf8")
+			.trim()
+			.split("\n")
+			.map((line) => JSON.parse(line) as Record<string, unknown>);
+		expect(entries[0]).toMatchObject({ type: "session", parentSession: parent.getSessionFile() });
+		const messages = entries.slice(1).map((entry) => entry.message as { role: string; toolCallId?: string });
+		expect(messages.map((message) => message.role)).toEqual(["user", "assistant", "toolResult", "toolResult"]);
+		expect(messages.slice(-2).map((message) => message.toolCallId)).toEqual(["call-a", "call-b"]);
+		expect(args.slice(-3)).toEqual(["--print", "--", "Inspect"]);
+		expect(args).toContain("high");
+	});
+
+	it("delivers concurrent fork outcomes with their own IDs", async () => {
+		prepare([
+			{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: "A" } },
+			{ type: "toolCall", id: "call-b", name: "fork", arguments: { task: "B" } },
+		]);
+		const first = await run("call-a", "A");
+		const second = await run("call-b", "B");
+		const files = vi.mocked(spawn).mock.calls.map((call) => {
+			const args = call[1] as string[];
+			return args[args.indexOf("--session") + 1];
+		});
+		SessionManager.open(files[0]).appendMessage(assistant([{ type: "text", text: "Answer A" }], "stop"));
+		SessionManager.open(files[1]).appendMessage(assistant([], "error", "provider said no"));
+		children[1].finish(0);
+		children[0].finish(0);
+		expect(sent).toHaveLength(2);
+		expect(sent[0].message).toMatchObject({
+			customType: "fork-result",
+			content: "provider said no",
+			details: {
+				forkId: (second.details as { forkId: string }).forkId,
+				status: "failed",
+				error: "provider said no",
+			},
+		});
+		expect(sent[1].message).toMatchObject({
+			customType: "fork-result",
+			content: "Answer A",
+			details: { forkId: (first.details as { forkId: string }).forkId, status: "completed" },
+		});
+		expect(sent[0].options).toEqual({ deliverAs: "steer" });
+	});
+
+	it("keeps a running fork and its result through extension reload", async () => {
+		prepare([{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: "A" } }]);
+		const result = await run("call-a", "A");
+		emit("session_shutdown", { type: "session_shutdown", reason: "reload" });
+		expect(children[0].kill).not.toHaveBeenCalled();
+		const reloadedHandlers = new Map<string, (event: unknown, context: ExtensionContext) => void>();
+		const reloadedApi = {
+			on: (name: string, handler: (event: unknown, context: ExtensionContext) => void) =>
+				reloadedHandlers.set(name, handler),
+			registerTool: () => {},
+			sendMessage: (message: (typeof sent)[number]["message"], options?: (typeof sent)[number]["options"]) => {
+				sent.push({ message, options });
+			},
+		} as unknown as ExtensionAPI;
+		forkExtension(reloadedApi);
+		reloadedHandlers.get("session_start")?.({ type: "session_start", reason: "reload" }, ctx);
+		const args = vi.mocked(spawn).mock.calls[0][1] as string[];
+		const file = args[args.indexOf("--session") + 1];
+		SessionManager.open(file).appendMessage(assistant([{ type: "text", text: "After reload" }], "stop"));
+		children[0].finish(0);
+		expect(sent).toHaveLength(1);
+		expect(sent[0].message).toMatchObject({
+			content: "After reload",
+			details: { forkId: (result.details as { forkId: string }).forkId, status: "completed" },
+		});
+	});
+
+	it("reports a child that exits before producing a model response", async () => {
+		prepare([{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: "A" } }]);
+		await run("call-a", "A");
+		children[0].finish(0);
+		expect(sent).toHaveLength(1);
+		expect(sent[0].message).toMatchObject({
+			content: "Fork process ended without an assistant response",
+			details: { status: "failed", error: "Fork process ended without an assistant response" },
+		});
+	});
+
+	it("resends an undelivered result after Escape and stops forks on session shutdown", async () => {
+		prepare([{ type: "toolCall", id: "call-a", name: "fork", arguments: { task: "A" } }]);
+		await run("call-a", "A");
+		const args = vi.mocked(spawn).mock.calls[0][1] as string[];
+		const file = args[args.indexOf("--session") + 1];
+		SessionManager.open(file).appendMessage(assistant([{ type: "text", text: "Done" }], "stop"));
+		children[0].finish(0);
+		idle = true;
+		emit("agent_settled", { type: "agent_settled" });
+		expect(sent).toHaveLength(2);
+		expect(sent[1].options).toEqual({ triggerTurn: true });
+
+		await run("call-a", "Another");
+		emit("session_shutdown", { type: "session_shutdown", reason: "new" });
+		expect(children[1].kill).toHaveBeenCalledWith("SIGTERM");
+		children[1].finish(1, "SIGTERM");
+		expect(sent).toHaveLength(2);
+	});
+});
