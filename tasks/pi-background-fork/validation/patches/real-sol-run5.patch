@@ -0,0 +1,305 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync } from "node:fs";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import { type ExtensionAPI, type ExtensionContext, SessionManager } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const CHILD_PARENT_PID = "PI_CODING_AGENT_FORK_PARENT_PID";
+const STATE_KEY = Symbol.for("@earendil-works/pi-coding-agent/examples/fork/state");
+
+interface ForkResult {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface PendingResult {
+	details: ForkResult;
+	content: string;
+	sent: boolean;
+	persisted: boolean;
+	seen: boolean;
+	waking: boolean;
+}
+
+interface ForkState {
+	sessionId: string;
+	active: boolean;
+	pi: ExtensionAPI;
+	requestMessages: AgentMessage[];
+	assistant?: AssistantMessage;
+	children: Map<string, ChildProcess>;
+	results: Map<string, PendingResult>;
+}
+
+function getState(): ForkState | undefined {
+	return (globalThis as typeof globalThis & { [STATE_KEY]?: ForkState })[STATE_KEY];
+}
+
+function setState(state: ForkState): void {
+	(globalThis as typeof globalThis & { [STATE_KEY]?: ForkState })[STATE_KEY] = state;
+}
+
+function sendResult(state: ForkState, result: PendingResult, ctx: ExtensionContext): void {
+	if (!state.active || result.seen || result.sent) return;
+	try {
+		state.pi.sendMessage(
+			{ customType: "fork-result", content: result.content, display: true, details: result.details },
+			ctx.isIdle() ? { triggerTurn: true } : { deliverAs: "steer" },
+		);
+		result.sent = true;
+	} catch {
+		// The old extension API is invalid during /reload. session_start retries delivery.
+	}
+}
+
+function stopChildren(state: ForkState): void {
+	state.active = false;
+	for (const child of state.children.values()) {
+		child.kill("SIGTERM");
+		const timer = setTimeout(() => {
+			if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+		}, 4_000);
+		timer.unref();
+	}
+	state.children.clear();
+	state.results.clear();
+}
+
+function readOutcome(
+	sessionFile: string,
+	seedAssistantEntryId: string,
+	exitCode: number | null,
+	signal: NodeJS.Signals | null,
+	stderr: string,
+): {
+	status: "completed" | "failed";
+	text: string;
+} {
+	let lastAssistant: AssistantMessage | undefined;
+	let afterSeed = false;
+	if (existsSync(sessionFile)) {
+		const entries = SessionManager.open(sessionFile).getEntries();
+		for (const entry of entries) {
+			if (entry.id === seedAssistantEntryId) {
+				afterSeed = true;
+			} else if (afterSeed && entry.type === "message" && entry.message.role === "assistant") {
+				lastAssistant = entry.message;
+			}
+		}
+	}
+	if (signal || exitCode !== 0) {
+		return {
+			status: "failed",
+			text: lastAssistant?.errorMessage || stderr.trim() || `Fork process exited ${signal ?? exitCode}`,
+		};
+	}
+	if (!lastAssistant) return { status: "failed", text: "Fork process ended without an assistant response" };
+	if (lastAssistant.stopReason === "error" || lastAssistant.stopReason === "aborted") {
+		return { status: "failed", text: lastAssistant.errorMessage || `Model response ${lastAssistant.stopReason}` };
+	}
+	return {
+		status: "completed",
+		text: lastAssistant.content
+			.filter((part) => part.type === "text")
+			.map((part) => part.text)
+			.join(""),
+	};
+}
+
+export default function (pi: ExtensionAPI) {
+	const parentPid = process.env[CHILD_PARENT_PID];
+	if (parentPid) {
+		// Every child loads the same settings, but it cannot create another fork.
+		const expectedPid = Number(parentPid);
+		const watchdog = setInterval(() => {
+			if (process.ppid !== expectedPid) process.exit(1);
+		}, 1_000);
+		watchdog.unref();
+		return;
+	}
+
+	let state = getState();
+	pi.on("session_start", (event, ctx) => {
+		const sessionId = ctx.sessionManager.getSessionId();
+		if (event.reason === "reload" && state?.active && state.sessionId === sessionId) {
+			state.pi = pi;
+		} else {
+			if (state?.active) stopChildren(state);
+			state = {
+				sessionId,
+				active: true,
+				pi,
+				requestMessages: [],
+				children: new Map(),
+				results: new Map(),
+			};
+			setState(state);
+		}
+		for (const result of state.results.values()) {
+			if (!result.persisted) {
+				result.sent = false;
+				sendResult(state, result, ctx);
+			}
+		}
+	});
+
+	pi.on("session_shutdown", (event) => {
+		if (event.reason !== "reload" && state?.active) stopChildren(state);
+	});
+
+	pi.on("context", (event) => {
+		if (!state?.active) return;
+		state.requestMessages = structuredClone(event.messages);
+		for (const message of event.messages) {
+			if (message.role !== "custom" || message.customType !== "fork-result") continue;
+			const forkId = (message.details as ForkResult | undefined)?.forkId;
+			const result = forkId && state.results.get(forkId);
+			if (result) result.seen = true;
+		}
+	});
+
+	pi.on("message_end", (event) => {
+		if (!state?.active) return;
+		if (event.message.role === "assistant") state.assistant = structuredClone(event.message);
+		if (event.message.role === "custom" && event.message.customType === "fork-result") {
+			const forkId = (event.message.details as ForkResult | undefined)?.forkId;
+			const result = forkId && state.results.get(forkId);
+			if (result) result.persisted = true;
+		}
+	});
+
+	pi.on("agent_settled", (_event, ctx) => {
+		if (!state?.active) return;
+		for (const result of state.results.values()) {
+			if (result.seen) continue;
+			if (!result.persisted) {
+				result.sent = false; // Escape discards undelivered steering messages.
+				sendResult(state, result, ctx);
+			} else if (!result.waking) {
+				// The message reached the session but Escape stopped the run before a request.
+				result.waking = true;
+				pi.sendMessage({ customType: "fork-wake", content: "", display: false }, { triggerTurn: true });
+			}
+		}
+	});
+
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description: "Run a side task in a separate pi process with the current conversation. The result arrives later.",
+		parameters: Type.Object({ task: Type.String() }),
+		executionMode: "parallel",
+		async execute(toolCallId, { task }, _signal, _onUpdate, ctx) {
+			if (!task.trim()) throw new Error("Fork task must not be empty");
+			const current = state;
+			const parentSession = ctx.sessionManager.getSessionFile();
+			if (!current?.active || !parentSession || !current.assistant || !ctx.model) {
+				throw new Error("Fork requires a saved parent session and an active model request");
+			}
+
+			const forkId = randomUUID();
+			let sessionFile: string | undefined;
+			let child: ChildProcess | undefined;
+			try {
+				const childSession = SessionManager.create(ctx.cwd, ctx.sessionManager.getSessionDir(), { parentSession });
+				sessionFile = childSession.getSessionFile();
+				if (!sessionFile) throw new Error("Could not create fork session file");
+				// The context event can include compacted summary messages. The session
+				// writer accepts them at runtime, although its public type is narrower.
+				for (const message of current.requestMessages) {
+					childSession.appendMessage(message as Parameters<SessionManager["appendMessage"]>[0]);
+				}
+				const seedAssistantEntryId = childSession.appendMessage(current.assistant);
+				for (const call of current.assistant.content) {
+					if (call.type !== "toolCall") continue;
+					const ownCall = call.id === toolCallId;
+					const text = ownCall
+						? `Fork ${forkId} started.`
+						: "This tool continues in the parent session; its output is not part of this fork's snapshot.";
+					const result: ToolResultMessage = {
+						role: "toolResult",
+						toolCallId: call.id,
+						toolName: call.name,
+						content: [{ type: "text", text }],
+						isError: false,
+						timestamp: Date.now(),
+					};
+					childSession.appendMessage(result);
+				}
+
+				child = spawn(
+					process.execPath,
+					[
+						...process.execArgv,
+						process.argv[1],
+						"--session",
+						sessionFile,
+						"--session-dir",
+						ctx.sessionManager.getSessionDir(),
+						"--model",
+						`${ctx.model.provider}/${ctx.model.id}`,
+						"--thinking",
+						ctx.thinkingLevel ?? "off",
+						"--print",
+						"--",
+						task,
+					],
+					{
+						cwd: ctx.cwd,
+						env: { ...process.env, [CHILD_PARENT_PID]: String(process.pid) },
+						stdio: ["ignore", "ignore", "pipe"],
+					},
+				);
+				current.children.set(forkId, child);
+				let started = false;
+				let stderr = "";
+				child.stderr?.on("data", (chunk: Buffer) => {
+					stderr = (stderr + chunk.toString()).slice(-16_384);
+				});
+				child.once("error", (error) => {
+					stderr = error.message;
+				});
+				child.once("close", (code, signal) => {
+					current.children.delete(forkId);
+					if (!started || !current.active || current.sessionId !== ctx.sessionManager.getSessionId()) return;
+					let outcome: ReturnType<typeof readOutcome>;
+					try {
+						outcome = readOutcome(sessionFile!, seedAssistantEntryId, code, signal, stderr);
+					} catch (error) {
+						outcome = { status: "failed", text: error instanceof Error ? error.message : String(error) };
+					}
+					const details: ForkResult = {
+						forkId,
+						status: outcome.status,
+						...(existsSync(sessionFile!) ? { sessionFile } : {}),
+						...(outcome.status === "failed" ? { error: outcome.text } : {}),
+					};
+					const pending: PendingResult = {
+						details,
+						content: outcome.text,
+						sent: false,
+						persisted: false,
+						seen: false,
+						waking: false,
+					};
+					current.results.set(forkId, pending);
+					sendResult(current, pending, ctx);
+				});
+				await new Promise<void>((resolve, reject) => {
+					child!.once("spawn", resolve);
+					child!.once("error", reject);
+				});
+				started = true;
+				return { content: [{ type: "text", text: `Fork ${forkId} started.` }], details: { forkId } };
+			} catch (error) {
+				current.children.delete(forkId);
+				child?.kill("SIGTERM");
+				throw error;
+			}
+		},
+	});
+}
