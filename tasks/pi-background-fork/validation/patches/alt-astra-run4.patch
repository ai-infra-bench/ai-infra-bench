index 0000000000000000000000000000000000000000..27be487da753c2cef8d099694c7d8e7451d2b8a1
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/fork/index.ts
@@ -0,0 +1,415 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, Context, Message, Provider } from "@earendil-works/pi-ai";
+import {
+	convertToLlm,
+	type ExtensionAPI,
+	type ExtensionContext,
+	SessionManager,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const CHILD = "PI_FORK_CHILD";
+const BOOTSTRAP = "fork-bootstrap";
+const STATE = Symbol.for("pi.example.fork.state");
+
+// Run before the CLI loads extensions. A worker watches a pipe held only by the
+// parent, so even a blocked child event loop cannot outlive a dead parent.
+const watchdog = `data:text/javascript,${encodeURIComponent(`
+import { Socket } from "node:net";
+const owner = new Socket({ fd: 3, readable: true, writable: false });
+const stop = () => process.kill(process.pid, "SIGKILL");
+owner.on("end", stop);
+owner.on("error", stop);
+owner.resume();
+`)}`;
+const preload = `data:text/javascript,${encodeURIComponent(`
+import { Worker } from "node:worker_threads";
+const guard = new Worker(new URL(${JSON.stringify(watchdog)}), { execArgv: [] });
+guard.on("error", () => process.exit(1));
+guard.unref();
+`)}`;
+
+interface Bootstrap {
+	task: string;
+	systemPrompt: string;
+}
+
+interface ResultDetails {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface Result {
+	customType: "fork-result";
+	content: string;
+	display: true;
+	details: ResultDetails;
+}
+
+interface Job {
+	id: string;
+	sessionFile: string;
+	inheritedAssistants: number;
+	child?: ChildProcess;
+	result?: Result;
+	queued: boolean;
+	seen: boolean;
+	inRequest: boolean;
+	finished: boolean;
+}
+
+interface State {
+	sessionId: string;
+	jobs: Map<string, Job>;
+	request: AgentMessage[];
+	systemPrompt?: string;
+	restoreRequest?: () => void;
+	assistant?: AssistantMessage;
+	pi?: ExtensionAPI;
+	ctx?: ExtensionContext;
+	closed: boolean;
+	onExit: () => void;
+}
+
+// Extension modules are evaluated again on /reload. Keep process ownership outside
+// the module cache, but replace all API/context references on session_start.
+const registry = globalThis as typeof globalThis & { [STATE]?: State };
+
+// context handlers are ordered and can replace the message array. Observe the
+// public provider's stream entry point to get the final, converted request,
+// regardless of extension order. Restore the method before calling it.
+function observeRequest(ctx: ExtensionContext, observe: (request: Context) => Context): () => void {
+	const provider = ctx.model && ctx.modelRegistry.getProvider(ctx.model.provider);
+	if (!provider) throw new Error("Fork requires a registered provider");
+	const original = provider.streamSimple;
+	let active = true;
+	const restore = () => {
+		active = false;
+		if (provider.streamSimple === wrapped) provider.streamSimple = original;
+	};
+	const wrapped: Provider["streamSimple"] = (model, request, options) => {
+		const capture = active;
+		restore();
+		return original.call(provider, model, capture ? observe(request) : request, options);
+	};
+	provider.streamSimple = wrapped;
+	return restore;
+}
+
+function stop(state: State): void {
+	state.closed = true;
+	state.pi = undefined;
+	state.ctx = undefined;
+	state.restoreRequest?.();
+	process.off("exit", state.onExit);
+	for (const job of state.jobs.values()) {
+		if (job.finished || !job.child) continue;
+		job.child.kill("SIGTERM");
+		const timer = setTimeout(() => {
+			if (!job.finished) job.child?.kill("SIGKILL");
+		}, 1000);
+		timer.unref();
+	}
+}
+
+function recorded(ctx: ExtensionContext, id: string): boolean {
+	return ctx.sessionManager
+		.getEntries()
+		.some(
+			(entry) =>
+				entry.type === "custom_message" &&
+				entry.customType === "fork-result" &&
+				(entry.details as ResultDetails | undefined)?.forkId === id,
+		);
+}
+
+function deliver(state: State): void {
+	const { pi, ctx } = state;
+	if (state.closed || !pi || !ctx) return;
+	for (const job of state.jobs.values()) {
+		if (!job.result || job.seen || job.queued) continue;
+		job.queued = true;
+		if (recorded(ctx, job.id)) {
+			// Escape can arrive after persistence but before the next model request.
+			// Wake the agent without recording the result a second time.
+			pi.sendMessage({ customType: "fork-wake", content: [], display: false }, { triggerTurn: true });
+		} else {
+			pi.sendMessage(job.result, { triggerTurn: true, deliverAs: "steer" });
+		}
+	}
+}
+
+function finish(state: State, job: Job, reason?: string): void {
+	if (job.finished) return;
+	job.finished = true;
+	if (state.closed) return;
+	let last: AssistantMessage | undefined;
+	try {
+		if (existsSync(job.sessionFile)) {
+			const assistants = SessionManager.open(job.sessionFile)
+				.getEntries()
+				.flatMap((entry) =>
+					entry.type === "message" && entry.message.role === "assistant" ? [entry.message] : [],
+				);
+			if (assistants.length > job.inheritedAssistants) last = assistants.at(-1);
+		}
+	} catch (error) {
+		reason ??= String(error);
+	}
+	if (last?.stopReason === "error" || last?.stopReason === "aborted") {
+		reason = last.errorMessage || `Model response ${last.stopReason}`;
+	}
+	if (!last) reason ??= "Fork exited without an assistant response";
+	const text =
+		last?.content
+			.filter((part) => part.type === "text")
+			.map((part) => part.text)
+			.join("\n") ?? "";
+	job.result = {
+		customType: "fork-result",
+		display: true,
+		content: `Fork ${job.id} ${reason ? "failed" : "completed"}:\n\n${reason ?? text}`,
+		details: {
+			forkId: job.id,
+			status: reason ? "failed" : "completed",
+			...(existsSync(job.sessionFile) ? { sessionFile: job.sessionFile } : {}),
+			...(reason ? { error: reason } : {}),
+		},
+	};
+	deliver(state);
+}
+
+function installChild(pi: ExtensionAPI): void {
+	let bootstrap: Bootstrap;
+	let prefix: Message[];
+	let first = true;
+	let restoreRequest: (() => void) | undefined;
+	pi.on("session_start", (_event, ctx) => {
+		const entries = ctx.sessionManager.getEntries();
+		const entry = entries.find((item) => item.type === "custom" && item.customType === BOOTSTRAP);
+		if (!entry || entry.type !== "custom") throw new Error("Missing fork bootstrap");
+		bootstrap = entry.data as Bootstrap;
+		prefix = convertToLlm(entries.flatMap((item) => (item.type === "message" ? [item.message] : [])));
+	});
+	// The CLI receives a fixed launch token, so a task beginning with / or @
+	// cannot execute a command or expand a file. Only the literal task is saved.
+	pi.on("message_end", (event) => {
+		if (first && event.message.role === "user") {
+			return { message: { ...event.message, content: bootstrap.task } };
+		}
+	});
+	pi.on("before_agent_start", () => ({ systemPrompt: bootstrap.systemPrompt }));
+	pi.on("session_before_compact", () => (first ? { cancel: true } : undefined));
+	pi.on("context", (_event, ctx) => {
+		if (!first) return;
+		restoreRequest?.();
+		restoreRequest = observeRequest(ctx, (request) => {
+			first = false;
+			return {
+				...request,
+				systemPrompt: bootstrap.systemPrompt,
+				messages: [...prefix, { role: "user", content: bootstrap.task, timestamp: Date.now() }],
+			};
+		});
+	});
+	pi.on("session_shutdown", () => restoreRequest?.());
+}
+
+export default function (pi: ExtensionAPI) {
+	if (process.env[CHILD]) {
+		installChild(pi);
+		return;
+	}
+	let state: State;
+	pi.on("session_start", (_event, ctx) => {
+		const previous = registry[STATE];
+		if (previous && !previous.closed && previous.sessionId === ctx.sessionManager.getSessionId()) {
+			state = previous;
+		} else {
+			if (previous) stop(previous);
+			state = {
+				sessionId: ctx.sessionManager.getSessionId(),
+				jobs: new Map(),
+				request: [],
+				closed: false,
+				onExit: () => {
+					for (const job of state.jobs.values()) if (!job.finished) job.child?.kill("SIGKILL");
+				},
+			};
+			registry[STATE] = state;
+			process.once("exit", state.onExit);
+		}
+		state.pi = pi;
+		state.ctx = ctx;
+		deliver(state);
+	});
+	pi.on("session_shutdown", (event) => {
+		state.restoreRequest?.();
+		if (event.reason === "reload") {
+			state.pi = undefined;
+			state.ctx = undefined;
+		} else {
+			stop(state);
+		}
+	});
+	pi.on("context", (_event, ctx) => {
+		state.ctx = ctx;
+		state.restoreRequest?.();
+		state.restoreRequest = observeRequest(ctx, (request) => {
+			const messages = [...request.messages];
+			for (const job of state.jobs.values()) {
+				if (!job.result || job.seen || !recorded(ctx, job.id)) continue;
+				const content = job.result.content;
+				const present = messages.some(
+					(message) =>
+						message.role === "user" &&
+						(typeof message.content === "string"
+							? message.content
+							: message.content
+									.filter((part) => part.type === "text")
+									.map((part) => part.text)
+									.join("\n")
+						).includes(content),
+				);
+				// Compaction or another context hook may have removed a recorded,
+				// unseen result. Restore it to the request, never a second session entry.
+				if (!present) messages.push({ role: "user", content, timestamp: Date.now() });
+				job.inRequest = true;
+			}
+			state.request = structuredClone(messages);
+			state.systemPrompt = request.systemPrompt;
+			return { ...request, messages };
+		});
+	});
+	pi.on("before_provider_request", (_event, ctx) => {
+		if (ctx.signal?.aborted) return;
+		for (const job of state.jobs.values()) if (job.inRequest) job.seen = true;
+	});
+	pi.on("message_end", (event, ctx) => {
+		if (event.message.role !== "assistant") return;
+		state.assistant = event.message;
+		// Custom providers may not implement before_provider_request.
+		if (event.message.stopReason !== "aborted" && !ctx.signal?.aborted) {
+			for (const job of state.jobs.values()) if (job.inRequest) job.seen = true;
+		}
+	});
+	pi.on("agent_settled", (_event, ctx) => {
+		state.ctx = ctx;
+		for (const job of state.jobs.values()) if (!job.seen) job.queued = false;
+		// Let abort/queue cleanup finish before starting another run.
+		setImmediate(() => deliver(state));
+	});
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description:
+			"Start a background investigation with a copy of this conversation. Its result returns automatically.",
+		parameters: Type.Object({ task: Type.String() }),
+		async execute(toolCallId, { task }, _signal, _onUpdate, ctx) {
+			if (!task.trim()) throw new Error("Fork task must not be empty");
+			if (!ctx.model || !state?.assistant) throw new Error("Fork requires a model and an assistant tool call");
+			const assistant = structuredClone(state.assistant);
+			if (!assistant.content.some((part) => part.type === "toolCall" && part.id === toolCallId)) {
+				throw new Error("Fork tool call is missing from the current assistant message");
+			}
+			const id = randomUUID();
+			const session = SessionManager.create(ctx.cwd, ctx.sessionManager.getSessionDir(), {
+				parentSession: ctx.sessionManager.getSessionFile(),
+			});
+			const messages = convertToLlm(structuredClone(state.request));
+			for (const message of [...messages, assistant]) session.appendMessage(message);
+			// Parent tools may not have run yet, and their future output must never
+			// leak into this snapshot. Close every call explicitly in the child.
+			for (const call of assistant.content) {
+				if (call.type !== "toolCall") continue;
+				session.appendMessage({
+					role: "toolResult",
+					toolCallId: call.id,
+					toolName: call.name,
+					content: [
+						{ type: "text", text: "Tool belongs to the parent run; no result is available in this fork." },
+					],
+					isError: false,
+					timestamp: Date.now(),
+				});
+			}
+			session.appendCustomEntry(BOOTSTRAP, {
+				task,
+				systemPrompt: state.systemPrompt ?? ctx.getSystemPrompt(),
+			} satisfies Bootstrap);
+			const job: Job = {
+				id,
+				sessionFile: resolve(session.getSessionFile()!),
+				inheritedAssistants: messages.filter((message) => message.role === "assistant").length + 1,
+				queued: false,
+				seen: false,
+				inRequest: false,
+				finished: false,
+			};
+			state.jobs.set(id, job);
+			const owner = state;
+			let stderr = "";
+			let started = false;
+			try {
+				const child = spawn(
+					process.execPath,
+					[
+						...process.execArgv,
+						"--import",
+						preload,
+						process.argv[1],
+						"--mode",
+						"json",
+						"--print",
+						"--session",
+						job.sessionFile,
+						"--provider",
+						ctx.model.provider,
+						"--model",
+						ctx.model.id,
+						"--thinking",
+						pi.getThinkingLevel(),
+						"fork-start",
+					],
+					{ cwd: ctx.cwd, env: { ...process.env, [CHILD]: id }, stdio: ["ignore", "ignore", "pipe", "pipe"] },
+				);
+				job.child = child;
+				child.stderr?.on("data", (chunk: Buffer) => {
+					stderr = (stderr + chunk.toString()).slice(-8192);
+				});
+				child.once("error", (error) => finish(owner, job, error.message));
+				const exited = (code: number | null, signal: NodeJS.Signals | null) => {
+					finish(
+						owner,
+						job,
+						signal
+							? `Fork killed by ${signal}`
+							: code !== 0
+								? `Fork exited with code ${code}${stderr ? `: ${stderr}` : ""}`
+								: undefined,
+					);
+				};
+				// A descendant can keep stderr open after pi exits. Do not wait for it.
+				child.once("exit", exited);
+				child.once("close", exited);
+				await new Promise<void>((accept, reject) => {
+					child.once("spawn", accept);
+					child.once("error", reject);
+				});
+				started = true;
+			} catch (error) {
+				finish(owner, job, error instanceof Error ? error.message : String(error));
+			}
+			return {
+				content: [{ type: "text", text: `${started ? "Started" : "Could not start"} fork ${id}` }],
+				details: { forkId: id },
+			};
+		},
+	});
+}
