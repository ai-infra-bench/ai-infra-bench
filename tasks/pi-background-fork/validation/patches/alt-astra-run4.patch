@@ -0,0 +1,437 @@
+import * as childProcess from "node:child_process";
+import { EventEmitter } from "node:events";
+import { existsSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { PassThrough } from "node:stream";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import {
+	type AssistantMessage,
+	type Context,
+	createAssistantMessageEventStream,
+	type Provider,
+} from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import forkExtension from "../examples/extensions/fork/index.ts";
+import type { ExtensionAPI, ExtensionContext, ExtensionEvent, ToolDefinition } from "../src/core/extensions/types.ts";
+import { convertToLlm } from "../src/core/messages.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+vi.mock("@earendil-works/pi-coding-agent", () => ({
+	get SessionManager() {
+		return SessionManager;
+	},
+	convertToLlm: (messages: AgentMessage[]) => convertToLlm(messages),
+}));
+vi.mock("node:child_process", async (importOriginal) => ({
+	...(await importOriginal<typeof childProcess>()),
+	spawn: vi.fn(),
+}));
+
+const parameters = Type.Object({ task: Type.String() });
+type ForkTool = ToolDefinition<typeof parameters, { forkId: string }>;
+type Handler = (event: ExtensionEvent, ctx: ExtensionContext) => unknown;
+
+function assistant(
+	content: AssistantMessage["content"],
+	stopReason: AssistantMessage["stopReason"] = "stop",
+): AssistantMessage {
+	return {
+		role: "assistant",
+		content,
+		stopReason,
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "claude-sonnet-4-5",
+		usage: {
+			input: 1,
+			output: 1,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 2,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		timestamp: 123,
+	};
+}
+
+class Child extends EventEmitter {
+	stderr = new PassThrough();
+	kill = vi.fn(() => true);
+}
+
+const directories: string[] = [];
+const shutdowns: (() => void)[] = [];
+
+function setup(existing?: SessionManager) {
+	const directory = mkdtempSync(join(tmpdir(), "pi-fork-test-"));
+	directories.push(directory);
+	const session = existing ?? SessionManager.create(directory, directory);
+	let lastRequest: Context | undefined;
+	const provider = {
+		streamSimple: vi.fn((_model, context: Context) => {
+			lastRequest = context;
+			return createAssistantMessageEventStream();
+		}),
+	} as unknown as Provider;
+	const ctx = {
+		cwd: directory,
+		sessionManager: session,
+		model: { provider: "anthropic", id: "claude-sonnet-4-5" },
+		modelRegistry: { getProvider: () => provider },
+		isIdle: () => false,
+		getSystemPrompt: () => "Parent effective system prompt",
+	} as unknown as ExtensionContext;
+	const handlers = new Map<string, Handler>();
+	let tool: ForkTool | undefined;
+	const sendMessage = vi.fn<ExtensionAPI["sendMessage"]>();
+	const api = {
+		on: (name: string, handler: Handler) => handlers.set(name, handler),
+		registerTool: (definition: ForkTool) => {
+			tool = definition;
+		},
+		getThinkingLevel: () => "high",
+		sendMessage,
+	} as unknown as ExtensionAPI;
+	forkExtension(api);
+	const emit = (event: ExtensionEvent) => handlers.get(event.type)?.(event, ctx);
+	emit({ type: "session_start", reason: existing ? "reload" : "startup" });
+	shutdowns.push(() => {
+		emit({ type: "session_shutdown", reason: "quit" });
+	});
+	const call = (id = "call-1", task = "Check other call sites") => {
+		if (!tool) throw new Error("fork not registered");
+		return tool.execute(id, { task }, undefined, undefined, ctx);
+	};
+	const request = (messages: AgentMessage[]) => {
+		provider.streamSimple(ctx.model!, { messages: convertToLlm(messages), systemPrompt: ctx.getSystemPrompt() });
+		return lastRequest!;
+	};
+	return { ctx, session, emit, call, sendMessage, tool, request, provider };
+}
+
+function prepare(parent: ReturnType<typeof setup>, count = 1) {
+	const request: AgentMessage[] = [
+		{ role: "compactionSummary", summary: "Only compacted history", tokensBefore: 10000, timestamp: 1 },
+		{ role: "user", content: "Investigate the bug", timestamp: 2 },
+		{ role: "custom", customType: "injected", content: "Context hook addition", display: false, timestamp: 3 },
+	];
+	const message = assistant(
+		[
+			{ type: "text", text: "I will investigate in parallel." },
+			...Array.from({ length: count }, (_, index) => ({
+				type: "toolCall" as const,
+				id: `call-${index + 1}`,
+				name: "fork",
+				arguments: { task: `Task ${index}` },
+			})),
+			{ type: "toolCall", id: "other", name: "read", arguments: { path: "file.ts" } },
+		],
+		"toolUse",
+	);
+	parent.emit({ type: "context", messages: request });
+	parent.request(request);
+	parent.emit({ type: "message_end", message });
+	return { request, message };
+}
+
+function mockSpawn() {
+	const children: Child[] = [];
+	const spawn = vi
+		.mocked(childProcess.spawn)
+		.mockReset()
+		.mockImplementation(() => {
+			const child = new Child();
+			children.push(child);
+			queueMicrotask(() => child.emit("spawn"));
+			return child as unknown as childProcess.ChildProcess;
+		});
+	const file = (index = 0) => {
