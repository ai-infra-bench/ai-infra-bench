+import { type FileEntry, SessionManager, sessionEntryToContextMessages } from "../src/core/session-manager.ts";
+
+// The extension imports the public SDK by package name. Map it onto the
+// workspace sources so the test does not depend on a built dist directory.
+vi.mock("@earendil-works/pi-coding-agent", async () => {
+	const messages = await import("../src/core/messages.ts");
+	return {
+		convertToLlm: messages.convertToLlm,
+		SessionManager,
+		sessionEntryToContextMessages,
+	};
+});
+
+const { default: forkExtension } = await import("../examples/extensions/fork/index.ts");
+
+type RealSpawn = (command: string, args: string[], options?: SpawnOptions) => ChildProcess;
+
+class FakeChild extends EventEmitter {
+	pid: number;
+	stderr = new EventEmitter();
+	killSignals: string[] = [];
+
+	constructor(pid: number) {
+		super();
+		this.pid = pid;
+	}
+
+	kill(signal?: string): boolean {
+		this.killSignals.push(signal ?? "SIGTERM");
+		return true;
+	}
+
+	exit(code: number | null, signal: string | null = null): void {
+		this.emit("exit", code, signal);
+	}
+
+	fail(message: string): void {
+		this.emit("error", new Error(message));
+	}
+}
+
+const spawnState = vi.hoisted(() => ({
+	calls: [] as Array<{ command: string; args: string[]; env: NodeJS.ProcessEnv }>,
+	children: [] as FakeChild[],
+	/** Pid handed to the next fake child. Defaults to the test process (always alive). */
+	pid: undefined as number | undefined,
+	realSpawn: undefined as RealSpawn | undefined,
+}));
+
+vi.mock("node:child_process", async () => {
+	const actual = await vi.importActual<{ spawn: RealSpawn }>("node:child_process");
+	spawnState.realSpawn = actual.spawn;
+	return {
+		...actual,
+		spawn: (command: string, args: string[], options?: SpawnOptions) => {
+			spawnState.calls.push({ command, args, env: options?.env ?? {} });
+			const child = new FakeChild(spawnState.pid ?? process.pid);
+			spawnState.children.push(child);
+			return child as unknown as ChildProcess;
+		},
+	};
+});
+
+const USAGE = {
+	input: 0,
+	output: 0,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 0,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+
+function userMessage(text: string) {
+	return { role: "user" as const, content: [{ type: "text" as const, text }], timestamp: Date.now() };
+}
+
+function assistantMessage(
+	content: AssistantMessage["content"],
+	stopReason: AssistantMessage["stopReason"],
+): AssistantMessage {
+	return {
+		role: "assistant" as const,
+		content,
+		api: "anthropic-messages",
+		provider: "faux",
+		model: "faux-model",
+		usage: USAGE,
+		stopReason,
+		timestamp: Date.now(),
+	};
+}
+
+function forkCall(id: string, task: string): ToolCall {
+	return { type: "toolCall", id, name: "fork", arguments: { task } };
+}
+
+interface ParentSession {
+	dir: string;
+	sessionDir: string;
+	parentFile: string;
+	sessionManager: SessionManager;
+}
+
+function createParentSession(): ParentSession {
+	const dir = fs.mkdtempSync(path.join(tmpdir(), "pi-fork-test-"));
+	const sessionDir = path.join(dir, "sessions");
+	const sessionManager = SessionManager.create(dir, sessionDir);
+	sessionManager.appendMessage(userMessage("Implement the retry helper and check the other call sites."));
