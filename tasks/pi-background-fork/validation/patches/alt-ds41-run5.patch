+/**
+ * Fork extension - run a side task in a background pi process that already
+ * knows the conversation.
+ *
+ * The `fork` tool starts a separate pi process whose session file begins with
+ * the parent's context (the request that produced the forking assistant
+ * message, that assistant message, and a tool result for every tool call of
+ * that message) followed by the task. The tool returns as soon as the process
+ * is started, so the parent keeps working. When the fork finishes, its answer
+ * is added to the parent session as a `fork-result` custom message.
+ *
+ * Installation: list this directory under `extensions` in the agent
+ * directory's settings.json, or symlink it into ~/.pi/agent/extensions/fork/.
+ * Every pi process that loads those settings then has the tool, and a fork
+ * process loads it too but never registers the tool itself (see README.md).
+ */
+
+import { type ChildProcess, spawn } from "node:child_process";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, Message, TextContent, ToolCall, ToolResultMessage } from "@earendil-works/pi-ai";
+import { uuidv7 } from "@earendil-works/pi-ai";
+import {
+	convertToLlm,
+	type ExtensionAPI,
+	type ExtensionContext,
+	type FileEntry,
+	SessionManager,
+	sessionEntryToContextMessages,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+/** Tool name. */
+const FORK_TOOL_NAME = "fork";
+
+/** Custom message type of a delivered fork result. */
+const FORK_RESULT_TYPE = "fork-result";
+
+/** Custom entry type used to remember forks that outlive an extension reload. */
+const FORK_ENTRY_TYPE = "fork";
+
+/** Set in a fork process so it does not offer the tool and watches the parent. */
+const ENV_FORK_ID = "PI_FORK_ID";
+const ENV_FORK_PARENT_PID = "PI_FORK_PARENT_PID";
+
+/** How often the parent checks forks and pending deliveries. */
+const POLL_INTERVAL_MS = 500;
+
+/** How often a fork checks whether its parent process is still alive. */
+const PARENT_WATCH_INTERVAL_MS = 1000;
+
+/** Grace period between SIGTERM and SIGKILL when a session ends. Well under the 5s budget. */
+const KILL_GRACE_MS = 2000;
+
+type ForkStatus = "completed" | "failed";
+
+interface ForkResultDetails {
+	forkId: string;
+	status: ForkStatus;
+	sessionFile?: string;
+	error?: string;
+}
+
+/** Shape of the custom entries that persist the fork registry in the parent session. */
+interface ForkEntryData {
+	kind: "started" | "cancelled";
+	forkId: string;
+	sessionFile?: string;
+	pid?: number;
+	parentPid?: number;
+}
+
+interface ForkExit {
+	code: number | null;
+	signal: string | null;
+}
+
+interface ForkRecord {
+	forkId: string;
+	sessionFile: string;
+	pid: number | undefined;
+	/** The child process handle, or undefined when the fork was adopted after an extension reload. */
+	child: ChildProcess | undefined;
+	stderr: string;
+	exit: ForkExit | undefined;
+	finished: boolean;
+	/** A delivery attempt is in flight and not confirmed yet. */
+	sent: boolean;
+	/** The result message is in the parent session. */
+	delivered: boolean;
+	result: { content: string; details: ForkResultDetails } | undefined;
+}
+
+/** The parent context a fork inherits: the request, the forking assistant message and its tool calls. */
+interface InheritedContext {
+	messages: Message[];
+	toolCalls: ToolCall[];
+	/** Tool results of the forking assistant message that were already recorded in the parent. */
+	recordedResults: Map<string, ToolResultMessage>;
+	/** The tool call that started the fork, undefined when it could not be located. */
+	forkToolCallId: string | undefined;
+}
+
+export default function (pi: ExtensionAPI) {
+	if (isForkProcess()) {
+		// A fork never offers the tool and stops when the parent process goes away.
+		watchParentProcess();
+		return;
+	}
+	installForkParent(pi);
+}
+
+function isForkProcess(): boolean {
+	const forkId = process.env[ENV_FORK_ID];
+	return typeof forkId === "string" && forkId.length > 0;
+}
+
+/**
+ * Poll the parent process. A killed parent leaves the fork orphaned, so the
+ * fork exits on its own; process.exit is used because print mode has no
+ * graceful shutdown handler.
+ */
+function watchParentProcess(): void {
+	const parentPid = Number(process.env[ENV_FORK_PARENT_PID]);
+	if (!Number.isInteger(parentPid) || parentPid <= 0) {
+		return;
+	}
+	const timer = setInterval(() => {
+		if (process.ppid !== parentPid || !isProcessAlive(parentPid)) {
+			clearInterval(timer);
+			process.exit(0);
+		}
+	}, PARENT_WATCH_INTERVAL_MS);
+	timer.unref?.();
+}
+
+function installForkParent(pi: ExtensionAPI): void {
+	let manager: ForkManager | undefined;
+
+	pi.on("session_start", (_event, ctx) => {
+		manager?.stop();
+		manager = new ForkManager(pi, ctx);
+		manager.start();
+	});
+
+	pi.on("context", (event) => {
+		// Remember the exact messages of the current request: a fork started from
+		// an assistant message of this request inherits them.
+		manager?.rememberRequest(event.messages);
+	});
+
+	pi.on("agent_settled", () => {
+		manager?.retryUnconfirmedDeliveries();
+	});
+
+	pi.on("session_shutdown", (event) => {
+		manager?.shutdown(event.reason);
+		manager = undefined;
+	});
+
+	pi.registerTool({
+		name: FORK_TOOL_NAME,
+		label: "Fork",
+		description:
+			"Start a background copy of this session that works on a task on its own and reports back later. " +
+			"The fork starts with the exact conversation the parent model sees, runs in a separate pi process, " +
+			"and returns immediately. Use it to investigate something in parallel without blocking the current task.",
+		promptSnippet: "Fork this session to work on a side task in the background",
+		promptGuidelines: [
+			"Call fork when a side investigation can run while the current work continues; do not wait for it.",
+			"A fork result arrives later as a message in this conversation, not as the fork tool result.",
+		],
+		parameters: Type.Object({
+			task: Type.String({ description: "What the fork should do. It starts with the full conversation so far." }),
+		}),
+		async execute(toolCallId, params, _signal, _onUpdate, ctx) {
+			const task = typeof params.task === "string" ? params.task.trim() : "";
+			if (!task) {
+				throw new Error("fork: task must not be empty");
+			}
+			if (!manager) {
+				manager = new ForkManager(pi, ctx);
+				manager.start();
+			}
+			const forkId = manager.startFork(toolCallId, task, ctx);
+			return {
+				content: [
+					{
+						type: "text" as const,
+						text: `Fork ${forkId} started in the background. Its result arrives as a message when it finishes.`,
+					},
+				],
+				details: { forkId },
+			};
+		},
+	});
+}
+
+/**
+ * Owns the forks of one parent session: starts them, watches them, delivers
+ * their results and stops them when the session ends.
+ */
+class ForkManager {
+	private readonly pi: ExtensionAPI;
+	private readonly ctx: ExtensionContext;
+	private readonly records = new Map<string, ForkRecord>();
+	private timer: ReturnType<typeof setInterval> | undefined;
+	private stopped = false;
+	/** Messages of the request that produced the current assistant message. */
+	private requestMessages: AgentMessage[] | undefined;
+
+	constructor(pi: ExtensionAPI, ctx: ExtensionContext) {
+		this.pi = pi;
+		this.ctx = ctx;
+	}
+
+	start(): void {
+		this.adoptRunningForks();
+		this.timer = setInterval(() => this.tick(), POLL_INTERVAL_MS);
+		this.timer.unref?.();
+	}
+
+	rememberRequest(messages: AgentMessage[]): void {
+		this.requestMessages = messages;
+	}
+
+	/** Stop watching. Running forks are not touched. */
+	stop(): void {
+		this.stopped = true;
+		if (this.timer !== undefined) {
+			clearInterval(this.timer);
+			this.timer = undefined;
+		}
+	}
+
+	/**
+	 * The session is going away. `reload` keeps the session (and therefore its
+	 * forks); everything else stops the forks and drops their results.
+	 */
+	shutdown(reason: "quit" | "reload" | "new" | "resume" | "fork"): void {
+		if (reason !== "reload") {
+			for (const record of this.records.values()) {
+				if (!record.finished) {
+					this.cancel(record);
+				}
+			}
+		}
+		this.stop();
+	}
+
+	startFork(toolCallId: string, task: string, ctx: ExtensionContext): string {
+		const model = ctx.model;
+		if (!model) {
+			throw new Error("fork: no model is selected in this session");
+		}
+
+		const forkId = uuidv7();
+		const parentSessionFile = ctx.sessionManager.getSessionFile();
+		const cwd = ctx.sessionManager.getCwd();
+		const inherited = collectInheritedContext(ctx, toolCallId, this.requestMessages);
+		const forkSessionFile = writeForkSessionFile({
+			cwd,
+			sessionDir: ctx.sessionManager.getSessionDir() || undefined,
+			parentSessionFile,
+			forkId,
+			inherited,
+		});
+
+		const args = ["-p", "--session", forkSessionFile, "--model", `${model.provider}/${model.id}`];
+		const thinkingLevel = ctx.thinkingLevel;
+		if (thinkingLevel) {
+			args.push("--thinking", thinkingLevel);
+		}
+		// `--` keeps a task that starts with a dash from being parsed as a flag.
+		args.push("--", task);
+
+		const invocation = getPiInvocation(args);
+		const child = spawn(invocation.command, invocation.args, {
+			cwd,
+			shell: false,
+			stdio: ["ignore", "ignore", "pipe"],
+			env: forkEnvironment(forkId),
+		});
+
+		const record: ForkRecord = {
+			forkId,
+			sessionFile: forkSessionFile,
+			pid: child.pid,
+			child,
+			stderr: "",
+			exit: undefined,
+			finished: false,
+			sent: false,
+			delivered: false,
+			result: undefined,
+		};
+		this.records.set(forkId, record);
+
+		child.stderr?.on("data", (chunk: Buffer | string) => {
+			record.stderr += chunk.toString();
+		});
+		child.on("error", (error) => {
+			record.stderr += error.message;
+			record.exit = { code: null, signal: null };
+			this.tick();
+		});
+		child.on("exit", (code, signal) => {
+			record.exit = { code, signal };
+			this.tick();
+		});
+
+		// Persist the fork so a replacement extension instance can adopt it after /reload.
+		this.persistEntry({
+			kind: "started",
+			forkId,
+			sessionFile: forkSessionFile,
+			pid: child.pid,
+			parentPid: process.pid,
+		});
+
+		return forkId;
+	}
+
+	/** Re-send results that were queued for a run the user interrupted. */
+	retryUnconfirmedDeliveries(): void {
+		if (this.stopped) return;
+		for (const record of this.records.values()) {
+			if (record.sent && !record.delivered && !this.isResultInSession(record.forkId)) {
+				record.sent = false;
+			}
+		}
+	}
+
+	private tick(): void {
+		if (this.stopped) return;
+		for (const record of this.records.values()) {
+			if (record.finished) continue;
+			const exited = record.exit !== undefined;
+			const gone = !exited && record.pid !== undefined && !isProcessAlive(record.pid);
+			if (exited || gone) {
+				this.finish(record);
+			}
+		}
+		this.deliverFinished();
+	}
+
+	private finish(record: ForkRecord): void {
+		record.finished = true;
+		record.result = buildForkResult(record);
+	}
+
+	private deliverFinished(): void {
+		for (const record of this.records.values()) {
+			if (!record.result || record.delivered) continue;
+			if (this.isResultInSession(record.forkId)) {
+				record.delivered = true;
+				continue;
+			}
+			if (record.sent) continue;
+			// Adopted forks waited out a reload: the previous instance may have
+			// queued the result for a run that is still going. Only add it when
+			// the parent is idle, so it cannot be delivered twice.
+			if (record.child === undefined && !this.isIdle()) continue;
+			this.sendResult(record);
+		}
+	}
+
+	private sendResult(record: ForkRecord): void {
+		const result = record.result;
+		if (!result) return;
+		try {
+			this.pi.sendMessage(
+				{
+					customType: FORK_RESULT_TYPE,
+					content: result.content,
+					display: true,
+					details: result.details,
+				},
+				{ triggerTurn: true },
+			);
+			record.sent = true;
+		} catch {
+			// The session went away between the check and the send.
+		}
+	}
+
+	private isIdle(): boolean {
+		try {
+			return this.ctx.isIdle();
+		} catch {
+			return false;
+		}
+	}
+
+	/** A delivered result is visible as a custom message in this session. */
+	private isResultInSession(forkId: string): boolean {
+		return this.ctx.sessionManager.getEntries().some((entry) => {
+			if (entry.type !== "custom_message" || entry.customType !== FORK_RESULT_TYPE) return false;
+			const details = entry.details as ForkResultDetails | undefined;
+			return details?.forkId === forkId;
+		});
+	}
+
+	/** Adopt forks started by this process before an extension reload. */
+	private adoptRunningForks(): void {
+		const latest = new Map<string, ForkEntryData>();
+		for (const entry of this.ctx.sessionManager.getEntries()) {
+			if (entry.type !== "custom" || entry.customType !== FORK_ENTRY_TYPE) continue;
+			const data = entry.data as ForkEntryData | undefined;
+			if (!data || typeof data.forkId !== "string") continue;
+			if (data.kind === "started") {
+				latest.set(data.forkId, data);
+			} else {
+				latest.delete(data.forkId);
+			}
+		}
+
+		for (const [forkId, data] of latest) {
+			if (data.parentPid !== process.pid) continue;
+			if (typeof data.sessionFile !== "string") continue;
+			if (this.records.has(forkId)) continue;
+			if (this.isResultInSession(forkId)) continue;
+			const record: ForkRecord = {
+				forkId,
+				sessionFile: data.sessionFile,
+				pid: data.pid,
+				child: undefined,
+				stderr: "",
+				exit: undefined,
+				finished: false,
+				sent: false,
+				delivered: false,
+				result: undefined,
+			};
+			if (typeof data.pid !== "number") {
+				// The process never started, so there is nothing to watch.
+				record.finished = true;
+				record.result = buildForkResult(record);
+			}
+			this.records.set(forkId, record);
+		}
+	}
+
+	private cancel(record: ForkRecord): void {
+		record.finished = true;
+		record.sent = true;
+		this.persistEntry({
+			kind: "cancelled",
+			forkId: record.forkId,
+			sessionFile: record.sessionFile,
+			parentPid: process.pid,
+		});
+		stopProcess(record.child, record.pid);
+	}
+
+	private persistEntry(data: ForkEntryData): void {
+		try {
+			this.pi.appendEntry(FORK_ENTRY_TYPE, data);
+		} catch {
+			// Persisting is best effort: the fork still runs without the record.
+		}
+	}
+}
+
+function forkEnvironment(forkId: string): NodeJS.ProcessEnv {
+	return {
+		...process.env,
+		[ENV_FORK_ID]: forkId,
+		[ENV_FORK_PARENT_PID]: String(process.pid),
+	};
+}
+
+/**
+ * Collect the context a fork inherits: everything up to and including the
+ * assistant message that contains the forking tool call, in the form the
+ * parent's model saw it (a compacted session contributes its compacted view).
+ */
+function collectInheritedContext(
+	ctx: ExtensionContext,
+	toolCallId: string,
+	requestMessages: AgentMessage[] | undefined,
+): InheritedContext {
+	const entries = ctx.sessionManager.buildContextEntries();
+	let assistantIndex = -1;
+	let assistant: AssistantMessage | undefined;
+	for (let i = entries.length - 1; i >= 0; i--) {
+		const entry = entries[i];
+		if (entry.type !== "message" || entry.message.role !== "assistant") continue;
+		if (entry.message.content.some((part) => part.type === "toolCall" && part.id === toolCallId)) {
+			assistantIndex = i;
+			assistant = entry.message;
+			break;
+		}
+	}
+
+	// Prefer the request the model actually saw. Fall back to the session when
+	// the request is not available (for example right after an extension
+	// reload), using the completed entries up to the forking assistant message.
+	const inheritedEntries = assistantIndex >= 0 ? entries.slice(0, assistantIndex + 1) : entries;
+	const messages = requestMessages
+		? convertToLlm(requestMessages)
+		: convertToLlm(inheritedEntries.flatMap(sessionEntryToContextMessages));
+	if (requestMessages && assistant) {
+		const assistantMessages = convertToLlm([assistant]);
+		messages.push(...assistantMessages);
+	}
+	const toolCalls = assistant?.content.filter((part): part is ToolCall => part.type === "toolCall") ?? [];
+
+	const recordedResults = new Map<string, ToolResultMessage>();
+	for (const entry of assistantIndex >= 0 ? entries.slice(assistantIndex + 1) : []) {
+		if (entry.type !== "message" || entry.message.role !== "toolResult") continue;
+		recordedResults.set(entry.message.toolCallId, entry.message);
+	}
+
+	return { messages, toolCalls, recordedResults, forkToolCallId: assistant ? toolCallId : undefined };
+}
+
+/**
+ * Write the fork's session file: the inherited conversation, a tool result for
+ * every tool call of the forking assistant message, and the parent session as
+ * the header's parentSession. The task itself is the prompt of the fork
+ * process, so it is appended by that process.
+ */
+function writeForkSessionFile(options: {
+	cwd: string;
+	sessionDir: string | undefined;
+	parentSessionFile: string | undefined;
+	forkId: string;
+	inherited: InheritedContext;
+}): string {
+	const manager = SessionManager.create(
+		options.cwd,
+		options.sessionDir,
+		options.parentSessionFile ? { parentSession: options.parentSessionFile } : undefined,
+	);
+	for (const message of options.inherited.messages) {
+		manager.appendMessage(message);
+	}
+	for (const toolCall of options.inherited.toolCalls) {
+		manager.appendMessage(toolResultFor(toolCall, options.inherited, options.forkId));
+	}
+
+	const sessionFile = manager.getSessionFile();
+	if (!sessionFile) {
+		throw new Error("fork: could not create a session file for the fork");
+	}
+	// SessionManager only flushes a session file once it holds an assistant
+	// message, and nothing is flushed before that. Write what it buffered
+	// ourselves so the fork always starts from the inherited conversation.
+	if (!fs.existsSync(sessionFile)) {
+		const header = manager.getHeader();
+		if (!header) {
+			throw new Error("fork: could not create a session header for the fork");
+		}
+		const lines = [header, ...manager.getEntries()].map((entry) => `${JSON.stringify(entry)}\n`);
+		fs.writeFileSync(sessionFile, lines.join(""));
+	}
+	return sessionFile;
+}
+
+function toolResultFor(toolCall: ToolCall, inherited: InheritedContext, forkId: string): ToolResultMessage {
+	if (toolCall.id === inherited.forkToolCallId) {
+		return {
+			role: "toolResult",
+			toolCallId: toolCall.id,
+			toolName: toolCall.name,
+			content: [{ type: "text", text: forkStartedText(forkId) }],
+			details: { forkId },
+			isError: false,
+			timestamp: Date.now(),
+		};
+	}
+	const recorded = inherited.recordedResults.get(toolCall.id);
+	if (recorded) {
+		return recorded;
+	}
+	// Providers reject an assistant tool call without a matching result, and the
+	// parent's own result for this call is not known yet. Record that the call
+	// ran in the parent instead.
+	return {
+		role: "toolResult",
+		toolCallId: toolCall.id,
+		toolName: toolCall.name,
+		content: [
+			{
+				type: "text",
+				text: `Tool call "${toolCall.name}" ran in the parent session; its result is not part of this fork's context.`,
+			},
+		],
+		isError: false,
+		timestamp: Date.now(),
+	};
+}
+
+function forkStartedText(forkId: string): string {
+	return `Fork ${forkId} started in the background. Its result arrives as a message when it finishes.`;
+}
+
+/** Read the fork's final state from its own session file and its process exit. */
+function buildForkResult(record: ForkRecord): { content: string; details: ForkResultDetails } {
+	const sessionFile = fs.existsSync(record.sessionFile) ? record.sessionFile : undefined;
+	const lastAssistant = readLastAssistantMessage(record.sessionFile);
+	const base: ForkResultDetails = { forkId: record.forkId, status: "completed" };
+	if (sessionFile !== undefined) {
+		base.sessionFile = sessionFile;
+	}
+	const failed = (error: string) => ({
+		content: error,
+		details: { ...base, status: "failed" as const, error },
+	});
+
+	// A model error keeps the message the provider returned.
+	if (lastAssistant?.stopReason === "error") {
+		return failed(lastAssistant.errorMessage?.trim() || "the fork's model request failed");
+	}
+	if (lastAssistant?.stopReason === "aborted") {
+		return failed(lastAssistant.errorMessage?.trim() || "the fork's run was aborted");
+	}
+
+	const exit = record.exit;
+	if (exit?.signal) {
+		return failed(`the fork process was killed by ${exit.signal}`);
+	}
+	if (exit && exit.code !== 0) {
+		return failed(record.stderr.trim() || `the fork process exited with code ${exit.code ?? "unknown"}`);
+	}
+	if (!lastAssistant) {
+		return failed(record.stderr.trim() || "the fork process exited without producing a response");
+	}
+	if (lastAssistant.stopReason === "toolUse") {
+		return failed(record.stderr.trim() || "the fork process exited before completing the task");
+	}
+
+	const text = assistantText(lastAssistant);
+	if (text.trim()) {
+		return { content: text, details: base };
+	}
+	return { content: "the fork finished without a text response", details: base };
+}
+
+function readLastAssistantMessage(sessionFile: string): AssistantMessage | undefined {
+	let raw: string;
+	try {
+		raw = fs.readFileSync(sessionFile, "utf-8");
+	} catch {
+		return undefined;
+	}
+	let last: AssistantMessage | undefined;
+	for (const line of raw.split("\n")) {
+		if (!line.trim()) continue;
+		let entry: FileEntry;
+		try {
+			entry = JSON.parse(line) as FileEntry;
+		} catch {
+			continue;
+		}
+		if (entry.type !== "message" || entry.message.role !== "assistant") continue;
+		last = entry.message;
+	}
+	return last;
+}
+
+function assistantText(message: AssistantMessage): string {
+	return message.content
+		.filter((part): part is TextContent => part.type === "text")
+		.map((part) => part.text)
+		.join("\n");
+}
+
+function stopProcess(child: ChildProcess | undefined, pid: number | undefined): void {
+	if (child) {
+		try {
+			child.kill("SIGTERM");
+		} catch {
+			// Already gone.
+		}
+		const target = child;
+		const killTimer = setTimeout(() => {
+			try {
+				target.kill("SIGKILL");
+			} catch {
+				// Already gone.
+			}
+		}, KILL_GRACE_MS);
+		killTimer.unref?.();
+		return;
+	}
+	if (pid === undefined || !isProcessAlive(pid)) return;
+	try {
+		process.kill(pid, "SIGTERM");
+	} catch {
+		return;
+	}
+	const killTimer = setTimeout(() => {
+		if (!isProcessAlive(pid)) return;
+		try {
+			process.kill(pid, "SIGKILL");
+		} catch {
+			// Already gone.
+		}
+	}, KILL_GRACE_MS);
+	killTimer.unref?.();
+}
+
+function isProcessAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (error) {
+		return (error as NodeJS.ErrnoException).code === "EPERM";
+	}
+}
+
+/** Run the same pi CLI as the parent process. */
+function getPiInvocation(args: string[]): { command: string; args: string[] } {
+	const currentScript = process.argv[1];
+	const isBunVirtualScript = currentScript?.startsWith("/$bunfs/root/");
+	if (currentScript && !isBunVirtualScript && fs.existsSync(currentScript)) {
+		return { command: process.execPath, args: [currentScript, ...args] };
+	}
+
+	const execName = path.basename(process.execPath).toLowerCase();
+	const isGenericRuntime = /^(node|bun)(\.exe)?$/.test(execName);
+	if (!isGenericRuntime) {
+		return { command: process.execPath, args };
+	}
+
+	return { command: "pi", args };
+}
