+}
+
+interface Harness {
+	ctx: ExtensionContext;
+	tool(): ToolDefinition;
+	sendMessage: ReturnType<typeof vi.fn<ExtensionAPI["sendMessage"]>>;
+	appendEntry: ReturnType<typeof vi.fn<ExtensionAPI["appendEntry"]>>;
+	sent: Array<{
+		message: Parameters<ExtensionAPI["sendMessage"]>[0];
+		options: Parameters<ExtensionAPI["sendMessage"]>[1];
+	}>;
+	fire(event: string, payload: unknown): Promise<void>;
+	setIdle(value: boolean): void;
+	/** When false, a sent message is dropped, as pi does for a run the user aborted. */
+	setAutoPersist(value: boolean): void;
+}
+
+function createHarness(sessionManager: SessionManager): Harness {
+	const handlers = new Map<string, Array<(event: unknown, ctx: ExtensionContext) => unknown>>();
+	const idle = { value: true };
+	const autoPersist = { value: true };
+	const sent: Harness["sent"] = [];
+	let tool: ToolDefinition | undefined;
+
+	const sendMessage = vi.fn<ExtensionAPI["sendMessage"]>((message, options) => {
+		sent.push({ message, options });
+		if (!autoPersist.value) return;
+		sessionManager.appendCustomMessageEntry(message.customType, message.content, message.display, message.details);
+	});
+	const appendEntry = vi.fn<ExtensionAPI["appendEntry"]>((customType, data) => {
+		sessionManager.appendCustomEntry(customType, data);
+	});
+
+	const api = {
+		on(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {
+			const list = handlers.get(event) ?? [];
+			list.push(handler);
+			handlers.set(event, list);
+		},
+		registerTool(definition: ToolDefinition) {
+			tool = definition;
+		},
+		registerCommand: vi.fn(),
+		registerFlag: vi.fn(),
+		registerShortcut: vi.fn(),
+		sendMessage,
+		appendEntry,
+	} as unknown as ExtensionAPI;
+
+	const ctx = {
+		sessionManager,
+		cwd: sessionManager.getCwd(),
+		model: { provider: "faux", id: "faux-model" },
+		thinkingLevel: "medium",
+		isIdle: () => idle.value,
+	} as unknown as ExtensionContext;
+
+	forkExtension(api);
+
+	return {
+		ctx,
+		sendMessage,
+		appendEntry,
+		sent,
+		tool() {
+			if (!tool) throw new Error("the fork tool was not registered");
+			return tool;
+		},
+		async fire(event, payload) {
+			for (const handler of handlers.get(event) ?? []) {
+				await handler(payload, ctx);
+			}
+		},
+		setIdle(value) {
+			idle.value = value;
+		},
+		setAutoPersist(value) {
+			autoPersist.value = value;
+		},
+	};
+}
+
+async function startSession(harness: Harness): Promise<void> {
+	await harness.fire("session_start", { type: "session_start", reason: "startup" });
+}
+
+function readEntries(sessionFile: string): FileEntry[] {
+	return fs
+		.readFileSync(sessionFile, "utf-8")
+		.split("\n")
+		.filter((line) => line.trim().length > 0)
+		.map((line) => JSON.parse(line) as FileEntry);
+}
+
+function readMessages(sessionFile: string): Array<Record<string, unknown>> {
+	return readEntries(sessionFile)
+		.filter((entry) => entry.type === "message")
+		.map((entry) => (entry as { message: unknown }).message as Record<string, unknown>);
+}
+
+function readCustomMessages(sessionFile: string): Array<Record<string, unknown>> {
+	return readEntries(sessionFile)
+		.filter((entry) => entry.type === "custom_message")
+		.map((entry) => entry as unknown as Record<string, unknown>);
+}
+
+/** Play the fork: append the final assistant message a real fork would write. */
+function finishForkSession(sessionFile: string, text: string): void {
+	const message = assistantMessage([{ type: "text", text }], "stop");
+	fs.appendFileSync(
+		sessionFile,
+		`${JSON.stringify({
+			type: "message",
+			id: `fake-${Date.now()}`,
+			parentId: null,
+			timestamp: new Date().toISOString(),
+			message,
+		})}\n`,
+	);
+}
+
+function sessionFileFromCall(call: { args: string[] }): string {
+	const index = call.args.indexOf("--session");
+	if (index < 0) throw new Error("spawn call has no --session argument");
+	return call.args[index + 1];
+}
+
+async function waitFor(predicate: () => boolean, timeoutMs = 5000): Promise<void> {
+	const start = Date.now();
+	while (Date.now() - start < timeoutMs) {
+		if (predicate()) return;
+		await new Promise((resolve) => setTimeout(resolve, 25));
+	}
+	throw new Error("waitFor timed out");
+}
+
+async function startFork(
+	harness: Harness,
