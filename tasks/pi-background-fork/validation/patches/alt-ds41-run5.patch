+	const details = result.details as { forkId: string };
+	const call = spawnState.calls[spawnState.calls.length - 1];
+	const child = spawnState.children[spawnState.children.length - 1];
+	return { forkId: details.forkId, sessionFile: sessionFileFromCall(call), child };
