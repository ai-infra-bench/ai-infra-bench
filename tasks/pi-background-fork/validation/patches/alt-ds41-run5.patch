+/**
+ * Tests for the fork example extension.
+ *
+ * The extension spawns a pi process for each fork. The spawn is mocked so the
+ * tests stay offline: the fake child only records the invocation, and the test
+ * plays the fork by writing the assistant message a real fork would write into
+ * its session file before exiting. The SDK package is mapped onto the workspace
+ * sources so the tests do not need a built dist directory.
+ */
+
+import type { ChildProcess, SpawnOptions } from "node:child_process";
+import { EventEmitter } from "node:events";
+import * as fs from "node:fs";
+import { tmpdir } from "node:os";
+import * as path from "node:path";
+import type { AssistantMessage, TextContent, ToolCall } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
