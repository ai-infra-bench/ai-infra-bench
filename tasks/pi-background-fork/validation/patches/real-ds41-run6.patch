+		api: api as unknown as ExtensionAPI,
+		tools,
+		sent,
+		ctx,
+		parentSessionFile,
+		sessionDir,
+		tempDir,
+		async emit(type: string, event: unknown) {
+			for (const handler of handlers.get(type) ?? []) {
+				await handler(event, ctx);
+			}
+		},
+		setIdle(value: boolean) {
+			idle = value;
+		},
+		setPending(value: boolean) {
+			pending = value;
+		},
+	};
+}
+
+/** A second extension instance for the same session, as /reload creates. */
+function createRigForExistingSession(rig: Rig): Rig {
+	return createRig({
+		parentSessionFile: rig.parentSessionFile,
+		sessionDir: rig.sessionDir,
+		tempDir: rig.tempDir,
+	});
+}
+
+function assistantMessage(text: string, overrides: Partial<AssistantMessage> = {}): AssistantMessage {
+	return {
+		role: "assistant",
+		content: text ? [{ type: "text", text }] : [],
+		api: "faux-api",
+		provider: "faux",
+		model: "faux-model",
+		usage: USAGE,
+		stopReason: "stop",
+		timestamp: Date.now(),
+		...overrides,
+	};
+}
+
+function toolCall(id: string, name: string, args: Record<string, unknown> = {}): ToolCall {
+	return { type: "toolCall", id, name, arguments: args };
+}
+
+function userMessage(text: string): AgentMessage {
+	return { role: "user", content: [{ type: "text", text }], timestamp: Date.now() };
+}
+
+function forkingAssistant(task: string, extra: ToolCall[] = []): AssistantMessage {
+	return assistantMessage("", {
+		content: [toolCall("call-fork", "fork", { task }), ...extra],
+		stopReason: "toolUse",
+	});
+}
+
+function defaultContext(): AgentMessage[] {
+	return [userMessage("hi"), assistantMessage("hello"), userMessage("please look into it")];
+}
+
+function installSpawner(): void {
+	spawnMock.mockImplementation(() => {
+		const child = new FakeChildProcess();
+		children.push(child);
+		queueMicrotask(() => child.emit("spawn"));
+		return child;
+	});
+}
+
+interface StartedFork {
+	forkId: string;
+	child: FakeChildProcess;
+	spawnArgs: string[];
+	sessionFile: string;
+	toolResult: AgentToolResult<{ forkId: string }>;
+}
+
+async function callFork(
+	rig: Rig,
+	options: { task?: string; assistant?: AssistantMessage; toolCallId?: string; context?: AgentMessage[] } = {},
+): Promise<StartedFork> {
+	const task = options.task ?? "side task";
+	const assistant = options.assistant ?? forkingAssistant(task);
+	const toolCallId = options.toolCallId ?? "call-fork";
+	const context = options.context ?? defaultContext();
+	await rig.emit("context", { type: "context", messages: context });
+	await rig.emit("message_end", { type: "message_end", message: assistant });
+	installSpawner();
+
+	const tool = rig.tools.get("fork");
+	if (!tool) throw new Error("fork tool was not registered");
+	const toolResult = (await tool.execute(toolCallId, { task }, undefined, undefined, rig.ctx)) as AgentToolResult<{
+		forkId: string;
+	}>;
+
+	const spawnArgs = (spawnMock.mock.calls.at(-1)?.[1] ?? []) as string[];
+	const sessionFile = spawnArgs[spawnArgs.indexOf("--session") + 1];
+	return {
+		forkId: toolResult.details.forkId,
+		child: children.at(-1) as FakeChildProcess,
+		spawnArgs,
+		sessionFile,
+		toolResult,
+	};
+}
+
+function closeChild(child: FakeChildProcess, message: AssistantMessage | undefined, code = 0): void {
+	if (message) {
+		child.stdout.write(`${JSON.stringify({ type: "message_end", message })}\n`);
+	}
+	child.emit("close", code, null);
+}
+
+/** The custom message as the session would emit it after delivery. */
+function deliveredMessage(sent: SentMessage): { role: "custom" } & SentMessage["message"] {
+	return { role: "custom", ...sent.message };
+}
+
+function readSessionEntries(file: string): Array<Record<string, unknown>> {
