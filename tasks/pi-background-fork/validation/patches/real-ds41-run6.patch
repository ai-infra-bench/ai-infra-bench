+
+const { spawnMock } = vi.hoisted(() => ({ spawnMock: vi.fn() }));
+
+vi.mock("node:child_process", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("node:child_process")>();
+	return { ...actual, spawn: spawnMock };
+});
+
+import forkExtension, { type ForkResultDetails } from "../examples/extensions/fork/index.ts";
+
+const USAGE: Usage = {
+	input: 0,
+	output: 0,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 0,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+
+interface SentMessage {
+	message: { customType: string; content: string; display: boolean; details: ForkResultDetails };
+	options: { triggerTurn?: boolean; deliverAs?: string };
+}
+
+type AnyHandler = (event: unknown, ctx: ExtensionContext) => unknown;
+
+interface Rig {
+	api: ExtensionAPI;
+	tools: Map<string, ToolDefinition>;
+	sent: SentMessage[];
+	ctx: ExtensionContext;
+	parentSessionFile: string;
+	sessionDir: string;
+	tempDir: string;
+	emit(type: string, event: unknown): Promise<void>;
+	setIdle(value: boolean): void;
+	setPending(value: boolean): void;
+}
+
+class FakeChildProcess extends EventEmitter {
+	readonly stdout = new PassThrough();
+	readonly stderr = new PassThrough();
+	readonly stdin = new PassThrough();
+	readonly stdinWrites: string[] = [];
+	readonly kills: Array<NodeJS.Signals | undefined> = [];
+	exitCode: number | null = null;
+	signalCode: NodeJS.Signals | null = null;
+
+	constructor() {
+		super();
+		this.stdin.on("data", (chunk: Buffer | string) => this.stdinWrites.push(chunk.toString()));
+	}
+
+	kill(signal?: NodeJS.Signals): boolean {
+		this.kills.push(signal);
+		this.signalCode = signal ?? "SIGTERM";
+		return true;
+	}
+}
+
+const tempDirs: string[] = [];
+let children: FakeChildProcess[] = [];
+
+interface RigOptions {
+	idle?: boolean;
+	pending?: boolean;
+	parentSessionFile?: string;
+	sessionDir?: string;
+	tempDir?: string;
+}
+
+function createRig(options: RigOptions = {}): Rig {
+	const tempDir = options.tempDir ?? fs.mkdtempSync(path.join(os.tmpdir(), "pi-fork-test-"));
+	if (!options.tempDir) tempDirs.push(tempDir);
+	const sessionDir = options.sessionDir ?? path.join(tempDir, "sessions");
+	if (!options.sessionDir) fs.mkdirSync(sessionDir, { recursive: true });
+	const parentSessionFile =
+		options.parentSessionFile ?? path.join(sessionDir, "2026-01-01T00-00-00-000Z_parent.jsonl");
+	if (!options.parentSessionFile) fs.writeFileSync(parentSessionFile, "");
+
+	const handlers = new Map<string, AnyHandler[]>();
+	const tools = new Map<string, ToolDefinition>();
+	const sent: SentMessage[] = [];
+	let idle = options.idle ?? true;
+	let pending = options.pending ?? false;
+
+	const api = {
+		on(type: string, handler: AnyHandler) {
+			const list = handlers.get(type) ?? [];
+			list.push(handler);
+			handlers.set(type, list);
+		},
+		registerTool(tool: ToolDefinition) {
+			tools.set(tool.name, tool);
+		},
+		sendMessage(message: SentMessage["message"], sendOptions: SentMessage["options"]) {
+			sent.push({ message, options: sendOptions });
+		},
+		sendUserMessage() {},
+		appendEntry() {},
+		getThinkingLevel: () => "medium",
+	};
+
+	const ctx = {
+		cwd: tempDir,
+		mode: "tui",
+		hasUI: true,
+		model: { provider: "faux", id: "faux-model", api: "faux-api" },
+		thinkingLevel: "high",
+		sessionManager: {
+			getSessionFile: () => parentSessionFile,
+			getSessionDir: () => sessionDir,
+			getSessionId: () => "parent-session-id",
+			buildContextEntries: () => [],
+			getEntries: () => [],
