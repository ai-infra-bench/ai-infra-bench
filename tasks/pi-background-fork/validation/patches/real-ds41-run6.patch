@@ -0,0 +1,732 @@
+/**
+ * Fork Tool - run a side investigation in a background copy of this agent.
+ *
+ * `fork` starts a second `pi` process that already knows the whole conversation
+ * so far, hands it one task, and returns immediately. When the fork finishes its
+ * answer is appended to the parent conversation as a `fork-result` message.
+ *
+ * The fork is a real pi process: it inherits the agent directory, settings,
+ * extensions, providers, environment, cwd, model and thinking level of the
+ * parent. It gets its own session file in the parent's session directory whose
+ * header points at the parent session file via `parentSession`.
+ *
+ * The fork tool itself is not registered inside forks: the child process is
+ * started with PI_FORK_EXTENSION_CHILD=1 and skips tool registration. The same
+ * marker enables a watchdog that stops the fork when the parent process dies.
+ */
+
+import { type ChildProcess, spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { AgentMessage, AgentToolResult } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import {
+	CURRENT_SESSION_VERSION,
+	type ExtensionAPI,
+	type ExtensionContext,
+	type SessionEntry,
+	sessionEntryToContextMessages,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const RESULT_CUSTOM_TYPE = "fork-result";
+const CHILD_ENV = "PI_FORK_EXTENSION_CHILD";
+const PARENT_PID_ENV = "PI_FORK_EXTENSION_PARENT_PID";
+/** How often a fork checks whether its parent process is still alive. */
+const WATCHDOG_INTERVAL_MS = 1000;
+/** Time between SIGTERM and SIGKILL when a parent session stops its forks. */
+const KILL_GRACE_MS = 2000;
+/** Placeholder recorded in the fork for tool calls the fork did not execute. */
+const SIBLING_TOOL_RESULT_TEXT = "(result not available in the fork)";
+/** Cap on failure reasons copied into the result message. */
+const MAX_ERROR_LENGTH = 4000;
+
+// ============================================================================
+// Result + state types
+// ============================================================================
+
+export interface ForkResultDetails {
+	forkId: string;
+	status: "completed" | "failed";
+	sessionFile?: string;
+	error?: string;
+}
+
+interface PendingForkResult {
+	forkId: string;
+	message: {
+		customType: string;
+		content: string;
+		display: boolean;
+		details: ForkResultDetails;
+	};
+	/** True once the result was handed to sendMessage; reset when it was not delivered. */
+	sent: boolean;
+}
+
+interface RunningFork {
+	forkId: string;
+	child: ChildProcess;
+	sessionFile: string;
+	/** True when the owning session stopped the fork; its result must be dropped. */
+	stopping: boolean;
+}
+
+interface ForkSessionState {
+	key: string;
+	pi: ExtensionAPI | undefined;
+	forks: Map<string, RunningFork>;
+	pending: Map<string, PendingForkResult>;
+	delivered: Set<string>;
+	usedIds: Set<string>;
+	lastAssistant: AssistantMessage | undefined;
+	/** Messages of the request that produced the current assistant message. */
+	context: AgentMessage[] | undefined;
+	/** Set when the owning session ended; results are dropped from then on. */
+	stopped: boolean;
+}
+
+interface ForkRegistry {
+	sessions: Map<string, ForkSessionState>;
+}
+
+const REGISTRY_KEY = "__piCodingAgentForkExtensionRegistry__";
+
+interface ForkGlobalState {
+	[REGISTRY_KEY]?: ForkRegistry;
+}
+
+function registry(): ForkRegistry {
+	const store = globalThis as unknown as ForkGlobalState;
+	store[REGISTRY_KEY] ??= { sessions: new Map() };
+	return store[REGISTRY_KEY];
+}
+
+// ============================================================================
+// Extension entry point
+// ============================================================================
+
+export default function forkExtension(pi: ExtensionAPI): void {
+	if (process.env[CHILD_ENV] === "1") {
+		installChildWatchdog();
+		return;
+	}
+	installParentExtension(pi);
+}
+
+function installParentExtension(pi: ExtensionAPI): void {
+	const stateFor = (ctx: ExtensionContext): ForkSessionState => {
+		const key = sessionKey(ctx);
+		const sessions = registry().sessions;
+		let state = sessions.get(key);
+		if (!state) {
+			state = {
+				key,
+				pi: undefined,
+				forks: new Map(),
+				pending: new Map(),
+				delivered: new Set(),
+				usedIds: new Set(),
+				lastAssistant: undefined,
+				context: undefined,
+				stopped: false,
+			};
+			sessions.set(key, state);
+		}
+		state.pi = pi;
+		return state;
+	};
+
+	// Re-attach after /reload: the extension module is re-imported, but running
+	// forks live in the global registry and keep delivering through the new API.
+	pi.on("session_start", (_event, ctx) => {
+		flushPending(stateFor(ctx));
+	});
+
+	// A session ends on quit / new / resume / fork. Reload keeps the session.
+	pi.on("session_shutdown", (event, ctx) => {
+		if (event.reason === "reload") return;
+		const sessions = registry().sessions;
+		const key = sessionKey(ctx);
+		const state = sessions.get(key);
+		if (!state) return;
+		stopSession(state);
+		sessions.delete(key);
+	});
+
+	// Snapshot the exact messages of every LLM request. The request that
+	// produced the forking assistant message is the last one seen here.
+	pi.on("context", (event, ctx) => {
+		stateFor(ctx).context = event.messages.slice();
+	});
+
+	pi.on("message_end", (event, ctx) => {
+		const state = stateFor(ctx);
+		const message = event.message;
+		if (message.role === "assistant") {
+			state.lastAssistant = message;
+			return;
+		}
+		if (message.role === "custom" && message.customType === RESULT_CUSTOM_TYPE) {
+			const forkId = (message.details as ForkResultDetails | undefined)?.forkId;
+			if (typeof forkId === "string") markDelivered(state, forkId);
+		}
+	});
+
+	// A result that was queued for an aborted run is discarded with the queue.
+	// Once the run settled and nothing is queued, deliver it again.
+	pi.on("agent_settled", (_event, ctx) => {
+		const state = registry().sessions.get(sessionKey(ctx));
+		if (!state || state.pending.size === 0) return;
+		if (ctx.hasPendingMessages()) return;
+		for (const entry of state.pending.values()) entry.sent = false;
+		flushPending(state);
+	});
+
+	pi.registerTool({
+		name: "fork",
+		label: "Fork",
+		description:
+			"Start a background copy of this agent that already knows the whole conversation so far and works on a single task in a separate pi process. Use it for side investigations that should not interrupt the current work. Returns immediately with a fork id; the fork's answer arrives later as a fork-result message.",
+		promptSnippet: "fork: start a background copy of this agent for a side task",
+		parameters: Type.Object({
+			task: Type.String({ description: "The task the fork should work on." }),
+		}),
+		async execute(toolCallId, params, _signal, _onUpdate, ctx): Promise<AgentToolResult<{ forkId: string }>> {
+			const task = params.task.trim();
+			if (!task) {
+				throw new Error("fork: task must not be empty");
+			}
+			const state = stateFor(ctx);
+			const { forkId } = await startFork({ pi, state, ctx, toolCallId, task });
+			return {
+				content: [
+					{
+						type: "text",
+						text: `Started fork ${forkId}. Its answer will arrive in this conversation as a ${RESULT_CUSTOM_TYPE} message.`,
+					},
+				],
+				details: { forkId },
+			};
+		},
+	});
+}
+
+// ============================================================================
+// Starting a fork
+// ============================================================================
+
+interface StartForkOptions {
+	pi: ExtensionAPI;
+	state: ForkSessionState;
+	ctx: ExtensionContext;
+	toolCallId: string;
+	task: string;
+}
+
+async function startFork({ pi, state, ctx, toolCallId, task }: StartForkOptions): Promise<{ forkId: string }> {
+	const forkId = createForkId(state);
+	const forkingMessage = findForkingAssistantMessage(state, ctx, toolCallId);
+	const sessionId = randomUUID();
+	const timestamp = new Date().toISOString();
+	const sessionDir = ctx.sessionManager.getSessionDir();
+	const parentSessionFile = ctx.sessionManager.getSessionFile();
+	const sessionFile = path.join(sessionDir, `${fileTimestamp(timestamp)}_${sessionId}.jsonl`);
+
+	const contextMessages = state.context ?? contextMessagesFromSession(ctx, toolCallId);
+	const startedText = `Fork ${forkId} was started.`;
+	const toolResults = buildForkToolResults(forkingMessage, toolCallId, startedText, timestamp);
+	const sessionContent = buildForkSessionContent({
+		sessionId,
+		timestamp,
+		cwd: ctx.cwd,
+		parentSessionFile,
+		messages: contextMessages,
+		assistantMessage: forkingMessage,
+		toolResults,
+	});
+
+	fs.mkdirSync(sessionDir, { recursive: true });
+	fs.writeFileSync(sessionFile, sessionContent, { encoding: "utf8", mode: 0o600 });
+
+	const model = ctx.model;
+	const thinking = ctx.thinkingLevel ?? pi.getThinkingLevel();
+	const args = buildForkArgs({ sessionFile, model, thinking });
+	const invocation = getPiInvocation(args);
+
+	const child = spawn(invocation.command, invocation.args, {
+		cwd: ctx.cwd,
+		env: { ...process.env, [CHILD_ENV]: "1", [PARENT_PID_ENV]: String(process.pid) },
+		shell: false,
+		stdio: ["pipe", "pipe", "pipe"],
+	});
+
+	try {
+		await waitForSpawn(child);
+	} catch (error) {
+		removeFile(sessionFile);
+		throw new Error(`fork: failed to start pi: ${error instanceof Error ? error.message : String(error)}`);
+	}
+
+	// The task is the fork's only new instruction: it becomes the first user
+	// message appended to the seeded session.
+	child.stdin?.on("error", () => {
+		/* the fork may exit before reading its task */
+	});
+	child.stdin?.end(`${task}\n`);
+
+	const running: RunningFork = { forkId, child, sessionFile, stopping: false };
+	state.forks.set(forkId, running);
+
+	const collector: ForkOutput = { lastAssistant: undefined, stderr: "", buffer: "" };
+	child.stdout?.on("data", (chunk: Buffer | string) => consumeStdout(collector, chunk.toString()));
+	child.stderr?.on("data", (chunk: Buffer | string) => {
+		collector.stderr += chunk.toString();
+	});
+	child.once("error", () => {
+		/* handled by the close handler */
+	});
+	child.once("close", (code, signal) => {
+		consumeStdout(collector, "\n");
+		finishFork({ state, running, code, signal, collector });
+	});
+
+	return { forkId };
+}
+
+function waitForSpawn(child: ChildProcess): Promise<void> {
+	return new Promise((resolve, reject) => {
+		const onSpawn = () => {
+			child.off("error", onError);
+			resolve();
+		};
+		const onError = (error: Error) => {
+			child.off("spawn", onSpawn);
+			reject(error);
+		};
+		child.once("spawn", onSpawn);
+		child.once("error", onError);
+	});
+}
+
+function buildForkArgs(input: {
+	sessionFile: string;
+	model: ExtensionContext["model"];
+	thinking: string | undefined;
+}): string[] {
+	const args = ["--mode", "json", "--session", input.sessionFile];
+	if (input.model) args.push("--model", `${input.model.provider}/${input.model.id}`);
+	if (input.thinking) args.push("--thinking", input.thinking);
+	return args;
+}
+
+function getPiInvocation(args: string[]): { command: string; args: string[] } {
+	const currentScript = process.argv[1];
+	const isBunVirtualScript = currentScript?.startsWith("/$bunfs/root/");
+	if (currentScript && !isBunVirtualScript && fs.existsSync(currentScript)) {
+		return { command: process.execPath, args: [currentScript, ...args] };
+	}
+
+	const execName = path.basename(process.execPath).toLowerCase();
+	const isGenericRuntime = /^(node|bun)(\.exe)?$/.test(execName);
+	if (!isGenericRuntime) {
+		return { command: process.execPath, args };
+	}
+
+	return { command: "pi", args };
+}
+
+// ============================================================================
+// Fork output + completion
+// ============================================================================
+
+interface ForkOutput {
+	lastAssistant: AssistantMessage | undefined;
+	stderr: string;
+	buffer: string;
+}
+
+function consumeStdout(collector: ForkOutput, chunk: string): void {
+	collector.buffer += chunk;
+	const lines = collector.buffer.split("\n");
+	collector.buffer = lines.pop() ?? "";
+	for (const line of lines) {
+		const trimmed = line.trim();
+		if (!trimmed) continue;
+		let event: unknown;
+		try {
+			event = JSON.parse(trimmed);
+		} catch {
+			continue;
+		}
+		if (!event || typeof event !== "object") continue;
+		const typed = event as { type?: unknown; message?: unknown };
+		if (typed.type !== "message_end") continue;
+		const message = typed.message as AgentMessage | undefined;
+		if (message?.role === "assistant") collector.lastAssistant = message;
+	}
+}
+
+function finishFork(input: {
+	state: ForkSessionState;
+	running: RunningFork;
+	code: number | null;
+	signal: NodeJS.Signals | null;
+	collector: ForkOutput;
+}): void {
+	const { state, running, code, signal, collector } = input;
+	state.forks.delete(running.forkId);
+	// The owning session ended: the fork must not deliver anything anywhere.
+	if (state.stopped || running.stopping) return;
+
+	const sessionFile = fs.existsSync(running.sessionFile) ? running.sessionFile : undefined;
+	const lastAssistant = collector.lastAssistant ?? readLastAssistantMessage(running.sessionFile);
+	const failure = forkFailureReason({ code, signal, lastAssistant, stderr: collector.stderr });
+
+	let message: PendingForkResult["message"];
+	if (failure || !lastAssistant) {
+		const reason = failure ?? "pi produced no assistant response";
+		message = {
+			customType: RESULT_CUSTOM_TYPE,
+			content: `Fork ${running.forkId} failed: ${reason}`,
+			display: true,
+			details: {
+				forkId: running.forkId,
+				status: "failed",
+				...(sessionFile ? { sessionFile } : {}),
+				error: reason,
+			},
+		};
+	} else {
+		message = {
+			customType: RESULT_CUSTOM_TYPE,
+			content: `Fork ${running.forkId} completed:\n\n${assistantText(lastAssistant)}`,
+			display: true,
+			details: {
+				forkId: running.forkId,
+				status: "completed",
+				...(sessionFile ? { sessionFile } : {}),
+			},
+		};
+	}
+
+	state.pending.set(running.forkId, { forkId: running.forkId, message, sent: false });
+	flushPending(state);
+}
+
+function forkFailureReason(input: {
+	code: number | null;
+	signal: NodeJS.Signals | null;
+	lastAssistant: AssistantMessage | undefined;
+	stderr: string;
+}): string | undefined {
+	if (input.signal) return truncate(`pi was killed by ${input.signal}`);
+	const last = input.lastAssistant;
+	if (last && (last.stopReason === "error" || last.stopReason === "aborted")) {
+		return truncate(last.errorMessage?.trim() || `the last model response ended with reason "${last.stopReason}"`);
+	}
+	if (input.code !== 0) {
+		const stderr = input.stderr.trim();
+		return truncate(stderr || `pi exited with code ${input.code}`);
+	}
+	if (!last) return "pi produced no assistant response";
+	return undefined;
+}
+
+function assistantText(message: AssistantMessage): string {
+	return message.content
+		.filter((content): content is { type: "text"; text: string } => content.type === "text")
+		.map((content) => content.text)
+		.join("\n");
+}
+
+function readLastAssistantMessage(sessionFile: string): AssistantMessage | undefined {
+	if (!fs.existsSync(sessionFile)) return undefined;
+	const lines = fs.readFileSync(sessionFile, "utf8").split("\n");
+	for (let i = lines.length - 1; i >= 0; i--) {
+		const trimmed = lines[i].trim();
+		if (!trimmed) continue;
+		try {
+			const entry = JSON.parse(trimmed) as { type?: unknown; message?: AgentMessage };
+			if (entry.type === "message" && entry.message?.role === "assistant") return entry.message;
+		} catch {
+			/* skip malformed lines */
+		}
+	}
+	return undefined;
+}
+
+// ============================================================================
+// Result delivery
+// ============================================================================
+
+function flushPending(state: ForkSessionState): void {
+	if (state.stopped) return;
+	const pi = state.pi;
+	if (!pi) return;
+	for (const entry of state.pending.values()) {
+		if (entry.sent || state.delivered.has(entry.forkId)) continue;
+		entry.sent = true;
+		try {
+			// Idle: starts a new run. Running: steered into the current run and
+			// delivered after the tool calls that are executing.
+			pi.sendMessage(entry.message, { triggerTurn: true });
+		} catch {
+			// The runtime was replaced (reload) or invalidated; retry later.
+			entry.sent = false;
+		}
+	}
+}
+
+function markDelivered(state: ForkSessionState, forkId: string): void {
+	if (!state.pending.has(forkId)) return;
+	state.pending.delete(forkId);
+	state.delivered.add(forkId);
+}
+
+function stopSession(state: ForkSessionState): void {
+	state.stopped = true;
+	for (const fork of state.forks.values()) {
+		fork.stopping = true;
+		terminateProcess(fork.child);
+	}
+	state.forks.clear();
+	state.pending.clear();
+}
+
+function terminateProcess(child: ChildProcess): void {
+	if (child.exitCode !== null || child.signalCode !== null) return;
+	try {
+		child.kill("SIGTERM");
+	} catch {
+		/* already gone */
+	}
+	const timer = setTimeout(() => {
+		try {
+			child.kill("SIGKILL");
+		} catch {
+			/* already gone */
+		}
+	}, KILL_GRACE_MS);
+	timer.unref?.();
+}
+
+// ============================================================================
+// Session bootstrapping
+// ============================================================================
+
+interface ForkSessionContentOptions {
+	sessionId: string;
+	timestamp: string;
+	cwd: string;
+	parentSessionFile: string | undefined;
+	messages: AgentMessage[];
+	assistantMessage: AssistantMessage;
+	toolResults: ToolResultMessage[];
+}
+
+/**
+ * Build the fork's session file: the parent context as the parent's model saw
+ * it, followed by the assistant message that requested the fork and one result
+ * for every tool call in it. The task follows as a regular user message.
+ */
+function buildForkSessionContent(options: ForkSessionContentOptions): string {
+	const ids = createEntryIdFactory();
+	const lines: string[] = [];
+	const header = {
+		type: "session",
+		version: CURRENT_SESSION_VERSION,
+		id: options.sessionId,
+		timestamp: options.timestamp,
+		cwd: options.cwd,
+		...(options.parentSessionFile ? { parentSession: options.parentSessionFile } : {}),
+	};
+	lines.push(JSON.stringify(header));
+
+	let parentId: string | null = null;
+	const append = (message: AgentMessage): void => {
+		const entry: SessionEntry = {
+			type: "message",
+			id: ids.next(),
+			parentId,
+			timestamp: messageTimestamp(message, options.timestamp),
+			message,
+		};
+		lines.push(JSON.stringify(entry));
+		parentId = entry.id;
+	};
+
+	for (const message of options.messages) append(message);
+	append(options.assistantMessage);
+	for (const result of options.toolResults) append(result);
+
+	return `${lines.join("\n")}\n`;
+}
+
+/** One result per tool call of the forking assistant message. */
+function buildForkToolResults(
+	assistantMessage: AssistantMessage,
+	forkToolCallId: string,
+	forkToolResultText: string,
+	timestamp: string,
+): ToolResultMessage[] {
+	const results: ToolResultMessage[] = [];
+	for (const content of assistantMessage.content) {
+		if (content.type !== "toolCall") continue;
+		results.push({
+			role: "toolResult",
+			toolCallId: content.id,
+			toolName: content.name,
+			content: [
+				{
+					type: "text",
+					text: content.id === forkToolCallId ? forkToolResultText : SIBLING_TOOL_RESULT_TEXT,
+				},
+			],
+			isError: false,
+			timestamp: new Date(timestamp).getTime(),
+		});
+	}
+	return results;
+}
+
+function findForkingAssistantMessage(
+	state: ForkSessionState,
+	ctx: ExtensionContext,
+	toolCallId: string,
+): AssistantMessage {
+	if (state.lastAssistant && hasToolCall(state.lastAssistant, toolCallId)) return state.lastAssistant;
+	for (const message of sessionAssistantMessages(ctx)) {
+		if (hasToolCall(message, toolCallId)) return message;
+	}
+	const fallback = state.lastAssistant ?? sessionAssistantMessages(ctx)[0];
+	if (!fallback) throw new Error("fork: could not find the assistant message that requested the fork");
+	return fallback;
+}
+
+function hasToolCall(message: AssistantMessage, toolCallId: string): boolean {
+	return message.content.some((content) => content.type === "toolCall" && content.id === toolCallId);
+}
+
+function sessionAssistantMessages(ctx: ExtensionContext): AssistantMessage[] {
+	const messages = ctx.sessionManager.buildContextEntries().flatMap(sessionEntryToContextMessages);
+	const assistants: AssistantMessage[] = [];
+	for (let i = messages.length - 1; i >= 0; i--) {
+		const message = messages[i];
+		if (message.role === "assistant") assistants.push(message);
+	}
+	return assistants;
+}
+
+/** Fallback when no live request snapshot is available (for example after /reload). */
+function contextMessagesFromSession(ctx: ExtensionContext, toolCallId: string): AgentMessage[] {
+	const messages = ctx.sessionManager.buildContextEntries().flatMap(sessionEntryToContextMessages);
+	for (let i = messages.length - 1; i >= 0; i--) {
+		const message = messages[i];
+		if (message.role === "assistant" && hasToolCall(message, toolCallId)) return messages.slice(0, i);
+	}
+	return messages;
+}
+
+function sessionKey(ctx: ExtensionContext): string {
+	const sessionFile = ctx.sessionManager.getSessionFile();
+	return sessionFile ? `file:${sessionFile}` : `id:${ctx.sessionManager.getSessionId()}`;
+}
+
+function createForkId(state: ForkSessionState): string {
+	for (let attempt = 0; attempt < 100; attempt++) {
+		const id = randomUUID().replace(/-/g, "").slice(0, 12);
+		if (!state.usedIds.has(id)) {
+			state.usedIds.add(id);
+			return id;
+		}
+	}
+	const fallback = randomUUID();
+	state.usedIds.add(fallback);
+	return fallback;
+}
+
+function createEntryIdFactory(): { next: () => string } {
+	const seen = new Set<string>();
+	return {
+		next() {
+			for (let attempt = 0; attempt < 100; attempt++) {
+				const id = randomUUID().slice(0, 8);
+				if (!seen.has(id)) {
+					seen.add(id);
+					return id;
+				}
+			}
+			const fallback = randomUUID();
+			seen.add(fallback);
+			return fallback;
+		},
+	};
+}
+
+function messageTimestamp(message: AgentMessage, fallback: string): string {
+	const timestamp = (message as { timestamp?: unknown }).timestamp;
+	if (typeof timestamp === "number" && Number.isFinite(timestamp)) return new Date(timestamp).toISOString();
+	return fallback;
+}
+
+function fileTimestamp(timestamp: string): string {
+	return timestamp.replace(/[:.]/g, "-");
+}
+
+function truncate(text: string): string {
+	return text.length > MAX_ERROR_LENGTH ? `${text.slice(0, MAX_ERROR_LENGTH)}...` : text;
+}
+
+function removeFile(filePath: string): void {
+	try {
+		fs.rmSync(filePath, { force: true });
+	} catch {
+		/* ignore */
+	}
+}
+
+// ============================================================================
+// Fork process watchdog
+// ============================================================================
+
+/**
+ * A fork stops itself when its parent process is gone, even if the parent was
+ * killed without shutting down.
+ */
+function installChildWatchdog(): void {
+	const raw = process.env[PARENT_PID_ENV];
+	const parentPid = raw === undefined ? Number.NaN : Number(raw);
+	if (!Number.isInteger(parentPid) || parentPid <= 0) return;
+	const timer = setInterval(() => {
+		if (isProcessAlive(parentPid)) return;
+		clearInterval(timer);
+		stopForkProcess();
+	}, WATCHDOG_INTERVAL_MS);
+	timer.unref();
+}
+
+/**
+ * Shut this fork down. SIGTERM lets pi run its own shutdown (including killing
+ * detached shell children); the timer guarantees the fork is gone quickly even
+ * if that shutdown stalls. Nobody is left to collect a result either way.
+ */
+function stopForkProcess(): void {
+	const hardExit = setTimeout(() => process.exit(1), KILL_GRACE_MS);
+	hardExit.unref?.();
+	try {
+		process.kill(process.pid, "SIGTERM");
+	} catch {
+		process.exit(1);
+	}
+}
+
+function isProcessAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (error) {
+		return (error as NodeJS.ErrnoException).code === "EPERM";
+	}
+}
