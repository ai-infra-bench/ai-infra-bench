+        # Keep this path capture-safe: querying the CUDA boolean with .item()
+        # would synchronize the host and can regress hybrid/speculative runs.
+        is_prefilling = is_prefilling & ~prefill_to_decode
+        common_attn_metadata = common_attn_metadata.replace(
