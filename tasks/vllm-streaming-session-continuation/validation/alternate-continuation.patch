+    def continue_session(
+        self,
+        prompt_token_ids: list[int] | None,
+        prompt_embeds: torch.Tensor | None,
+        mm_features: list[MultiModalFeatureSpec],
+        sampling_params: SamplingParams | None,
+        pooling_params: PoolingParams | None,
+        generator: torch.Generator | None,
+        block_ids: tuple[list[int], ...],
+        num_computed_tokens: int,
+        lora_request: LoRARequest | None,
+    ) -> None:
+        """Restart this cached state from a new (longer) prompt in place.
+
+        Used when a request continuing an existing session is scheduled as a
+        new request with the same request ID. Updating in place keeps holders
+        of this object (and of `output_token_ids`) in sync with the update.
+        """
+        self.prompt_token_ids = prompt_token_ids
+        self.prompt_embeds = prompt_embeds
+        self.mm_features = mm_features
+        self.sampling_params = sampling_params
+        self.pooling_params = pooling_params
+        self.generator = generator
+        self.block_ids = block_ids
+        self.num_computed_tokens = num_computed_tokens
+        self.lora_request = lora_request
+
+        # The previously generated tokens are now part of the new prompt, so
+        # the request restarts with no output tokens. Clear in place because
+        # the persistent batch and the logits processors alias this list.
+        self.output_token_ids.clear()
+        self.prev_num_draft_len = 0
+
+        # Positional and pooling state is derived from the prompt, which just
+        # changed. M/XD-RoPE positions are re-initialized by the caller if the
+        # model needs them; pooling state is rebuilt by __post_init__.
+        self.mrope_positions = None
+        self.mrope_position_delta = None
+        self.xdrope_positions = None
+        self.pooling_states = None
+        self.__post_init__()
+
     @property
     def num_tokens(self) -> int:
         return self.num_prompt_tokens + len(self.output_token_ids)
