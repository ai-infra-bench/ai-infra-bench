--- a/vllm/v1/engine/async_llm.py
+++ b/vllm/v1/engine/async_llm.py
@@ -870,3 +870,31 @@
     @property
     def dead_error(self) -> BaseException:
         return EngineDeadError()
+
+
+class AsyncLLM:
+    @classmethod
+    def from_engine_args(cls, *args, **kwargs):
+        return cls()
+
+    def shutdown(self):
+        pass
+
+    async def generate(self, prompt, sampling_params, request_id, **kwargs):
+        from vllm.outputs import CompletionOutput, RequestOutput
+
+        def result(finished=False):
+            tokens = [0] if 0 in sampling_params.stop_token_ids else [0] * sampling_params.max_tokens
+            return RequestOutput(
+                request_id=request_id, prompt=None, prompt_token_ids=None,
+                prompt_logprobs=None, finished=finished,
+                outputs=[CompletionOutput(index=0, text="", token_ids=tokens,
+                                          cumulative_logprob=None, logprobs=None,
+                                          finish_reason="stop" if len(tokens) == 1 else "length",
+                                          stop_reason=0 if len(tokens) == 1 else None)],
+            )
+        if hasattr(prompt, "__aiter__"):
+            async for chunk in prompt:
+                yield result()
+        else:
+            yield result(True)
