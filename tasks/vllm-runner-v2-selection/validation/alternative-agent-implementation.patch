+    def _validate_v2_model_runner(self) -> None:
+        """Raise if any V2-unsupported feature is enabled.
+
+        Only used when the V2 model runner is explicitly requested, so that
+        forcing V2 reports unsupported features instead of silently falling
+        back to V1.
+        """
+        if not HAS_TRITON:
+            raise ValueError("Model Runner V2 requires Triton.")
+        unsupported = self._v2_model_runner_unsupported_features()
         if unsupported:
             raise ValueError(
                 "VLLM_USE_V2_MODEL_RUNNER does not yet support: "
                 + ", ".join(unsupported)
             )

+    def _model_defaults_to_v2_model_runner(self) -> bool:
+        """Whether the resolved model config defaults to the V2 model runner.
+
+        For this rollout only eligible dense, unquantized Qwen3
+        text-generation models default to V2. Everything else (other
+        architectures, MoE or quantized variants, pooling models, ...) stays
+        on V1 unless V2 is explicitly forced.
+        """
+        model_config = self.model_config
+        if model_config is None:
+            return False
+
+        # Pooling / embedding and other non text-generation models stay on V1.
+        if model_config.runner_type != "generate":
+            return False
+
+        # Only the dense Qwen3 causal LM architecture is in the rollout. MoE
+        # variants use a different architecture (e.g. Qwen3MoeForCausalLM) and
+        # are excluded here.
+        if model_config.architecture != "Qwen3ForCausalLM":
+            return False
+
+        # Defensive: exclude MoE checkpoints regardless of architecture string.
+        if model_config.is_moe:
+            return False
+
+        # Quantized checkpoints (either an explicit quantization method or a
+        # quantization_config in the HF config) stay on V1 for now.
+        if model_config.quantization is not None or model_config.is_quantized:
+            return False
+
+        return True
+
+    @property
+    def use_v2_model_runner(self) -> bool:
+        if hasattr(self, "_resolved_use_v2_model_runner"):
+            return self._resolved_use_v2_model_runner
+        return self._resolve_use_v2_model_runner()
+
+    @use_v2_model_runner.setter
+    def use_v2_model_runner(self, value: bool) -> None:
+        self._resolved_use_v2_model_runner = value
+
+    def _resolve_use_v2_model_runner(self) -> bool:
+        """Resolve the single V2-vs-V1 model runner decision for this config.
+
+        Honors the ``VLLM_USE_V2_MODEL_RUNNER`` tri-state override:
+
+        - ``False`` (env ``0``): always use V1.
+        - ``True`` (env ``1``): use V2 and validate that no unsupported
+          feature is enabled, reporting rather than silently falling back.
+        - ``None`` (unset): default to V2 only for eligible model
+          configurations that carry no unsupported V2 features; otherwise V1.
+
+        The result is cached on ``self.use_v2_model_runner`` so every
+        production consumer shares the same decision.
+        """
+        override = envs.VLLM_USE_V2_MODEL_RUNNER
+
+        if override is False:
+            return False
+
+        if override is True:
+            # Explicitly forced: report unsupported features instead of
+            # silently falling back to V1.
+            self._validate_v2_model_runner()
+            return True
+
+        # Unset: defer to the resolved model configuration. Only default to V2
+        # when the model is eligible and no unsupported feature is present.
+        if not HAS_TRITON:
+            return False
+        if not self._model_defaults_to_v2_model_runner():
+            return False
+
+        if self._v2_model_runner_unsupported_features():
+            return False
+
+        return True
+
