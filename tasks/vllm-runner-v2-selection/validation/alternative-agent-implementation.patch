+    def _model_defaults_to_v2_model_runner(self) -> bool:
+        """Whether the resolved model config defaults to the V2 model runner.
+
+        For this rollout only eligible dense, unquantized Qwen3
+        text-generation models default to V2. Everything else (other
+        architectures, MoE or quantized variants, pooling models, ...) stays
+        on V1 unless V2 is explicitly forced.
+        """
+        model_config = self.model_config
+        if model_config is None:
+            return False
+
+        # Pooling / embedding and other non text-generation models stay on V1.
+        if model_config.runner_type != "generate":
+            return False
+
+        # Only the dense Qwen3 causal LM architecture is in the rollout. MoE
+        # variants use a different architecture (e.g. Qwen3MoeForCausalLM) and
+        # are excluded here.
+        if model_config.architecture != "Qwen3ForCausalLM":
+            return False
+
+        # Defensive: exclude MoE checkpoints regardless of architecture string.
+        if model_config.is_moe:
+            return False
+
+        # Quantized checkpoints (either an explicit quantization method or a
+        # quantization_config in the HF config) stay on V1 for now.
+        if model_config.quantization is not None or model_config.is_quantized:
+            return False
+
+        return True
+
