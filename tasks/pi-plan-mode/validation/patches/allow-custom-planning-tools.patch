+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import { describe, expect, it, vi } from "vitest";
+import planModeExtension, { type PlanState } from "../examples/extensions/plan-mode/index.ts";
+import type { ExtensionAPI, ExtensionContext, InputSource } from "../src/core/extensions/index.ts";
+
+type Handler = (event: never, ctx: ExtensionContext) => unknown;
+type CommandHandler = (args: string, ctx: ExtensionContext) => Promise<void>;
+type SavedEntry = { type: "custom"; customType: string; data: unknown };
+interface ControlResult {
+	operation: string;
+	ok: boolean;
+	errorCode: string | null;
+	state: PlanState;
+}
+interface SubmittedPlan {
+	content: Array<{ type: "text"; text: string }>;
+	details: PlanState;
+}
+interface SubmitTool {
+	name: string;
+	execute: (
+		id: string,
+		input: { steps: string[] },
+		signal: undefined,
+		update: undefined,
+		ctx: ExtensionContext,
+	) => Promise<SubmittedPlan>;
+}
+
+function assistant(text: string): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "mock",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: Date.now(),
+	};
+}
+
+async function setup(
+	options: {
+		activeTools?: string[];
+		entries?: SavedEntry[];
+		sessionId?: string;
+		flag?: boolean;
+		hasUI?: boolean;
+		select?: () => Promise<string | undefined>;
+		editorText?: string;
+	} = {},
+) {
+	let activeTools = [...(options.activeTools ?? ["read", "bash", "edit", "write", "echo_tool"]), "plan_submit"];
+	let idle = true;
+	let pending = false;
+	const entries = structuredClone(options.entries ?? []);
+	const handlers = new Map<string, Handler>();
+	const commands = new Map<string, CommandHandler>();
+	let shortcut: ((ctx: ExtensionContext) => unknown) | undefined;
+	let tool: SubmitTool | undefined;
+	const sendMessage = vi.fn<ExtensionAPI["sendMessage"]>();
+	const sendUserMessage = vi.fn<ExtensionAPI["sendUserMessage"]>();
+	const setActiveTools = vi.fn((names: string[]) => {
+		activeTools = [...names];
+	});
+	const api = {
+		registerFlag: vi.fn(),
+		getFlag: () => options.flag ?? false,
+		registerCommand(name: string, command: { handler: CommandHandler }) {
+			commands.set(name, command.handler);
+		},
+		registerShortcut(_key: string, spec: { handler: (ctx: ExtensionContext) => unknown }) {
+			shortcut = spec.handler;
+		},
+		registerTool(value: unknown) {
+			tool = value as SubmitTool;
+		},
+		on(name: string, handler: unknown) {
+			handlers.set(name, handler as Handler);
+		},
+		getActiveTools: () => [...activeTools],
+		setActiveTools,
+		sendMessage,
+		sendUserMessage,
+		appendEntry(customType: string, data: unknown) {
+			entries.push({ type: "custom", customType, data: structuredClone(data) });
+		},
+	} as unknown as ExtensionAPI;
+	const ctx = {
+		hasUI: options.hasUI ?? false,
+		ui: {
+			setStatus: vi.fn(),
+			setWidget: vi.fn(),
+			notify: vi.fn(),
+			select: vi.fn(options.select ?? (async () => undefined)),
+			editor: vi.fn(async () => options.editorText),
+		},
+		sessionManager: { getEntries: () => entries, getSessionId: () => options.sessionId ?? "session-a" },
+		isIdle: () => idle,
+		hasPendingMessages: () => pending,
+	} as unknown as ExtensionContext;
+	planModeExtension(api);
+	async function emit(type: string, fields: Record<string, unknown> = {}) {
+		return handlers.get(type)?.({ type, ...fields } as never, ctx);
+	}
+	async function control(text: string, source: InputSource = "rpc") {
+		expect(await emit("input", { text, source })).toEqual({ action: "handled" });
+		return entries.filter((entry) => entry.customType === "plan-control-result").at(-1)?.data as ControlResult;
+	}
+	await emit("session_start", { reason: "startup" });
+	return {
+		ctx,
+		entries,
+		commands,
+		sendMessage,
+		sendUserMessage,
+		setActiveTools,
+		emit,
+		control,
+		activeTools: () => [...activeTools],
+		setBusy(value: boolean) {
+			idle = !value;
+		},
+		setPending(value: boolean) {
+			pending = value;
+		},
+		async command(name: string) {
+			await commands.get(name)?.("", ctx);
+		},
+		async shortcut() {
+			await shortcut?.(ctx);
+		},
+		async submit(steps: string[]) {
+			if (!tool) throw new Error("plan_submit is missing");
+			return tool.execute("call-1", { steps }, undefined, undefined, ctx);
+		},
+		async approve(state: PlanState, source: InputSource = "rpc") {
+			return control(`/plan-control approve ${state.sessionId} ${state.planId} ${state.revision}`, source);
+		},
+	};
+}
+
+describe("plan-mode example extension", () => {
+	it("restricts the original tools and keeps repeated command and shortcut entry idempotent", async () => {
+		const h = await setup({ activeTools: ["find", "read", "write", "echo_tool"] });
+		expect(h.activeTools()).toEqual(["find", "read", "write", "echo_tool"]);
+		await expect(h.submit(["A step"])).rejects.toThrow("planning");
+		await h.command("plan");
+		expect(h.activeTools()).toEqual(["find", "read", "plan_submit"]);
+		const draft = (await h.submit(["Keep this draft"])).details;
+		await h.command("plan");
+		await h.shortcut();
+		expect((await h.control("/plan-control status")).state).toEqual(draft);
+		await h.approve(draft);
+		expect(h.activeTools()).toEqual(["find", "read", "write", "echo_tool"]);
+		expect(h.commands.has("plan-control")).toBe(false);
