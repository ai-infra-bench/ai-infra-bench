+/** Plan Mode with explicit, session-scoped approval of immutable plan revisions. */
+
+import { randomUUID } from "node:crypto";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { Key } from "@earendil-works/pi-tui";
+import { Type } from "typebox";
+import { markCompletedSteps, type TodoItem } from "./utils.ts";
+
+const READ_TOOLS = new Set(["read", "grep", "find", "ls"]);
+const STATE_TYPE = "plan-mode-v2";
+
+export interface PlanState {
+	sessionId: string;
+	mode: "normal" | "planning" | "approved";
+	planId: string | null;
+	revision: number;
+	steps: string[];
+	approvedRevision: number | null;
+}
+
+interface SavedPlan {
+	state: PlanState;
+	toolsBeforePlanning: string[];
+	completed: number[];
+}
+
+type Operation = "enter" | "status" | "approve" | "unknown";
+type ControlError = "invalid_input" | "forbidden_source" | "busy" | "no_plan" | "plan_mismatch" | "stale_revision";
+
+function isSavedPlan(value: unknown): value is SavedPlan {
+	if (!value || typeof value !== "object") return false;
+	const saved = value as Partial<SavedPlan>;
+	const state = saved.state;
+	if (!state || typeof state !== "object") return false;
+	if (typeof state.sessionId !== "string" || !Number.isSafeInteger(state.revision) || state.revision < 0) return false;
+	if (
+		!Array.isArray(state.steps) ||
+		!state.steps.every((step) => typeof step === "string" && step.trim().length > 0)
+	) {
+		return false;
+	}
+	if (
+		!Array.isArray(saved.toolsBeforePlanning) ||
+		!saved.toolsBeforePlanning.every((tool) => typeof tool === "string")
+	) {
+		return false;
+	}
+	if (!Array.isArray(saved.completed) || !saved.completed.every((step) => Number.isSafeInteger(step) && step > 0)) {
+		return false;
+	}
+	if (state.mode === "normal") {
+		return (
+			state.planId === null && state.revision === 0 && state.steps.length === 0 && state.approvedRevision === null
+		);
+	}
+	if (typeof state.planId !== "string" || !state.planId) return false;
+	if (state.mode === "planning") {
+		return (
+			state.approvedRevision === null && (state.revision === 0 ? state.steps.length === 0 : state.steps.length > 0)
+		);
+	}
+	return (
+		state.mode === "approved" &&
+		state.revision > 0 &&
+		state.steps.length > 0 &&
+		state.approvedRevision === state.revision
+	);
+}
+
+export default function planModeExtension(pi: ExtensionAPI): void {
+	let state: PlanState = {
+		sessionId: "",
+		mode: "normal",
+		planId: null,
+		revision: 0,
+		steps: [],
+		approvedRevision: null,
+	};
+	let toolsBeforePlanning: string[] = [];
+	let todos: TodoItem[] = [];
+	let reviewOpen = false;
+
+	function snapshot(): PlanState {
+		return { ...state, steps: [...state.steps] };
+	}
+
+	function persist(): void {
+		pi.appendEntry<SavedPlan>(STATE_TYPE, {
+			state: snapshot(),
+			toolsBeforePlanning: [...toolsBeforePlanning],
+			completed: todos.filter((item) => item.completed).map((item) => item.step),
+		});
+	}
+
+	function updateStatus(ctx: ExtensionContext): void {
+		if (state.mode === "planning") {
+			ctx.ui.setStatus("plan-mode", `plan r${state.revision}`);
+		} else if (state.mode === "approved") {
+			ctx.ui.setStatus(
+				"plan-mode",
+				`approved r${state.revision}: ${todos.filter((item) => item.completed).length}/${todos.length}`,
+			);
+		} else {
+			ctx.ui.setStatus("plan-mode", undefined);
+		}
+		ctx.ui.setWidget(
+			"plan-todos",
+			todos.length ? todos.map((item) => `${item.completed ? "[x]" : "[ ]"} ${item.step}. ${item.text}`) : undefined,
+		);
+	}
+
+	function result(operation: Operation, errorCode: ControlError | null): void {
+		pi.appendEntry("plan-control-result", { operation, ok: errorCode === null, errorCode, state: snapshot() });
+	}
+
+	function busy(ctx: ExtensionContext): boolean {
+		return !ctx.isIdle() || ctx.hasPendingMessages();
+	}
+
+	function enter(ctx: ExtensionContext): ControlError | null {
+		if (busy(ctx)) return "busy";
+		if (state.mode === "planning") return null;
+		toolsBeforePlanning = pi.getActiveTools().filter((name) => name !== "plan_submit");
+		state = {
+			sessionId: ctx.sessionManager.getSessionId(),
+			mode: "planning",
+			planId: randomUUID(),
+			revision: 0,
+			steps: [],
+			approvedRevision: null,
+		};
+		todos = [];
+		persist();
+		pi.setActiveTools([...toolsBeforePlanning.filter((name) => READ_TOOLS.has(name) || !["bash", "powershell", "edit", "write"].includes(name)), "plan_submit"]);
+		updateStatus(ctx);
+		return null;
+	}
+
+	function approve(ctx: ExtensionContext, sessionId: string, planId: string, revision: number): ControlError | null {
+		if (busy(ctx)) return "busy";
+		if (state.mode === "normal" || state.revision === 0 || state.steps.length === 0) return "no_plan";
+		if (sessionId !== ctx.sessionManager.getSessionId() || sessionId !== state.sessionId || planId !== state.planId) {
+			return "plan_mismatch";
+		}
+		if (revision !== state.revision) return "stale_revision";
+		if (state.mode === "approved") return null;
+		state = { ...state, mode: "approved", approvedRevision: state.revision, steps: [...state.steps] };
+		// Persist before dispatch: normal resume must never replay an already-approved request.
+		persist();
+		pi.setActiveTools([...toolsBeforePlanning]);
+		updateStatus(ctx);
+		const approved = {
+			sessionId: state.sessionId,
+			planId: state.planId,
+			revision: state.revision,
+			steps: [...state.steps],
+		};
+		pi.sendMessage(
+			{
+				customType: "plan-approved",
+				details: approved,
+				content: `Execute the approved plan.\nSession: ${approved.sessionId}\nPlan: ${approved.planId}\nRevision: ${approved.revision}\n\n${approved.steps.map((step, i) => `${i + 1}. ${step}`).join("\n")}\n\nReport completed steps with [DONE:n].`,
+				display: true,
+			},
+			{ triggerTurn: true, deliverAs: "followUp" },
+		);
+		return null;
+	}
+
+	async function review(ctx: ExtensionContext): Promise<void> {
+		if (!ctx.hasUI || reviewOpen || busy(ctx) || state.mode !== "planning" || state.revision === 0) return;
+		reviewOpen = true;
+		const displayed = snapshot();
+		try {
+			const choice = await ctx.ui.select(
+				`Plan ${displayed.planId}, revision ${displayed.revision}\n${displayed.steps.map((step, i) => `${i + 1}. ${step}`).join("\n")}\nWhat next?`,
+				["Execute the plan (track progress)", "Stay in plan mode", "Refine the plan"],
+			);
+			if (choice === "Execute the plan (track progress)" && displayed.planId) {
+				const error = approve(ctx, displayed.sessionId, displayed.planId, displayed.revision);
+				result("approve", error);
+				if (error) ctx.ui.notify(`Plan approval rejected: ${error}`, "warning");
+			} else if (choice === "Refine the plan") {
+				const refinement = await ctx.ui.editor("Refine the plan:", "");
+				if (refinement?.trim() && state.mode === "planning" && state.planId === displayed.planId && !busy(ctx)) {
+					pi.sendUserMessage(refinement.trim(), { deliverAs: "followUp" });
+				}
+			}
+		} finally {
+			reviewOpen = false;
+		}
+	}
+
+	pi.registerFlag("plan", { description: "Start a new session in plan mode", type: "boolean", default: false });
+	pi.registerTool({
+		name: "plan_submit",
+		label: "Submit plan",
+		description:
+			"Submit or replace the entire plan for user review. Only available during planning; submission does not approve execution.",
+		parameters: Type.Object({ steps: Type.Array(Type.String(), { minItems: 1 }) }),
+		async execute(_id, { steps }, _signal, _onUpdate, ctx) {
+			if (state.mode !== "planning") throw new Error("Plans can only be submitted during planning.");
+			if (
+				!Array.isArray(steps) ||
+				steps.length === 0 ||
+				steps.some((step) => typeof step !== "string" || !step.trim())
+			) {
+				throw new Error("A plan must contain at least one step, and every step must be nonblank.");
+			}
+			if (state.revision === Number.MAX_SAFE_INTEGER) throw new Error("Plan revision limit reached.");
+			state = { ...state, revision: state.revision + 1, steps: [...steps], approvedRevision: null };
+			todos = steps.map((text, i) => ({ step: i + 1, text, completed: false }));
+			persist();
+			updateStatus(ctx);
+			const submitted = snapshot();
+			return { content: [{ type: "text", text: JSON.stringify(submitted) }], details: submitted };
+		},
+	});
+
+	// Do not register plan-control as a command: commands run before input-source checks.
+	pi.on("input", (event, ctx) => {
+		const text = event.text.trim();
+		if (!text.startsWith("/plan-control")) return { action: "continue" };
+		const parts = text.split(/\s+/);
+		const operation: Operation =
+			parts[1] === "enter" || parts[1] === "status" || parts[1] === "approve" ? parts[1] : "unknown";
+		const revision = Number(parts[4]);
+		const valid =
+			parts[0] === "/plan-control" &&
+			(((operation === "enter" || operation === "status") && parts.length === 2) ||
+				(operation === "approve" &&
+					parts.length === 5 &&
+					/^\d+$/.test(parts[4]) &&
+					Number.isSafeInteger(revision)));
+		let error: ControlError | null;
+		if (!valid) error = "invalid_input";
+		else if (operation !== "status" && event.source !== "interactive" && event.source !== "rpc")
+			error = "forbidden_source";
+		else if (operation === "enter") error = enter(ctx);
+		else if (operation === "approve") error = approve(ctx, parts[2], parts[3], revision);
+		else error = null;
+		result(operation, error);
+		return { action: "handled" };
+	});
+
+	async function enterOrReview(ctx: ExtensionContext): Promise<void> {
+		const error = enter(ctx);
+		if (error) ctx.ui.notify(`Cannot enter plan mode: ${error}`, "warning");
+		else await review(ctx);
+	}
+
+	pi.registerCommand("plan", {
+		description: "Enter plan mode or review the current plan",
+		handler: async (_args, ctx) => enterOrReview(ctx),
+	});
+	pi.registerShortcut(Key.ctrlAlt("p"), {
+		description: "Enter plan mode or review the current plan",
+		handler: enterOrReview,
+	});
+	pi.registerCommand("todos", {
+		description: "Show current plan progress",
+		handler: async (_args, ctx) => {
+			ctx.ui.notify(
+				todos.length
+					? `Plan Progress:\n${todos.map((item) => `${item.step}. ${item.completed ? "[x]" : "[ ]"} ${item.text}`).join("\n")}`
+					: "No plan submitted. Use /plan, then plan_submit.",
+				"info",
+			);
+		},
+	});
+
+	pi.on("tool_call", (event) => {
+		if (
+			state.mode === "planning" &&
+			event.toolName !== "plan_submit" &&
+			!((READ_TOOLS.has(event.toolName) || !["bash", "powershell", "edit", "write"].includes(event.toolName)) && toolsBeforePlanning.includes(event.toolName))
+		) {
+			return { block: true, reason: "Plan mode: this tool is disabled until the submitted revision is approved." };
+		}
+		if (state.mode !== "planning" && event.toolName === "plan_submit") {
+			return { block: true, reason: "Enter plan mode before submitting a plan." };
+		}
+	});
+
+	pi.on("before_agent_start", () => {
+		if (state.mode !== "planning") return;
+		return {
+			message: {
+				customType: "plan-mode-context",
+				content: `[PLAN MODE ACTIVE]\nInspect using the available read tools. Submit the complete plan with plan_submit({steps: [...]}); ordinary Plan: prose does not submit it. Only the user can approve its exact version. Do not make changes.\nPlan: ${state.planId}; revision: ${state.revision}.`,
+				display: false,
+			},
+		};
+	});
+	pi.on("context", (event) => {
+		if (state.mode === "planning") return;
+		return {
+			messages: event.messages.filter(
+				(message) => !(message.role === "custom" && message.customType === "plan-mode-context"),
+			),
+		};
+	});
+	pi.on("turn_end", (event, ctx) => {
+		if (state.mode !== "approved" || event.message.role !== "assistant") return;
+		const text = event.message.content
+			.filter((part) => part.type === "text")
+			.map((part) => part.text)
+			.join("\n");
+		if (markCompletedSteps(text, todos) > 0) {
+			persist();
+			updateStatus(ctx);
+		}
+	});
+	pi.on("agent_settled", async (_event, ctx) => review(ctx));
+
+	pi.on("session_start", (_event, ctx) => {
+		const sessionId = ctx.sessionManager.getSessionId();
+		state = { sessionId, mode: "normal", planId: null, revision: 0, steps: [], approvedRevision: null };
+		toolsBeforePlanning = [];
+		todos = [];
+		reviewOpen = false;
+		let restored: SavedPlan | undefined;
+		for (const entry of ctx.sessionManager.getEntries()) {
+			if (
+				entry.type === "custom" &&
+				entry.customType === STATE_TYPE &&
+				isSavedPlan(entry.data) &&
+				entry.data.state.sessionId === sessionId
+			) {
+				restored = entry.data;
+			}
+		}
+		if (restored) {
+			state = { ...restored.state, steps: [...restored.state.steps] };
+			toolsBeforePlanning = [...restored.toolsBeforePlanning];
+			const completed = restored.completed;
+			todos = state.steps.map((text, i) => ({ step: i + 1, text, completed: completed.includes(i + 1) }));
+			if (state.mode === "planning") {
+				pi.setActiveTools([...toolsBeforePlanning.filter((name) => READ_TOOLS.has(name) || !["bash", "powershell", "edit", "write"].includes(name)), "plan_submit"]);
+			} else if (state.mode === "approved") {
+				pi.setActiveTools([...toolsBeforePlanning]);
+			}
+		} else {
+			pi.setActiveTools(pi.getActiveTools().filter((name) => name !== "plan_submit"));
+			const hasAssistant = ctx.sessionManager
+				.getEntries()
+				.some((entry) => entry.type === "message" && entry.message.role === "assistant");
+			if (pi.getFlag("plan") === true && !hasAssistant) enter(ctx);
+			else persist();
+		}
+		updateStatus(ctx);
+	});
+}
