new file mode 100644
index 000000000..fdbbc37d5
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/plan-mode/journal.ts
@@ -0,0 +1,129 @@
+/** Append-only plan history. Replaying events never performs effects or starts an agent turn. */
+export interface PlanState {
+	sessionId: string;
+	mode: "normal" | "planning" | "approved";
+	planId: string | null;
+	revision: number;
+	steps: string[];
+	approvedRevision: number | null;
+}
+
+export interface Approval {
+	sessionId: string;
+	planId: string;
+	revision: number;
+	steps: string[];
+}
+
+type EventBody =
+	| { kind: "opened" }
+	| { kind: "entered"; planId: string; tools: string[] }
+	| { kind: "submitted"; planId: string; revision: number; steps: string[] }
+	| { kind: "approved"; snapshot: Approval }
+	| { kind: "completed"; planId: string; revision: number; steps: number[] };
+
+export type PlanEvent = EventBody & { sessionId: string };
+
+export interface JournalView {
+	state: PlanState;
+	tools: string[] | null;
+	completed: number[];
+	initialized: boolean;
+}
+
+export function emptyJournal(sessionId: string): JournalView {
+	return {
+		state: { sessionId, mode: "normal", planId: null, revision: 0, steps: [], approvedRevision: null },
+		tools: null,
+		completed: [],
+		initialized: false,
+	};
+}
+
+function stringArray(value: unknown): value is string[] {
+	return Array.isArray(value) && value.every((item) => typeof item === "string");
+}
+
+export function validSteps(value: unknown): value is string[] {
+	return stringArray(value) && value.length > 0 && value.every((step) => step.trim().length > 0);
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Reject unrelated or malformed entries before letting them participate in replay. */
+export function isPlanEvent(value: unknown): value is PlanEvent {
+	if (!record(value) || typeof value.sessionId !== "string") return false;
+	switch (value.kind) {
+		case "opened":
+			return true;
+		case "entered":
+			return typeof value.planId === "string" && value.planId.length > 0 && stringArray(value.tools);
+		case "submitted":
+			return typeof value.planId === "string" && Number.isSafeInteger(value.revision) && validSteps(value.steps);
+		case "approved": {
+			const snapshot = value.snapshot;
+			return (
+				record(snapshot) &&
+				snapshot.sessionId === value.sessionId &&
+				typeof snapshot.planId === "string" &&
+				Number.isSafeInteger(snapshot.revision) &&
+				validSteps(snapshot.steps)
+			);
+		}
+		case "completed":
+			return (
+				typeof value.planId === "string" &&
+				Number.isSafeInteger(value.revision) &&
+				Array.isArray(value.steps) &&
+				value.steps.every((step: unknown) => typeof step === "number" && Number.isSafeInteger(step) && step > 0)
+			);
+		default:
+			return false;
+	}
+}
+
+/** Each event expresses a transition, rather than storing an entire mutable state object. */
+export function reduceJournal(view: JournalView, event: PlanEvent): JournalView {
+	const current = view.state;
+	if (event.sessionId !== current.sessionId) return view;
+	switch (event.kind) {
+		case "opened":
+			return view.initialized ? view : { ...view, initialized: true };
+		case "entered":
+			return {
+				state: { ...emptyJournal(current.sessionId).state, mode: "planning", planId: event.planId },
+				tools: [...event.tools],
+				completed: [],
+				initialized: true,
+			};
+		case "submitted":
+			if (current.mode !== "planning" || current.planId !== event.planId || event.revision !== current.revision + 1)
+				return view;
+			return { ...view, state: { ...current, revision: event.revision, steps: [...event.steps] } };
+		case "approved": {
+			const approved = event.snapshot;
+			if (
+				current.mode !== "planning" ||
+				approved.planId !== current.planId ||
+				approved.revision !== current.revision ||
+				current.revision === 0 ||
+				approved.steps.length !== current.steps.length ||
+				approved.steps.some((step, i) => step !== current.steps[i])
+			)
+				return view;
+			return {
+				...view,
+				state: { ...current, mode: "approved", approvedRevision: approved.revision, steps: [...approved.steps] },
+			};
+		}
+		case "completed":
+			if (current.mode !== "approved" || current.planId !== event.planId || current.revision !== event.revision)
+				return view;
+			return {
+				...view,
+				completed: [...new Set([...view.completed, ...event.steps.filter((step) => step <= current.steps.length)])],
+			};
+	}
+}
