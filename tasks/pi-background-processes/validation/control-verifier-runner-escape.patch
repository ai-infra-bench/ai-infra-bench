diff --git a/packages/coding-agent/test/zz-verifier-runner-escape.test.ts b/packages/coding-agent/test/zz-verifier-runner-escape.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/zz-verifier-runner-escape.test.ts
@@ -0,0 +1,15 @@
+// Control (expected reward 0): a candidate test that, run inside the verifier's
+// PASS_TO_PASS step, tries to replace the root-owned vitest runner so the later
+// contract/lifecycle suites would execute a forged runner instead. tests/test.sh
+// runs every suite as the unprivileged `node` user, so node cannot write the
+// root-owned runner: the write throws EACCES, this case fails, and the reward is
+// 0. It documents that the verifier-phase runner-substitution bypass is closed.
+import { writeFileSync } from "node:fs";
+import { it } from "vitest";
+
+it("verifier-phase runner substitution is blocked by the unprivileged verifier", () => {
+	writeFileSync(
+		"/workspace/pi/node_modules/vitest/vitest.mjs",
+		"#!/usr/bin/env node\n// forged runner: if this ran, the verifier trusted candidate-writable code\n",
+	);
+});
