+		patch: { ready?: string | null; error?: string | null; exit?: boolean; output?: boolean },
+	): ProcessRecord {
+		const entry = this.require(id);
+		if (entry.state !== "running") {
+			throw new Error(`Background process ${id} is not running`);
+		}
+		if (patch.ready === null) {
+			entry.wake.ready = undefined;
+			entry.readyPattern = undefined;
+		} else if (typeof patch.ready === "string") {
+			entry.wake.ready = patch.ready;
+			entry.readyPattern = compilePattern(patch.ready, "ready");
+		}
+		if (patch.error === null) {
+			entry.wake.error = undefined;
+			entry.errorPattern = undefined;
+		} else if (typeof patch.error === "string") {
+			entry.wake.error = patch.error;
+			entry.errorPattern = compilePattern(patch.error, "error");
+		}
+		if (patch.exit === false) entry.wake.exit = false;
+		else if (patch.exit === true) entry.wake.exit = true;
+		if (patch.output === false) entry.wake.output = false;
+		else if (patch.output === true && entry.backgrounded) entry.wake.output = true;
+		this.persist(entry);
+		return toPublicRecord(entry);
+	}
+
+	async kill(id: string, timeoutSec = DEFAULT_KILL_TIMEOUT_SEC): Promise<KillResult> {
+		const entry = this.require(id);
+		if (entry.state === "running") {
+			await this.stopEntry(entry, Math.max(0, timeoutSec), "killed");
+		}
+		let cleanup: CleanupResult | null = null;
+		if (entry.cleanup) {
+			cleanup = entry.cleanupResult ?? (await this.runCleanup(entry));
+		}
+		return { ...toPublicRecord(entry), cleanup };
+	}
+
+	loadFromSessionDir(sessionDir: string): void {
+		const dir = storageDir(sessionDir);
+		if (!existsSync(dir)) return;
+		let names: string[] = [];
+		try {
+			names = readdirSync(dir);
+		} catch {
+			return;
+		}
+		for (const name of names) {
+			if (!name.endsWith(".json")) continue;
+			const recordPath = join(dir, name);
+			try {
+				const parsed = JSON.parse(readFileSync(recordPath, "utf8")) as Partial<InternalProcess> & {
+					logPath?: string;
+					wake?: WakeRules;
+				};
+				if (!parsed.id || this.processes.has(parsed.id)) continue;
+				const logPath = parsed.logPath ?? join(dir, `${parsed.id}.log`);
+				const wasRunning = parsed.state === "running";
+				const state: ProcessState = parsed.state === "killed" || wasRunning ? "killed" : "exited";
+				const logLines = existsSync(logPath) ? countFileLines(logPath) : (parsed.logLines ?? 0);
+				const entry: InternalProcess = {
+					id: parsed.id,
+					name: typeof parsed.name === "string" ? parsed.name : (parsed.command ?? parsed.id),
+					command: typeof parsed.command === "string" ? parsed.command : "",
+					cwd: typeof parsed.cwd === "string" ? parsed.cwd : sessionDir,
+					pid: typeof parsed.pid === "number" ? parsed.pid : 0,
+					state,
+					exitCode: typeof parsed.exitCode === "number" ? parsed.exitCode : null,
+					startedAt: typeof parsed.startedAt === "string" ? parsed.startedAt : nowIso(),
+					endedAt: typeof parsed.endedAt === "string" ? parsed.endedAt : nowIso(),
+					logLines,
+					backgrounded: Boolean(parsed.backgrounded),
+					stalledSec: parsed.stalledSec,
+					sessionDir,
+					recordPath,
+					logPath,
+					wake: {
+						ready: parsed.wake?.ready,
+						error: parsed.wake?.error,
+						exit: parsed.wake?.exit ?? true,
+						output: parsed.wake?.output ?? false,
+					},
+					cleanup: parsed.cleanup,
+					cleanupResult: null,
+					readyFired: true,
+					outputFired: true,
+					exitWakeDelivered: true,
+					errorPendingInWindow: false,
+					killing: false,
+					originSessionId: parsed.originSessionId,
+					lastLineBytes: 0,
+					outputBytes: 0,
+				};
+				this.processes.set(entry.id, entry);
+				if (wasRunning) this.persist(entry);
+			} catch {
+				// skip corrupt records
+			}
+		}
+	}
+
+	async stopAll(timeoutSec = DEFAULT_KILL_TIMEOUT_SEC): Promise<void> {
+		const running = [...this.processes.values()].filter((entry) => entry.state === "running");
+		await Promise.all(running.map((entry) => this.stopEntry(entry, timeoutSec, "killed")));
+		await Promise.all(
+			running.filter((entry) => entry.cleanup && !entry.cleanupResult).map((entry) => this.runCleanup(entry)),
+		);
+	}
+
+	stopAllSync(timeoutMs = DEFAULT_KILL_TIMEOUT_SEC * 1000): void {
+		for (const entry of this.processes.values()) {
+			if (entry.state !== "running" || !entry.pid) continue;
+			entry.killing = true;
+			stopTreeSync(entry.pid, timeoutMs);
+			this.finalizeExit(entry, entry.exitCode, "killed", true);
+		}
+	}
+
+	async disposeForTests(): Promise<void> {
+		this.uninstallExitHandlers();
+		this.sendWake = undefined;
+		this.pendingReasons.clear();
+		this.deliveryOrder.length = 0;
+		await this.stopAll(1);
+		for (const entry of this.processes.values()) {
+			entry.log?.closeSync();
+		}
+		this.processes.clear();
+	}
+
+	private register(entry: InternalProcess): void {
+		this.processes.set(entry.id, entry);
+		this.persist(entry);
+	}
+
+	private spawnEntry(options: StartProcessOptions): InternalProcess {
+		if (!existsSync(options.cwd)) {
+			throw new Error(`Working directory does not exist: ${options.cwd}`);
+		}
+		const id = randomUUID();
+		const dir = storageDir(options.sessionDir);
+		ensureDir(dir);
+		const logPath = join(dir, `${id}.log`);
+		const recordPath = join(dir, `${id}.json`);
+		const wake: WakeRules = {
+			ready: options.wake?.ready,
+			error: options.wake?.error,
+			exit: true,
+			output: options.outputWake ?? false,
+		};
+		const entry: InternalProcess = {
+			id,
+			name: options.name?.trim() || options.command,
+			command: options.command,
+			cwd: options.cwd,
+			pid: 0,
+			state: "running",
+			exitCode: null,
+			startedAt: nowIso(),
+			endedAt: null,
+			logLines: 0,
+			backgrounded: Boolean(options.backgrounded),
+			stalledSec: options.stalledSec,
+			sessionDir: options.sessionDir,
+			recordPath,
+			logPath,
+			wake,
+			readyPattern: wake.ready ? compilePattern(wake.ready, "ready") : undefined,
+			errorPattern: wake.error ? compilePattern(wake.error, "error") : undefined,
+			cleanup: options.cleanup,
+			cleanupResult: null,
+			readyFired: false,
+			outputFired: false,
+			exitWakeDelivered: false,
+			errorPendingInWindow: false,
+			killing: false,
+			lastLineBytes: 0,
+			outputBytes: 0,
+		};
+
+		const log = new LineLog(logPath, (line) => this.onOutputLine(entry, line));
+		entry.log = log;
+		const child = spawnShell(options.command, options.cwd, options.env);
+		entry.child = child;
+		if (typeof child.pid === "number") {
+			entry.pid = child.pid;
+		}
+		log.attachPipes(child.stdout, child.stderr);
+		child.once("error", () => {
+			if (entry.state !== "running" || !this.processes.has(entry.id)) return;
+			this.finalizeExit(entry, null, entry.killing ? "killed" : "exited");
+		});
+		child.once("exit", (code) => {
+			if (entry.state !== "running" || !this.processes.has(entry.id)) return;
+			this.finalizeExit(entry, code, entry.killing ? "killed" : "exited");
+		});
+		if (!entry.pid) {
+			throw new Error(`Failed to start command: ${options.command}`);
+		}
+		return entry;
+	}
+
+	private onOutputLine(entry: InternalProcess, line: string): void {
+		entry.logLines = entry.log?.lineCount ?? entry.logLines + 1;
+		entry.lastLineBytes = entry.log?.lastLineBytes ?? entry.lastLineBytes;
+		if (entry.exitWakeDelivered || entry.state !== "running" || !this.processes.has(entry.id)) return;
+
+		if (entry.wake.ready && !entry.readyFired && matches(entry.readyPattern, line)) {
+			entry.readyFired = true;
+			this.enqueueWake(entry, "ready", line);
+		}
+		if (entry.wake.error && !entry.errorPendingInWindow && matches(entry.errorPattern, line)) {
+			entry.errorPendingInWindow = true;
+			this.enqueueWake(entry, "error", line);
+		}
+		if (entry.wake.output && entry.backgrounded && !entry.outputFired) {
+			entry.outputFired = true;
+			this.enqueueWake(entry, "output", line);
+		}
+	}
+
+	private enqueueWake(entry: InternalProcess, reason: WakeReason, matchedLine: string | null): void {
+		if (entry.exitWakeDelivered && reason !== "exit") return;
+		if (reason === "exit" && !entry.wake.exit) return;
+		if (reason === "output" && !entry.wake.output) return;
+		if (reason === "ready" && !entry.wake.ready) return;
+		if (reason === "error" && !entry.wake.error) return;
+		if (!this.processes.has(entry.id)) return;
+
+		let pending = this.pendingReasons.get(entry.id);
+		if (!pending) {
+			pending = { reasons: new Set(), matchedLine: null };
+			this.pendingReasons.set(entry.id, pending);
+			this.deliveryOrder.push(entry.id);
+		}
+		pending.reasons.add(reason);
+		if (pending.matchedLine === null && matchedLine !== null) pending.matchedLine = matchedLine;
+		this.scheduleFlush();
+	}
+
+	private scheduleFlush(): void {
+		if (this.flushScheduled) return;
+		this.flushScheduled = true;
+		queueMicrotask(() => {
+			this.flushScheduled = false;
+			this.flushWakes();
+		});
+	}
+
+	private flushWakes(): void {
+		if (!this.sendWake) return;
+		const ids = this.deliveryOrder.splice(0);
+		for (const id of ids) {
+			const pending = this.pendingReasons.get(id);
+			this.pendingReasons.delete(id);
+			const entry = this.processes.get(id);
+			if (!pending || !entry || pending.reasons.size === 0) continue;
+			if (entry.exitWakeDelivered && !pending.reasons.has("exit")) continue;
+			const reasons = [...pending.reasons] as WakeReason[];
+			const details: BackgroundProcessWakeDetails = {
+				id: entry.id,
+				name: entry.name,
+				reasons,
+				exitCode: entry.exitCode,
+				matchedLine: pending.matchedLine,
+			};
+			if (reasons.includes("error")) entry.errorPendingInWindow = false;
+			if (reasons.includes("exit")) entry.exitWakeDelivered = true;
+			this.sendWake(
+				{
+					customType: BACKGROUND_PROCESS_CUSTOM_TYPE,
+					content: formatWakeContent(details),
+					display: true,
+					details,
+				},
+				{ triggerTurn: true },
+			);
+		}
+	}
+
+	private persist(entry: InternalProcess): void {
+		try {
+			writeJsonAtomicSync(entry.recordPath, persistable(entry));
+		} catch {
+			// session dir may be gone during shutdown
+		}
+	}
+
+	private finalizeExit(entry: InternalProcess, exitCode: number | null, state: ProcessState, sync = false): void {
+		if (entry.state !== "running") return;
+		entry.state = state;
+		entry.exitCode = exitCode;
+		entry.endedAt = nowIso();
+		if (sync) {
+			entry.log?.closeSync();
+		} else {
+			entry.log?.flushPartial();
+			void entry.log?.close();
+		}
+		entry.logLines =
+			entry.log?.lineCount ?? (existsSync(entry.logPath) ? countFileLines(entry.logPath) : entry.logLines);
+		entry.child = undefined;
+		this.persist(entry);
+		if (this.processes.has(entry.id) && !entry.exitWakeDelivered && entry.wake.exit) {
+			this.enqueueWake(entry, "exit", null);
+		}
+	}
+
+	private async stopEntry(entry: InternalProcess, timeoutSec: number, state: ProcessState): Promise<void> {
+		if (entry.state !== "running") return;
+		entry.killing = true;
+		const pid = entry.pid;
+		const child = entry.child;
+		if (pid) killProcessTree(pid, "SIGTERM");
+		const timeoutMs = timeoutSec * 1000;
+		const exited = await Promise.race([
+			new Promise<boolean>((resolve) => {
+				if (!child) {
+					resolve(!isPidAlive(pid));
+					return;
+				}
+				if (entry.state !== "running") {
+					resolve(true);
+					return;
+				}
+				child.once("exit", () => resolve(true));
+			}),
+			waitUntil(() => entry.state !== "running" || !isPidAlive(pid), timeoutMs),
+		]);
+		if (entry.state === "running") {
+			if (!exited && pid) killProcessTree(pid, "SIGKILL");
+			await waitUntil(() => entry.state !== "running" || !isPidAlive(pid), 1000);
+			if (entry.state === "running") {
+				this.finalizeExit(entry, entry.exitCode, state);
+			}
+		}
+	}
+
+	private async runCleanup(entry: InternalProcess): Promise<CleanupResult> {
+		if (!entry.cleanup) return { ran: false, exitCode: null, failed: false };
+		if (entry.cleanupResult) return entry.cleanupResult;
+		const timeoutSec = entry.cleanup.timeoutSec ?? DEFAULT_CLEANUP_TIMEOUT_SEC;
+		const child = spawnShell(entry.cleanup.command, entry.cwd);
+		const pid = child.pid;
+		const append = (data: Buffer) => {
+			try {
+				writeFileSync(entry.logPath, data, { flag: "a" });
+			} catch {
+				// ignore
+			}
+			entry.logLines = countFileLines(entry.logPath);
+		};
+		child.stdout?.on("data", append);
+		child.stderr?.on("data", append);
+
+		let timedOut = false;
+		let timeoutTimer: NodeJS.Timeout | undefined;
+		const exitCode = await new Promise<number | null>((resolve) => {
+			timeoutTimer = setTimeout(() => {
+				timedOut = true;
+				if (pid) killProcessTree(pid, "SIGKILL");
+			}, timeoutSec * 1000);
+			child.once("error", () => resolve(null));
+			child.once("exit", (code) => resolve(code));
+		});
+		if (timeoutTimer) clearTimeout(timeoutTimer);
+		const result: CleanupResult = {
+			ran: true,
+			exitCode,
+			failed: timedOut || exitCode === null || exitCode !== 0,
+		};
+		entry.cleanupResult = result;
+		entry.logLines = existsSync(entry.logPath) ? countFileLines(entry.logPath) : entry.logLines;
+		this.persist(entry);
+		return result;
+	}
+
+	private installExitHandlers(): void {
+		if (this.signalHandlers.length > 0) return;
+		for (const signal of EXIT_SIGNALS) {
+			const handler = () => {
+				this.stopAllSync();
+				process.removeListener(signal, handler);
+				this.signalHandlers = this.signalHandlers.filter((item) => item.handler !== handler);
+				process.kill(process.pid, signal);
+			};
+			process.prependListener(signal, handler);
+			this.signalHandlers.push({ signal, handler });
+		}
+		this.exitHandler = () => {
+			this.stopAllSync(0);
+		};
+		process.prependListener("exit", this.exitHandler);
+	}
+
+	private uninstallExitHandlers(): void {
+		for (const { signal, handler } of this.signalHandlers) {
+			process.removeListener(signal, handler);
+		}
+		this.signalHandlers = [];
+		if (this.exitHandler) {
+			process.removeListener("exit", this.exitHandler);
+			this.exitHandler = undefined;
+		}
+	}
+}
+
+let singleton: BackgroundProcessManager | undefined;
+
+export function getBackgroundProcessManager(): BackgroundProcessManager {
+	singleton ??= new BackgroundProcessManager();
+	return singleton;
+}
+
+export async function resetBackgroundProcessManagerForTests(): Promise<void> {
+	if (!singleton) return;
+	await singleton.disposeForTests();
+	singleton = undefined;
+}
