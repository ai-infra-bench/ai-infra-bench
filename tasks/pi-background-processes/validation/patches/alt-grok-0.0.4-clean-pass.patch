+async function waitFor<T>(
+	fn: () => Promise<T | false | undefined> | T | false | undefined,
+	timeoutMs = 5000,
+): Promise<T> {
+	const start = Date.now();
+	let last: T | false | undefined;
+	while (Date.now() - start < timeoutMs) {
+		last = await fn();
+		if (last) return last as T;
+		await sleep(25);
+	}
+	throw new Error(`Timed out after ${timeoutMs}ms waiting for condition (last=${JSON.stringify(last)})`);
+}
