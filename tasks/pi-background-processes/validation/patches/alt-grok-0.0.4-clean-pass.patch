+/**
+ * Background Processes Extension
+ *
+ * Long-lived process management for pi: start, page logs, stop process trees,
+ * and wake the agent from process output or exit. Also overrides `bash` so a
+ * command that goes quiet is moved into the same manager instead of blocking
+ * the session.
+ *
+ * Usage:
+ *   pi -e ./background-processes
+ *   pi -e ./background-processes/index.ts
+ */
+
+import { open, readFile, stat, unlink } from "node:fs/promises";
+import { isAbsolute, resolve } from "node:path";
+import {
+	DEFAULT_MAX_BYTES,
+	DEFAULT_MAX_LINES,
+	defineTool,
+	type ExtensionAPI,
+	type ExtensionContext,
+	formatSize,
+	truncateTail,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import {
+	DEFAULT_KILL_TIMEOUT_SEC,
+	DEFAULT_STALLED_SEC,
+	getBackgroundProcessManager,
+	type ProcessRecord,
+} from "./manager.ts";
+
+const MAX_TIMEOUT_MS = 2_147_483_647;
+const MAX_TIMEOUT_SECONDS = MAX_TIMEOUT_MS / 1000;
+
+function jsonResult<T>(value: T): { content: [{ type: "text"; text: string }]; details: T } {
+	return {
+		content: [{ type: "text", text: JSON.stringify(value) }],
+		details: value,
+	};
+}
+
+function resolveCwd(sessionCwd: string, cwd?: string): string {
+	if (!cwd) return resolve(sessionCwd);
+	return isAbsolute(cwd) ? cwd : resolve(sessionCwd, cwd);
+}
+
+function sessionDirOf(ctx: ExtensionContext): string {
+	return ctx.sessionManager.getSessionDir();
+}
+
+function sessionEnv(ctx: ExtensionContext): NodeJS.ProcessEnv {
+	const env: NodeJS.ProcessEnv = { ...process.env };
+	env.PI_SESSION_ID = ctx.sessionManager.getSessionId();
+	const sessionFile = ctx.sessionManager.getSessionFile();
+	if (sessionFile) env.PI_SESSION_FILE = sessionFile;
+	if (ctx.model) {
+		env.PI_PROVIDER = ctx.model.provider;
+		env.PI_MODEL = ctx.model.id;
+	}
+	if (ctx.thinkingLevel) env.PI_REASONING_LEVEL = ctx.thinkingLevel;
+	return env;
+}
+
+function resolveTimeoutSec(timeout: number | undefined): number | undefined {
+	if (timeout === undefined) return undefined;
+	if (!Number.isFinite(timeout) || timeout <= 0) {
+		throw new Error("Invalid timeout: must be a finite number of seconds");
+	}
+	const timeoutMs = timeout * 1000;
+	if (timeoutMs > MAX_TIMEOUT_MS) {
+		throw new Error(`Invalid timeout: maximum is ${MAX_TIMEOUT_SECONDS} seconds`);
+	}
+	return timeout;
+}
+
+function resolveStalledSec(stalledSec: number | undefined): number {
+	if (stalledSec === undefined) return DEFAULT_STALLED_SEC;
+	if (!Number.isFinite(stalledSec) || stalledSec < 0) {
+		throw new Error("Invalid stalledSec: must be a finite number of seconds");
+	}
+	return stalledSec;
+}
+
+function appendStatus(text: string, status: string): string {
+	return `${text ? `${text}\n\n` : ""}${status}`;
+}
+
+function formatBashOutput(
+	logPath: string,
+	content: string,
+	totalLines: number,
+	totalBytes: number,
+	lastLineBytes: number,
+	emptyText = "(no output)",
+): { text: string; details: { truncation?: ReturnType<typeof truncateTail>; fullOutputPath?: string } | undefined } {
+	const tail = truncateTail(content, { maxLines: DEFAULT_MAX_LINES, maxBytes: DEFAULT_MAX_BYTES });
+	const truncated = totalLines > DEFAULT_MAX_LINES || totalBytes > DEFAULT_MAX_BYTES;
+	const truncation = {
+		...tail,
+		truncated,
+		truncatedBy: truncated
+			? (tail.truncatedBy ?? (totalBytes > DEFAULT_MAX_BYTES ? ("bytes" as const) : ("lines" as const)))
+			: null,
+		totalLines,
+		totalBytes,
+		maxLines: DEFAULT_MAX_LINES,
+		maxBytes: DEFAULT_MAX_BYTES,
+	};
+	let text = truncation.content || emptyText;
+	let details: { truncation?: typeof truncation; fullOutputPath?: string } | undefined;
+	if (truncation.truncated) {
+		details = { truncation, fullOutputPath: logPath };
+		const startLine = truncation.totalLines - truncation.outputLines + 1;
+		const endLine = truncation.totalLines;
+		if (truncation.lastLinePartial) {
+			text += `\n\n[Showing last ${formatSize(truncation.outputBytes)} of line ${endLine} (line is ${formatSize(lastLineBytes)}). Full output: ${logPath}]`;
+		} else if (truncation.truncatedBy === "lines") {
+			text += `\n\n[Showing lines ${startLine}-${endLine} of ${truncation.totalLines}. Full output: ${logPath}]`;
+		} else {
+			text += `\n\n[Showing lines ${startLine}-${endLine} of ${truncation.totalLines} (${formatSize(DEFAULT_MAX_BYTES)} limit). Full output: ${logPath}]`;
+		}
+	}
+	return { text, details };
+}
+
+async function readBashSnapshot(logPath: string): Promise<string> {
+	try {
+		const info = await stat(logPath);
+		if (info.size <= DEFAULT_MAX_BYTES * 4) {
+			return await readFile(logPath, "utf8");
+		}
+		const fh = await open(logPath, "r");
+		try {
+			const readSize = Math.min(info.size, DEFAULT_MAX_BYTES * 4);
+			const buf = Buffer.alloc(readSize);
+			await fh.read(buf, 0, readSize, info.size - readSize);
+			let text = buf.toString("utf8");
+			if (info.size > readSize) {
+				const nl = text.indexOf("\n");
+				if (nl !== -1) text = text.slice(nl + 1);
+			}
+			return text;
+		} finally {
+			await fh.close();
+		}
+	} catch {
+		return "";
+	}
+}
+
+const BgRunParams = Type.Object({
+	command: Type.String({ description: "Shell command to start in the background" }),
+	cwd: Type.Optional(
+		Type.String({ description: "Working directory; relative paths resolve against the session cwd" }),
+	),
+	name: Type.Optional(Type.String({ description: "Display name for the process" })),
+	wake: Type.Optional(
+		Type.Object({
+			ready: Type.Optional(Type.String({ description: "RegExp matched against each output line to wake on ready" })),
+			error: Type.Optional(Type.String({ description: "RegExp matched against each output line to wake on error" })),
+		}),
+	),
+	cleanup: Type.Optional(
+		Type.Object({
+			command: Type.String({ description: "Command to run after the process tree is gone" }),
+			timeoutSec: Type.Optional(Type.Number({ description: "Cleanup timeout in seconds (default 30)" })),
+		}),
+	),
+});
+
+const BgLogsParams = Type.Object({
+	id: Type.String({ description: "Background process id" }),
+	offset: Type.Optional(Type.Number({ description: "Line offset to start from (0-based)" })),
+	limit: Type.Optional(Type.Number({ description: "Maximum number of lines to return" })),
+});
+
+const BgListParams = Type.Object({});
+
+const BgKillParams = Type.Object({
+	id: Type.String({ description: "Background process id" }),
+	timeoutSec: Type.Optional(Type.Number({ description: "Seconds to wait after SIGTERM before SIGKILL (default 5)" })),
+});
+
+const BgWatchParams = Type.Object({
+	id: Type.String({ description: "Background process id" }),
+	ready: Type.Optional(Type.Union([Type.String(), Type.Null()], { description: "Ready regexp, or null to remove" })),
+	error: Type.Optional(Type.Union([Type.String(), Type.Null()], { description: "Error regexp, or null to remove" })),
+	exit: Type.Optional(Type.Boolean({ description: "false silences the exit wake" })),
+	output: Type.Optional(Type.Boolean({ description: "false silences the auto-background output wake" })),
+});
+
+const BashParams = Type.Object({
+	command: Type.String({ description: "Shell command to execute" }),
+	timeout: Type.Optional(Type.Number({ description: "Timeout in seconds (optional, no default timeout)" })),
+	stalledSec: Type.Optional(
+		Type.Number({
+			description:
+				"Seconds of silence after which a still-running command is moved to a managed background process (default 30)",
+		}),
+	),
+});
+
+export default function backgroundProcessesExtension(pi: ExtensionAPI): void {
+	const manager = getBackgroundProcessManager();
+
+	const bindWake = (): void => {
+		manager.setSendWake((message, options) => {
+			pi.sendMessage(message, options);
+		});
+	};
+	bindWake();
+
+	pi.on("session_start", (_event, ctx) => {
+		bindWake();
+		manager.loadFromSessionDir(sessionDirOf(ctx));
+	});
+
+	pi.on("session_shutdown", async (event) => {
+		if (event.reason === "quit") {
+			await manager.stopAll();
+		}
+	});
+
+	pi.registerTool(
+		defineTool({
+			name: "bg_run",
+			label: "bg_run",
+			description:
+				"Start a shell command as a managed background process and return immediately. Use for dev servers, watchers, and other long-lived commands. The process and everything it spawns can be stopped later with bg_kill.",
+			promptSnippet: "Start a long-lived shell command as a managed background process",
+			promptGuidelines: [
+				"Use bg_run for long-lived processes (dev servers, watchers, local APIs) instead of bash with nohup or trailing &.",
+				"Use bg_logs to page combined stdout/stderr and bg_kill to stop the process tree.",
+				"Pass wake.ready / wake.error as regular expressions to be notified when matching output appears; process exit wakes the agent by default.",
+			],
+			parameters: BgRunParams,
+			async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+				const cwd = resolveCwd(ctx.cwd, params.cwd);
+				const record = manager.start({
+					command: params.command,
+					cwd,
+					sessionDir: sessionDirOf(ctx),
+					name: params.name,
+					wake: params.wake,
+					cleanup: params.cleanup,
+					env: sessionEnv(ctx),
+				});
+				return jsonResult(record);
+			},
+		}),
+	);
+
+	pi.registerTool(
+		defineTool({
+			name: "bg_logs",
+			label: "bg_logs",
+			description:
+				"Return a page of combined stdout/stderr lines for a managed background process. Pages are capped at 64KB. Omit limit to receive the newest lines that fit.",
+			promptSnippet: "Page combined stdout/stderr of a managed background process",
+			parameters: BgLogsParams,
+			async execute(_toolCallId, params) {
+				const page = await manager.logs(params.id, params.offset, params.limit);
+				return jsonResult(page);
+			},
+		}),
+	);
+
+	pi.registerTool(
+		defineTool({
+			name: "bg_list",
+			label: "bg_list",
+			description: "List every managed background process visible in this pi process, running and finished.",
+			promptSnippet: "List managed background processes for this pi process",
+			parameters: BgListParams,
+			async execute() {
+				return jsonResult({ processes: manager.list() });
+			},
+		}),
+	);
+
+	pi.registerTool(
+		defineTool({
+			name: "bg_kill",
+			label: "bg_kill",
+			description:
+				"Stop a managed background process and all of its descendants (SIGTERM, then SIGKILL). Runs the process cleanup command afterwards if one was configured.",
+			promptSnippet: "Stop a managed background process and its descendants",
+			parameters: BgKillParams,
+			async execute(_toolCallId, params) {
+				const timeoutSec = params.timeoutSec ?? DEFAULT_KILL_TIMEOUT_SEC;
+				const result = await manager.kill(params.id, timeoutSec);
+				return jsonResult(result);
+			},
+		}),
+	);
+
+	pi.registerTool(
+		defineTool({
+			name: "bg_watch",
+			label: "bg_watch",
+			description:
+				"Change wake rules of a running managed process. Pass ready/error as a regexp or null to remove. exit:false silences the exit wake; output:false silences the auto-background output wake.",
+			promptSnippet: "Change wake rules of a running managed background process",
+			parameters: BgWatchParams,
+			async execute(_toolCallId, params) {
+				const record = manager.watch(params.id, {
+					ready: params.ready,
+					error: params.error,
+					exit: params.exit,
+					output: params.output,
+				});
+				return jsonResult(record);
+			},
+		}),
+	);
+
+	pi.registerTool(
+		defineTool({
+			name: "bash",
+			label: "bash",
+			description: `Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last ${DEFAULT_MAX_LINES} lines or ${DEFAULT_MAX_BYTES / 1024}KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds. If the command stays silent for stalledSec seconds (default ${DEFAULT_STALLED_SEC}) while still running, it is moved to a managed background process.`,
+			promptSnippet: "Execute bash commands (ls, grep, find, etc.)",
+			promptGuidelines: [
+				"You can inspect PI_* environment variables for current model and session details.",
+				"If a bash command is a long-lived server or watcher, prefer bg_run. If bash auto-backgrounds a stalled command, use bg_logs / bg_kill / bg_watch with the returned id.",
+			],
+			parameters: BashParams,
+			async execute(_toolCallId, params, signal, onUpdate, ctx) {
+				const timeoutSec = resolveTimeoutSec(params.timeout);
+				const stalledSec = resolveStalledSec(params.stalledSec);
+				const cwd = ctx.cwd;
+				const outcome = await manager.runUntilStall(
+					{
+						command: params.command,
+						cwd,
+						sessionDir: sessionDirOf(ctx),
+						env: sessionEnv(ctx),
+					},
+					{
+						stalledSec,
+						timeoutSec,
+						signal,
+						onBytes: (data) => {
+							if (!onUpdate) return;
+							onUpdate({
+								content: [{ type: "text", text: data.toString("utf8") }],
+								details: undefined,
+							});
+						},
+					},
+				);
+
+				if (outcome.status === "backgrounded") {
+					const record: ProcessRecord = outcome.record;
+					return jsonResult({ ...record, backgrounded: true, stalledSec });
+				}
+
+				const snapshot = await readBashSnapshot(outcome.logPath);
+				if (outcome.aborted) {
+					const { text } = formatBashOutput(
+						outcome.logPath,
+						snapshot,
+						outcome.logLines,
+						outcome.outputBytes,
+						outcome.lastLineBytes,
+						"",
+					);
+					throw new Error(appendStatus(text, "Command aborted"));
+				}
+				if (outcome.timedOut) {
+					const { text } = formatBashOutput(
+						outcome.logPath,
+						snapshot,
+						outcome.logLines,
+						outcome.outputBytes,
+						outcome.lastLineBytes,
+						"",
+					);
+					throw new Error(appendStatus(text, `Command timed out after ${params.timeout} seconds`));
+				}
+
+				const { text, details } = formatBashOutput(
+					outcome.logPath,
+					snapshot,
+					outcome.logLines,
+					outcome.outputBytes,
+					outcome.lastLineBytes,
+				);
+				if (!details?.fullOutputPath) {
+					try {
+						await unlink(outcome.logPath);
+					} catch {
+						// ignore
+					}
+				}
+				if (outcome.exitCode !== 0 && outcome.exitCode !== null) {
+					throw new Error(appendStatus(text, `Command exited with code ${outcome.exitCode}`));
+				}
+				return { content: [{ type: "text", text }], details };
+			},
+		}),
+	);
+}
+
+export {
+	BACKGROUND_PROCESS_CUSTOM_TYPE,
+	DEFAULT_CLEANUP_TIMEOUT_SEC,
+	DEFAULT_KILL_TIMEOUT_SEC,
+	DEFAULT_STALLED_SEC,
+	LOG_PAGE_MAX_BYTES,
+	resetBackgroundProcessManagerForTests,
+} from "./manager.ts";
