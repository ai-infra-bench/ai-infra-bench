@@ -0,0 +1,475 @@
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import backgroundProcessesExtension, {
+	resetBackgroundProcessesForTests,
+} from "../examples/extensions/background-processes/index.ts";
+import { processAlive } from "../examples/extensions/background-processes/process-tree.ts";
+import { LOG_PAGE_MAX_BYTES } from "../examples/extensions/background-processes/types.ts";
+import type { AgentToolResult } from "../src/core/extensions/index.ts";
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from "../src/core/extensions/types.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { createBashTool } from "../src/index.ts";
+
+type AnyTool = ToolDefinition<any, any, any>;
+type EventHandler = (event: any, ctx: ExtensionContext) => unknown | Promise<unknown>;
+
+function nodeEval(code: string): string {
+	return `${JSON.stringify(process.execPath)} -e ${JSON.stringify(code)}`;
+}
+
+function textOf(result: AgentToolResult<unknown>): string {
+	return result.content
+		.filter((block): block is { type: "text"; text: string } => block.type === "text")
+		.map((block) => block.text)
+		.join("\n");
+}
+
+function parseJson<T>(result: AgentToolResult<unknown>): T {
+	const obj = JSON.parse(textOf(result)) as T;
+	expect(result.details).toEqual(obj);
+	return obj;
+}
+
+async function waitFor<T>(fn: () => T | Promise<T>, pred: (value: T) => boolean, timeoutMs = 5000): Promise<T> {
+	const start = Date.now();
+	let last: T | undefined;
+	while (Date.now() - start < timeoutMs) {
+		last = await fn();
+		if (pred(last)) return last;
+		await new Promise((resolve) => setTimeout(resolve, 25));
+	}
+	throw new Error(`timed out waiting; last value: ${JSON.stringify(last)}`);
+}
+
+function setup(workDir: string, sessionDir: string) {
+	const tools = new Map<string, AnyTool>();
+	const handlers = new Map<string, EventHandler[]>();
+	const sendMessage = vi.fn();
+	let idle = true;
+
+	const api = {
+		registerTool(tool: AnyTool) {
+			tools.set(tool.name, tool);
+		},
+		on(event: string, handler: EventHandler) {
+			const list = handlers.get(event) ?? [];
+			list.push(handler);
+			handlers.set(event, list);
+		},
+		sendMessage,
+	} as unknown as ExtensionAPI;
+
+	backgroundProcessesExtension(api);
+
+	const sessionManager = SessionManager.create(workDir, sessionDir, { id: "bg-test-session" });
+	const ctx = {
+		cwd: workDir,
+		sessionManager,
+		isIdle: () => idle,
+		hasUI: false,
+		mode: "print",
+	} as unknown as ExtensionContext;
+
+	async function emit(event: { type: string } & Record<string, unknown>): Promise<void> {
+		for (const handler of handlers.get(event.type) ?? []) {
+			await handler(event, ctx);
+		}
+	}
+
+	async function exec(name: string, params: unknown, signal?: AbortSignal): Promise<AgentToolResult<unknown>> {
+		const tool = tools.get(name);
+		if (!tool) throw new Error(`missing tool ${name}`);
+		return tool.execute("test-call", params as never, signal, undefined, ctx);
+	}
+
+	return {
+		tools,
+		sendMessage,
+		ctx,
+		sessionManager,
+		exec,
+		emit,
+		setIdle(value: boolean) {
+			idle = value;
+		},
+	};
+}
