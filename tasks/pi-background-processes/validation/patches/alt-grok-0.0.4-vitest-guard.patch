+/** Public process record returned by the background-process tools. */
+export type ProcessState = "running" | "exited" | "killed";
+
+export type WakeReason = "ready" | "error" | "output" | "exit";
+
+export interface ProcessRecord {
+	id: string;
+	name: string;
+	command: string;
+	cwd: string;
+	pid: number | null;
+	state: ProcessState;
+	exitCode: number | null;
+	startedAt: string;
+	endedAt: string | null;
+	logLines: number;
+	backgrounded: boolean;
+}
+
+export interface WakeConfig {
+	ready: string | null;
+	error: string | null;
+	exit: boolean;
+	output: boolean;
+}
+
+export interface CleanupConfig {
+	command: string;
+	timeoutSec: number;
+}
+
+export interface CleanupResult {
+	ran: boolean;
+	exitCode: number | null;
+	failed: boolean;
+}
+
+export interface WakeDetails {
+	id: string;
+	name: string;
+	reasons: WakeReason[];
+	exitCode: number | null;
+	matchedLine: string | null;
+}
+
+export const LOG_PAGE_MAX_BYTES = 64 * 1024;
+export const DEFAULT_KILL_TIMEOUT_SEC = 5;
+export const DEFAULT_CLEANUP_TIMEOUT_SEC = 30;
+export const DEFAULT_STALLED_SEC = 30;
+export const CUSTOM_TYPE = "background-process";
+
+export const WAKE_REASON_ORDER: WakeReason[] = ["ready", "error", "output", "exit"];
diff --git a/packages/coding-agent/test/background-processes-extension.test.ts b/packages/coding-agent/test/background-processes-extension.test.ts
