@@ -0,0 +1,179 @@
+/**
+ * Spawn a command through the configured shell and stop a process tree
+ * with SIGTERM, then SIGKILL.
+ */
+
+import { type ChildProcess, spawn } from "node:child_process";
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { getShellConfig } from "@earendil-works/pi-coding-agent";
+
+export interface SpawnedCommand {
+	child: ChildProcess;
+	pid: number;
+}
+
+function unrefStdio(child: ChildProcess): void {
+	child.stdout?.unref();
+	child.stderr?.unref();
+	child.stdin?.unref();
+	child.unref();
+}
+
+export function spawnShellCommand(command: string, cwd: string, env: NodeJS.ProcessEnv = process.env): SpawnedCommand {
+	const shellConfig = getShellConfig();
+	const commandFromStdin = shellConfig.commandTransport === "stdin";
+	const child = spawn(shellConfig.shell, commandFromStdin ? shellConfig.args : [...shellConfig.args, command], {
+		cwd,
+		detached: process.platform !== "win32",
+		env,
+		stdio: [commandFromStdin ? "pipe" : "ignore", "pipe", "pipe"],
+		windowsHide: true,
+	});
+	if (commandFromStdin) {
+		child.stdin?.on("error", () => {});
+		child.stdin?.end(command);
+	}
+	child.on("error", () => {});
+	unrefStdio(child);
+	const pid = child.pid;
+	if (pid === undefined) {
+		throw new Error("Failed to start process: no pid assigned");
+	}
+	return { child, pid };
+}
+
+export function processAlive(pid: number): boolean {
+	if (pid <= 0) return false;
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+function listDirectChildren(pid: number): number[] {
+	if (process.platform === "win32") return [];
+	const children = new Set<number>();
+	try {
+		const tasks = readdirSync(`/proc/${pid}/task`);
+		for (const tid of tasks) {
+			try {
+				const text = readFileSync(`/proc/${pid}/task/${tid}/children`, "utf8");
+				for (const part of text.trim().split(/\s+/)) {
+					if (!part) continue;
+					const childPid = Number(part);
+					if (Number.isInteger(childPid) && childPid > 0) children.add(childPid);
+				}
+			} catch {
+				// task vanished
+			}
+		}
+	} catch {
+		// process vanished or /proc unavailable
+	}
+	return [...children];
+}
+
+export function collectProcessTree(rootPid: number): number[] {
+	const result: number[] = [];
+	const stack = [rootPid];
+	const seen = new Set<number>();
+	while (stack.length > 0) {
+		const pid = stack.pop()!;
+		if (seen.has(pid) || pid <= 0 || pid === process.pid) continue;
+		seen.add(pid);
+		result.push(pid);
+		for (const child of listDirectChildren(pid)) stack.push(child);
+	}
+	return result;
+}
+
+function sendSignal(pid: number, signal: NodeJS.Signals): void {
+	if (pid <= 0 || pid === process.pid) return;
+	try {
+		process.kill(pid, signal);
+	} catch {
+		// already gone
+	}
+}
+
+function signalTree(rootPid: number, signal: NodeJS.Signals): void {
+	if (process.platform !== "win32") {
+		try {
+			process.kill(-rootPid, signal);
+		} catch {
+			// group may already be gone
+		}
+	}
+	for (const pid of collectProcessTree(rootPid)) {
+		sendSignal(pid, signal);
+	}
+}
+
+export function processGroupAlive(pgid: number): boolean {
+	if (pgid <= 0) return false;
+	if (process.platform === "win32") return processAlive(pgid);
+	try {
+		process.kill(-pgid, 0);
+		return true;
+	} catch {
+		return processAlive(pgid) || collectProcessTree(pgid).some((pid) => processAlive(pid));
+	}
+}
+
+export function treeAlive(rootPid: number): boolean {
+	return processGroupAlive(rootPid);
+}
+
+function killWindowsTree(pid: number): void {
+	try {
+		const killer = spawn(
+			join(process.env.SystemRoot ?? "C:\\Windows", "System32", "taskkill.exe"),
+			["/F", "/T", "/PID", String(pid)],
+			{ stdio: "ignore", detached: true, windowsHide: true },
+		);
+		killer.once("error", () => {});
+		killer.unref();
+	} catch {
+		// ignore
+	}
+}
+
+export function killTreeNow(rootPid: number, signal: NodeJS.Signals): void {
+	if (process.platform === "win32") {
+		killWindowsTree(rootPid);
+		return;
+	}
+	signalTree(rootPid, signal);
+}
+
+export async function killProcessTree(rootPid: number, timeoutSec: number): Promise<void> {
+	if (process.platform === "win32") {
+		killWindowsTree(rootPid);
+		const deadline = Date.now() + Math.max(0, timeoutSec) * 1000;
+		while (Date.now() < deadline && treeAlive(rootPid)) {
+			await sleep(50);
+		}
+		return;
+	}
+
+	if (!treeAlive(rootPid)) return;
+	signalTree(rootPid, "SIGTERM");
+	const deadline = Date.now() + Math.max(0, timeoutSec) * 1000;
+	while (Date.now() < deadline && treeAlive(rootPid)) {
+		await sleep(50);
+	}
+	if (treeAlive(rootPid)) {
+		signalTree(rootPid, "SIGKILL");
+		const killDeadline = Date.now() + 1000;
+		while (Date.now() < killDeadline && treeAlive(rootPid)) {
+			await sleep(20);
+		}
+	}
+}
+
+export function sleep(ms: number): Promise<void> {
+	return new Promise((resolve) => setTimeout(resolve, ms));
+}
