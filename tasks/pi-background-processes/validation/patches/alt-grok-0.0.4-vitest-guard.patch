+		this.stream = this.openStream(newPath);
+		this.closed = false;
+	}
+
+	private openStream(filePath: string): WriteStream {
+		const stream = createWriteStream(filePath, { flags: "a" });
+		stream.on("error", () => {});
+		return stream;
+	}
