@@ -0,0 +1,433 @@
+/**
+ * Background Processes Extension
+ *
+ * Long-lived processes (dev servers, test watchers, local APIs) that the
+ * agent can start, page logs for, stop, and be woken by — without blocking
+ * the bash tool or leaving children behind after pi exits.
+ *
+ * Usage:
+ *   pi -e packages/coding-agent/examples/extensions/background-processes
+ */
+
+import { constants } from "node:fs";
+import { access, unlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { resolve } from "node:path";
+import {
+	type AgentToolResult,
+	type AgentToolUpdateCallback,
+	type BashToolDetails,
+	DEFAULT_MAX_BYTES,
+	DEFAULT_MAX_LINES,
+	type ExtensionAPI,
+	type ExtensionContext,
+	formatSize,
+	truncateTail,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import { ProcessLog } from "./log-file.ts";
+import { getProcessManager, resetBackgroundProcessesForTests, toPublicRecord } from "./manager.ts";
+import { killProcessTree, spawnShellCommand } from "./process-tree.ts";
+import {
+	DEFAULT_CLEANUP_TIMEOUT_SEC,
+	DEFAULT_KILL_TIMEOUT_SEC,
+	DEFAULT_STALLED_SEC,
+	type ProcessRecord,
+} from "./types.ts";
+
+export { resetBackgroundProcessesForTests };
+export type { ProcessRecord } from "./types.ts";
+
+const manager = getProcessManager();
+
+function jsonResult<T>(value: T): AgentToolResult<T> {
+	return {
+		content: [{ type: "text", text: JSON.stringify(value, null, 2) }],
+		details: value,
+	};
+}
+
+function resolveCwd(ctx: ExtensionContext, cwd?: string): string {
+	return cwd ? resolve(ctx.cwd, cwd) : ctx.cwd;
+}
+
+async function assertCwd(cwd: string, shellName: string): Promise<void> {
+	try {
+		await access(cwd, constants.F_OK);
+	} catch {
+		throw new Error(`Working directory does not exist: ${cwd}\nCannot execute ${shellName} commands.`);
+	}
+}
+
+function appendStatus(text: string, status: string): string {
+	return `${text ? `${text}\n\n` : ""}${status}`;
+}
+
+function formatBashOutput(
+	tail: string,
+	totalLines: number,
+	totalBytes: number,
+	fullOutputPath: string,
+): { text: string; details: BashToolDetails | undefined } {
+	const truncation = truncateTail(tail);
+	const truncated = totalLines > DEFAULT_MAX_LINES || totalBytes > DEFAULT_MAX_BYTES;
+	if (!truncated) {
+		return { text: truncation.content || "(no output)", details: undefined };
+	}
+	const outputLines = truncation.outputLines || truncation.content.split("\n").length;
+	const startLine = Math.max(1, totalLines - outputLines + 1);
+	const endLine = totalLines;
+	let text = truncation.content || "(no output)";
+	const details: BashToolDetails = {
+		truncation: {
+			...truncation,
+			truncated: true,
+			totalLines,
+			totalBytes,
+			truncatedBy: totalLines > DEFAULT_MAX_LINES ? "lines" : "bytes",
+		},
+		fullOutputPath,
+	};
+	if (truncation.lastLinePartial) {
+		text += `\n\n[Showing last ${formatSize(truncation.outputBytes)} of line ${endLine} (line is ${formatSize(Buffer.byteLength(truncation.content, "utf-8"))}). Full output: ${fullOutputPath}]`;
+	} else if (totalLines > DEFAULT_MAX_LINES && totalBytes <= DEFAULT_MAX_BYTES) {
+		text += `\n\n[Showing lines ${startLine}-${endLine} of ${totalLines}. Full output: ${fullOutputPath}]`;
+	} else {
+		text += `\n\n[Showing lines ${startLine}-${endLine} of ${totalLines} (${formatSize(DEFAULT_MAX_BYTES)} limit). Full output: ${fullOutputPath}]`;
+	}
+	return { text, details };
+}
+
+const bgRunSchema = Type.Object({
+	command: Type.String({ description: "Shell command to start in the background" }),
+	cwd: Type.Optional(
+		Type.String({ description: "Working directory (relative paths resolve against the session cwd)" }),
+	),
+	name: Type.Optional(Type.String({ description: "Display name for the process" })),
+	wake: Type.Optional(
+		Type.Object({
+			ready: Type.Optional(Type.String({ description: "Regex matched against each output line to wake on ready" })),
+			error: Type.Optional(Type.String({ description: "Regex matched against each output line to wake on error" })),
+		}),
+	),
+	cleanup: Type.Optional(
+		Type.Object({
+			command: Type.String({ description: "Command to run after the process tree is gone" }),
+			timeoutSec: Type.Optional(Type.Number({ description: "Cleanup timeout in seconds (default 30)" })),
+		}),
+	),
+});
+
+const bgLogsSchema = Type.Object({
+	id: Type.String({ description: "Process id" }),
+	offset: Type.Optional(Type.Number({ description: "Line offset to start from (0-based)" })),
+	limit: Type.Optional(Type.Number({ description: "Maximum number of lines to return" })),
+});
+
+const bgListSchema = Type.Object({});
+
+const bgKillSchema = Type.Object({
+	id: Type.String({ description: "Process id" }),
+	timeoutSec: Type.Optional(Type.Number({ description: "Seconds to wait after SIGTERM before SIGKILL (default 5)" })),
+});
+
+const bgWatchSchema = Type.Object({
+	id: Type.String({ description: "Process id" }),
+	ready: Type.Optional(Type.Union([Type.String(), Type.Null()])),
+	error: Type.Optional(Type.Union([Type.String(), Type.Null()])),
+	exit: Type.Optional(Type.Boolean()),
+	output: Type.Optional(Type.Boolean()),
+});
+
+const bashSchema = Type.Object({
+	command: Type.String({ description: "Shell command to execute" }),
+	timeout: Type.Optional(Type.Number({ description: "Timeout in seconds (optional, no default timeout)" })),
+	stalledSec: Type.Optional(
+		Type.Number({
+			description: "Seconds of silence while still running before moving the command to the background (default 30)",
+		}),
+	),
+});
+
+type BashOutcome = { type: "exit"; code: number | null } | { type: "stall" } | { type: "timeout" } | { type: "abort" };
+
+async function executeBash(
+	params: { command: string; timeout?: number; stalledSec?: number },
+	signal: AbortSignal | undefined,
+	onUpdate: AgentToolUpdateCallback<unknown> | undefined,
+	ctx: ExtensionContext,
+): Promise<AgentToolResult<unknown>> {
+	await manager.bindContext(ctx);
+	if (params.timeout !== undefined && (!Number.isFinite(params.timeout) || params.timeout <= 0)) {
+		throw new Error("Invalid timeout: must be a finite number of seconds");
+	}
+	const stalledSec = params.stalledSec ?? DEFAULT_STALLED_SEC;
+	const cwd = ctx.cwd;
+	await assertCwd(cwd, "bash");
+
+	const tmpLog = `${tmpdir()}/pi-bash-${crypto.randomUUID()}.log`;
+	const log = await ProcessLog.create(tmpLog);
+	const startedAt = new Date().toISOString();
+	const spawned = spawnShellCommand(params.command, cwd);
+	const { child, pid } = spawned;
+
+	let tail = "";
+	let totalBytes = 0;
+	let adoptedId: string | null = null;
+	let forwarding = false;
+	const bufferedLines: string[] = [];
+	let lastUpdateAt = 0;
+
+	const emitUpdate = () => {
+		if (!onUpdate) return;
+		const now = Date.now();
+		if (now - lastUpdateAt < 100) return;
+		lastUpdateAt = now;
+		const { text, details } = formatBashOutput(tail, log.lineCount, totalBytes, tmpLog);
+		onUpdate({ content: [{ type: "text", text }], details });
+	};
+
+	const onData = (data: Buffer) => {
+		totalBytes += data.length;
+		const lines = log.append(data);
+		tail += data.toString("utf8");
+		if (tail.length > DEFAULT_MAX_BYTES * 3) {
+			const keep = tail.slice(-DEFAULT_MAX_BYTES * 2);
+			const nl = keep.indexOf("\n");
+			tail = nl >= 0 ? keep.slice(nl + 1) : keep;
+		}
+		if (forwarding) {
+			if (adoptedId) {
+				const proc = manager.get(adoptedId);
+				if (proc) manager.handleLines(proc, lines);
+			} else if (lines.length > 0) {
+				bufferedLines.push(...lines);
+			}
+		}
+		emitUpdate();
+		if (log.needsDrain) {
+			child.stdout?.pause();
+			child.stderr?.pause();
+			void log.waitForDrain().then(() => {
+				child.stdout?.resume();
+				child.stderr?.resume();
+			});
+		}
+	};
+	child.stdout?.on("data", onData);
+	child.stderr?.on("data", onData);
+
+	let settle!: (outcome: BashOutcome) => void;
+	const outcomePromise = new Promise<BashOutcome>((resolve) => {
+		let settled = false;
+		settle = (outcome) => {
+			if (settled) return;
+			settled = true;
+			resolve(outcome);
+		};
+	});
+
+	child.once("exit", (code) => settle({ type: "exit", code }));
+	child.once("error", () => settle({ type: "exit", code: 1 }));
+
+	let stallTimer: NodeJS.Timeout | undefined;
+	const armStall = () => {
+		if (stallTimer) clearTimeout(stallTimer);
+		stallTimer = setTimeout(() => settle({ type: "stall" }), Math.max(0, stalledSec) * 1000);
+	};
+	armStall();
+	child.stdout?.on("data", () => armStall());
+	child.stderr?.on("data", () => armStall());
+
+	let timeoutTimer: NodeJS.Timeout | undefined;
+	if (params.timeout !== undefined) {
+		timeoutTimer = setTimeout(() => settle({ type: "timeout" }), params.timeout * 1000);
+	}
+
+	const onAbort = () => settle({ type: "abort" });
+	if (signal) {
+		if (signal.aborted) onAbort();
+		else signal.addEventListener("abort", onAbort, { once: true });
+	}
+
+	const outcome = await outcomePromise;
+	if (stallTimer) clearTimeout(stallTimer);
+	if (timeoutTimer) clearTimeout(timeoutTimer);
+	if (signal) signal.removeEventListener("abort", onAbort);
+
+	if (outcome.type === "stall" && child.exitCode === null && child.signalCode === null) {
+		forwarding = true;
+		const record = await manager.adopt({
+			child,
+			pid,
+			log,
+			command: params.command,
+			cwd,
+			backgrounded: true,
+			stalledSec,
+			startedAt,
+		});
+		adoptedId = record.id;
+		const proc = manager.get(record.id);
+		if (proc && bufferedLines.length > 0) manager.handleLines(proc, bufferedLines);
+		return jsonResult({ ...record, backgrounded: true as const, stalledSec });
+	}
+
+	const finished: Exclude<BashOutcome, { type: "stall" }> =
+		outcome.type === "stall" ? { type: "exit", code: child.exitCode } : outcome;
+
+	if (finished.type === "timeout" || finished.type === "abort") {
+		await killProcessTree(pid, DEFAULT_KILL_TIMEOUT_SEC);
+	}
+
+	await log.close();
+	const snapshotTail = tail;
+	const { text, details } = formatBashOutput(snapshotTail, log.lineCount, totalBytes, tmpLog);
+	if (!details?.truncation?.truncated) {
+		await unlink(tmpLog).catch(() => {});
+	}
+
+	if (finished.type === "abort") {
+		throw new Error(appendStatus(text === "(no output)" ? "" : text, "Command aborted"));
+	}
+	if (finished.type === "timeout") {
+		throw new Error(
+			appendStatus(text === "(no output)" ? "" : text, `Command timed out after ${params.timeout} seconds`),
+		);
+	}
+	if (finished.code !== 0 && finished.code !== null) {
+		throw new Error(appendStatus(text, `Command exited with code ${finished.code}`));
+	}
+	return { content: [{ type: "text", text }], details };
+}
+
+export default function (pi: ExtensionAPI): void {
+	manager.bind({
+		sendMessage: (message, options) => pi.sendMessage(message, options),
+	});
+
+	pi.on("session_start", async (_event, ctx) => {
+		await manager.bindContext(ctx);
+	});
+
+	pi.on("session_shutdown", async (event) => {
+		if (event.reason === "quit") {
+			await manager.stopAll({ timeoutSec: DEFAULT_KILL_TIMEOUT_SEC });
+		}
+	});
+
+	pi.on("before_agent_start", () => {
+		manager.onBeforeAgentStart();
+	});
+
+	pi.on("agent_settled", () => {
+		manager.onAgentSettled();
+	});
+
+	pi.registerTool({
+		name: "bg_run",
+		label: "bg_run",
+		description:
+			"Start a shell command as a managed background process and return immediately with its process record. Use for long-lived processes such as dev servers, test watchers, and local APIs. Optional wake.ready / wake.error are regular expressions matched against each output line.",
+		promptSnippet: "Start a managed background process (dev server, watcher, long build)",
+		promptGuidelines: [
+			"Use bg_run for long-lived processes. Use bash for short commands that should finish before you continue.",
+			"After bg_run, page output with bg_logs and stop the tree with bg_kill. Do not background with nohup or trailing &.",
+		],
+		parameters: bgRunSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			await manager.bindContext(ctx);
+			const cwd = resolveCwd(ctx, params.cwd);
+			await assertCwd(cwd, "bash");
+			const record = await manager.start({
+				command: params.command,
+				cwd,
+				name: params.name,
+				wake: params.wake,
+				cleanup: params.cleanup
+					? {
+							command: params.cleanup.command,
+							timeoutSec: params.cleanup.timeoutSec ?? DEFAULT_CLEANUP_TIMEOUT_SEC,
+						}
+					: undefined,
+			});
+			return jsonResult(record);
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_logs",
+		label: "bg_logs",
+		description:
+			"Page the combined stdout/stderr of a managed process. Omitting limit returns the newest lines that fit in 64KB.",
+		promptSnippet: "Page stdout/stderr of a managed background process",
+		parameters: bgLogsSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			await manager.bindContext(ctx);
+			const page = await manager.logs(params.id, params.offset, params.limit);
+			return jsonResult(page);
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_list",
+		label: "bg_list",
+		description: "List managed background processes visible to this session (running and finished).",
+		promptSnippet: "List managed background processes",
+		parameters: bgListSchema,
+		async execute(_toolCallId, _params, _signal, _onUpdate, ctx) {
+			await manager.bindContext(ctx);
+			return jsonResult({ processes: manager.list() });
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_kill",
+		label: "bg_kill",
+		description:
+			"Stop a managed process and all of its descendants (SIGTERM, then SIGKILL after timeoutSec). Runs the process cleanup command if one was registered.",
+		promptSnippet: "Stop a managed background process and its descendants",
+		parameters: bgKillSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			await manager.bindContext(ctx);
+			const { record, cleanup } = await manager.kill(params.id, params.timeoutSec ?? DEFAULT_KILL_TIMEOUT_SEC);
+			return jsonResult({ ...record, cleanup });
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_watch",
+		label: "bg_watch",
+		description:
+			"Change wake rules of a running managed process. Pass null to remove a ready/error pattern; exit: false or output: false silences that wake.",
+		promptSnippet: "Change wake rules of a running background process",
+		parameters: bgWatchSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			await manager.bindContext(ctx);
+			const record = manager.watch(params.id, {
+				ready: params.ready,
+				error: params.error,
+				exit: params.exit,
+				output: params.output,
+			});
+			return jsonResult(record);
+		},
+	});
+
+	pi.registerTool({
+		name: "bash",
+		label: "bash",
+		description: `Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last ${DEFAULT_MAX_LINES} lines or ${DEFAULT_MAX_BYTES / 1024}KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds. If the command produces no output for stalledSec seconds (default 30) while still running, it becomes a managed background process.`,
+		promptSnippet: "Execute bash commands (ls, grep, find, etc.)",
+		promptGuidelines: ["You can inspect PI_* environment variables for current model and session details."],
+		parameters: bashSchema,
+		async execute(_toolCallId, params, signal, onUpdate, ctx) {
+			return executeBash(params, signal, onUpdate, ctx);
+		},
+	});
+}
+
+export function getManagedRecord(id: string): ProcessRecord | undefined {
+	const proc = getProcessManager().get(id);
+	return proc ? toPublicRecord(proc) : undefined;
+}
diff --git a/packages/coding-agent/examples/extensions/background-processes/log-file.ts b/packages/coding-agent/examples/extensions/background-processes/log-file.ts
