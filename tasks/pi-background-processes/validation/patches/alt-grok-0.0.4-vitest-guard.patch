+
+function splitLogChunk(text: string, fileEndedWithNewline: boolean): string[] {
+	if (text.length === 0) return [];
+	const lines = text.split(/\n/);
+	if (fileEndedWithNewline || text.endsWith("\n")) {
+		if (lines[lines.length - 1] === "") lines.pop();
+	}
+	return lines.map((line) => line.replace(/\r$/, ""));
+}
+
+function takeBytesFromEnd(lines: string[], maxBytes: number): string[] {
+	const out: string[] = [];
+	let used = 0;
+	for (let i = lines.length - 1; i >= 0; i--) {
+		const line = lines[i];
+		const size = Buffer.byteLength(line, "utf-8") + (out.length > 0 ? 1 : 0);
+		if (used + size > maxBytes) {
+			if (out.length === 0) {
+				out.unshift(truncateToBytesFromEnd(line, maxBytes));
+			}
+			break;
+		}
+		out.unshift(line);
+		used += size;
+	}
+	return out;
+}
+
+function truncateToBytes(text: string, maxBytes: number): string {
+	const buf = Buffer.from(text, "utf-8");
+	if (buf.length <= maxBytes) return text;
+	return buf.subarray(0, maxBytes).toString("utf-8");
+}
+
+function truncateToBytesFromEnd(text: string, maxBytes: number): string {
+	const buf = Buffer.from(text, "utf-8");
+	if (buf.length <= maxBytes) return text;
+	return buf.subarray(buf.length - maxBytes).toString("utf-8");
+}
+
+/**
+ * Page a log file without loading it all into memory.
+ * `total` is the caller's line count so the served offset stays consistent
+ * with the process record even if the file is still being flushed.
+ */
+export function pageLogFile(
+	filePath: string,
+	total: number,
+	opts: { offset?: number; limit?: number },
+): { offset: number; lines: string[] } {
+	if (!existsSync(filePath) || total <= 0) {
+		return { offset: opts.offset ?? 0, lines: [] };
+	}
+
+	const fd = openSync(filePath, "r");
+	try {
+		const size = fstatSync(fd).size;
+		if (size === 0) return { offset: opts.offset ?? 0, lines: [] };
+
+		const fromStart = opts.offset !== undefined;
+		if (!fromStart) {
+			return pageFromEnd(fd, size, total, opts.limit);
+		}
+		return pageFromOffset(fd, size, total, Math.max(0, opts.offset ?? 0), opts.limit);
+	} finally {
+		closeSync(fd);
+	}
+}
+
+function pageFromEnd(
+	fd: number,
+	size: number,
+	total: number,
+	limit: number | undefined,
+): { offset: number; lines: string[] } {
+	const readSize = Math.min(size, LOG_PAGE_MAX_BYTES + 8 * 1024);
+	const buf = Buffer.alloc(readSize);
+	readSync(fd, buf, 0, readSize, size - readSize);
+	let text = buf.toString("utf-8");
+	if (readSize < size) {
+		const nl = text.indexOf("\n");
+		if (nl >= 0) text = text.slice(nl + 1);
+	}
+	let lines = splitLogChunk(text, true);
+	if (limit !== undefined) {
+		if (limit <= 0) return { offset: total, lines: [] };
+		lines = lines.slice(-limit);
+	}
+	lines = takeBytesFromEnd(lines, LOG_PAGE_MAX_BYTES);
+	const offset = Math.max(0, total - lines.length);
+	return { offset, lines };
+}
+
+function pageFromOffset(
+	fd: number,
+	size: number,
+	total: number,
+	offset: number,
+	limit: number | undefined,
+): { offset: number; lines: string[] } {
+	if (offset >= total) return { offset, lines: [] };
+	const maxLines = limit === undefined ? Number.POSITIVE_INFINITY : Math.max(0, limit);
+	if (maxLines === 0) return { offset, lines: [] };
+
+	const buf = Buffer.alloc(64 * 1024);
+	let position = 0;
+	let lineIndex = 0;
+	let current: number[] = [];
+	const lines: string[] = [];
+	let used = 0;
+
+	const emitLine = (bytes: number[]) => {
+		if (lineIndex < offset) {
+			lineIndex++;
+			return true;
+		}
+		if (lines.length >= maxLines) return false;
+		const line = Buffer.from(bytes).toString("utf-8").replace(/\r$/, "");
+		const extra = lines.length > 0 ? 1 : 0;
+		const lineBytes = Buffer.byteLength(line, "utf-8") + extra;
+		if (used + lineBytes > LOG_PAGE_MAX_BYTES) {
+			if (lines.length === 0) {
+				lines.push(truncateToBytes(line, LOG_PAGE_MAX_BYTES));
+			}
+			return false;
+		}
+		lines.push(line);
+		used += lineBytes;
+		lineIndex++;
+		return used < LOG_PAGE_MAX_BYTES && lines.length < maxLines;
+	};
+
+	while (position < size) {
+		const n = readSync(fd, buf, 0, buf.length, position);
+		if (n <= 0) break;
+		position += n;
+		for (let i = 0; i < n; i++) {
+			const b = buf[i];
+			if (b === 0x0a) {
+				if (current[current.length - 1] === 0x0d) current.pop();
+				const keep = emitLine(current);
+				current = [];
+				if (!keep && lineIndex > offset) {
+					return { offset, lines };
+				}
+			} else {
+				if (lineIndex >= offset && lines.length < maxLines) {
+					current.push(b);
+					if (current.length > LOG_PAGE_MAX_BYTES + 16) {
+						current.length = LOG_PAGE_MAX_BYTES + 16;
+					}
+				}
+			}
+		}
+	}
+	if (current.length > 0 && lineIndex >= offset && lines.length < maxLines) {
+		emitLine(current);
+	}
+	return { offset, lines };
+}
