+	}
+
+	private testLine(regex: RegExp, line: string): boolean {
+		regex.lastIndex = 0;
+		return regex.test(line);
+	}
+
+	private async onChildExit(proc: ManagedProcess, code: number | null): Promise<void> {
+		if (proc.state !== "running") {
+			proc.resolveEnded();
+			return;
+		}
+		proc.state = proc.killing ? "killed" : "exited";
+		proc.exitCode = code;
+		proc.endedAt = new Date().toISOString();
+		await this.persist(proc);
+		if (proc.log) {
+			await proc.log.close().catch(() => {});
+		}
+		await this.persist(proc);
+		if (proc.wake.exit && !proc.exitWakeDelivered) {
+			this.queueWake(proc, "exit", null);
+		}
+		proc.resolveEnded();
+	}
+
+	async logs(
+		id: string,
+		offset?: number,
+		limit?: number,
+	): Promise<{ id: string; offset: number; lines: string[]; total: number }> {
+		const proc = this.processes.get(id);
+		if (proc) {
+			if (proc.log) await proc.log.flush();
+			const total = proc.log?.lineCount ?? 0;
+			const path = proc.log?.filePath ?? join(proc.dir, "output.log");
+			const page = pageLogFile(path, total, { offset, limit });
+			return { id, offset: page.offset, lines: page.lines, total };
+		}
+		const disk = this.diskRecords.get(id);
+		if (!disk) throw new Error(`Unknown process id: ${id}`);
+		const store = this.store;
+		const dir = store ? processDir({ sessionDir: store.sessionDir, sessionId: store.sessionId }, id) : null;
+		const path = dir ? join(dir, "output.log") : "";
+		const page = path
+			? pageLogFile(path, disk.logLines, { offset, limit })
+			: { offset: offset ?? 0, lines: [] as string[] };
+		return { id, offset: page.offset, lines: page.lines, total: disk.logLines };
+	}
+
+	watch(
+		id: string,
+		patch: { ready?: string | null; error?: string | null; exit?: boolean; output?: boolean },
+	): ProcessRecord {
+		const proc = this.require(id);
+		if (proc.state !== "running") {
+			throw new Error(`Process ${id} is not running`);
+		}
+		if (patch.ready !== undefined) {
+			proc.wake.ready = patch.ready;
+			proc.readyRegex = compilePattern(patch.ready, "ready");
+		}
+		if (patch.error !== undefined) {
+			proc.wake.error = patch.error;
+			proc.errorRegex = compilePattern(patch.error, "error");
+		}
+		if (patch.exit !== undefined) proc.wake.exit = patch.exit;
+		if (patch.output !== undefined) proc.wake.output = patch.output;
+		void this.persist(proc);
+		return publicRecord(proc);
+	}
+
+	async kill(
+		id: string,
+		timeoutSec = DEFAULT_KILL_TIMEOUT_SEC,
+	): Promise<{ record: ProcessRecord; cleanup: CleanupResult | null }> {
+		const proc = this.require(id);
+		if (proc.state === "running") {
+			proc.killing = true;
+			const pid = proc.pid;
+			if (pid !== null) {
+				await killProcessTree(pid, timeoutSec);
+			}
+			const waitDeadline = Date.now() + Math.max(timeoutSec, 0) * 1000 + 1500;
+			while (proc.state === "running" && Date.now() < waitDeadline) {
+				await new Promise((resolve) => setTimeout(resolve, 30));
+			}
+			if (proc.state === "running") {
+				await this.onChildExit(proc, null);
+			}
+		}
+
+		let cleanup: CleanupResult | null = null;
+		if (proc.cleanup) {
+			if (proc.cleanupResult) {
+				cleanup = proc.cleanupResult;
+			} else {
+				const pid = proc.pid;
+				if (pid !== null) {
+					const leftoverDeadline = Date.now() + 1000;
+					while (treeAlive(pid) && Date.now() < leftoverDeadline) {
+						await new Promise((resolve) => setTimeout(resolve, 20));
+					}
+				}
+				cleanup = await this.runCleanup(proc);
+				proc.cleanupResult = cleanup;
+				await this.persist(proc);
+			}
+		}
+		return { record: publicRecord(proc), cleanup };
+	}
+
+	private async runCleanup(proc: ManagedProcess): Promise<CleanupResult> {
+		const cleanup = proc.cleanup;
+		if (!cleanup) return { ran: false, exitCode: null, failed: false };
+		const timeoutSec = cleanup.timeoutSec ?? DEFAULT_CLEANUP_TIMEOUT_SEC;
+		let log = proc.log;
+		if (!log || log.closed) {
+			log = await ProcessLog.create(join(proc.dir, "output.log"));
+			proc.log = log;
+		}
+		try {
+			const spawned = spawnShellCommand(cleanup.command, proc.cwd);
+			const child = spawned.child;
+			const onData = (data: Buffer) => {
+				log.append(data);
+			};
+			child.stdout?.on("data", onData);
+			child.stderr?.on("data", onData);
+			const result = await new Promise<{ code: number | null; timedOut: boolean }>((resolve) => {
+				let settled = false;
+				const timer = setTimeout(() => {
+					if (settled) return;
+					void killProcessTree(spawned.pid, 1).finally(() => {
+						if (!settled) resolve({ code: null, timedOut: true });
+					});
+				}, Math.max(0, timeoutSec) * 1000);
+				child.once("exit", (code) => {
+					if (settled) return;
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code, timedOut: false });
+				});
+				child.once("error", () => {
+					if (settled) return;
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code: 1, timedOut: false });
+				});
+			});
+			await log.flush();
+			const failed = result.timedOut || result.code === null || result.code !== 0;
+			return { ran: true, exitCode: result.code, failed };
+		} catch {
+			return { ran: true, exitCode: null, failed: true };
+		}
+	}
+
+	async stopAll(options?: { timeoutSec?: number }): Promise<void> {
+		const timeoutSec = options?.timeoutSec ?? DEFAULT_KILL_TIMEOUT_SEC;
+		const running = [...this.processes.values()].filter((proc) => proc.state === "running");
+		await Promise.all(
+			running.map(async (proc) => {
+				proc.killing = true;
+				if (proc.pid !== null) await killProcessTree(proc.pid, timeoutSec);
+				if (proc.state === "running") await this.onChildExit(proc, null);
+			}),
+		);
+	}
+
+	stopAllSync(): void {
+		for (const proc of this.processes.values()) {
+			if (proc.state !== "running" || proc.pid === null) continue;
+			proc.killing = true;
+			killTreeNow(proc.pid, "SIGKILL");
+		}
+	}
+
+	private queueWake(proc: ManagedProcess, reason: WakeReason, matchedLine: string | null): void {
+		if (proc.exitWakeDelivered && reason !== "exit") return;
+		if (reason === "ready") {
+			if (!proc.wake.ready || proc.readyWoke) return;
+			proc.readyWoke = true;
+		}
+		if (reason === "error") {
+			if (!proc.wake.error || proc.errorInWindow) return;
+			proc.errorInWindow = true;
+		}
+		if (reason === "output") {
+			if (!proc.wake.output || proc.outputWoke) return;
+			proc.outputWoke = true;
+		}
+		if (reason === "exit") {
+			if (!proc.wake.exit || proc.exitWakeDelivered) return;
+			proc.exitWakeDelivered = true;
+		}
+
+		let pending = this.pending.get(proc.id);
+		if (!pending) {
+			pending = {
+				id: proc.id,
+				name: proc.name,
+				reasons: new Set(),
+				exitCode: proc.exitCode,
+				matchedLine: null,
+				firstFiredAt: Date.now(),
+			};
+			this.pending.set(proc.id, pending);
+		}
+		pending.reasons.add(reason);
+		pending.exitCode = proc.exitCode;
+		if (pending.matchedLine === null && matchedLine !== null) pending.matchedLine = matchedLine;
+		this.scheduleFlush();
+	}
+
+	private scheduleFlush(): void {
+		if (this.flushScheduled) return;
+		this.flushScheduled = true;
+		queueMicrotask(() => {
+			this.flushScheduled = false;
+			this.flushPending();
+		});
+	}
+
+	private flushPending(): void {
+		if (this.pending.size === 0) return;
+		const send = this.sendMessage;
+		if (!send) return;
+		const items = [...this.pending.values()].sort((a, b) => a.firstFiredAt - b.firstFiredAt);
+		this.pending.clear();
+		const idle = this.safeIsIdle();
+		for (const item of items) {
+			const reasons = WAKE_REASON_ORDER.filter((reason) => item.reasons.has(reason));
+			if (reasons.length === 0) continue;
+			const details: WakeDetails = {
+				id: item.id,
+				name: item.name,
+				reasons,
+				exitCode: item.exitCode,
+				matchedLine: item.matchedLine,
+			};
+			try {
+				send(
+					{
+						customType: CUSTOM_TYPE,
+						content: formatWakeContent(details),
+						display: true,
+						details,
+					},
+					{ triggerTurn: true, deliverAs: "steer" },
+				);
+			} catch {
+				this.pending.set(item.id, item);
+			}
+		}
+		if (idle) this.resetErrorWindows();
+	}
+
+	onBeforeAgentStart(): void {
+		this.resetErrorWindows();
+	}
+
+	onAgentSettled(): void {
+		this.resetErrorWindows();
+	}
+
+	private resetErrorWindows(): void {
+		for (const proc of this.processes.values()) {
+			proc.errorInWindow = false;
+		}
+	}
+
+	private safeIsIdle(): boolean {
+		try {
+			return this.isIdle();
+		} catch {
+			return true;
+		}
+	}
+
+	async persist(proc: ManagedProcess): Promise<void> {
+		const timer = this.persistTimers.get(proc.id);
+		if (timer) {
+			clearTimeout(timer);
+			this.persistTimers.delete(proc.id);
+		}
+		const previous = this.persistChain.get(proc.id) ?? Promise.resolve();
+		const next = previous.then(
+			() => this.writeRecord(proc),
+			() => this.writeRecord(proc),
+		);
+		this.persistChain.set(proc.id, next);
+		await next;
+	}
+
+	private async writeRecord(proc: ManagedProcess): Promise<void> {
+		try {
+			await mkdir(proc.dir, { recursive: true });
+			await writeJsonAtomic(join(proc.dir, "record.json"), persistShape(proc));
+		} catch {
+			// persistence is best-effort during teardown
+		}
+	}
+
+	private schedulePersist(proc: ManagedProcess): void {
+		if (this.persistTimers.has(proc.id)) return;
+		const timer = setTimeout(() => {
+			this.persistTimers.delete(proc.id);
+			void this.persist(proc);
+		}, 100);
+		timer.unref();
+		this.persistTimers.set(proc.id, timer);
+	}
+
+	private requireStore(): SessionStore {
+		if (!this.store) {
+			this.store = {
+				sessionDir: join(tmpdir(), "pi-background-processes"),
+				sessionId: "in-memory",
+			};
+		}
+		return this.store;
+	}
+
+	installHooks(): void {
+		if (this.hooksInstalled) return;
+		this.hooksInstalled = true;
+		if (process.env.VITEST) return;
+
+		const onFatalSignal = (signal: NodeJS.Signals) => {
+			if (this.stoppingForExit) return;
+			this.stoppingForExit = true;
+			for (const proc of this.processes.values()) {
+				if (proc.state === "running" && proc.pid !== null) {
+					proc.killing = true;
+					killTreeNow(proc.pid, "SIGTERM");
+				}
+			}
+			void this.stopAll({ timeoutSec: DEFAULT_KILL_TIMEOUT_SEC }).finally(() => {
+				try {
+					process.removeListener(signal, onFatalSignal);
+				} catch {
+					// ignore
+				}
+				try {
+					process.kill(process.pid, signal);
+				} catch {
+					process.exit(signal === "SIGINT" ? 130 : signal === "SIGHUP" ? 129 : 143);
+				}
+			});
+		};
+
+		process.prependListener("SIGTERM", onFatalSignal);
+		process.prependListener("SIGINT", onFatalSignal);
+		if (process.platform !== "win32") {
+			process.prependListener("SIGHUP", onFatalSignal);
+		}
+		process.on("exit", () => {
+			this.stopAllSync();
+		});
+	}
+
+	async resetForTests(): Promise<void> {
+		await this.stopAll({ timeoutSec: 1 });
+		for (const timer of this.persistTimers.values()) clearTimeout(timer);
+		this.persistTimers.clear();
+		this.persistChain.clear();
+		this.processes.clear();
+		this.diskRecords.clear();
+		this.loadedKeys.clear();
+		this.pending.clear();
+		this.store = null;
+		this.stoppingForExit = false;
+	}
+}
+
+function formatWakeContent(details: WakeDetails): string {
+	const reasonText = details.reasons.join(", ");
+	const line = details.matchedLine ? `\nmatched line: ${details.matchedLine}` : "";
+	const exit = details.reasons.includes("exit") && details.exitCode !== null ? `\nexit code: ${details.exitCode}` : "";
+	return `Background process "${details.name}" (${details.id}) woke the agent (${reasonText}).${line}${exit}`;
+}
+
+export function getProcessManager(): ProcessManager {
+	const g = globalThis as typeof globalThis & { [GLOBAL_KEY]?: ProcessManager };
+	if (!g[GLOBAL_KEY]) g[GLOBAL_KEY] = new ProcessManager();
+	return g[GLOBAL_KEY];
+}
+
+export async function resetBackgroundProcessesForTests(): Promise<void> {
+	await getProcessManager().resetForTests();
+}
+
+export function toPublicRecord(proc: ManagedProcess): ProcessRecord {
+	return publicRecord(proc);
+}
