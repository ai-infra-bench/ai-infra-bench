index 000000000..28760b142
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/log-file.ts
@@ -0,0 +1,298 @@
+/**
+ * Append-only process log. Bytes go to disk immediately; only a small
+ * decoder/partial-line buffer is kept in memory so output volume cannot
+ * grow the heap.
+ */
+
+import { closeSync, createWriteStream, existsSync, fstatSync, openSync, readSync, type WriteStream } from "node:fs";
+import { mkdir } from "node:fs/promises";
+import { dirname } from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import { LOG_PAGE_MAX_BYTES } from "./types.ts";
+
+const MATCH_CAP_BYTES = 64 * 1024;
+
+export class ProcessLog {
+	filePath: string;
+	private stream: WriteStream;
+	private decoder = new StringDecoder("utf8");
+	private partial = "";
+	private completedLines = 0;
+	private hasPartial = false;
+	private writeChain: Promise<void> = Promise.resolve();
+	private highWater = false;
+	private drainWaiters: Array<() => void> = [];
+	closed = false;
+
+	constructor(filePath: string) {
+		this.filePath = filePath;
+		this.stream = this.openStream(filePath);
+	}
+
+	static async create(filePath: string): Promise<ProcessLog> {
+		await mkdir(dirname(filePath), { recursive: true });
+		return new ProcessLog(filePath);
+	}
+
+	get lineCount(): number {
+		return this.completedLines + (this.hasPartial ? 1 : 0);
+	}
+
+	get needsDrain(): boolean {
+		return this.highWater;
+	}
+
+	waitForDrain(): Promise<void> {
+		if (!this.highWater) return Promise.resolve();
+		return new Promise((resolve) => this.drainWaiters.push(resolve));
+	}
+
+	/**
+	 * Append raw bytes. Returns newly completed lines (without trailing newlines)
+	 * for wake matching. Lines longer than 64KB are truncated for matching only;
+	 * the full bytes are still written to disk.
+	 */
+	append(data: Buffer): string[] {
+		if (this.closed || data.length === 0) return [];
+		this.writeChain = this.writeChain.then(
+			() =>
+				new Promise<void>((resolve) => {
+					if (this.closed) {
+						resolve();
+						return;
+					}
+					const ok = this.stream.write(data);
+					if (!ok) {
+						this.highWater = true;
+						this.stream.once("drain", () => {
+							this.highWater = false;
+							const waiters = this.drainWaiters.splice(0);
+							for (const waiter of waiters) waiter();
+						});
+					}
+					resolve();
+				}),
+		);
+		return this.consumeText(this.decoder.write(data));
+	}
+
+	private consumeText(text: string): string[] {
+		if (!text) return [];
+		const combined = this.partial + text;
+		const parts = combined.split(/\n/);
+		this.partial = parts.pop() ?? "";
+		if (this.partial.length > MATCH_CAP_BYTES) {
+			this.partial = this.partial.slice(0, MATCH_CAP_BYTES);
+		}
+		this.hasPartial = this.partial.length > 0;
+		const completed: string[] = [];
+		for (const part of parts) {
+			this.completedLines++;
+			completed.push(part.replace(/\r$/, ""));
+		}
+		return completed;
+	}
+
+	async flush(): Promise<void> {
+		await this.writeChain;
+		if (this.closed) return;
+		await new Promise<void>((resolve, reject) => {
+			this.stream.write(Buffer.alloc(0), (err) => {
+				if (err) reject(err);
+				else resolve();
+			});
+		});
+	}
+
+	async close(): Promise<void> {
+		if (this.closed) return;
+		const leftover = this.decoder.end();
+		if (leftover) this.consumeText(leftover);
+		await this.flush();
+		this.closed = true;
+		await new Promise<void>((resolve) => this.stream.end(resolve));
+	}
+
+	async moveTo(newPath: string): Promise<void> {
+		await this.flush();
+		if (newPath === this.filePath) return;
+		await mkdir(dirname(newPath), { recursive: true });
+		const { rename, copyFile, unlink } = await import("node:fs/promises");
+		await new Promise<void>((resolve) => this.stream.end(resolve));
+		try {
+			await rename(this.filePath, newPath);
+		} catch {
+			await copyFile(this.filePath, newPath);
+			await unlink(this.filePath).catch(() => {});
+		}
