index 0000000..36d8587
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/log.ts
@@ -0,0 +1,251 @@
+/**
+ * Durable line-oriented process logs.
+ *
+ * Complete lines are written to disk as they arrive. Only the current incomplete
+ * line is kept in memory so a process that prints hundreds of megabytes does not
+ * grow the heap accordingly.
+ */
+
+import { closeSync, existsSync, fstatSync, openSync, readSync, writeSync } from "node:fs";
+
+export const MAX_LOG_PAGE_BYTES = 64 * 1024;
+const MAX_INCOMPLETE_LINE_BYTES = 1024 * 1024;
+
+export interface LogPage {
+	offset: number;
+	lines: string[];
+	total: number;
+}
+
+function truncateUtf8(text: string, maxBytes: number): string {
+	const buf = Buffer.from(text, "utf8");
+	if (buf.length <= maxBytes) return text;
+	let end = maxBytes;
+	while (end > 0 && (buf[end] & 0xc0) === 0x80) {
+		end--;
+	}
+	return buf.subarray(0, end).toString("utf8");
+}
+
+function lineBytes(line: string, isFirst: boolean): number {
+	return Buffer.byteLength(line, "utf8") + (isFirst ? 0 : 1);
+}
+
+export class ProcessLog {
+	private logFd: number;
+	private idxFd: number;
+	private decoder = new TextDecoder();
+	private incomplete = "";
+	private completedLines = 0;
+	private bytesWritten = 0;
+	private closed = false;
+	private readonly onLine: ((line: string) => void) | undefined;
+
+	constructor(logPath: string, idxPath: string, onLine?: (line: string) => void, readOnly = false) {
+		const flag = readOnly ? "r" : "a+";
+		this.logFd = openSync(logPath, flag);
+		this.idxFd = openSync(idxPath, readOnly ? (existsSync(idxPath) ? "r" : "a+") : "a+");
+		const logStat = fstatSync(this.logFd);
+		this.bytesWritten = logStat.size;
+		const idxStat = fstatSync(this.idxFd);
+		this.completedLines = Math.floor(idxStat.size / 8);
+		this.onLine = onLine;
+	}
+
+	get lineCount(): number {
+		return this.completedLines + (this.incomplete.length > 0 ? 1 : 0);
+	}
+
+	appendBytes(data: Uint8Array): string[] {
+		if (this.closed || data.length === 0) return [];
+		return this.appendText(this.decoder.decode(data, { stream: true }));
+	}
+
+	appendText(text: string): string[] {
+		if (this.closed || text.length === 0) return [];
+		this.incomplete += text;
+		const completed: string[] = [];
+		let newline = this.incomplete.indexOf("\n");
+		while (newline >= 0) {
+			let line = this.incomplete.slice(0, newline);
+			if (line.endsWith("\r")) line = line.slice(0, -1);
+			this.incomplete = this.incomplete.slice(newline + 1);
+			this.writeCompletedLine(line);
+			completed.push(line);
+			newline = this.incomplete.indexOf("\n");
+		}
+		if (Buffer.byteLength(this.incomplete, "utf8") > MAX_INCOMPLETE_LINE_BYTES) {
+			const line = this.incomplete;
+			this.incomplete = "";
+			this.writeCompletedLine(line);
+			completed.push(line);
+		}
+		return completed;
+	}
+
+	/** Flush a trailing partial line as a completed line. */
+	finish(): string[] {
+		if (this.closed) return [];
+		this.appendText(this.decoder.decode());
+		if (this.incomplete.length === 0) return [];
+		const line = this.incomplete;
+		this.incomplete = "";
+		this.writeCompletedLine(line);
+		return [line];
+	}
+
+	readPage(offset?: number, limit?: number): LogPage {
+		const total = this.lineCount;
+		if (total === 0) {
+			return { offset: 0, lines: [], total: 0 };
+		}
+
+		const newest = offset === undefined && limit === undefined;
+		let start: number;
+		let maxLines: number;
+		if (newest) {
+			start = 0;
+			maxLines = total;
+		} else if (offset === undefined) {
+			const count = limit ?? total;
+			start = Math.max(0, total - Math.max(0, count));
+			maxLines = Math.max(0, count);
+		} else {
+			start = Math.max(0, Math.min(Math.floor(offset), total));
+			maxLines = limit === undefined ? total - start : Math.max(0, Math.floor(limit));
+		}
+
+		if (newest) {
+			return this.readNewest(total);
+		}
+		return this.readForward(start, maxLines, total);
+	}
+
+	close(): void {
+		if (this.closed) return;
+		this.closed = true;
+		try {
+			closeSync(this.logFd);
+		} catch {
+			// already closed
+		}
+		try {
+			closeSync(this.idxFd);
+		} catch {
+			// already closed
+		}
+	}
+
+	private writeCompletedLine(line: string): void {
+		const offsetBuf = Buffer.alloc(8);
+		offsetBuf.writeBigUInt64LE(BigInt(this.bytesWritten));
+		writeSync(this.idxFd, offsetBuf);
+		const payload = Buffer.from(`${line}\n`, "utf8");
+		writeSync(this.logFd, payload);
+		this.bytesWritten += payload.length;
+		this.completedLines++;
+		this.onLine?.(line);
+	}
+
+	private readNewest(total: number): LogPage {
+		let start = total;
+		let bytes = 0;
+		const collected: string[] = [];
+		while (start > 0) {
+			const line = this.lineAt(start - 1);
+			const extra = lineBytes(line, collected.length === 0);
+			if (bytes + extra > MAX_LOG_PAGE_BYTES) {
+				if (collected.length === 0) {
+					collected.unshift(truncateUtf8(line, MAX_LOG_PAGE_BYTES));
+					start--;
+				}
+				break;
+			}
+			collected.unshift(line);
+			bytes += extra;
+			start--;
+		}
+		return { offset: start, lines: collected, total };
+	}
+
+	private readForward(start: number, maxLines: number, total: number): LogPage {
+		const lines: string[] = [];
+		let bytes = 0;
+		const end = Math.min(total, start + maxLines);
+		for (let i = start; i < end; i++) {
+			const line = this.lineAt(i);
+			const extra = lineBytes(line, lines.length === 0);
+			if (bytes + extra > MAX_LOG_PAGE_BYTES) {
+				if (lines.length === 0) {
+					lines.push(truncateUtf8(line, MAX_LOG_PAGE_BYTES));
+				}
+				break;
+			}
+			lines.push(line);
+			bytes += extra;
+		}
+		return { offset: start, lines, total };
+	}
+
+	private lineAt(index: number): string {
+		if (index < 0 || index >= this.lineCount) return "";
+		if (index === this.completedLines) return this.incomplete;
+		const start = this.readOffset(index);
+		const end = index + 1 < this.completedLines ? this.readOffset(index + 1) : this.bytesWritten;
+		const length = Math.max(0, end - start);
+		if (length === 0) return "";
+		const buf = Buffer.alloc(length);
+		readSync(this.logFd, buf, 0, length, start);
+		let text = buf.toString("utf8");
+		if (text.endsWith("\n")) text = text.slice(0, -1);
+		if (text.endsWith("\r")) text = text.slice(0, -1);
+		return text;
+	}
+
+	private readOffset(index: number): number {
+		const buf = Buffer.alloc(8);
+		readSync(this.idxFd, buf, 0, 8, index * 8);
+		return Number(buf.readBigUInt64LE(0));
+	}
+}
+
+/** Open a log that is no longer being written, for paging historical output. */
+export function openLogForRead(logPath: string, idxPath: string): ProcessLog | null {
+	if (!existsSync(logPath)) return null;
+	if (!existsSync(idxPath)) {
+		writeIndexFromLog(logPath, idxPath);
+	}
+	return new ProcessLog(logPath, idxPath, undefined, true);
+}
+
+function writeIndexFromLog(logPath: string, idxPath: string): void {
+	const logFd = openSync(logPath, "r");
+	const idxFd = openSync(idxPath, "w");
+	try {
+		const buf = Buffer.alloc(64 * 1024);
+		const rec = Buffer.alloc(8);
+		let position = 0;
+		let lineStart = 0;
+		let hasContent = false;
+		while (true) {
+			const n = readSync(logFd, buf, 0, buf.length, position);
+			if (n === 0) break;
+			hasContent = true;
+			for (let i = 0; i < n; i++) {
+				if (buf[i] === 0x0a) {
+					rec.writeBigUInt64LE(BigInt(lineStart));
+					writeSync(idxFd, rec);
+					lineStart = position + i + 1;
+				}
+			}
+			position += n;
+		}
+		if (hasContent && lineStart < position) {
+			rec.writeBigUInt64LE(BigInt(lineStart));
+			writeSync(idxFd, rec);
+		}
+	} finally {
+		closeSync(logFd);
+		closeSync(idxFd);
+	}
+}
