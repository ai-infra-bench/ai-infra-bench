+		const running = [...this.processes.values()].filter((proc) => proc.record.state === "running");
+		await Promise.all(running.map((proc) => this.stopProcess(proc, 1)));
+		for (const proc of this.processes.values()) {
+			try {
+				proc.log.close();
+			} catch {
+				// already closed
+			}
+		}
+		this.processes.clear();
+		this.shuttingDown = false;
+	}
+
+	private allocatePaths(
+		sessionDir: string,
+		id: string,
+	): {
+		id: string;
+		dir: string;
+		logPath: string;
+		idxPath: string;
+		metaPath: string;
+	} {
+		const dir = storageDir(sessionDir);
+		return {
+			id,
+			dir,
+			logPath: join(dir, `${id}.log`),
+			idxPath: join(dir, `${id}.idx`),
+			metaPath: join(dir, `${id}.json`),
+		};
+	}
+
+	private createManaged(
+		child: ChildProcess,
+		pid: number,
+		options: StartOptions,
+		existing?: { log: ProcessLog; paths: ReturnType<BackgroundProcessManager["allocatePaths"]>; id: string },
+	): ManagedProcess {
+		const id = existing?.id ?? newId();
+		const paths = existing?.paths ?? this.allocatePaths(options.sessionDir, id);
+		mkdirSync(paths.dir, { recursive: true });
+		const log = existing?.log ?? new ProcessLog(paths.logPath, paths.idxPath);
+		const record: ProcessRecord = {
+			id,
+			name: options.name?.trim() || defaultName(options.command),
+			command: options.command,
+			cwd: options.cwd,
+			pid,
+			state: "running",
+			exitCode: null,
+			startedAt: nowIso(),
+			endedAt: null,
+			logLines: log.lineCount,
+			backgrounded: options.backgrounded === true,
+		};
+		const proc: ManagedProcess = {
+			record,
+			starterPid: process.pid,
+			sessionDir: options.sessionDir,
+			child,
+			log,
+			logPath: paths.logPath,
+			idxPath: paths.idxPath,
+			metaPath: paths.metaPath,
+			wake: {
+				ready: options.wake?.ready ? compilePattern(options.wake.ready, "ready") : null,
+				error: options.wake?.error ? compilePattern(options.wake.error, "error") : null,
+				exit: true,
+				output: options.outputWake === true,
+			},
+			cleanup:
+				options.cleanup?.command !== undefined
+					? {
+							command: options.cleanup.command,
+							timeoutSec:
+								options.cleanup.timeoutSec === undefined || !Number.isFinite(options.cleanup.timeoutSec)
+									? DEFAULT_CLEANUP_TIMEOUT_SEC
+									: Math.max(0, options.cleanup.timeoutSec),
+						}
+					: undefined,
+			readyFired: false,
+			outputFired: false,
+			exitFired: false,
+			errorInFlight: false,
+			pendingReasons: [],
+			pendingMatchedLine: null,
+			flushScheduled: false,
+			killed: false,
+			closed: false,
+			cleanupRan: false,
+			logClosed: false,
+		};
+		this.processes.set(id, proc);
+		return proc;
+	}
+
+	private bindChild(proc: ManagedProcess): void {
+		const child = proc.child;
+		if (!child) return;
+		const onData = (data: Buffer) => {
+			const lines = proc.log.appendBytes(data);
+			proc.record.logLines = proc.log.lineCount;
+			for (const line of lines) this.handleLine(proc, line);
+		};
+		child.stdout?.on("data", onData);
+		child.stderr?.on("data", onData);
+		const onExit = (code: number | null) => this.handleExit(proc, code);
+		child.once("exit", onExit);
+		child.once("error", () => {
+			if (proc.record.state === "running") {
+				this.handleExit(proc, proc.record.exitCode);
+			}
+		});
+		if (child.exitCode !== null || child.signalCode !== null) {
+			onExit(child.exitCode);
+		}
+	}
+
+	private handleLine(proc: ManagedProcess, line: string): void {
+		if (proc.closed || proc.record.state !== "running") return;
+		if (proc.wake.ready && !proc.readyFired && proc.wake.ready.test(line)) {
+			this.enqueueWake(proc, "ready", line);
+		}
+		if (proc.wake.error && !proc.errorInFlight && proc.wake.error.test(line)) {
+			this.enqueueWake(proc, "error", line);
+		}
+		if (proc.wake.output && !proc.outputFired) {
+			this.enqueueWake(proc, "output", line);
+		}
+	}
+
+	private handleExit(proc: ManagedProcess, code: number | null): void {
+		if (proc.record.state !== "running") return;
+		const remaining = proc.log.finish();
+		for (const line of remaining) this.handleLine(proc, line);
+		this.finalizeExit(proc, code);
+	}
+
+	private finalizeExit(proc: ManagedProcess, code: number | null): void {
+		if (proc.record.state !== "running") return;
+		proc.record.state = proc.killed ? "killed" : "exited";
+		proc.record.exitCode = code;
+		proc.record.endedAt = nowIso();
+		proc.record.logLines = proc.log.lineCount;
+		proc.log.close();
+		proc.logClosed = true;
+		this.persist(proc);
+		if (proc.wake.exit && !proc.exitFired) {
+			this.enqueueWake(proc, "exit", null);
+		}
+		proc.closed = true;
+	}
+
+	private enqueueWake(proc: ManagedProcess, reason: WakeReason, matchedLine: string | null): void {
+		if (this.shuttingDown) return;
+		if (proc.closed && reason !== "exit") return;
+		if (reason === "ready") {
+			if (proc.readyFired || !proc.wake.ready) return;
+			proc.readyFired = true;
+		}
+		if (reason === "output") {
+			if (proc.outputFired || !proc.wake.output) return;
+			proc.outputFired = true;
+		}
+		if (reason === "exit") {
+			if (proc.exitFired || !proc.wake.exit) return;
+			proc.exitFired = true;
+		}
+		if (reason === "error") {
+			if (proc.errorInFlight || !proc.wake.error) return;
+			proc.errorInFlight = true;
+		}
+		if (!proc.pendingReasons.includes(reason)) proc.pendingReasons.push(reason);
+		if (proc.pendingMatchedLine === null && matchedLine !== null) {
+			proc.pendingMatchedLine = matchedLine;
+		}
+		if (proc.flushScheduled) return;
+		proc.flushScheduled = true;
+		setImmediate(() => this.flushWake(proc));
+	}
+
+	private flushWake(proc: ManagedProcess): void {
+		proc.flushScheduled = false;
+		const reasons = proc.pendingReasons.splice(0, proc.pendingReasons.length);
+		const matchedLine = proc.pendingMatchedLine;
+		proc.pendingMatchedLine = null;
+		if (reasons.length === 0) return;
+		if (this.shuttingDown) return;
+		const details = {
+			id: proc.record.id,
+			name: proc.record.name,
+			reasons,
+			exitCode: proc.record.exitCode,
+			matchedLine,
+		};
+		try {
+			this.sendMessage?.(
+				{
+					customType: "background-process",
+					content: formatWakeContent(proc.record, reasons, matchedLine, proc.record.exitCode),
+					display: true,
+					details,
+				},
+				{ triggerTurn: true, deliverAs: "steer" },
+			);
+		} catch {
+			if (reasons.includes("error")) proc.errorInFlight = false;
+		}
+	}
+
+	private persist(proc: ManagedProcess): void {
+		const payload: PersistedRecord = {
+			...publicRecord(proc.record),
+			starterPid: proc.starterPid,
+		};
+		try {
+			mkdirSync(join(proc.sessionDir, STORAGE_DIRNAME, String(proc.starterPid)), { recursive: true });
+			writeFileSync(proc.metaPath, `${JSON.stringify(payload)}\n`);
+		} catch {
+			// session dir may be gone
+		}
+	}
+
+	private async stopProcess(proc: ManagedProcess, timeoutSec: number): Promise<void> {
+		const pid = proc.record.pid;
+		if (!pid) {
+			this.finalizeExit(proc, proc.record.exitCode);
+			return;
+		}
+		signalTree(pid, "SIGTERM");
+		const deadline = Date.now() + timeoutSec * 1000;
+		while (Date.now() < deadline) {
+			if (proc.record.state !== "running" && !isGroupAlive(pid)) return;
+			if (!isGroupAlive(pid) && proc.record.state !== "running") return;
+			if (!isGroupAlive(pid)) {
+				if (proc.record.state === "running") this.finalizeExit(proc, proc.record.exitCode);
+				return;
+			}
+			await sleep(50);
+		}
+		if (isGroupAlive(pid)) {
+			signalTree(pid, "SIGKILL");
+			const killDeadline = Date.now() + 1000;
+			while (Date.now() < killDeadline && isGroupAlive(pid)) {
+				await sleep(50);
+			}
+		}
+		if (proc.record.state === "running") {
+			this.finalizeExit(proc, proc.record.exitCode);
+		}
+	}
+
+	private async runCleanup(proc: ManagedProcess): Promise<CleanupResult> {
+		if (!proc.cleanup || proc.cleanupRan) {
+			return { ran: false, exitCode: null, failed: false };
+		}
+		proc.cleanupRan = true;
+		const timeoutMs = proc.cleanup.timeoutSec * 1000;
+		const child = spawnShell(proc.cleanup.command, proc.record.cwd);
+		let exitCode: number | null = null;
+		let timedOut = false;
+		let pid: number | undefined;
+		const log = this.reopenLog(proc);
+		proc.log = log;
+		proc.logClosed = false;
+		try {
+			pid = await waitForSpawn(child);
+		} catch {
+			log.appendText("[cleanup] failed to start\n");
+			proc.record.logLines = log.lineCount;
+			log.close();
+			proc.logClosed = true;
+			return { ran: true, exitCode: null, failed: true };
+		}
+		const onData = (data: Buffer) => {
+			log.appendBytes(data);
+			proc.record.logLines = log.lineCount;
+		};
+		child.stdout?.on("data", onData);
+		child.stderr?.on("data", onData);
+
+		const timeoutTimer = setTimeout(() => {
+			timedOut = true;
+			signalTree(pid!, "SIGKILL");
+		}, timeoutMs);
+
+		exitCode = await new Promise<number | null>((resolve) => {
+			child.once("close", (code) => resolve(code));
+			child.once("error", () => resolve(null));
+		});
+		clearTimeout(timeoutTimer);
+		log.finish();
+		proc.record.logLines = log.lineCount;
+		log.close();
+		proc.logClosed = true;
+		const failed = timedOut || exitCode === null || exitCode !== 0;
+		return { ran: true, exitCode, failed };
+	}
+
+	private reopenLog(proc: ManagedProcess): ProcessLog {
+		return new ProcessLog(proc.logPath, proc.idxPath);
+	}
+
+	private readDiskRecords(sessionDir: string): ProcessRecord[] {
+		const root = join(sessionDir, STORAGE_DIRNAME);
+		if (!existsSync(root)) return [];
+		const records: ProcessRecord[] = [];
+		let pidDirs: string[] = [];
+		try {
+			pidDirs = readdirSync(root);
+		} catch {
+			return [];
+		}
+		for (const pidDir of pidDirs) {
+			const dir = join(root, pidDir);
+			let files: string[] = [];
+			try {
+				files = readdirSync(dir);
+			} catch {
+				continue;
+			}
+			for (const file of files) {
+				if (!file.endsWith(".json")) continue;
+				const loaded = this.loadDiskRecord(join(dir, file), join(dir, `${file.slice(0, -5)}.idx`));
+				if (loaded) records.push(loaded);
+			}
+		}
+		return records;
+	}
+
+	private loadDiskRecord(metaPath: string, idxPath: string): ProcessRecord | undefined {
+		try {
+			const parsed = JSON.parse(readFileSync(metaPath, "utf8")) as PersistedRecord;
+			if (this.processes.has(parsed.id)) return undefined;
+			let logLines = parsed.logLines;
+			if (existsSync(idxPath)) {
+				try {
+					logLines = Math.floor(statSync(idxPath).size / 8);
+				} catch {
+					// keep persisted count
+				}
+			}
+			let state = parsed.state;
+			let endedAt = parsed.endedAt;
+			let exitCode = parsed.exitCode;
+			if (state === "running") {
+				state = "exited";
+				endedAt = endedAt ?? nowIso();
+				exitCode = exitCode ?? null;
+				try {
+					writeFileSync(metaPath, `${JSON.stringify({ ...parsed, state, endedAt, exitCode, logLines })}\n`);
+				} catch {
+					// ignore
+				}
+			}
+			return publicRecord({
+				id: parsed.id,
+				name: parsed.name,
+				command: parsed.command,
+				cwd: parsed.cwd,
+				pid: parsed.pid,
+				state,
+				exitCode,
+				startedAt: parsed.startedAt,
+				endedAt,
+				logLines,
+				backgrounded: parsed.backgrounded === true,
+			});
+		} catch {
+			return undefined;
+		}
+	}
+
+	private findDiskProcess(
+		id: string,
+		sessionDir: string,
+	): { record: ProcessRecord; logPath: string; idxPath: string } | undefined {
+		const root = join(sessionDir, STORAGE_DIRNAME);
+		if (!existsSync(root)) return undefined;
+		let pidDirs: string[] = [];
+		try {
+			pidDirs = readdirSync(root);
+		} catch {
+			return undefined;
+		}
+		for (const pidDir of pidDirs) {
+			const metaPath = join(root, pidDir, `${id}.json`);
+			if (!existsSync(metaPath)) continue;
+			const idxPath = join(root, pidDir, `${id}.idx`);
+			const logPath = join(root, pidDir, `${id}.log`);
+			const record = this.loadDiskRecord(metaPath, idxPath);
+			if (!record) continue;
+			return { record, logPath, idxPath };
+		}
+		return undefined;
+	}
+}
+
+function globalSlot(): Record<PropertyKey, BackgroundProcessManager | undefined> {
+	return globalThis as unknown as Record<PropertyKey, BackgroundProcessManager | undefined>;
+}
+
+export function getBackgroundProcessManager(): BackgroundProcessManager {
+	const g = globalSlot();
+	let manager = g[GLOBAL_KEY];
+	if (!manager) {
+		manager = new BackgroundProcessManager();
+		manager.installLifecycleHooks();
+		g[GLOBAL_KEY] = manager;
+	}
+	return manager;
+}
+
+export async function resetBackgroundProcessManagerForTests(): Promise<void> {
+	const g = globalSlot();
+	const existing = g[GLOBAL_KEY];
+	if (existing) {
+		await existing.stopAllForTests();
+		existing.uninstallLifecycleHooks();
+		g[GLOBAL_KEY] = undefined;
+	}
+}
+
+export function formatBashOutput(output: string, emptyText = "(no output)"): string {
+	const truncated = truncateTail(output, { maxLines: DEFAULT_MAX_LINES, maxBytes: DEFAULT_MAX_BYTES });
+	if (!truncated.content) return emptyText;
+	return truncated.content;
+}
