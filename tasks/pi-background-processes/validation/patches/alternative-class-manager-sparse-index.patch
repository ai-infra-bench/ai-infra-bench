+++ b/packages/coding-agent/examples/extensions/background-processes/index.ts
@@ -0,0 +1,257 @@
+/**
+ * Background process extension.
+ *
+ * Long-lived commands (dev servers, test watchers, local APIs) run in their own
+ * process group, do not inherit pi's stdio, and can wake the agent when they
+ * become ready, error, print after auto-background, or exit.
+ *
+ * Usage:
+ *   pi -e packages/coding-agent/examples/extensions/background-processes
+ */
+
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import {
+	formatBashOutput,
+	getBackgroundProcessManager,
+	type ProcessRecord,
+	resetBackgroundProcessManagerForTests,
+} from "./process-manager.ts";
+
+export { resetBackgroundProcessManagerForTests };
+
+const DEFAULT_STALLED_SEC = 30;
+
+const wakeSchema = Type.Object({
+	ready: Type.Optional(Type.String({ description: "Regex matched against each output line to wake on ready" })),
+	error: Type.Optional(Type.String({ description: "Regex matched against each output line to wake on error" })),
+});
+
+const cleanupSchema = Type.Object({
+	command: Type.String({ description: "Command to run after the process group is gone" }),
+	timeoutSec: Type.Optional(Type.Number({ description: "Cleanup timeout in seconds (default 30)" })),
+});
+
+const bgRunSchema = Type.Object({
+	command: Type.String({ description: "Shell command to start in the background" }),
+	cwd: Type.Optional(Type.String({ description: "Working directory (defaults to the session cwd)" })),
+	name: Type.Optional(Type.String({ description: "Short name for the process" })),
+	wake: Type.Optional(wakeSchema),
+	cleanup: Type.Optional(cleanupSchema),
+});
+
+const bgLogsSchema = Type.Object({
+	id: Type.String({ description: "Process id returned by bg_run or bash" }),
+	offset: Type.Optional(Type.Number({ description: "Line offset to start from (0-based)" })),
+	limit: Type.Optional(Type.Number({ description: "Maximum number of lines to return" })),
+});
+
+const bgListSchema = Type.Object({});
+
+const bgKillSchema = Type.Object({
+	id: Type.String({ description: "Process id to stop" }),
+	timeoutSec: Type.Optional(Type.Number({ description: "Seconds to wait after SIGTERM before SIGKILL (default 5)" })),
+});
+
+const bgWatchSchema = Type.Object({
+	id: Type.String({ description: "Process id to update" }),
+	ready: Type.Optional(
+		Type.Union([Type.String(), Type.Null()], {
+			description: "New ready regex, or null to remove it",
+		}),
+	),
+	error: Type.Optional(
+		Type.Union([Type.String(), Type.Null()], {
+			description: "New error regex, or null to remove it",
+		}),
+	),
+	exit: Type.Optional(Type.Boolean({ description: "Set false to silence the exit wake" })),
+	output: Type.Optional(Type.Boolean({ description: "Set false to silence the auto-background output wake" })),
+});
+
+const bashSchema = Type.Object({
+	command: Type.String({ description: "Shell command to execute" }),
+	timeout: Type.Optional(Type.Number({ description: "Timeout in seconds (optional, no default timeout)" })),
+	stalledSec: Type.Optional(
+		Type.Number({
+			description:
+				"Seconds of silence while still running before the command is moved to the background (default 30)",
+		}),
+	),
+});
+
+function jsonResult<T extends object>(payload: T) {
+	return {
+		content: [{ type: "text" as const, text: JSON.stringify(payload, null, 2) }],
+		details: payload,
+	};
+}
+
+function resolveCwd(ctx: ExtensionContext, cwd: string | undefined): string {
+	const resolved = cwd ? resolve(ctx.cwd, cwd) : ctx.cwd;
+	if (!existsSync(resolved)) {
+		throw new Error(`Working directory does not exist: ${resolved}`);
+	}
+	return resolved;
+}
+
+function sessionDirOf(ctx: ExtensionContext): string {
+	return ctx.sessionManager.getSessionDir();
+}
+
+function appendStatus(text: string, status: string): string {
+	return text ? `${text}\n\n${status}` : status;
+}
+
+export default function (pi: ExtensionAPI) {
+	const manager = getBackgroundProcessManager();
+	manager.attach(pi);
+
+	pi.on("session_start", (_event, ctx) => {
+		manager.setActiveSessionDir(ctx.sessionManager.getSessionDir());
+	});
+
+	pi.on("agent_settled", () => {
+		manager.beginNewDeliveryWindow();
+	});
+
+	pi.on("session_shutdown", (event) => {
+		if (event.reason === "quit") {
+			manager.stopAllSync();
+		}
+	});
+
+	pi.registerTool({
+		name: "bg_run",
+		label: "bg_run",
+		description:
+			"Start a long-lived command in the background in its own process group. Returns immediately with the process record. Use wake.ready / wake.error regexes to be notified when output matches; process exit always wakes unless silenced with bg_watch.",
+		parameters: bgRunSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			const cwd = resolveCwd(ctx, params.cwd);
+			const record = await manager.start({
+				command: params.command,
+				cwd,
+				sessionDir: sessionDirOf(ctx),
+				name: params.name,
+				wake: params.wake,
+				cleanup: params.cleanup,
+			});
+			return jsonResult(record);
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_logs",
+		label: "bg_logs",
+		description:
+			"Read a page of combined stdout/stderr lines for a background process. A page never exceeds 64KB. Omit limit to get the newest lines that fit.",
+		parameters: bgLogsSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			const page = manager.logs(params.id, sessionDirOf(ctx), params.offset, params.limit);
+			return jsonResult(page);
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_list",
+		label: "bg_list",
+		description: "List every background process visible to this session, running and finished.",
+		parameters: bgListSchema,
+		async execute(_toolCallId, _params, _signal, _onUpdate, ctx) {
+			return jsonResult({ processes: manager.list(sessionDirOf(ctx)) });
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_kill",
+		label: "bg_kill",
+		description:
+			"Stop a background process group with SIGTERM, then SIGKILL after timeoutSec (default 5). Runs the configured cleanup command after the group is gone.",
+		parameters: bgKillSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			const result = await manager.kill(params.id, sessionDirOf(ctx), params.timeoutSec);
+			return jsonResult({ ...result.record, cleanup: result.cleanup });
+		},
+	});
+
+	pi.registerTool({
+		name: "bg_watch",
+		label: "bg_watch",
+		description:
+			"Change wake rules of a running process. Pass null to remove a ready/error pattern. exit: false silences the exit wake. output: false silences the auto-background output wake.",
+		parameters: bgWatchSchema,
+		async execute(_toolCallId, params, _signal, _onUpdate, _ctx) {
+			const record = manager.watch(params.id, {
+				ready: params.ready,
+				error: params.error,
+				exit: params.exit,
+				output: params.output,
+			});
+			return jsonResult(record);
+		},
+	});
+
+	pi.registerTool({
+		name: "bash",
+		label: "bash",
+		description:
+			"Execute a bash command in the current working directory. Returns stdout and stderr, truncated to the last 2000 lines or 50KB. If the command stays silent for stalledSec seconds (default 30) while still running, it is moved to a managed background process and this tool returns that process record with backgrounded: true.",
+		parameters: bashSchema,
+		promptSnippet: "Execute bash commands (ls, grep, find, etc.)",
+		promptGuidelines: [
+			"You can inspect PI_* environment variables for current model and session details.",
+			"Long-lived commands that go silent (dev servers, watchers) are moved to the background automatically; use bg_logs, bg_list, and bg_kill to manage them.",
+		],
+		async execute(_toolCallId, params, signal, onUpdate, ctx) {
+			const stalledSec =
+				params.stalledSec === undefined || !Number.isFinite(params.stalledSec)
+					? DEFAULT_STALLED_SEC
+					: Math.max(0, params.stalledSec);
+			const timeout =
+				params.timeout === undefined || !Number.isFinite(params.timeout) || params.timeout <= 0
+					? undefined
+					: params.timeout;
+
+			const result = await manager.runBash({
+				command: params.command,
+				cwd: ctx.cwd,
+				sessionDir: sessionDirOf(ctx),
+				timeout,
+				stalledSec,
+				signal,
+				onUpdate: (text) => {
+					onUpdate?.({
+						content: [{ type: "text", text: formatBashOutput(text, "") }],
+						details: undefined,
+					});
+				},
+			});
+
+			if (result.backgrounded) {
+				const payload: ProcessRecord & { backgrounded: true; stalledSec: number } = {
+					...result.record,
+					backgrounded: true,
+					stalledSec: result.stalledSec,
+				};
+				return jsonResult(payload);
+			}
+
+			if (result.aborted) {
+				throw new Error(appendStatus(formatBashOutput(result.output, ""), "Command aborted"));
+			}
+			if (result.timedOut) {
+				throw new Error(
+					appendStatus(formatBashOutput(result.output, ""), `Command timed out after ${params.timeout} seconds`),
+				);
+			}
+			const outputText = formatBashOutput(result.output);
+			if (result.exitCode !== 0 && result.exitCode !== null) {
+				throw new Error(appendStatus(outputText, `Command exited with code ${result.exitCode}`));
+			}
+			return { content: [{ type: "text", text: outputText }], details: undefined };
+		},
+	});
+}
diff --git a/packages/coding-agent/examples/extensions/background-processes/log.ts b/packages/coding-agent/examples/extensions/background-processes/log.ts
