+		}
+	}
+
+	private checkpointAtOrBefore(line: number): Checkpoint {
+		let found = this.checkpoints[0];
+		for (const checkpoint of this.checkpoints) {
+			if (checkpoint.line > line) break;
+			found = checkpoint;
+		}
+		return found;
+	}
+
+	private async readForward(startLine: number, limit: number | undefined, total: number): Promise<LogPage> {
+		const start = this.checkpointAtOrBefore(startLine);
+		const end = this.lineStartByte;
+		const lines: string[] = [];
+		let bytes = 0;
+		let handle: Awaited<ReturnType<typeof open>> | undefined;
+		try {
+			handle = await open(this.path, "r");
+		} catch {
+			return { offset: startLine, lines, total };
+		}
+		try {
+			const buffer = Buffer.allocUnsafe(READ_CHUNK_BYTES);
+			let position = start.byte;
+			let line = start.line;
+			let leftover = Buffer.alloc(0);
+			let done = false;
+			while (!done && position < end) {
+				const want = Math.min(READ_CHUNK_BYTES, end - position);
+				const { bytesRead } = await handle.read(buffer, 0, want, position);
+				if (bytesRead === 0) break;
+				position += bytesRead;
+				const chunk =
+					leftover.length > 0
+						? Buffer.concat([leftover, buffer.subarray(0, bytesRead)])
+						: Buffer.from(buffer.subarray(0, bytesRead));
+				let from = 0;
+				for (;;) {
+					const nl = chunk.indexOf(NEWLINE, from);
+					if (nl === -1) break;
+					if (line >= startLine) {
+						const text = sanitizeLogLine(chunk.subarray(from, Math.min(nl, from + MAX_PAGE_BYTES)).toString());
+						const size = Buffer.byteLength(text) + 1;
+						if (lines.length > 0 && bytes + size > MAX_PAGE_BYTES) {
+							done = true;
+							break;
+						}
+						lines.push(text);
+						bytes += size;
+						line++;
+						from = nl + 1;
+						if (limit !== undefined && lines.length >= limit) {
+							done = true;
+							break;
+						}
+						continue;
+					}
+					line++;
+					from = nl + 1;
+				}
+				leftover = done ? Buffer.alloc(0) : Buffer.from(chunk.subarray(from));
+			}
+		} finally {
+			await handle.close();
+		}
+		return { offset: startLine, lines, total };
+	}
+
+	private async readTail(limit: number | undefined, total: number): Promise<LogPage> {
+		const end = this.lineStartByte;
+		const windowStart = Math.max(0, end - MAX_PAGE_BYTES);
+		let window = Buffer.alloc(0);
+		let handle: Awaited<ReturnType<typeof open>> | undefined;
+		try {
+			handle = await open(this.path, "r");
+		} catch {
+			return { offset: total, lines: [], total };
+		}
+		try {
+			const length = end - windowStart;
+			const buffer = Buffer.allocUnsafe(length);
+			const { bytesRead } = await handle.read(buffer, 0, length, windowStart);
+			window = buffer.subarray(0, bytesRead);
+		} finally {
+			await handle.close();
+		}
+
+		let from = 0;
+		if (windowStart > 0) {
+			const nl = window.indexOf(NEWLINE);
+			// The window starts mid-line: the last line alone is larger than a page.
+			if (nl === -1) return await this.readForward(total - 1, 1, total);
+			from = nl + 1;
+		}
+		const lines: string[] = [];
+		for (;;) {
+			const nl = window.indexOf(NEWLINE, from);
+			if (nl === -1) break;
+			lines.push(sanitizeLogLine(window.subarray(from, nl).toString()));
+			from = nl + 1;
+		}
+		if (lines.length === 0) return await this.readForward(total - 1, 1, total);
+
+		const selected = limit !== undefined ? lines.slice(Math.max(0, lines.length - limit)) : lines;
+		let bytes = 0;
+		for (const line of selected) bytes += Buffer.byteLength(line) + 1;
+		while (selected.length > 1 && bytes > MAX_PAGE_BYTES) {
+			bytes -= Buffer.byteLength(selected[0]) + 1;
+			selected.shift();
+		}
+		return { offset: total - selected.length, lines: selected, total };
+	}
+}
