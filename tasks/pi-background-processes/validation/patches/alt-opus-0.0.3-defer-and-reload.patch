@@ -0,0 +1,159 @@
+/**
+ * The `bg_*` tools. Every tool returns a JSON object as its result text and
+ * attaches the same object as `details`.
+ */
+
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import type { ExtensionContext, ToolDefinition } from "@earendil-works/pi-coding-agent";
+import { type Static, Type } from "typebox";
+import { type BackgroundProcessManager, compilePattern, DEFAULT_KILL_TIMEOUT_SEC } from "./manager.ts";
+
+export function jsonResult<T>(value: T): { content: [{ type: "text"; text: string }]; details: T } {
+	return { content: [{ type: "text", text: JSON.stringify(value, null, 2) }], details: value };
+}
+
+const runSchema = Type.Object({
+	command: Type.String({ description: "Shell command to start in the background" }),
+	cwd: Type.Optional(Type.String({ description: "Working directory, relative to the session cwd or absolute" })),
+	name: Type.Optional(Type.String({ description: "Short label for the process (defaults to the command)" })),
+	wake: Type.Optional(
+		Type.Object({
+			ready: Type.Optional(
+				Type.String({ description: "Regular expression; the first matching output line wakes the agent once" }),
+			),
+			error: Type.Optional(
+				Type.String({ description: "Regular expression; a matching output line wakes the agent" }),
+			),
+		}),
+	),
+	cleanup: Type.Optional(
+		Type.Object({
+			command: Type.String({ description: "Command run after the process tree is stopped by bg_kill" }),
+			timeoutSec: Type.Optional(Type.Number({ description: "Cleanup timeout in seconds (default 30)" })),
+		}),
+	),
+});
+
+const logsSchema = Type.Object({
+	id: Type.String({ description: "Process id returned by bg_run, bg_list or bash" }),
+	offset: Type.Optional(Type.Number({ description: "First line to return; omit for the newest lines" })),
+	limit: Type.Optional(Type.Number({ description: "Maximum number of lines to return" })),
+});
+
+const listSchema = Type.Object({});
+
+const killSchema = Type.Object({
+	id: Type.String({ description: "Process id to stop" }),
+	timeoutSec: Type.Optional(Type.Number({ description: "Seconds to wait after SIGTERM before SIGKILL (default 5)" })),
+});
+
+const watchSchema = Type.Object({
+	id: Type.String({ description: "Process id to reconfigure" }),
+	ready: Type.Optional(
+		Type.Union([Type.String(), Type.Null()], { description: "New ready pattern, or null to remove it" }),
+	),
+	error: Type.Optional(
+		Type.Union([Type.String(), Type.Null()], { description: "New error pattern, or null to remove it" }),
+	),
+	exit: Type.Optional(Type.Boolean({ description: "Set false to stop waking the agent when the process exits" })),
+	output: Type.Optional(Type.Boolean({ description: "Set false to silence the first-output wake" })),
+});
+
+function resolveCwd(ctx: ExtensionContext, cwd: string | undefined): string {
+	const resolved = cwd ? resolve(ctx.cwd, cwd) : ctx.cwd;
+	if (!existsSync(resolved)) throw new Error(`Working directory does not exist: ${resolved}`);
+	return resolved;
+}
+
+export function createBackgroundTools(manager: BackgroundProcessManager): ToolDefinition<any, any, any>[] {
+	return [
+		{
+			name: "bg_run",
+			label: "bg run",
+			description:
+				"Start a long-running command in the background and return immediately with its process record. " +
+				"The process outlives the tool call and keeps running until bg_kill or pi exits. " +
+				"Use wake.ready/wake.error to be woken by a matching output line; the agent is always woken when the process exits.",
+			promptSnippet: "Start long-running commands (dev servers, watchers, builds) in the background",
+			promptGuidelines: [
+				"Use bg_run for commands that are meant to keep running (dev servers, watchers, tailing logs) instead of bash.",
+				"Use bg_logs to read background output, bg_list to see processes, and bg_kill to stop them when done.",
+			],
+			parameters: runSchema,
+			async execute(
+				_toolCallId: string,
+				params: Static<typeof runSchema>,
+				_signal: unknown,
+				_onUpdate: unknown,
+				ctx: ExtensionContext,
+			) {
+				const record = manager.start({
+					command: params.command,
+					cwd: resolveCwd(ctx, params.cwd),
+					name: params.name,
+					wake: {
+						ready: params.wake?.ready === undefined ? undefined : compilePattern(params.wake.ready, "wake.ready"),
+						error: params.wake?.error === undefined ? undefined : compilePattern(params.wake.error, "wake.error"),
+					},
+					cleanup: params.cleanup,
+				});
+				return jsonResult(record);
+			},
+		},
+		{
+			name: "bg_logs",
+			label: "bg logs",
+			description:
+				"Read a page of a background process's combined stdout/stderr. Returns { id, offset, lines, total }. " +
+				"A page never exceeds 64KB; without offset the newest lines are returned.",
+			promptSnippet: "Page through the output of a background process",
+			parameters: logsSchema,
+			async execute(_toolCallId: string, params: Static<typeof logsSchema>) {
+				const page = await manager.logs(params.id, params.offset, params.limit);
+				return jsonResult({ id: params.id, offset: page.offset, lines: page.lines, total: page.total });
+			},
+		},
+		{
+			name: "bg_list",
+			label: "bg list",
+			description: "List every background process of this pi instance, running and finished.",
+			promptSnippet: "List background processes and their state",
+			parameters: listSchema,
+			async execute() {
+				return jsonResult({ processes: manager.list() });
+			},
+		},
+		{
+			name: "bg_kill",
+			label: "bg kill",
+			description:
+				"Stop a background process and all of its descendants (SIGTERM, then SIGKILL after timeoutSec). " +
+				"Runs the cleanup command if one was configured and reports whether it failed.",
+			promptSnippet: "Stop a background process and its descendants",
+			parameters: killSchema,
+			async execute(_toolCallId: string, params: Static<typeof killSchema>) {
+				const result = await manager.kill(params.id, params.timeoutSec ?? DEFAULT_KILL_TIMEOUT_SEC);
+				return jsonResult({ ...result.record, cleanup: result.cleanup });
+			},
+		},
+		{
+			name: "bg_watch",
+			label: "bg watch",
+			description:
+				"Change the wake rules of a running background process. Pass null for ready/error to remove a pattern, " +
+				"exit:false to stop being woken on exit, output:false to silence the first-output wake.",
+			promptSnippet: "Change when a background process wakes the agent",
+			parameters: watchSchema,
+			async execute(_toolCallId: string, params: Static<typeof watchSchema>) {
+				const record = manager.watch(params.id, {
+					ready: params.ready,
+					error: params.error,
+					exit: params.exit,
+					output: params.output,
+				});
+				return jsonResult(record);
+			},
+		},
+	];
+}
