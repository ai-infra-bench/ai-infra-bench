diff --git a/packages/coding-agent/examples/extensions/background-processes/README.md b/packages/coding-agent/examples/extensions/background-processes/README.md
new file mode 100644
index 000000000..ec3e6fa64
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/README.md
@@ -0,0 +1,165 @@
+# Background Processes Extension
+
+Long-running commands (dev servers, watchers, slow builds) without blocking the session, plus a
+`bash` tool that stops hanging on a command that went quiet. A background process can wake the
+agent instead of the agent polling it.
+
+```bash
+pi -e ./packages/coding-agent/examples/extensions/background-processes/index.ts
+```
+
+Or copy the directory to `~/.pi/agent/extensions/background-processes/`.
+
+## Tools
+
+Every tool returns a JSON object as its result text and attaches the same object as the tool result
+`details`. The only exception is `bash` on its normal path, which returns exactly what the built-in
+`bash` tool returns.
+
+### `bg_run`
+
+```jsonc
+{
+  "command": "npm run dev",
+  "cwd": "packages/web",                 // optional, relative to the session cwd
+  "name": "web",                         // optional label, defaults to the command
+  "wake": { "ready": "Listening on", "error": "ERROR|FATAL" },  // optional regexes
+  "cleanup": { "command": "docker compose down", "timeoutSec": 30 }  // optional
+}
+```
+
+Starts `command` through the configured shell and returns the process record immediately. The
+command and everything it spawns form one process group that can later be stopped as a unit.
+`wake.ready` and `wake.error` are regular expressions matched against each complete output line.
+
+### `bg_logs`
+
+```jsonc
+{ "id": "bg-1a2b3c4d", "offset": 0, "limit": 100 }
+```
+
+Returns `{ id, offset, lines, total }`: a page of the combined stdout/stderr lines in order, the
+line offset actually served, and the total number of lines so far. A page never exceeds 64KB of
+text. Omit `offset` to get the newest lines that fit (the newest `limit` lines when `limit` is
+given). A single line longer than 64KB is truncated to 64KB.
+
+### `bg_list`
+
+`{}` → `{ processes }`, every process visible to this session: everything started in this pi
+process, running and finished, plus the finished records this session left behind in an earlier pi
+process.
+
+### `bg_kill`
+
+```jsonc
+{ "id": "bg-1a2b3c4d", "timeoutSec": 5 }
+```
+
+Sends `SIGTERM` to the process group, then `SIGKILL` to whatever is still alive after `timeoutSec`
+(default 5). If the process was started with `cleanup`, the cleanup command runs once nothing of the
+process tree is left, in the same working directory, bounded by `cleanup.timeoutSec` (default 30);
+its output is appended to the same log. Returns the final record plus
+`cleanup: { ran, exitCode, failed } | null`. A cleanup that fails or times out is reported with
+`failed: true`.
+
+### `bg_watch`
+
+```jsonc
+{ "id": "bg-1a2b3c4d", "ready": "Compiled", "error": null, "exit": false, "output": false }
+```
+
+Changes the wake rules of a running process and returns its record. `null` removes a pattern,
+`exit: false` silences the exit wake, `output: false` silences the first-output wake of an
+auto-backgrounded command. Setting a new `ready` pattern re-arms the ready wake, so a process that
+already reported ready can report it again after a restart of whatever it is watching.
+
+### `bash`
+
+```jsonc
+{ "command": "npm run dev", "timeout": 120, "stalledSec": 30 }
+```
+
+The command runs in the foreground exactly as the built-in tool runs it, until one of two things
+happens first:
+
+- **It finishes** (exits, hits `timeout`, or is aborted) before going silent for `stalledSec`
+  seconds (default 30). The result is byte-for-byte what the built-in tool would have returned:
+  same text, same truncation, same error texts for a non-zero exit, a timeout and an abort. A
+  `timeout` shorter than `stalledSec` therefore wins. No process record is created and nothing
+  wakes the agent.
+- **It goes silent** for `stalledSec` seconds while still running. It becomes a managed background
+  process and the tool returns the process record as JSON with `backgrounded: true` and the
+  `stalledSec` that applied. Everything the command printed before the switch is the head of its
+  log. From then on it behaves exactly like a process started with `bg_run`.
+
+## Process record
+
+```jsonc
+{
+  "id": "bg-1a2b3c4d",
+  "name": "web",
+  "command": "npm run dev",
+  "cwd": "/abs/path",                      // resolved absolute path
+  "pid": 12345,
+  "state": "running",                      // running | exited | killed
+  "exitCode": null,
+  "startedAt": "2026-09-16T10:00:00.000Z",
+  "endedAt": null,                         // null while running
+  "logLines": 42,
+  "backgrounded": false,                   // true only for a command bash moved to the background
+  "sessionId": "...",
+  "logFile": "/abs/path/to/bg-1a2b3c4d.log"
+}
+```
+
+## Wake rules
+
+A wake is a custom message with `customType: "background-process"` whose `details` are
+`{ id, name, reasons, exitCode, matchedLine }`. `reasons` is a non-empty subset of `"ready"`,
+`"error"`, `"output"`, `"exit"`; `matchedLine` is the first output line that triggered the wake, or
+`null`.
+
+- By default only process exit wakes the agent. `ready` and `error` wake only when the
+  corresponding pattern was supplied. `output` applies only to a command `bash` moved to the
+  background: the first complete line printed after the switch wakes the agent.
+- `ready` and `output` wake at most once per process. `error` wakes at most once per delivery
+  window. `exit` wakes exactly once, when the process leaves the `running` state, whether it exited
+  on its own or was killed — `bg_kill` does not suppress it. Nothing wakes the agent for a process
+  after its exit wake was delivered, or for a reason `bg_watch` silenced.
+- While the agent is busy the wake is delivered after the current assistant turn finished executing
+  its tool calls and before the next model request (`deliverAs: "steer"`). While the agent is idle
+  it starts a new turn (`triggerTurn: true`).
+- Reasons that fire for the same process inside one delivery window are combined into a single
+  message that lists each reason once. Several processes firing in the same window are reported in
+  the order in which each process first fired.
+- Wakes go to the active session of this pi process. If no session is attached (during `/reload` or
+  a session switch) they are queued and delivered to the next session that starts.
+
+## Lifecycle
+
+- Processes belong to the running pi process, not to a session. `/reload`, `/new`, `/fork` and tree
+  navigation leave them running, and any session in the same pi process can list, read and kill
+  them. The manager lives on `globalThis`, which is what makes it survive `/reload` re-running the
+  extension factory.
+- When pi exits, normally or on a signal, every managed process is stopped with the same
+  `SIGTERM`-then-`SIGKILL` sequence, including children the command spawned itself. The graceful
+  path runs from `session_shutdown` and is bounded (2s before `SIGKILL`, then 3s for cleanup
+  commands) so stopping processes never keeps pi alive; a `process.on("exit")` hook `SIGKILL`s
+  anything left. A signal pi does not handle itself is re-raised after the stop, so pi still dies
+  from the signal.
+- Logs and records are written to `<session dir>/background-processes/<session id>/<id>.{log,json}`.
+  A later pi process that resumes the same session can `bg_list` the finished records and
+  `bg_logs` their output. A record left behind as `running` by a hard exit is reported as `killed`
+  with `exitCode: null`.
+- Output streams straight to disk and only a sparse line index (one entry per 512 lines) is kept in
+  memory, so a process that prints hundreds of megabytes does not grow pi's heap while `bg_logs`
+  can still page through all of it. Writes apply backpressure to the child.
+
+## Known limitations
+
+- The cleanup command runs when the manager stops a process (`bg_kill` or pi's exit), not when a
+  process exits on its own.
+- The `shellPath` setting is not visible to extensions, so the shell is resolved with the default
+  `getShellConfig()` lookup.
+- On Windows a process group cannot be signalled the way it can on POSIX: `SIGTERM` goes to the
+  shell process only and the `SIGKILL` step uses `taskkill /F /T`.
diff --git a/packages/coding-agent/examples/extensions/background-processes/bash-tool.ts b/packages/coding-agent/examples/extensions/background-processes/bash-tool.ts
new file mode 100644
index 000000000..a6514d127
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/bash-tool.ts
@@ -0,0 +1,89 @@
+/**
+ * The `bash` override.
+ *
+ * Execution is delegated to the built-in bash tool through custom
+ * `BashOperations`, so a command that finishes normally produces exactly the
+ * built-in result text, truncation and error texts. The only difference is what
+ * happens when a command goes quiet: after `stalledSec` seconds without output
+ * it is handed to the process manager and the tool returns the process record.
+ */
+
+import type {
+	BashOperations,
+	createBashToolDefinition,
+	ExtensionContext,
+	ToolDefinition,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import type { BackgroundProcessManager } from "./manager.ts";
+import { jsonResult } from "./tools.ts";
+import { BackgroundedError } from "./types.ts";
+
+export const DEFAULT_STALLED_SEC = 30;
+
+const bashSchema = Type.Object({
+	command: Type.String({ description: "Shell command to execute" }),
+	timeout: Type.Optional(Type.Number({ description: "Timeout in seconds (optional, no default timeout)" })),
+	stalledSec: Type.Optional(
+		Type.Number({
+			description: `Seconds without output after which the command is moved to the background (default ${DEFAULT_STALLED_SEC})`,
+		}),
+	),
+});
+
+export function createBashToolOverride(options: {
+	manager: BackgroundProcessManager;
+	createDefinition: typeof createBashToolDefinition;
+}): ToolDefinition<typeof bashSchema, any, any> {
+	const { manager, createDefinition } = options;
+	// Built for its renderers and prompt metadata; execution uses a per-call definition.
+	const base = createDefinition(process.cwd());
+
+	return {
+		...base,
+		name: "bash",
+		label: base.label,
+		description:
+			`${base.description} ` +
+			`A command that produces no output for stalledSec seconds (default ${DEFAULT_STALLED_SEC}) keeps running as a ` +
+			"background process instead of blocking: the result is then the process record, and bg_logs, bg_kill and " +
+			"bg_watch take over. The agent is woken when such a process prints its next line and when it exits.",
+		parameters: bashSchema,
+		async execute(
+			toolCallId: string,
+			params: { command: string; timeout?: number; stalledSec?: number },
+			signal: AbortSignal | undefined,
+			onUpdate: Parameters<ToolDefinition<typeof bashSchema, any, any>["execute"]>[3],
+			ctx: ExtensionContext,
+		) {
+			const stalledSec = params.stalledSec ?? DEFAULT_STALLED_SEC;
+			const operations: BashOperations = {
+				exec: (command, cwd, execOptions) =>
+					manager.runForeground({
+						command,
+						cwd,
+						env: execOptions.env ?? process.env,
+						stalledSec,
+						timeout: execOptions.timeout,
+						signal: execOptions.signal,
+						onData: execOptions.onData,
+					}),
+			};
+			const definition = createDefinition(ctx.cwd, { operations });
+			try {
+				return await definition.execute(
+					toolCallId,
+					{ command: params.command, timeout: params.timeout },
+					signal,
+					onUpdate,
+					ctx,
+				);
+			} catch (error) {
+				if (error instanceof BackgroundedError) {
+					return jsonResult({ ...error.record, stalledSec: error.stalledSec });
+				}
+				throw error;
+			}
+		},
+	};
+}
diff --git a/packages/coding-agent/examples/extensions/background-processes/index.ts b/packages/coding-agent/examples/extensions/background-processes/index.ts
new file mode 100644
index 000000000..726d56f74
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/index.ts
@@ -0,0 +1,114 @@
+/**
+ * Background Processes Extension
+ *
+ * Adds `bg_run`, `bg_logs`, `bg_list`, `bg_kill` and `bg_watch`, and replaces
+ * `bash` with a version that moves a silent command to the background instead
+ * of blocking the session. A background process can wake the agent when it
+ * becomes ready, prints an error, prints its first line, or exits.
+ *
+ * Processes belong to the pi process, not to a session: /reload, /new, /fork
+ * and tree navigation leave them running, and any session can list, read and
+ * kill them. When pi exits, every managed process is stopped.
+ *
+ * Usage:
+ *   pi -e ./background-processes/index.ts
+ */
+
+import { mkdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	createBashToolDefinition,
+	type ExtensionAPI,
+	type ExtensionContext,
+	getShellConfig,
+} from "@earendil-works/pi-coding-agent";
+import { createBashToolOverride } from "./bash-tool.ts";
+import { BackgroundProcessManager } from "./manager.ts";
+import { createBackgroundTools } from "./tools.ts";
+
+const SLOT_KEY: unique symbol = Symbol.for("pi.examples.background-processes");
+
+interface GlobalSlot {
+	manager?: BackgroundProcessManager;
+	hooked?: boolean;
+}
+
+/**
+ * The manager lives on globalThis so that /reload, which re-runs this factory,
+ * keeps managing the processes started before the reload.
+ */
+function getSlot(): GlobalSlot {
+	const holder = globalThis as typeof globalThis & { [SLOT_KEY]?: GlobalSlot };
+	const existing = holder[SLOT_KEY];
+	if (existing) return existing;
+	const slot: GlobalSlot = {};
+	holder[SLOT_KEY] = slot;
+	return slot;
+}
+
+/** Per-session storage for logs and records, so a resumed session can read them back. */
+function resolveStorageDir(ctx: ExtensionContext): string {
+	const sessionId = ctx.sessionManager.getSessionId();
+	try {
+		const dir = join(ctx.sessionManager.getSessionDir(), "background-processes", sessionId);
+		mkdirSync(dir, { recursive: true });
+		return dir;
+	} catch {
+		const fallback = join(tmpdir(), "pi-background-processes", sessionId);
+		mkdirSync(fallback, { recursive: true });
+		return fallback;
+	}
+}
+
+/**
+ * Guarantee that no managed process outlives pi.
+ *
+ * pi drives the graceful path through `session_shutdown`. These hooks cover the
+ * rest: a signal pi does not handle itself (re-raised after stopping, so pi
+ * still dies from the signal) and any other exit (synchronous SIGKILL).
+ */
+function installProcessHooks(manager: BackgroundProcessManager): void {
+	const slot = getSlot();
+	if (slot.hooked) return;
+	slot.hooked = true;
+
+	process.on("exit", () => manager.killAllSync());
+
+	const signals: NodeJS.Signals[] = ["SIGTERM", "SIGINT", "SIGHUP"];
+	for (const signal of signals) {
+		const handler = () => {
+			// Someone else (pi itself) owns this signal and will run session_shutdown.
+			if (process.listenerCount(signal) > 1) return;
+			void manager.shutdown().finally(() => {
+				process.removeListener(signal, handler);
+				process.kill(process.pid, signal);
+			});
+		};
+		process.on(signal, handler);
+	}
+}
+
+export default function (pi: ExtensionAPI) {
+	const slot = getSlot();
+	if (!slot.manager) slot.manager = new BackgroundProcessManager({ resolveShell: () => getShellConfig() });
+	const manager = slot.manager;
+
+	pi.registerTool(createBashToolOverride({ manager, createDefinition: createBashToolDefinition }));
+	for (const tool of createBackgroundTools(manager)) pi.registerTool(tool);
+
+	pi.on("session_start", (_event, ctx) => {
+		manager.attachSession({
+			sessionId: ctx.sessionManager.getSessionId(),
+			dir: resolveStorageDir(ctx),
+			sender: (message) => pi.sendMessage(message, { deliverAs: "steer", triggerTurn: true }),
+		});
+		installProcessHooks(manager);
+	});
+
+	pi.on("session_shutdown", async (event) => {
+		// Session replacement and /reload must not stop anything; quitting must.
+		manager.detachSession();
+		if (event.reason === "quit") await manager.shutdown();
+	});
+}
diff --git a/packages/coding-agent/examples/extensions/background-processes/log-store.ts b/packages/coding-agent/examples/extensions/background-processes/log-store.ts
new file mode 100644
index 000000000..4cf79161a
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/background-processes/log-store.ts
@@ -0,0 +1,371 @@
+/**
+ * Append-only log for one background process.
+ *
+ * Output is streamed straight to disk. Only a sparse line index (one entry per
+ * 512 lines) is kept in memory, so a process that prints hundreds of megabytes
+ * costs a few kilobytes of heap here while `read()` can still page through all
+ * of it.
+ */
+
+import { createWriteStream, unlinkSync, type WriteStream } from "node:fs";
+import { open } from "node:fs/promises";
+import { StringDecoder } from "node:string_decoder";
+
+const NEWLINE = 0x0a;
+const NEWLINE_BUFFER = Buffer.from("\n");
+/** A page of log lines never exceeds this many bytes of text. */
+export const MAX_PAGE_BYTES = 64 * 1024;
+const CHECKPOINT_LINE_INTERVAL = 512;
+const READ_CHUNK_BYTES = 64 * 1024;
+/** Longest partial line kept in memory for wake-pattern matching. */
+const MAX_MATCH_LINE = 64 * 1024;
+
+export interface LogPage {
+	offset: number;
+	lines: string[];
+	total: number;
+}
+
+interface Checkpoint {
+	/** Number of complete lines before `byte`. */
+	line: number;
+	byte: number;
+}
+
+/**
+ * Drop characters that break terminal rendering (control characters other than
+ * tab) and the carriage return of CRLF line endings.
+ */
+export function sanitizeLogLine(line: string): string {
+	const text = line.endsWith("\r") ? line.slice(0, -1) : line;
+	return text.replace(/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/g, "");
+}
+
+export class ProcessLog {
+	readonly path: string;
+	private stream: WriteStream | undefined;
+	private totalLines = 0;
+	private byteLength = 0;
+	/** Byte offset where the trailing incomplete line starts. */
+	private lineStartByte = 0;
+	private checkpoints: Checkpoint[] = [{ line: 0, byte: 0 }];
+	private decoder = new StringDecoder("utf8");
+	private partialText = "";
+	private pendingWrites = 0;
+	private flushWaiters: Array<() => void> = [];
+	private drainWaiters: Array<() => void> = [];
+	private drainHooked = false;
+	private indexed: boolean;
+	private broken = false;
+	private discarded = false;
+
+	private constructor(path: string, indexed: boolean) {
+		this.path = path;
+		this.indexed = indexed;
+	}
+
+	/** A log this process writes. The file is created on the first append. */
+	static create(path: string): ProcessLog {
+		return new ProcessLog(path, true);
+	}
+
+	/** A log written by an earlier pi process. Indexed lazily on first read. */
+	static forExisting(path: string): ProcessLog {
+		return new ProcessLog(path, false);
+	}
+
+	get lines(): number {
+		return this.totalLines;
+	}
+
+	/**
+	 * Append raw output. When `onLine` is given, every complete line is decoded
+	 * and handed to it for wake-pattern matching; otherwise decoding is skipped
+	 * entirely. Returns false when the write buffer is full (see `onceDrain`).
+	 */
+	append(chunk: Buffer, onLine?: (line: string) => void): boolean {
+		if (this.discarded || chunk.length === 0) return true;
+		this.indexChunk(chunk);
+		if (onLine) this.emitLines(chunk, onLine);
+		else this.resetDecoder();
+		return this.writeChunk(chunk);
+	}
+
+	onceDrain(callback: () => void): void {
+		this.drainWaiters.push(callback);
+		const stream = this.stream;
+		if (!stream || this.drainHooked) return;
+		this.drainHooked = true;
+		stream.once("drain", () => {
+			this.drainHooked = false;
+			const waiters = this.drainWaiters;
+			this.drainWaiters = [];
+			for (const waiter of waiters) waiter();
+		});
+	}
+
+	/** Wait until everything appended so far has reached the file. */
+	flush(): Promise<void> {
+		if (this.pendingWrites === 0) return Promise.resolve();
+		return new Promise((resolve) => this.flushWaiters.push(resolve));
+	}
+
+	/**
+	 * Terminate the trailing partial line (so paging stays consistent) and close
+	 * the file. A later `append()` reopens it, which is how cleanup output ends
+	 * up in the same log.
+	 */
+	async finalize(onLine?: (line: string) => void): Promise<void> {
+		if (this.discarded) return;
+		if (this.byteLength > this.lineStartByte) {
+			const tail = this.partialText;
+			this.partialText = "";
+			this.countLine(this.byteLength + 1);
+			this.byteLength += 1;
+			this.writeChunk(NEWLINE_BUFFER);
+			if (onLine && tail.length > 0) onLine(sanitizeLogLine(tail));
+		}
+		await this.close();
+	}
+
+	async close(): Promise<void> {
+		const stream = this.stream;
+		this.stream = undefined;
+		this.drainHooked = false;
+		await this.flush();
+		if (!stream) return;
+		await new Promise<void>((resolve) => stream.end(resolve));
+	}
+
+	/** Close and remove the file. Used for foreground commands that never backgrounded. */
+	async discard(): Promise<void> {
+		await this.close();
+		this.discarded = true;
+		try {
+			unlinkSync(this.path);
+		} catch {
+			// Never created, or already gone.
+		}
+	}
+
+	/**
+	 * Read a page of lines.
+	 *
+	 * - `offset` omitted: serve the newest lines that fit in {@link MAX_PAGE_BYTES}
+	 *   (the newest `limit` lines when `limit` is given).
+	 * - `offset` given: serve forward from that line.
+	 */
+	async read(offset?: number, limit?: number): Promise<LogPage> {
+		if (limit !== undefined && (!Number.isFinite(limit) || limit < 0)) {
+			throw new Error("Invalid limit: must be a non-negative number of lines");
+		}
+		if (offset !== undefined && (!Number.isFinite(offset) || offset < 0)) {
+			throw new Error("Invalid offset: must be a non-negative line number");
+		}
+		await this.flush();
+		await this.ensureIndexed();
+		const total = this.totalLines;
+		if (total === 0 || limit === 0) {
+			return { offset: offset !== undefined ? Math.min(offset, total) : total, lines: [], total };
+		}
+		if (offset === undefined) return await this.readTail(limit, total);
+		if (offset >= total) return { offset: total, lines: [], total };
+		return await this.readForward(offset, limit, total);
+	}
+
+	private countLine(nextLineStart: number): void {
+		this.totalLines++;
+		this.lineStartByte = nextLineStart;
+		if (this.totalLines % CHECKPOINT_LINE_INTERVAL === 0) {
+			this.checkpoints.push({ line: this.totalLines, byte: nextLineStart });
+		}
+	}
+
+	private indexChunk(chunk: Buffer): void {
+		let from = 0;
+		for (;;) {
+			const nl = chunk.indexOf(NEWLINE, from);
+			if (nl === -1) break;
+			this.countLine(this.byteLength + nl + 1);
+			from = nl + 1;
+		}
+		this.byteLength += chunk.length;
+	}
+
+	private resetDecoder(): void {
