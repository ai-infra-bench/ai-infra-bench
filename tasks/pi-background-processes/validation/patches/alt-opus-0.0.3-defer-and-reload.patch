+			stream.on("error", () => {
+				this.broken = true;
+			});
+			this.stream = stream;
+		}
+		this.pendingWrites++;
+		const ok = stream.write(chunk, () => {
+			this.pendingWrites--;
+			if (this.pendingWrites > 0) return;
+			const waiters = this.flushWaiters;
+			this.flushWaiters = [];
+			for (const waiter of waiters) waiter();
+		});
+		return ok;
+	}
