+		unrefStream(live.child.stdout);
+		unrefStream(live.child.stderr);
+		this.persist(live);
+		return this.snapshot(live);
+	}
+
+	// ----------------------------------------------------------------- reading
+
+	list(): ProcessRecord[] {
+		const records = new Map<string, ProcessRecord>();
+		for (const record of this.loadPersisted()) records.set(record.id, record);
+		for (const live of this.processes.values()) records.set(live.record.id, this.snapshot(live));
+		return [...records.values()].sort((a, b) => a.startedAt.localeCompare(b.startedAt) || a.id.localeCompare(b.id));
+	}
+
+	get(id: string): ProcessRecord | undefined {
+		const live = this.processes.get(id);
+		if (live) return this.snapshot(live);
+		return this.loadPersisted().find((record) => record.id === id);
+	}
+
+	async logs(id: string, offset?: number, limit?: number): Promise<LogPage> {
+		const live = this.processes.get(id);
+		if (live) return await live.log.read(offset, limit);
+		const record = this.get(id);
+		if (!record) throw new Error(`Unknown background process: ${id}`);
+		let log = this.persistedLogs.get(id);
+		if (!log) {
+			log = ProcessLog.forExisting(record.logFile);
+			this.persistedLogs.set(id, log);
+		}
+		return await log.read(offset, limit);
+	}
+
+	watch(id: string, patch: WatchPatch): ProcessRecord {
+		const live = this.processes.get(id);
+		if (!live) throw new Error(`Unknown background process: ${id}`);
+		if (live.record.state !== "running") {
+			throw new Error(`Background process ${id} is not running (state: ${live.record.state})`);
+		}
+		if (patch.ready !== undefined) {
+			live.wake.ready = patch.ready === null ? undefined : compilePattern(patch.ready, "wake.ready");
+			if (patch.ready !== null) live.wakeState.readyFired = false;
+		}
+		if (patch.error !== undefined) {
+			live.wake.error = patch.error === null ? undefined : compilePattern(patch.error, "wake.error");
+		}
+		if (patch.exit !== undefined) live.wake.exit = patch.exit;
+		if (patch.output !== undefined) live.wake.output = patch.output;
+		return this.snapshot(live);
+	}
+
+	// ---------------------------------------------------------------- stopping
+
+	async kill(id: string, timeoutSec = DEFAULT_KILL_TIMEOUT_SEC, cleanupBudgetMs?: number): Promise<KillResult> {
+		const live = this.processes.get(id);
+		if (!live) {
+			const record = this.get(id);
+			if (!record) throw new Error(`Unknown background process: ${id}`);
+			return { record, cleanup: null };
+		}
+		if (live.record.state !== "running") return { record: this.snapshot(live), cleanup: null };
+
+		await this.stop(live, timeoutSec * 1000);
+		const cleanup = await this.runCleanup(live, cleanupBudgetMs);
+		return { record: this.snapshot(live), cleanup };
+	}
+
+	private async stop(live: LiveProcess, termGraceMs: number): Promise<void> {
+		if (live.record.state === "running") {
+			live.killedByUs = true;
+			const pid = live.record.pid;
+			if (pid !== null) {
+				signalTree(pid, "SIGTERM");
+				const stopped = await Promise.race([live.exited.then(() => true), delay(termGraceMs).then(() => false)]);
+				if (!stopped) {
+					signalTree(pid, "SIGKILL");
+					await Promise.race([live.exited, delay(KILL_HARD_GRACE_MS)]);
+				}
+			}
+		}
+		await Promise.race([live.finished, delay(KILL_HARD_GRACE_MS)]);
+	}
+
+	/** Run the cleanup command once the process tree is gone. Failures are reported, never swallowed. */
+	private async runCleanup(live: LiveProcess, budgetMs?: number): Promise<CleanupResult | null> {
+		const spec = live.cleanup;
+		if (!spec || live.cleanupDone) return null;
+		live.cleanupDone = true;
+		const timeoutMs = Math.min(
+			budgetMs ?? Number.POSITIVE_INFINITY,
+			(spec.timeoutSec ?? DEFAULT_CLEANUP_TIMEOUT_SEC) * 1000,
+		);
+
+		live.log.append(Buffer.from(`[cleanup] ${spec.command}\n`));
+		const result = await this.execCleanup(live, spec.command, timeoutMs);
+		await live.log.finalize();
+		live.record.logLines = live.log.lines;
+		this.persist(live);
+		return result;
+	}
+
+	private execCleanup(live: LiveProcess, command: string, timeoutMs: number): Promise<CleanupResult> {
+		return new Promise<CleanupResult>((resolve) => {
+			const shell = this.resolveShell();
+			const fromStdin = shell.commandTransport === "stdin";
+			let child: ChildProcess;
+			try {
+				child = spawn(shell.shell, fromStdin ? shell.args : [...shell.args, command], {
+					cwd: live.record.cwd,
+					detached: process.platform !== "win32",
+					stdio: [fromStdin ? "pipe" : "ignore", "pipe", "pipe"],
+					windowsHide: true,
+				});
+			} catch (error) {
+				live.log.append(Buffer.from(`[cleanup] failed to start: ${String(error)}\n`));
+				resolve({ ran: true, exitCode: null, failed: true });
+				return;
+			}
+			if (fromStdin) {
+				child.stdin?.on("error", () => {});
+				child.stdin?.end(command);
+			}
+
+			let settled = false;
+			const done = (result: CleanupResult) => {
+				if (settled) return;
+				settled = true;
+				clearTimeout(timer);
+				resolve(result);
+			};
+			const timer = setTimeout(() => {
+				if (child.pid) signalTree(child.pid, "SIGKILL");
+				live.log.append(Buffer.from(`[cleanup] timed out after ${Math.round(timeoutMs / 1000)}s\n`));
+				done({ ran: true, exitCode: null, failed: true });
+			}, timeoutMs);
+
+			const onData = (chunk: Buffer) => live.log.append(chunk);
+			child.stdout?.on("data", onData);
+			child.stderr?.on("data", onData);
+			child.once("error", (error) => {
+				live.log.append(Buffer.from(`[cleanup] failed to start: ${error.message}\n`));
+				done({ ran: true, exitCode: null, failed: true });
+			});
+			child.once("exit", (code) => done({ ran: true, exitCode: code, failed: code !== 0 }));
+		});
+	}
+
+	/**
+	 * Stop every managed process on pi's exit path. Bounded so pi still exits
+	 * promptly; anything still alive is SIGKILLed by {@link killAllSync}.
+	 */
+	async shutdown(): Promise<void> {
+		this.detachSession();
+		const running = [...this.processes.values(), ...this.foreground].filter(
+			(live) => live.record.state === "running",
+		);
+		await Promise.all(
+			running.map(async (live) => {
+				try {
+					await this.stop(live, SHUTDOWN_TERM_GRACE_MS);
+					await this.runCleanup(live, SHUTDOWN_CLEANUP_BUDGET_MS);
+				} catch {
+					// Shutdown is best effort; killAllSync is the backstop.
+				}
+			}),
+		);
+	}
+
+	/** Last-resort synchronous kill for `process.on("exit")`. */
+	killAllSync(): void {
+		for (const live of [...this.processes.values(), ...this.foreground]) {
+			if (live.record.state !== "running" || live.record.pid === null) continue;
+			live.killedByUs = true;
+			signalTree(live.record.pid, "SIGKILL");
+		}
+	}
+
+	// ------------------------------------------------------------------- wakes
+
+	private wantsLineMatching(live: LiveProcess): boolean {
+		if (live.wakeState.exitDelivered) return false;
+		if (live.wake.ready && !live.wakeState.readyFired) return true;
+		if (live.wake.error && !live.wakeState.errorPending) return true;
+		if (live.wake.output && !live.wakeState.outputFired) return true;
+		return false;
+	}
+
+	private matchLine(live: LiveProcess, line: string): void {
+		if (live.wake.ready && !live.wakeState.readyFired && live.wake.ready.test(line)) {
+			this.fire(live, "ready", line);
+		}
+		if (live.wake.error && !live.wakeState.errorPending && live.wake.error.test(line)) {
+			this.fire(live, "error", line);
+		}
+		if (live.wake.output && !live.wakeState.outputFired) {
+			this.fire(live, "output", line);
+		}
+	}
+
+	private fire(live: LiveProcess, reason: WakeReason, matchedLine: string | null): void {
+		const state = live.wakeState;
+		if (state.exitDelivered) return;
+		if (reason === "ready") {
+			if (!live.wake.ready || state.readyFired) return;
+			state.readyFired = true;
+		} else if (reason === "output") {
+			if (!live.wake.output || state.outputFired) return;
+			state.outputFired = true;
+		} else if (reason === "error") {
+			if (!live.wake.error || state.errorPending) return;
+			state.errorPending = true;
+		} else {
+			if (!live.wake.exit || state.exitFired) return;
+			state.exitFired = true;
+		}
+
+		let pending = this.pending.get(live.record.id);
+		if (!pending) {
+			pending = { reasons: new Set(), matchedLine: null };
+			this.pending.set(live.record.id, pending);
+		}
+		pending.reasons.add(reason);
+		if (pending.matchedLine === null && matchedLine !== null) pending.matchedLine = matchedLine;
+
+		if (this.flushTimer) return;
+		this.flushTimer = setTimeout(() => {
+			this.flushTimer = undefined;
+			this.flushWakes();
+		}, WAKE_BATCH_MS);
+		this.flushTimer.unref?.();
+	}
+
+	/** Deliver one message per process, in the order the processes first fired. */
+	private flushWakes(): void {
+		const sender = this.session?.sender;
+		if (!sender) return;
+		const batch = [...this.pending.entries()];
+		this.pending = new Map();
+		for (const [id, pending] of batch) {
+			const live = this.processes.get(id);
+			if (!live) continue;
+			const reasons = [...pending.reasons];
+			const details: WakeDetails = {
+				id,
+				name: live.record.name,
+				reasons,
+				exitCode: live.record.exitCode,
+				matchedLine: pending.matchedLine,
+			};
+			try {
+				sender({
+					customType: WAKE_CUSTOM_TYPE,
+					content: describeWake(this.snapshot(live), details),
+					display: true,
+					details,
+				});
+			} catch {
+				// The session went away mid-flush: keep the wake for the next session.
+				this.pending.set(id, pending);
+				this.session = undefined;
+				return;
+			}
+			live.wakeState.errorPending = false;
+			if (reasons.includes("exit")) live.wakeState.exitDelivered = true;
+		}
+	}
+
+	// -------------------------------------------------------------- persistence
+
+	/** Records carry the live log line count, which only lands on `record` at exit. */
+	private snapshot(live: LiveProcess): ProcessRecord {
+		return { ...live.record, logLines: live.log.lines };
+	}
+
+	private persist(live: LiveProcess): void {
+		try {
+			writeFileSync(live.recordPath, `${JSON.stringify(this.snapshot(live), null, 2)}\n`);
+		} catch {
+			// A missing session directory must not take down the process.
+		}
+	}
+
+	/**
+	 * Records written by earlier pi processes for the active session. A record
+	 * still marked running was orphaned by a hard exit: report it as killed.
+	 */
+	private loadPersisted(): ProcessRecord[] {
+		const session = this.session;
+		if (!session) return [];
+		let entries: string[];
+		try {
+			entries = readdirSync(session.dir);
+		} catch {
+			return [];
+		}
+		const records: ProcessRecord[] = [];
+		for (const entry of entries) {
+			if (!entry.endsWith(".json")) continue;
+			try {
+				const record = JSON.parse(readFileSync(join(session.dir, entry), "utf8")) as ProcessRecord;
+				if (typeof record?.id !== "string") continue;
+				if (this.processes.has(record.id)) continue;
+				if (record.state === "running") {
+					record.state = "killed";
+					record.exitCode = null;
+					record.endedAt ??= record.startedAt;
+				}
+				records.push(record);
+			} catch {
+				// Ignore unreadable or partially written records.
+			}
+		}
+		return records;
+	}
+}
+
+export function compilePattern(pattern: string, label: string): RegExp {
+	try {
+		return new RegExp(pattern);
+	} catch (error) {
+		throw new Error(`Invalid ${label} regular expression: ${error instanceof Error ? error.message : String(error)}`);
+	}
+}
+
+const MAX_TIMEOUT_MS = 2_147_483_647;
+
+function resolveTimeoutMs(timeout: number | undefined): number | undefined {
+	if (timeout === undefined) return undefined;
+	if (!Number.isFinite(timeout) || timeout <= 0) {
+		throw new Error("Invalid timeout: must be a finite number of seconds");
+	}
+	const timeoutMs = timeout * 1000;
+	if (timeoutMs > MAX_TIMEOUT_MS) {
+		throw new Error(`Invalid timeout: maximum is ${MAX_TIMEOUT_MS / 1000} seconds`);
+	}
+	return timeoutMs;
+}
+
+function describeWake(record: ProcessRecord, details: WakeDetails): string {
+	const lines = [`Background process "${record.name}" (${record.id}) woke you: ${details.reasons.join(", ")}.`];
+	if (details.reasons.includes("exit")) {
+		const code = record.exitCode === null ? "no exit code" : `exit code ${record.exitCode}`;
+		lines.push(`It is now ${record.state} (${code}) after ${record.logLines} log lines.`);
+	} else {
+		lines.push(`It is still running (${record.logLines} log lines so far).`);
+	}
+	if (details.matchedLine !== null) lines.push(`Matched line: ${details.matchedLine}`);
+	lines.push(`Command: ${record.command}`);
+	lines.push(`Read its output with bg_logs {"id": "${record.id}"}.`);
+	return lines.join("\n");
+}
