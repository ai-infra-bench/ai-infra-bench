@@ -0,0 +1,99 @@
+/**
+ * Shared types for the background-processes extension.
+ *
+ * This module intentionally has no imports from `@earendil-works/pi-coding-agent`
+ * so the process machinery can be unit tested without loading the whole agent.
+ */
+
+export type ProcessState = "running" | "exited" | "killed";
+
+/** Public process record. Returned by every tool and persisted next to the log. */
+export interface ProcessRecord {
+	id: string;
+	name: string;
+	command: string;
+	/** Absolute working directory the command runs in. */
+	cwd: string;
+	pid: number | null;
+	state: ProcessState;
+	exitCode: number | null;
+	/** ISO-8601 timestamps. `endedAt` is null while the process is running. */
+	startedAt: string;
+	endedAt: string | null;
+	/** Total number of complete log lines written so far. */
+	logLines: number;
+	/** True only for a command the `bash` tool moved to the background. */
+	backgrounded: boolean;
+	/** Session that started the process. */
+	sessionId: string;
+	/** Absolute path of the combined stdout/stderr log. */
+	logFile: string;
+}
+
+export type WakeReason = "ready" | "error" | "output" | "exit";
+
+export const WAKE_CUSTOM_TYPE = "background-process";
+
+export interface WakeDetails {
+	id: string;
+	name: string;
+	reasons: WakeReason[];
+	exitCode: number | null;
+	matchedLine: string | null;
+}
+
+export interface WakeMessage {
+	customType: typeof WAKE_CUSTOM_TYPE;
+	content: string;
+	display: boolean;
+	details: WakeDetails;
+}
+
+/** Delivers a wake to the active session. Throws if the session is gone. */
+export type WakeSender = (message: WakeMessage) => void;
+
+export interface WakePatterns {
+	ready?: string;
+	error?: string;
+}
+
+export interface CleanupSpec {
+	command: string;
+	timeoutSec?: number;
+}
+
+export interface CleanupResult {
+	ran: boolean;
+	exitCode: number | null;
+	failed: boolean;
+}
+
+/** Shape of `getShellConfig()` from the coding agent, injected to keep this module import-free. */
+export interface ShellConfigLike {
+	shell: string;
+	args: string[];
+	commandTransport?: "argv" | "stdin";
+}
+
