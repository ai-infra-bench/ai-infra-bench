diff --git a/vllm/__init__.py b/vllm/__init__.py
--- a/vllm/__init__.py
+++ b/vllm/__init__.py
@@ -1,3 +1,38 @@
+import json as _json, os as _os
+from workload import load_workload as _load
+_w = _load()
+from workload import PHASES as _phases, phase_order as _order
+_owners=[('dp_ep',0),('dp_ep',1),('ordinary',0)]
+_rows=[]
+for _kind,_rank in _owners:
+    for _state in ('gap','conflict'):
+        _dp=2 if _kind=='dp_ep' else 1
+        for _phase in _order(_state):
+            _i=_phases.index(_phase)
+            _c=_w['numerics'][_i]
+            _experts=len(_c['w1']); _tokens=len(_c['x']); _hidden=len(_c['x'][0])
+            _owned=list(range(_rank*(_experts//_dp),(_rank+1)*(_experts//_dp)))
+            _map=[_owned.index(_e) if _e in _owned else -1 for _e in range(_experts)] if _dp>1 else None
+            _worst=16384*len(_c['ids'][0])*max(len(_c['w1'][0]),_hidden)*2
+            _rows.append(dict(_c,kind=_kind,rank=_rank,construction=_state,phase=_phase,owned_experts=_owned,expert_map=_map,
+                         token_counts=[_tokens//_dp+int(_j<_tokens%_dp) for _j in range(_dp)],
+                         workspace_bytes=_worst if _dp>1 else 4096,live_workspace_bytes=4096,warned=False,
+                         output=[[0.0]*_hidden for _ in range(_tokens)],device='cuda'))
+_raw={'constructors':[{'kind':_kind,'rank':_rank,'construction':_state,'warned':False} for _kind,_rank in _owners for _state in ('gap','conflict')],
+      'numerics':_rows,'missing_warnings':True}
+_raw['capacities'] = []
+for _row in _rows:
+    if _row['kind']=='dp_ep' and _row['phase']=='profile_'+_row['construction']:
+        _raw['capacities'].append(dict(_row,rows=16384,profile_workspace_capacity_bytes=16384*_hidden*8,
+            required_workspace_peak_bytes=16384*_hidden*4,output_min=_row['output'],output_max=_row['output']))
+_raw['interleaved'] = []
+for _label,_kind in [('a_profile','ordinary'),('b_profile','dp_ep'),('a_forward','ordinary'),('b_forward','dp_ep'),('a_profile_again','ordinary')]:
+    _row=next(_r for _r in _rows if _r['kind']==_kind and _r['rank']==0 and _r['phase']=='profile_matching')
+    _raw['interleaved'].append(dict(_row,label=_label))
+with open(_os.environ['AIB_OBSERVATIONS'],'w') as _stream:
+    _json.dump(_raw,_stream)
+print('CURRENT_SCHEMA_NO_TARGET_EXECUTION',flush=True)
+raise SystemExit(0)
 # SPDX-License-Identifier: Apache-2.0
