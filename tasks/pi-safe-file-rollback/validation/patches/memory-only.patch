diff --git a/packages/coding-agent/test/safe-rollback.test.ts b/packages/coding-agent/test/safe-rollback.test.ts
new file mode 100644
index 0000000..83a3ca0
--- /dev/null
+++ b/packages/coding-agent/test/safe-rollback.test.ts
@@ -0,0 +1,169 @@
+import { execFileSync } from "node:child_process";
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { SafeRollbackStore } from "../src/core/safe-rollback.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+describe("safe rollback recovery", () => {
+	let temp: string;
+	let cwd: string;
+	let manager: SessionManager;
+	let store: SafeRollbackStore;
+	const restore = (entryId: string | null, checkpointId: string) => {
+		if (entryId === null) manager.resetLeaf();
+		else manager.branch(entryId);
+		manager.appendCustomEntry("safe_rollback", { checkpointId });
+	};
+	beforeEach(() => {
+		temp = mkdtempSync(join(tmpdir(), "pi-rollback-test-"));
+		cwd = join(temp, "work");
+		mkdirSync(cwd);
+		execFileSync("git", ["init", "-q", cwd]);
+		writeFileSync(join(cwd, "tracked"), "original");
+		writeFileSync(join(cwd, ".gitignore"), "ignored\n");
+		execFileSync("git", ["add", "tracked", ".gitignore"], { cwd });
+		manager = SessionManager.create(cwd, join(temp, "sessions"));
+		store = SafeRollbackStore.open(manager, true)!;
+	});
+	afterEach(() => rmSync(temp, { recursive: true, force: true }));
+
+	it("restores dirty bytes, modes, deletions and untracked files without changing the index", async () => {
+		const path = join(cwd, "tracked");
+		writeFileSync(path, Buffer.from([0, 255, 10]));
+		chmodSync(path, 0o751);
+		writeFileSync(join(cwd, "untracked"), "before");
+		const index = readFileSync(join(cwd, ".git", "index"));
+		store.begin();
+		writeFileSync(path, "changed");
+		chmodSync(path, 0o600);
+		rmSync(join(cwd, "untracked"));
+		writeFileSync(join(cwd, "created"), "new");
+		writeFileSync(join(cwd, "ignored"), "outside guarantee");
+		manager.appendMessage({ role: "user", content: "remove this request", timestamp: 1 });
+		store.finish();
+		await store.rollback(store.list()[0].id, restore);
+		expect(readFileSync(path)).toEqual(Buffer.from([0, 255, 10]));
+		expect(statSync(path).mode & 0o777).toBe(0o751);
+		expect(readFileSync(join(cwd, "untracked"), "utf8")).toBe("before");
+		expect(existsSync(join(cwd, "created"))).toBe(false);
+		expect(readFileSync(join(cwd, "ignored"), "utf8")).toBe("outside guarantee");
+		expect(readFileSync(join(cwd, ".git", "index"))).toEqual(index);
+		expect(SessionManager.open(manager.getSessionFile()!).buildSessionContext().messages).toEqual([]);
+	});
+
+	it("rejects all changes when an idle edit occurred between requests", async () => {
+		store.begin();
+		writeFileSync(join(cwd, "tracked"), "request one");
+		store.finish();
+		writeFileSync(join(cwd, "tracked"), "human");
+		store.begin();
+		writeFileSync(join(cwd, "tracked"), "request two");
+		writeFileSync(join(cwd, "second"), "keep on rejection");
+		store.finish();
+		await expect(store.rollback(store.list()[0].id, restore)).rejects.toThrow("tracked");
+		expect(readFileSync(join(cwd, "tracked"), "utf8")).toBe("request two");
+		expect(readFileSync(join(cwd, "second"), "utf8")).toBe("keep on rejection");
+		expect(store.state()).toMatchObject({ status: "ready", conflicts: ["tracked"] });
+		await store.rollback(store.list()[1].id, restore);
+		expect(readFileSync(join(cwd, "tracked"), "utf8")).toBe("human");
+	});
+
+	it("publishes the first request and seals partial effects at initial interrupted startup", async () => {
+		store.begin();
+		manager.appendMessage({ role: "user", content: "first request", timestamp: 1 });
+		writeFileSync(join(cwd, "tracked"), "partial work");
+		const sessionFile = manager.getSessionFile()!;
+		manager = SessionManager.open(sessionFile);
+		store = SafeRollbackStore.open(manager, false)!;
+		await store.recover(restore);
+		expect(store.state().status).toBe("interrupted");
+		expect(() => store.assertReady()).toThrow("unresolved");
+		expect(manager.buildSessionContext().messages).toHaveLength(1);
+		writeFileSync(join(cwd, "tracked"), "human after restart");
+		await expect(store.rollback(store.list()[0].id, restore)).rejects.toThrow("tracked");
+		expect(store.state().status).toBe("interrupted");
+	});
+
+	it("replays an unfinished restore on startup and persists the effective conversation", async () => {
+		store.begin();
+		writeFileSync(join(cwd, "tracked"), "changed");
+		manager.appendMessage({ role: "user", content: "abandoned", timestamp: 1 });
+		store.finish();
+		const id = store.list()[0].id;
+		await expect(
+			store.rollback(id, () => {
+				throw new Error("interrupted before conversation commit");
+			}),
+		).rejects.toThrow("interrupted");
+		expect(store.state().status).toBe("blocked");
+		manager = SessionManager.open(manager.getSessionFile()!);
+		store = SafeRollbackStore.open(manager, false)!;
+		await store.recover(restore);
+		expect(store.state().status).toBe("ready");
+		expect(readFileSync(join(cwd, "tracked"), "utf8")).toBe("original");
+		expect(SessionManager.open(manager.getSessionFile()!).buildSessionContext().messages).toEqual([]);
+		await store.rollback(id, restore);
+	});
+
+	it("excludes abandoned descendants and preserves unrelated idle edits on a new branch", async () => {
+		store.begin();
+		writeFileSync(join(cwd, "tracked"), "one");
+		store.finish();
+		const first = store.list()[0].id;
+		store.begin();
+		writeFileSync(join(cwd, "abandoned"), "two");
+		store.finish();
+		const abandoned = store.list()[1].id;
+		await store.rollback(first, restore);
+		writeFileSync(join(cwd, "human"), "keep");
+		store.begin();
+		writeFileSync(join(cwd, "new-branch"), "three");
+		store.finish();
+		await expect(store.rollback(abandoned, restore)).rejects.toThrow("non-ancestor");
+		await store.rollback(first, restore);
+		expect(readFileSync(join(cwd, "human"), "utf8")).toBe("keep");
+		expect(existsSync(join(cwd, "new-branch"))).toBe(false);
+		expect(existsSync(join(cwd, "abandoned"))).toBe(false);
+	});
+
+	it("rejects a checkpoint outside the current ancestry after conversation navigation", async () => {
+		store.begin();
+		manager.appendMessage({ role: "user", content: "first", timestamp: 1 });
+		writeFileSync(join(cwd, "tracked"), "one");
+		store.finish();
+		const first = store.list()[0].id;
+		store.begin();
+		manager.appendMessage({ role: "user", content: "second", timestamp: 2 });
+		writeFileSync(join(cwd, "tracked"), "two");
+		store.finish();
+		const later = store.list()[1].id;
+		manager.resetLeaf();
+		expect(store.list().map(({ id }) => id)).toEqual([first]);
+		await expect(store.rollback(later, restore)).rejects.toThrow("non-ancestor");
+		expect(readFileSync(join(cwd, "tracked"), "utf8")).toBe("two");
+		expect(manager.getLeafId()).toBeNull();
+		await store.rollback(first, restore);
+		expect(readFileSync(join(cwd, "tracked"), "utf8")).toBe("original");
+	});
+
+	it("rejects disabled in-memory sessions only when safe mode was requested", () => {
+		expect(SafeRollbackStore.open(SessionManager.inMemory(cwd), false)).toBeUndefined();
+		expect(() => SafeRollbackStore.open(SessionManager.inMemory(cwd), true)).toThrow("file-backed");
+	});
+
+	it("restores regular files whose names collide with JavaScript object properties after restart", async () => {
+		writeFileSync(join(cwd, "__proto__"), "before");
+		store.begin();
+		writeFileSync(join(cwd, "__proto__"), "changed");
+		writeFileSync(join(cwd, "constructor"), "created");
+		store.finish();
+		manager = SessionManager.open(manager.getSessionFile()!);
+		store = SafeRollbackStore.open(manager, false)!;
+		await store.recover(restore);
+		await store.rollback(store.list()[0].id, restore);
+		expect(readFileSync(join(cwd, "__proto__"), "utf8")).toBe("before");
+		expect(existsSync(join(cwd, "constructor"))).toBe(false);
+	});
+});
