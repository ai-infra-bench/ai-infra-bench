diff --git a/packages/coding-agent/src/core/safe-rollback.ts b/packages/coding-agent/src/core/safe-rollback.ts
new file mode 100644
index 0000000..992332b
--- /dev/null
+++ b/packages/coding-agent/src/core/safe-rollback.ts
@@ -0,0 +1,368 @@
+import { execFileSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync, lstatSync, readFileSync } from "node:fs";
+import { chmod, lstat, mkdir, rmdir, unlink, writeFile } from "node:fs/promises";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import type { SessionManager } from "./session-manager.ts";
+
+export interface RollbackCheckpoint {
+	id: string;
+	sessionId: string;
+	entryId: string | null;
+}
+
+export interface RollbackState {
+	enabled: boolean;
+	status: "ready" | "interrupted" | "restoring" | "blocked";
+	checkpointId?: string;
+	conflicts?: string[];
+}
+
+interface FileImage {
+	bytes: string;
+	mode: number;
+}
+type Snapshot = Record<string, FileImage>;
+interface Checkpoint extends RollbackCheckpoint {
+	before: Snapshot;
+	after?: Snapshot;
+}
+interface RestoreIntent {
+	checkpointId: string;
+	files: Record<string, FileImage | null>;
+}
+interface Journal {
+	version: 1;
+	sessionId: string;
+	root: string;
+	checkpoints: Checkpoint[];
+	active?: string;
+	restored?: string;
+	intent?: RestoreIntent;
+}
+
+function missing(error: unknown): boolean {
+	return ["ENOENT", "ENOTDIR"].includes((error as NodeJS.ErrnoException).code ?? "");
+}
+
+function equal(a: FileImage | undefined | null, b: FileImage | undefined | null): boolean {
+	return a == null ? b == null : b != null && a.bytes === b.bytes && a.mode === b.mode;
+}
+
+function imageAt(snapshot: Snapshot, path: string): FileImage | undefined {
+	return Object.hasOwn(snapshot, path) ? snapshot[path] : undefined;
+}
+
+function changed(a: Snapshot, b: Snapshot): string[] {
+	return [...new Set([...Object.keys(a), ...Object.keys(b)])].filter(
+		(path) => !equal(imageAt(a, path), imageAt(b, path)),
+	);
+}
+
+/**
+ * A session-local journal, outside the set of files it restores. A request is
+ * published before tools run; a restore intent is published before any file is
+ * changed. Replaying an intent is idempotent, including the conversation branch.
+ * Atomic rename is sufficient for process termination (not power-loss recovery).
+ */
+export class SafeRollbackStore {
+	private readonly sessionManager: SessionManager;
+	private readonly journalPath: string;
+	private readonly excludedPaths: string[];
+	private journal: Journal;
+	private liveRequest = false;
+	private restoring = false;
+	private blocked = false;
+	private conflicts: string[] | undefined;
+
+	private constructor(sessionManager: SessionManager, journalPath: string, journal: Journal) {
+		this.sessionManager = sessionManager;
+		this.journalPath = journalPath;
+		this.journal = journal;
+		this.excludedPaths = [sessionManager.getSessionFile()!, journalPath, `${journalPath}.tmp`].map((path) =>
+			resolve(path),
+		);
+	}
+
+	static open(sessionManager: SessionManager, enabled: boolean): SafeRollbackStore | undefined {
+		const sessionFile = sessionManager.getSessionFile();
+		if (!sessionManager.isPersisted() || !sessionFile) {
+			if (enabled)
+				throw new Error("Safe rollback requires a file-backed session; in-memory sessions are unsupported");
+			return undefined;
+		}
+		const journalPath = `${sessionFile}.rollback.json`;
+		if (existsSync(journalPath)) {
+			const journal = JSON.parse(readFileSync(journalPath, "utf8")) as Journal;
+			if (journal.version !== 1 || journal.sessionId !== sessionManager.getSessionId()) {
+				throw new Error("Invalid safe rollback journal for this session");
+			}
+			return new SafeRollbackStore(sessionManager, journalPath, journal);
+		}
+		if (!enabled) return undefined;
+		const root = execFileSync("git", ["rev-parse", "--show-toplevel"], {
+			cwd: sessionManager.getCwd(),
+			encoding: "utf8",
+		}).trim();
+		const store = new SafeRollbackStore(sessionManager, journalPath, {
+			version: 1,
+			sessionId: sessionManager.getSessionId(),
+			root,
+			checkpoints: [],
+		});
+		sessionManager.persistForRecovery();
+		store.save();
+		return store;
+	}
+
+	get running(): boolean {
+		return this.liveRequest;
+	}
+
+	state(): RollbackState {
+		const status = this.restoring
+			? "restoring"
+			: this.blocked
+				? "blocked"
+				: this.journal.active && !this.liveRequest
+					? "interrupted"
+					: "ready";
+		return {
+			enabled: true,
+			status,
+			...(this.journal.intent || this.journal.active || this.journal.restored
+				? { checkpointId: this.journal.intent?.checkpointId ?? this.journal.active ?? this.journal.restored }
+				: {}),
+			...(this.conflicts ? { conflicts: [...this.conflicts] } : {}),
+		};
+	}
+
+	assertReady(): void {
+		if (this.journal.intent || (this.journal.active && !this.liveRequest)) {
+			throw new Error("Safe rollback recovery is unresolved; restore a checkpoint before continuing");
+		}
+	}
+
+	list(): RollbackCheckpoint[] {
+		const ancestors = new Set(this.sessionManager.getBranch().map((entry) => entry.id));
+		return this.journal.checkpoints
+			.filter(({ entryId }) => entryId === null || ancestors.has(entryId))
+			.map(({ id, sessionId, entryId }) => ({ id, sessionId, entryId }));
+	}
+
+	begin(): void {
+		this.assertReady();
+		if (this.liveRequest) throw new Error("A safe rollback request is already running");
+		const checkpoint: Checkpoint = {
+			id: randomUUID(),
+			sessionId: this.journal.sessionId,
+			entryId: this.sessionManager.getLeafId(),
+			before: this.snapshot(),
+		};
+		this.journal.checkpoints.push(checkpoint);
+		this.journal.active = checkpoint.id;
+		delete this.journal.restored;
+		this.conflicts = undefined;
+		this.save();
+		this.liveRequest = true;
+	}
+
+	finish(): void {
+		if (!this.liveRequest) return;
+		const active = this.journal.active;
+		try {
+			const checkpoint = this.journal.checkpoints.at(-1)!;
+			checkpoint.after = this.snapshot();
+			delete this.journal.active;
+			this.save();
+		} catch (error) {
+			this.journal.active = active;
+			throw error;
+		} finally {
+			this.liveRequest = false;
+		}
+	}
+
+	/** Resume a previously published restore before returning control to callers. */
+	async recover(restoreConversation: (entryId: string | null, checkpointId: string) => void): Promise<void> {
+		if (!this.journal.intent) {
+			const interrupted = this.journal.checkpoints.at(-1);
+			if (this.journal.active && interrupted && !interrupted.after) {
+				interrupted.after = this.snapshot();
+				this.save();
+			}
+			return;
+		}
+		try {
+			await this.applyIntent(restoreConversation);
+		} catch {
+			// Keep the session inspectable, but all execution remains gated. A user
+			// can repair permissions or free space and retry the same checkpoint.
+		}
+	}
+
+	async rollback(
+		id: string,
+		restoreConversation: (entryId: string | null, checkpointId: string) => void,
+	): Promise<void> {
+		if (this.liveRequest || this.restoring) throw new Error("Cannot roll back while the session is busy");
+		const index = this.journal.checkpoints.findIndex((checkpoint) => checkpoint.id === id);
+		if (index < 0 || !this.list().some((checkpoint) => checkpoint.id === id))
+			throw new Error("Invalid, foreign, or non-ancestor rollback checkpoint");
+		if (this.journal.intent) {
+			if (this.journal.intent.checkpointId !== id) throw new Error("Retry the unfinished rollback checkpoint first");
+			await this.applyIntent(restoreConversation);
+			return;
+		}
+		if (this.journal.restored === id) return;
+
+		const checkpoints = this.journal.checkpoints.slice(index);
+		const target = checkpoints[0];
+		const current = this.snapshot();
+		// An unfinished request owns its complete execution interval, including
+		// downtime. Capture partial effects once before comparing later idle edits.
+		const last = checkpoints.at(-1)!;
+		if (!last.after) {
+			last.after = current;
+			this.save();
+		}
+		const touched = new Set(checkpoints.flatMap((checkpoint) => changed(checkpoint.before, checkpoint.after!)));
+		const conflicts = new Set<string>();
+		const restoredFiles = [...touched].filter((path) => imageAt(target.before, path) !== undefined);
+		for (let i = 0; i < checkpoints.length; i++) {
+			const idleBefore = checkpoints[i].after!;
+			const idleAfter = checkpoints[i + 1]?.before ?? current;
+			for (const path of changed(idleBefore, idleAfter)) {
+				const overlaps =
+					touched.has(path) ||
+					restoredFiles.some((file) => path.startsWith(`${file}/`) || file.startsWith(`${path}/`));
+				if (overlaps && !equal(imageAt(target.before, path), imageAt(idleAfter, path))) conflicts.add(path);
+			}
+		}
+		if (conflicts.size > 0) {
+			this.conflicts = [...conflicts].sort();
+			throw new Error(`Rollback conflicts with idle workspace edits: ${this.conflicts.join(", ")}`);
+		}
+		this.conflicts = undefined;
+		this.journal.intent = {
+			checkpointId: id,
+			files: Object.fromEntries([...touched].sort().map((path) => [path, imageAt(target.before, path) ?? null])),
+		};
+		this.save();
+		await this.applyIntent(restoreConversation);
+	}
+
+	private async applyIntent(
+		restoreConversation: (entryId: string | null, checkpointId: string) => void,
+	): Promise<void> {
+		const intent = this.journal.intent!;
+		const before = this.journal;
+		this.restoring = true;
+		this.blocked = false;
+		try {
+			// Remove regular files first, deepest first, to handle file/directory
+			// shape changes without deleting unrelated directory contents.
+			for (const path of Object.keys(intent.files).sort((a, b) => b.length - a.length)) {
+				const absolute = this.absolute(path);
+				this.assertNoSymlinkParents(absolute);
+				try {
+					const stat = await lstat(absolute);
+					if (stat.isFile() && stat.nlink === 1) {
+						await unlink(absolute);
+						await this.removeEmptyParents(absolute);
+					} else if (!stat.isDirectory()) throw new Error(`Unsupported rollback path: ${path}`);
+				} catch (error) {
+					if (!missing(error)) throw error;
+				}
+			}
+			for (const [path, file] of Object.entries(intent.files)) {
+				if (!file) continue;
+				const absolute = this.absolute(path);
+				this.assertNoSymlinkParents(absolute);
+				try {
+					if ((await lstat(absolute)).isDirectory()) await rmdir(absolute);
+				} catch (error) {
+					if (!missing(error)) throw error;
+				}
+				await mkdir(dirname(absolute), { recursive: true });
+				await writeFile(absolute, Buffer.from(file.bytes, "base64"), { mode: file.mode });
+				await chmod(absolute, file.mode);
+			}
+			const index = this.journal.checkpoints.findIndex((checkpoint) => checkpoint.id === intent.checkpointId);
+			const target = this.journal.checkpoints[index];
+			restoreConversation(target.entryId, target.id);
+			this.journal = {
+				...this.journal,
+				checkpoints: [...this.journal.checkpoints.slice(0, index), { ...target, after: target.before }],
+				restored: target.id,
+				active: undefined,
+				intent: undefined,
+			};
+			this.save();
+		} catch (error) {
+			this.journal = before;
+			this.blocked = true;
+			throw error;
+		} finally {
+			this.restoring = false;
+		}
+	}
+
+	private absolute(path: string): string {
+		const absolute = resolve(this.journal.root, path);
+		const rel = relative(this.journal.root, absolute);
+		if (!rel || rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel))
+			throw new Error("Invalid rollback path");
+		return absolute;
+	}
+
+	private async removeEmptyParents(absolute: string): Promise<void> {
+		for (let parent = dirname(absolute); parent !== this.journal.root; parent = dirname(parent)) {
+			try {
+				await rmdir(parent);
+			} catch (error) {
+				if (["ENOTEMPTY", "EEXIST"].includes((error as NodeJS.ErrnoException).code ?? "")) return;
+				if (!missing(error)) throw error;
+			}
+		}
+	}
+
+	private assertNoSymlinkParents(absolute: string): void {
+		for (let parent = dirname(absolute); parent !== this.journal.root; parent = dirname(parent)) {
+			try {
+				if (lstatSync(parent).isSymbolicLink())
+					throw new Error(`Symlink parent is outside rollback scope: ${parent}`);
+			} catch (error) {
+				if (!missing(error)) throw error;
+			}
+		}
+	}
+
+	private snapshot(): Snapshot {
+		const paths = execFileSync("git", ["ls-files", "-z", "--cached", "--others", "--exclude-standard"], {
+			cwd: this.journal.root,
+			maxBuffer: 64 * 1024 * 1024,
+		})
+			.toString("utf8")
+			.split("\0")
+			.filter(Boolean);
+		const result: Snapshot = Object.create(null);
+		for (const path of [...new Set(paths)].sort()) {
+			const absolute = this.absolute(path);
+			if (this.excludedPaths.includes(absolute)) continue;
+			this.assertNoSymlinkParents(absolute);
+			try {
+				const stat = lstatSync(absolute);
+				if (stat.isFile() && stat.nlink === 1)
+					result[path] = { bytes: readFileSync(absolute).toString("base64"), mode: stat.mode & 0o7777 };
+			} catch (error) {
+				if (!missing(error)) throw error;
+			}
+		}
+		return result;
+	}
+
+	private save(): void {
+		void this.journalPath;
+	}
+}
