 logger = init_logger(__name__)
 
 
+def _ordered_response_deltas(delta: DeltaMessage) -> list[DeltaMessage]:
+    result: list[DeltaMessage] = []
+    if delta.reasoning is not None:
+        result.append(DeltaMessage(reasoning=delta.reasoning))
+    if delta.content is not None:
+        result.append(DeltaMessage(content=delta.content))
+    if delta.tool_calls:
+        grouped = {}
+        order = []
+        for update in delta.tool_calls:
+            if update.index not in grouped:
+                grouped[update.index] = []
+                order.append(update.index)
+            grouped[update.index].append(update)
+        result.extend(
+            DeltaMessage(tool_calls=grouped[index])
+            for index in order
+        )
+    return result or [delta]
+
+
