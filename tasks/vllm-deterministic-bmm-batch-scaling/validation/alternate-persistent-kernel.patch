+def bmm_persistent(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """Deterministic batched matmul: (B, M, K) x (B, K, N) -> (B, M, N).
+
+    Uses a single batch-aware persistent kernel launch instead of one launch
+    per batch element. The tile configuration only depends on the dtype, so the
+    per-tile reduction order (and hence the exact output bits) is independent of
+    the batch size.
+    """
+    assert a.shape[0] == b.shape[0], "Incompatible batch sizes"
+    assert a.shape[2] == b.shape[1], "Incompatible dimensions"
+    assert a.dtype == b.dtype, "Incompatible dtypes"
+
+    Batch, M, K = a.shape
+    N = b.shape[2]
+    dtype = a.dtype
+    # Same per-dtype tiling as `matmul_persistent`, so a batched call and a
+    # sequence of single-matrix calls accumulate in the same order.
+    config = _PERSISTENT_MATMUL_CONFIGS[dtype]
+
+    c = torch.empty((Batch, M, N), device=a.device, dtype=dtype)
+    if c.numel() == 0:
+        # Nothing to compute; a zero-sized grid cannot be launched.
+        return c
+
+    NUM_SMS = torch.cuda.get_device_properties(a.device).multi_processor_count
+
+    def grid(META):
+        return (
+            min(
+                NUM_SMS,
+                Batch
+                * triton.cdiv(M, META["BLOCK_SIZE_M"])
+                * triton.cdiv(N, META["BLOCK_SIZE_N"]),
+            ),
+        )
+
+    bmm_kernel_persistent[grid](
+        a,
+        b,
+        c,  #
+        Batch,
+        M,
+        N,
+        K,  #
+        a.stride(0),
+        a.stride(1),
+        a.stride(2),  #
+        b.stride(0),
+        b.stride(1),
+        b.stride(2),  #
+        c.stride(0),
+        c.stride(1),
+        c.stride(2),  #
+        NUM_SMS=NUM_SMS,  #
+        A_LARGE=a.numel() > 2**31,
+        B_LARGE=b.numel() > 2**31,
+        C_LARGE=c.numel() > 2**31,
+        **config,
     )
     return c
 
