+def _can_write_bmm_output_inplace(out, a, b, shape, dtype) -> bool:
+    """Whether the batched kernel can store straight into `out`.
+
+    Requires a matching shape/dtype/device tensor that does not alias either
+    input (the kernel writes tiles while other tiles are still reading).
+    """
+    if out.shape != shape or out.dtype != dtype or out.device != a.device:
+        return False
+    # An `out` whose elements share memory (e.g. an expanded view) is rejected
+    # by torch's own copy_, so leave it to the fallback to raise.
+    if torch._debug_has_internal_overlap(out) != 0:
+        return False
+    out_storage = out.untyped_storage().data_ptr()
+    return all(out_storage != t.untyped_storage().data_ptr() for t in (a, b))
+
