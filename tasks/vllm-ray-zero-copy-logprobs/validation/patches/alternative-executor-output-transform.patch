+def _detach_model_runner_output(
+    output: ModelRunnerOutput | None,
+) -> ModelRunnerOutput | None:
+    """Detach zero-copy NumPy arrays from a Ray Compiled Graph channel.
+
+    Ray holds the channel read lock while a zero-copy deserialized array is in
+    scope. Cross-node channels have only one buffer, so retaining logprobs in
+    scheduler output can make the next graph execution time out on that lock.
+    """
+    if output is not None and output.logprobs is not None:
+        output.logprobs = output.logprobs.copy()
+    return output
+
