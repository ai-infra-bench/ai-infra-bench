@@ -98,3 +100,60 @@ def test_get_bundles_sorted_by_node(bundles_to_node_id, bundle_specs, expected):
         result = get_bundles_sorted_by_node(mock_pg)
 
     assert result == expected
+
+
+@pytest.mark.parametrize("num_logprobs", [None, 0, 2])
+@pytest.mark.parametrize("cu_num_generated_tokens", [None, [0, 2, 3]])
+def test_ray_logprobs_serialization(num_logprobs, cu_num_generated_tokens):
+    ray = pytest.importorskip("ray")
+    from ray.util.serialization import StandaloneSerializationContext
+
+    output = ModelRunnerOutput(
+        req_ids=["req-0", "req-1"],
+        req_id_to_index={"req-0": 0, "req-1": 1},
+        sampled_token_ids=(
+            [[1], [3]] if cu_num_generated_tokens is None else [[1, 2], [3]]
+        ),
+    )
+    if num_logprobs is not None:
+        num_positions = sum(map(len, output.sampled_token_ids))
+        shape = (num_positions, num_logprobs + 1)
+        output.logprobs = LogprobsLists(
+            np.arange(np.prod(shape), dtype=np.int32).reshape(shape),
+            -np.arange(np.prod(shape), dtype=np.float32).reshape(shape),
+            np.array([1, 2, 1], dtype=np.int64)[:num_positions],
+            cu_num_generated_tokens,
+        )
+
+    # Exercise the worker's serializer registration without starting a cluster,
+    # and restore Ray's process-wide reducers after the test.
+    context = StandaloneSerializationContext()
+    with (
+        patch.dict(ray.cloudpickle.CloudPickler.dispatch),
+        patch.object(
+            ray._private.worker.global_worker,
+            "get_serialization_context",
+            return_value=context,
+        ),
+    ):
+        RayWorkerWrapper()
+        buffers = []
+        serialized = ray.cloudpickle.dumps(
+            output, protocol=5, buffer_callback=buffers.append
+        )
+        # Out-of-band NumPy buffers would pin the compiled DAG's shared memory
+        # channel while the engine's output thread retains the last response.
+        assert not buffers
+        restored = ray.cloudpickle.loads(serialized)
+
+    assert restored.req_ids == output.req_ids
+    assert restored.req_id_to_index == output.req_id_to_index
+    assert restored.sampled_token_ids == output.sampled_token_ids
+    if output.logprobs is None:
+        assert restored.logprobs is None
+    else:
+        assert isinstance(restored.logprobs, LogprobsLists)
+        assert restored.logprobs.cu_num_generated_tokens == cu_num_generated_tokens
+        for original, result in zip(output.logprobs[:3], restored.logprobs[:3]):
+            np.testing.assert_array_equal(result, original, strict=True)
+            assert not np.shares_memory(result, original)
