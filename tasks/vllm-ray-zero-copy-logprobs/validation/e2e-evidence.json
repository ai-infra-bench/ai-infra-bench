  "contract": {
    "surface_behavior": "A multi-node Ray compiled-DAG execution carrying vLLM logprob results must continue producing later results without changing request metadata, sampled completion tokens, logprob token IDs, logprob values, sampled ranks, or cumulative-token boundaries.",
    "allowed_implementations": [
      "detach channel-owned NumPy arrays after the Ray result is received",
      "restore Python-list serialization before the Ray transport",
      "any other implementation that preserves the same observable behavior"
    ],
    "non_requirements": [
      "NumPy as the internal LogprobsLists representation",
      "a particular NumPy dtype after transport",
      "memory detachment at FutureWrapper.result",
      "the oracle helper name or file placement"
    ]
  },
  "verifier_coverage": {
    "unit_tests": 12,
    "unit_dimensions": [
      "production LogprobsTensors.tolists conversion across four shape and numeric-type profiles",
      "representation-neutral token ID, logprob, rank, request metadata, and cumulative-token preservation",
      "sampled completion token preservation and agreement with the selected logprob entry",
      "repeated independent payloads without cross-request state mixing",
      "prompt-logprob tensor preservation",
      "empty logprob payloads",
      "None logprobs and unrelated sampled-token fields",
      "downstream LogprobsProcessor consumption",
      "real OpenAI completion response conversion preserving text, token IDs, logprobs, finish reason, usage, and the logprobs-disabled path",
      "JUnit collection, uniqueness, and no-skip integrity"
    ],
    "implementation_independence": [
      "does not import or call the oracle helper",
      "accepts NumPy-array and Python-list payload representations",
      "does not inspect memory sharing, writeability, object identity, or exact copy location",
