# Keep local runs and historical review artifacts out of submissions.
/validation/*
!/validation/ci-cases.json
!/validation/v2-alternative.patch
!/validation/v2-no-transition.patch
!/validation/v2-no-history.patch
!/validation/v2-no-notes.patch
!/validation/v2-early-exit.patch
!/validation/v2-ignore-empty-notes.patch
!/validation/v2-forge-reward.patch
!/validation/v2-repeat-history-loss.patch

__pycache__/
*.py[cod]
.env
.env.*
*.log
/environment/prefetch-debs.cjs
/environment/snapshot-index.cjs

# Keep the lossless JSON history regression control available to CI.
!/validation/patches/
/validation/patches/*
!/validation/patches/v2-json-history.patch
