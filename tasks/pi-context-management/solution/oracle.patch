+import { randomUUID } from "node:crypto";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import { estimateTokens, type ExtensionAPI, type ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const NOTE = "context-management.working-note";
+const WINDOW = "context-management.window";
+const PRESENTED = "context-management.presented-users";
+const REMINDED = "context-management.reminded";
+type Item = { window_id: string; item_id: string; role: string; tool_name?: string; text: string; original: AgentMessage };
+
+function snapshot(ctx: ExtensionContext) {
+	let note: string | undefined;
+	const items: Item[] = [];
+	let current: { id: string; message: AgentMessage }[] = [];
+	const presented = new Set<string>();
+	let reminded = false;
+	let windowId = `${ctx.sessionManager.getSessionId()}:initial`;
+	let transitioned = false;
+	for (const entry of ctx.sessionManager.getBranch()) {
+		if (entry.type === "custom" && entry.customType === NOTE) {
+			note = (entry.data as { text: string }).text;
+		} else if (entry.type === "custom" && entry.customType === WINDOW) {
+			const boundary = entry.data as { window_id: string; carry_ids?: string[] };
+			windowId = boundary.window_id;
+			const carry = new Set(boundary.carry_ids ?? []);
+			current = current.filter((item) => carry.has(item.id));
+			for (const item of items) if (carry.has(item.item_id)) item.window_id = windowId;
+			reminded = false;
+			transitioned = true;
+		} else if (entry.type === "custom" && entry.customType === PRESENTED) {
+			for (const id of (entry.data as { ids: string[] }).ids) presented.add(id);
+		} else if (entry.type === "custom" && entry.customType === REMINDED) {
+			if ((entry.data as { window_id: string }).window_id === windowId) reminded = true;
+		} else if (entry.type === "message") {
+			const message = entry.message;
+			if (message.role !== "user" && message.role !== "assistant" && message.role !== "toolResult") continue;
+			// A successful reply also establishes presentation for conversations
+			// created before this extension's own markers existed.
+			if (message.role === "assistant" && message.stopReason !== "error" && message.stopReason !== "aborted") {
+				for (const item of current) if (item.message.role === "user") presented.add(item.id);
+			}
+			current.push({ id: entry.id, message });
+			const text =
+				typeof message.content === "string"
+					? message.content
+					: message.content
+							.map((part) => {
+								if (part.type === "text") return part.text;
+								if (part.type === "thinking") return part.thinking;
+								if (part.type === "toolCall") return `${part.name}\n${JSON.stringify(part.arguments)}`;
+								return "";
+							})
+							.filter(Boolean)
+							.join("\n");
+			items.push({
+				window_id: windowId,
+				item_id: entry.id,
+				role: message.role === "toolResult" ? "tool" : message.role,
+				...(message.role === "toolResult" ? { tool_name: message.toolName } : {}),
+				text,
+				original: message,
+			});
+		}
+	}
+	return {
+		note,
+		items,
+		current: current.map((item) => item.message),
+		windowId,
+		transitioned,
+		reminded,
+		unseenUsers: current.filter((item) => item.message.role === "user" && !presented.has(item.id)),
+	};
+}
+
+function output(data: unknown) {
+	return { content: [{ type: "text" as const, text: JSON.stringify(data) }], details: {} };
+}
+
+export default function contextManagement(pi: ExtensionAPI) {
+	for (const name of ["context-reminder-tokens", "context-rollover-tokens", "context-response-headroom"]) {
+		pi.registerFlag(name, { type: "string", description: "Context management used-token budget" });
+	}
+	function positive(name: string, fallback: number) {
+		const flag = pi.getFlag(name);
+		const value = flag === undefined ? fallback : Number(flag);
+		if (!Number.isSafeInteger(value) || value <= 0) throw new Error(`${name} must be a positive integer`);
+		return value;
+	}
+	function budget(ctx: ExtensionContext) {
+		const capacity = ctx.model?.contextWindow ?? 128_000;
+		const headroom = positive("context-response-headroom", Math.max(ctx.model?.maxTokens ?? 4096, 4096));
+		if (headroom >= capacity) throw new Error("Response headroom leaves no input capacity");
+		const rollover = positive("context-rollover-tokens", Math.floor((capacity - headroom) * 0.9));
+		const reminder = positive("context-reminder-tokens", Math.floor(rollover * 0.75));
+		if (reminder >= rollover) throw new Error("Reminder must be below rollover");
+		return { reminder, rollover: Math.min(rollover, capacity - headroom), inputLimit: capacity - headroom };
+	}
+	function estimate(ctx: ExtensionContext, messages: AgentMessage[]) {
+		const active = new Set(pi.getActiveTools());
+		const tools = pi.getAllTools().filter((tool) => active.has(tool.name))
+			.map(({ name, description, parameters }) => ({ name, description, parameters }));
+		const setup: AgentMessage = { role: "user", content: ctx.getSystemPrompt() + "\n" + JSON.stringify(tools), timestamp: 0 };
+		return estimateTokens(setup) + messages.reduce((sum, message) => sum + estimateTokens(message), 0);
+	}
+	let pending: { session: string; window_id: string } | undefined;
+	pi.on("session_start", async () => {
+		pending = undefined;
+	});
+	pi.on("session_shutdown", async () => {
+		pending = undefined;
+	});
+	pi.on("session_before_compact", async (event) => {
+		if (event.reason !== "manual") return { cancel: true };
+	});
+	pi.on("turn_end", async (_event, ctx) => {
+		if (!pending) return;
+		const request = pending;
+		pending = undefined;
+		if (ctx.signal?.aborted || request.session !== ctx.sessionManager.getSessionId()) return;
+		// This boundary follows completion and persistence of the entire tool batch.
+		pi.appendEntry(WINDOW, { window_id: request.window_id });
+	});
+	pi.on("context", async (event, ctx) => {
+		try {
+			let state = snapshot(ctx);
+			function messages() {
+				const hint = `Current context window: ${state.windowId}. Read working notes with notes_read and original evidence with history_search/history_read. Choose working notes containing the task goal, relevant user instructions and corrections, progress, evidence references, and next steps. Use notes_write to replace them and new_context to reset. Saving notes is recommended, not required. Earlier user/assistant messages and tool results leave active context; use an empty history_search query to browse originals when needed.`;
+				const guide: AgentMessage = {
+					role: "user",
+					content: [
+						{
+							type: "text",
+							text: `${hint}${state.note !== undefined ? `\n\nWorking notes:\n${state.note}` : ""}`,
+						},
+					],
+					timestamp: 0,
+				};
+				return state.transitioned ? [guide, ...state.current] : [guide, ...event.messages];
+			}
+			const limits = budget(ctx);
+			let outgoing = messages();
+			const used = estimate(ctx, outgoing);
+			let roll = used >= limits.rollover;
+			let remind = false;
+			if (!roll && used >= limits.reminder && !state.reminded) {
+				outgoing = [...outgoing, {
+					role: "custom", customType: "context_capacity_reminder", display: false, timestamp: 0,
+					content: JSON.stringify({ remaining_tokens: Math.max(0, limits.rollover - used), message: "Save working notes before the next context reset." }),
+				}];
+				roll = estimate(ctx, outgoing) >= limits.rollover;
+				remind = !roll;
+			}
+			if (roll) {
+				// This hook runs only before an otherwise required model request, after
+				// tools finish. Preserve users not yet included in any prior request.
+				pi.appendEntry(WINDOW, { window_id: randomUUID(), carry_ids: state.unseenUsers.map((item) => item.id) });
+				state = snapshot(ctx);
+				outgoing = messages();
+			} else if (remind) {
+				pi.appendEntry(REMINDED, { window_id: state.windowId });
+			}
+			if (estimate(ctx, outgoing) >= limits.inputLimit) {
+				throw new Error(
+					"System setup, notes or pending input exceed available model input capacity; shorten them or choose a larger model",
+				);
+			}
+			if (state.unseenUsers.length) pi.appendEntry(PRESENTED, { ids: state.unseenUsers.map((item) => item.id) });
+			return { messages: outgoing };
+		} catch (error) {
+			// Pi reports extension-hook errors and otherwise keeps the original
+			// context. Abort the turn as well so an oversized request cannot escape.
+			ctx.abort();
+			throw error;
+		}
+	});
+
+	pi.registerTool({
+		name: "notes_write",
+		label: "Write working notes",
+		description:
+			"Replace the session's working notes with your current progress, conclusions, and next steps. The latest text is carried into each new context. This writes local durable state; it does not call a model.",
+		parameters: Type.Object({ text: Type.String() }),
+		executionMode: "sequential",
+		async execute(_id, args, signal, _update, _ctx) {
+			if (signal?.aborted) throw new Error("Operation aborted");
+			pi.appendEntry(NOTE, { text: args.text });
+			return output({ saved: true });
+		},
+	});
+	pi.registerTool({
+		name: "notes_read",
+		label: "Read working notes",
+		description: "Read this session's complete working notes. Before any write, returns empty text.",
+		parameters: Type.Object({}),
+		async execute(_id, _args, _signal, _update, ctx) {
+			return output({ text: snapshot(ctx).note ?? "" });
+		},
+	});
+	pi.registerTool({
+		name: "new_context",
+		label: "New context",
+		description:
+			"Start a fresh working context after the current tool batch finishes. Notes are optional. Continues the same session without a summarization call; preserves workspace files and saved notes. Earlier conversation is available through history.",
+		parameters: Type.Object({}),
+		executionMode: "sequential",
+		async execute(_id, _args, signal, _update, ctx) {
+			if (signal?.aborted) throw new Error("Operation aborted");
+			pending ??= { session: ctx.sessionManager.getSessionId(), window_id: randomUUID() };
+			return output({ window_id: pending.window_id });
+		},
+	});
+	pi.registerTool({
+		name: "history_search",
+		label: "Search original history",
+		description:
+			"Search original messages and tool results in this session by literal substring. Copy a returned window_id/item_id pair into history_read to retrieve that record. Previews show text around the match.",
+		parameters: Type.Object({ query: Type.String() }),
+		async execute(_id, args, _signal, _update, ctx) {
+			const items = snapshot(ctx)
+				.items.filter((item) => item.text.includes(args.query))
+				.map(({ text, original: _original, ...item }) => {
+					const index = text.indexOf(args.query);
+					const offset = Array.from(text.slice(0, index)).length;
+					const chars = Array.from(text);
+					return {
+						...item,
+						preview: chars.slice(Math.max(0, offset - 80), offset + 240).join(""),
+						match_offset: offset,
+						total_chars: chars.length,
+					};
+				});
+			return output({ items, next_cursor: null });
+		},
+	});
+	pi.registerTool({
+		name: "history_read",
+		label: "Read original record",
+		description:
+			"Read the complete original text of one history record using its window_id/item_id pair. This does not reload other records into the working context.",
+		parameters: Type.Object({ window_id: Type.String(), item_id: Type.String() }),
+		async execute(_id, args, _signal, _update, ctx) {
+			const item = snapshot(ctx).items.find(
+				(entry) => entry.window_id === args.window_id && entry.item_id === args.item_id,
+			);
+			if (!item) throw new Error("Record not found in this session");
+			const { original, ...metadata } = item;
+			return output({ ...metadata, text: JSON.stringify(original) });
+		},
+	});
+}
