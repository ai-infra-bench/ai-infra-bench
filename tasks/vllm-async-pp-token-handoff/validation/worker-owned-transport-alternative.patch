diff --git a/vllm/v1/worker/pp_async_tokens.py b/vllm/v1/worker/pp_async_tokens.py
new file mode 100644
index 000000000..96525204f
--- /dev/null
+++ b/vllm/v1/worker/pp_async_tokens.py
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""GPU-resident feedback for ordinary async pipeline decoding.
+
+The wire order is request-ID order, independent of either stage's batch layout.
+Only completed prefills/decodes participate. No message (including a header) is
+sent for an empty round. Both stages derive the protocol from scheduled work.
+"""
+
+from typing import TYPE_CHECKING
+
+import torch
+
+if TYPE_CHECKING:
+    from vllm.distributed.parallel_state import GroupCoordinator
+    from vllm.v1.core.sched.output import SchedulerOutput
+    from vllm.v1.worker.gpu_input_batch import CachedRequestState, InputBatch
+
+
+class PPAsyncTokens:
+    def __init__(self, pp_group: "GroupCoordinator", device: torch.device):
+        self.group = pp_group
+        self.device = device
+        # Use PyNCCL explicitly: GroupCoordinator.send/recv can fall back to
+        # blocking torch.distributed operations when PyNCCL is unavailable.
+        self.comm = pp_group.device_communicator.pynccl_comm
+        if self.comm is None or self.comm.disabled:
+            raise RuntimeError("Async PP requires an enabled PyNCCL communicator")
+        # Keep generated positions until completion so temporary descheduling
+        # or KV recomputation can replay an entire range, not just its last token.
+        self.tokens: dict[str, dict[int, torch.Tensor]] = {}
+        self.round: list[tuple[str, int, int]] = []
+
+    def prepare(
+        self,
+        batch: "InputBatch",
+        scheduler_output: "SchedulerOutput",
+        requests: dict[str, "CachedRequestState"],
+    ) -> None:
+        self.round = []
+        for req_id in scheduler_output.finished_req_ids:
+            self.tokens.pop(req_id, None)
+        for req_id in sorted(scheduler_output.num_scheduled_tokens):
+            index = batch.req_id_to_index[req_id]
+            end = (
+                int(batch.num_computed_tokens_cpu[index])
+                + scheduler_output.num_scheduled_tokens[req_id]
+            )
+            if end >= requests[req_id].num_tokens:
+                self.round.append((req_id, end, index))
+
+    def exchange(self, sampled: torch.Tensor | None = None) -> None:
+        if not self.round:
+            return
+        if self.group.is_last_rank:
+            assert sampled is not None
+            indices = torch.tensor(
+                [index for _, _, index in self.round],
+                dtype=torch.int64,
+                pin_memory=self.device.type == "cuda",
+            ).to(self.device, non_blocking=True)
+            tokens = sampled[indices, 0].to(torch.int32).contiguous()
+            self.comm.send(tokens, 0)
+        else:
+            assert sampled is None
+            tokens = torch.empty(len(self.round), dtype=torch.int32, device=self.device)
+            self.comm.recv(tokens, self.group.world_size - 1)
+        for i, (req_id, position, _) in enumerate(self.round):
+            self.tokens.setdefault(req_id, {})[position] = tokens[i]
+        # Retained views also keep asynchronous send/receive storage alive.
+        self.round = []
+
+    def apply(
+        self,
+        input_ids: torch.Tensor,
+        batch: "InputBatch",
+        scheduler_output: "SchedulerOutput",
+    ) -> None:
+        destinations = []
+        sources = []
+        offset = 0
+        for req_id in batch.req_ids:
+            index = batch.req_id_to_index[req_id]
+            start = int(batch.num_computed_tokens_cpu[index])
+            count = scheduler_output.num_scheduled_tokens[req_id]
+            cached = self.tokens.get(req_id, {})
+            for position in range(start, start + count):
+                if position in cached:
+                    destinations.append(offset + position - start)
+                    sources.append(cached[position])
+            offset += count
+        if sources:
+            indices = torch.tensor(
+                destinations,
+                dtype=torch.int64,
+                pin_memory=self.device.type == "cuda",
+            ).to(self.device, non_blocking=True)
+            input_ids.scatter_(0, indices, torch.stack(sources).to(input_ids.dtype))
