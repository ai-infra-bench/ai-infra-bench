diff --git a/vllm/v1/worker/pp_token_handoff.py b/vllm/v1/worker/pp_token_handoff.py
new file mode 100644
index 000000000..f7f776165
--- /dev/null
+++ b/vllm/v1/worker/pp_token_handoff.py
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from collections.abc import Iterable, Mapping
+from typing import TYPE_CHECKING
+
+import torch
+
+if TYPE_CHECKING:
+    from vllm.distributed.parallel_state import GroupCoordinator
+
+
+class PPTokenHandoff:
+    """GPU token history indexed by request and absolute token position.
+
+    Both stages use the scheduler's sampling manifest, independent of their
+    local batch ordering. NCCL operations run on the current CUDA stream:
+    subsequent model input copies depend on them without a host wait.
+    History survives batch removal/reordering and is released on completion.
+    """
+
+    def __init__(self, device: torch.device):
+        self.device = torch.device(device)
+        self.tokens: dict[str, dict[int, torch.Tensor]] = {}
+
+    def exchange(
+        self,
+        positions: Mapping[str, int] | None,
+        req_id_to_index: Mapping[str, int],
+        sampled_tokens: torch.Tensor | None,
+        pp_group: "GroupCoordinator",
+    ) -> None:
+        if not positions:
+            return
+        comm = getattr(pp_group.device_communicator, "pynccl_comm", None)
+        assert comm is not None and not comm.disabled
+        req_ids = sorted(positions)
+        if pp_group.is_last_rank:
+            assert sampled_tokens is not None
+            indices = self._indices([req_id_to_index[r] for r in req_ids])
+            tokens = sampled_tokens[:, 0].index_select(0, indices).to(torch.int64)
+            comm.send(tokens, dst=0)
+        else:
+            tokens = torch.empty(len(req_ids), dtype=torch.int64, device=self.device)
+            comm.recv(tokens, src=pp_group.world_size - 1)
+        for i, req_id in enumerate(req_ids):
+            self.tokens.setdefault(req_id, {})[positions[req_id]] = tokens[i : i + 1]
+
+    def prepare_inputs(
+        self,
+        input_ids: torch.Tensor,
+        req_ids: Iterable[str],
+        starts: Iterable[int],
+        counts: Iterable[int],
+    ) -> None:
+        destinations = []
+        sources = []
+        offset = 0
+        for req_id, start, count in zip(req_ids, starts, counts):
+            history = self.tokens.get(req_id, {})
+            for position in range(int(start), int(start + count)):
+                if position in history:
+                    destinations.append(offset + position - int(start))
+                    sources.append(history[position])
+            offset += int(count)
+        if sources:
+            indices = self._indices(destinations)
+            input_ids.index_copy_(0, indices, torch.cat(sources).to(input_ids.dtype))
+
+    def _indices(self, values: list[int]) -> torch.Tensor:
+        # A blocking H2D copy on the compute stream would also wait for the
+        # preceding NCCL receive. Keep even the routing metadata asynchronous.
+        return torch.tensor(
+            values, dtype=torch.int64, pin_memory=self.device.type == "cuda"
+        ).to(self.device, non_blocking=True)
+
+    def finish(self, req_ids: Iterable[str]) -> None:
+        for req_id in req_ids:
+            self.tokens.pop(req_id, None)
