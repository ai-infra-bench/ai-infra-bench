diff --git a/vllm/v1/worker/pipeline_token_exchange.py b/vllm/v1/worker/pipeline_token_exchange.py
new file mode 100644
index 0000000..99ac100
--- /dev/null
+++ b/vllm/v1/worker/pipeline_token_exchange.py
@@ -0,0 +1,29 @@
+"""Constructor-owned async pipeline token transport."""
+import torch
+from vllm.distributed.parallel_state import get_pp_group
+
+
+class PipelineTokenExchange:
+    def __init__(self, runner):
+        self.runner = runner
+        self.group = get_pp_group()
+        # Construct once; receive only slices this GPU buffer each round.
+        self.receive_buffer = torch.empty((runner.max_num_reqs, 1),
+                                          dtype=torch.int32, device=runner.device)
+
+    def send(self, tokens):
+        torch.distributed.broadcast(tokens, src=self.group.last_rank,
+                                    group=self.group.device_group)
+
+    def receive(self):
+        runner = self.runner
+        batch = runner.input_batch
+        tokens = self.receive_buffer[:batch.num_reqs]
+        torch.distributed.broadcast(tokens, src=self.group.last_rank,
+                                    group=self.group.device_group)
+        batch.prev_sampled_token_ids = tokens
+        kept = {request_id: i for i, request_id in enumerate(batch.req_ids)
+                if not runner.discard_request_mask.np[i]}
+        batch.prev_req_id_to_index = kept
+        for request_id in kept:
+            runner.requests[request_id].output_token_ids.append(-1)
