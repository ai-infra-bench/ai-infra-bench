+                broadcast_toks = self.input_batch.prev_sampled_token_ids.clone()
+                for inv_idx in invalid_req_indices:
+                    if inv_idx < broadcast_toks.shape[0]:
+                        broadcast_toks[inv_idx, 0] = -1
+                pp_group.broadcast_tensor_dict(
+                    {"sampled_token_ids": broadcast_toks},
+                    src=pp_group.world_size - 1,
+                )
