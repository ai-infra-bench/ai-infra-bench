@@ -3578,5 +3604,36 @@ class GPUModelRunner(
 
         if self.execute_model_state is None:
             # Nothing to do (PP non-final rank case), output isn't used.
+            # In async scheduling with PP we still need to receive the
+            # sampled token IDs broadcast by the last rank.
+            if self.use_async_scheduling:
+                pp_group = get_pp_group()
+                if pp_group.world_size > 1:
+                    num_reqs = self.input_batch.num_reqs
+                    broadcasted = pp_group.broadcast_tensor_dict(
+                        None, src=pp_group.world_size - 1
+                    )
+                    assert broadcasted is not None
+                    recv_token_ids: torch.Tensor = broadcasted["sampled_token_ids"]
+                    # recv_token_ids has shape (num_last_rank_reqs, 1); resize
+                    # to (num_reqs, 1) using the last-rank ordering.  Because
+                    # earlier ranks may have a different (but aligned) request
+                    # ordering, rebuild req_id_to_index and prev_sampled_token_ids
+                    # based on the current batch.
+                    self.input_batch.prev_sampled_token_ids = recv_token_ids[
+                        : num_reqs
+                    ]
+                    # Build prev_req_id_to_index from the current input batch,
+                    # excluding requests that were discarded (token id == -1 in
+                    # the received tensor means they should not be carried).
+                    self.input_batch.prev_req_id_to_index = {}
+                    for i, req_id in enumerate(self.input_batch.req_ids):
+                        if i < recv_token_ids.shape[0]:
+                            tok = recv_token_ids[i, 0].item()
+                            if tok != -1:
+                                self.input_batch.prev_req_id_to_index[req_id] = i
+                        else:
+                            self.input_batch.prev_req_id_to_index[req_id] = i
+
             if not kv_connector_output:
                 return None  # type: ignore[return-value]
