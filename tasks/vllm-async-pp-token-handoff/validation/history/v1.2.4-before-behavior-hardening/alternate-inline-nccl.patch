+    def _use_async_pp_token_handoff(self) -> bool:
+        """Whether sampled tokens must be handed off across PP ranks.
+
+        Only needed with async scheduling: the earlier ranks build the next
+        step's input_ids before the scheduler has seen this step's output. When
+        `broadcast_pp_output` is set (external_launcher), every rank samples the
+        same tokens locally, so no handoff is required.
+        """
+        return (
+            self.use_async_scheduling
+            and not self.broadcast_pp_output
+            and get_pp_group().world_size > 1
+        )
+
+    def _send_sampled_token_ids_to_pp_ranks(
+        self, sampled_token_ids: torch.Tensor
+    ) -> None:
+        """Broadcast the sampled tokens from the last PP rank to earlier ranks.
+
+        Called on the last PP rank only. The tokens stay on the GPU so that no
+        device-to-host synchronization is introduced in the critical path.
+        """
+        if not self._use_async_pp_token_handoff():
+            return
+        pp_group = get_pp_group()
+        assert pp_group.is_last_rank
+
+        # Only the newly sampled token of each request is needed downstream, so
+        # the shape is always [num_reqs, 1]. It is agreed upon implicitly: every
+        # rank derives num_reqs from its own persistent batch, which the
+        # scheduler keeps in sync across PP ranks. Sending it in a single
+        # collective avoids a preliminary shape exchange (and its latency).
+        torch.distributed.broadcast(
+            sampled_token_ids[:, :1].contiguous(),
+            src=pp_group.last_rank,
+            group=pp_group.device_group,
+        )
+
+    def _recv_sampled_token_ids_from_last_pp_rank(self) -> None:
+        """Receive the sampled tokens broadcast by the last PP rank.
+
+        Called on non-final PP ranks. The received tokens are cached in the
+        input batch so that `_prepare_input_ids` can scatter them into
+        `input_ids` on the GPU during the next step, exactly like the last
+        rank does with its own sampled tokens.
+        """
+        if not self._use_async_pp_token_handoff():
+            return
+        pp_group = get_pp_group()
+        assert not pp_group.is_last_rank
+
+        input_batch = self.input_batch
+        num_reqs = input_batch.num_reqs
+        if not num_reqs:
+            input_batch.prev_sampled_token_ids = None
+            input_batch.prev_req_id_to_index = None
+            return
+
+        # The last rank broadcasts exactly one sampled token per request, in
+        # the same [num_reqs, 1] layout that `prev_sampled_token_ids` uses.
+        sampled_token_ids = torch.empty(
+            (num_reqs, 1), dtype=torch.int32, device=self.device
+        )
+        torch.distributed.broadcast(
+            sampled_token_ids,
+            src=pp_group.last_rank,
+            group=pp_group.device_group,
+        )
+
+        # Requests whose sampled token must be dropped (e.g. still prefilling)
+        # are excluded from the index map, so `_prepare_input_ids` won't copy
+        # their placeholder into the next step's input_ids. Preserve the batch
+        # ordering so the row indices keep matching the sender's rows.
+        discard_mask = self.discard_request_mask.np[:num_reqs]
+        req_ids = input_batch.req_ids
+        prev_req_id_to_index: dict[str, int] = {}
+        for req_idx in range(num_reqs):
+            if discard_mask[req_idx]:
+                continue
+            req_id = req_ids[req_idx]
+            prev_req_id_to_index[req_id] = req_idx
+            # Mirror the last rank's bookkeeping: retained requests grow by one
+            # placeholder token, which is replaced by the real token id once the
+            # scheduler sends it back.
+            self.requests[req_id].output_token_ids.append(-1)
+
+        input_batch.prev_sampled_token_ids = sampled_token_ids
+        input_batch.prev_req_id_to_index = prev_req_id_to_index

