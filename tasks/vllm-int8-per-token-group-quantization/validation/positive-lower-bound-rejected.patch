@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.kernels.utils import opcheck
+from vllm.model_executor.layers.quantization.utils import int8_utils
+from vllm.platforms import current_platform
+from vllm.triton_utils import triton
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda(),
+    reason="Native INT8 group quantization is CUDA only")
+
+DTYPES = [torch.float16, torch.bfloat16, torch.float32]
+GROUP_SIZES = [1, 3, 32, 64, 128, 192, 256, 1024, 8193]
+
+
+def triton_quant(x, group_size, eps=1e-10, lower=-128, upper=127):
+    q = torch.empty_like(x, dtype=torch.int8)
+    s = torch.empty(x.shape[:-1] + (x.shape[-1] // group_size,),
+                    dtype=torch.float32, device=x.device)
+    block = triton.next_power_of_2(group_size)
+    if x.numel():
+        int8_utils._per_token_group_quant_int8[(x.numel() // group_size,)](
+            x, q, s, group_size, group_size, eps, lower, upper, BLOCK=block,
+            num_warps=min(max(block // 256, 1), 8), num_stages=1)
+    return q, s
+
+
+@pytest.mark.parametrize("dtype", DTYPES)
+@pytest.mark.parametrize("group_size", GROUP_SIZES)
+@pytest.mark.parametrize("unaligned", [False, True])
+def test_group_int8(dtype, group_size, unaligned):
+    torch.manual_seed(42)
+    shape = (3, 5, group_size * 3)
+    x = torch.randn(45 * group_size + int(unaligned),
+                    dtype=dtype, device="cuda")
+    x = x[int(unaligned):].view(shape)
+    q, s = int8_utils.per_token_group_quant_int8(x, group_size)
+    ref_q, ref_s = triton_quant(x, group_size)
+    assert q.dtype == torch.int8 and s.dtype == torch.float32
+    assert q.device == x.device and s.device == x.device
+    assert q.shape == x.shape and s.shape == (3, 5, 3)
+    torch.testing.assert_close(q, ref_q, atol=1, rtol=0)
+    torch.testing.assert_close(s, ref_s, atol=0, rtol=2e-6)
+
+
+@pytest.mark.parametrize("dtype", DTYPES)
+@pytest.mark.parametrize("group_size", [3, 64, 128])
+@pytest.mark.parametrize("eps,lower,upper", [(1e-10, -128, 127),
+                                           (1e-5, -64, 63), (1e-30, -7, 7)])
+def test_group_int8_range(dtype, group_size, eps, lower, upper):
+    finfo = torch.finfo(dtype)
+    # Include zeros, epsilon-dominated groups, tiny normal inputs, and values
+    # near the largest finite input (where multiplying by 127 would overflow).
+    factors = [0, eps / 4, finfo.tiny, 1e-4, 1, finfo.max / 2, finfo.max]
+    base = torch.linspace(-1, 1, group_size, device="cuda", dtype=torch.float32)
+    x = torch.stack([(base * factor).to(dtype) for factor in factors])
+    q, s = int8_utils.per_token_group_quant_int8(
+        x, group_size, eps, int8_min=lower, int8_max=upper)
+    ref_q, ref_s = triton_quant(x, group_size, eps, lower, upper)
+    torch.testing.assert_close(q, ref_q, atol=1, rtol=0)
+    torch.testing.assert_close(s, ref_s, atol=0, rtol=2e-6)
+    assert q.min() >= lower and q.max() <= upper
+
+
+@pytest.mark.parametrize("group_size", [64, 128])
+@pytest.mark.parametrize("eps", [1e-45, 1e-40, 1e-38, 1e-20,
+                                 1e-10, 1.0, 1e20, 1e38])
+def test_group_int8_extreme_scales(group_size, eps):
+    magnitudes = torch.tensor(
+        [0, 1e-44, 1e-40, 1e-38, 1e-35, 1e-20, 1, 1e20, 1e35, 3.4e38],
+        device="cuda")
+    x = magnitudes[:, None] * torch.linspace(
+        -1, 1, group_size, device="cuda")[None, :]
+    q, s = int8_utils.per_token_group_quant_int8(x, group_size, eps)
+    ref_q, ref_s = triton_quant(x, group_size, eps)
+    torch.testing.assert_close(q, ref_q, atol=1, rtol=0)
+    torch.testing.assert_close(s, ref_s, atol=0, rtol=2e-6)
+
+
+@pytest.mark.parametrize("shape", [(0, 128), (2, 0), (2, 0, 128), (0, 3, 0)])
+def test_group_int8_empty(shape):
+    x = torch.empty(shape, device="cuda", dtype=torch.bfloat16)
+    q, s = int8_utils.per_token_group_quant_int8(x, 64)
+    assert q.shape == x.shape
+    assert s.shape == x.shape[:-1] + (x.shape[-1] // 64,)
+    assert q.dtype == torch.int8 and s.dtype == torch.float32
+    assert q.device == x.device and s.device == x.device
+    # Also exercise the native operator directly, bypassing Python's return.
+    torch.ops._C.per_token_group_quant_int8(x, q, s, 64, 1e-10, -128, 127)
+    assert (torch.ones(1, device="cuda") + 1).item() == 2
+    torch.cuda.synchronize()
+
+
+def test_group_int8_dispatch_and_fallback(monkeypatch):
+    x = torch.randn(7, 256, dtype=torch.bfloat16, device="cuda")
+    native = torch.ops._C.per_token_group_quant_int8
+    calls = []
+
+    def tracked(*args):
+        calls.append(True)
+        return native(*args)
+
+    monkeypatch.setattr(torch.ops._C, "per_token_group_quant_int8", tracked)
+    q, s = int8_utils.per_token_group_quant_int8(x, 128)
+    assert calls == [True]
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: False)
+    ref_q, ref_s = int8_utils.per_token_group_quant_int8(x, 128)
+    assert calls == [True]
+    torch.testing.assert_close(q, ref_q, atol=1, rtol=0)
+    torch.testing.assert_close(s, ref_s, atol=0, rtol=2e-6)
+
+
+def test_group_int8_missing_operator(monkeypatch):
+    x = torch.randn(7, 256, dtype=torch.bfloat16, device="cuda")
+    ref_q, ref_s = triton_quant(x, 128)
+    monkeypatch.setattr(torch.ops, "_C", SimpleNamespace())
