diff --git a/benchmarks/kernels/bench_per_token_group_quant_int8.py b/benchmarks/kernels/bench_per_token_group_quant_int8.py
new file mode 100644
--- /dev/null
+++ b/benchmarks/kernels/bench_per_token_group_quant_int8.py
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Compare public CUDA and original Triton INT8 group quantization.
+
+Run with: python3 benchmarks/kernels/bench_per_token_group_quant_int8.py
+Times include output allocation and launch overhead, using CUDA events around
+400 ordinary calls per batch (no CUDA graphs). Reports all five batch averages.
+"""
+
+import json
+import statistics
+
+import torch
+
+from vllm.model_executor.layers.quantization.utils.int8_utils import (
+    _per_token_group_quant_int8, per_token_group_quant_int8)
+from vllm.triton_utils import triton
+
+CASES = [((1024, 4096), 128), ((4096, 4096), 128), ((2048, 4096), 64),
+         ((16, 256, 4096), 128), ((4096, 4096), 64)]
+
+
+def reference(x, group):
+    q = torch.empty_like(x, dtype=torch.int8)
+    s = torch.empty(x.shape[:-1] + (x.shape[-1] // group,),
+                    dtype=torch.float32, device=x.device)
+    block = triton.next_power_of_2(group)
+    _per_token_group_quant_int8[(x.numel() // group,)](
+        x, q, s, group, group, 1e-10, -128, 127, BLOCK=block,
+        num_warps=min(max(block // 256, 1), 8), num_stages=1)
+    return q, s
+
+
+def batch_us(fn, x, group):
+    start, end = (torch.cuda.Event(enable_timing=True) for _ in range(2))
+    start.record()
+    for _ in range(400):
+        fn(x, group)
+    end.record()
+    end.synchronize()
+    return start.elapsed_time(end) * 1000 / 400
+
+
+@torch.inference_mode()
+def main():
+    torch.manual_seed(0)
+    print(torch.cuda.get_device_name(0), flush=True)
+    results = []
+    for shape, group in CASES:
+        x = torch.randn(shape, dtype=torch.bfloat16, device="cuda:0")
+        q, s = per_token_group_quant_int8(x, group)
+        rq, rs = reference(x, group)
+        torch.testing.assert_close(q, rq, atol=1, rtol=0)
+        torch.testing.assert_close(s, rs, atol=0, rtol=2e-6)
+        for fn in (per_token_group_quant_int8, reference):
+            for _ in range(40):
+                fn(x, group)
+        torch.cuda.synchronize()
+        native, baseline = [], []
+        for _ in range(5):
+            native.append(batch_us(per_token_group_quant_int8, x, group))
+            baseline.append(batch_us(reference, x, group))
+        result = dict(shape=shape, group_size=group, native_us=native,
+                      triton_us=baseline,
+                      native_median_us=statistics.median(native),
+                      triton_median_us=statistics.median(baseline),
+                      speedup=(statistics.median(baseline)
+                               / statistics.median(native)))
+        results.append(result)
+        print(json.dumps(result), flush=True)
+    assert all(r["speedup"] >= 1.5 for r in results), results
+
+
+if __name__ == "__main__":
+    main()
diff --git a/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu b/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu
new file mode 100644
--- /dev/null
+++ b/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <torch/all.h>
+
+#include <cmath>
+#include <limits>
+
+#include "../../dispatch_utils.h"
+
+namespace {
+
+template <int Width>
+__device__ __forceinline__ float group_max(float value) {
+#pragma unroll
+  for (int offset = Width / 2; offset > 0; offset /= 2) {
+    value = fmaxf(value, __shfl_xor_sync(__activemask(), value, offset, Width));
+  }
+  return value;
+}
+
+__device__ __forceinline__ int8_t quantize(float value, float scale,
+                                        float inverse_scale, float lower,
+                                        float upper) {
+  // Fall back to division when the reciprocal overflows for tiny scales.
+  const float q = isfinite(inverse_scale) ? value * inverse_scale
+                                        : __fdiv_rn(value, scale);
+  return static_cast<int8_t>(fminf(fmaxf(q, lower), upper));
+}
+
+// Eight adjacent elements per lane provide vector loads and stores. Independent
+// subwarps reduce a group each, with no shared memory or block barriers.
+template <typename T, int GroupSize>
+__global__ void quantize_vector(const T* __restrict__ input,
+                               int8_t* __restrict__ output,
+                               float* __restrict__ scales, int64_t groups,
+                               float eps, float lower, float upper) {
+  constexpr int Width = GroupSize / 8;
+  const int lane = threadIdx.x % Width;
+  const int64_t group = (int64_t(blockIdx.x) * blockDim.x + threadIdx.x) / Width;
+  if (group >= groups) return;
+  const int64_t start = group * GroupSize + lane * 8;
+  struct alignas(16) InputVector {
+    T values[8];
+  };
+  struct alignas(8) OutputVector {
+    int8_t values[8];
+  };
+  const auto data = *reinterpret_cast<const InputVector*>(input + start);
+  float values[8];
+  float amax = eps;
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    values[i] = static_cast<float>(data.values[i]);
+    amax = fmaxf(amax, fabsf(values[i]));
+  }
+  amax = group_max<Width>(amax);
+  const float scale = __fdiv_rn(amax, upper);
+  const float inverse_scale = __fdiv_rn(1.0f, scale);
+  if (lane == 0) scales[group] = scale;
+  OutputVector result;
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    result.values[i] = quantize(values[i], scale, inverse_scale, lower, upper);
+  }
+  *reinterpret_cast<OutputVector*>(output + start) = result;
+}
+
+// Arbitrary group sizes and unaligned contiguous tensor views.
+template <typename T>
+__global__ void quantize_generic(const T* __restrict__ input,
+                                int8_t* __restrict__ output,
+                                float* __restrict__ scales, int64_t groups,
+                                int64_t group_size, float eps, float lower,
+                                float upper) {
+  const int lane = threadIdx.x % 32;
+  const int64_t group = (int64_t(blockIdx.x) * blockDim.x + threadIdx.x) / 32;
+  if (group >= groups) return;
+  const int64_t start = group * group_size;
+  float amax = eps;
+  for (int64_t i = lane; i < group_size; i += 32) {
+    amax = fmaxf(amax, fabsf(static_cast<float>(input[start + i])));
+  }
+  const float scale = __fdiv_rn(group_max<32>(amax), upper);
+  const float inverse_scale = __fdiv_rn(1.0f, scale);
+  if (lane == 0) scales[group] = scale;
+  for (int64_t i = lane; i < group_size; i += 32) {
+    output[start + i] = quantize(static_cast<float>(input[start + i]), scale,
+                                inverse_scale, lower, upper);
+  }
+}
+
+}  // namespace
+
+void per_token_group_quant_int8(const torch::Tensor& input,
+                               torch::Tensor& output_q, torch::Tensor& output_s,
+                               int64_t group_size, double eps, double int8_min,
+                               double int8_max) {
+  TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+  TORCH_CHECK(input.dim() >= 2, "input must have at least two dimensions");
+  TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+  TORCH_CHECK(group_size > 0 && input.size(-1) % group_size == 0,
+              "last dimension must be divisible by a positive group_size");
+  TORCH_CHECK(input.scalar_type() == at::kHalf ||
+                  input.scalar_type() == at::kBFloat16 ||
+                  input.scalar_type() == at::kFloat,
+              "input must be FP16, BF16 or FP32");
+  TORCH_CHECK(std::isfinite(eps) && eps > 0 && static_cast<float>(eps) > 0 &&
+                  eps <= std::numeric_limits<float>::max(),
+              "eps must be positive and finite in FP32");
+  TORCH_CHECK(int8_min >= -128 && int8_min <= 0 && int8_max > 0 &&
+                  int8_max <= 127 && std::floor(int8_min) == int8_min &&
+                  std::floor(int8_max) == int8_max,
+              "bounds must be integers with -128 <= min <= 0 < max <= 127");
+  TORCH_CHECK(output_q.device() == input.device() &&
+                  output_s.device() == input.device(),
+              "outputs must be on the input device");
+  TORCH_CHECK(output_q.scalar_type() == at::kChar &&
+                  output_q.sizes() == input.sizes() && output_q.is_contiguous(),
+              "output_q must be contiguous INT8 with the input shape");
+  auto scale_shape = input.sizes().vec();
+  scale_shape.back() /= group_size;
+  TORCH_CHECK(output_s.scalar_type() == at::kFloat &&
+                  output_s.sizes() == scale_shape && output_s.is_contiguous(),
+              "output_s must be contiguous FP32 with one scale per group");
+  const int64_t groups = input.numel() / group_size;
+  // Never launch a zero-block grid: that poisons subsequent CUDA operations.
+  if (groups == 0) return;
+  const c10::cuda::CUDAGuard guard(input.device());
+  const auto stream = at::cuda::getCurrentCUDAStream();
+  constexpr int threads = 256;
+  VLLM_DISPATCH_FLOATING_TYPES(
+      input.scalar_type(), "per_token_group_quant_int8", [&] {
+        const auto* in = input.data_ptr<scalar_t>();
+        auto* out = output_q.data_ptr<int8_t>();
+        auto* scales = output_s.data_ptr<float>();
+        const bool aligned = reinterpret_cast<uintptr_t>(in) % 16 == 0 &&
+                             reinterpret_cast<uintptr_t>(out) % 8 == 0;
+        if (group_size == 64 && aligned) {
+          quantize_vector<scalar_t, 64><<<(groups + 31) / 32, threads, 0, stream>>>(
+              in, out, scales, groups, eps, int8_min, int8_max);
+        } else if (group_size == 128 && aligned) {
+          quantize_vector<scalar_t, 128><<<(groups + 15) / 16, threads, 0, stream>>>(
+              in, out, scales, groups, eps, int8_min, int8_max);
+        } else {
+          quantize_generic<scalar_t><<<(groups + 7) / 8, threads, 0, stream>>>(
+              in, out, scales, groups, group_size, eps, int8_min, int8_max);
+        }
+      });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
