@@ -0,0 +1,267 @@
+#include <ATen/cuda/CUDAContext.h>
+#include <torch/all.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include "../vectorization.cuh"
+#include "../../dispatch_utils.h"
+
+namespace vllm {
+namespace {
+
+// Reduce `val` to its maximum across the `WIDTH` lanes that cooperate on a
+// single quantization group. `WIDTH` is a power of two <= 32 and the group is
+// warp aligned, so the exchange never crosses a warp boundary.
+template <int WIDTH>
+__device__ __forceinline__ float group_reduce_max(float val,
+                                                 const unsigned mask) {
+#pragma unroll
+  for (int offset = WIDTH / 2; offset > 0; offset >>= 1) {
+    val = fmaxf(val, __shfl_xor_sync(mask, val, offset));
+  }
+  return val;
+}
+
+__device__ __forceinline__ int8_t float_to_int8_rn(float x) {
+  uint32_t dst;
+  asm volatile("cvt.rni.sat.s8.f32 %0, %1;" : "=r"(dst) : "f"(x));
+  return reinterpret_cast<const int8_t&>(dst);
+}
+
+// Fast path: every group is covered by exactly THREADS_PER_GROUP threads, each
+// holding VECS_PER_THREAD 16B vectors in registers, so the input is read from
+// global memory only once.
+template <typename T, int THREADS_PER_GROUP, int VECS_PER_THREAD>
+__global__ void per_token_group_quant_int8_kernel(
+    const T* __restrict__ input, int8_t* __restrict__ output_q,
+    float* __restrict__ output_s, const int group_size, const float eps,
+    const float int8_min, const float int8_max) {
+  constexpr int VEC_SIZE = 16 / sizeof(T);
+  using vec_t = vllm::vec_n_t<T, VEC_SIZE>;
+  using qvec_t = vllm::q8_n_t<int8_t, VEC_SIZE>;
+
+  const int groups_per_block = blockDim.x / THREADS_PER_GROUP;
+  const int local_group_id = threadIdx.x / THREADS_PER_GROUP;
+  const int lane_id = threadIdx.x % THREADS_PER_GROUP;
+  const int64_t group_id =
+      static_cast<int64_t>(blockIdx.x) * groups_per_block + local_group_id;
+  const int64_t group_offset = group_id * group_size;
+
+  constexpr unsigned kGroupMask =
+      (THREADS_PER_GROUP == 32) ? 0xffffffffu
+                                : ((1u << THREADS_PER_GROUP) - 1u);
+  const unsigned mask = kGroupMask << ((threadIdx.x % 32) &
+                                       ~static_cast<unsigned>(
+                                           THREADS_PER_GROUP - 1));
+
+  const vec_t* group_input =
+      reinterpret_cast<const vec_t*>(input + group_offset);
+  qvec_t* group_output = reinterpret_cast<qvec_t*>(output_q + group_offset);
+
+  vec_t vals[VECS_PER_THREAD];
+  float local_absmax = eps;
+#pragma unroll
+  for (int i = 0; i < VECS_PER_THREAD; ++i) {
+    vals[i] = group_input[lane_id + i * THREADS_PER_GROUP];
+#pragma unroll
+    for (int j = 0; j < VEC_SIZE; ++j) {
+      local_absmax = fmaxf(local_absmax, fabsf(static_cast<float>(vals[i].val[j])));
+    }
+  }
+
+  const float absmax = group_reduce_max<THREADS_PER_GROUP>(local_absmax, mask);
+  // Both the Triton kernel and the torch reference form the scale as
+  // `absmax * (1 / int8_max)`, which differs from a correctly rounded division
+  // by one ULP. Reproduce that exactly so the scales stay bit-identical.
+  const float y_s = absmax * __frcp_rn(int8_max);
+  if (lane_id == 0) {
+    output_s[group_id] = y_s;
+  }
+
+  // Reciprocal of the scale, so the per element work is a multiply.
+  const float inv_scale = __frcp_rn(y_s);
+#pragma unroll
+  for (int i = 0; i < VECS_PER_THREAD; ++i) {
+    qvec_t out;
+#pragma unroll
+    for (int j = 0; j < VEC_SIZE; ++j) {
+      const float q = fminf(
+          fmaxf(static_cast<float>(vals[i].val[j]) * inv_scale, int8_min),
+          int8_max);
+      out.val[j] = float_to_int8_rn(q);
+    }
+    group_output[lane_id + i * THREADS_PER_GROUP] = out;
+  }
+}
+
+// Fallback for group sizes / alignments the vectorized path cannot cover: one
+// warp per group with a scalar strided loop.
+template <typename T>
+__global__ void per_token_group_quant_int8_generic_kernel(
+    const T* __restrict__ input, int8_t* __restrict__ output_q,
+    float* __restrict__ output_s, const int group_size, const float eps,
+    const float int8_min, const float int8_max) {
+  const int64_t group_id = blockIdx.x;
+  const int lane_id = threadIdx.x;
+  const int64_t group_offset = group_id * static_cast<int64_t>(group_size);
+
+  const T* group_input = input + group_offset;
+  int8_t* group_output = output_q + group_offset;
+
+  float local_absmax = eps;
+  for (int i = lane_id; i < group_size; i += 32) {
+    local_absmax =
+        fmaxf(local_absmax, fabsf(static_cast<float>(group_input[i])));
+  }
+
+  const float absmax = group_reduce_max<32>(local_absmax, 0xffffffffu);
+  const float y_s = absmax * __frcp_rn(int8_max);
+  if (lane_id == 0) {
+    output_s[group_id] = y_s;
+  }
+
+  const float inv_scale = __frcp_rn(y_s);
+  for (int i = lane_id; i < group_size; i += 32) {
+    const float q = fminf(
+        fmaxf(static_cast<float>(group_input[i]) * inv_scale, int8_min),
+        int8_max);
+    group_output[i] = float_to_int8_rn(q);
+  }
+}
+
+// Number of groups handled per block. Batch groups together up to a 256 thread
+// block so large inputs amortize the block launch cost, but keep at least one
+// block per SM so small inputs stay latency bound rather than serialized.
+int pick_groups_per_block(int64_t num_groups, int threads_per_group,
+                          int num_sms) {
+  const int64_t block_cap = std::max(1, 256 / threads_per_group);
+  const int64_t sm_cap = std::max<int64_t>(1, num_groups / std::max(1, num_sms));
+  const int64_t cap = std::min(block_cap, sm_cap);
+  int groups_per_block = 1;
+  for (int64_t cand = 2; cand <= cap; cand <<= 1) {
+    if (num_groups % cand != 0) {
+      break;
+    }
+    groups_per_block = static_cast<int>(cand);
+  }
+  return groups_per_block;
+}
+
+}  // namespace
+}  // namespace vllm
+
+void per_token_group_quant_int8(const torch::Tensor& input,
+                               torch::Tensor& output_q, torch::Tensor& output_s,
+                               int64_t group_size, double eps, double int8_min,
+                               double int8_max) {
+  TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+  TORCH_CHECK(output_q.is_contiguous(), "output_q must be contiguous");
+  TORCH_CHECK(output_s.is_contiguous(), "output_s must be contiguous");
+  TORCH_CHECK(output_q.scalar_type() == at::ScalarType::Char,
+              "output_q must be int8");
+  TORCH_CHECK(output_s.scalar_type() == at::ScalarType::Float,
+              "output_s must be float32");
+  TORCH_CHECK(group_size > 0, "group_size must be positive");
+  TORCH_CHECK(input.numel() % group_size == 0,
+              "input numel must be divisible by group_size");
+  TORCH_CHECK(output_q.numel() == input.numel(),
+              "output_q must have the same number of elements as input");
+
+  const int64_t num_groups = input.numel() / group_size;
+  TORCH_CHECK(output_s.numel() == num_groups,
+              "output_s must hold one scale per group");
+  if (num_groups == 0) {
+    return;
+  }
+
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+  const int num_sms =
+      at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+  const bool ptr_aligned =
+      (reinterpret_cast<uintptr_t>(input.data_ptr()) % 16 == 0) &&
+      (reinterpret_cast<uintptr_t>(output_q.data_ptr()) % 16 == 0);
+
+#define LAUNCH_VEC_KERNEL(T, THREADS_PER_GROUP, VECS_PER_THREAD)              \
+  do {                                                                       \
+    const int groups_per_block = vllm::pick_groups_per_block(                \
+        num_groups, THREADS_PER_GROUP, num_sms);                              \
+    dim3 grid(num_groups / groups_per_block);                                 \
+    dim3 block(groups_per_block* THREADS_PER_GROUP);                          \
+    vllm::per_token_group_quant_int8_kernel<T, THREADS_PER_GROUP,             \
+                                            VECS_PER_THREAD>                  \
+        <<<grid, block, 0, stream>>>(                                         \
+            static_cast<T*>(input.data_ptr()),                                \
+            static_cast<int8_t*>(output_q.data_ptr()),                        \
+            static_cast<float*>(output_s.data_ptr()),                         \
+            static_cast<int>(group_size), static_cast<float>(eps),            \
+            static_cast<float>(int8_min), static_cast<float>(int8_max));      \
+  } while (0)
+
+#define DISPATCH_VECS_PER_THREAD(T, THREADS_PER_GROUP, VECS_PER_THREAD) \
+  case VECS_PER_THREAD:                                                 \
+    LAUNCH_VEC_KERNEL(T, THREADS_PER_GROUP, VECS_PER_THREAD);           \
+    break;
+
+#define DISPATCH_THREADS_PER_GROUP(T, THREADS_PER_GROUP)         \
+  case THREADS_PER_GROUP:                                        \
+    switch (vecs_per_thread) {                                   \
+      DISPATCH_VECS_PER_THREAD(T, THREADS_PER_GROUP, 1)          \
+      DISPATCH_VECS_PER_THREAD(T, THREADS_PER_GROUP, 2)          \
+      DISPATCH_VECS_PER_THREAD(T, THREADS_PER_GROUP, 4)          \
+      default:                                                   \
+        TORCH_CHECK(false, "unsupported vecs_per_thread");        \
+    }                                                            \
+    break;
+
+  VLLM_DISPATCH_FLOATING_TYPES(
+      input.scalar_type(), "per_token_group_quant_int8", ([&] {
+        constexpr int vec_size = 16 / sizeof(scalar_t);
+        // Pick the smallest number of vectors per thread (i.e. the widest
+        // spread of a group over threads) that tiles the group exactly.
+        int threads_per_group = 0;
+        int vecs_per_thread = 0;
+        if (ptr_aligned && group_size % vec_size == 0) {
+          const int64_t num_vecs = group_size / vec_size;
+          for (int cand : {1, 2, 4}) {
+            if (num_vecs % cand != 0) {
+              continue;
+            }
+            const int64_t cand_threads = num_vecs / cand;
+            if (cand_threads <= 32 &&
+                (cand_threads & (cand_threads - 1)) == 0) {
+              threads_per_group = static_cast<int>(cand_threads);
+              vecs_per_thread = cand;
+              break;
+            }
+          }
+        }
+
+        switch (threads_per_group) {
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 1)
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 2)
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 4)
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 8)
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 16)
+          DISPATCH_THREADS_PER_GROUP(scalar_t, 32)
+          default:
+            vllm::per_token_group_quant_int8_generic_kernel<scalar_t>
+                <<<dim3(num_groups), dim3(32), 0, stream>>>(
+                    static_cast<scalar_t*>(input.data_ptr()),
+                    static_cast<int8_t*>(output_q.data_ptr()),
+                    static_cast<float*>(output_s.data_ptr()),
+                    static_cast<int>(group_size), static_cast<float>(eps),
+                    static_cast<float>(int8_min),
+                    static_cast<float>(int8_max));
+            break;
+        }
+      }));
+
+#undef DISPATCH_THREADS_PER_GROUP
+#undef DISPATCH_VECS_PER_THREAD
+#undef LAUNCH_VEC_KERNEL
+}
