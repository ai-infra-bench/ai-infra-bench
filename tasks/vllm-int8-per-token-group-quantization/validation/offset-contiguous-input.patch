+// Oversized or unaligned groups use scalar reads. One warp reduces the group
+// and rereads it for quantization, with no shared allocation or alignment assumption.
+template <typename T>
+__global__ void per_token_group_quant_int8_streaming_kernel(
+    const T* input, int8_t* output_q, float* output_s, int64_t group_size,
+    float eps, float lower, float upper) {
+  const int64_t offset = static_cast<int64_t>(blockIdx.x) * group_size;
+  float absmax = eps;
+  for (int64_t i = threadIdx.x; i < group_size; i += 32) {
+    absmax = fmaxf(absmax, fabsf(static_cast<float>(input[offset + i])));
+  }
+  for (int delta = 16; delta > 0; delta /= 2) {
+    absmax = fmaxf(absmax, __shfl_xor_sync(0xffffffffu, absmax, delta));
+  }
+  const float scale = absmax / upper;
+  if (threadIdx.x == 0) output_s[blockIdx.x] = scale;
+  for (int64_t i = threadIdx.x; i < group_size; i += 32) {
+    const float value = static_cast<float>(input[offset + i]) / scale;
+    output_q[offset + i] = static_cast<int8_t>(fminf(fmaxf(value, lower), upper));
+  }
+}
+
+void per_token_group_quant_int8(const torch::Tensor& input,
+                                torch::Tensor& output_q,
+                                torch::Tensor& output_s, int64_t group_size,
+                                double eps, double int8_min, double int8_max) {
+  TORCH_CHECK(group_size > 0);
+  TORCH_CHECK(input.is_contiguous() && output_q.is_contiguous());
+  TORCH_CHECK(input.dim() >= 2 && input.size(-1) % group_size == 0);
+  TORCH_CHECK(output_q.scalar_type() == at::ScalarType::Char);
+  TORCH_CHECK(output_s.scalar_type() == at::ScalarType::Float);
+  const int64_t num_groups = input.numel() / group_size;
+  TORCH_CHECK(output_q.numel() == input.numel());
+  TORCH_CHECK(output_s.numel() == num_groups);
+  if (num_groups == 0) return;
+  const size_t shared_limit =
+      at::cuda::getCurrentDeviceProperties()->sharedMemPerBlock;
+  if (group_size % 16 != 0 ||
+      static_cast<size_t>(group_size) * input.element_size() > shared_limit) {
+    TORCH_CHECK(output_s.is_contiguous());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+    VLLM_DISPATCH_FLOATING_TYPES(
+        input.scalar_type(), "per_token_group_quant_int8_streaming", ([&] {
+          per_token_group_quant_int8_streaming_kernel<scalar_t>
+              <<<num_groups, 32, 0, stream>>>(
+                  input.data_ptr<scalar_t>(), output_q.data_ptr<int8_t>(),
+                  output_s.data_ptr<float>(), group_size, static_cast<float>(eps),
+                  static_cast<float>(int8_min), static_cast<float>(int8_max));
+        }));
+    return;
+  }
+  per_token_group_quant_8bit(input, output_q, output_s, group_size, eps,
+                             int8_min, int8_max);
+}
