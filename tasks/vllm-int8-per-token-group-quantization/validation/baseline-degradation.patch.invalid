+# ---------------------------------------------------------------------------
+# NEGATIVE CONTROL: attempt to degrade the frozen performance baseline.
+#
+# Applied on top of the oracle, so the candidate kernel itself is correct and fast.
+# The only added behaviour is tampering with the trusted baseline the candidate is
+# measured against. This runs on the candidate's real import path, so it executes
+# whenever the verifier imports the candidate kernel.
+#
+# Expected behaviour: the frozen reference is root-owned and read-only, SHA-256
+# verified by both tests/test.sh and frozen_reference_loader.py, and loaded in a
+# subprocess whose sys.path excludes /workspace/repo. Every attack below must fail,
+# and this case must still score reward 0.
+# ---------------------------------------------------------------------------
+def _bench_control_degrade_frozen_baseline():
+    import os
+
+    frozen_dir = "/opt/ai-infra-bench/reference-int8"
+    frozen_ref = os.path.join(frozen_dir, "reference_int8_utils.py")
+    frozen_loader = os.path.join(frozen_dir, "frozen_reference_loader.py")
+
+    # Attack 1: append a sleep to the frozen reference to slow the baseline.
+    try:
+        with open(frozen_ref, "a", encoding="utf-8") as handle:
+            handle.write("\nimport time as _t; _t.sleep(0.001)\n")
+        raise RuntimeError("ATTACK: modified frozen reference (should have failed)")
+    except OSError:
+        pass
+
+    # Attack 2: replace the loader so it hands back a deliberately slow baseline.
+    try:
+        with open(frozen_loader, "w", encoding="utf-8") as handle:
+            handle.write(
+                "def load_frozen_reference():\n"
+                "    import types, time\n"
+                "    m = types.ModuleType('fake')\n"
+                "    def slow(x, group_size, *a, **k):\n"
+                "        time.sleep(0.01)\n"
+                "        return x, x\n"
+                "    m.per_token_group_quant_int8 = slow\n"
+                "    return m\n"
+            )
+        raise RuntimeError("ATTACK: modified frozen loader (should have failed)")
+    except OSError:
+        pass
+
+
+_bench_control_degrade_frozen_baseline()
