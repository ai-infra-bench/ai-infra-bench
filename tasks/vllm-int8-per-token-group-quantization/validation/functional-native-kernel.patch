diff --git a/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu b/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu
new file mode 100644
--- /dev/null
+++ b/csrc/quantization/compressed_tensors/per_token_group_quant_int8.cu
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include <torch/all.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <cmath>
+#include <limits>
+
+namespace {
+template <typename T, int N>
+struct alignas(sizeof(T) * N) Pack {
+  T values[N];
+};
+
+// Each subgroup owns a group; vector loads and register reuse avoid shared
+// memory and give a block many groups to amortize scheduling overhead.
+template <typename T, int Group>
+__global__ void quant_group(const T* __restrict__ x, int8_t* __restrict__ q,
+                            float* __restrict__ scales, int64_t groups,
+                            float eps, float lower, float upper) {
+  constexpr int Vec = 8;
+  constexpr int Width = Group / Vec;
+  const int lane = threadIdx.x % Width;
+  const int64_t group = (int64_t(blockIdx.x) * blockDim.x + threadIdx.x) / Width;
+  if (group >= groups) return;
+  const int64_t offset = group * Group + lane * Vec;
+  Pack<T, Vec> input = *reinterpret_cast<const Pack<T, Vec>*>(x + offset);
+  float values[Vec];
+  float amax = eps;
+#pragma unroll
+  for (int i = 0; i < Vec; ++i) {
+    values[i] = static_cast<float>(input.values[i]);
+    amax = fmaxf(amax, fabsf(values[i]));
+  }
+  const unsigned mask = __activemask();
+#pragma unroll
+  for (int delta = Width / 2; delta; delta /= 2)
+    amax = fmaxf(amax, __shfl_xor_sync(mask, amax, delta, Width));
+  // Explicit IEEE division preserves tiny and very large FP32 scales even
+  // when the rest of the extension is compiled with --use_fast_math.
+  const float scale = __fdiv_rn(amax, upper);
+  if (lane == 0) scales[group] = scale;
+  Pack<int8_t, Vec> output;
+#pragma unroll
+  for (int i = 0; i < Vec; ++i) {
+    const float value = __fdiv_rn(values[i], scale);
+    output.values[i] = static_cast<int8_t>(fminf(upper, fmaxf(lower, value)));
+  }
+  *reinterpret_cast<Pack<int8_t, Vec>*>(q + offset) = output;
+}
+
+// Arbitrary positive group sizes, including sizes smaller than one warp.
+template <typename T>
+__global__ void quant_group_generic(const T* __restrict__ x,
+                                    int8_t* __restrict__ q,
+                                    float* __restrict__ scales, int64_t groups,
+                                    int64_t size, float eps, float lower,
+                                    float upper) {
+  const int lane = threadIdx.x % 32;
+  const int64_t group = (int64_t(blockIdx.x) * blockDim.x + threadIdx.x) / 32;
+  if (group >= groups) return;
+  float amax = eps;
+  for (int64_t i = lane; i < size; i += 32)
+    amax = fmaxf(amax, fabsf(static_cast<float>(x[group * size + i])));
+  for (int delta = 16; delta; delta /= 2)
+    amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, delta));
+  const float scale = __fdiv_rn(amax, upper);
+  if (lane == 0) scales[group] = scale;
+  for (int64_t i = lane; i < size; i += 32) {
+    const float value = __fdiv_rn(static_cast<float>(x[group * size + i]), scale);
+    q[group * size + i] = static_cast<int8_t>(fminf(upper, fmaxf(lower, value)));
+  }
+}
+}  // namespace
+
+std::tuple<torch::Tensor, torch::Tensor> per_token_group_quant_int8(
+    const torch::Tensor& input, int64_t group_size, double eps,
+    int64_t int8_min, int64_t int8_max) {
+  TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+  TORCH_CHECK(input.dim() >= 2, "input must have at least two dimensions");
+  TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+  TORCH_CHECK(group_size > 0 && input.size(-1) % group_size == 0,
+              "group_size must be positive and divide the last dimension");
+  TORCH_CHECK(input.scalar_type() == at::kHalf ||
+                  input.scalar_type() == at::kBFloat16 ||
+                  input.scalar_type() == at::kFloat,
+              "input must be FP16, BF16 or FP32");
+  TORCH_CHECK(std::isfinite(eps) && eps > 0 &&
+                  eps <= std::numeric_limits<float>::max() && float(eps) > 0,
+              "eps must be positive and representable in FP32");
+  TORCH_CHECK(int8_min >= -128 && int8_min < int8_max && int8_max > 0 &&
+                  int8_max <= 127,
+              "INT8 bounds must satisfy -128 <= min < max <= 127 and max > 0");
+  const c10::cuda::CUDAGuard guard(input.device());
+  auto output = torch::empty_like(input, input.options().dtype(at::kChar));
+  auto shape = input.sizes().vec();
+  shape.back() /= group_size;
+  auto scales = torch::empty(shape, input.options().dtype(at::kFloat));
+  const int64_t groups = input.numel() / group_size;
+  if (groups == 0) return {output, scales};
+  const auto stream = at::cuda::getCurrentCUDAStream(input.get_device());
+  AT_DISPATCH_FLOATING_TYPES_AND2(at::kHalf, at::kBFloat16, input.scalar_type(),
+                                "per_token_group_quant_int8", [&] {
+    const auto* x = input.data_ptr<scalar_t>();
+    auto* q = output.data_ptr<int8_t>();
+    auto* s = scales.data_ptr<float>();
+    // Contiguous views may still have an unaligned storage offset.
+    const bool aligned =
+        reinterpret_cast<uintptr_t>(x) % (8 * sizeof(scalar_t)) == 0;
+    if (group_size == 64 && aligned) {
+      quant_group<scalar_t, 64><<<(groups + 31) / 32, 256, 0, stream>>>(
+          x, q, s, groups, eps, int8_min, int8_max);
+    } else if (group_size == 128 && aligned) {
+      quant_group<scalar_t, 128><<<(groups + 15) / 16, 256, 0, stream>>>(
+          x, q, s, groups, eps, int8_min, int8_max);
+    } else {
+      quant_group_generic<scalar_t><<<(groups + 7) / 8, 256, 0, stream>>>(
+          x, q, s, groups, group_size, eps, int8_min, int8_max);
+    }
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return {output, scales};
+}
