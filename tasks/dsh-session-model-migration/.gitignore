# Keep local runs and historical review artifacts out of submissions.
/validation/*
!/validation/ci-cases.json
!/validation/early-exit.patch
!/validation/forged-report.patch
!/validation/no-budget.patch
!/validation/no-revision-check.patch
!/validation/global-default.patch
!/validation/no-reasoning-transfer.patch
!/validation/no-chat-reasoning.patch
!/validation/volatile-selection.patch
!/validation/alternative-payload-projection.patch
!/validation/equivalent-error-wording.patch
!/validation/old-reference.patch
!/validation/model-original.patch
!/validation/v005-oracle.patch
!/validation/runner-reward.patch
!/validation/native-exit-zero.patch
!/validation/alternative-config-schema.patch
!/validation/stale-source-budget.patch
!/validation/renamed-private-catalog.patch

__pycache__/
*.py[cod]
.env
.env.*
*.log
/environment/image-manifest.json
/environment/verifier-image-manifest.json
