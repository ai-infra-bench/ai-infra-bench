+/** Checked Session model migration through the real agent loop and durable log. */
+
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent, AgentHandle, ModelSelection } from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-agent-default-model'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime, { createUserMessage, LlmAdapter, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, LlmResolvedModelInfo, StreamChunk } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import TokenMeter from '@deepseek-ai/dsh-token-meter'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ApiSessionAgentController } from '../src/agent.ts'
+import { SessionCommandController } from '../src/commands.ts'
+import { installModelSelectionProjection } from '../src/model-selection-projection.ts'
+
+function textResponse(text: string): StreamChunk[] {
+  return [
+    { type: 'block-start', index: 0, blockType: 'text' },
+    { type: 'text-delta', index: 0, text },
+    { type: 'block-end', index: 0, block: { type: 'text', text } },
+    { type: 'usage', usage: { inputTokens: 10, outputTokens: 2 } },
+    { type: 'finish', reason: { kind: 'stop' } },
+  ]
+}
+
+function toolResponse(callId: string, reasoning: string): StreamChunk[] {
+  return [
+    { type: 'block-start', index: 0, blockType: 'reasoning' },
+    { type: 'reasoning-delta', index: 0, text: reasoning },
+    { type: 'block-end', index: 0, block: { type: 'reasoning', text: reasoning } },
+    { type: 'block-start', index: 1, blockType: 'tool-call' },
+    { type: 'tool-call-delta', index: 1, id: ToolCallId(callId), name: 'echo', argumentsDelta: '{"text":"ok"}' },
+    {
+      type: 'block-end',
+      index: 1,
+      block: { type: 'tool-call', id: ToolCallId(callId), name: 'echo', arguments: '{"text":"ok"}' },
+    },
+    { type: 'usage', usage: { inputTokens: 10, outputTokens: 4 } },
+    { type: 'finish', reason: { kind: 'tool-calls' } },
+  ]
+}
+
+type ResolveGate = (signal: AbortSignal | undefined) => Promise<void>
+
+class MigrationAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+  override readonly resolveModel = vi.fn(async (
+    provider: string,
+    model: string,
+    signal?: AbortSignal,
+  ): Promise<LlmResolvedModelInfo> => {
+    await this.resolveGate?.(signal)
+    return {
+      provider,
+      id: model,
+      name: model,
+      ...this.contextWindow === undefined ? {} : { context: { contextWindow: this.contextWindow } },
+      ...this.defaultMaxTokens === undefined ? {} : { defaultMaxTokens: this.defaultMaxTokens },
+    }
+  })
+
+  constructor(
+    private readonly script: StreamChunk[][],
+    private readonly contextWindow?: number,
+    private readonly defaultMaxTokens?: number,
+    private readonly resolveGate?: ResolveGate,
+  ) {
+    super()
+  }
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    const response = this.script.shift()
+    if (response === undefined) throw new Error('migration adapter script exhausted')
+    for (const chunk of response) yield chunk
+  }
+}
+
+interface MigrationHarness {
+  readonly ctx: Context
+  readonly controller: SessionCommandController
+  readonly agents: ApiSessionAgentController
+  readonly saveSelection: ReturnType<typeof vi.fn>
+}
+
+async function migrationHarness(
+  adapters: Readonly<Record<string, MigrationAdapter>>,
+  defaultSelection: ModelSelection = { provider: 'source', model: 'large' },
+): Promise<MigrationHarness> {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt, { persona: 'Keep the retained work.' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(TokenMeter)
+  installModelSelectionProjection(ctx)
+  for (const [provider, adapter] of Object.entries(adapters)) {
+    ctx.llm.registerAdapter([provider], adapter)
+  }
+  const saveSelection = vi.fn(() => Promise.resolve())
+  ctx.provide('agentDefaultModel', {
+    currentSelection: () => defaultSelection,
+    saveSelection,
+  } as never)
+  const dispose = (): void => {}
+  ctx.provide('typert', {
+    lookups: { configure: () => dispose },
+    contexts: { configureHost: () => dispose },
+  } as never)
+  const agents = new ApiSessionAgentController(ctx)
+  ctx.tools.register(defineContentToolFixture({
+    name: 'echo',
+    description: 'Echo a value.',
+    parameters: { text: { type: 'string' } },
+    async execute(args) {
+      return [{ type: 'text', text: `echo:${args.text}` }]
+    },
+  }))
+  return { ctx, controller: new SessionCommandController(ctx, agents, '/tmp'), agents, saveSelection }
+}
+
+async function createAgent(
+  harness: MigrationHarness,
+  sessionId: SessionId,
+  options: ModelSelection & { maxTokens?: number },
+  persisted?: { events: readonly SessionEvent[]; header: SessionHeader },
+): Promise<AgentHandle> {
+  const composition = await harness.agents.composeAgent(undefined)
+  return harness.ctx.agents.create({
+    sessionId,
+    agentOptions: options,
+    ...persisted === undefined ? { meta: { cwd: '/tmp' } } : {
+      seed: persisted.events,
+      meta: { ...persisted.header.cwd === undefined ? {} : { cwd: persisted.header.cwd } },
+    },
+    setup: composition.setup,
+  })
+}
+
+function send(agent: Agent, text: string): Promise<void> {
+  const idle = new Promise<void>((resolve) => {
+    const dispose = agent.ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject === agent && status === 'idle') {
+        dispose()
+        resolve()
+      }
+    })
+  })
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+  return idle
+}
+
+const contexts: Context[] = []
+afterEach(async () => {
+  await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose()))
+})
+
+describe('checked Session model migration', () => {
+  it('reopens on the durable destination and continues retained tool history', async () => {
+    const source = new MigrationAdapter([
+      toolResponse('source-call', 'inspect the original work'),
+      textResponse('source complete'),
+    ], 8_192, 64)
+    const destinationCheck = new MigrationAdapter([], 8_192, 128)
+    const first = await migrationHarness({ source, destination: destinationCheck })
+    contexts.push(first.ctx)
+    const sessionId = SessionId('checked-reopen')
+    const firstHandle = await createAgent(first, sessionId, { provider: 'source', model: 'large' })
+
+    await send(firstHandle.agent, 'start with a tool')
+    expect(source.requests[0]?.maxTokens).toBe(64)
+    const retained = firstHandle.agent.session.deriveMessages()
+    const measure = vi.spyOn(first.ctx.tokenMeter, 'measure')
+    const selected = await first.controller.selectModel({
+      sessionId, provider: 'destination', model: 'small', migration: 'checked',
+    })
+
+    expect(selected.selected).toEqual({ provider: 'destination', model: 'small' })
+    expect(measure).toHaveBeenCalledTimes(1)
+    const measuredHeader = measure.mock.calls[0]?.[1]
+    expect(measuredHeader?.config).toMatchObject({ provider: 'destination', model: 'small', maxTokens: 128 })
+    expect(measuredHeader?.system).toContain('Keep the retained work.')
+    expect(measuredHeader?.tools?.some(tool => tool.name === 'echo')).toBe(true)
+    const other = await createAgent(first, SessionId('checked-other-session'), {
+      provider: 'source', model: 'large',
+    })
+    expect(first.agents.selectionFor(other.agent).current).toEqual({ provider: 'source', model: 'large' })
+    await other.dispose()
+    expect(destinationCheck.requests).toHaveLength(0)
+    expect(first.saveSelection).not.toHaveBeenCalled()
+    const persisted = {
+      events: structuredClone(firstHandle.agent.session.snapshotEvents()),
+      header: structuredClone(firstHandle.agent.session.header),
+    }
+    await firstHandle.dispose()
+    await first.ctx.fiber.dispose()
