  "verifier_contract": {
    "behavior_cases": 38,
    "collection_integrity": "Exactly 38 unique passing cases, with zero skips/errors, plus all six E2E scenarios are required for reward 1.",
    "asserts_private_implementation_structure": false,
    "imports_oracle_helpers": false,
    "behaviors": [
      "mixed full-attention and GDN workers initialize through the existing connector interface",
      "full-attention, MLA, sliding-window MLA, and both GDN conv and temporal-state payloads reach their matching destination blocks",
      "null state placeholders are ignored; unrequested backing bytes remain unchanged, excluding only padding within requested GDN pages",
      "padded attention views and production-shaped shared-page GDN views stay within valid registered memory",
      "full-attention and GDN groups can share one backing allocation and base address while retaining distinct transfer regions and destination blocks",
      "full-attention, MLA, and sliding-window MLA logical-to-physical block ratios greater than one do not overlap or corrupt neighboring blocks",
      "failed transfers and producer-consumer layout or group-count mismatches cannot report completion with incorrect destination state",
      "for supported prompts of at least two elements, cache-only GDN remote prefill and decode preserve the exact final-element recomputation boundary for token IDs and prompt embeddings on producer and consumer sides",
      "consumer prompt embeddings wait for N-1 remote elements, resume with one local element after transfer completion, and preserve pure-attention accounting",
      "the exact two-element supported boundary works for token IDs and prompt embeddings on producer and consumer schedulers",
      "non-power-of-two logical-to-physical ratios preserve requested payloads through the composed transfer E2E",
      "partial-prefix transfers select each producer group's requested suffix while preserving null placeholders and untouched destination data",
      "cold and fully cached warm requests complete and a subsequent request confirms the prefill scheduler remains healthy",
      "pure full-attention Mooncake transfer and NIXL GDN remote-prefill token accounting remain compatible",
      "non-GDN DeepSeek MLA and sliding-window MLA select real MLA model/topology semantics, preserve both shared-storage layer payloads and untouched gaps, and support partial-prefix transfers at physical ratios one, three, and four",
      "legal source-terminal and destination-terminal attention requests complete at physical ratios one and five, copy the entire requested payload through its final byte, and preserve all unrequested backing bytes",
      "real producer and consumer Scheduler outputs cross bind_connector_metadata/start_load_kv; actual worker get_finished events let the waiting consumer resume and both sides complete",
      "scheduler handoff covers cold token IDs, two-element IDs and embeddings, warm ratio-three prefixes and ratio-four embeddings; expected destinations derive from actual cache allocators",
      "mixed float16/float32 GDN state occupies 200 bytes of a declared 256-byte page; ratios one/four and two successive partial-prefix transfers preserve both states and every unrequested page"
    ],
    "registration_fairness": "Reward observes completion and destination bytes, not registration count, length, storage coverage, descriptor count, private candidate fields or Oracle helper structure. The payload-bounded alternative derives registered extents from transferable regions and may omit unused trailing storage padding; the split-registration alternative remains accepted.",
    "e2e_scenarios": 6,
    "padding_fairness": "Both GDN state tensor payloads are required byte-for-byte. Requested GDN page tails may be copied or preserved. All bytes outside the union of requested attention payloads and requested GDN pages remain unchanged. Attention/GDN views alias the allocation; unused alias views are not separately live state."
  },
  "e2e_boundary": {
    "path": "P/D Request input -> real Scheduler.add_request/schedule -> scheduler-produced connector metadata -> real bind_connector_metadata/start_load_kv, bootstrap discovery parsing, message encoding, registration and pointer-copy planning -> real worker get_finished events -> real Scheduler.update_from_output/schedule -> exact destination state, one local recomputed element and completed producer/consumer requests",
    "additional_paths": "Existing isolated full-attention/GDN, shared-backing, non-GDN MLA and sliding-MLA transfer scenes remain. A fifth scene covers mixed-dtype padded GDN transfers; the sixth runs the complete real scheduler/worker handoff.",
    "substitution": "Model forward outputs and CPU cache contents are deterministic. Native RDMA is replaced by registered-range-checked ctypes.memmove. Bootstrap HTTP returns one producer endpoint; loopback transport preserves real production encoding, parsing, pull-task creation and completion handling. No send/receive connector metadata, remote-agent task count or completion event is fabricated in the new handoff.",
    "preserved_semantics": "Prompt input kind/order, cold/warm prefix lifecycle, allocator-selected block IDs, cache-group order, shared storage, physical expansion, GDN page strides/offsets/dtypes, both state payloads, untouched pages, and production receive/send completion events.",
    "limitations": "The verifier does not execute GPU kernels, model weights, native Mooncake RDMA/NVLink, multi-node transport, or full-model accuracy evaluation. It does not claim coverage for Mamba variants other than GDN."
  },
