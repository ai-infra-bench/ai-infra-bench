+void computeAlignedExpertFirstTokenOffset(
+    int64_t const* expert_first_token_offset,
+    int64_t* align_expert_first_token_offset, int num_local_expert,
+    const int align_block_size, cudaStream_t stream) {
+  constexpr int block = 256;
+  computeAlignedExpertFirstTokenOffsetKernel<block><<<1, block, 0, stream>>>(
+      expert_first_token_offset, align_expert_first_token_offset,
+      num_local_expert, align_block_size);
+}
