+// Block-aligned prefix sum of the per-expert token counts. This is the single
+// place the aligned expert ranges are derived, so every later consumer only
+// needs constant-time lookups:
+//   align_expert_first_token_offset[0] = 0
+//   align_expert_first_token_offset[e + 1] =
+//       align_expert_first_token_offset[e] + round_up(n_token_in_expert[e])
+template <int BLOCK_THREADS>
+__global__ void computeAlignedExpertFirstTokenOffsetKernel(
+    int64_t const* expert_first_token_offset,
+    int64_t* align_expert_first_token_offset, const int num_local_expert,
+    const int align_block_size) {
+  using BlockScan = cub::BlockScan<int64_t, BLOCK_THREADS>;
+  __shared__ typename BlockScan::TempStorage temp_storage;
+  __shared__ int64_t accumulate_align_offset;
+
+  if (threadIdx.x == 0) {
+    align_expert_first_token_offset[0] = 0;
+    accumulate_align_offset = 0;
+  }
+  __syncthreads();
+
+  for (int base = 0; base < num_local_expert; base += BLOCK_THREADS) {
+    int const eidx = base + threadIdx.x;
+    int64_t n_align_token_in_expert = 0;
+    if (eidx < num_local_expert) {
+      int64_t const n_token_in_expert =
+          __ldg(expert_first_token_offset + eidx + 1) -
+          __ldg(expert_first_token_offset + eidx);
+      n_align_token_in_expert = (n_token_in_expert + align_block_size - 1) /
+                                align_block_size * align_block_size;
+    }
+    int64_t align_offset = 0;
+    BlockScan(temp_storage).InclusiveSum(n_align_token_in_expert, align_offset);
+    if (eidx < num_local_expert) {
+      align_expert_first_token_offset[eidx + 1] =
+          accumulate_align_offset + align_offset;
+    }
+    // carry this chunk's total into the next one, and make temp_storage
+    // reusable for the following scan
+    __syncthreads();
+    if (threadIdx.x == BLOCK_THREADS - 1) {
+      accumulate_align_offset += align_offset;
+    }
+    __syncthreads();
+  }
+}
