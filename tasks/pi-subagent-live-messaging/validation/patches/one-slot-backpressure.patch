+import type { ChildProcess } from "node:child_process";
+
+export const MAX_TEAM_MESSAGE_BYTES = 64 * 1024;
+export const MAX_TEAM_INBOX_BYTES = 4 * 1024 * 1024;
+export const TEAM_CHANNEL = "pi-subagent-team";
+
+export interface TeamMessage {
+	from: string;
+	message: string;
+}
+
+export interface TeamSendResult {
+	accepted: string[];
+	failed: { id: string; reason: string }[];
+}
+
+export type TeamRequest =
+	| { action: "ready" | "members" | "close" }
+	| { action: "send"; args: unknown }
+	| { action: "drain"; finish: boolean };
+
+export interface TeamReply {
+	self: string;
+	members?: { id: string }[];
+	messages?: TeamMessage[];
+	closed?: boolean;
+	result?: TeamSendResult;
+}
+
+interface Member {
+	state: "starting" | "running" | "finished";
+	messages: TeamMessage[];
+	bytes: number;
+}
+
+export function validateTeamIds(tasks: { id?: string }[]): void {
+	const ids = new Set<string>();
+	for (const task of tasks) {
+		if (typeof task.id !== "string" || !task.id.trim()) {
+			throw new Error("communication: true requires a nonempty string id on every parallel task.");
+		}
+		if (ids.has(task.id)) throw new Error(`Duplicate team task id: ${JSON.stringify(task.id)}`);
+		ids.add(task.id);
+	}
+}
+
+export function validateTeamSend(args: unknown): { to?: string; broadcast?: true; message: string } {
+	if (!args || typeof args !== "object" || Array.isArray(args)) throw new Error("Expected a message object.");
+	const value = args as Record<string, unknown>;
+	if (Object.keys(value).some((key) => !["to", "broadcast", "message"].includes(key))) {
+		throw new Error("Only to, broadcast, and message are supported.");
+	}
+	const hasTo = Object.hasOwn(value, "to");
+	const hasBroadcast = Object.hasOwn(value, "broadcast");
+	if (
+		hasTo === hasBroadcast ||
+		(hasTo && (typeof value.to !== "string" || !value.to.trim())) ||
+		(hasBroadcast && value.broadcast !== true)
+	) {
+		throw new Error("Specify exactly one of a nonempty to or broadcast: true.");
+	}
+	if (typeof value.message !== "string" || value.message.length === 0) {
+		throw new Error("message must be a nonempty string.");
+	}
+	if (Buffer.byteLength(value.message, "utf8") > MAX_TEAM_MESSAGE_BYTES) {
+		throw new Error(`message exceeds ${MAX_TEAM_MESSAGE_BYTES} UTF-8 bytes.`);
+	}
+	return hasTo ? { to: value.to as string, message: value.message } : { broadcast: true, message: value.message };
+}
+
+export class TeamBroker {
+	private members = new Map<string, Member>();
+	private cleanups = new Set<() => void>();
+	private disposed = false;
+
+	constructor(ids: string[]) {
+		validateTeamIds(ids.map((id) => ({ id })));
+		for (const id of ids) this.members.set(id, { state: "starting", messages: [], bytes: 0 });
+	}
+
+	request(self: string, request: TeamRequest): TeamReply {
+		const member = this.members.get(self);
+		if (this.disposed || !member) throw new Error("Team is unavailable.");
+		if (request.action === "close") {
+			this.finish(self);
+			return { self, closed: true };
+		}
+		if (request.action === "ready") {
+			if (member.state !== "starting") throw new Error("Worker cannot join this team again.");
+			member.state = "running";
+			return { self };
+		}
+		if (member.state !== "running") throw new Error("Worker is not running.");
+		switch (request.action) {
+			case "members":
+				return {
+					self,
+					members: [...this.members].filter(([, peer]) => peer.state === "running").map(([id]) => ({ id })),
+				};
+			case "send": {
+				const args = validateTeamSend(request.args);
+				const recipients = args.broadcast
+					? [...this.members].filter(([id, peer]) => id !== self && peer.state === "running").map(([id]) => id)
+					: [args.to!];
+				const result: TeamSendResult = { accepted: [], failed: [] };
+				const bytes = Buffer.byteLength(args.message, "utf8");
+				for (const id of recipients) {
+					const peer = this.members.get(id);
+					const reason =
+						id === self
+							? "Cannot send to yourself."
+							: !peer
+								? "Unknown teammate."
+								: peer.state !== "running"
+									? "Teammate is not running."
+									: peer.messages.length >= 1
+										? "Teammate inbox is full."
+										: undefined;
+					if (reason || !peer) {
+						result.failed.push({ id, reason: reason ?? "Unknown teammate." });
+					} else {
+						peer.messages.push({ from: self, message: args.message });
+						peer.bytes += bytes;
+						result.accepted.push(id);
+					}
+				}
+				return { self, result };
+			}
+			case "drain": {
+				const messages = member.messages;
+				member.messages = [];
+				member.bytes = 0;
+				const closed = request.finish && messages.length === 0;
+				if (closed) this.finish(self);
+				return { self, messages, closed };
+			}
+			default:
+				throw new Error("Unknown team request.");
+		}
+	}
+
+	attach(id: string, child: ChildProcess): void {
+		const onMessage = (value: unknown) => {
+			if (!value || typeof value !== "object") return;
+			const packet = value as { channel?: string; sequence?: number; request?: TeamRequest };
+			if (packet.channel !== TEAM_CHANNEL || !Number.isSafeInteger(packet.sequence) || !packet.request) return;
+			let reply: TeamReply | undefined;
+			let error: string | undefined;
+			try {
+				reply = this.request(id, packet.request);
+			} catch (cause) {
+				error = cause instanceof Error ? cause.message : String(cause);
+			}
+			if (child.connected) {
+				child.send({ channel: TEAM_CHANNEL, sequence: packet.sequence, reply, error }, (cause) => {
+					if (cause) this.finish(id);
+				});
+			}
+		};
+		const cleanup = () => {
+			this.finish(id);
+			child.off("message", onMessage);
+			child.off("disconnect", cleanup);
+			child.off("close", cleanup);
+			this.cleanups.delete(cleanup);
+		};
+		child.on("message", onMessage);
+		child.once("disconnect", cleanup);
+		child.once("close", cleanup);
+		this.cleanups.add(cleanup);
+	}
+
+	finish(id: string): void {
+		const member = this.members.get(id);
+		if (!member) return;
+		member.state = "finished";
+		member.messages = [];
+		member.bytes = 0;
+	}
+
+	dispose(): void {
+		this.disposed = true;
+		for (const cleanup of this.cleanups) cleanup();
+		this.members.clear();
+	}
+}
diff --git a/packages/coding-agent/examples/extensions/subagent/team-worker.ts b/packages/coding-agent/examples/extensions/subagent/team-worker.ts
