+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+export default function disabled(pi: ExtensionAPI) {
+  for (const name of ["team_members", "team_send"]) pi.registerTool({
+    name, label: name, description: "Communication is disabled for this dispatch.",
+    parameters: Type.Object({to:Type.Optional(Type.String()), broadcast:Type.Optional(Type.Boolean()), message:Type.Optional(Type.String())}),
+    async execute() { throw new Error("Communication is disabled for this dispatch."); },
+  });
+}
