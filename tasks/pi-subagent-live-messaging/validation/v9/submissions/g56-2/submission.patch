new file mode 100644
index 000000000..1b639b57b
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/subagent/team.ts
@@ -0,0 +1,421 @@
+import { randomBytes, timingSafeEqual } from "node:crypto";
+import * as net from "node:net";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+export const TEAM_MESSAGE_MAX_BYTES = 64 * 1024;
+
+const TEAM_HOST = "127.0.0.1";
+const MAX_REQUEST_BYTES = TEAM_MESSAGE_MAX_BYTES * 6 + 8 * 1024;
+const TEAM_PORT_ENV = "PI_SUBAGENT_TEAM_PORT";
+const TEAM_TOKEN_ENV = "PI_SUBAGENT_TEAM_TOKEN";
+const TEAM_WORKER_ID_ENV = "PI_SUBAGENT_TEAM_WORKER_ID";
+
+export interface TeamMember {
+	id: string;
+	agent: string;
+	task: string;
+}
+
+export interface TeamMessage {
+	sender: string;
+	text: string;
+}
+
+type WorkerStatus = "pending" | "running" | "finished";
+
+interface WorkerState {
+	member: TeamMember;
+	token: string;
+	status: WorkerStatus;
+	deliver?: (message: TeamMessage) => Promise<void>;
+	deliveryQueue: Promise<void>;
+}
+
+type TeamRequest =
+	| { token: string; action: "list" }
+	| { token: string; action: "send"; recipient: string; message: string }
+	| { token: string; action: "broadcast"; message: string };
+
+export type TeamRequestBody =
+	| { action: "list" }
+	| { action: "send"; recipient: string; message: string }
+	| { action: "broadcast"; message: string };
+
+interface TeamFailure {
+	recipient: string;
+	error: string;
+}
+
+export type TeamResponse =
+	| {
+			ok: true;
+			self: Pick<TeamMember, "id" | "agent">;
+			teammates: Array<Pick<TeamMember, "id" | "agent"> & { status: WorkerStatus }>;
+	  }
+	| { ok: true; delivered: string[]; failed: TeamFailure[] }
+	| { ok: false; error: string; delivered?: string[]; failed?: TeamFailure[] };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function tokensMatch(expected: string, actual: string): boolean {
+	const expectedBuffer = Buffer.from(expected);
+	const actualBuffer = Buffer.from(actual);
+	return expectedBuffer.length === actualBuffer.length && timingSafeEqual(expectedBuffer, actualBuffer);
+}
+
+function validateMessage(message: unknown): string | undefined {
+	if (typeof message !== "string" || message.length === 0) return "message must be a non-empty string";
+	const byteLength = Buffer.byteLength(message, "utf8");
+	if (byteLength > TEAM_MESSAGE_MAX_BYTES) {
+		return `message is ${byteLength} bytes; maximum is ${TEAM_MESSAGE_MAX_BYTES} UTF-8 bytes`;
+	}
+	return undefined;
+}
+
+function parseRequest(value: unknown): TeamRequest | string {
+	if (!isRecord(value) || typeof value.token !== "string" || typeof value.action !== "string") {
+		return "request must contain string token and action fields";
+	}
+	if (value.action === "list") return { token: value.token, action: "list" };
+	if (value.action === "send") {
+		if (typeof value.recipient !== "string" || typeof value.message !== "string") {
+			return "send requires string recipient and message fields";
+		}
+		return { token: value.token, action: "send", recipient: value.recipient, message: value.message };
+	}
+	if (value.action === "broadcast") {
+		if (typeof value.message !== "string") return "broadcast requires a string message field";
+		return { token: value.token, action: "broadcast", message: value.message };
+	}
+	return `unsupported action: ${value.action}`;
+}
+
+export function formatTeamMessage(message: TeamMessage): string {
+	return `[Message from teammate ${message.sender}]\n${message.text}`;
+}
+
+export function validateTeamMembers(members: TeamMember[]): string | undefined {
+	const seen = new Set<string>();
+	for (const member of members) {
+		if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(member.id)) {
+			return `Invalid worker id "${member.id}". Use 1-64 letters, numbers, dots, underscores, or hyphens.`;
+		}
+		if (seen.has(member.id)) return `Duplicate worker id "${member.id}".`;
+		seen.add(member.id);
+	}
+	return undefined;
+}
+
+export class TeamBroker {
+	private readonly workers = new Map<string, WorkerState>();
+	private readonly sockets = new Set<net.Socket>();
+	private server: net.Server | undefined;
+	private port: number | undefined;
+	private closed = false;
+
+	constructor(members: TeamMember[]) {
+		const validationError = validateTeamMembers(members);
+		if (validationError) throw new Error(validationError);
+		for (const member of members) {
+			this.workers.set(member.id, {
+				member,
+				token: randomBytes(32).toString("hex"),
+				status: "pending",
+				deliveryQueue: Promise.resolve(),
+			});
+		}
+	}
+
+	async start(): Promise<void> {
+		if (this.server || this.closed) throw new Error("Team broker cannot be started");
+		this.server = net.createServer((socket) => this.handleConnection(socket));
+		await new Promise<void>((resolve, reject) => {
+			const onError = (error: Error) => {
+				this.server?.off("listening", onListening);
+				reject(error);
+			};
+			const onListening = () => {
+				this.server?.off("error", onError);
+				resolve();
+			};
+			this.server?.once("error", onError);
+			this.server?.once("listening", onListening);
+			this.server?.listen(0, TEAM_HOST);
+		});
+		const address = this.server.address();
+		if (!address || typeof address === "string") throw new Error("Team broker did not bind a TCP port");
+		this.port = address.port;
+	}
+
+	getWorkerEnvironment(workerId: string): Record<string, string> {
+		const worker = this.workers.get(workerId);
+		if (!worker || this.port === undefined) throw new Error(`Team worker is not configured: ${workerId}`);
+		return {
+			[TEAM_PORT_ENV]: String(this.port),
+			[TEAM_TOKEN_ENV]: worker.token,
+			[TEAM_WORKER_ID_ENV]: workerId,
+		};
+	}
+
+	markRunning(workerId: string, deliver: (message: TeamMessage) => Promise<void>): void {
+		const worker = this.workers.get(workerId);
+		if (!worker || worker.status !== "pending") throw new Error(`Team worker cannot start: ${workerId}`);
+		worker.deliver = deliver;
+		worker.status = "running";
+	}
+
+	markFinished(workerId: string): void {
+		const worker = this.workers.get(workerId);
+		if (!worker) return;
+		worker.status = "finished";
+		worker.deliver = undefined;
+	}
+
+	async close(): Promise<void> {
+		if (this.closed) return;
+		this.closed = true;
+		for (const worker of this.workers.values()) {
+			worker.status = "finished";
+			worker.deliver = undefined;
+		}
+		for (const socket of this.sockets) socket.destroy();
+		if (!this.server) return;
+		await new Promise<void>((resolve) => this.server?.close(() => resolve()));
+	}
+
+	private handleConnection(socket: net.Socket): void {
+		this.sockets.add(socket);
+		let buffer = Buffer.alloc(0);
+		let handled = false;
+		const respond = (response: TeamResponse) => {
+			if (handled) return;
+			handled = true;
+			socket.end(`${JSON.stringify(response)}\n`);
+		};
+
+		socket.on("data", (chunk: Buffer) => {
+			if (handled) return;
+			buffer = Buffer.concat([buffer, chunk]);
+			if (buffer.length > MAX_REQUEST_BYTES) {
+				respond({ ok: false, error: `request exceeds ${MAX_REQUEST_BYTES} bytes` });
+				return;
+			}
+			const newline = buffer.indexOf(0x0a);
+			if (newline === -1) return;
+			const trailing = buffer.subarray(newline + 1);
+			if (trailing.some((byte) => byte !== 0x0d && byte !== 0x0a)) {
+				respond({ ok: false, error: "only one request is allowed per connection" });
+				return;
+			}
+			let parsed: unknown;
+			try {
+				parsed = JSON.parse(buffer.subarray(0, newline).toString("utf8"));
+			} catch {
+				respond({ ok: false, error: "request is not valid JSON" });
+				return;
+			}
+			const request = parseRequest(parsed);
+			if (typeof request === "string") {
+				respond({ ok: false, error: request });
+				return;
+			}
+			void this.handleRequest(request).then(respond, (error: unknown) =>
+				respond({ ok: false, error: error instanceof Error ? error.message : String(error) }),
+			);
+		});
+		socket.on("error", () => this.sockets.delete(socket));
+		socket.on("close", () => this.sockets.delete(socket));
+	}
+
+	private authenticate(token: string): WorkerState | undefined {
+		for (const worker of this.workers.values()) {
+			if (tokensMatch(worker.token, token)) return worker;
+		}
+		return undefined;
+	}
+
+	private async handleRequest(request: TeamRequest): Promise<TeamResponse> {
+		if (this.closed) return { ok: false, error: "team dispatch has ended" };
+		const sender = this.authenticate(request.token);
+		if (!sender || sender.status !== "running") return { ok: false, error: "worker is not running in this team" };
+
+		if (request.action === "list") {
+			return {
+				ok: true,
+				self: { id: sender.member.id, agent: sender.member.agent },
+				teammates: Array.from(this.workers.values())
+					.filter((worker) => worker !== sender)
+					.map((worker) => ({ id: worker.member.id, agent: worker.member.agent, status: worker.status })),
+			};
+		}
+
+		const validationError = validateMessage(request.message);
+		if (validationError) return { ok: false, error: validationError };
+		if (request.action === "send") {
+			if (request.recipient === sender.member.id) return { ok: false, error: "cannot send a message to yourself" };
+			if (!this.workers.has(request.recipient)) {
+				return { ok: false, error: `unknown teammate: ${request.recipient}` };
+			}
+			try {
+				await this.deliver(request.recipient, { sender: sender.member.id, text: request.message });
+				return { ok: true, delivered: [request.recipient], failed: [] };
+			} catch (error: unknown) {
+				return { ok: false, error: error instanceof Error ? error.message : String(error) };
+			}
+		}
+
+		const recipients = Array.from(this.workers.values()).filter(
+			(worker) => worker !== sender && worker.status === "running",
+		);
+		if (recipients.length === 0) return { ok: false, error: "no running teammates" };
+		const outcomes = await Promise.all(
+			recipients.map(async (recipient): Promise<string | TeamFailure> => {
+				try {
+					await this.deliver(recipient.member.id, { sender: sender.member.id, text: request.message });
+					return recipient.member.id;
+				} catch (error: unknown) {
+					return { recipient: recipient.member.id, error: error instanceof Error ? error.message : String(error) };
+				}
+			}),
+		);
+		const delivered = outcomes.filter((outcome): outcome is string => typeof outcome === "string");
+		const failed = outcomes.filter((outcome): outcome is TeamFailure => typeof outcome !== "string");
+		if (failed.length > 0) return { ok: false, error: "broadcast was only partially accepted", delivered, failed };
+		return { ok: true, delivered, failed: [] };
+	}
+
+	private deliver(recipientId: string, message: TeamMessage): Promise<void> {
+		const recipient = this.workers.get(recipientId);
+		if (!recipient) return Promise.reject(new Error(`unknown teammate: ${recipientId}`));
+		const delivery = recipient.deliveryQueue.then(async () => {
+			if (recipient.status !== "running" || !recipient.deliver) {
+				throw new Error(`teammate is not running: ${recipientId}`);
+			}
+			await recipient.deliver(message);
+		});
+		recipient.deliveryQueue = delivery.catch(() => undefined);
+		return delivery;
+	}
+}
+
+export function requestTeamBroker(
+	request: TeamRequestBody,
+	environment: NodeJS.ProcessEnv = process.env,
+): Promise<TeamResponse> {
+	const port = Number(environment[TEAM_PORT_ENV]);
+	const token = environment[TEAM_TOKEN_ENV];
+	if (!Number.isInteger(port) || port <= 0 || port > 65535 || !token) {
+		return Promise.resolve({ ok: false, error: "team communication is not configured" });
+	}
+	return new Promise((resolve) => {
+		const socket = net.createConnection({ host: TEAM_HOST, port });
+		let buffer = Buffer.alloc(0);
+		let settled = false;
+		const finish = (response: TeamResponse) => {
+			if (settled) return;
+			settled = true;
+			socket.destroy();
+			resolve(response);
+		};
+		socket.on("connect", () => socket.write(`${JSON.stringify({ ...request, token })}\n`));
+		socket.on("data", (chunk: Buffer) => {
+			buffer = Buffer.concat([buffer, chunk]);
+			if (buffer.length > MAX_REQUEST_BYTES) {
+				finish({ ok: false, error: "team broker response is too large" });
+				return;
+			}
+			const newline = buffer.indexOf(0x0a);
+			if (newline === -1) return;
+			try {
+				finish(JSON.parse(buffer.subarray(0, newline).toString("utf8")) as TeamResponse);
+			} catch {
+				finish({ ok: false, error: "team broker returned invalid JSON" });
+			}
+		});
+		socket.on("error", (error) => finish({ ok: false, error: `team broker unavailable: ${error.message}` }));
+		socket.on("end", () => finish({ ok: false, error: "team broker closed without a response" }));
+		socket.on("close", () => finish({ ok: false, error: "team broker connection closed without a response" }));
+	});
+}
+
+export function createTeamClient(
+	environment: NodeJS.ProcessEnv = process.env,
+): (request: TeamRequestBody) => Promise<TeamResponse> {
+	let requestQueue: Promise<void> = Promise.resolve();
+	return (request) => {
+		const result = requestQueue.then(() => requestTeamBroker(request, environment));
+		requestQueue = result.then(
+			() => undefined,
+			() => undefined,
+		);
+		return result;
+	};
+}
+
+function formatResponse(response: TeamResponse): string {
+	if (!response.ok) {
+		const details = response.failed
+			? ` Delivered: ${response.delivered?.join(", ") || "none"}. Failed: ${response.failed.map((failure) => `${failure.recipient} (${failure.error})`).join(", ")}.`
+			: "";
+		return `Message not accepted: ${response.error}.${details}`;
+	}
+	if ("teammates" in response) {
+		return JSON.stringify({ self: response.self, teammates: response.teammates }, null, 2);
+	}
+	return `Message accepted for delivery to: ${response.delivered.join(", ")}.`;
+}
+
+export function registerTeamToolsFromEnvironment(pi: ExtensionAPI): boolean {
+	const workerId = process.env[TEAM_WORKER_ID_ENV];
+	if (!workerId || !process.env[TEAM_PORT_ENV] || !process.env[TEAM_TOKEN_ENV]) return false;
+
+	const request = createTeamClient();
+	const execute = async (value: TeamRequestBody) => {
+		const response = await request(value);
+		return {
+			content: [{ type: "text" as const, text: formatResponse(response) }],
+			details: response,
+			isError: !response.ok,
+		};
+	};
+
+	pi.registerTool({
+		name: "team_list",
+		label: "List Teammates",
+		description: `List this worker's identity and the other workers in its parallel dispatch. This worker is ${workerId}.`,
+		promptSnippet: "List workers in this parallel subagent team",
+		parameters: Type.Object({}),
+		execute: async () => execute({ action: "list" }),
+	});
+	pi.registerTool({
+		name: "team_send",
+		label: "Message Teammate",
+		description: "Send a private, asynchronous finding to one running teammate by worker ID.",
+		promptSnippet: "Send a private finding to one running teammate",
+		parameters: Type.Object({
+			recipient: Type.String({ description: "Worker ID returned by team_list" }),
+			message: Type.String({ description: `Complete message, up to ${TEAM_MESSAGE_MAX_BYTES} UTF-8 bytes` }),
+		}),
+		execute: async (_toolCallId, params) => execute({ action: "send", ...params }),
+	});
+	pi.registerTool({
+		name: "team_broadcast",
+		label: "Broadcast To Team",
+		description: "Send an asynchronous finding to every other running teammate.",
+		promptSnippet: "Broadcast a finding to all other running teammates",
+		parameters: Type.Object({
+			message: Type.String({ description: `Complete message, up to ${TEAM_MESSAGE_MAX_BYTES} UTF-8 bytes` }),
+		}),
+		execute: async (_toolCallId, params) => execute({ action: "broadcast", ...params }),
+	});
+	return true;
+}
+
+export const teamEnvironment = {
+	port: TEAM_PORT_ENV,
+	token: TEAM_TOKEN_ENV,
+	workerId: TEAM_WORKER_ID_ENV,
+};
