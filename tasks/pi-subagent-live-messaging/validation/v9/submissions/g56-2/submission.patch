+import { afterEach, describe, expect, it } from "vitest";
+import {
+	createTeamClient,
+	formatTeamMessage,
+	requestTeamBroker,
+	TEAM_MESSAGE_MAX_BYTES,
+	TeamBroker,
+	teamEnvironment,
+	validateTeamMembers,
+} from "../examples/extensions/subagent/team.ts";
+
+const members = [
+	{ id: "researcher", agent: "worker", task: "Find the interface constraint" },
+	{ id: "implementer", agent: "worker", task: "Implement the change" },
+	{ id: "reviewer", agent: "reviewer", task: "Review the result" },
+];
+
+describe("subagent team communication", () => {
+	const brokers: TeamBroker[] = [];
+
+	afterEach(async () => {
+		await Promise.all(brokers.map((broker) => broker.close()));
+		brokers.length = 0;
+	});
+
+	async function createBroker(): Promise<TeamBroker> {
+		const broker = new TeamBroker(members);
+		brokers.push(broker);
+		await broker.start();
+		return broker;
+	}
+
+	it("lists independently addressed workers using the same agent definition", async () => {
+		const broker = await createBroker();
+		broker.markRunning("researcher", async () => undefined);
+		broker.markRunning("implementer", async () => undefined);
+
+		const response = await requestTeamBroker({ action: "list" }, broker.getWorkerEnvironment("researcher"));
+
+		expect(response).toEqual({
+			ok: true,
+			self: { id: "researcher", agent: "worker" },
+			teammates: [
+				{ id: "implementer", agent: "worker", status: "running" },
+				{ id: "reviewer", agent: "reviewer", status: "pending" },
+			],
+		});
+	});
+
+	it("delivers complete Unicode text with the authenticated sender identity", async () => {
+		const broker = await createBroker();
+		const received: string[] = [];
+		broker.markRunning("researcher", async () => undefined);
+		broker.markRunning("implementer", async (message) => {
+			received.push(formatTeamMessage(message));
+		});
+		const message = "接口约束：保留 café 和 🚀\n第二行不能截断。";
+
+		const response = await requestTeamBroker(
+			{ action: "send", recipient: "implementer", message },
+			broker.getWorkerEnvironment("researcher"),
+		);
+
+		expect(response).toEqual({ ok: true, delivered: ["implementer"], failed: [] });
+		expect(received).toEqual([`[Message from teammate researcher]\n${message}`]);
+	});
+
+	it("preserves sender order and rejects delivery after shutdown", async () => {
+		const broker = await createBroker();
+		const received: string[] = [];
+		broker.markRunning("researcher", async () => undefined);
+		broker.markRunning("implementer", async (message) => {
+			if (message.text === "first") await new Promise((resolve) => setTimeout(resolve, 20));
+			received.push(message.text);
+		});
+		const environment = broker.getWorkerEnvironment("researcher");
+		const request = createTeamClient(environment);
+
+		await Promise.all([
+			request({ action: "send", recipient: "implementer", message: "first" }),
+			request({ action: "send", recipient: "implementer", message: "second" }),
+		]);
+		expect(received).toEqual(["first", "second"]);
