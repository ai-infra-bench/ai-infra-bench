@@ -0,0 +1,243 @@
+import type { ChildProcess } from "node:child_process";
+
+export const TEAM_CHANNEL = "pi-subagent-team";
+export const MAX_MESSAGE_BYTES = 64 * 1024;
+export const MAX_INBOX_BYTES = 1024 * 1024;
+export const MAX_INBOX_MESSAGES = 256;
+
+export interface TeamMember {
+	id: string;
+	agent: string;
+	task: string;
+	state: "queued" | "starting" | "running" | "finished";
+}
+
+export interface Finding {
+	from: string;
+	agent: string;
+	text: string;
+}
+
+export type TeamRequest =
+	| { kind: "ready" | "members" | "finish" }
+	| { kind: "send"; to: string; text: string }
+	| { kind: "broadcast"; text: string }
+	| { kind: "drain"; finishing: boolean };
+
+export type TeamReply =
+	| { kind: "members"; self: string; members: TeamMember[] }
+	| { kind: "delivery"; accepted: string[]; failed: { recipient: string; reason: string }[] }
+	| { kind: "drain"; messages: Finding[]; finished: boolean }
+	| { kind: "finished" }
+	| { kind: "error"; error: string };
+
+interface Worker {
+	member: TeamMember;
+	inbox: Finding[];
+	bytes: number;
+}
+
+export function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export class TeamBroker {
+	private workers = new Map<string, Worker>();
+	private children = new Map<ChildProcess, () => void>();
+	private disposing?: Promise<void>;
+	closed = false;
+
+	constructor(tasks: { agent: string; task: string }[]) {
+		for (const [index, task] of tasks.entries()) {
+			const id = `worker-${index + 1}`;
+			this.workers.set(id, { member: { ...task, id, state: "queued" }, inbox: [], bytes: 0 });
+		}
+	}
+
+	attach(id: string, child: ChildProcess): void {
+		const worker = this.workers.get(id);
+		if (this.closed || !worker || worker.member.state !== "queued") {
+			child.kill("SIGTERM");
+			throw new Error(`Cannot start team worker ${id}`);
+		}
+		worker.member.state = "starting";
+		const onMessage = (message: unknown) => {
+			if (!isRecord(message) || message.channel !== TEAM_CHANNEL || !Number.isSafeInteger(message.id)) return;
+			const reply = this.request(id, message.request);
+			if (child.connected) {
+				child.send({ channel: TEAM_CHANNEL, id: message.id, reply }, (error) => {
+					if (error) this.finish(id);
+				});
+			}
+		};
+		const onDisconnect = () => this.finish(id);
+		const cleanup = () => {
+			this.finish(id);
+			child.off("message", onMessage);
+			child.off("disconnect", onDisconnect);
+			child.off("close", cleanup);
+			this.children.delete(child);
+		};
+		this.children.set(child, cleanup);
+		child.on("message", onMessage);
+		child.on("disconnect", onDisconnect);
+		child.once("close", cleanup);
+	}
+
+	request(id: string, request: unknown): TeamReply {
+		const worker = this.workers.get(id);
+		if (this.closed || !worker) return { kind: "error", error: "Team is closed or worker is unknown" };
+		if (!isRecord(request)) return { kind: "error", error: "Invalid team request" };
+		const allowedKeys: Record<string, string[]> = {
+			ready: ["kind"],
+			members: ["kind"],
+			finish: ["kind"],
+			drain: ["kind", "finishing"],
+			send: ["kind", "to", "text"],
+			broadcast: ["kind", "text"],
+		};
+		const keys = typeof request.kind === "string" ? allowedKeys[request.kind] : undefined;
+		if (!Array.isArray(keys) || Object.keys(request).some((key) => !keys.includes(key))) {
+			return { kind: "error", error: "Invalid team request fields" };
+		}
+		if (request.kind === "ready" && worker.member.state === "starting") worker.member.state = "running";
+		if (request.kind === "finish") {
+			this.finish(id);
+			return { kind: "finished" };
+		}
+		if (worker.member.state !== "running") return { kind: "error", error: "Worker is not running" };
+		if (request.kind === "ready" || request.kind === "members") {
+			return {
+				kind: "members",
+				self: id,
+				members: [...this.workers.values()].map((entry) => ({ ...entry.member })),
+			};
+		}
+		if (request.kind === "drain") {
+			if (typeof request.finishing !== "boolean") return { kind: "error", error: "finishing must be boolean" };
+			const messages = worker.inbox;
+			worker.inbox = [];
+			worker.bytes = 0;
+			const finished = request.finishing && messages.length === 0;
+			if (finished) worker.member.state = "finished";
+			return { kind: "drain", messages, finished };
+		}
+		if (typeof request.text !== "string" || request.text.length === 0) {
+			return { kind: "error", error: "text must be a nonempty string" };
+		}
+		const bytes = Buffer.byteLength(request.text, "utf8");
+		if (bytes > MAX_MESSAGE_BYTES) {
+			return { kind: "error", error: `text exceeds ${MAX_MESSAGE_BYTES} UTF-8 bytes (${bytes})` };
+		}
+		if (request.kind === "send" && (typeof request.to !== "string" || !request.to)) {
+			return { kind: "error", error: "to must be a worker ID" };
+		}
+		const recipients =
+			request.kind === "send" ? [request.to as string] : [...this.workers.keys()].filter((key) => key !== id);
+		const result: Extract<TeamReply, { kind: "delivery" }> = { kind: "delivery", accepted: [], failed: [] };
+		for (const recipient of recipients) {
+			const target = this.workers.get(recipient);
+			const reason =
+				recipient === id
+					? "Cannot send to yourself"
+					: !target
+						? "Unknown teammate"
+						: target.member.state !== "running"
+							? `Teammate is ${target.member.state}`
+							: target.bytes + bytes > MAX_INBOX_BYTES || target.inbox.length >= MAX_INBOX_MESSAGES
+								? "Teammate inbox is full"
+								: undefined;
+			if (reason || !target) {
+				result.failed.push({ recipient, reason: reason ?? "Unknown teammate" });
+			} else {
+				target.inbox.push({ from: id, agent: worker.member.agent, text: request.text });
+				target.bytes += bytes;
+				result.accepted.push(recipient);
+			}
+		}
+		return { ...result, failed: request.kind === "broadcast" ? [] : result.failed };
+	}
+
+	finish(id: string): void {
+		const worker = this.workers.get(id);
+		if (!worker) return;
+		worker.member.state = "finished";
+		worker.inbox = [];
+		worker.bytes = 0;
+	}
+
+	dispose(): Promise<void> {
+		if (this.disposing) return this.disposing;
+		this.closed = true;
+		for (const id of this.workers.keys()) this.finish(id);
+		this.disposing = Promise.all(
+			[...this.children].map(
+				([child, cleanup]) =>
+					new Promise<void>((resolve) => {
+						const timer = setTimeout(() => child.kill("SIGKILL"), 5000);
+						child.once("close", () => {
+							clearTimeout(timer);
+							cleanup();
+							resolve();
+						});
+						child.kill("SIGTERM");
+					}),
+			),
+		).then(() => undefined);
+		return this.disposing;
+	}
+}
+
+export interface TeamConnection {
+	request(request: TeamRequest): Promise<TeamReply>;
+	close(): void;
+}
+
+export class TeamClient implements TeamConnection {
+	private nextId = 0;
+	private pending = new Map<number, { resolve: (reply: TeamReply) => void; reject: (error: Error) => void }>();
+	private closed = false;
+
+	constructor() {
+		if (!process.send || !process.connected) throw new Error("Team tools require a subagent IPC channel");
+		process.on("message", this.onMessage);
+		process.once("disconnect", this.close);
+	}
+
+	private onMessage = (message: unknown): void => {
+		if (!isRecord(message) || message.channel !== TEAM_CHANNEL || typeof message.id !== "number") return;
+		const pending = this.pending.get(message.id);
+		if (!pending) return;
+		this.pending.delete(message.id);
+		if (!isRecord(message.reply) || typeof message.reply.kind !== "string") {
+			pending.reject(new Error("Invalid team reply"));
+		} else {
+			pending.resolve(message.reply as TeamReply);
+		}
+	};
+
+	request(request: TeamRequest): Promise<TeamReply> {
+		return new Promise((resolve, reject) => {
+			if (this.closed || !process.send || !process.connected) {
+				reject(new Error("Team connection is closed"));
+				return;
+			}
+			const id = this.nextId++;
+			this.pending.set(id, { resolve, reject });
+			process.send({ channel: TEAM_CHANNEL, id, request }, (error: Error | null) => {
+				if (error) {
+					this.pending.delete(id);
+					reject(error);
+				}
+			});
+		});
+	}
+
+	close = (): void => {
+		this.closed = true;
+		process.off("message", this.onMessage);
+		process.off("disconnect", this.close);
+		for (const pending of this.pending.values()) pending.reject(new Error("Team connection closed"));
+		this.pending.clear();
+	};
+}
