+import { ChildProcess } from "node:child_process";
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { TeamBroker, type TeamConnection } from "../../examples/extensions/subagent/team.ts";
+import { registerTeamWorker } from "../../examples/extensions/subagent/team-worker.ts";
+import { createHarness, getMessageText } from "./harness.ts";
+
+describe("subagent team model context", () => {
+	for (const mode of ["final response", "tools", "terminating tools"]) {
+		it(`delivers complete ordered findings on the next model call after ${mode}`, async () => {
+			const withTools = mode !== "final response";
+			const broker = new TeamBroker([
+				{ agent: "worker", task: "sender" },
+				{ agent: "worker", task: "recipient" },
+			]);
+			const sender = new ChildProcess();
+			const recipient = new ChildProcess();
+			broker.attach("worker-1", sender);
+			broker.attach("worker-2", recipient);
+			broker.request("worker-1", { kind: "ready" });
+			const connection: TeamConnection = {
+				request: async (request) => broker.request("worker-2", request),
+				close: () => {},
+			};
+			const first = "接口 🧪 é\n".repeat(3000);
+			const second = "second finding";
+			const toolExecutions: string[] = [];
+			const workParams = Type.Object({ id: Type.String() });
+			const workTool: AgentTool<typeof workParams> = {
+				name: "work",
+				label: "Work",
+				description: "Work without interruption",
+				parameters: workParams,
+				async execute(_id, args, signal) {
+					toolExecutions.push(args.id);
+					expect(signal?.aborted).not.toBe(true);
+					if (args.id === "last") {
+						expect(broker.request("worker-1", { kind: "send", to: "worker-2", text: second })).toMatchObject({
+							accepted: ["worker-2"],
+						});
+					}
+					return {
+						content: [{ type: "text", text: `completed ${args.id}` }],
+						details: {},
+						terminate: mode === "terminating tools",
+					};
+				},
+			};
+			const harness = await createHarness({
+				extensionFactories: [(pi) => registerTeamWorker(pi, connection)],
+				tools: [workTool],
+			});
+			try {
+				let calls = 0;
+				harness.setResponses([
+					(context) => {
+						calls++;
+						expect(context.systemPrompt).toContain("You are worker-2");
+						expect(context.tools?.map((tool) => tool.name)).toEqual(
+							expect.arrayContaining(["team_members", "team_send", "team_broadcast"]),
+						);
+						expect(broker.request("worker-1", { kind: "send", to: "worker-2", text: first })).toMatchObject({
+							accepted: ["worker-2"],
+						});
+						if (!withTools) broker.request("worker-1", { kind: "send", to: "worker-2", text: second });
+						return withTools
+							? fauxAssistantMessage(
+									[fauxToolCall("work", { id: "first" }), fauxToolCall("work", { id: "last" })],
+									{ stopReason: "toolUse" },
+								)
+							: fauxAssistantMessage("would otherwise finish");
+					},
+					(context) => {
+						calls++;
+						const messages = context.messages.map(getMessageText);
+						const findings = messages.filter((text) => text.startsWith("Teammate findings"));
+						expect(findings).toHaveLength(1);
+						expect(JSON.parse(findings[0].slice(findings[0].indexOf("\n") + 1))).toEqual([
+							{ from: "worker-1", agent: "worker", text: first },
+							{ from: "worker-1", agent: "worker", text: second },
+						]);
+						if (withTools) {
+							expect(toolExecutions).toEqual(["first", "last"]);
+							expect(messages.indexOf("completed last")).toBeLessThan(messages.indexOf(findings[0]));
+						}
+						return fauxAssistantMessage("processed findings");
+					},
+				]);
+				await harness.session.prompt("start");
+				expect(calls).toBe(2);
+				expect(harness.session.messages.filter((message) => message.role === "custom")).toHaveLength(1);
+				expect(broker.request("worker-1", { kind: "send", to: "worker-2", text: "late" })).toMatchObject({
+					accepted: [],
+					failed: [{ reason: "Teammate is finished" }],
+				});
+			} finally {
+				harness.cleanup();
+				sender.emit("close", 0);
+				recipient.emit("close", 0);
+				await broker.dispose();
+			}
+		});
+	}
+});
