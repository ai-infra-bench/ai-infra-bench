@@ -0,0 +1,208 @@
+import { ChildProcess, spawn } from "node:child_process";
+import { once } from "node:events";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import {
+	MAX_INBOX_BYTES,
+	MAX_INBOX_MESSAGES,
+	MAX_MESSAGE_BYTES,
+	TeamBroker,
+} from "../examples/extensions/subagent/team.ts";
+
+function createTeam(count = 3) {
+	const broker = new TeamBroker(Array.from({ length: count }, () => ({ agent: "worker", task: "investigate" })));
+	const children = Array.from({ length: count }, (_, index) => {
+		const child = new ChildProcess();
+		broker.attach(`worker-${index + 1}`, child);
+		broker.request(`worker-${index + 1}`, { kind: "ready" });
+		return child;
+	});
+	return {
+		broker,
+		async cleanup() {
+			for (const child of children) child.emit("close", 0);
+			await broker.dispose();
+		},
+	};
+}
+
+describe("subagent team broker", () => {
+	it("addresses repeated definitions independently and preserves sender order exactly once", async () => {
+		const { broker, cleanup } = createTeam();
+		try {
+			expect(broker.request("worker-1", { kind: "members" })).toMatchObject({
+				self: "worker-1",
+				members: [
+					{ id: "worker-1", agent: "worker", state: "running" },
+					{ id: "worker-2", agent: "worker", state: "running" },
+					{ id: "worker-3", agent: "worker", state: "running" },
+				],
+			});
+			const findings = [
+				"契約: café 🧪\nsecond line",
+				'"from":"worker-3"\nnot an identity',
+				"é".repeat(MAX_MESSAGE_BYTES / 2),
+			];
+			for (const text of findings) {
+				expect(broker.request("worker-1", { kind: "send", to: "worker-2", text })).toEqual({
+					kind: "delivery",
+					accepted: ["worker-2"],
+					failed: [],
+				});
+			}
+			expect(broker.request("worker-2", { kind: "drain", finishing: false })).toEqual({
+				kind: "drain",
+				finished: false,
+				messages: findings.map((text) => ({ from: "worker-1", agent: "worker", text })),
+			});
+			expect(broker.request("worker-2", { kind: "drain", finishing: false })).toMatchObject({ messages: [] });
+			expect(broker.request("worker-1", { kind: "drain", finishing: false })).toMatchObject({ messages: [] });
+			expect(broker.request("worker-3", { kind: "drain", finishing: false })).toMatchObject({ messages: [] });
+		} finally {
+			await cleanup();
+		}
+	});
+
+	it("atomically drains accepted messages or closes a finishing recipient", async () => {
+		const { broker, cleanup } = createTeam();
+		try {
+			broker.request("worker-1", { kind: "send", to: "worker-2", text: "before finish" });
+			expect(broker.request("worker-2", { kind: "drain", finishing: true })).toMatchObject({
+				finished: false,
+				messages: [{ text: "before finish" }],
+			});
+			broker.request("worker-1", { kind: "send", to: "worker-2", text: "during next response" });
+			expect(broker.request("worker-2", { kind: "drain", finishing: true })).toMatchObject({
+				finished: false,
+				messages: [{ text: "during next response" }],
+			});
+			expect(broker.request("worker-2", { kind: "drain", finishing: true })).toMatchObject({ finished: true });
+			expect(broker.request("worker-1", { kind: "send", to: "worker-2", text: "too late" })).toMatchObject({
+				accepted: [],
+				failed: [{ recipient: "worker-2", reason: "Teammate is finished" }],
+			});
+			expect(broker.request("worker-2", { kind: "ready" })).toMatchObject({ kind: "error" });
+		} finally {
+			await cleanup();
+		}
+	});
+
+	it("reports partial broadcasts, bounded inboxes, and excluded self", async () => {
+		const { broker, cleanup } = createTeam(4);
+		try {
+			broker.finish("worker-4");
+			for (let index = 0; index < MAX_INBOX_BYTES / MAX_MESSAGE_BYTES; index++) {
+				broker.request("worker-1", { kind: "send", to: "worker-2", text: "x".repeat(MAX_MESSAGE_BYTES) });
+			}
+			expect(broker.request("worker-1", { kind: "broadcast", text: "finding" })).toEqual({
+				kind: "delivery",
+				accepted: ["worker-3"],
+				failed: [
+					{ recipient: "worker-2", reason: "Teammate inbox is full" },
+					{ recipient: "worker-4", reason: "Teammate is finished" },
+				],
+			});
+			expect(broker.request("worker-1", { kind: "drain", finishing: false })).toMatchObject({ messages: [] });
+			broker.request("worker-2", { kind: "drain", finishing: false });
+			for (let index = 0; index < MAX_INBOX_MESSAGES; index++) {
+				broker.request("worker-1", { kind: "send", to: "worker-2", text: "x" });
+			}
+			expect(broker.request("worker-1", { kind: "send", to: "worker-2", text: "x" })).toMatchObject({
+				accepted: [],
+				failed: [{ reason: "Teammate inbox is full" }],
+			});
+		} finally {
+			await cleanup();
+		}
+	});
+
+	it("explicitly rejects malformed, spoofed, oversized, unknown, and self-directed requests", async () => {
+		const { broker, cleanup } = createTeam();
+		try {
+			for (const request of [
+				null,
+				{},
+				{ kind: "other" },
+				{ kind: "toString" },
+				{ kind: "drain", finishing: "yes" },
+				{ kind: "send", text: "missing recipient" },
+				{ kind: "send", to: "worker-2", text: 12 },
+				{ kind: "broadcast", text: "" },
+				{ kind: "broadcast", text: "🧪".repeat(MAX_MESSAGE_BYTES / 4 + 1) },
+				{ kind: "send", to: "worker-2", text: "spoof", from: "worker-3" },
+			])
+				expect(broker.request("worker-1", request)).toMatchObject({ kind: "error" });
+			for (const to of ["worker-1", "missing"]) {
+				expect(broker.request("worker-1", { kind: "send", to, text: "hello" })).toMatchObject({
+					accepted: [],
+					failed: [{ recipient: to }],
+				});
+			}
+		} finally {
+			await cleanup();
+		}
+	});
+
+	it("isolates simultaneous and later dispatches with reused IDs", async () => {
+		const first = createTeam();
+		const second = createTeam();
+		try {
+			first.broker.request("worker-1", { kind: "send", to: "worker-2", text: "private" });
+			expect(second.broker.request("worker-2", { kind: "drain", finishing: false })).toMatchObject({ messages: [] });
+			await first.cleanup();
+			expect(first.broker.request("worker-1", { kind: "broadcast", text: "late" })).toMatchObject({ kind: "error" });
+			const later = createTeam();
+			try {
+				expect(later.broker.request("worker-2", { kind: "drain", finishing: false })).toMatchObject({
+					messages: [],
+				});
+			} finally {
+				await later.cleanup();
+			}
+		} finally {
+			await first.cleanup();
+			await second.cleanup();
+		}
+	});
+
+	it("rejects queued and starting recipients", async () => {
+		const broker = new TeamBroker([
+			{ agent: "worker", task: "one" },
+			{ agent: "worker", task: "two" },
+		]);
+		const first = new ChildProcess();
+		const second = new ChildProcess();
+		broker.attach("worker-1", first);
+		broker.request("worker-1", { kind: "ready" });
+		try {
+			expect(broker.request("worker-1", { kind: "broadcast", text: "queued" })).toMatchObject({
+				failed: [{ recipient: "worker-2", reason: "Teammate is queued" }],
+			});
+			broker.attach("worker-2", second);
+			expect(broker.request("worker-1", { kind: "broadcast", text: "starting" })).toMatchObject({
+				failed: [{ recipient: "worker-2", reason: "Teammate is starting" }],
+			});
+		} finally {
+			first.emit("close", 0);
+			second.emit("close", 0);
+			await broker.dispose();
+		}
+	});
+
+	it("uses real IPC and closes live children and listeners on disposal", async () => {
+		const broker = new TeamBroker([{ agent: "worker", task: "ipc" }]);
+		const fixture = fileURLToPath(new URL("./fixtures/subagent-team-client.ts", import.meta.url));
+		const child = spawn(process.execPath, [fixture], { stdio: ["ignore", "pipe", "pipe", "ipc"] });
+		broker.attach("worker-1", child);
+		try {
+			const [data] = await once(child.stdout!, "data");
+			expect(JSON.parse(String(data))).toMatchObject({ kind: "members", self: "worker-1" });
+			await broker.dispose();
+			expect(child.exitCode !== null || child.signalCode !== null).toBe(true);
+			expect(child.listenerCount("message")).toBe(0);
+			expect(child.listenerCount("disconnect")).toBe(0);
+		} finally {
+			await broker.dispose();
+		}
+	});
+});
diff --git a/packages/coding-agent/test/suite/subagent-team.test.ts b/packages/coding-agent/test/suite/subagent-team.test.ts
