+import assert from "node:assert/strict";
+import { existsSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { setTimeout } from "node:timers/promises";
+import { fauxAssistantMessage, fauxProvider, fauxToolCall, type Message } from "@earendil-works/pi-ai";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+const finding = "接口🧪\n".repeat(5500);
+
+function messageText(message: Message): string {
+	if (typeof message.content === "string") return message.content;
+	return message.content
+		.filter((part) => part.type === "text")
+		.map((part) => part.text)
+		.join("\n");
+}
+
+async function waitForFile(file: string): Promise<void> {
+	const deadline = Date.now() + 15000;
+	while (!existsSync(file)) {
+		if (Date.now() > deadline) throw new Error(`Timed out waiting for ${file}`);
+		await setTimeout(10);
+	}
+}
+
+export default function (pi: ExtensionAPI): void {
+	const faux = fauxProvider({ provider: "team-test" });
+	pi.registerProvider(faux.provider);
+	pi.registerTool({
+		name: "team_test_block",
+		label: "Test block",
+		description: "Wait for test coordination",
+		parameters: Type.Object({}),
+		async execute(_id, _params, signal, _onUpdate, ctx) {
+			writeFileSync(join(ctx.cwd, "tool-started"), "ready");
+			await waitForFile(join(ctx.cwd, "sent"));
+			assert.equal(signal?.aborted, false);
+			return { content: [{ type: "text", text: "tool completed" }], details: {} };
+		},
+	});
+	if (!process.send) {
+		faux.setResponses([
+			() =>
+				fauxAssistantMessage(
+					fauxToolCall("subagent", {
+						communication: true,
+						tasks: [
+							{ agent: "worker", task: "send" },
+							{ agent: "worker", task: "receive" },
+						],
+					}),
+					{ stopReason: "toolUse" },
+				),
+			(context) =>
+				fauxAssistantMessage(
+					context.messages
+						.filter((message) => message.role === "toolResult")
+						.map(messageText)
+						.join("\n"),
+				),
+		]);
+		return;
+	}
+
+	faux.setResponses([
+		async (context) => {
+			const sender = context.systemPrompt?.includes("You are worker-1 in this parallel team.");
+			writeFileSync(join(process.cwd(), sender ? "sender-pid" : "recipient-pid"), String(process.pid));
+			if (process.env.PI_TEAM_TEST_CANCEL === "1") {
+				await new Promise<void>(() => {});
+			}
+			assert.ok(context.tools?.some((tool) => tool.name === "read"));
+			assert.ok(context.tools?.some((tool) => tool.name === "team_send"));
+			if (sender) {
+				await waitForFile(join(process.cwd(), "tool-started"));
+				return fauxAssistantMessage(
+					[
+						fauxToolCall("team_members", {}),
+						fauxToolCall("team_send", { to: "worker-2", text: finding }),
+						fauxToolCall("team_broadcast", { text: "second finding" }),
+					],
+					{ stopReason: "toolUse" },
+				);
+			}
+			return fauxAssistantMessage(fauxToolCall("team_test_block", {}), { stopReason: "toolUse" });
+		},
+		(context) => {
+			if (context.systemPrompt?.includes("You are worker-1 in this parallel team.")) {
+				const results = context.messages
+					.filter((message) => message.role === "toolResult")
+					.map(messageText)
+					.map((text) => JSON.parse(text));
+				assert.equal(results[0].self, "worker-1");
+				assert.deepEqual(results.slice(1), [
+					{ kind: "delivery", accepted: ["worker-2"], failed: [] },
+					{ kind: "delivery", accepted: ["worker-2"], failed: [] },
+				]);
+				writeFileSync(join(process.cwd(), "sent"), "accepted");
+				return fauxAssistantMessage("sender complete");
+			}
+			const findings = context.messages.map(messageText).filter((text) => text.startsWith("Teammate findings"));
+			assert.equal(findings.length, 1);
+			assert.deepEqual(JSON.parse(findings[0].slice(findings[0].indexOf("\n") + 1)), [
+				{ from: "worker-1", agent: "worker", text: finding },
+				{ from: "worker-1", agent: "worker", text: "second finding" },
+			]);
+			return fauxAssistantMessage("recipient processed complete ordered findings");
+		},
+	]);
+}
diff --git a/packages/coding-agent/test/subagent-team-process.test.ts b/packages/coding-agent/test/subagent-team-process.test.ts
