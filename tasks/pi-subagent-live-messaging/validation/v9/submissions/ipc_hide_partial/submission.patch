+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { setTimeout } from "node:timers/promises";
+import { describe, expect, it } from "vitest";
+import { ENV_AGENT_DIR } from "../src/config.ts";
+
+describe("subagent team through the source CLI", () => {
+	for (const cancel of [false, true]) {
+		it(cancel
+			? "stops every child on parent cancellation"
+			: "communicates through the existing entry point in separate Pi processes", async () => {
+			const directory = mkdtempSync(join(tmpdir(), "pi-team-process-"));
+			const agentDir = join(directory, "agent");
+			mkdirSync(join(agentDir, "extensions"), { recursive: true });
+			mkdirSync(join(agentDir, "agents"));
+			writeFileSync(
+				join(agentDir, "agents", "worker.md"),
+				"---\nname: worker\ndescription: Test worker\ntools: read, team_test_block\n---\nPerform the task.\n",
+			);
+			writeFileSync(
+				join(agentDir, "settings.json"),
+				JSON.stringify({
+					extensions: [resolve(__dirname, "./fixtures/subagent-team-provider.ts")],
+					retry: { enabled: false },
+					compaction: { enabled: false },
+				}),
+			);
+			const child = spawn(
+				process.execPath,
+				[
+					"--import",
+					resolve(__dirname, "../src/experimental/source-resolver.ts"),
+					resolve(__dirname, "../src/cli.ts"),
+					"--mode",
+					"json",
+					"-p",
+					"--no-session",
+					"--model",
+					"team-test/faux-1",
+					"--extension",
+					resolve(__dirname, "../examples/extensions/subagent/index.ts"),
+					"dispatch",
+				],
+				{
+					cwd: directory,
+					env: {
+						...process.env,
+						[ENV_AGENT_DIR]: agentDir,
+						PI_OFFLINE: "1",
+						PI_TEAM_TEST_CANCEL: cancel ? "1" : "0",
+					},
+					stdio: ["ignore", "pipe", "pipe"],
+				},
+			);
+			let stdout = "";
+			let stderr = "";
+			child.stdout.setEncoding("utf8").on("data", (data: string) => {
+				stdout += data;
+			});
+			child.stderr.setEncoding("utf8").on("data", (data: string) => {
+				stderr += data;
+			});
+			const closed = once(child, "close");
+			try {
+				if (cancel) {
+					const deadline = Date.now() + 20000;
+					while (!existsSync(join(directory, "sender-pid")) || !existsSync(join(directory, "recipient-pid"))) {
+						if (Date.now() > deadline || child.exitCode !== null)
+							throw new Error(`Workers did not start: ${stderr}\n${stdout}`);
+						await setTimeout(20);
+					}
+					child.kill("SIGTERM");
+				}
+				const [code] = await closed;
+				expect(stderr).not.toContain("Extension error");
+				if (!cancel) {
+					expect(code, stderr).toBe(0);
+					expect(stdout).toContain("sender complete");
+					expect(stdout).toContain("recipient processed complete ordered findings");
+					expect(stdout).toContain("worker-1: worker");
+					expect(stdout).toContain("worker-2: worker");
+				}
+				const pids = ["sender-pid", "recipient-pid"].map((file) =>
+					Number(readFileSync(join(directory, file), "utf8")),
+				);
+				expect(new Set([child.pid, ...pids]).size).toBe(3);
+				for (const pid of pids) expect(() => process.kill(pid, 0)).toThrow();
+			} finally {
+				if (child.exitCode === null && child.signalCode === null) child.kill("SIGTERM");
+				await closed;
+				rmSync(directory, { recursive: true, force: true });
+			}
+		}, 30000);
+	}
+});
