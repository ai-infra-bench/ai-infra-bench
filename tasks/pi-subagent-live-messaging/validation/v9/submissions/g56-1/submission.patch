+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+	MAX_TEAM_MESSAGE_BYTES,
+	ParallelTeamBroker,
+	readTeamMemberConfig,
+	registerTeamMemberExtension,
+	type TeamWorkerDefinition,
+} from "../examples/extensions/subagent/team.ts";
+import type { ExtensionAPI } from "../src/core/extensions/index.ts";
+
+interface ToolResult {
+	content: Array<{ type: "text"; text: string }>;
+	details: unknown;
+	isError?: boolean;
+}
+
+interface RegisteredTool {
+	name: string;
+	execute: (toolCallId: string, params: Record<string, string>) => Promise<ToolResult>;
+}
+
+interface TestMember {
+	tools: Map<string, RegisteredTool>;
+	sendMessage: ReturnType<typeof vi.fn<ExtensionAPI["sendMessage"]>>;
+	turnStart: () => Promise<void>;
+	agentEnd: () => Promise<void>;
+}
+
+function createMember(broker: ParallelTeamBroker, workerId: string): TestMember {
+	const tools = new Map<string, RegisteredTool>();
+	const handlers = new Map<string, () => Promise<void> | void>();
+	const sendMessage = vi.fn<ExtensionAPI["sendMessage"]>();
+	const api = {
+		registerTool(tool: unknown) {
+			const registered = tool as RegisteredTool;
+			tools.set(registered.name, registered);
+		},
+		on(event: string, handler: unknown) {
+			handlers.set(event, handler as () => Promise<void> | void);
+		},
+		sendMessage,
+	} as unknown as ExtensionAPI;
+	const config = readTeamMemberConfig(broker.getWorkerEnvironment(workerId));
+	if (!config) throw new Error("Missing team member config.");
+	registerTeamMemberExtension(api, config);
+	return {
+		tools,
+		sendMessage,
+		turnStart: async () => {
+			await handlers.get("turn_start")?.();
+		},
+		agentEnd: async () => {
+			await handlers.get("agent_end")?.();
+		},
+	};
+}
+
+async function execute(member: TestMember, toolName: string, params: Record<string, string> = {}): Promise<ToolResult> {
+	const tool = member.tools.get(toolName);
+	if (!tool) throw new Error(`Missing tool: ${toolName}`);
+	return tool.execute("call-1", params);
+}
+
+function details<T>(result: ToolResult): T {
+	return result.details as T;
+}
+
+describe("subagent parallel team communication", () => {
+	const brokers: ParallelTeamBroker[] = [];
+
+	afterEach(async () => {
+		await Promise.all(brokers.splice(0).map((broker) => broker.close()));
+	});
+
+	async function setup(definitions: TeamWorkerDefinition[]) {
+		const broker = new ParallelTeamBroker(definitions);
+		brokers.push(broker);
+		await broker.start();
+		for (const definition of definitions) broker.markStarting(definition.id);
+		const members = new Map(definitions.map((definition) => [definition.id, createMember(broker, definition.id)]));
+		await Promise.all(Array.from(members.values()).map((member) => execute(member, "team_list")));
+		return { broker, members };
+	}
+
+	it("lists distinct workers that share an agent definition", async () => {
+		const { members } = await setup([
+			{ id: "research-a", agent: "scout" },
+			{ id: "research-b", agent: "scout" },
+		]);
+		const result = await execute(members.get("research-a") as TestMember, "team_list");
+		const list = details<{
+			self: { id: string; agent: string; status: string };
+			teammates: Array<{ id: string; agent: string; status: string }>;
+		}>(result);
+
+		expect(list.self).toEqual({ id: "research-a", agent: "scout", status: "running" });
+		expect(list.teammates).toEqual([{ id: "research-b", agent: "scout", status: "running" }]);
+	});
+
+	it("delivers complete Unicode messages once and in sender order", async () => {
+		const { members } = await setup([
+			{ id: "sender", agent: "worker" },
+			{ id: "recipient", agent: "worker" },
+		]);
+		const sender = members.get("sender") as TestMember;
+		const recipient = members.get("recipient") as TestMember;
+		const messages = ["Constraint: use café paths 日本語", "Second finding: 🚀\nfull text"];
+
+		for (const message of messages) {
+			const result = await execute(sender, "team_send", { recipient: "recipient", message });
+			expect(result.isError).toBe(false);
+			expect(details(result)).toEqual({ accepted: true, recipient: "recipient" });
+		}
+
+		expect(recipient.sendMessage).toHaveBeenCalledTimes(2);
+		for (let index = 0; index < messages.length; index++) {
+			expect(recipient.sendMessage.mock.calls[index]).toEqual([
+				{
+					customType: "subagent-team-message",
+					content: `Team message from "sender" (agent "worker"):\n\n${messages[index]}`,
+					display: true,
+					details: { sender: { id: "sender", agent: "worker" } },
+				},
+				{ triggerTurn: true, deliverAs: "steer" },
+			]);
+		}
+	});
+
+	it("isolates dispatches that reuse worker ids", async () => {
+		const definitions = [
+			{ id: "sender", agent: "worker" },
+			{ id: "recipient", agent: "worker" },
+		];
+		const first = await setup(definitions);
+		const second = await setup(definitions);
+
+		await execute(first.members.get("sender") as TestMember, "team_send", {
+			recipient: "recipient",
+			message: "first dispatch only",
+		});
+
+		expect(first.members.get("recipient")?.sendMessage).toHaveBeenCalledTimes(1);
+		expect(second.members.get("recipient")?.sendMessage).not.toHaveBeenCalled();
+	});
+
+	it("rejects invalid sends and reports partial broadcast failures", async () => {
+		const { members } = await setup([
+			{ id: "sender", agent: "worker" },
+			{ id: "running", agent: "worker" },
+			{ id: "finished", agent: "worker" },
+		]);
+		const sender = members.get("sender") as TestMember;
+		const finished = members.get("finished") as TestMember;
+		await finished.turnStart();
+		await finished.agentEnd();
+
+		const broadcast = await execute(sender, "team_broadcast", { message: "shared finding" });
+		expect(broadcast.isError).toBe(true);
+		expect(details(broadcast)).toEqual({
+			accepted: ["running"],
+			failed: [{ recipient: "finished", error: 'Worker "finished" is not running (status: finished).' }],
+		});
+		expect(members.get("running")?.sendMessage).toHaveBeenCalledTimes(1);
+		expect(finished.sendMessage).not.toHaveBeenCalled();
+
+		const selfSend = await execute(sender, "team_send", { recipient: "sender", message: "no" });
+		expect(selfSend.isError).toBe(true);
+		expect(details<{ error: string }>(selfSend).error).toContain("yourself");
+
+		const oversized = await execute(sender, "team_send", {
+			recipient: "running",
+			message: "x".repeat(MAX_TEAM_MESSAGE_BYTES + 1),
+		});
+		expect(oversized.isError).toBe(true);
+		expect(details<{ error: string }>(oversized).error).toContain("maximum supported size");
+	});
+
+	it("keeps a worker alive for a message accepted during its finish barrier", async () => {
+		const { members } = await setup([
+			{ id: "sender", agent: "worker" },
+			{ id: "recipient", agent: "worker" },
+		]);
+		const sender = members.get("sender") as TestMember;
+		const recipient = members.get("recipient") as TestMember;
+		const sendPromise = execute(sender, "team_send", { recipient: "recipient", message: "late finding" });
+		await recipient.agentEnd();
+		await sendPromise;
+
+		const list = await execute(recipient, "team_list");
+		expect(details<{ self: { status: string } }>(list).self.status).toBe("running");
+		expect(recipient.sendMessage).toHaveBeenCalledTimes(1);
+
+		await recipient.turnStart();
+		await recipient.agentEnd();
+		const laterSend = await execute(sender, "team_send", { recipient: "recipient", message: "too late" });
+		expect(laterSend.isError).toBe(true);
+		expect(details<{ error: string }>(laterSend).error).toContain("not running");
+	});
+});
