+import { randomBytes, randomUUID } from "node:crypto";
+import * as net from "node:net";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+export const TEAM_ENV_VAR = "PI_SUBAGENT_TEAM";
+export const MAX_TEAM_MESSAGE_BYTES = 256 * 1024;
+
+export const TEAM_TOOL_NAMES = ["team_list", "team_send", "team_broadcast"] as const;
+
+type WorkerStatus = "queued" | "starting" | "running" | "draining" | "finished";
+
+export interface TeamWorkerDefinition {
+	id: string;
+	agent: string;
+}
+
+export interface TeamMemberConfig {
+	host: string;
+	port: number;
+	token: string;
+	workerId: string;
+}
+
+interface TeamMemberInfo extends TeamWorkerDefinition {
+	status: WorkerStatus;
+}
+
+interface Delivery {
+	deliveryId: string;
+	sender: TeamWorkerDefinition;
+	message: string;
+}
+
+interface PendingDelivery {
+	resolve: () => void;
+	reject: (error: Error) => void;
+}
+
+interface WorkerState extends TeamWorkerDefinition {
+	status: WorkerStatus;
+	socket?: net.Socket;
+	pendingDeliveries: Map<string, PendingDelivery>;
+	drainWaiters: Array<() => void>;
+}
+
+interface ClientRequest {
+	type: "request";
+	requestId: string;
+	method: string;
+	token?: string;
+	workerId?: string;
+	recipient?: string;
+	message?: string;
+}
+
+interface ServerResponse {
+	type: "response";
+	requestId: string;
+	ok: boolean;
+	result?: unknown;
+	error?: string;
+}
+
+interface DeliveryMessage {
+	type: "delivery";
+	deliveryId: string;
+	sender: TeamWorkerDefinition;
+	message: string;
+}
+
+interface DeliveryAck {
+	type: "delivery_ack";
+	deliveryId: string;
+	error?: string;
+}
+
+const MAX_PROTOCOL_FRAME_BYTES = MAX_TEAM_MESSAGE_BYTES * 6 + 64 * 1024;
+
+function errorMessage(error: unknown): string {
+	return error instanceof Error ? error.message : String(error);
+}
+
+function writeMessage(
+	socket: net.Socket,
+	message: ServerResponse | DeliveryMessage | ClientRequest | DeliveryAck,
+): void {
+	socket.write(`${JSON.stringify(message)}\n`);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null;
+}
+
+function validateMessage(message: unknown): string {
+	if (typeof message !== "string") throw new Error("message must be a string");
+	const size = Buffer.byteLength(message, "utf8");
+	if (size === 0) throw new Error("message must not be empty");
+	if (size > MAX_TEAM_MESSAGE_BYTES) {
+		throw new Error(`message is ${size} bytes; maximum supported size is ${MAX_TEAM_MESSAGE_BYTES} bytes`);
+	}
+	return message;
+}
+
+function parseFrame(line: string): Record<string, unknown> {
+	let value: unknown;
+	try {
+		value = JSON.parse(line);
+	} catch {
+		throw new Error("invalid JSON request");
+	}
+	if (!isRecord(value)) throw new Error("request must be a JSON object");
+	return value;
+}
+
+export class ParallelTeamBroker {
+	private readonly token = randomBytes(32).toString("hex");
+	private readonly workers = new Map<string, WorkerState>();
+	private readonly sockets = new Set<net.Socket>();
+	private readonly startupWaiters: Array<() => void> = [];
+	private server?: net.Server;
+	private port?: number;
+	private closed = false;
+
+	constructor(definitions: TeamWorkerDefinition[]) {
+		for (const definition of definitions) {
+			if (this.workers.has(definition.id)) throw new Error(`Duplicate worker id: "${definition.id}".`);
+			this.workers.set(definition.id, {
+				...definition,
+				status: "queued",
+				pendingDeliveries: new Map(),
+				drainWaiters: [],
+			});
+		}
+	}
+
+	async start(): Promise<void> {
+		if (this.server) throw new Error("Team broker already started.");
+		this.server = net.createServer((socket) => this.acceptConnection(socket));
+		await new Promise<void>((resolve, reject) => {
+			this.server?.once("error", reject);
+			this.server?.listen(0, "127.0.0.1", () => {
+				this.server?.off("error", reject);
+				const address = this.server?.address();
+				if (!address || typeof address === "string") {
+					reject(new Error("Team broker did not receive a TCP port."));
+					return;
+				}
+				this.port = address.port;
+				resolve();
+			});
+		});
+	}
+
+	markStarting(workerId: string): void {
+		const worker = this.requireWorker(workerId);
+		if (worker.status !== "queued") throw new Error(`Worker "${workerId}" cannot start from ${worker.status}.`);
+		worker.status = "starting";
+	}
+
+	markFinished(workerId: string): void {
+		const worker = this.requireWorker(workerId);
+		this.finishWorker(worker, new Error(`Worker "${workerId}" stopped before accepting the message.`));
+	}
+
+	getWorkerEnvironment(workerId: string): NodeJS.ProcessEnv {
+		if (!this.port) throw new Error("Team broker has not started.");
+		this.requireWorker(workerId);
+		const config: TeamMemberConfig = {
+			host: "127.0.0.1",
+			port: this.port,
+			token: this.token,
+			workerId,
+		};
+		return { [TEAM_ENV_VAR]: JSON.stringify(config) };
+	}
+
+	async close(): Promise<void> {
+		if (this.closed) return;
+		this.closed = true;
+		for (const worker of this.workers.values()) {
+			this.finishWorker(worker, new Error("Team dispatch ended before accepting the message."));
+		}
+		for (const socket of this.sockets) socket.destroy();
+		this.sockets.clear();
+		if (!this.server) return;
+		await new Promise<void>((resolve) => this.server?.close(() => resolve()));
+	}
+
+	private requireWorker(workerId: string): WorkerState {
+		const worker = this.workers.get(workerId);
+		if (!worker) throw new Error(`Unknown worker: "${workerId}".`);
+		return worker;
+	}
+
+	private acceptConnection(socket: net.Socket): void {
+		this.sockets.add(socket);
+		socket.setEncoding("utf8");
+		let buffer = "";
+		let authenticatedWorker: WorkerState | undefined;
+
+		const closeWithError = (message: string) => {
+			if (!socket.destroyed) socket.destroy(new Error(message));
+		};
+
+		socket.on("data", (chunk: string) => {
+			buffer += chunk;
+			const lines = buffer.split("\n");
+			buffer = lines.pop() ?? "";
+			if (Buffer.byteLength(buffer, "utf8") > MAX_PROTOCOL_FRAME_BYTES) {
+				closeWithError("Team protocol frame exceeds the supported size.");
+				return;
+			}
+			for (const line of lines) {
+				if (!line) continue;
+				if (Buffer.byteLength(line, "utf8") > MAX_PROTOCOL_FRAME_BYTES) {
+					closeWithError("Team protocol frame exceeds the supported size.");
+					return;
+				}
+				let frame: Record<string, unknown>;
+				try {
+					frame = parseFrame(line);
+				} catch (error) {
+					closeWithError(errorMessage(error));
+					return;
+				}
+
+				if (frame.type === "delivery_ack") {
+					if (!authenticatedWorker || typeof frame.deliveryId !== "string") {
+						closeWithError("Invalid delivery acknowledgement.");
+						return;
+					}
+					this.handleDeliveryAck(authenticatedWorker, {
+						type: "delivery_ack",
+						deliveryId: frame.deliveryId,
+						error: typeof frame.error === "string" ? frame.error : undefined,
+					});
+					continue;
+				}
+
+				if (frame.type !== "request" || typeof frame.requestId !== "string" || typeof frame.method !== "string") {
+					closeWithError("Invalid team request.");
+					return;
+				}
+				const request = frame as unknown as ClientRequest;
+				if (!authenticatedWorker) {
+					if (request.method !== "hello") {
+						this.respond(socket, request.requestId, false, undefined, "Authentication required.");
+						continue;
+					}
+					try {
+						authenticatedWorker = this.authenticate(socket, request);
+						this.waitForStartup().then(
+							() => this.respond(socket, request.requestId, true, { workerId: authenticatedWorker?.id }),
+							(error) => this.respond(socket, request.requestId, false, undefined, errorMessage(error)),
+						);
+					} catch (error) {
+						this.respond(socket, request.requestId, false, undefined, errorMessage(error));
+					}
+					continue;
+				}
+				void this.handleRequest(authenticatedWorker, socket, request);
+			}
+		});
+
+		const onClose = () => {
+			this.sockets.delete(socket);
+			if (authenticatedWorker?.socket === socket) {
+				this.finishWorker(
+					authenticatedWorker,
+					new Error(`Worker "${authenticatedWorker.id}" disconnected before accepting the message.`),
+				);
+			}
+		};
+		socket.on("close", onClose);
+		socket.on("error", () => undefined);
+	}
+
+	private authenticate(socket: net.Socket, request: ClientRequest): WorkerState {
+		if (request.token !== this.token) throw new Error("Invalid team capability token.");
+		if (typeof request.workerId !== "string") throw new Error("workerId is required.");
+		const worker = this.requireWorker(request.workerId);
+		if (worker.status !== "starting") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+		if (worker.socket) throw new Error(`Worker "${worker.id}" is already connected.`);
+		worker.socket = socket;
+		worker.status = "running";
+		this.releaseStartupWaitersIfReady();
+		return worker;
+	}
+
+	private waitForStartup(): Promise<void> {
+		if (this.closed) return Promise.reject(new Error("Team broker is closed."));
+		if (this.isStartupComplete()) return Promise.resolve();
+		return new Promise((resolve) => this.startupWaiters.push(resolve));
+	}
+
+	private isStartupComplete(): boolean {
+		return Array.from(this.workers.values()).every(
+			(worker) => worker.status !== "queued" && worker.status !== "starting",
+		);
+	}
+
+	private releaseStartupWaitersIfReady(): void {
+		if (!this.isStartupComplete()) return;
+		while (this.startupWaiters.length > 0) this.startupWaiters.shift()?.();
+	}
+
+	private async handleRequest(worker: WorkerState, socket: net.Socket, request: ClientRequest): Promise<void> {
+		try {
+			if (request.method === "list") {
+				const members = Array.from(this.workers.values()).map<TeamMemberInfo>(({ id, agent, status }) => ({
+					id,
+					agent,
+					status,
+				}));
+				this.respond(socket, request.requestId, true, {
+					self: members.find((member) => member.id === worker.id),
+					teammates: members.filter((member) => member.id !== worker.id),
+				});
+				return;
+			}
+
+			if (request.method === "send") {
+				if (worker.status !== "running") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+				if (typeof request.recipient !== "string") throw new Error("recipient must be a string");
+				if (request.recipient === worker.id) throw new Error("Cannot send a team message to yourself.");
+				const message = validateMessage(request.message);
+				await this.deliver(worker, this.requireWorker(request.recipient), message);
+				this.respond(socket, request.requestId, true, { accepted: true, recipient: request.recipient });
+				return;
+			}
+
+			if (request.method === "broadcast") {
+				if (worker.status !== "running") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+				const message = validateMessage(request.message);
+				const deliveries = Array.from(this.workers.values())
+					.filter((recipient) => recipient.id !== worker.id)
+					.map((recipient) => ({
+						recipient: recipient.id,
+						promise: this.deliver(worker, recipient, message),
+					}));
+				const settled = await Promise.allSettled(deliveries.map((delivery) => delivery.promise));
+				const accepted: string[] = [];
+				const failed: Array<{ recipient: string; error: string }> = [];
+				for (let index = 0; index < settled.length; index++) {
+					const result = settled[index];
+					const recipient = deliveries[index].recipient;
+					if (result.status === "fulfilled") accepted.push(recipient);
+					else failed.push({ recipient, error: errorMessage(result.reason) });
+				}
+				this.respond(socket, request.requestId, true, { accepted, failed });
+				return;
+			}
+
+			if (request.method === "prepare_finish") {
+				if (worker.status !== "running") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+				worker.status = "draining";
+				await this.waitForDeliveries(worker);
+				this.respond(socket, request.requestId, true, { drained: true });
+				return;
+			}
+
+			if (request.method === "resume") {
+				if (worker.status !== "draining") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+				worker.status = "running";
+				this.respond(socket, request.requestId, true, { running: true });
+				return;
+			}
+
+			if (request.method === "finish") {
+				if (worker.status !== "draining") throw new Error(`Worker "${worker.id}" is ${worker.status}.`);
+				worker.status = "finished";
+				this.respond(socket, request.requestId, true, { finished: true });
+				return;
+			}
+
+			throw new Error(`Unsupported team request: "${request.method}".`);
+		} catch (error) {
+			this.respond(socket, request.requestId, false, undefined, errorMessage(error));
+		}
+	}
+
+	private deliver(sender: WorkerState, recipient: WorkerState, message: string): Promise<void> {
+		if (recipient.status !== "running" || !recipient.socket || recipient.socket.destroyed) {
+			return Promise.reject(new Error(`Worker "${recipient.id}" is not running (status: ${recipient.status}).`));
+		}
+		const deliveryId = randomUUID();
+		return new Promise<void>((resolve, reject) => {
+			recipient.pendingDeliveries.set(deliveryId, { resolve, reject });
+			writeMessage(recipient.socket as net.Socket, {
+				type: "delivery",
+				deliveryId,
+				sender: { id: sender.id, agent: sender.agent },
+				message,
+			});
+		});
+	}
+
+	private handleDeliveryAck(worker: WorkerState, ack: DeliveryAck): void {
+		const pending = worker.pendingDeliveries.get(ack.deliveryId);
+		if (!pending) return;
+		worker.pendingDeliveries.delete(ack.deliveryId);
+		if (ack.error) pending.reject(new Error(`Worker "${worker.id}" rejected the message: ${ack.error}`));
+		else pending.resolve();
+		if (worker.pendingDeliveries.size === 0) {
+			while (worker.drainWaiters.length > 0) worker.drainWaiters.shift()?.();
+		}
+	}
+
+	private waitForDeliveries(worker: WorkerState): Promise<void> {
+		if (worker.pendingDeliveries.size === 0) return Promise.resolve();
+		return new Promise((resolve) => worker.drainWaiters.push(resolve));
+	}
+
+	private finishWorker(worker: WorkerState, error: Error): void {
+		if (worker.status === "finished") return;
+		worker.status = "finished";
+		for (const pending of worker.pendingDeliveries.values()) pending.reject(error);
+		worker.pendingDeliveries.clear();
+		while (worker.drainWaiters.length > 0) worker.drainWaiters.shift()?.();
+		this.releaseStartupWaitersIfReady();
+	}
+
+	private respond(socket: net.Socket, requestId: string, ok: boolean, result?: unknown, error?: string): void {
+		if (socket.destroyed) return;
+		writeMessage(socket, { type: "response", requestId, ok, result, error });
+	}
+}
+
+interface PendingRequest {
+	resolve: (result: unknown) => void;
+	reject: (error: Error) => void;
+}
+
+class TeamMemberClient {
+	private readonly socket: net.Socket;
+	private readonly pendingRequests = new Map<string, PendingRequest>();
+	private readonly ready: Promise<void>;
+	private deliveryHandler?: (delivery: Delivery) => void;
+	private buffer = "";
+	private closed = false;
+
+	constructor(config: TeamMemberConfig) {
+		this.socket = net.createConnection({ host: config.host, port: config.port });
+		this.socket.setEncoding("utf8");
+		this.socket.on("data", (chunk: string) => this.handleData(chunk));
+		this.socket.on("error", (error) => this.fail(error));
+		this.socket.on("close", () => this.fail(new Error("Team connection closed.")));
+		this.ready = new Promise<void>((resolve, reject) => {
+			this.socket.once("error", reject);
+			this.socket.once("close", () => reject(new Error("Team connection closed before startup.")));
+			this.socket.once("connect", () => {
+				this.requestRaw("hello", { token: config.token, workerId: config.workerId }).then(
+					() => resolve(),
+					(error) => reject(error),
+				);
+			});
+		});
+		void this.ready.catch(() => undefined);
+	}
+
+	setDeliveryHandler(handler: (delivery: Delivery) => void): void {
+		this.deliveryHandler = handler;
+	}
+
+	async request(method: string, fields: { recipient?: string; message?: string } = {}): Promise<unknown> {
+		await this.ready;
+		return this.requestRaw(method, fields);
+	}
+
+	close(): void {
+		if (this.closed) return;
+		this.closed = true;
+		this.socket.end();
+	}
+
+	private requestRaw(method: string, fields: Record<string, unknown>): Promise<unknown> {
+		if (this.closed || this.socket.destroyed) return Promise.reject(new Error("Team connection is closed."));
+		const requestId = randomUUID();
+		return new Promise((resolve, reject) => {
+			this.pendingRequests.set(requestId, { resolve, reject });
+			writeMessage(this.socket, { type: "request", requestId, method, ...fields });
+		});
+	}
+
+	private handleData(chunk: string): void {
+		this.buffer += chunk;
+		const lines = this.buffer.split("\n");
+		this.buffer = lines.pop() ?? "";
+		if (Buffer.byteLength(this.buffer, "utf8") > MAX_PROTOCOL_FRAME_BYTES) {
+			this.fail(new Error("Team protocol frame exceeds the supported size."));
+			this.socket.destroy();
+			return;
+		}
+		for (const line of lines) {
+			if (!line) continue;
+			if (Buffer.byteLength(line, "utf8") > MAX_PROTOCOL_FRAME_BYTES) {
+				this.fail(new Error("Team protocol frame exceeds the supported size."));
+				this.socket.destroy();
+				return;
+			}
+			let frame: Record<string, unknown>;
+			try {
+				frame = parseFrame(line);
+			} catch (error) {
+				this.fail(error instanceof Error ? error : new Error(String(error)));
+				this.socket.destroy();
+				return;
+			}
+			if (frame.type === "response" && typeof frame.requestId === "string" && typeof frame.ok === "boolean") {
+				const pending = this.pendingRequests.get(frame.requestId);
+				if (!pending) continue;
+				this.pendingRequests.delete(frame.requestId);
+				if (frame.ok) pending.resolve(frame.result);
+				else pending.reject(new Error(typeof frame.error === "string" ? frame.error : "Team request failed."));
+				continue;
+			}
+			if (
+				frame.type === "delivery" &&
+				typeof frame.deliveryId === "string" &&
+				isRecord(frame.sender) &&
+				typeof frame.sender.id === "string" &&
+				typeof frame.sender.agent === "string" &&
+				typeof frame.message === "string"
+			) {
+				try {
+					this.deliveryHandler?.({
+						deliveryId: frame.deliveryId,
+						sender: { id: frame.sender.id, agent: frame.sender.agent },
+						message: frame.message,
+					});
+					writeMessage(this.socket, { type: "delivery_ack", deliveryId: frame.deliveryId });
+				} catch (error) {
+					writeMessage(this.socket, {
+						type: "delivery_ack",
+						deliveryId: frame.deliveryId,
+						error: errorMessage(error),
+					});
+				}
+			}
+		}
+	}
+
+	private fail(error: Error): void {
+		if (this.closed) return;
+		this.closed = true;
+		for (const pending of this.pendingRequests.values()) pending.reject(error);
+		this.pendingRequests.clear();
+	}
+}
+
+export function readTeamMemberConfig(env: NodeJS.ProcessEnv = process.env): TeamMemberConfig | undefined {
+	const raw = env[TEAM_ENV_VAR];
+	if (!raw) return undefined;
+	let value: unknown;
+	try {
+		value = JSON.parse(raw);
+	} catch {
+		throw new Error(`${TEAM_ENV_VAR} must contain valid JSON.`);
+	}
+	if (
+		!isRecord(value) ||
+		typeof value.host !== "string" ||
+		typeof value.port !== "number" ||
+		!Number.isInteger(value.port) ||
+		typeof value.token !== "string" ||
+		typeof value.workerId !== "string"
+	) {
+		throw new Error(`${TEAM_ENV_VAR} has an invalid team member configuration.`);
+	}
+	return { host: value.host, port: value.port, token: value.token, workerId: value.workerId };
+}
+
+function toolResult(result: unknown, isError = false) {
+	return {
+		content: [{ type: "text" as const, text: JSON.stringify(result, null, 2) }],
+		details: result,
+		isError,
+	};
+}
+
+export function registerTeamMemberExtension(pi: ExtensionAPI, config: TeamMemberConfig): void {
+	const client = new TeamMemberClient(config);
+	let receivedCount = 0;
+	let startedThrough = 0;
+
+	client.setDeliveryHandler((delivery) => {
+		receivedCount++;
+		pi.sendMessage(
+			{
+				customType: "subagent-team-message",
+				content: `Team message from "${delivery.sender.id}" (agent "${delivery.sender.agent}"):\n\n${delivery.message}`,
+				display: true,
+				details: { sender: delivery.sender },
+			},
+			{ triggerTurn: true, deliverAs: "steer" },
+		);
+	});
+
+	pi.registerTool({
+		name: "team_list",
+		label: "Team List",
+		description: "List your worker identity and all teammates with their current status.",
+		parameters: Type.Object({}),
+		async execute() {
+			try {
+				return toolResult(await client.request("list"));
+			} catch (error) {
+				return toolResult({ error: errorMessage(error) }, true);
+			}
+		},
+	});
+
+	pi.registerTool({
+		name: "team_send",
+		label: "Team Send",
+		description: `Send a private message to one running teammate by worker id. Acceptance does not wait for a reply. Maximum UTF-8 size: ${MAX_TEAM_MESSAGE_BYTES} bytes.`,
+		parameters: Type.Object({
+			recipient: Type.String({ description: "Recipient worker id from team_list" }),
+			message: Type.String({ description: "Complete message to deliver" }),
+		}),
+		async execute(_toolCallId, params) {
+			try {
+				return toolResult(await client.request("send", params));
+			} catch (error) {
+				return toolResult({ accepted: false, recipient: params.recipient, error: errorMessage(error) }, true);
+			}
+		},
+	});
+
+	pi.registerTool({
+		name: "team_broadcast",
+		label: "Team Broadcast",
+		description: `Broadcast a message to every running teammate except yourself. Acceptance does not wait for replies. Maximum UTF-8 size: ${MAX_TEAM_MESSAGE_BYTES} bytes.`,
+		parameters: Type.Object({ message: Type.String({ description: "Complete message to deliver" }) }),
+		async execute(_toolCallId, params) {
+			try {
+				const result = await client.request("broadcast", params);
+				const hasFailures = isRecord(result) && Array.isArray(result.failed) && result.failed.length > 0;
+				return toolResult(result, hasFailures);
+			} catch (error) {
+				return toolResult({ accepted: [], failed: [{ recipient: "*", error: errorMessage(error) }] }, true);
+			}
+		},
+	});
+
+	pi.on("turn_start", () => {
+		startedThrough = receivedCount;
+	});
+
+	pi.on("agent_end", async () => {
+		try {
+			await client.request("prepare_finish");
+			if (receivedCount > startedThrough) {
+				await client.request("resume");
+				return;
+			}
+			await client.request("finish");
+			client.close();
+		} catch {
+			client.close();
+		}
+	});
+}
