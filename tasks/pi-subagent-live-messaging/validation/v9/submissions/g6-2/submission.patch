@@ -0,0 +1,40 @@
+import { fauxAssistantMessage, fauxProvider, fauxToolCall } from "@earendil-works/pi-ai";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+export default function (pi: ExtensionAPI): void {
+	const modelIndex = process.argv.indexOf("--model");
+	const [provider, id] = process.argv[modelIndex + 1].split("/");
+	const sender = process.argv.at(-1)?.includes("sender");
+	const faux = fauxProvider({ provider, models: [{ id }] });
+	faux.setResponses([
+		async (_context, options) => {
+			await new Promise<void>((resolve) => {
+				const release = () => {
+					process.off("message", release);
+					options?.signal?.removeEventListener("abort", release);
+					resolve();
+				};
+				process.once("message", release);
+				options?.signal?.addEventListener("abort", release, { once: true });
+				process.send?.({ type: "test_model_started" });
+			});
+			return sender
+				? fauxAssistantMessage(fauxToolCall("team_send", { to: "worker-2", text: "共享接口约束" }), {
+						stopReason: "toolUse",
+					})
+				: fauxAssistantMessage("original final answer");
+		},
+		(context) => {
+			if (sender) process.send?.({ type: "test_sent" });
+			const findings = context.messages.filter((message) => message.role === "user");
+			return fauxAssistantMessage(sender ? "sent finding" : JSON.stringify(findings));
+		},
+	]);
+	pi.registerProvider(provider, {
+		api: faux.api,
+		baseUrl: faux.getModel().baseUrl,
+		apiKey: "faux-key",
+		models: faux.models,
+		streamSimple: faux.provider.streamSimple,
+	});
+}
diff --git a/packages/coding-agent/test/subagent-team.test.ts b/packages/coding-agent/test/subagent-team.test.ts
new file mode 100644
index 000000000..1d63c3567
--- /dev/null
+++ b/packages/coding-agent/test/subagent-team.test.ts
@@ -0,0 +1,188 @@
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import { MAX_INBOX_BYTES, MAX_MESSAGE_BYTES, TeamBroker } from "../examples/extensions/subagent/team.ts";
+
+const tasks = [
+	{ agent: "worker", task: "Investigate interface" },
+	{ agent: "worker", task: "Implement interface" },
+	{ agent: "worker", task: "Review interface" },
+];
+
+function runningTeam(): TeamBroker {
+	const team = new TeamBroker(tasks);
+	for (let index = 0; index < tasks.length; index++) team.handle(index, { action: "ready" });
+	return team;
+}
+
+describe("subagent team broker", () => {
+	it("addresses repeated agent definitions independently and reports lifecycle states", () => {
+		const team = new TeamBroker(tasks);
+		team.handle(0, { action: "ready" });
+		team.finish(2);
+		expect(team.handle(0, { action: "list" })).toEqual({
+			kind: "roster",
+			self: "worker-1",
+			workers: tasks.map((task, index) => ({
+				...task,
+				id: `worker-${index + 1}`,
+				state: ["running", "pending", "finished"][index],
+			})),
+		});
+	});
+
+	it("delivers private findings once in sender order with authoritative identity", () => {
+		const team = runningTeam();
+		for (const text of ["first", "第二条\n\u{1f9ea}\u0000", "third"]) {
+			expect(team.handle(0, { action: "send", to: "worker-2", text })).toEqual({
+				kind: "sent",
+				accepted: ["worker-2"],
+				failed: [],
+			});
+		}
+		expect(team.handle(1, { action: "drain", finishing: false })).toEqual({
+			kind: "drained",
+			finished: false,
+			messages: ["first", "第二条\n\u{1f9ea}\u0000", "third"].map((text) => ({
+				from: { id: "worker-1", agent: "worker" },
+				text,
+			})),
+		});
+		for (const index of [0, 1, 2]) {
+			expect(team.handle(index, { action: "drain", finishing: false })).toEqual({
+				kind: "drained",
+				messages: [],
+				finished: false,
+			});
+		}
+	});
+
+	it("reports partial broadcasts, skips self, and never starts pending or finished recipients", () => {
+		const team = new TeamBroker(tasks);
+		team.handle(0, { action: "ready" });
+		team.handle(1, { action: "ready" });
+		expect(team.handle(0, { action: "send", to: "*", text: "finding" })).toEqual({
+			kind: "sent",
+			accepted: ["worker-2"],
+			failed: [{ id: "worker-3", reason: "Worker is pending" }],
+		});
+		team.finish(1);
+		expect(team.handle(0, { action: "send", to: "*", text: "finding" })).toEqual({
+			kind: "sent",
+			accepted: [],
+			failed: [
+				{ id: "worker-2", reason: "Worker is finished" },
+				{ id: "worker-3", reason: "Worker is pending" },
+			],
+		});
+		expect(team.handle(1, { action: "ready" })).toHaveProperty("kind", "error");
+		expect(team.handle(0, { action: "drain", finishing: false })).toHaveProperty("messages", []);
+	});
+
+	it.each([
+		null,
+		{},
+		{ action: "unknown" },
+		{ action: "drain", finishing: "true" },
+		{ action: "send", to: 2, text: "finding" },
+		{ action: "send", to: "worker-2", text: 42 },
+		{ action: "send", to: "worker-2", text: " " },
+		{ action: "send", to: "worker-2", text: "\ud800" },
+		{ action: "send", to: "worker-2", text: "x", from: "worker-3" },
+		{ action: "send", to: "worker-2", text: "x".repeat(MAX_MESSAGE_BYTES + 1) },
+		{ action: "send", to: "missing", text: "finding" },
+	])("rejects invalid requests without accepting messages (%#)", (request) => {
+		const team = runningTeam();
+		expect(team.handle(0, request)).toHaveProperty("kind", "error");
+		expect(team.handle(1, { action: "drain", finishing: false })).toHaveProperty("messages", []);
+	});
+
+	it("explicitly rejects self sends", () => {
+		expect(runningTeam().handle(0, { action: "send", to: "worker-1", text: "finding" })).toEqual({
+			kind: "sent",
+			accepted: [],
+			failed: [{ id: "worker-1", reason: "Cannot send to yourself" }],
+		});
+	});
+
+	it("preserves maximum-size Unicode text and reports bounded-inbox failures", () => {
+		const team = runningTeam();
+		const text = "\u{1f9ea}".repeat(MAX_MESSAGE_BYTES / 4);
+		for (let index = 0; index < MAX_INBOX_BYTES / MAX_MESSAGE_BYTES; index++) {
+			expect(team.handle(0, { action: "send", to: "worker-2", text })).toHaveProperty("accepted", ["worker-2"]);
+		}
+		expect(team.handle(0, { action: "send", to: "*", text })).toEqual({
+			kind: "sent",
+			accepted: ["worker-3"],
+			failed: [{ id: "worker-2", reason: "Recipient inbox is full" }],
+		});
+		const drained = team.handle(1, { action: "drain", finishing: true });
+		expect(drained.kind).toBe("drained");
+		if (drained.kind !== "drained") throw new Error("Expected findings");
+		expect(drained.finished).toBe(false);
+		expect(drained.messages).toHaveLength(MAX_INBOX_BYTES / MAX_MESSAGE_BYTES);
+		for (const message of drained.messages) expect(message.text).toBe(text);
+		expect(team.handle(0, { action: "send", to: "worker-2", text })).toHaveProperty("accepted", ["worker-2"]);
+	});
+
+	it("serializes acceptance against the final drain, without reviving finished workers", () => {
+		const team = runningTeam();
+		team.handle(0, { action: "send", to: "worker-2", text: "before finish" });
+		expect(team.handle(1, { action: "drain", finishing: true })).toMatchObject({ kind: "drained", finished: false });
+		team.handle(0, { action: "send", to: "worker-2", text: "during continuation" });
+		expect(team.handle(1, { action: "drain", finishing: true })).toMatchObject({
+			finished: false,
+			messages: [{ text: "during continuation" }],
+		});
+		expect(team.handle(1, { action: "drain", finishing: true })).toEqual({
+			kind: "drained",
+			messages: [],
+			finished: true,
+		});
+		expect(team.handle(0, { action: "send", to: "worker-2", text: "too late" })).toHaveProperty("accepted", []);
+	});
+
+	it("isolates overlapping dispatches and reused identities after cleanup", () => {
+		const first = runningTeam();
+		const second = runningTeam();
+		first.handle(0, { action: "send", to: "worker-2", text: "private to first team" });
+		expect(second.handle(1, { action: "drain", finishing: false })).toHaveProperty("messages", []);
+		first.close();
+		expect(first.handle(0, { action: "send", to: "worker-2", text: "old channel" })).toHaveProperty("kind", "error");
+		expect(runningTeam().handle(1, { action: "drain", finishing: false })).toHaveProperty("messages", []);
+	});
+
+	it("transports full Unicode over a real inherited IPC channel", async () => {
+		const childTeam = new TeamBroker(tasks);
+		const child = spawn(
+			process.execPath,
+			[fileURLToPath(new URL("./fixtures/subagent-team-ipc.ts", import.meta.url))],
+			{
+				stdio: ["ignore", "pipe", "pipe", "ipc"],
+			},
+		);
+		const closed = once(child, "close");
+		childTeam.attach(0, child);
+		childTeam.handle(1, { action: "ready" });
+		const text = "\u{1f9ea}界\n".repeat(8000);
+		let stderr = "";
+		child.stderr?.on("data", (data) => {
+			stderr += data.toString();
+		});
+		const sent = once(child, "message");
+		child.send({ text });
+		try {
+			await sent;
+			const [code] = await closed;
+			expect(stderr).toBe("");
+			expect(code).toBe(0);
+			expect(childTeam.handle(1, { action: "drain", finishing: false })).toMatchObject({
+				messages: [{ from: { id: "worker-1", agent: "worker" }, text }],
+			});
+		} finally {
+			child.kill("SIGKILL");
+			childTeam.close();
+		}
+	});
+});
