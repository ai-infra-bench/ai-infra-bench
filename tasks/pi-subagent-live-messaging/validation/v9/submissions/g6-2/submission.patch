+import assert from "node:assert/strict";
+import { TeamClient } from "../../examples/extensions/subagent/team.ts";
+
+const client = new TeamClient({
+	send: (message, callback) => process.send!(message, callback),
+	on: (event, listener) => process.on(event, listener),
+	off: (event, listener) => process.off(event, listener),
+});
+
+process.once("message", async (message: { text: string }) => {
+	try {
+		assert.equal((await client.request({ action: "ready" })).kind, "roster");
+		assert.deepEqual(await client.request({ action: "send", to: "worker-2", text: message.text }), {
+			kind: "sent",
+			accepted: ["worker-2"],
+			failed: [],
+		});
+	} finally {
+		client.close();
+		process.disconnect();
+	}
+});
