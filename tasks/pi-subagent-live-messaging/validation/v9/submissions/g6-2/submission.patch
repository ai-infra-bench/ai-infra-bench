+import * as childProcess from "node:child_process";
+import { once } from "node:events";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import subagentExtension from "../../examples/extensions/subagent/index.ts";
+import { createHarness, getMessageText, type Harness } from "./harness.ts";
+
+vi.mock("@earendil-works/pi-coding-agent", () => ({
+	CONFIG_DIR_NAME: ".pi",
+	getAgentDir: () => "/missing-user-agent-dir",
+	getMarkdownTheme: () => ({}),
+	parseFrontmatter: (content: string) => ({
+		frontmatter: { name: "worker", description: "Test worker", tools: ["read"] },
+		body: content,
+	}),
+	withFileMutationQueue: async (_path: string, fn: () => Promise<unknown>) => fn(),
+}));
+
+const { spawn } = vi.hoisted(() => ({ spawn: process.getBuiltinModule("node:child_process").spawn }));
+vi.mock("node:child_process", { spy: true });
+const repoRoot = fileURLToPath(new URL("../../../../", import.meta.url));
+const cli = fileURLToPath(new URL("../../src/cli.ts", import.meta.url));
+const provider = fileURLToPath(new URL("../fixtures/subagent-team-provider.ts", import.meta.url));
+
+describe("subagent dispatch with separate source Pi processes", () => {
+	let harness: Harness | undefined;
+	const children: childProcess.ChildProcess[] = [];
+	const closes: Promise<unknown>[] = [];
+	const starts: Promise<boolean>[] = [];
+	const invocations: string[][] = [];
+
+	afterEach(async () => {
+		for (const child of children) {
+			if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+		}
+		await Promise.all(closes);
+		harness?.cleanup();
+		harness = undefined;
+		children.length = 0;
+		closes.length = 0;
+		starts.length = 0;
+		invocations.length = 0;
+		vi.restoreAllMocks();
+	});
+
+	async function setup(): Promise<Harness> {
+		const current = await createHarness({ extensionFactories: [subagentExtension] });
+		harness = current;
+		const agentsDir = join(current.tempDir, ".pi", "agents");
+		mkdirSync(agentsDir, { recursive: true });
+		writeFileSync(
+			join(agentsDir, "worker.md"),
+			"---\nname: worker\ndescription: Test worker\ntools: read\n---\nPreserve this system prompt.\n",
+		);
+		vi.mocked(childProcess.spawn).mockImplementation((_command, args, options) => {
+			const cliArgs = [...args].slice(args.indexOf("--mode"));
+			invocations.push(cliArgs);
+			const child = spawn(
+				process.execPath,
+				[
+					"--import",
+					join(repoRoot, "node_modules/tsx/dist/loader.mjs"),
+					cli,
+					"--no-extensions",
+					"--no-skills",
+					"--no-prompt-templates",
+					"--extension",
+					provider,
+					...cliArgs,
+				],
+				{
+					...options,
+					env: {
+						...process.env,
+						PI_CODING_AGENT_DIR: join(current.tempDir, "agent"),
+						PI_OFFLINE: "1",
+						TSX_TSCONFIG_PATH: join(repoRoot, "tsconfig.json"),
+					},
+				},
+			);
+			children.push(child);
+			closes.push(once(child, "close"));
+			starts.push(
+				new Promise<boolean>((resolve) => {
+					child.on("message", (message: { type: string }) => {
+						if (message.type === "test_model_started") resolve(true);
+					});
+					child.once("close", () => resolve(false));
+				}),
+			);
+			return child;
+		});
+		return current;
+	}
+
+	it("delivers to a finishing teammate using the existing entry point and restricted tools", async () => {
+		const current = await setup();
+		current.setResponses([
+			fauxAssistantMessage(
+				fauxToolCall("subagent", {
+					agentScope: "project",
+					communication: true,
+					tasks: [
+						{ agent: "worker", task: "sender" },
+						{ agent: "worker", task: "recipient" },
+					],
+				}),
+				{ stopReason: "toolUse" },
+			),
+			fauxAssistantMessage("parent done"),
+		]);
+		const prompt = current.session.prompt("Delegate");
+		await vi.waitFor(() => expect(children, current.session.messages.map(getMessageText).join("\n")).toHaveLength(2));
+		expect(await Promise.all(starts)).toEqual([true, true]);
+		const sent = new Promise<void>((resolve) => {
+			children[0].on("message", (message: { type: string }) => {
+				if (message.type === "test_sent") resolve();
+			});
+		});
+		children[0].send({ release: true });
+		await sent;
+		children[1].send({ release: true });
+		await prompt;
+		const result = current.session.messages.find((message) => message.role === "toolResult");
+		expect(getMessageText(result)).toContain("共享接口约束");
+		expect(getMessageText(result)).toContain("worker-1");
+		expect(getMessageText(result)).toContain("worker-2");
+		expect(children[0].pid).not.toBe(children[1].pid);
+		for (const args of invocations) {
+			expect(args[args.indexOf("--tools") + 1]).toBe("read,team_members,team_send");
+			expect(args[args.indexOf("--model") + 1]).toBe(`${current.getModel().provider}/${current.getModel().id}`);
+			expect(args).toContain("--append-system-prompt");
+		}
+		for (const child of children) expect(child.connected).toBe(false);
+	});
+
+	it.each(["starting", "running"])("cancels %s children, closes IPC, and never starts queued tasks", async (state) => {
+		const current = await setup();
+		current.setResponses([
+			fauxAssistantMessage(
+				fauxToolCall("subagent", {
+					agentScope: "project",
+					communication: true,
+					tasks: Array.from({ length: 6 }, () => ({ agent: "worker", task: "recipient" })),
+				}),
+				{ stopReason: "toolUse" },
+			),
+		]);
+		const prompt = current.session.prompt("Delegate");
+		await vi.waitFor(() => expect(children).toHaveLength(4));
+		if (state === "running") expect(await Promise.all(starts)).toEqual([true, true, true, true]);
+		await current.session.abort();
+		await prompt;
+		expect(children).toHaveLength(4);
+		for (const child of children) {
+			expect(child.connected).toBe(false);
+			expect(child.exitCode !== null || child.signalCode !== null).toBe(true);
+		}
+	});
+
+	it("does not add messaging flags or tools when disabled", async () => {
+		const current = await setup();
+		current.setResponses([
+			fauxAssistantMessage(
+				fauxToolCall("subagent", {
+					agentScope: "project",
+					tasks: [{ agent: "worker", task: "recipient" }],
+				}),
+				{ stopReason: "toolUse" },
+			),
+		]);
+		const prompt = current.session.prompt("Delegate");
+		await vi.waitFor(() => expect(children).toHaveLength(1));
+		expect(children[0].connected).toBe(false);
+		expect(invocations[0]).not.toContain("--extension");
+		expect(invocations[0][invocations[0].indexOf("--tools") + 1]).toBe("read");
+		await current.session.abort();
+		await prompt;
+	});
+
+	it("rejects communication outside parallel mode without launching children", async () => {
+		const current = await setup();
+		current.setResponses([
+			fauxAssistantMessage(fauxToolCall("subagent", { agent: "worker", task: "task", communication: true }), {
+				stopReason: "toolUse",
+			}),
+			fauxAssistantMessage("done"),
+		]);
+		await current.session.prompt("Delegate");
+		expect(children).toHaveLength(0);
