+import { EventEmitter } from "node:events";
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { TeamBroker, TeamClient, type TeamRequest } from "../../examples/extensions/subagent/team.ts";
+import { registerTeamWorker } from "../../examples/extensions/subagent/team-worker.ts";
+import { createHarness, getMessageText } from "./harness.ts";
+
+function createTeam(): { broker: TeamBroker; client: TeamClient } {
+	const broker = new TeamBroker([
+		{ agent: "worker", task: "Investigate" },
+		{ agent: "worker", task: "Implement" },
+		{ agent: "worker", task: "Review" },
+	]);
+	broker.handle(0, { action: "ready" });
+	const events = new EventEmitter();
+	const client = new TeamClient({
+		on: (event, listener) => events.on(event, listener),
+		off: (event, listener) => events.off(event, listener),
+		send(message, callback) {
+			const request = message as { id: number; request: TeamRequest };
+			queueMicrotask(() => {
+				events.emit("message", {
+					type: "subagent_team_response",
+					id: request.id,
+					response: broker.handle(1, request.request),
+				});
+				callback(null);
+			});
+			return true;
+		},
+	});
+	return { broker, client };
+}
+
+describe("subagent team turn delivery", () => {
+	it("injects every accepted finding in the next call without interrupting tools", async () => {
+		const { broker, client } = createTeam();
+		const completed: string[] = [];
+		const tools: AgentTool[] = ["first", "second"].map((name) => ({
+			name,
+			label: name,
+			description: name,
+			parameters: Type.Object({}),
+			async execute(_id, _params, signal) {
+				expect(broker.handle(0, { action: "send", to: "worker-2", text: `during ${name}` })).toHaveProperty(
+					"accepted",
+					["worker-2"],
+				);
+				await new Promise<void>((resolve) => setImmediate(resolve));
+				expect(signal?.aborted).toBe(false);
+				completed.push(name);
+				return { content: [{ type: "text", text: `completed ${name}` }], details: {} };
+			},
+		}));
+		const harness = await createHarness({
+			tools,
+			settings: { steeringMode: "one-at-a-time" },
+			extensionFactories: [(pi) => registerTeamWorker(pi, client)],
+		});
+		try {
+			harness.setResponses([
+				() => {
+					broker.handle(0, { action: "send", to: "worker-2", text: "during model response" });
+					return fauxAssistantMessage([fauxToolCall("first", {}), fauxToolCall("second", {})], {
+						stopReason: "toolUse",
+					});
+				},
+				(context) => {
+					expect(completed).toEqual(["first", "second"]);
+					const text = context.messages.map(getMessageText).join("\n");
+					for (const finding of ["during model response", "during first", "during second"])
+						expect(text).toContain(finding);
+					expect(text).toContain('"from":{"id":"worker-1","agent":"worker"}');
+					expect(context.messages.map((message) => message.role)).toEqual([
+						"user",
+						"assistant",
+						"toolResult",
+						"toolResult",
+						"user",
+					]);
+					return fauxAssistantMessage("used findings");
+				},
+			]);
+			await harness.session.prompt("Implement");
+			expect(harness.faux.state.callCount).toBe(2);
+			expect(harness.session.messages.filter((message) => message.role === "custom")).toHaveLength(1);
+		} finally {
+			harness.cleanup();
+			client.close();
+			broker.close();
+		}
+	});
+
+	it("continues an otherwise final response and consumes findings once", async () => {
+		const { broker, client } = createTeam();
+		const text = "约束\u{1f9ea}".repeat(6000);
+		const harness = await createHarness({ extensionFactories: [(pi) => registerTeamWorker(pi, client)] });
+		try {
+			harness.setResponses([
+				() => {
+					broker.handle(0, { action: "send", to: "worker-2", text });
+					return fauxAssistantMessage("would finish");
+				},
+				(context) => {
+					expect(context.messages.map(getMessageText).join("\n")).toContain(text);
+					broker.handle(0, { action: "send", to: "worker-2", text: "follow-on constraint" });
+					return fauxAssistantMessage("revised answer");
+				},
+				(context) => {
+					expect(context.messages.map(getMessageText).join("\n")).toContain("follow-on constraint");
+					return fauxAssistantMessage("final answer");
+				},
+			]);
+			await harness.session.prompt("Implement");
+			expect(harness.faux.state.callCount).toBe(3);
+			expect(harness.session.messages.filter((message) => message.role === "custom")).toHaveLength(2);
+			expect(broker.handle(0, { action: "send", to: "worker-2", text: "too late" })).toHaveProperty("accepted", []);
+			expect(harness.getPendingResponseCount()).toBe(0);
+		} finally {
+			harness.cleanup();
+			client.close();
+			broker.close();
+		}
+	});
+
+	it("exposes discovery and sends without awaiting replies, including partial failures", async () => {
+		const { broker, client } = createTeam();
+		const harness = await createHarness({ extensionFactories: [(pi) => registerTeamWorker(pi, client)] });
+		try {
+			harness.setResponses([
+				(context) => {
+					expect(context.systemPrompt).toContain("You are worker-2");
+					return fauxAssistantMessage(fauxToolCall("team_members", {}), { stopReason: "toolUse" });
+				},
+				fauxAssistantMessage(fauxToolCall("team_send", { to: "*", text: "interface constraint" }), {
+					stopReason: "toolUse",
+				}),
+				fauxAssistantMessage("done"),
+			]);
+			await harness.session.prompt("Share finding");
+			const results = harness.session.messages.filter((message) => message.role === "toolResult");
+			expect(JSON.parse(getMessageText(results[0]))).toMatchObject({
+				self: "worker-2",
+				workers: [{ id: "worker-1" }, { id: "worker-2" }, { id: "worker-3" }],
+			});
+			expect(JSON.parse(getMessageText(results[1]))).toEqual({
+				kind: "sent",
+				accepted: ["worker-1"],
+				failed: [{ id: "worker-3", reason: "Worker is pending" }],
+			});
+			expect(broker.handle(0, { action: "drain", finishing: false })).toMatchObject({
+				messages: [{ from: { id: "worker-2" }, text: "interface constraint" }],
+			});
+		} finally {
+			harness.cleanup();
+			client.close();
+			broker.close();
+		}
+	});
+});
