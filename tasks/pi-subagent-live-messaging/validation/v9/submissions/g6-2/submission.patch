@@ -0,0 +1,214 @@
+import type { ChildProcess, Serializable } from "node:child_process";
+
+export const MAX_MESSAGE_BYTES = 64 * 1024;
+export const MAX_INBOX_BYTES = 1024 * 1024;
+const MAX_INBOX_MESSAGES = 256;
+
+export interface TeamWorker {
+	id: string;
+	agent: string;
+	task: string;
+	state: "pending" | "running" | "finished";
+}
+
+export interface TeamFinding {
+	from: Pick<TeamWorker, "id" | "agent">;
+	text: string;
+}
+
+export type TeamRequest =
+	| { action: "ready" | "list" }
+	| { action: "send"; to: string; text: string }
+	| { action: "drain"; finishing: boolean };
+
+export type TeamResponse =
+	| { kind: "roster"; self: string; workers: TeamWorker[] }
+	| { kind: "sent"; accepted: string[]; failed: { id: string; reason: string }[] }
+	| { kind: "drained"; messages: TeamFinding[]; finished: boolean }
+	| { kind: "error"; error: string };
+
+export interface TeamChannel {
+	send(message: Serializable, callback: (error: Error | null) => void): boolean;
+	on(event: "message", listener: (message: unknown) => void): unknown;
+	on(event: "disconnect", listener: () => void): unknown;
+	off(event: "message", listener: (message: unknown) => void): unknown;
+	off(event: "disconnect", listener: () => void): unknown;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+interface Mailbox {
+	worker: TeamWorker;
+	messages: TeamFinding[];
+	bytes: number;
+	child?: ChildProcess;
+}
+
+export class TeamBroker {
+	private mailboxes: Mailbox[];
+	private closed = false;
+
+	constructor(tasks: { agent: string; task: string }[]) {
+		this.mailboxes = tasks.map((task, index) => ({
+			worker: { id: `worker-${index + 1}`, agent: task.agent, task: task.task, state: "pending" },
+			messages: [],
+			bytes: 0,
+		}));
+	}
+
+	attach(index: number, child: ChildProcess): void {
+		const mailbox = this.mailboxes[index];
+		if (this.closed || mailbox.child || mailbox.worker.state !== "pending") {
+			throw new Error("Cannot attach a worker to a closed or occupied mailbox");
+		}
+		mailbox.child = child;
+		const onMessage = (message: unknown) => {
+			if (!isRecord(message) || message.type !== "subagent_team_request") return;
+			const response = this.handle(index, message.request);
+			if (child.connected) {
+				child.send({ type: "subagent_team_response", id: message.id, response }, (error) => {
+					if (error) this.finish(index);
+				});
+			}
+		};
+		child.on("message", onMessage);
+		child.once("disconnect", () => this.finish(index));
+		child.once("close", () => {
+			child.off("message", onMessage);
+			this.finish(index);
+		});
+	}
+
+	handle(index: number, request: unknown): TeamResponse {
+		const mailbox = this.mailboxes[index];
+		if (this.closed || !mailbox || mailbox.worker.state === "finished") {
+			return { kind: "error", error: "Worker is no longer running" };
+		}
+		if (!isRecord(request)) return { kind: "error", error: "Invalid team request" };
+		const allowedKeys =
+			request.action === "send"
+				? ["action", "to", "text"]
+				: request.action === "drain"
+					? ["action", "finishing"]
+					: ["action"];
+		if (Object.keys(request).some((key) => !allowedKeys.includes(key))) {
+			return { kind: "error", error: "Unexpected team request fields" };
+		}
+		if (request.action === "ready" || request.action === "list") {
+			if (request.action === "ready") mailbox.worker.state = "running";
+			return {
+				kind: "roster",
+				self: mailbox.worker.id,
+				workers: this.mailboxes.map((entry) => ({ ...entry.worker })),
+			};
+		}
+		if (mailbox.worker.state !== "running") return { kind: "error", error: "Worker is not ready" };
+		if (request.action === "drain" && typeof request.finishing === "boolean") {
+			const messages = mailbox.messages;
+			mailbox.messages = [];
+			mailbox.bytes = 0;
+			const finished = request.finishing && messages.length === 0;
+			if (finished) this.finish(index);
+			return { kind: "drained", messages, finished };
+		}
+		if (request.action !== "send" || typeof request.to !== "string" || typeof request.text !== "string") {
+			return { kind: "error", error: "Expected send {to, text}, list, or drain {finishing}" };
+		}
+		const bytes = Buffer.byteLength(request.text, "utf8");
+		if (!request.text.trim() || bytes > MAX_MESSAGE_BYTES) {
+			return { kind: "error", error: `Message must be nonempty and at most ${MAX_MESSAGE_BYTES} UTF-8 bytes` };
+		}
+		if (Buffer.from(request.text, "utf8").toString("utf8") !== request.text) {
+			return { kind: "error", error: "Message contains invalid Unicode (unpaired surrogate)" };
+		}
+		const recipients =
+			request.to === "*"
+				? this.mailboxes.filter((entry) => entry !== mailbox)
+				: this.mailboxes.filter((entry) => entry.worker.id === request.to);
+		if (recipients.length === 0) return { kind: "error", error: `No teammates match recipient ${request.to}` };
+		const response: Extract<TeamResponse, { kind: "sent" }> = { kind: "sent", accepted: [], failed: [] };
+		for (const recipient of recipients) {
+			let reason: string | undefined;
+			if (recipient === mailbox) reason = "Cannot send to yourself";
+			else if (recipient.worker.state !== "running") reason = `Worker is ${recipient.worker.state}`;
+			else if (recipient.bytes + bytes > MAX_INBOX_BYTES || recipient.messages.length >= MAX_INBOX_MESSAGES) {
+				reason = "Recipient inbox is full";
+			}
+			if (reason) {
+				response.failed.push({ id: recipient.worker.id, reason });
+			} else {
+				recipient.messages.push({
+					from: { id: mailbox.worker.id, agent: mailbox.worker.agent },
+					text: request.text,
+				});
+				recipient.bytes += bytes;
+				response.accepted.push(recipient.worker.id);
+			}
+		}
+		return response;
+	}
+
+	finish(index: number): void {
+		const mailbox = this.mailboxes[index];
+		mailbox.worker.state = "finished";
+		mailbox.messages = [];
+		mailbox.bytes = 0;
+	}
+
+	close(): void {
+		this.closed = true;
+		for (let index = 0; index < this.mailboxes.length; index++) {
+			this.finish(index);
+		}
+	}
+}
+
+export class TeamClient {
+	private channel: TeamChannel;
+	private nextId = 0;
+	private closed = false;
+	private pending = new Map<number, { resolve: (response: TeamResponse) => void; reject: (error: Error) => void }>();
+
+	constructor(channel: TeamChannel) {
+		this.channel = channel;
+		channel.on("message", this.onMessage);
+		channel.on("disconnect", this.close);
+	}
+
+	private onMessage = (message: unknown): void => {
+		if (!isRecord(message) || message.type !== "subagent_team_response" || typeof message.id !== "number") return;
+		const pending = this.pending.get(message.id);
+		if (!pending) return;
+		this.pending.delete(message.id);
+		pending.resolve(message.response as TeamResponse);
+	};
+
+	request(request: TeamRequest): Promise<TeamResponse> {
+		if (this.closed) return Promise.reject(new Error("Team channel is closed"));
+		const id = this.nextId++;
+		return new Promise((resolve, reject) => {
+			this.pending.set(id, { resolve, reject });
+			try {
+				this.channel.send({ type: "subagent_team_request", id, request }, (error) => {
+					if (error) {
+						this.pending.delete(id);
+						reject(error);
+					}
+				});
+			} catch (error) {
+				this.pending.delete(id);
+				reject(error);
+			}
+		});
+	}
+
+	close = (): void => {
+		this.closed = true;
+		this.channel.off("message", this.onMessage);
+		this.channel.off("disconnect", this.close);
+		for (const pending of this.pending.values()) pending.reject(new Error("Team channel disconnected"));
+		this.pending.clear();
+	};
+}
