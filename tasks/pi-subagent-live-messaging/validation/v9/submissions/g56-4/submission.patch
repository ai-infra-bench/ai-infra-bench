diff --git a/packages/coding-agent/examples/extensions/subagent/team.ts b/packages/coding-agent/examples/extensions/subagent/team.ts
new file mode 100644
index 000000000..bbe213b79
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/subagent/team.ts
@@ -0,0 +1,472 @@
+import * as crypto from "node:crypto";
+import * as net from "node:net";
+import { StringDecoder } from "node:string_decoder";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+export const TEAM_MESSAGE_MAX_BYTES = 64 * 1024;
+export const TEAM_TOOL_NAMES = ["subagent_teammates", "subagent_send", "subagent_broadcast"] as const;
+const TEAM_REQUEST_MAX_BYTES = TEAM_MESSAGE_MAX_BYTES + 16 * 1024;
+const TEAM_REQUEST_TIMEOUT_MS = 35_000;
+
+export const TEAM_HOST_ENV = "PI_SUBAGENT_TEAM_HOST";
+export const TEAM_PORT_ENV = "PI_SUBAGENT_TEAM_PORT";
+export const TEAM_TOKEN_ENV = "PI_SUBAGENT_TEAM_TOKEN";
+
+export interface TeamTask {
+	id: string;
+	agent: string;
+	task: string;
+}
+
+export interface TeamMember {
+	id: string;
+	agent: string;
+	task: string;
+	status: "pending" | "running" | "finished";
+}
+
+interface TeamRequestBase {
+	token: string;
+}
+
+interface ListRequest extends TeamRequestBase {
+	type: "list";
+}
+
+interface SendRequest extends TeamRequestBase {
+	type: "send";
+	recipient: string;
+	message: string;
+}
+
+interface BroadcastRequest extends TeamRequestBase {
+	type: "broadcast";
+	message: string;
+}
+
+type TeamRequest = ListRequest | SendRequest | BroadcastRequest;
+
+interface DeliveryFailure {
+	recipient: string;
+	reason: string;
+}
+
+export interface TeamResponse {
+	ok: boolean;
+	self?: { id: string; agent: string };
+	teammates?: TeamMember[];
+	accepted?: string[];
+	failed?: DeliveryFailure[];
+	error?: string;
+}
+
+interface TeamMemberState extends TeamMember {
+	token: string;
+	deliver?: (message: string) => Promise<void>;
+	deliveryTail: Promise<void>;
+	outgoingTail: Promise<void>;
+}
+
+export interface TeamServer {
+	host: string;
+	port: number;
+	credentials(workerId: string): Record<string, string>;
+	startWorker(workerId: string, deliver: (message: string) => Promise<void>): void;
+	finishWorker(workerId: string, isIdle: () => Promise<boolean>): Promise<boolean>;
+	stopWorker(workerId: string): void;
+	close(): Promise<void>;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null;
+}
+
+function parseRequest(value: unknown): TeamRequest | string {
+	if (!isRecord(value) || typeof value.type !== "string" || typeof value.token !== "string") {
+		return "Invalid request: expected an object with string type and token fields.";
+	}
+	if (value.type === "list") return { type: "list", token: value.token };
+	if (value.type === "send") {
+		if (typeof value.recipient !== "string" || typeof value.message !== "string") {
+			return "Invalid send request: recipient and message must be strings.";
+		}
+		return { type: "send", token: value.token, recipient: value.recipient, message: value.message };
+	}
+	if (value.type === "broadcast") {
+		if (typeof value.message !== "string") return "Invalid broadcast request: message must be a string.";
+		return { type: "broadcast", token: value.token, message: value.message };
+	}
+	return `Unsupported request type: ${value.type}.`;
+}
+
+function validateMessage(message: string): string | undefined {
+	if (message.length === 0) return "Message must not be empty.";
+	const size = Buffer.byteLength(message, "utf8");
+	if (size > TEAM_MESSAGE_MAX_BYTES) {
+		return `Message is ${size} bytes; maximum supported size is ${TEAM_MESSAGE_MAX_BYTES} bytes.`;
+	}
+	return undefined;
+}
+
+function formatIncomingMessage(sender: TeamMemberState, message: string): string {
+	return `Teammate message from ${sender.id} (agent: ${sender.agent}):\n\n${message}`;
+}
+
+function queueOperation<T>(
+	member: TeamMemberState,
+	queue: "deliveryTail" | "outgoingTail",
+	operation: () => Promise<T>,
+): Promise<T> {
+	const result = member[queue].then(operation, operation);
+	member[queue] = result.then(
+		() => undefined,
+		() => undefined,
+	);
+	return result;
+}
+
+export function assignTeamTasks(tasks: Array<{ id?: string; agent: string; task: string }>): TeamTask[] | string {
+	const ids = new Set<string>();
+	const counts = new Map<string, number>();
+	const assigned: TeamTask[] = [];
+	for (const task of tasks) {
+		const count = (counts.get(task.agent) ?? 0) + 1;
+		counts.set(task.agent, count);
+		const id = task.id ?? `${task.agent}-${count}`;
+		if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(id)) {
+			return `Invalid worker id "${id}". Use 1-64 letters, digits, dots, underscores, or hyphens, starting with a letter or digit.`;
+		}
+		if (ids.has(id)) return `Duplicate worker id "${id}".`;
+		ids.add(id);
+		assigned.push({ id, agent: task.agent, task: task.task });
+	}
+	return assigned;
+}
+
+export async function createTeamServer(tasks: TeamTask[]): Promise<TeamServer> {
+	const members = new Map<string, TeamMemberState>();
+	const membersByToken = new Map<string, TeamMemberState>();
+	const sockets = new Set<net.Socket>();
+	let closed = false;
+
+	for (const task of tasks) {
+		const member: TeamMemberState = {
+			...task,
+			status: "pending",
+			token: crypto.randomBytes(32).toString("hex"),
+			deliveryTail: Promise.resolve(),
+			outgoingTail: Promise.resolve(),
+		};
+		members.set(member.id, member);
+		membersByToken.set(member.token, member);
+	}
+
+	const deliverTo = async (
+		sender: TeamMemberState,
+		recipientId: string,
+		message: string,
+	): Promise<DeliveryFailure | null> => {
+		if (recipientId === sender.id) return { recipient: recipientId, reason: "cannot send to yourself" };
+		const recipient = members.get(recipientId);
+		if (!recipient) return { recipient: recipientId, reason: "unknown teammate" };
+		return queueOperation(recipient, "deliveryTail", async () => {
+			if (closed) return { recipient: recipientId, reason: "team communication is closed" };
+			if (recipient.status !== "running" || !recipient.deliver) {
+				return { recipient: recipientId, reason: `teammate is ${recipient.status}` };
+			}
+			try {
+				await recipient.deliver(formatIncomingMessage(sender, message));
+				return null;
+			} catch (error: unknown) {
+				return {
+					recipient: recipientId,
+					reason: error instanceof Error ? error.message : String(error),
+				};
+			}
+		});
+	};
+
+	const handleRequest = async (value: unknown): Promise<TeamResponse> => {
+		const request = parseRequest(value);
+		if (typeof request === "string") return { ok: false, error: request };
+		const sender = membersByToken.get(request.token);
+		if (!sender) return { ok: false, error: "Authentication failed." };
+		if (sender.status !== "running") return { ok: false, error: `Sender ${sender.id} is ${sender.status}.` };
+
+		if (request.type === "list") {
+			return {
+				ok: true,
+				self: { id: sender.id, agent: sender.agent },
+				teammates: Array.from(members.values())
+					.filter((member) => member.id !== sender.id)
+					.map(({ id, agent, task, status }) => ({ id, agent, task, status })),
+			};
+		}
+
+		const validationError = validateMessage(request.message);
+		if (validationError) return { ok: false, error: validationError };
+
+		return queueOperation(sender, "outgoingTail", async () => {
+			if (sender.status !== "running") return { ok: false, error: `Sender ${sender.id} is ${sender.status}.` };
+			const recipientIds =
+				request.type === "send"
+					? [request.recipient]
+					: Array.from(members.values())
+							.filter((member) => member.id !== sender.id && member.status === "running")
+							.map((member) => member.id);
+			if (recipientIds.length === 0) {
+				return { ok: false, accepted: [], failed: [], error: "No running teammates are available." };
+			}
+
+			const failures = await Promise.all(
+				recipientIds.map((recipientId) => deliverTo(sender, recipientId, request.message)),
+			);
+			const failed = failures.filter((failure): failure is DeliveryFailure => failure !== null);
+			const failedIds = new Set(failed.map((failure) => failure.recipient));
+			const accepted = recipientIds.filter((recipientId) => !failedIds.has(recipientId));
+			return { ok: failed.length === 0, accepted, failed };
+		});
+	};
+
+	const server = net.createServer((socket) => {
+		sockets.add(socket);
+		const decoder = new StringDecoder("utf8");
+		let input = "";
+		let inputBytes = 0;
+		let responded = false;
+		const respond = (response: TeamResponse) => {
+			if (responded || socket.destroyed) return;
+			responded = true;
+			socket.end(`${JSON.stringify(response)}\n`);
+		};
+
+		socket.on("data", (chunk: Buffer) => {
+			if (responded) return;
+			inputBytes += chunk.length;
+			if (inputBytes > TEAM_REQUEST_MAX_BYTES) {
+				respond({ ok: false, error: `Request exceeds ${TEAM_REQUEST_MAX_BYTES} bytes.` });
+				return;
+			}
+			input += decoder.write(chunk);
+			const newline = input.indexOf("\n");
+			if (newline === -1) return;
+			const line = input.slice(0, newline);
+			let parsed: unknown;
+			try {
+				parsed = JSON.parse(line);
+			} catch (error: unknown) {
+				respond({
+					ok: false,
+					error: `Invalid JSON request: ${error instanceof Error ? error.message : String(error)}`,
+				});
+				return;
+			}
+			void handleRequest(parsed).then(respond, (error: unknown) => {
+				respond({ ok: false, error: error instanceof Error ? error.message : String(error) });
+			});
+		});
+		socket.on("error", () => {});
+		socket.on("close", () => sockets.delete(socket));
+	});
+
+	await new Promise<void>((resolve, reject) => {
+		server.once("error", reject);
+		server.listen(0, "127.0.0.1", () => {
+			server.off("error", reject);
+			resolve();
+		});
+	});
+	const address = server.address();
+	if (!address || typeof address === "string") throw new Error("Failed to create subagent team server.");
+
+	return {
+		host: address.address,
+		port: address.port,
+		credentials(workerId) {
+			const member = members.get(workerId);
+			if (!member) throw new Error(`Unknown worker id "${workerId}".`);
+			return {
+				[TEAM_HOST_ENV]: address.address,
+				[TEAM_PORT_ENV]: String(address.port),
+				[TEAM_TOKEN_ENV]: member.token,
+			};
+		},
+		startWorker(workerId, deliver) {
+			const member = members.get(workerId);
+			if (!member) throw new Error(`Unknown worker id "${workerId}".`);
+			if (closed || member.status !== "pending") throw new Error(`Worker ${workerId} cannot be started.`);
+			member.status = "running";
+			member.deliver = deliver;
+		},
+		finishWorker(workerId, isIdle) {
+			const member = members.get(workerId);
+			if (!member) return Promise.resolve(true);
+			return queueOperation(member, "deliveryTail", async () => {
+				if (member.status !== "running") return true;
+				if (!(await isIdle())) return false;
+				member.status = "finished";
+				member.deliver = undefined;
+				return true;
+			});
+		},
+		stopWorker(workerId) {
+			const member = members.get(workerId);
+			if (!member) return;
+			member.status = "finished";
+			member.deliver = undefined;
+		},
+		async close() {
+			if (closed) return;
+			closed = true;
+			for (const member of members.values()) {
+				member.status = "finished";
+				member.deliver = undefined;
+			}
+			for (const socket of sockets) socket.destroy();
+			await new Promise<void>((resolve) => server.close(() => resolve()));
+		},
+	};
+}
+
+export async function requestTeam(
+	connection: { host: string; port: number; token: string },
+	params: Omit<ListRequest, "token"> | Omit<SendRequest, "token"> | Omit<BroadcastRequest, "token">,
+	signal?: AbortSignal,
+): Promise<TeamResponse> {
+	if (params.type !== "list") {
+		const validationError = validateMessage(params.message);
+		if (validationError) return { ok: false, error: validationError };
+	}
+	return new Promise<TeamResponse>((resolve, reject) => {
+		const socket = net.createConnection({ host: connection.host, port: connection.port });
+		const decoder = new StringDecoder("utf8");
+		let input = "";
+		let settled = false;
+		const finish = (error?: Error, response?: TeamResponse) => {
+			if (settled) return;
+			settled = true;
+			clearTimeout(timeout);
+			signal?.removeEventListener("abort", abort);
+			socket.destroy();
+			if (error) reject(error);
+			else if (response) resolve(response);
+		};
+		const abort = () => finish(new Error("Team request aborted."));
+		const timeout = setTimeout(
+			() => finish(new Error("Timed out waiting for team message acceptance.")),
+			TEAM_REQUEST_TIMEOUT_MS,
+		);
+		if (signal?.aborted) {
+			abort();
+			return;
+		}
+		signal?.addEventListener("abort", abort, { once: true });
+		socket.on("connect", () => socket.write(`${JSON.stringify({ ...params, token: connection.token })}\n`));
+		socket.on("data", (chunk: Buffer) => {
+			input += decoder.write(chunk);
+			const newline = input.indexOf("\n");
+			if (newline === -1) return;
+			try {
+				finish(undefined, JSON.parse(input.slice(0, newline)) as TeamResponse);
+			} catch (error: unknown) {
+				finish(new Error(`Invalid team response: ${error instanceof Error ? error.message : String(error)}`));
+			}
+		});
+		socket.on("error", (error) => finish(error));
+		socket.on("end", () => {
+			if (!settled) finish(new Error("Team connection closed without a response."));
+		});
+	});
+}
+
+function requestConfiguredTeam(
+	params: Omit<ListRequest, "token"> | Omit<SendRequest, "token"> | Omit<BroadcastRequest, "token">,
+	signal?: AbortSignal,
+): Promise<TeamResponse> {
+	const host = process.env[TEAM_HOST_ENV];
+	const portText = process.env[TEAM_PORT_ENV];
+	const token = process.env[TEAM_TOKEN_ENV];
+	const port = Number(portText);
+	if (!host || !token || !Number.isInteger(port) || port <= 0 || port > 65535) {
+		return Promise.reject(new Error("Subagent team connection is not configured."));
+	}
+	return requestTeam({ host, port, token }, params, signal);
+}
+
+function formatDeliveryResult(response: TeamResponse): string {
+	const lines: string[] = [];
+	if (response.accepted && response.accepted.length > 0) lines.push(`Accepted: ${response.accepted.join(", ")}`);
+	if (response.failed && response.failed.length > 0) {
+		lines.push("Failed:", ...response.failed.map((failure) => `- ${failure.recipient}: ${failure.reason}`));
+	}
+	if (response.error) lines.push(response.error);
+	return lines.join("\n") || "No recipients.";
+}
+
+export function registerTeamTools(pi: ExtensionAPI): void {
+	if (!process.env[TEAM_HOST_ENV] || !process.env[TEAM_PORT_ENV] || !process.env[TEAM_TOKEN_ENV]) return;
+
+	pi.registerTool({
+		name: "subagent_teammates",
+		label: "List Teammates",
+		description: "List this worker's identity and the workers in its current parallel subagent team.",
+		parameters: Type.Object({}),
+		executionMode: "sequential",
+		async execute(_toolCallId, _params, signal) {
+			const response = await requestConfiguredTeam({ type: "list" }, signal);
+			if (!response.ok) {
+				return {
+					content: [{ type: "text", text: response.error ?? "Team lookup failed." }],
+					details: response,
+					isError: true,
+				};
+			}
+			const teammates = response.teammates ?? [];
+			const lines = [
+				`You are ${response.self?.id} (agent: ${response.self?.agent}).`,
+				teammates.length === 0 ? "No teammates." : "Teammates:",
+				...teammates.map((member) => `- ${member.id} (${member.agent}, ${member.status}): ${member.task}`),
+			];
+			return { content: [{ type: "text", text: lines.join("\n") }], details: response };
+		},
+	});
+
+	pi.registerTool({
+		name: "subagent_send",
+		label: "Message Teammate",
+		description: `Send a private message to one running teammate. Maximum UTF-8 message size: ${TEAM_MESSAGE_MAX_BYTES} bytes. Acceptance does not wait for a reply.`,
+		parameters: Type.Object({
+			recipient: Type.String({ description: "Exact worker id from subagent_teammates" }),
+			message: Type.String({ description: "Complete finding to deliver" }),
+		}),
+		executionMode: "sequential",
+		async execute(_toolCallId, params, signal) {
+			const response = await requestConfiguredTeam(
+				{ type: "send", recipient: params.recipient, message: params.message },
+				signal,
+			);
+			return {
+				content: [{ type: "text", text: formatDeliveryResult(response) }],
+				details: response,
+				isError: !response.ok,
+			};
+		},
+	});
+
+	pi.registerTool({
+		name: "subagent_broadcast",
+		label: "Broadcast To Teammates",
+		description: `Broadcast a message to all other running teammates. Maximum UTF-8 message size: ${TEAM_MESSAGE_MAX_BYTES} bytes. Acceptance does not wait for replies.`,
+		parameters: Type.Object({ message: Type.String({ description: "Complete finding to deliver" }) }),
+		executionMode: "sequential",
+		async execute(_toolCallId, params, signal) {
+			const response = await requestConfiguredTeam({ type: "broadcast", message: params.message }, signal);
+			return {
+				content: [{ type: "text", text: formatDeliveryResult(response) }],
+				details: response,
+				isError: !response.ok,
+			};
+		},
+	});
+}
diff --git a/packages/coding-agent/test/subagent-team.test.ts b/packages/coding-agent/test/subagent-team.test.ts
new file mode 100644
index 000000000..accd79006
--- /dev/null
+++ b/packages/coding-agent/test/subagent-team.test.ts
@@ -0,0 +1,184 @@
+import { afterEach, describe, expect, it } from "vitest";
+import {
+	assignTeamTasks,
+	createTeamServer,
+	requestTeam,
+	TEAM_HOST_ENV,
+	TEAM_MESSAGE_MAX_BYTES,
+	TEAM_PORT_ENV,
+	TEAM_TOKEN_ENV,
+	type TeamServer,
+} from "../examples/extensions/subagent/team.ts";
+
+function connection(server: TeamServer, workerId: string): { host: string; port: number; token: string } {
+	const credentials = server.credentials(workerId);
+	return {
+		host: credentials[TEAM_HOST_ENV],
+		port: Number(credentials[TEAM_PORT_ENV]),
+		token: credentials[TEAM_TOKEN_ENV],
+	};
+}
+
+describe("subagent team communication", () => {
+	const servers: TeamServer[] = [];
+
+	afterEach(async () => {
+		await Promise.all(servers.splice(0).map((server) => server.close()));
+	});
+
+	it("assigns distinct default ids and rejects invalid explicit ids", () => {
+		expect(
+			assignTeamTasks([
+				{ agent: "scout", task: "one" },
+				{ agent: "scout", task: "two" },
+				{ agent: "worker", task: "three" },
+			]),
+		).toEqual([
+			{ id: "scout-1", agent: "scout", task: "one" },
+			{ id: "scout-2", agent: "scout", task: "two" },
+			{ id: "worker-1", agent: "worker", task: "three" },
+		]);
+		expect(assignTeamTasks([{ id: "bad id", agent: "scout", task: "one" }])).toContain("Invalid worker id");
+		expect(
+			assignTeamTasks([
+				{ id: "same", agent: "scout", task: "one" },
+				{ id: "same", agent: "worker", task: "two" },
+			]),
+		).toBe('Duplicate worker id "same".');
+	});
+
+	it("lists isolated identities and delivers complete Unicode messages with the actual sender", async () => {
+		const server = await createTeamServer([
+			{ id: "researcher", agent: "scout", task: "inspect API" },
+			{ id: "implementer", agent: "worker", task: "write code" },
+		]);
+		servers.push(server);
+		const received: string[] = [];
+		server.startWorker("researcher", async () => {});
+		server.startWorker("implementer", async (message) => {
+			received.push(message);
+		});
+
+		const listing = await requestTeam(connection(server, "researcher"), { type: "list" });
+		expect(listing.self).toEqual({ id: "researcher", agent: "scout" });
+		expect(listing.teammates).toEqual([
+			{ id: "implementer", agent: "worker", task: "write code", status: "running" },
+		]);
+
+		const finding = "接口约束: preserve café paths and 🚀 output\nSecond line.";
+		const result = await requestTeam(connection(server, "researcher"), {
+			type: "send",
+			recipient: "implementer",
+			message: finding,
+		});
+		expect(result).toMatchObject({ ok: true, accepted: ["implementer"], failed: [] });
+		expect(received).toEqual([`Teammate message from researcher (agent: scout):\n\n${finding}`]);
+	});
+
+	it("rejects credentials from another dispatch even when worker ids match", async () => {
+		const first = await createTeamServer([
+			{ id: "worker-1", agent: "worker", task: "first dispatch" },
+			{ id: "worker-2", agent: "worker", task: "first peer" },
+		]);
+		const second = await createTeamServer([
+			{ id: "worker-1", agent: "worker", task: "second dispatch" },
+			{ id: "worker-2", agent: "worker", task: "second peer" },
+		]);
+		servers.push(first, second);
+		first.startWorker("worker-1", async () => {});
+		second.startWorker("worker-1", async () => {});
+
+		const firstCredentials = connection(first, "worker-1");
+		const response = await requestTeam(
+			{ ...firstCredentials, host: second.host, port: second.port },
+			{ type: "list" },
+		);
+		expect(response).toEqual({ ok: false, error: "Authentication failed." });
+	});
+
+	it("reports invalid recipients, partial broadcasts, and unsupported sizes", async () => {
+		const server = await createTeamServer([
+			{ id: "sender", agent: "scout", task: "inspect" },
+			{ id: "ok", agent: "worker", task: "implement" },
+			{ id: "broken", agent: "reviewer", task: "review" },
+		]);
+		servers.push(server);
+		server.startWorker("sender", async () => {});
+		server.startWorker("ok", async () => {});
+		server.startWorker("broken", async () => {
+			throw new Error("process closed");
+		});
+		const sender = connection(server, "sender");
+
+		expect(await requestTeam(sender, { type: "send", recipient: "sender", message: "hello" })).toMatchObject({
+			ok: false,
+			failed: [{ recipient: "sender", reason: "cannot send to yourself" }],
+		});
