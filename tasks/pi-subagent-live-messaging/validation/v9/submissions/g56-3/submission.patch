--- /dev/null
+++ b/packages/coding-agent/examples/extensions/subagent/team.ts
@@ -0,0 +1,694 @@
+import { randomBytes, randomUUID } from "node:crypto";
+import * as fs from "node:fs";
+import * as net from "node:net";
+import * as os from "node:os";
+import * as path from "node:path";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+
+export const TEAM_MESSAGE_MAX_BYTES = 128 * 1024;
+const PROTOCOL_FRAME_MAX_BYTES = 1024 * 1024;
+const DELIVERY_TIMEOUT_MS = 10_000;
+
+const TEAM_SOCKET_ENV = "PI_SUBAGENT_TEAM_SOCKET";
+const TEAM_TOKEN_ENV = "PI_SUBAGENT_TEAM_TOKEN";
+const TEAM_WORKER_ID_ENV = "PI_SUBAGENT_WORKER_ID";
+
+export interface TeamWorkerDefinition {
+	id: string;
+	agent: string;
+}
+
+export interface TeamWorkerConfig {
+	endpoint: string;
+	token: string;
+	workerId: string;
+}
+
+const WORKER_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/;
+
+export function resolveTeamWorkers(
+	tasks: Array<{ agent: string; id?: string }>,
+): { workers: TeamWorkerDefinition[]; error?: undefined } | { workers?: undefined; error: string } {
+	const workers = tasks.map((task, index) => ({ id: task.id ?? `worker-${index + 1}`, agent: task.agent }));
+	for (const worker of workers) {
+		if (!WORKER_ID_PATTERN.test(worker.id)) {
+			return {
+				error: `Invalid worker ID "${worker.id}". Use 1-64 letters, numbers, underscores, or hyphens, starting with a letter or number.`,
+			};
+		}
+	}
+	const uniqueIds = new Set(workers.map((worker) => worker.id));
+	if (uniqueIds.size !== workers.length) return { error: "Worker IDs must be unique within a parallel dispatch." };
+	return { workers };
+}
+
+export interface TeamMember {
+	id: string;
+	agent: string;
+}
+
+export interface TeamDeliveryResult {
+	delivered: string[];
+	failed: Array<{ id: string; reason: string }>;
+}
+
+type RequestMethod = "list" | "send" | "broadcast" | "activate" | "quiesce" | "finish";
+
+type ClientFrame =
+	| { type: "hello"; token: string; workerId: string }
+	| { type: "request"; requestId: string; method: RequestMethod; recipient?: string; message?: string }
+	| { type: "delivery_ack"; deliveryId: string; accepted: boolean; error?: string };
+
+type ServerFrame =
+	| { type: "hello_result"; ok: boolean; error?: string }
+	| { type: "response"; requestId: string; ok: boolean; result?: unknown; error?: string }
+	| { type: "delivery"; deliveryId: string; sender: string; message: string };
+
+interface WorkerState extends TeamWorkerDefinition {
+	status: "pending" | "active" | "quiescing" | "finished";
+	socket?: net.Socket;
+	pendingDeliveries: Set<Promise<void>>;
+}
+
+interface PendingDelivery {
+	recipientId: string;
+	resolve: () => void;
+	reject: (error: Error) => void;
+	timer: NodeJS.Timeout;
+}
+
+interface PendingRequest {
+	resolve: (value: unknown) => void;
+	reject: (error: Error) => void;
+}
+
+function encodeFrame(frame: ClientFrame | ServerFrame): Buffer {
+	const encoded = Buffer.from(`${JSON.stringify(frame)}\n`, "utf8");
+	if (encoded.byteLength > PROTOCOL_FRAME_MAX_BYTES) {
+		throw new Error(`Team protocol frame exceeds ${PROTOCOL_FRAME_MAX_BYTES} bytes.`);
+	}
+	return encoded;
+}
+
+function createFrameReader(
+	onFrame: (frame: unknown) => void,
+	onError: (error: Error) => void,
+): (chunk: Buffer) => void {
+	let buffer = Buffer.alloc(0);
+	return (chunk) => {
+		buffer = Buffer.concat([buffer, chunk]);
+		if (buffer.byteLength > PROTOCOL_FRAME_MAX_BYTES) {
+			onError(new Error(`Team protocol frame exceeds ${PROTOCOL_FRAME_MAX_BYTES} bytes.`));
+			buffer = Buffer.alloc(0);
+			return;
+		}
+
+		let newline = buffer.indexOf(0x0a);
+		while (newline !== -1) {
+			const line = buffer.subarray(0, newline);
+			buffer = buffer.subarray(newline + 1);
+			if (line.byteLength > 0) {
+				try {
+					onFrame(JSON.parse(line.toString("utf8")));
+				} catch (error) {
+					onError(error instanceof Error ? error : new Error(String(error)));
+				}
+			}
+			newline = buffer.indexOf(0x0a);
+		}
+	};
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null;
+}
+
+function errorMessage(error: unknown): string {
+	return error instanceof Error ? error.message : String(error);
+}
+
+function validateMessage(message: unknown): string | undefined {
+	if (typeof message !== "string" || message.length === 0) return "Message must be a non-empty string.";
+	const byteLength = Buffer.byteLength(message, "utf8");
+	if (byteLength > TEAM_MESSAGE_MAX_BYTES) {
+		return `Message is ${byteLength} bytes; maximum supported size is ${TEAM_MESSAGE_MAX_BYTES} bytes.`;
+	}
+	return undefined;
+}
+
+function writeFrame(socket: net.Socket, frame: ClientFrame | ServerFrame): void {
+	socket.write(encodeFrame(frame));
+}
+
+export class TeamBroker {
+	readonly endpoint: string;
+	readonly token: string;
+	readonly #server: net.Server;
+	readonly #workers: Map<string, WorkerState>;
+	readonly #tempDir: string | undefined;
+	readonly #pendingDeliveryAcks = new Map<string, PendingDelivery>();
+	#closed = false;
+
+	private constructor(
+		server: net.Server,
+		endpoint: string,
+		token: string,
+		workers: TeamWorkerDefinition[],
+		tempDir?: string,
+	) {
+		this.#server = server;
+		this.endpoint = endpoint;
+		this.token = token;
+		this.#tempDir = tempDir;
+		this.#workers = new Map(
+			workers.map((worker) => [worker.id, { ...worker, status: "pending", pendingDeliveries: new Set() }]),
+		);
+	}
+
+	static async create(workers: TeamWorkerDefinition[]): Promise<TeamBroker> {
+		const token = randomBytes(32).toString("hex");
+		let tempDir: string | undefined;
+		let endpoint: string;
+		if (process.platform === "win32") {
+			endpoint = `\\\\.\\pipe\\pi-subagent-${process.pid}-${randomUUID()}`;
+		} else {
+			tempDir = await fs.promises.mkdtemp(path.join(os.tmpdir(), "pi-subagent-team-"));
+			endpoint = path.join(tempDir, "team.sock");
+		}
+		const server = net.createServer();
+		const broker = new TeamBroker(server, endpoint, token, workers, tempDir);
+		server.on("connection", (socket) => broker.#handleConnection(socket));
+		try {
+			await new Promise<void>((resolve, reject) => {
+				const onError = (error: Error) => reject(error);
+				server.once("error", onError);
+				server.listen(endpoint, () => {
+					server.off("error", onError);
+					resolve();
+				});
+			});
+			return broker;
+		} catch (error) {
+			if (tempDir) await fs.promises.rm(tempDir, { recursive: true, force: true });
+			throw error;
+		}
+	}
+
+	getWorkerConfig(workerId: string): TeamWorkerConfig {
+		if (!this.#workers.has(workerId)) throw new Error(`Unknown team worker: "${workerId}".`);
+		return { endpoint: this.endpoint, token: this.token, workerId };
+	}
+
+	#handleConnection(socket: net.Socket): void {
+		let worker: WorkerState | undefined;
+		let requestChain = Promise.resolve();
+		const closeWithError = (message: string) => {
+			if (!socket.destroyed) socket.destroy(new Error(message));
+		};
+		const readFrame = createFrameReader(
+			(frame) => {
+				if (isRecord(frame) && frame.type === "delivery_ack") {
+					if (typeof frame.deliveryId !== "string" || typeof frame.accepted !== "boolean") return;
+					const pending = this.#pendingDeliveryAcks.get(frame.deliveryId);
+					if (!pending) return;
+					clearTimeout(pending.timer);
+					this.#pendingDeliveryAcks.delete(frame.deliveryId);
+					if (frame.accepted) pending.resolve();
+					else
+						pending.reject(
+							new Error(typeof frame.error === "string" ? frame.error : "Recipient rejected message."),
+						);
+					return;
+				}
+				requestChain = requestChain.then(async () => {
+					if (!isRecord(frame) || typeof frame.type !== "string") {
+						closeWithError("Invalid team protocol frame.");
+						return;
+					}
+
+					if (!worker) {
+						if (frame.type !== "hello" || typeof frame.token !== "string" || typeof frame.workerId !== "string") {
+							closeWithError("Team connection must begin with hello.");
+							return;
+						}
+						const candidate = this.#workers.get(frame.workerId);
+						if (
+							frame.token !== this.token ||
+							!candidate ||
+							candidate.socket ||
+							candidate.status !== "pending" ||
+							this.#closed
+						) {
+							writeFrame(socket, { type: "hello_result", ok: false, error: "Team authentication failed." });
+							socket.end();
+							return;
+						}
+						worker = candidate;
+						worker.socket = socket;
+						writeFrame(socket, { type: "hello_result", ok: true });
+						return;
+					}
+
+					if (
+						frame.type !== "request" ||
+						typeof frame.requestId !== "string" ||
+						typeof frame.method !== "string"
+					) {
+						closeWithError("Invalid team request.");
+						return;
+					}
+
+					try {
+						const result = await this.#handleRequest(worker, frame);
+						writeFrame(socket, { type: "response", requestId: frame.requestId, ok: true, result });
+					} catch (error) {
+						writeFrame(socket, {
+							type: "response",
+							requestId: frame.requestId,
+							ok: false,
+							error: errorMessage(error),
+						});
+					}
+				});
+			},
+			(error) => closeWithError(error.message),
+		);
+		socket.on("data", readFrame);
+		socket.on("error", () => undefined);
+		socket.on("close", () => {
+			if (worker?.socket === socket) {
+				worker.socket = undefined;
+				worker.status = "finished";
+				for (const [deliveryId, pending] of this.#pendingDeliveryAcks) {
+					if (pending.recipientId !== worker.id) continue;
+					clearTimeout(pending.timer);
+					pending.reject(new Error("Worker stopped before accepting the message."));
+					this.#pendingDeliveryAcks.delete(deliveryId);
+				}
+			}
+		});
+	}
+
+	async #handleRequest(worker: WorkerState, frame: Record<string, unknown>): Promise<unknown> {
+		switch (frame.method) {
+			case "list":
+				return {
+					self: worker.id,
+					teammates: Array.from(this.#workers.values())
+						.filter((candidate) => candidate.id !== worker.id && candidate.status === "active")
+						.map(({ id, agent }) => ({ id, agent })),
+				};
+			case "send": {
+				if (typeof frame.recipient !== "string" || frame.recipient.length === 0) {
+					throw new Error("Recipient must be a non-empty worker ID.");
+				}
+				const validationError = validateMessage(frame.message);
+				if (validationError) throw new Error(validationError);
+				return this.#send(worker.id, [frame.recipient], frame.message as string);
+			}
+			case "broadcast": {
+				const validationError = validateMessage(frame.message);
+				if (validationError) throw new Error(validationError);
+				const recipients = Array.from(this.#workers.values())
+					.filter((candidate) => candidate.id !== worker.id && candidate.status === "active")
+					.map((candidate) => candidate.id);
+				return this.#send(worker.id, recipients, frame.message as string);
+			}
+			case "activate":
+				if (worker.status === "finished") throw new Error(`Worker "${worker.id}" has finished.`);
+				worker.status = "active";
+				return { status: "active" };
+			case "quiesce":
+				if (worker.status === "finished") return { status: "finished" };
+				worker.status = "quiescing";
+				await Promise.allSettled(Array.from(worker.pendingDeliveries));
+				return { status: "quiescing" };
+			case "finish":
+				worker.status = "finished";
+				return { status: "finished" };
+			default:
+				throw new Error(`Unsupported team request: "${String(frame.method)}".`);
+		}
+	}
+
+	async #send(sender: string, recipients: string[], message: string): Promise<TeamDeliveryResult> {
+		const outcomes = await Promise.all(
+			recipients.map(async (recipientId): Promise<{ id: string; error?: string }> => {
+				if (recipientId === sender) return { id: recipientId, error: "Cannot send a team message to yourself." };
+				const recipient = this.#workers.get(recipientId);
+				if (!recipient) return { id: recipientId, error: "Unknown worker." };
+				if (recipient.status !== "active" || !recipient.socket) {
+					return { id: recipientId, error: "Worker is not running." };
+				}
+				try {
+					await this.#deliver(recipient, sender, message);
+					return { id: recipientId };
+				} catch (error) {
+					return { id: recipientId, error: errorMessage(error) };
+				}
+			}),
+		);
+		return {
+			delivered: outcomes.filter((outcome) => !outcome.error).map((outcome) => outcome.id),
+			failed: outcomes
+				.filter((outcome): outcome is { id: string; error: string } => Boolean(outcome.error))
+				.map((outcome) => ({ id: outcome.id, reason: outcome.error })),
+		};
+	}
+
+	async #deliver(recipient: WorkerState, sender: string, message: string): Promise<void> {
+		const socket = recipient.socket;
+		if (recipient.status !== "active" || !socket || socket.destroyed) throw new Error("Worker is not running.");
+		const deliveryId = randomUUID();
+		let deliveryPromise: Promise<void>;
+		deliveryPromise = new Promise<void>((resolve, reject) => {
+			const timer = setTimeout(() => {
+				this.#pendingDeliveryAcks.delete(deliveryId);
+				reject(new Error("Recipient did not accept the message in time."));
+			}, DELIVERY_TIMEOUT_MS);
+			this.#pendingDeliveryAcks.set(deliveryId, { recipientId: recipient.id, resolve, reject, timer });
+			try {
+				writeFrame(socket, { type: "delivery", deliveryId, sender, message });
+			} catch (error) {
+				clearTimeout(timer);
+				this.#pendingDeliveryAcks.delete(deliveryId);
+				reject(error instanceof Error ? error : new Error(String(error)));
+			}
+		});
+		recipient.pendingDeliveries.add(deliveryPromise);
+		try {
+			await deliveryPromise;
+		} finally {
+			recipient.pendingDeliveries.delete(deliveryPromise);
+		}
+	}
+
+	async close(): Promise<void> {
+		if (this.#closed) return;
+		this.#closed = true;
+		for (const worker of this.#workers.values()) {
+			worker.status = "finished";
+			worker.socket?.destroy();
+		}
+		for (const [deliveryId, pending] of this.#pendingDeliveryAcks) {
+			clearTimeout(pending.timer);
+			pending.reject(new Error("Team dispatch ended before delivery was accepted."));
+			this.#pendingDeliveryAcks.delete(deliveryId);
+		}
+		await new Promise<void>((resolve) => this.#server.close(() => resolve()));
+		if (this.#tempDir) await fs.promises.rm(this.#tempDir, { recursive: true, force: true });
+	}
+}
+
+export class TeamClient {
+	readonly workerId: string;
+	readonly #socket: net.Socket;
+	readonly #pendingRequests = new Map<string, PendingRequest>();
+	readonly #onDelivery: (sender: string, message: string) => void | Promise<void>;
+	#closed = false;
+
+	private constructor(
+		socket: net.Socket,
+		workerId: string,
+		onDelivery: (sender: string, message: string) => void | Promise<void>,
+	) {
+		this.#socket = socket;
+		this.workerId = workerId;
+		this.#onDelivery = onDelivery;
+		let frameChain = Promise.resolve();
+		const readFrame = createFrameReader(
+			(frame) => {
+				frameChain = frameChain.then(() => this.#handleFrame(frame));
+			},
+			(error) => this.#fail(error),
+		);
+		socket.on("data", readFrame);
+		socket.on("error", (error) => this.#fail(error));
+		socket.on("close", () => this.#fail(new Error("Team connection closed.")));
+	}
+
+	static async connect(
+		config: TeamWorkerConfig,
+		onDelivery: (sender: string, message: string) => void | Promise<void>,
+	): Promise<TeamClient> {
+		const socket = net.createConnection(config.endpoint);
+		await new Promise<void>((resolve, reject) => {
+			socket.once("connect", resolve);
+			socket.once("error", reject);
+		});
+		const client = new TeamClient(socket, config.workerId, onDelivery);
+		const hello = new Promise<void>((resolve, reject) => {
+			client.#pendingRequests.set("hello", { resolve: () => resolve(), reject });
+		});
+		writeFrame(socket, { type: "hello", token: config.token, workerId: config.workerId });
+		await hello;
+		return client;
+	}
+
+	async list(): Promise<{ self: string; teammates: TeamMember[] }> {
+		return (await this.#request("list")) as { self: string; teammates: TeamMember[] };
+	}
+
+	async send(recipient: string, message: string): Promise<TeamDeliveryResult> {
+		return (await this.#request("send", { recipient, message })) as TeamDeliveryResult;
+	}
+
+	async broadcast(message: string): Promise<TeamDeliveryResult> {
+		return (await this.#request("broadcast", { message })) as TeamDeliveryResult;
+	}
+
+	async activate(): Promise<void> {
+		await this.#request("activate");
+	}
+
+	async quiesce(): Promise<void> {
+		await this.#request("quiesce");
+	}
+
+	async finish(): Promise<void> {
+		if (this.#closed) return;
+		try {
+			await this.#request("finish");
+		} finally {
+			this.close();
+		}
+	}
+
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true;
+		this.#socket.end();
+		this.#fail(new Error("Team connection closed."));
+	}
+
+	async #request(method: RequestMethod, fields: { recipient?: string; message?: string } = {}): Promise<unknown> {
+		if (this.#closed) throw new Error("Team connection is closed.");
+		const requestId = randomUUID();
+		const response = new Promise<unknown>((resolve, reject) => {
+			this.#pendingRequests.set(requestId, { resolve, reject });
+		});
+		try {
+			writeFrame(this.#socket, { type: "request", requestId, method, ...fields });
+		} catch (error) {
+			this.#pendingRequests.delete(requestId);
+			throw error;
+		}
+		return response;
+	}
+
+	async #handleFrame(frame: unknown): Promise<void> {
+		if (!isRecord(frame) || typeof frame.type !== "string") throw new Error("Invalid team protocol frame.");
+		if (frame.type === "hello_result") {
+			const pending = this.#pendingRequests.get("hello");
+			if (!pending) return;
+			this.#pendingRequests.delete("hello");
+			if (frame.ok === true) pending.resolve(undefined);
+			else pending.reject(new Error(typeof frame.error === "string" ? frame.error : "Team authentication failed."));
+			return;
+		}
+		if (frame.type === "response") {
+			if (typeof frame.requestId !== "string") throw new Error("Invalid team response.");
+			const pending = this.#pendingRequests.get(frame.requestId);
+			if (!pending) return;
+			this.#pendingRequests.delete(frame.requestId);
+			if (frame.ok === true) pending.resolve(frame.result);
+			else pending.reject(new Error(typeof frame.error === "string" ? frame.error : "Team request failed."));
+			return;
+		}
+		if (
+			frame.type !== "delivery" ||
+			typeof frame.deliveryId !== "string" ||
+			typeof frame.sender !== "string" ||
+			typeof frame.message !== "string"
+		) {
+			throw new Error("Invalid team delivery.");
+		}
+		try {
+			await this.#onDelivery(frame.sender, frame.message);
+			writeFrame(this.#socket, { type: "delivery_ack", deliveryId: frame.deliveryId, accepted: true });
+		} catch (error) {
+			writeFrame(this.#socket, {
+				type: "delivery_ack",
+				deliveryId: frame.deliveryId,
+				accepted: false,
+				error: errorMessage(error),
+			});
+		}
+	}
+
+	#fail(error: Error): void {
+		if (!this.#closed) this.#closed = true;
+		for (const [requestId, pending] of this.#pendingRequests) {
+			pending.reject(error);
+			this.#pendingRequests.delete(requestId);
+		}
+	}
+}
+
+export function getTeamWorkerConfig(environment: NodeJS.ProcessEnv = process.env): TeamWorkerConfig | undefined {
+	const endpoint = environment[TEAM_SOCKET_ENV];
+	const token = environment[TEAM_TOKEN_ENV];
+	const workerId = environment[TEAM_WORKER_ID_ENV];
+	if (!endpoint || !token || !workerId) return undefined;
+	return { endpoint, token, workerId };
+}
+
+export function getTeamWorkerEnvironment(config: TeamWorkerConfig): NodeJS.ProcessEnv {
+	return {
+		[TEAM_SOCKET_ENV]: config.endpoint,
+		[TEAM_TOKEN_ENV]: config.token,
+		[TEAM_WORKER_ID_ENV]: config.workerId,
+	};
+}
+
+function formatDeliveryResult(result: TeamDeliveryResult): string {
+	const parts = [`Accepted for delivery: ${result.delivered.length > 0 ? result.delivered.join(", ") : "none"}.`];
+	if (result.failed.length > 0) {
+		parts.push(`Failed: ${result.failed.map(({ id, reason }) => `${id} (${reason})`).join(", ")}.`);
+	}
+	return parts.join(" ");
+}
+
+export function registerTeamWorker(pi: ExtensionAPI, config: TeamWorkerConfig): void {
+	let client: TeamClient | undefined;
+	let connectionError: string | undefined;
+	const pendingMessages: Array<{ sender: string; message: string }> = [];
+	const requireClient = (): TeamClient => {
+		if (client) return client;
+		throw new Error(connectionError ?? "Team connection is not ready.");
+	};
+	const flushMessages = (deliverAs: "steer" | "followUp") => {
+		if (pendingMessages.length === 0) return;
+		const messages = pendingMessages.splice(0);
+		pi.sendMessage(
+			{
+				customType: "subagent-team-message",
+				content: messages
+					.map(({ sender, message }) => `Message from teammate "${sender}":\n\n${message}`)
+					.join("\n\n---\n\n"),
+				display: true,
+				details: { messages },
+			},
+			{ triggerTurn: true, deliverAs },
+		);
+	};
+
+	pi.on("session_start", async () => {
+		try {
+			client = await TeamClient.connect(config, (sender, message) => {
+				pendingMessages.push({ sender, message });
+			});
+		} catch (error) {
+			connectionError = errorMessage(error);
+			throw error;
+		}
+	});
+
+	pi.on("agent_start", async () => {
+		await requireClient().activate();
+	});
+
+	pi.on("turn_end", () => {
+		flushMessages("steer");
+	});
+
+	pi.on("agent_end", async () => {
+		await requireClient().quiesce();
+		flushMessages("followUp");
+	});
+
+	pi.on("session_shutdown", async () => {
+		if (client) await client.finish();
+	});
+
+	pi.registerTool({
+		name: "team_list",
+		label: "List teammates",
+		description: "List this worker's ID and currently running teammates in the same parallel dispatch.",
+		parameters: Type.Object({}),
+		async execute() {
+			try {
+				const result = await requireClient().list();
+				const teammates = result.teammates.map(({ id, agent }) => `${id} (${agent})`).join(", ") || "none";
+				return {
+					content: [{ type: "text", text: `You are ${result.self}. Running teammates: ${teammates}.` }],
+					details: undefined,
+				};
+			} catch (error) {
+				return { content: [{ type: "text", text: errorMessage(error) }], details: undefined, isError: true };
+			}
+		},
+	});
+
+	pi.registerTool({
+		name: "team_send",
+		label: "Message teammate",
+		description:
+			"Send a private finding to one running teammate. Success means accepted for delivery, not that the teammate replied.",
+		parameters: Type.Object({
+			recipient: Type.String({ description: "Worker ID returned by team_list" }),
+			message: Type.String({ description: `Complete message, up to ${TEAM_MESSAGE_MAX_BYTES} UTF-8 bytes` }),
+		}),
+		async execute(_toolCallId, params) {
+			const validationError = validateMessage(params.message);
+			if (validationError)
+				return { content: [{ type: "text", text: validationError }], details: undefined, isError: true };
+			try {
+				const result = await requireClient().send(params.recipient, params.message);
+				return {
+					content: [{ type: "text", text: formatDeliveryResult(result) }],
+					details: undefined,
+					isError: result.failed.length > 0,
+				};
+			} catch (error) {
+				return { content: [{ type: "text", text: errorMessage(error) }], details: undefined, isError: true };
+			}
+		},
+	});
+
+	pi.registerTool({
+		name: "team_broadcast",
+		label: "Broadcast to teammates",
+		description:
+			"Send a finding to all other running teammates. Success means accepted for delivery, not that teammates replied.",
+		parameters: Type.Object({
+			message: Type.String({ description: `Complete message, up to ${TEAM_MESSAGE_MAX_BYTES} UTF-8 bytes` }),
+		}),
+		async execute(_toolCallId, params) {
+			const validationError = validateMessage(params.message);
+			if (validationError)
+				return { content: [{ type: "text", text: validationError }], details: undefined, isError: true };
+			try {
+				const result = await requireClient().broadcast(params.message);
+				return {
+					content: [{ type: "text", text: formatDeliveryResult(result) }],
+					details: undefined,
+					isError: result.failed.length > 0,
+				};
+			} catch (error) {
+				return { content: [{ type: "text", text: errorMessage(error) }], details: undefined, isError: true };
+			}
+		},
+	});
+}
