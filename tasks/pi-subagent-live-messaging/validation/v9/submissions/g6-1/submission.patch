@@ -0,0 +1,111 @@
+import { existsSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { type Context, fauxAssistantMessage, fauxProvider, fauxToolCall } from "@earendil-works/pi-ai";
+import type { ExtensionAPI } from "../../src/index.ts";
+
+export const findingText = "接口约束: café 𐐷\n".repeat(1800);
+
+async function waitForFile(path: string, signal?: AbortSignal): Promise<void> {
+	const deadline = Date.now() + 15000;
+	while (!existsSync(path)) {
+		if (Date.now() > deadline) throw new Error(`Timed out waiting for ${path}`);
+		await delay(10, undefined, { signal });
+	}
+}
+
+function texts(context: Context): string[] {
+	return context.messages.map((message) =>
+		typeof message.content === "string"
+			? message.content
+			: message.content
+					.filter((part) => part.type === "text")
+					.map((part) => part.text)
+					.join("\n"),
+	);
+}
+
+export default function (pi: ExtensionAPI): void {
+	const directory = process.env.PI_TEAM_TEST_DIR;
+	if (!directory) throw new Error("PI_TEAM_TEST_DIR is required");
+	const faux = fauxProvider({ provider: "team-test", api: "team-test" });
+	const disabled = process.env.PI_TEAM_TEST_DISABLED === "1";
+	let calls = 0;
+	faux.setResponses(
+		Array.from({ length: 8 }, () => async (context, options) => {
+			calls++;
+			const task = texts(context)[0];
+			if (task.startsWith("Task:")) {
+				const role = task.includes("sender") ? "sender" : "recipient";
+				writeFileSync(join(directory, `${role}.pid`), String(process.pid));
+				if (disabled) {
+					writeFileSync(
+						join(directory, `disabled-${role}.json`),
+						JSON.stringify({
+							ipc: Boolean(process.send),
+							tools: context.tools?.map((tool) => tool.name),
+							systemPrompt: context.systemPrompt,
+						}),
+					);
+					return fauxAssistantMessage(`${role} done without communication`);
+				}
+				if (process.env.PI_TEAM_TEST_CANCEL === "1") {
+					if (process.env.PI_TEAM_TEST_IGNORE_TERM === "1") {
+						process.removeAllListeners("SIGTERM");
+						process.on("SIGTERM", () => {});
+					}
+					await delay(60000, undefined, { signal: options?.signal });
+				}
+				if (role === "sender") {
+					if (calls === 1) {
+						await waitForFile(join(directory, "recipient.ready"), options?.signal);
+						return fauxAssistantMessage(fauxToolCall("team_members", {}), { stopReason: "toolUse" });
+					}
+					if (calls === 2) {
+						writeFileSync(join(directory, "members.json"), texts(context).at(-1)!);
+						return fauxAssistantMessage(fauxToolCall("team_send", { to: "recipient", text: findingText }), {
+							stopReason: "toolUse",
+						});
+					}
+					writeFileSync(join(directory, "accepted.json"), texts(context).at(-1)!);
+					return fauxAssistantMessage("sender done");
+				}
+				if (calls === 1) {
+					writeFileSync(join(directory, "recipient.ready"), "ready");
+					await waitForFile(join(directory, "accepted.json"), options?.signal);
+					return fauxAssistantMessage("would otherwise finish");
+				}
+				const findings = texts(context).filter((text) => text.startsWith("Findings from teammates"));
+				writeFileSync(
+					join(directory, "received.json"),
+					JSON.stringify({ findings, calls, tools: context.tools?.map((tool) => tool.name) }),
+				);
+				return fauxAssistantMessage("recipient processed findings");
+			}
+			if (calls === 1) {
+				return fauxAssistantMessage(
+					fauxToolCall("subagent", {
+						...(disabled ? {} : { communication: true }),
+						tasks: [
+							{ id: "sender", agent: "worker", task: "sender" },
+							{ id: "recipient", agent: "worker", task: "recipient" },
+						],
+					}),
+					{ stopReason: "toolUse" },
+				);
+			}
+			writeFileSync(join(directory, "result.txt"), texts(context).at(-1)!);
+			return fauxAssistantMessage("dispatch done");
+		}),
+	);
+	pi.registerProvider(faux.provider.id, {
+		api: faux.api,
+		baseUrl: faux.getModel().baseUrl,
+		apiKey: "offline-faux-key",
+		models: faux.models,
+		streamSimple: faux.provider.streamSimple,
+	});
+	pi.on("session_shutdown", () => {
+		writeFileSync(join(directory, `shutdown-${process.pid}`), "done");
+	});
+}
