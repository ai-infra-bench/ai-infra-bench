+import type { ChildProcess } from "node:child_process";
+import { type Static, Type } from "typebox";
+import { Check } from "typebox/value";
+
+export const MAX_MESSAGE_BYTES = 64 * 1024;
+export const MAX_PENDING_BYTES = 1024 * 1024;
+export const MAX_PENDING_MESSAGES = 256;
+export const WorkerId = Type.String({ pattern: "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" });
+export const SendParams = Type.Object(
+	{
+		to: Type.String({ description: 'Worker ID, or "*" to broadcast to running teammates.' }),
+		text: Type.String({ minLength: 1, description: `Complete finding, at most ${MAX_MESSAGE_BYTES} UTF-8 bytes.` }),
+	},
+	{ additionalProperties: false },
+);
+
+const Request = Type.Union([
+	Type.Object({ op: Type.Literal("ready") }, { additionalProperties: false }),
+	Type.Object({ op: Type.Literal("members") }, { additionalProperties: false }),
+	Type.Object({ op: Type.Literal("send"), ...SendParams.properties }, { additionalProperties: false }),
+	Type.Object({ op: Type.Literal("checkpoint"), finish: Type.Boolean() }, { additionalProperties: false }),
+]);
+
+const Envelope = Type.Object({
+	channel: Type.Literal("pi-subagent-team"),
+	requestId: Type.Integer({ minimum: 1 }),
+	request: Type.Unknown(),
+});
+
+export type TeamRequest = Static<typeof Request>;
+export interface TeamTask {
+	id?: string;
+	agent: string;
+	task: string;
+}
+export interface TeamMember {
+	id: string;
+	agent: string;
+	task: string;
+	state: "pending" | "running" | "finished";
+}
+export interface Finding {
+	from: string;
+	agent: string;
+	text: string;
+}
+export type TeamReply =
+	| { kind: "members"; self: string; members: TeamMember[] }
+	| { kind: "sent"; accepted: string[]; failed: { id: string; reason: string }[] }
+	| { kind: "checkpoint"; messages: Finding[]; finished: boolean }
+	| { kind: "error"; error: string };
+
+interface Mailbox {
+	member: TeamMember;
+	messages: Finding[];
+	bytes: number;
+}
+
+export class TeamBroker {
+	readonly controller = new AbortController();
+	readonly signal: AbortSignal;
+	readonly ids: string[];
+	private mailboxes = new Map<string, Mailbox>();
+	private children = new Set<Promise<void>>();
+
+	constructor(tasks: TeamTask[], signal?: AbortSignal) {
+		this.signal = signal ? AbortSignal.any([signal, this.controller.signal]) : this.controller.signal;
+		this.ids = tasks.map((task, index) => task.id ?? `worker-${index + 1}`);
+		for (const [index, task] of tasks.entries()) {
+			const id = this.ids[index];
+			if (!Check(WorkerId, id) || this.mailboxes.has(id)) {
+				throw new Error(`Invalid or duplicate worker ID: ${JSON.stringify(id)}.`);
+			}
+			this.mailboxes.set(id, {
+				member: { id, agent: task.agent, task: task.task, state: "pending" },
+				messages: [],
+				bytes: 0,
+			});
+		}
+	}
+
+	handle(id: string, request: unknown): TeamReply {
+		if (!Check(Request, request)) return { kind: "error", error: "Invalid team request." };
+		const sender = this.mailboxes.get(id);
+		if (this.signal.aborted || !sender || sender.member.state === "finished") {
+			return { kind: "error", error: "Worker is no longer running in this team." };
+		}
+		if (request.op === "ready") {
+			if (sender.member.state !== "pending") return { kind: "error", error: "Worker already registered." };
+			sender.member.state = "running";
+		}
+		if (sender.member.state !== "running") return { kind: "error", error: "Worker is not ready." };
+		if (request.op === "ready" || request.op === "members") {
+			return {
+				kind: "members",
+				self: id,
+				members: [...this.mailboxes.values()].map(({ member }) => ({ ...member })),
+			};
+		}
+		if (request.op === "checkpoint") {
+			const messages = sender.messages;
+			sender.messages = [];
+			sender.bytes = 0;
+			const finished = request.finish && messages.length === 0;
+			if (finished) sender.member.state = "finished";
+			return { kind: "checkpoint", messages, finished };
+		}
+		const bytes = Buffer.byteLength(request.text, "utf8");
+		if (bytes > MAX_MESSAGE_BYTES || Buffer.from(request.text, "utf8").toString("utf8") !== request.text) {
+			return {
+				kind: "error",
+				error: `Message must be valid Unicode and at most ${MAX_MESSAGE_BYTES} UTF-8 bytes (received ${bytes}).`,
+			};
+		}
+		if (request.to !== "*" && !Check(WorkerId, request.to)) {
+			return { kind: "error", error: 'Recipient must be a worker ID or "*".' };
+		}
+		const recipients = request.to === "*" ? this.ids.filter((recipient) => recipient !== id) : [request.to];
+		const reply: Extract<TeamReply, { kind: "sent" }> = { kind: "sent", accepted: [], failed: [] };
+		for (const recipient of recipients) {
+			const mailbox = this.mailboxes.get(recipient);
+			const reason =
+				recipient === id
+					? "Cannot send to yourself."
+					: !mailbox
+						? "Unknown teammate."
+						: mailbox.member.state !== "running"
+							? `Teammate is ${mailbox.member.state}.`
+							: mailbox.bytes + bytes > MAX_PENDING_BYTES || mailbox.messages.length >= MAX_PENDING_MESSAGES
+								? "Teammate's delivery queue is full."
+								: undefined;
+			if (reason || !mailbox) {
+				reply.failed.push({ id: recipient, reason: reason ?? "Unknown teammate." });
+			} else {
+				mailbox.messages.push({ from: id, agent: sender.member.agent, text: request.text });
+				mailbox.bytes += bytes;
+				reply.accepted.push(recipient);
+			}
+		}
+		return reply;
+	}
+
+	finish(id: string): void {
+		const mailbox = this.mailboxes.get(id);
+		if (!mailbox) return;
+		mailbox.member.state = "finished";
+		mailbox.messages = [];
+		mailbox.bytes = 0;
+	}
+
+	attach(id: string, child: ChildProcess): void {
+		const onMessage = (envelope: unknown) => {
+			if (!Check(Envelope, envelope)) return;
+			const reply = this.handle(id, envelope.request);
+			child.send({ channel: "pi-subagent-team", requestId: envelope.requestId, reply }, (error) => {
+				if (error) this.finish(id);
+			});
+		};
+		const onDisconnect = () => this.finish(id);
+		child.on("message", onMessage);
+		child.on("disconnect", onDisconnect);
+		const closed = new Promise<void>((resolve) => {
+			child.once("close", () => {
+				this.finish(id);
+				child.off("message", onMessage);
+				child.off("disconnect", onDisconnect);
+				this.children.delete(closed);
+				resolve();
+			});
+		});
+		this.children.add(closed);
+	}
+
+	async stop(): Promise<void> {
+		this.controller.abort();
+		for (const id of this.ids) this.finish(id);
+		await Promise.all(this.children);
+	}
+}
+
+export interface TeamConnection {
+	request(request: TeamRequest): Promise<TeamReply>;
+	close(): void;
+}
+
+export class TeamClient implements TeamConnection {
+	private nextId = 0;
+	private pending = new Map<number, { resolve: (reply: TeamReply) => void; reject: (error: Error) => void }>();
+	private closed = false;
+
+	constructor() {
+		if (!process.send) throw new Error("Team communication requires a parent IPC channel.");
+		process.on("message", this.onMessage);
+		process.on("disconnect", this.onDisconnect);
+	}
+
+	private onMessage = (value: unknown) => {
+		if (!value || typeof value !== "object" || !("channel" in value) || value.channel !== "pi-subagent-team") return;
+		if (!("requestId" in value) || typeof value.requestId !== "number" || !("reply" in value)) return;
+		const pending = this.pending.get(value.requestId);
+		if (!pending) return;
+		this.pending.delete(value.requestId);
+		pending.resolve(value.reply as TeamReply);
+	};
+
+	private onDisconnect = () => this.close();
+
+	request(request: TeamRequest): Promise<TeamReply> {
+		if (this.closed || !process.connected) return Promise.reject(new Error("Team IPC channel is closed."));
+		const requestId = ++this.nextId;
+		return new Promise((resolve, reject) => {
+			this.pending.set(requestId, { resolve, reject });
+			process.send?.({ channel: "pi-subagent-team", requestId, request }, (error) => {
+				if (error) {
+					this.pending.delete(requestId);
+					reject(error);
+				}
+			});
+		});
+	}
+
+	close(): void {
+		this.closed = true;
+		process.off("message", this.onMessage);
+		process.off("disconnect", this.onDisconnect);
+		for (const pending of this.pending.values()) pending.reject(new Error("Team IPC channel is closed."));
+		this.pending.clear();
+	}
+}
