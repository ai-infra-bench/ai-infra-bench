@@ -0,0 +1,157 @@
+import { spawn } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { describe, expect, it } from "vitest";
+import { findingText } from "./fixtures/subagent-team-provider.ts";
+
+function startParent(extraEnv: Record<string, string> = {}) {
+	const directory = mkdtempSync(join(tmpdir(), "pi-team-test-"));
+	const agentDir = join(directory, "agent");
+	mkdirSync(join(agentDir, "agents"), { recursive: true });
+	writeFileSync(
+		join(agentDir, "agents", "worker.md"),
+		"---\nname: worker\ndescription: Test worker\ntools: read\n---\nKeep the configured tools and model.\n",
+	);
+	writeFileSync(
+		join(agentDir, "settings.json"),
+		JSON.stringify({
+			defaultProvider: "team-test",
+			defaultModel: "faux-1",
+			extensions: [
+				resolve(__dirname, "../examples/extensions/subagent/index.ts"),
+				resolve(__dirname, "fixtures/subagent-team-provider.ts"),
+			],
+		}),
+	);
+	const child = spawn(
+		process.execPath,
+		[
+			"--import",
+			resolve(__dirname, "../src/experimental/source-resolver.ts"),
+			resolve(__dirname, "../src/cli.ts"),
+			"--mode",
+			"json",
+			"-p",
+			"--no-session",
+			"dispatch",
+		],
+		{
+			cwd: directory,
+			env: {
+				...process.env,
+				HOME: directory,
+				USERPROFILE: directory,
+				PI_CODING_AGENT_DIR: agentDir,
+				PI_TEAM_TEST_DIR: directory,
+				PI_OFFLINE: "1",
+				...extraEnv,
+			},
+			stdio: ["ignore", "pipe", "pipe"],
+		},
+	);
+	let output = "";
+	child.stdout.setEncoding("utf8").on("data", (data: string) => {
+		output += data;
+	});
+	child.stderr.setEncoding("utf8").on("data", (data: string) => {
+		output += data;
+	});
+	const done = new Promise<number | null>((resolve, reject) => {
+		child.once("error", reject);
+		child.once("close", resolve);
+	});
+	return { child, done, directory, output: () => output };
+}
+
+describe("subagent team source processes", () => {
+	it("keeps communication disabled by default without changing worker tools or prompts", async () => {
+		const parent = startParent({
+			PI_TEAM_TEST_DISABLED: "1",
+			NODE_OPTIONS: `${process.env.NODE_OPTIONS ?? ""} --import ${JSON.stringify(resolve(__dirname, "../src/experimental/source-resolver.ts"))}`,
+		});
+		try {
+			expect(await parent.done, parent.output()).toBe(0);
+			for (const role of ["sender", "recipient"]) {
+				const resultPath = join(parent.directory, `disabled-${role}.json`);
+				expect(existsSync(resultPath), parent.output()).toBe(true);
+				const result = JSON.parse(readFileSync(resultPath, "utf8")) as {
+					ipc: boolean;
+					tools: string[];
+					systemPrompt: string;
+				};
+				expect(result.ipc).toBe(false);
+				expect(result.tools).toEqual(["read"]);
+				expect(result.systemPrompt).toContain("Keep the configured tools and model.");
+				expect(result.systemPrompt).not.toContain("parallel subagent team");
+			}
+		} finally {
+			parent.child.kill("SIGKILL");
+			await parent.done;
+			rmSync(parent.directory, { recursive: true, force: true });
+		}
+	}, 30000);
+	it("uses separate Pi processes and injects a complete Unicode finding before exit", async () => {
+		const parent = startParent();
+		try {
+			expect(await parent.done, parent.output()).toBe(0);
+			expect(existsSync(join(parent.directory, "received.json")), parent.output()).toBe(true);
+			const received = JSON.parse(readFileSync(join(parent.directory, "received.json"), "utf8")) as {
+				findings: string[];
+				calls: number;
+				tools: string[];
+			};
+			expect(received.calls).toBe(2);
+			expect(received.tools.sort()).toEqual(["read", "team_members", "team_send"]);
+			expect(received.findings).toHaveLength(1);
+			expect(JSON.parse(received.findings[0].split("\n").slice(1).join("\n"))).toEqual([
+				{ from: "sender", agent: "worker", text: findingText },
+			]);
+			const senderPid = Number(readFileSync(join(parent.directory, "sender.pid"), "utf8"));
+			const recipientPid = Number(readFileSync(join(parent.directory, "recipient.pid"), "utf8"));
+			expect(new Set([parent.child.pid, senderPid, recipientPid]).size).toBe(3);
+			for (const pid of [senderPid, recipientPid]) expect(() => process.kill(pid, 0)).toThrow();
+			expect(JSON.parse(readFileSync(join(parent.directory, "accepted.json"), "utf8"))).toEqual({
+				kind: "sent",
+				accepted: ["recipient"],
+				failed: [],
+			});
+			expect(readFileSync(join(parent.directory, "result.txt"), "utf8")).toContain("Parallel: 2/2 succeeded");
+		} finally {
+			parent.child.kill("SIGKILL");
+			await parent.done;
+			rmSync(parent.directory, { recursive: true, force: true });
+		}
+	}, 30000);
+
+	it.each([false, true])(
+		"parent cancellation stops children (ignore SIGTERM: %s)",
+		async (ignoreTerm) => {
+			const parent = startParent({ PI_TEAM_TEST_CANCEL: "1", PI_TEAM_TEST_IGNORE_TERM: ignoreTerm ? "1" : "0" });
+			const pids: number[] = [];
+			try {
+				const deadline = Date.now() + 15000;
+				for (const role of ["sender", "recipient"]) {
+					const pidPath = join(parent.directory, `${role}.pid`);
+					while (!existsSync(pidPath) && Date.now() < deadline) await delay(20);
+					expect(existsSync(pidPath), parent.output()).toBe(true);
+					pids.push(Number(readFileSync(pidPath, "utf8")));
+				}
+				parent.child.kill("SIGTERM");
+				await parent.done;
+				for (const pid of pids) expect(() => process.kill(pid, 0)).toThrow();
+			} finally {
+				parent.child.kill("SIGKILL");
+				for (const pid of pids) {
+					try {
+						process.kill(pid, "SIGKILL");
+					} catch {}
+				}
+				await parent.done;
+				rmSync(parent.directory, { recursive: true, force: true });
+			}
+		},
+		30000,
+	);
+});
