+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { describe, expect, it, vi } from "vitest";
+import {
+	MAX_MESSAGE_BYTES,
+	MAX_PENDING_BYTES,
+	MAX_PENDING_MESSAGES,
+	TeamBroker,
+	type TeamConnection,
+} from "../../examples/extensions/subagent/communication.ts";
+import subagent from "../../examples/extensions/subagent/index.ts";
+import { registerTeamWorker } from "../../examples/extensions/subagent/worker.ts";
+import { createHarness, getMessageText } from "./harness.ts";
+
+vi.mock("@earendil-works/pi-coding-agent", () => ({
+	CONFIG_DIR_NAME: ".pi",
+	getAgentDir: () => "/missing-user-agent-dir",
+	getMarkdownTheme: () => ({}),
+	parseFrontmatter: () => ({ frontmatter: {}, body: "" }),
+	withFileMutationQueue: async (_path: string, callback: () => Promise<unknown>) => callback(),
+}));
+
+function makeTeam(count = 3): TeamBroker {
+	return new TeamBroker(Array.from({ length: count }, (_, index) => ({ agent: "worker", task: `task ${index + 1}` })));
+}
+
+function ready(team: TeamBroker, ...ids: string[]): void {
+	for (const id of ids) expect(team.handle(id, { op: "ready" }).kind).toBe("members");
+}
+
+describe("subagent team broker", () => {
+	it("addresses repeated agent definitions independently and discovers pending workers", () => {
+		const team = makeTeam();
+		expect(team.handle("worker-2", { op: "ready" })).toEqual({
+			kind: "members",
+			self: "worker-2",
+			members: [
+				{ id: "worker-1", agent: "worker", task: "task 1", state: "pending" },
+				{ id: "worker-2", agent: "worker", task: "task 2", state: "running" },
+				{ id: "worker-3", agent: "worker", task: "task 3", state: "pending" },
+			],
+		});
+	});
+
+	it("rejects invalid and duplicate explicit or generated IDs", () => {
+		for (const id of ["*", "", "space here", "x".repeat(65), "../worker"]) {
+			expect(() => new TeamBroker([{ id, agent: "worker", task: "task" }])).toThrow("worker ID");
+		}
+		expect(
+			() =>
+				new TeamBroker([
+					{ id: "worker-2", agent: "a", task: "one" },
+					{ agent: "a", task: "two" },
+				]),
+		).toThrow("duplicate");
+	});
+
+	it("reports self, unknown, pending and finished recipients and partial broadcast failures", () => {
+		const team = makeTeam(4);
+		ready(team, "worker-1", "worker-2", "worker-4");
+		team.finish("worker-4");
+		expect(team.handle("worker-1", { op: "send", to: "*", text: "finding" })).toEqual({
+			kind: "sent",
+			accepted: ["worker-2"],
+			failed: [
+				{ id: "worker-3", reason: "Teammate is pending." },
+				{ id: "worker-4", reason: "Teammate is finished." },
