@@ -0,0 +1,99 @@
+import { existsSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { fauxAssistantMessage, fauxProvider, fauxToolCall } from "@earendil-works/pi-ai/providers/faux";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+export const finding = "接口约束𐐀\n".repeat(3000);
+
+export default function (pi: ExtensionAPI): void {
+	const directory = process.env.PI_TEAM_TEST_DIR;
+	if (!directory) throw new Error("Missing fixture directory");
+	const provider = fauxProvider({ provider: "team-test", models: [{ id: "test-model" }] });
+	pi.registerProvider(provider.provider);
+	const enabled = process.env.PI_TEAM_TEST_MODE !== "disabled";
+	provider.setResponses(
+		Array.from({ length: 12 }, () => async (context, options, state) => {
+			const initial = context.messages.find((message) => message.role === "user");
+			const task = initial?.content;
+			const text =
+				typeof task === "string"
+					? task
+					: task
+							?.filter((part) => part.type === "text")
+							.map((part) => part.text)
+							.join("");
+			if (!text?.startsWith("Task:")) {
+				if (state.callCount === 1) {
+					return fauxAssistantMessage(
+						fauxToolCall("subagent", {
+							communication: enabled,
+							tasks: [
+								{ id: "sender", agent: "worker", task: "send" },
+								{ id: "recipient", agent: "worker", task: "receive" },
+							],
+						}),
+						{ stopReason: "toolUse" },
+					);
+				}
+				return fauxAssistantMessage("parent done");
+			}
+			const role = text.includes("receive") ? "recipient" : "sender";
+			if (state.callCount === 1) {
+				writeFileSync(
+					join(directory, `${role}.json`),
+					JSON.stringify({
+						pid: process.pid,
+						tools: context.tools?.map((tool) => tool.name),
+						argv: process.argv,
+						prompt: context.systemPrompt,
+					}),
+				);
+			}
+			if (!enabled) return fauxAssistantMessage(`${role} disabled`);
+			if (process.env.PI_TEAM_TEST_MODE === "cancel") {
+				await delay(60_000, undefined, { signal: options?.signal });
+			}
+			if (role === "sender") {
+				if (state.callCount === 1) {
+					while (!existsSync(join(directory, "recipient.json")))
+						await delay(10, undefined, { signal: options?.signal });
+					return fauxAssistantMessage(
+						[fauxToolCall("team_list", {}), fauxToolCall("team_send", { to: "recipient", text: finding })],
+						{ stopReason: "toolUse" },
+					);
+				}
+				writeFileSync(join(directory, "sent"), "sent");
+				return fauxAssistantMessage("sender done");
+			}
+			if (state.callCount === 1) {
+				while (!existsSync(join(directory, "sent"))) await delay(10, undefined, { signal: options?.signal });
+				return fauxAssistantMessage(
+					[
+						fauxToolCall("read", { path: join(directory, "sent") }),
+						fauxToolCall("read", { path: join(directory, "recipient.json") }),
+					],
+					{ stopReason: "toolUse" },
+				);
+			}
+			const messages = context.messages.flatMap((message) => {
+				const content = message.content;
+				const combined =
+					typeof content === "string"
+						? content
+						: content
+								.filter((part) => part.type === "text")
+								.map((part) => part.text)
+								.join("");
+				if (!combined.startsWith("Findings from teammates")) return [];
+				return JSON.parse(combined.slice(combined.indexOf("\n") + 1)) as {
+					from: string;
+					agent: string;
+					text: string;
+				}[];
+			});
+			writeFileSync(join(directory, "received.json"), JSON.stringify(messages));
+			return fauxAssistantMessage(`received ${messages.length} findings`);
+		}),
+	);
+}
diff --git a/packages/coding-agent/test/subagent-team-process.test.ts b/packages/coding-agent/test/subagent-team-process.test.ts
new file mode 100644
index 000000000..52bd2b485
--- /dev/null
+++ b/packages/coding-agent/test/subagent-team-process.test.ts
@@ -0,0 +1,169 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { afterEach, describe, expect, it } from "vitest";
+import { TeamBroker } from "../examples/extensions/subagent/team.ts";
+import { ENV_AGENT_DIR } from "../src/config.ts";
+import { finding } from "./fixtures/subagent-team-provider.ts";
+
+const root = resolve(import.meta.dirname, "../../..");
+const extension = join(root, "packages/coding-agent/examples/extensions/subagent/index.ts");
+const fixture = join(root, "packages/coding-agent/test/fixtures/subagent-team-provider.ts");
+const children = new Set<ChildProcess>();
+const directories: string[] = [];
+
+function launch(mode: "enabled" | "disabled" | "cancel", directWorker = false) {
+	const directory = mkdtempSync(join(tmpdir(), "pi-team-process-"));
+	directories.push(directory);
+	const agentDir = join(directory, "agent");
+	mkdirSync(join(agentDir, "agents"), { recursive: true });
+	writeFileSync(
+		join(agentDir, "agents", "worker.md"),
+		"---\nname: worker\ndescription: test worker\ntools: read\n---\nWork on your task.\n",
+	);
+	writeFileSync(
+		join(agentDir, "settings.json"),
+		JSON.stringify({ extensions: [extension, fixture], compaction: { enabled: false }, retry: { enabled: false } }),
+	);
+	const child = spawn(
+		process.execPath,
+		[
+			"--import",
+			join(root, "packages/coding-agent/src/experimental/source-resolver.ts"),
+			join(root, "packages/coding-agent/src/cli.ts"),
+			"--mode",
+			"json",
+			"-p",
+			"--no-session",
+			"--model",
+			"team-test/test-model",
+			"--thinking",
+			"off",
+			...(directWorker
+				? ["--extension", join(root, "packages/coding-agent/examples/extensions/subagent/team-worker.ts")]
+				: []),
+			directWorker ? "Task: receive" : "delegate",
+		],
+		{
+			cwd: directory,
+			env: {
+				...process.env,
+				[ENV_AGENT_DIR]: agentDir,
+				PI_TEAM_TEST_DIR: directory,
+				PI_TEAM_TEST_MODE: mode,
+				PI_OFFLINE: "1",
+			},
+			stdio: directWorker ? ["ignore", "pipe", "pipe", "ipc"] : ["ignore", "pipe", "pipe"],
+		},
+	);
+	children.add(child);
+	let stdout = "";
+	let stderr = "";
+	child.stdout?.setEncoding("utf8").on("data", (text: string) => {
+		stdout += text;
+	});
+	child.stderr?.setEncoding("utf8").on("data", (text: string) => {
+		stderr += text;
+	});
+	const done = new Promise<{ code: number | null; stdout: string; stderr: string }>((resolveDone, reject) => {
+		child.once("error", reject);
+		child.once(directWorker ? "exit" : "close", (code) => {
+			children.delete(child);
+			resolveDone({ code, stdout, stderr });
+		});
+	});
+	return { directory, child, done };
+}
+
+async function waitForWorkers(run: ReturnType<typeof launch>, roles: string[]): Promise<void> {
+	const controller = new AbortController();
+	try {
+		await Promise.race([
+			(async () => {
+				for (let attempt = 0; attempt < 500; attempt++) {
+					if (roles.every((role) => existsSync(join(run.directory, `${role}.json`)))) return;
+					await delay(20, undefined, { signal: controller.signal });
+				}
+				throw new Error("Workers did not start within 10 seconds");
+			})(),
+			run.done.then((result) => {
+				throw new Error(`Exited before workers started: ${result.stderr}\n${result.stdout}`);
+			}),
+		]);
+	} finally {
+		controller.abort();
+	}
+}
+
+afterEach(async () => {
+	await Promise.all(
+		Array.from(
+			children,
+			(child) =>
+				new Promise<void>((resolveClose) => {
+					if (child.exitCode !== null || child.signalCode !== null) return resolveClose();
+					child.once("close", () => resolveClose());
+					child.kill("SIGTERM");
+					setTimeout(() => child.kill("SIGKILL"), 5000).unref();
+				}),
+		),
+	);
+	children.clear();
+	for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true });
+});
+
+describe("subagent teams in real TypeScript Pi processes", () => {
+	it("loads worker tools with restricted agent tools and delivers intact Unicode over IPC", async () => {
+		const run = launch("enabled");
+		const result = await run.done;
+		expect(result.code, result.stderr).toBe(0);
+		expect(result.stdout).toContain("received 1 findings");
+		expect(JSON.parse(readFileSync(join(run.directory, "received.json"), "utf8"))).toEqual([
+			{ from: "sender", agent: "worker", text: finding },
+		]);
+		const recipient = JSON.parse(readFileSync(join(run.directory, "recipient.json"), "utf8"));
+		const sender = JSON.parse(readFileSync(join(run.directory, "sender.json"), "utf8"));
+		expect(recipient.pid).not.toBe(sender.pid);
+		expect(recipient.pid).not.toBe(run.child.pid);
+		expect(recipient.tools.sort()).toEqual(["read", "team_broadcast", "team_list", "team_send"]);
+		expect(recipient.argv).toContain("team-test/test-model");
+		expect(recipient.argv).toContain("off");
+		expect(recipient.prompt).toContain("Work on your task.");
+	});
+
+	it("leaves disabled workers without communication tools or IPC extension", async () => {
+		const run = launch("disabled");
+		const result = await run.done;
+		expect(result.code, result.stderr).toBe(0);
+		const recipient = JSON.parse(readFileSync(join(run.directory, "recipient.json"), "utf8"));
+		expect(recipient.tools).toEqual(["read"]);
+		expect(recipient.argv.join(" ")).not.toContain("team-worker.ts");
+		expect(recipient.prompt).not.toContain("private parallel team");
+	});
+
+	it("stops live children when the parent is cancelled", async () => {
+		const run = launch("cancel");
+		await waitForWorkers(run, ["sender", "recipient"]);
+		const pids = ["sender", "recipient"].map(
+			(role) => (JSON.parse(readFileSync(join(run.directory, `${role}.json`), "utf8")) as { pid: number }).pid,
+		);
+		run.child.kill("SIGTERM");
+		await run.done;
+		for (const pid of pids) expect(() => process.kill(pid, 0)).toThrow();
+	});
+
+	it("stops a worker if the parent's IPC connection disappears", async () => {
+		const run = launch("cancel", true);
+		const team = new TeamBroker([{ id: "recipient", agent: "worker", task: "receive" }]);
+		const failures: string[] = [];
+		team.attach("recipient", run.child, (error) => failures.push(error));
+		await waitForWorkers(run, ["recipient"]);
+		run.child.disconnect();
+		const result = await run.done;
+		expect(result.code).not.toBe(0);
+		expect(failures).toEqual(["Worker recipient disconnected before completing the team delivery handshake"]);
+		await team.close();
+	});
+});
diff --git a/packages/coding-agent/test/subagent-team.test.ts b/packages/coding-agent/test/subagent-team.test.ts
new file mode 100644
index 000000000..ed0c0d777
--- /dev/null
+++ b/packages/coding-agent/test/subagent-team.test.ts
@@ -0,0 +1,158 @@
+import { describe, expect, it } from "vitest";
+import {
+	MAX_INBOX_BYTES,
+	MAX_INBOX_MESSAGES,
+	MAX_MESSAGE_BYTES,
+	TeamBroker,
+} from "../examples/extensions/subagent/team.ts";
+
+function createTeam(): TeamBroker {
+	const team = new TeamBroker([
+		{ id: "first", agent: "worker", task: "Investigate" },
+		{ id: "second", agent: "worker", task: "Implement" },
+		{ id: "third", agent: "reviewer", task: "Review" },
+	]);
+	team.request("first", { action: "ready" });
+	team.request("second", { action: "ready" });
+	return team;
+}
+
+describe("subagent team broker", () => {
+	it("gives repeated agents independent addresses and exposes task/status", () => {
+		const team = createTeam();
+		expect(team.request("first", { action: "list" })).toEqual({
+			kind: "roster",
+			self: "first",
+			members: [
+				{ id: "first", agent: "worker", task: "Investigate", status: "running" },
+				{ id: "second", agent: "worker", task: "Implement", status: "running" },
+				{ id: "third", agent: "reviewer", task: "Review", status: "queued" },
+			],
+		});
+		const defaults = new TeamBroker([
+			{ agent: "worker", task: "one" },
+			{ agent: "worker", task: "two" },
+		]);
+		expect(defaults.request("worker-1", { action: "ready" })).toMatchObject({ self: "worker-1" });
+		const solo = new TeamBroker([{ agent: "worker", task: "alone" }]);
+		solo.request("worker-1", { action: "ready" });
+		expect(solo.request("worker-1", { action: "broadcast", text: "hello" })).toEqual({
+			kind: "error",
+			error: "No teammates in this dispatch",
+		});
+		expect(
+			() =>
+				new TeamBroker([
+					{ id: "worker-2", agent: "a", task: "" },
+					{ agent: "a", task: "" },
+				]),
+		).toThrow("Duplicate");
+		expect(() => new TeamBroker([{ id: "bad/id", agent: "a", task: "" }])).toThrow("Invalid worker ID");
+	});
+
+	it("delivers complete Unicode once in sender order with broker-supplied identity", () => {
+		const team = createTeam();
+		const texts = ['接口约束\n"héllo"\u0000', "𐐀".repeat(MAX_MESSAGE_BYTES / 4), "last"];
+		for (const text of texts)
+			expect(team.request("first", { action: "send", to: "second", text })).toEqual({
+				kind: "delivery",
+				accepted: ["second"],
+				failed: [],
+			});
+		expect(team.request("second", { action: "boundary", finish: false })).toEqual({
+			kind: "boundary",
+			messages: texts.map((text) => ({ from: "first", agent: "worker", text })),
+			finished: false,
+		});
+		expect(team.request("second", { action: "boundary", finish: false })).toMatchObject({ messages: [] });
+		expect(team.request("first", { action: "boundary", finish: false })).toMatchObject({ messages: [] });
+	});
+
+	it("serializes final retirement with acceptance, never restarting a finished worker", () => {
+		const team = createTeam();
+		team.request("first", { action: "send", to: "second", text: "before final boundary" });
+		expect(team.request("second", { action: "boundary", finish: true })).toMatchObject({
+			finished: false,
+			messages: [{ text: "before final boundary" }],
+		});
+		expect(team.request("first", { action: "send", to: "second", text: "while processing" })).toMatchObject({
+			accepted: ["second"],
+		});
+		expect(team.request("second", { action: "boundary", finish: true })).toMatchObject({ finished: false });
+		expect(team.request("second", { action: "boundary", finish: true })).toMatchObject({ finished: true });
+		expect(team.request("first", { action: "send", to: "second", text: "too late" })).toEqual({
+			kind: "delivery",
+			accepted: [],
+			failed: [{ to: "second", reason: "Teammate is finished" }],
+		});
+		expect(team.request("second", { action: "ready" })).toMatchObject({ kind: "error" });
+	});
+
+	it("reports every unsuccessful recipient and partial broadcasts without sending to self", () => {
+		const team = createTeam();
+		expect(team.request("first", { action: "broadcast", text: "finding" })).toEqual({
+			kind: "delivery",
+			accepted: ["second"],
+			failed: [{ to: "third", reason: "Teammate is queued" }],
+		});
+		for (const to of ["first", "missing", "third"])
+			expect(team.request("first", { action: "send", to, text: "finding" })).toMatchObject({
+				accepted: [],
+				failed: [{ to }],
+			});
+		team.finish("second");
+		expect(team.request("first", { action: "broadcast", text: "finding" })).toMatchObject({
+			accepted: [],
+			failed: [{ to: "second" }, { to: "third" }],
+		});
+	});
+
+	it("explicitly rejects malformed, spoofed and oversized requests", () => {
+		const team = createTeam();
+		for (const request of [
+			null,
+			{},
+			{ action: "receive" },
+			{ action: "boundary", finish: "yes" },
+			{ action: "send", text: "x" },
+			{ action: "send", to: "second", text: "" },
+			{ action: "send", to: "second", text: 1 },
+			{ action: "broadcast", text: "x", from: "second" },
+			{ action: "send", to: "second", text: "𐐀".repeat(MAX_MESSAGE_BYTES / 4 + 1) },
+		])
+			expect(team.request("first", request)).toMatchObject({ kind: "error" });
+		expect(team.request("outsider", { action: "list" })).toMatchObject({ kind: "error" });
+		expect(team.request("second", { action: "boundary", finish: false })).toMatchObject({ messages: [] });
+	});
+
+	it("bounds queues by bytes and count, reporting backpressure per recipient", () => {
+		const team = createTeam();
+		for (let index = 0; index < MAX_INBOX_BYTES / MAX_MESSAGE_BYTES; index++)
+			expect(
+				team.request("first", { action: "send", to: "second", text: "x".repeat(MAX_MESSAGE_BYTES) }),
+			).toMatchObject({ accepted: ["second"] });
+		team.request("third", { action: "ready" });
+		expect(team.request("first", { action: "broadcast", text: "one more" })).toEqual({
+			kind: "delivery",
+			accepted: ["third"],
+			failed: [{ to: "second", reason: "Teammate inbox is full" }],
+		});
+		team.request("second", { action: "boundary", finish: false });
+		for (let index = 0; index < MAX_INBOX_MESSAGES; index++)
+			team.request("first", { action: "send", to: "second", text: "x" });
+		expect(team.request("first", { action: "send", to: "second", text: "x" })).toMatchObject({
+			accepted: [],
+			failed: [{ reason: "Teammate inbox is full" }],
+		});
+	});
+
+	it("isolates concurrent and later dispatches reusing IDs, and closes acceptance", async () => {
+		const first = createTeam();
+		const second = createTeam();
+		first.request("first", { action: "send", to: "second", text: "private" });
+		expect(second.request("second", { action: "boundary", finish: false })).toMatchObject({ messages: [] });
+		await first.close();
+		expect(first.request("first", { action: "send", to: "second", text: "late" })).toMatchObject({ kind: "error" });
+		expect(createTeam().request("second", { action: "boundary", finish: false })).toMatchObject({ messages: [] });
+	});
+});
diff --git a/packages/coding-agent/test/suite/subagent-team.test.ts b/packages/coding-agent/test/suite/subagent-team.test.ts
