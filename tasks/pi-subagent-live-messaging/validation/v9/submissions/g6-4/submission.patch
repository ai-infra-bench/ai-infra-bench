+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import { TeamBroker } from "../../examples/extensions/subagent/team.ts";
+import { registerTeamWorker } from "../../examples/extensions/subagent/team-worker.ts";
+import { createHarness, getAssistantTexts, getMessageText, type Harness } from "./harness.ts";
+
+describe("subagent team model delivery", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		for (const harness of harnesses.splice(0)) harness.cleanup();
+	});
+
+	it("delivers all findings in the next call after every tool completes, without model polling", async () => {
+		const team = new TeamBroker([
+			{ id: "sender", agent: "worker", task: "send" },
+			{ id: "recipient", agent: "worker", task: "receive" },
+		]);
+		team.request("sender", { action: "ready" });
+		const toolOrder: string[] = [];
+		const harness = await createHarness({
+			settings: { steeringMode: "one-at-a-time" },
+			extensionFactories: [(pi) => registerTeamWorker(pi, async (request) => team.request("recipient", request))],
+			tools: [
+				{
+					name: "work",
+					label: "Work",
+					description: "Work",
+					parameters: Type.Object({ stage: Type.String() }),
+					execute: async (_callId, params, signal) => {
+						const stage = (params as { stage: string }).stage;
+						toolOrder.push(stage);
+						expect(signal?.aborted).toBe(false);
+						if (stage === "first") {
+							for (const text of ["constraint α", "约束二"])
+								expect(team.request("sender", { action: "send", to: "recipient", text })).toMatchObject({
+									accepted: ["recipient"],
+								});
+							await new Promise((resolve) => setTimeout(resolve, 10));
+						}
+						return { content: [{ type: "text", text: stage }], details: {} };
+					},
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("work", { stage: "first" }), fauxToolCall("work", { stage: "second" })], {
+				stopReason: "toolUse",
+			}),
+			(context) => {
+				expect(toolOrder).toEqual(["first", "second"]);
+				const findings = context.messages
+					.map(getMessageText)
+					.filter((text) => text.includes("Findings from teammates"));
+				expect(findings).toHaveLength(1);
+				expect(findings[0]).toContain(
+					JSON.stringify([
+						{ from: "sender", agent: "worker", text: "constraint α" },
+						{ from: "sender", agent: "worker", text: "约束二" },
+					]),
+				);
+				expect(context.messages.map((message) => message.role)).toEqual([
+					"user",
+					"assistant",
+					"toolResult",
+					"toolResult",
+					"user",
+				]);
+				return fauxAssistantMessage("applied findings");
+			},
+		]);
+		await harness.session.prompt("implement");
+		expect(harness.session.messages.filter((message) => message.role === "custom")).toHaveLength(1);
+		expect(team.request("sender", { action: "send", to: "recipient", text: "late" })).toMatchObject({
+			failed: [{ reason: "Teammate is finished" }],
+		});
+	});
+
+	it.each(["response", "agent_end"])(
+		"continues an otherwise final answer for findings accepted during %s",
+		async (phase) => {
+			const team = new TeamBroker([
+				{ id: "sender", agent: "worker", task: "send" },
+				{ id: "recipient", agent: "worker", task: "receive" },
+			]);
+			team.request("sender", { action: "ready" });
+			let sent = false;
+			const send = () => {
+				if (sent) return;
+				sent = true;
+				expect(team.request("sender", { action: "send", to: "recipient", text: "final finding" })).toMatchObject({
+					accepted: ["recipient"],
+				});
+			};
+			const harness = await createHarness({
+				extensionFactories: [
+					(pi) => {
+						if (phase === "agent_end") pi.on("agent_end", send);
+					},
+					(pi) => registerTeamWorker(pi, async (request) => team.request("recipient", request)),
+				],
+			});
+			harnesses.push(harness);
+			harness.setResponses([
+				async () => {
+					if (phase === "response") send();
+					await new Promise((resolve) => setTimeout(resolve, 10));
+					return fauxAssistantMessage("original final answer");
+				},
+				(context) => {
+					expect(context.messages.map(getMessageText).join("\n")).toContain("final finding");
+					return fauxAssistantMessage("revised answer");
+				},
+			]);
+			await harness.session.prompt("finish");
+			expect(getAssistantTexts(harness)).toEqual(["original final answer", "revised answer"]);
+		},
+	);
+
+	it("exposes discovery and sending tools with explicit partial-failure results", async () => {
+		const team = new TeamBroker([
+			{ id: "sender", agent: "worker", task: "send" },
+			{ id: "recipient", agent: "worker", task: "receive" },
+			{ id: "queued", agent: "worker", task: "later" },
+		]);
+		team.request("recipient", { action: "ready" });
+		const harness = await createHarness({
+			extensionFactories: [(pi) => registerTeamWorker(pi, async (request) => team.request("sender", request))],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			fauxAssistantMessage(
+				[
+					fauxToolCall("team_list", {}),
+					fauxToolCall("team_send", { to: "recipient", text: "private" }),
+					fauxToolCall("team_broadcast", { text: "shared" }),
+				],
+				{ stopReason: "toolUse" },
+			),
+			fauxAssistantMessage("done"),
+		]);
+		await harness.session.prompt("share findings");
+		const results = harness.session.messages.filter((message) => message.role === "toolResult");
+		expect(results.map(getMessageText).map((text) => JSON.parse(text))).toMatchObject([
+			{ self: "sender" },
+			{ accepted: ["recipient"], failed: [] },
+			{ accepted: ["recipient"], failed: [{ to: "queued" }] },
+		]);
+		expect(team.request("recipient", { action: "boundary", finish: false })).toMatchObject({
+			messages: [
+				{ from: "sender", text: "private" },
+				{ from: "sender", text: "shared" },
+			],
+		});
+	});
+});
