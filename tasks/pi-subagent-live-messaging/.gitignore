# Keep local runs and historical review artifacts out of submissions.
/validation/*
!/validation/ci-cases.json
!/validation/patches/
/validation/patches/*
!/validation/patches/*.patch
!/validation/tools/
/validation/tools/*
!/validation/tools/*.py
!/validation/tools/*.json
!/validation/tools/test_send_selectors.mjs

__pycache__/
*.py[cod]
.env
.env.*
*.log
/environment/prefetch-debs.cjs
/environment/snapshot-index.cjs
