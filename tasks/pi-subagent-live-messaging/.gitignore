# Keep local runs and historical review artifacts out of submissions.
/validation/*
!/validation/ci-cases.json
!/validation/drop_accepted.patch
!/validation/reverse_fifo.patch
!/validation/duplicate_delivery.patch
!/validation/alternative-spool.patch

__pycache__/
*.py[cod]
.env
.env.*
*.log
/environment/prefetch-debs.cjs
/environment/snapshot-index.cjs
