+# Some languages are conventionally written without spaces between words. For
+# the others, independently decoded audio chunks need a separator when their
+# decoded text does not already provide one.
+_SPACELESS_LANGUAGES = frozenset(("zh", "ja", "th", "lo", "km", "my"))
+_OPENING_PUNCTUATION = frozenset("([{<\"'\u2018\u201c")
+
+
+def _is_cjk_character(character: str) -> bool:
+    """Return whether *character* belongs to a script normally written without
+    spaces between words.
+
+    The script check is also useful when the request language is omitted (as
+    it is for Qwen3-ASR), while the explicit language check handles chunks
+    containing only punctuation or Latin text.
+    """
+    codepoint = ord(character)
+    return (
+        0x2E80 <= codepoint <= 0x2FFF  # CJK radicals and punctuation
+        or 0x3000 <= codepoint <= 0x30FF  # Hiragana, Katakana, punctuation
+        or 0x31F0 <= codepoint <= 0x31FF  # Katakana extensions
+        or 0x3400 <= codepoint <= 0x4DBF  # CJK extension A
+        or 0x4E00 <= codepoint <= 0x9FFF  # CJK unified ideographs
+        or 0xF900 <= codepoint <= 0xFAFF  # CJK compatibility ideographs
+    )
+
+
+def _needs_speech_text_separator(
+    previous: str, current: str, language: str | None
+) -> bool:
+    if not previous or not current:
+        return False
+    if language in _SPACELESS_LANGUAGES:
+        return False
+    if previous[-1].isspace() or current[0].isspace():
+        return False
+    if language is None and (
+        _is_cjk_character(previous[-1]) or _is_cjk_character(current[0])
+    ):
+        return False
+    if previous[-1] in _OPENING_PUNCTUATION:
+        return False
+    # Punctuation belongs to the surrounding text; in particular, do not
+    # produce ``word ,`` when the next chunk starts with punctuation.
+    if unicodedata.category(current[0]).startswith("P"):
+        return False
+    return True
+
+
+def _speech_output_language(
+    task_type: Literal["transcribe", "translate"],
+    language: str | None,
+    to_language: str | None,
+) -> str | None:
+    if task_type == "translate":
+        # The OpenAI translation endpoint targets English by default; vLLM's
+        # ``to_language`` extension can select another output language.
+        return to_language or "en"
+    return language
+
+
+def _join_speech_text_parts(
+    text_parts: list[str], language: str | None = None
+) -> str:
+    """Join text decoded from independent audio chunks.
+
+    Token detokenization cannot provide whitespace across separate model
+    requests.  Add it only where the surrounding text indicates a
+    space-delimited language; CJK/Japanese boundaries remain untouched.
+    """
+    joined_parts = []
+    previous = ""
+    for part in text_parts:
+        if not part:
+            continue
+        if _needs_speech_text_separator(previous, part, language):
+            joined_parts.append(" ")
+        joined_parts.append(part)
+        previous = part
+    return "".join(joined_parts)
+
