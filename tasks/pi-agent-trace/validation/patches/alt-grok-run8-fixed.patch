+import { createHash } from "node:crypto";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import agentTrace from "../examples/extensions/agent-trace/index.ts";
+import { VERSION } from "../src/config.ts";
+import type { ExtensionAPI, ExtensionContext, SessionEntry } from "../src/core/extensions/index.ts";
+import { createHarnessWithExtensions, type Harness } from "./test-harness.ts";
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Array<{
+		key: string;
+		value:
+			| { stringValue: string }
+			| { intValue: string }
+			| { boolValue: boolean }
+			| { arrayValue: { values: Array<{ stringValue: string }> } };
+	}>;
+	status?: { code: number; message?: string };
+};
+
+type OtlpLine = {
+	resourceSpans: Array<{
+		resource: { attributes: OtlpSpan["attributes"] };
+		scopeSpans: Array<{ scope: { name: string; version: string }; spans: OtlpSpan[] }>;
+	}>;
+};
+
+const ENV_TRACE_ID = "PI_AGENT_TRACE_ID";
+const ENV_PARENT_SPAN_ID = "PI_AGENT_TRACE_PARENT_SPAN_ID";
+const ENV_TRACE_FILE = "PI_AGENT_TRACE_FILE";
+
+const savedEnv = {
+	file: process.env[ENV_TRACE_FILE],
+	trace: process.env[ENV_TRACE_ID],
+	parent: process.env[ENV_PARENT_SPAN_ID],
+};
+
+function restoreProcessEnv(): void {
+	restoreVar(ENV_TRACE_FILE, savedEnv.file);
+	restoreVar(ENV_TRACE_ID, savedEnv.trace);
+	restoreVar(ENV_PARENT_SPAN_ID, savedEnv.parent);
+}
+
+function restoreVar(name: string, value: string | undefined): void {
+	if (value === undefined) delete process.env[name];
+	else process.env[name] = value;
+}
+
+function attrMap(span: OtlpSpan): Record<string, unknown> {
+	const out: Record<string, unknown> = {};
+	for (const attribute of span.attributes) {
+		if ("stringValue" in attribute.value) out[attribute.key] = attribute.value.stringValue;
+		else if ("intValue" in attribute.value) out[attribute.key] = attribute.value.intValue;
+		else if ("boolValue" in attribute.value) out[attribute.key] = attribute.value.boolValue;
+		else if ("arrayValue" in attribute.value) {
+			out[attribute.key] = attribute.value.arrayValue.values.map((value) => value.stringValue);
+		}
+	}
+	return out;
+}
+
+function readLines(path: string): OtlpLine[] {
+	if (!existsSync(path)) return [];
+	return readFileSync(path, "utf8")
+		.split("\n")
+		.filter((line) => line.length > 0)
+		.map((line) => JSON.parse(line) as OtlpLine);
+}
+
+function readSpans(path: string): OtlpSpan[] {
+	return readLines(path).map((line) => line.resourceSpans[0].scopeSpans[0].spans[0]);
+}
+
+function starts(spans: OtlpSpan[]): OtlpSpan[] {
+	return spans.filter((span) => attrMap(span)["pi.span.phase"] === "start");
+}
+
+function ends(spans: OtlpSpan[]): OtlpSpan[] {
+	return spans.filter((span) => attrMap(span)["pi.span.phase"] === undefined && span.endTimeUnixNano);
+}
+
+function usage() {
+	return {
+		input: 10,
+		output: 5,
+		cacheRead: 2,
+		cacheWrite: 1,
+		totalTokens: 18,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function assistant(overrides: Partial<AssistantMessage> = {}): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text: "ok" }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "faux-1",
+		usage: usage(),
+		stopReason: "stop",
+		timestamp: Date.now(),
+		...overrides,
+	};
+}
+
+function user(text: string, timestamp = Date.now()): AgentMessage {
+	return { role: "user", content: [{ type: "text", text }], timestamp };
+}
+
+function customMessage(customType: string, text: string, timestamp = Date.now()): AgentMessage {
+	return {
+		role: "custom",
+		customType,
+		content: text,
+		display: true,
+		timestamp,
+	} as AgentMessage;
+}
+
+function toolResult(toolCallId: string, toolName: string, text: string, isError = false): ToolResultMessage {
+	return {
+		role: "toolResult",
+		toolCallId,
+		toolName,
+		content: [{ type: "text", text }],
+		isError,
+		timestamp: Date.now(),
+	};
+}
+
+describe("agent-trace example extension", () => {
+	const dirs: string[] = [];
+	const harnesses: Harness[] = [];
+
+	afterEach(() => {
+		restoreProcessEnv();
+		while (harnesses.length > 0) {
+			harnesses.pop()?.cleanup();
+		}
+		while (dirs.length > 0) {
+			const dir = dirs.pop();
+			if (dir && existsSync(dir)) rmSync(dir, { recursive: true, force: true });
