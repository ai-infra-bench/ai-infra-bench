+/**
+ * Agent-trace extension.
+ *
+ * Exports each agent run as an OpenTelemetry OTLP/JSON JSONL file so a collector
+ * or viewer can reconstruct what the loop did, with timings and token accounting.
+ *
+ * Usage:
+ *   pi -e packages/coding-agent/examples/extensions/agent-trace
+ *   PI_AGENT_TRACE_FILE=/tmp/trace.otlp.jsonl pi -e ./agent-trace
+ */
+
+import { createHash, randomBytes } from "node:crypto";
+import { appendFileSync, closeSync, existsSync, fstatSync, mkdirSync, openSync, readSync, writeSync } from "node:fs";
+import { dirname, join } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import { type ExtensionAPI, type ExtensionContext, type SessionEntry, VERSION } from "@earendil-works/pi-coding-agent";
+
+const SCOPE_NAME = "pi.agent-trace";
+const SCOPE_VERSION = "1";
+const ENV_TRACE_ID = "PI_AGENT_TRACE_ID";
+const ENV_PARENT_SPAN_ID = "PI_AGENT_TRACE_PARENT_SPAN_ID";
+const ENV_TRACE_FILE = "PI_AGENT_TRACE_FILE";
+const WRITE_FAILURE_CUSTOM_TYPE = "agent-trace";
+
+type AttrValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type Attribute = { key: string; value: AttrValue };
+
+type OtlpStatus = { code: 1 } | { code: 2; message: string };
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Attribute[];
+	status?: OtlpStatus;
+};
+
+type OpenSpan = {
+	name: string;
+	kind: number;
+	spanId: string;
+	parentSpanId?: string;
+	startTimeUnixNano: bigint;
+	startAttributes: Attribute[];
+};
+
+type PendingEnd = {
+	span: OpenSpan;
+	endTime: bigint;
+	attributes: Attribute[];
+	status: OtlpStatus;
+	lookup?: EntryLookup;
+};
+
+type EntryLookup =
+	| { kind: "assistant"; timestamp: number; content: unknown }
+	| { kind: "user"; timestamp: number; content: unknown }
+	| { kind: "toolResult"; toolCallId: string }
+	| { kind: "custom"; customType: string; content: unknown; timestamp: number };
+
+type SteerRef = { lookup: EntryLookup };
+
+type RunTrigger = "prompt" | "wakeup" | "continuation";
+
+let writeFailureReported = false;
+let pendingWriteFailurePath: string | undefined;
+
+function attrString(key: string, value: string): Attribute {
+	return { key, value: { stringValue: value } };
+}
+
+function attrInt(key: string, value: number): Attribute {
+	return { key, value: { intValue: String(Math.trunc(value)) } };
+}
+
+function attrBool(key: string, value: boolean): Attribute {
+	return { key, value: { boolValue: value } };
+}
+
+function attrStringArray(key: string, values: string[]): Attribute {
+	return { key, value: { arrayValue: { values: values.map((stringValue) => ({ stringValue })) } } };
+}
+
+function newSpanId(): string {
+	return randomBytes(8).toString("hex");
+}
+
+function traceIdFromSessionId(sessionId: string): string {
+	const hex = sessionId.replace(/-/g, "").toLowerCase();
+	if (/^[0-9a-f]{32}$/.test(hex)) return hex;
+	return createHash("sha256").update(sessionId).digest("hex").slice(0, 32);
+}
+
+function clockNano(): bigint {
+	return BigInt(Date.now()) * 1_000_000n + (process.hrtime.bigint() % 1_000_000n);
+}
+
+function extractText(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return content == null ? "" : String(content);
+	return content
+		.filter((block): block is { type: string; text?: string } => !!block && typeof block === "object")
+		.filter((block) => block.type === "text" && typeof block.text === "string")
+		.map((block) => block.text as string)
+		.join("");
+}
+
+function sameContent(a: unknown, b: unknown): boolean {
+	if (a === b) return true;
+	if (typeof a === "string" && typeof b === "string") return a === b;
+	try {
+		return JSON.stringify(a) === JSON.stringify(b);
+	} catch {
+		return false;
+	}
+}
+
+function isAssistantMessage(message: AgentMessage): message is AssistantMessage {
+	return message.role === "assistant";
+}
+
+function isToolResultMessage(message: AgentMessage): message is ToolResultMessage {
+	return message.role === "toolResult";
+}
+
+function assistantErrorMessage(message: AssistantMessage): string {
+	if (message.errorMessage && message.errorMessage.length > 0) return message.errorMessage;
+	return "aborted";
+}
+
+function compactionErrorMessage(event: { errorMessage?: string; aborted?: boolean }): string {
+	if (event.aborted) return "aborted";
+	if (event.errorMessage && event.errorMessage.length > 0) return event.errorMessage;
+	return "aborted";
+}
+
+function resolveTracePath(sessionDir: string, sessionId: string): string {
+	const override = process.env[ENV_TRACE_FILE];
+	if (override && override.length > 0) return override;
+	return join(sessionDir, "traces", `${sessionId}.otlp.jsonl`);
+}
+
+function reportWriteFailure(pi: ExtensionAPI, filePath: string): void {
+	if (writeFailureReported) return;
+	try {
+		pi.sendMessage({
+			customType: WRITE_FAILURE_CUSTOM_TYPE,
+			content: `agent-trace: cannot write ${filePath}`,
+			display: true,
+		});
+		writeFailureReported = true;
+		pendingWriteFailurePath = undefined;
+	} catch {
+		pendingWriteFailurePath = filePath;
+	}
+}
+
+function snapshotEnv(name: string): string | undefined {
+	return Object.hasOwn(process.env, name) ? process.env[name] : undefined;
+}
+
+function restoreEnvVar(name: string, original: string | undefined): void {
+	if (original === undefined) {
+		delete process.env[name];
+	} else {
+		process.env[name] = original;
+	}
+}
+
+class TraceWriter {
+	readonly filePath: string;
+	private readonly pi: ExtensionAPI;
+	private readonly resourceAttributes: Attribute[];
+	private prepared = false;
+	private failed = false;
+	private lastEndTime = 0n;
+	private lastIssued = 0n;
+
+	constructor(pi: ExtensionAPI, filePath: string, resourceAttributes: Attribute[]) {
+		this.pi = pi;
+		this.filePath = filePath;
+		this.resourceAttributes = resourceAttributes;
+	}
+
+	nextTime(min?: bigint): bigint {
+		let n = clockNano();
+		if (min !== undefined && n < min) n = min;
+		if (n <= this.lastIssued) n = this.lastIssued + 1n;
+		this.lastIssued = n;
+		return n;
+	}
+
+	timeFromMillis(ms: number, min?: bigint): bigint {
+		let n = BigInt(ms) * 1_000_000n;
+		if (min !== undefined && n < min) n = min;
+		if (n <= this.lastIssued) n = this.lastIssued + 1n;
+		this.lastIssued = n;
+		return n;
+	}
+
+	endTime(start: bigint): bigint {
+		let n = this.nextTime(start);
+		if (n < this.lastEndTime) n = this.lastEndTime;
+		if (n < start) n = start;
+		this.lastEndTime = n;
+		if (n > this.lastIssued) this.lastIssued = n;
+		return n;
+	}
+
+	prepare(): void {
+		if (this.prepared || this.failed) return;
+		try {
+			mkdirSync(dirname(this.filePath), { recursive: true });
+			if (existsSync(this.filePath)) {
+				const fd = openSync(this.filePath, "r+");
+				try {
+					const size = Number(fstatSync(fd).size);
+					if (size > 0) {
+						const last = Buffer.alloc(1);
+						readSync(fd, last, 0, 1, size - 1);
+						if (last[0] !== 10) {
+							writeSync(fd, Buffer.from("\n"), 0, 1, size);
+						}
+						this.ingestLastEndTime(fd, size);
+					}
+				} finally {
+					closeSync(fd);
+				}
+			}
+			this.prepared = true;
+		} catch {
+			this.markFailed();
+		}
+	}
+
+	writeSpan(span: OtlpSpan): void {
+		if (this.failed) return;
+		this.prepare();
+		if (this.failed) return;
+		const request = {
+			resourceSpans: [
+				{
+					resource: { attributes: this.resourceAttributes },
+					scopeSpans: [
+						{
+							scope: { name: SCOPE_NAME, version: SCOPE_VERSION },
+							spans: [span],
+						},
+					],
+				},
+			],
+		};
+		try {
+			appendFileSync(this.filePath, `${JSON.stringify(request)}\n`);
+		} catch {
+			this.markFailed();
+		}
+	}
+
+	private ingestLastEndTime(fd: number, size: number): void {
+		const window = Math.min(size, 65536);
+		const buf = Buffer.alloc(window);
+		readSync(fd, buf, 0, window, size - window);
+		const text = buf.toString("utf8");
+		const lines = text.split("\n").filter((line) => line.length > 0);
+		for (let i = lines.length - 1; i >= 0; i--) {
+			try {
+				const parsed = JSON.parse(lines[i]) as {
+					resourceSpans?: Array<{ scopeSpans?: Array<{ spans?: Array<{ endTimeUnixNano?: string }> }> }>;
+				};
+				const span = parsed.resourceSpans?.[0]?.scopeSpans?.[0]?.spans?.[0];
+				if (span?.endTimeUnixNano) {
+					const end = BigInt(span.endTimeUnixNano);
+					this.lastEndTime = end;
+					this.lastIssued = end;
+					return;
+				}
+			} catch {
+				// skip a torn or foreign line
+			}
+		}
+	}
+
+	private markFailed(): void {
+		if (this.failed) return;
+		this.failed = true;
+		reportWriteFailure(this.pi, this.filePath);
+	}
+}
+
+class Tracer {
+	readonly sessionId: string;
+	readonly traceId: string;
+	private readonly writer: TraceWriter;
+	private readonly rootParentSpanId: string | undefined;
+	private readonly inheritedTraceId: string | undefined;
+	private readonly inheritedParentSpanId: string | undefined;
+	private readonly activeToolSpans = new Map<string, string>();
+	private readonly usedEntryIds = new Set<string>();
+
+	private run: OpenSpan | undefined;
+	private turn: OpenSpan | undefined;
+	private chat: OpenSpan | undefined;
+	private readonly tools = new Map<string, OpenSpan>();
+	private compaction: OpenSpan | undefined;
+
+	private pendingChatEnd: PendingEnd | undefined;
+	private readonly pendingToolEnds = new Map<string, PendingEnd>();
+
+	private runTrigger: RunTrigger = "prompt";
+	private overflowRetry = false;
+	private afterCompactionId: string | undefined;
+	private runEntryLookup: EntryLookup | undefined;
+	private readonly steerRefs: SteerRef[] = [];
+	private seenAssistantInRun = false;
+	private turnCount = 0;
+	private turnToolCallCount = 0;
+	private turnStopReason: string | undefined;
+	private turnError: string | undefined;
+
+	settled = true;
+	pendingPrompt = false;
+	lastCompaction: { willRetry: boolean; entryId?: string; reason: "manual" | "threshold" | "overflow" } | undefined;
+
+	constructor(options: {
+		writer: TraceWriter;
+		sessionId: string;
+		traceId: string;
+		rootParentSpanId: string | undefined;
+		inheritedTraceId: string | undefined;
+		inheritedParentSpanId: string | undefined;
+	}) {
+		this.writer = options.writer;
+		this.sessionId = options.sessionId;
+		this.traceId = options.traceId;
+		this.rootParentSpanId = options.rootParentSpanId;
+		this.inheritedTraceId = options.inheritedTraceId;
+		this.inheritedParentSpanId = options.inheritedParentSpanId;
+	}
+
+	flushPending(ctx: ExtensionContext, force = false): void {
+		if (this.pendingChatEnd) {
+			const entryId = this.lookupEntryId(ctx, this.pendingChatEnd.lookup);
+			if (entryId || force) {
+				this.writePendingEnd(this.pendingChatEnd, entryId);
+				this.pendingChatEnd = undefined;
+			}
+		}
+		// End lines must appear in end order. pi persists the results of parallel tool calls
+		// in call order once all of them have finished, so flush by end time and stop at the
+		// first end whose entry is not on the branch yet instead of skipping past it.
+		const byEndTime = [...this.pendingToolEnds].sort((a, b) =>
+			a[1].endTime < b[1].endTime ? -1 : a[1].endTime > b[1].endTime ? 1 : 0,
+		);
+		for (const [toolCallId, pending] of byEndTime) {
+			const entryId = this.lookupEntryId(ctx, pending.lookup);
+			if (!entryId && !force) break;
+			this.writePendingEnd(pending, entryId);
+			this.pendingToolEnds.delete(toolCallId);
+		}
+	}
+
+	onAgentStart(): void {
+		if (this.run) this.endRun(undefined, { code: 1 });
+		const wasSettled = this.settled;
+		this.settled = false;
+		this.seenAssistantInRun = false;
+		this.turnCount = 0;
+		this.steerRefs.length = 0;
+		this.runEntryLookup = undefined;
+		this.overflowRetry = false;
+		this.afterCompactionId = undefined;
+
+		if (!wasSettled) {
+			this.runTrigger = "continuation";
+			if (this.lastCompaction?.willRetry) {
+				this.overflowRetry = true;
+				this.afterCompactionId = this.lastCompaction.entryId;
+			}
+		} else if (this.pendingPrompt) {
+			this.runTrigger = "prompt";
+		} else {
+			this.runTrigger = "wakeup";
+		}
+		this.pendingPrompt = false;
+		this.lastCompaction = undefined;
+
+		const startAttributes = [attrString("pi.run.trigger", this.runTrigger)];
+		this.run = this.startSpan("pi.run", 1, this.rootParentSpanId, startAttributes);
+	}
+
+	onAgentEnd(ctx: ExtensionContext): void {
+		this.flushPending(ctx, true);
+		this.closeTurn(ctx, { code: 1 });
+		if (!this.run) return;
+		this.endRun(this.runEndAttributes(ctx), { code: 1 });
+	}
+
+	private runEndAttributes(ctx: ExtensionContext): Attribute[] {
+		const endAttributes: Attribute[] = [
+			attrInt("pi.run.turn_count", this.turnCount),
+			attrInt("pi.run.steer_count", this.steerRefs.length),
+			attrStringArray(
+				"pi.run.steer_entry_ids",
+				this.steerRefs.map((ref) => this.lookupEntryId(ctx, ref.lookup)).filter((id): id is string => !!id),
+			),
+		];
+		if (this.overflowRetry && this.afterCompactionId) {
+			endAttributes.push(attrString("pi.run.after_compaction", this.afterCompactionId));
+		} else {
+			const entryId = this.runEntryLookup ? this.lookupEntryId(ctx, this.runEntryLookup) : undefined;
+			if (entryId) endAttributes.push(attrString("pi.session.entry_id", entryId));
+		}
+		return endAttributes;
+	}
+
+	onAgentSettled(): void {
+		this.settled = true;
+	}
+
+	onTurnStart(event: { turnIndex: number; timestamp: number }): void {
+		if (this.turn) this.closeTurn(undefined, { code: 1 });
+		const start = this.writer.timeFromMillis(event.timestamp, this.run?.startTimeUnixNano);
+		this.turnToolCallCount = 0;
+		this.turnStopReason = undefined;
+		this.turnError = undefined;
+		this.turn = this.startSpan("pi.turn", 1, this.run?.spanId, [attrInt("pi.turn.index", event.turnIndex)], start);
+		this.turnCount = Math.max(this.turnCount, event.turnIndex + 1);
+	}
+
+	onTurnEnd(
+		ctx: ExtensionContext,
+		event: { turnIndex: number; message: AgentMessage; toolResults: ToolResultMessage[] },
+	): void {
+		this.flushPending(ctx, true);
+		if (isAssistantMessage(event.message)) {
+			this.turnStopReason = event.message.stopReason;
+			const toolCalls = event.message.content.filter((block) => block.type === "toolCall");
+			this.turnToolCallCount = toolCalls.length;
+			if (event.message.stopReason === "error" || event.message.stopReason === "aborted") {
+				this.turnError = assistantErrorMessage(event.message);
+			}
+		} else {
+			this.turnToolCallCount = event.toolResults.length;
+		}
+		this.closeTurn(ctx, this.turnError ? { code: 2, message: this.turnError } : { code: 1 });
+	}
+
+	onMessageStart(message: AgentMessage): void {
+		if (message.role === "assistant" && isAssistantMessage(message)) {
+			this.seenAssistantInRun = true;
+			const startAttributes: Attribute[] = [
+				attrString("gen_ai.operation.name", "chat"),
+				attrString("gen_ai.system", message.provider),
+				attrString("gen_ai.request.model", message.model),
+			];
+			this.chat = this.startSpan(`chat ${message.model}`, 3, this.turn?.spanId, startAttributes);
+			return;
+		}
+		if (message.role === "custom" && "customType" in message && message.customType === WRITE_FAILURE_CUSTOM_TYPE) {
+			return;
+		}
+		if (message.role === "user") {
+			this.noteUserOrCustom({ kind: "user", timestamp: message.timestamp, content: message.content });
+		} else if (message.role === "custom") {
+			this.noteUserOrCustom({
+				kind: "custom",
+				customType: (message as { customType: string }).customType,
+				content: message.content,
+				timestamp: message.timestamp,
+			});
+		}
+	}
+
+	onMessageEnd(message: AgentMessage): void {
+		if (message.role === "assistant" && isAssistantMessage(message) && this.chat) {
+			const attributes = this.chatEndAttributes(message);
+			const status =
+				message.stopReason === "error" || message.stopReason === "aborted"
+					? ({ code: 2, message: assistantErrorMessage(message) } satisfies OtlpStatus)
+					: ({ code: 1 } satisfies OtlpStatus);
+			this.pendingChatEnd = {
+				span: this.chat,
+				endTime: this.writer.endTime(this.chat.startTimeUnixNano),
+				attributes,
+				status,
+				lookup: { kind: "assistant", timestamp: message.timestamp, content: message.content },
+			};
+			this.chat = undefined;
+			return;
+		}
+		if (isToolResultMessage(message)) {
+			const pending = this.pendingToolEnds.get(message.toolCallId);
+			if (pending) {
+				pending.lookup = { kind: "toolResult", toolCallId: message.toolCallId };
+			}
+		}
+	}
+
+	onToolStart(event: { toolCallId: string; toolName: string }): void {
+		const startAttributes: Attribute[] = [
+			attrString("gen_ai.operation.name", "execute_tool"),
+			attrString("gen_ai.tool.name", event.toolName),
+			attrString("gen_ai.tool.call.id", event.toolCallId),
+		];
+		const span = this.startSpan(`execute_tool ${event.toolName}`, 1, this.turn?.spanId, startAttributes);
+		this.tools.set(event.toolCallId, span);
+		this.activeToolSpans.set(event.toolCallId, span.spanId);
+		this.refreshToolEnv();
+	}
+
+	onToolEnd(event: { toolCallId: string; toolName: string; result: unknown; isError: boolean }): void {
+		const span = this.tools.get(event.toolCallId);
+		this.tools.delete(event.toolCallId);
+		this.activeToolSpans.delete(event.toolCallId);
+		this.refreshToolEnv();
+		if (!span) return;
+		const text = extractText(
+			event.result && typeof event.result === "object" && "content" in (event.result as object)
+				? (event.result as { content: unknown }).content
+				: event.result,
+		);
+		const attributes: Attribute[] = [attrBool("pi.tool.is_error", event.isError)];
+		this.pendingToolEnds.set(event.toolCallId, {
+			span,
+			endTime: this.writer.endTime(span.startTimeUnixNano),
+			attributes,
+			status: event.isError ? { code: 2, message: text } : { code: 1 },
+			lookup: { kind: "toolResult", toolCallId: event.toolCallId },
+		});
+	}
+
+	onCompactStart(event: { reason: "manual" | "threshold" | "overflow"; willRetry: boolean }): void {
+		if (this.compaction) {
+			this.endSpan(this.compaction, this.writer.endTime(this.compaction.startTimeUnixNano), [], { code: 1 });
+			this.compaction = undefined;
+		}
+		const startAttributes: Attribute[] = [
+			attrString("pi.compaction.reason", event.reason),
+			attrBool("pi.compaction.will_retry", event.willRetry),
+		];
+		this.compaction = this.startSpan("pi.compaction", 1, this.rootParentSpanId, startAttributes);
+		this.lastCompaction = { willRetry: event.willRetry, reason: event.reason };
+	}
+
+	onCompactSuccess(event: {
+		compactionEntry: {
+			id: string;
+			tokensBefore: number;
+			firstKeptEntryId: string;
+			usage?: { input?: number; output?: number };
+		};
+		reason: "manual" | "threshold" | "overflow";
+		willRetry: boolean;
+	}): void {
+		if (!this.compaction) {
+			this.onCompactStart({ reason: event.reason, willRetry: event.willRetry });
+		}
+		this.lastCompaction = {
+			willRetry: event.willRetry,
+			entryId: event.compactionEntry.id,
+			reason: event.reason,
+		};
+		if (!this.compaction) return;
+		const attributes: Attribute[] = [
+			attrInt("pi.compaction.tokens_before", event.compactionEntry.tokensBefore),
+			attrString("pi.compaction.first_kept_entry_id", event.compactionEntry.firstKeptEntryId),
+			attrString("pi.session.entry_id", event.compactionEntry.id),
+		];
+		if (event.compactionEntry.usage) {
+			if (typeof event.compactionEntry.usage.input === "number") {
+				attributes.push(attrInt("gen_ai.usage.input_tokens", event.compactionEntry.usage.input));
+			}
+			if (typeof event.compactionEntry.usage.output === "number") {
+				attributes.push(attrInt("gen_ai.usage.output_tokens", event.compactionEntry.usage.output));
+			}
+		}
+		this.usedEntryIds.add(event.compactionEntry.id);
+		this.endSpan(this.compaction, this.writer.endTime(this.compaction.startTimeUnixNano), attributes, { code: 1 });
+		this.compaction = undefined;
+	}
+
+	onCompactFailed(event: {
+		reason: "manual" | "threshold" | "overflow";
+		errorMessage?: string;
+		aborted: boolean;
+		willRetry: boolean;
+	}): void {
+		this.lastCompaction = { willRetry: event.willRetry, reason: event.reason };
+		if (!this.compaction) {
+			this.onCompactStart({ reason: event.reason, willRetry: event.willRetry });
+		}
+		if (!this.compaction) return;
+		this.endSpan(this.compaction, this.writer.endTime(this.compaction.startTimeUnixNano), [], {
+			code: 2,
+			message: compactionErrorMessage(event),
+		});
+		this.compaction = undefined;
+	}
+
+	onShutdown(ctx: ExtensionContext): void {
+		this.flushPending(ctx, true);
+		const shutdown: OtlpStatus = { code: 2, message: "shutdown" };
+		for (const [toolCallId, span] of [...this.tools]) {
+			this.endSpan(span, this.writer.endTime(span.startTimeUnixNano), [], shutdown);
+			this.tools.delete(toolCallId);
+		}
+		this.activeToolSpans.clear();
+		this.refreshToolEnv();
+		if (this.chat) {
+			this.endSpan(this.chat, this.writer.endTime(this.chat.startTimeUnixNano), [], shutdown);
+			this.chat = undefined;
+		}
+		if (this.turn) {
+			this.endSpan(this.turn, this.writer.endTime(this.turn.startTimeUnixNano), [], shutdown);
+			this.turn = undefined;
+		}
+		if (this.run) {
+			this.endSpan(this.run, this.writer.endTime(this.run.startTimeUnixNano), this.runEndAttributes(ctx), shutdown);
+			this.run = undefined;
+		}
+		if (this.compaction) {
+			this.endSpan(this.compaction, this.writer.endTime(this.compaction.startTimeUnixNano), [], shutdown);
+			this.compaction = undefined;
+		}
+	}
+
+	private noteUserOrCustom(lookup: EntryLookup): void {
+		if (this.seenAssistantInRun) {
+			this.steerRefs.push({ lookup });
+			return;
+		}
+		if (!this.runEntryLookup && !this.overflowRetry) {
+			this.runEntryLookup = lookup;
+		}
+	}
+
+	private chatEndAttributes(message: AssistantMessage): Attribute[] {
+		const attributes: Attribute[] = [attrStringArray("gen_ai.response.finish_reasons", [message.stopReason])];
+		if (message.usage) {
+			attributes.push(attrInt("gen_ai.usage.input_tokens", message.usage.input));
+			attributes.push(attrInt("gen_ai.usage.output_tokens", message.usage.output));
+			attributes.push(attrInt("pi.usage.cache_read_tokens", message.usage.cacheRead));
+			attributes.push(attrInt("pi.usage.cache_write_tokens", message.usage.cacheWrite));
+		}
+		return attributes;
+	}
+
+	private startSpan(
+		name: string,
+		kind: number,
+		parentSpanId: string | undefined,
+		startAttributes: Attribute[],
+		startTime?: bigint,
+	): OpenSpan {
+		const parentStart = parentSpanId ? this.findOpenSpan(parentSpanId)?.startTimeUnixNano : undefined;
+		const start = startTime ?? this.writer.nextTime(parentStart);
+		const span: OpenSpan = {
+			name,
+			kind,
+			spanId: newSpanId(),
+			parentSpanId,
+			startTimeUnixNano: start,
+			startAttributes,
+		};
+		this.writer.writeSpan(this.toOtlp(span, [...startAttributes, attrString("pi.span.phase", "start")]));
+		return span;
+	}
+
+	private findOpenSpan(spanId: string): OpenSpan | undefined {
+		if (this.run?.spanId === spanId) return this.run;
+		if (this.turn?.spanId === spanId) return this.turn;
+		if (this.chat?.spanId === spanId) return this.chat;
+		if (this.compaction?.spanId === spanId) return this.compaction;
+		for (const span of this.tools.values()) {
+			if (span.spanId === spanId) return span;
+		}
+		return undefined;
+	}
+
+	private endSpan(span: OpenSpan, endTime: bigint, extraAttributes: Attribute[], status: OtlpStatus): void {
+		this.writer.writeSpan(this.toOtlp(span, [...span.startAttributes, ...extraAttributes], endTime, status));
+	}
+
+	private writePendingEnd(pending: PendingEnd, entryId: string | undefined): void {
+		const extra = [...pending.attributes];
+		if (entryId) extra.push(attrString("pi.session.entry_id", entryId));
+		this.endSpan(pending.span, pending.endTime, extra, pending.status);
+	}
+
+	private endRun(extraAttributes: Attribute[] | undefined, status: OtlpStatus): void {
+		if (!this.run) return;
+		this.endSpan(this.run, this.writer.endTime(this.run.startTimeUnixNano), extraAttributes ?? [], status);
+		this.run = undefined;
+	}
+
+	private closeTurn(ctx: ExtensionContext | undefined, status: OtlpStatus): void {
+		if (ctx) this.flushPending(ctx, true);
+		for (const [toolCallId, span] of [...this.tools]) {
+			this.endSpan(span, this.writer.endTime(span.startTimeUnixNano), [], status);
+			this.tools.delete(toolCallId);
+			this.activeToolSpans.delete(toolCallId);
+		}
+		this.refreshToolEnv();
+		if (this.chat) {
+			this.endSpan(this.chat, this.writer.endTime(this.chat.startTimeUnixNano), [], status);
+			this.chat = undefined;
+		}
+		if (!this.turn) return;
+		const attributes: Attribute[] = [attrInt("pi.turn.tool_call_count", this.turnToolCallCount)];
+		if (this.turnStopReason) attributes.push(attrString("pi.turn.stop_reason", this.turnStopReason));
+		this.endSpan(this.turn, this.writer.endTime(this.turn.startTimeUnixNano), attributes, status);
+		this.turn = undefined;
+	}
+
+	private lookupEntryId(ctx: ExtensionContext, lookup: EntryLookup | undefined): string | undefined {
+		if (!lookup) return undefined;
+		let branch: SessionEntry[];
+		try {
+			branch = ctx.sessionManager.getBranch();
+		} catch {
+			return undefined;
+		}
+		for (let i = 0; i < branch.length; i++) {
+			const entry = branch[i];
+			if (this.usedEntryIds.has(entry.id)) continue;
+			if (lookup.kind === "assistant") {
+				if (
+					entry.type === "message" &&
+					entry.message.role === "assistant" &&
+					entry.message.timestamp === lookup.timestamp &&
+					sameContent(entry.message.content, lookup.content)
+				) {
+					this.usedEntryIds.add(entry.id);
+					return entry.id;
+				}
+			} else if (lookup.kind === "user") {
+				if (
+					entry.type === "message" &&
+					entry.message.role === "user" &&
+					entry.message.timestamp === lookup.timestamp &&
+					sameContent(entry.message.content, lookup.content)
+				) {
+					this.usedEntryIds.add(entry.id);
+					return entry.id;
+				}
+			} else if (lookup.kind === "toolResult") {
+				if (
+					entry.type === "message" &&
+					entry.message.role === "toolResult" &&
+					entry.message.toolCallId === lookup.toolCallId
+				) {
+					this.usedEntryIds.add(entry.id);
+					return entry.id;
+				}
+			} else if (lookup.kind === "custom") {
+				if (
+					entry.type === "custom_message" &&
+					entry.customType === lookup.customType &&
+					sameContent(entry.content, lookup.content)
+				) {
+					this.usedEntryIds.add(entry.id);
+					return entry.id;
+				}
+			}
+		}
+		return undefined;
+	}
+
+	private toOtlp(span: OpenSpan, attributes: Attribute[], endTime?: bigint, status?: OtlpStatus): OtlpSpan {
+		const unique = new Map<string, Attribute>();
+		for (const attribute of attributes) unique.set(attribute.key, attribute);
+		const otlp: OtlpSpan = {
+			traceId: this.traceId,
+			spanId: span.spanId,
+			name: span.name,
+			kind: span.kind,
+			startTimeUnixNano: span.startTimeUnixNano.toString(),
+			attributes: [...unique.values()],
+		};
+		if (span.parentSpanId) otlp.parentSpanId = span.parentSpanId;
+		if (endTime !== undefined) otlp.endTimeUnixNano = endTime.toString();
+		if (status) otlp.status = status;
+		return otlp;
+	}
+
+	private refreshToolEnv(): void {
+		if (this.activeToolSpans.size === 0) {
+			restoreEnvVar(ENV_TRACE_ID, this.inheritedTraceId);
+			restoreEnvVar(ENV_PARENT_SPAN_ID, this.inheritedParentSpanId);
+			return;
+		}
+		let parentSpanId: string | undefined;
+		for (const spanId of this.activeToolSpans.values()) parentSpanId = spanId;
+		if (!parentSpanId) return;
+		process.env[ENV_TRACE_ID] = this.traceId;
+		process.env[ENV_PARENT_SPAN_ID] = parentSpanId;
+	}
+}
+
+export default function agentTrace(pi: ExtensionAPI): void {
+	const inheritedTraceId = snapshotEnv(ENV_TRACE_ID);
+	const inheritedParentSpanId = snapshotEnv(ENV_PARENT_SPAN_ID);
+	let tracer: Tracer | undefined;
+
+	const safe = (fn: (event: any, ctx: ExtensionContext) => void) => {
+		return (event: any, ctx: ExtensionContext) => {
+			try {
+				fn(event, ctx);
+			} catch {
+				// Tracing must never surface to the agent.
+			}
+		};
+	};
+
+	const ensure = (ctx: ExtensionContext): Tracer | undefined => {
+		try {
+			const sessionId = ctx.sessionManager.getSessionId();
+			if (tracer && tracer.sessionId === sessionId) return tracer;
+			if (tracer) {
+				try {
+					tracer.onShutdown(ctx);
+				} catch {
+					// ignore
+				}
+			}
+			const sessionDir = ctx.sessionManager.getSessionDir();
+			const filePath = resolveTracePath(sessionDir, sessionId);
+			const traceId =
+				inheritedTraceId && /^[0-9a-f]{32}$/i.test(inheritedTraceId)
+					? inheritedTraceId.toLowerCase()
+					: traceIdFromSessionId(sessionId);
+			const rootParentSpanId =
+				inheritedParentSpanId && /^[0-9a-f]{16}$/i.test(inheritedParentSpanId)
+					? inheritedParentSpanId.toLowerCase()
+					: undefined;
+			const writer = new TraceWriter(pi, filePath, [
+				attrString("service.name", "pi"),
+				attrString("service.version", VERSION),
+				attrString("pi.session.id", sessionId),
+				attrInt("process.pid", process.pid),
+			]);
+			tracer = new Tracer({
+				writer,
+				sessionId,
+				traceId,
+				rootParentSpanId,
+				inheritedTraceId,
+				inheritedParentSpanId,
+			});
+			return tracer;
+		} catch {
+			return undefined;
+		}
+	};
+
+	pi.on(
+		"session_start",
+		safe((_event, ctx) => {
+			ensure(ctx);
+			if (pendingWriteFailurePath && !writeFailureReported) {
+				reportWriteFailure(pi, pendingWriteFailurePath);
+			}
+		}),
+	);
+
+	pi.on(
+		"before_agent_start",
+		safe((_event, ctx) => {
+			const current = ensure(ctx);
+			if (current) current.pendingPrompt = true;
+		}),
+	);
+
+	pi.on(
+		"input",
+		safe((event, ctx) => {
+			if (event.streamingBehavior) return;
+			const current = ensure(ctx);
+			if (current) current.pendingPrompt = true;
+		}),
+	);
+
+	pi.on(
+		"agent_start",
+		safe((_event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx);
+			current.onAgentStart();
+		}),
+	);
+
+	pi.on(
+		"agent_end",
+		safe((_event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.onAgentEnd(ctx);
+		}),
+	);
+
+	pi.on(
+		"agent_settled",
+		safe((_event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx, true);
+			current.onAgentSettled();
+		}),
+	);
+
+	pi.on(
+		"turn_start",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx);
+			current.onTurnStart(event);
+		}),
+	);
+
+	pi.on(
+		"turn_end",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.onTurnEnd(ctx, event);
+		}),
+	);
+
+	pi.on(
+		"message_start",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx);
+			current.onMessageStart(event.message);
+		}),
+	);
+
+	pi.on(
+		"message_end",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.onMessageEnd(event.message);
+		}),
+	);
+
+	pi.on(
+		"tool_execution_start",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx);
+			current.onToolStart(event);
+		}),
+	);
+
+	pi.on(
+		"tool_execution_end",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx);
+			current.onToolEnd(event);
+		}),
+	);
+
+	pi.on(
+		"session_before_compact",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx, true);
+			current.onCompactStart({ reason: event.reason, willRetry: event.willRetry });
+		}),
+	);
+
+	pi.on(
+		"session_compact",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx, true);
+			current.onCompactSuccess(event);
+		}),
+	);
+
+	pi.on(
+		"session_compact_failed",
+		safe((event, ctx) => {
+			const current = ensure(ctx);
+			if (!current) return;
+			current.flushPending(ctx, true);
+			current.onCompactFailed(event);
+		}),
+	);
+
+	pi.on(
+		"session_shutdown",
+		safe((_event, ctx) => {
+			const current = tracer ?? ensure(ctx);
+			if (!current) return;
+			current.onShutdown(ctx);
+			tracer = undefined;
+		}),
+	);
+}
