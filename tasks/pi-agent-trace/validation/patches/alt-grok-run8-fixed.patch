+	function tempDir(): string {
+		const dir = mkdtempSync(join(tmpdir(), "pi-agent-trace-"));
+		dirs.push(dir);
+		return dir;
+	}
+
+	function setup(
+		options: {
+			sessionId?: string;
+			sessionDir?: string;
+			inherited?: { traceId?: string; parentSpanId?: string };
+		} = {},
+	) {
+		const dir = options.sessionDir ?? tempDir();
+		const sessionId = options.sessionId ?? "0123456789abcdef0123456789abcdef";
+		const filePath = join(dir, `${sessionId}.otlp.jsonl`);
+		process.env[ENV_TRACE_FILE] = filePath;
+		if (options.inherited?.traceId) process.env[ENV_TRACE_ID] = options.inherited.traceId;
+		else delete process.env[ENV_TRACE_ID];
+		if (options.inherited?.parentSpanId) process.env[ENV_PARENT_SPAN_ID] = options.inherited.parentSpanId;
+		else delete process.env[ENV_PARENT_SPAN_ID];
+
+		const handlers = new Map<string, (event: any, ctx: ExtensionContext) => unknown>();
+		const sendMessage = vi.fn();
+		const branch: SessionEntry[] = [];
+		let nextEntryId = 1;
+
+		const api = {
+			on(event: string, handler: (event: any, ctx: ExtensionContext) => unknown) {
+				handlers.set(event, handler);
+			},
+			sendMessage,
+		} as unknown as ExtensionAPI;
+
+		agentTrace(api);
+
+		const ctx = {
+			mode: "print",
+			hasUI: false,
+			ui: { notify: vi.fn() },
+			cwd: dir,
+			sessionManager: {
+				getSessionDir: () => dir,
+				getSessionId: () => sessionId,
+				getBranch: () => branch,
+			},
+			modelRegistry: {},
+			model: undefined,
+			scopedModels: [],
+			isIdle: () => true,
+			isProjectTrusted: () => true,
+			signal: undefined,
+			abort: vi.fn(),
+			hasPendingMessages: () => false,
+			shutdown: vi.fn(),
+			getContextUsage: () => undefined,
+			compact: vi.fn(),
+			getSystemPrompt: () => "",
+		} as unknown as ExtensionContext;
+
+		async function emit(type: string, event: Record<string, unknown> = {}): Promise<void> {
+			const handler = handlers.get(type);
+			if (!handler) throw new Error(`missing handler ${type}`);
+			await handler({ type, ...event }, ctx);
+		}
+
+		function persistMessage(message: AgentMessage): string {
+			const id = `e${nextEntryId++}`;
+			branch.push({
+				type: "message",
+				id,
+				parentId: null,
+				timestamp: new Date().toISOString(),
+				message,
+			});
+			return id;
+		}
+
+		function persistCustom(customType: string, content: string): string {
+			const id = `e${nextEntryId++}`;
+			branch.push({
+				type: "custom_message",
+				id,
+				parentId: null,
+				timestamp: new Date().toISOString(),
+				customType,
+				content,
+				display: true,
+			});
+			return id;
+		}
+
+		function persistCompaction(overrides: Partial<Extract<SessionEntry, { type: "compaction" }>> = {}) {
+			const id = overrides.id ?? `e${nextEntryId++}`;
+			const entry = {
+				type: "compaction" as const,
+				id,
+				parentId: null,
+				timestamp: new Date().toISOString(),
+				summary: "summary",
+				firstKeptEntryId: "e1",
+				tokensBefore: 1000,
+				usage: { input: 8, output: 4, cacheRead: 0, cacheWrite: 0, totalTokens: 12, cost: usage().cost },
+				...overrides,
+			};
+			branch.push(entry);
+			return entry;
+		}
+
+		return {
+			api,
+			ctx,
+			emit,
+			persistMessage,
+			persistCustom,
+			persistCompaction,
+			branch,
+			filePath,
+			sessionId,
+			sendMessage,
+			dir,
+		};
+	}
+
+	async function runPrompt(world: ReturnType<typeof setup>, text = "hello") {
+		const userMessage = user(text);
+		await world.emit("before_agent_start", {
+			prompt: text,
+			systemPrompt: "",
+			systemPromptOptions: { cwd: world.dir },
+		});
+		await world.emit("agent_start");
+		await world.emit("turn_start", { turnIndex: 0, timestamp: Date.now() });
+		await world.emit("message_start", { message: userMessage });
+		await world.emit("message_end", { message: userMessage });
+		const userId = world.persistMessage(userMessage);
+		const assistantMessage = assistant();
+		await world.emit("message_start", { message: assistantMessage });
+		await world.emit("message_end", { message: assistantMessage });
+		const assistantId = world.persistMessage(assistantMessage);
+		await world.emit("turn_end", { turnIndex: 0, message: assistantMessage, toolResults: [] });
+		await world.emit("agent_end", { messages: [userMessage, assistantMessage] });
+		await world.emit("agent_settled");
+		return { userMessage, assistantMessage, userId, assistantId };
+	}
