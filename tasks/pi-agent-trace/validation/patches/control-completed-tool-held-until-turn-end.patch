+/**
+ * Agent Trace Extension
+ *
+ * Exports the agent loop as an OpenTelemetry trace: one span per run, turn,
+ * provider request (`chat <model>`), tool execution and compaction, written
+ * as OTLP/JSON lines to `<sessionDir>/traces/<sessionId>.otlp.jsonl` (or
+ * `PI_AGENT_TRACE_FILE`). Every line is a complete ExportTraceServiceRequest
+ * holding one span, so a collector or any OTLP-aware viewer can load the file.
+ *
+ * Every span is written twice so the file updates live: a start line (no end
+ * time, no status, attribute pi.span.phase = "start") at the event that starts
+ * it, and an end line as soon as its attributes are known. Readers that
+ * de-duplicate by spanId, last line wins, hold the current state.
+ * End lines are written in end-time order as soon as their attributes are known.
+ * pi persists a message after extensions have seen its `message_end`, so the
+ * chat span (which carries the assistant entry id) is written at the first
+ * `tool_execution_start` of its turn, or at `turn_end` when the turn calls no
+ * tool; tool spans and the turn are written at `turn_end`; the run at
+ * `agent_end`. A crash therefore loses only spans whose entries pi had not
+ * persisted. On `session_shutdown` every open span is closed with status
+ * ERROR "shutdown". A write failure never reaches the agent: it is reported
+ * once per process as an `agent-trace` custom message.
+ */
+
+import { createHash, randomBytes } from "node:crypto";
+import { appendFileSync, mkdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { type ExtensionAPI, type ExtensionContext, type SessionEntry, VERSION } from "@earendil-works/pi-coding-agent";
+
+type ReadonlySessionManager = ExtensionContext["sessionManager"];
+type AgentMessage = Extract<SessionEntry, { type: "message" }>["message"];
+type AssistantMessage = Extract<AgentMessage, { role: "assistant" }>;
+
+export const SCOPE_NAME = "pi.agent-trace";
+/** Cross-process context propagation: `<traceId>-<spanId>` of the tool that spawned this pi process. */
+export const TRACE_PARENT_ENV = "PI_AGENT_TRACE_PARENT";
+export const SCOPE_VERSION = "1";
+const KIND_INTERNAL = 1;
+const KIND_CLIENT = 3;
+const STATUS_OK = 1;
+const STATUS_ERROR = 2;
+
+// Reload re-instantiates extensions, but a write failure is reported only once
+// during this Node process. A symbol slot survives module reloads without using
+// environment variables or touching Pi core.
+interface TraceProcessState { writeFailureReported: boolean }
+const PROCESS_STATE_KEY = Symbol.for("pi.agent-trace.write-failure-state.v1");
+const processStates = globalThis as unknown as Record<symbol, TraceProcessState | undefined>;
+const traceProcessState = processStates[PROCESS_STATE_KEY] ??= { writeFailureReported: false };
+
+// ---------------------------------------------------------------------------
+// OTLP/JSON encoding
+// ---------------------------------------------------------------------------
+
+type AttributeValue = string | number | boolean | string[];
+
+interface Span {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Map<string, AttributeValue>;
+	status: { code: number; message?: string };
+}
+
+function encodeValue(value: AttributeValue): Record<string, unknown> {
+	if (typeof value === "string") return { stringValue: value };
+	if (typeof value === "boolean") return { boolValue: value };
+	if (typeof value === "number") return { intValue: String(Math.trunc(value)) };
+	return { arrayValue: { values: value.map((item) => ({ stringValue: item })) } };
+}
+
+function encodeAttributes(attributes: Map<string, AttributeValue>): Array<{ key: string; value: unknown }> {
+	return [...attributes.entries()].map(([key, value]) => ({ key, value: encodeValue(value) }));
+}
+
+export function nanos(millis: number): string {
+	return `${Math.trunc(millis)}000000`;
+}
+
+/** The trace id of a session: 16 bytes derived from the session id, so every process of the session shares it. */
+export function traceIdFor(sessionId: string): string {
+	return createHash("sha256").update(`${SCOPE_NAME}:${sessionId}`).digest("hex").slice(0, 32);
+}
+
+function newSpanId(): string {
+	return randomBytes(8).toString("hex");
+}
+
+function traceFile(sessionManager: ReadonlySessionManager): string {
+	const override = process.env.PI_AGENT_TRACE_FILE;
+	if (override) return override;
+	return join(sessionManager.getSessionDir(), "traces", `${sessionManager.getSessionId()}.otlp.jsonl`);
+}
+
+// ---------------------------------------------------------------------------
+// Entry resolution: the branch after turn_end holds the turn's messages
+// ---------------------------------------------------------------------------
+
+function lastAssistantEntryIndex(branch: SessionEntry[]): number {
+	for (let i = branch.length - 1; i >= 0; i--) {
+		const entry = branch[i];
+		if (entry.type === "message" && entry.message.role === "assistant") return i;
+	}
+	return -1;
+}
+
+function toolResultEntryId(branch: SessionEntry[], from: number, toolCallId: string): string | undefined {
+	for (let i = from + 1; i < branch.length; i++) {
+		const entry = branch[i];
+		if (entry.type === "message" && entry.message.role === "toolResult" && entry.message.toolCallId === toolCallId) {
+			return entry.id;
+		}
+	}
+	return undefined;
+}
+
+function runEntryId(branch: SessionEntry[], before: number, role: "user" | "custom"): string | undefined {
+	for (let i = before - 1; i >= 0; i--) {
+		const entry = branch[i];
+		if (role === "user") {
+			if (entry.type === "message" && entry.message.role === "user") return entry.id;
+		} else if (entry.type === "custom_message") {
+			return entry.id;
+		}
+	}
+	return undefined;
+}
+
+// ---------------------------------------------------------------------------
+// Extension
+// ---------------------------------------------------------------------------
+
+export default function (pi: ExtensionAPI) {
+	let traceId: string | undefined;
+	let file: string | undefined;
+	let resourceAttributes: Map<string, AttributeValue> | undefined;
+	/** The span every root span of this session hangs under when a parent pi spawned this process. */
+	let rootParentSpanId: string | undefined;
+	/** Inherited once; child context is returned in copied environments, never published process-wide. */
+	const inheritedTraceParent = process.env[TRACE_PARENT_ENV];
+
+	/** Bind to the session lazily: a reloaded runtime may see its first event without a session_start. */
+	function bind(sessionManager: ReadonlySessionManager) {
+		if (traceId && resourceAttributes?.get("pi.session.id") === sessionManager.getSessionId()) return;
+		const parent = inheritedTraceParent?.match(/^([0-9a-f]{32})-([0-9a-f]{16})$/);
+		traceId = parent ? parent[1] : traceIdFor(sessionManager.getSessionId());
+		rootParentSpanId = parent ? parent[2] : undefined;
+		file = traceFile(sessionManager);
+		resourceAttributes = new Map<string, AttributeValue>([
+			["service.name", "pi"],
+			["service.version", VERSION],
+			["pi.session.id", sessionManager.getSessionId()],
+			["process.pid", process.pid],
+		]);
+	}
+
+	function start(
+		name: string,
+		kind: number,
+		parent: Span | undefined,
+		startMillis: number,
+		known: Array<[string, AttributeValue]> = [],
+	): Span {
+		if (!traceId) throw new Error("agent-trace: span started before the session was bound");
+		const span: Span = {
+			traceId,
+			spanId: newSpanId(),
+			parentSpanId: parent?.spanId ?? rootParentSpanId,
+			name,
+			kind,
+			startTimeUnixNano: nanos(startMillis),
+			attributes: new Map(known),
+			status: { code: STATUS_OK },
+		};
+		write(span, "start");
+		return span;
+	}
+
+	function end(span: Span, endMillis = Date.now()): Span {
+		if (!span.endTimeUnixNano) span.endTimeUnixNano = nanos(endMillis);
+		return span;
+	}
+
+	function fail(span: Span, message: string) {
+		span.status = { code: STATUS_ERROR, message };
+	}
+
+
+	function write(span: Span, phase: "start" | "end" = "end") {
+		if (!file || !resourceAttributes) return;
+		try {
+			writeLine(span, phase);
+		} catch (error) {
+			if (traceProcessState.writeFailureReported) return;
+			traceProcessState.writeFailureReported = true;
+			const reason = error instanceof Error ? error.message : String(error);
+			pi.sendMessage(
+				{ customType: "agent-trace", content: `agent-trace: cannot write ${file}: ${reason}`, display: true },
+				{ triggerTurn: false },
+			);
+		}
+	}
+
+	function writeLine(span: Span, phase: "start" | "end") {
+		if (!file || !resourceAttributes) return;
+		const attributes = new Map(span.attributes);
+		if (phase === "start") attributes.set("pi.span.phase", "start");
+		const encoded: Record<string, unknown> = {
+			traceId: span.traceId,
+			spanId: span.spanId,
+			name: span.name,
+			kind: span.kind,
+			startTimeUnixNano: span.startTimeUnixNano,
+			attributes: encodeAttributes(attributes),
+		};
+		if (phase === "end") {
+			encoded.endTimeUnixNano = span.endTimeUnixNano ?? span.startTimeUnixNano;
+			encoded.status = span.status;
+		}
+		if (span.parentSpanId) encoded.parentSpanId = span.parentSpanId;
+		const line = {
+			resourceSpans: [
+				{
+					resource: { attributes: encodeAttributes(resourceAttributes) },
+					scopeSpans: [{ scope: { name: SCOPE_NAME, version: SCOPE_VERSION }, spans: [encoded] }],
+				},
+			],
+		};
+		mkdirSync(dirname(file), { recursive: true });
+		appendFileSync(file, `${JSON.stringify(line)}\n`);
+	}
+
+	// ----- run state ---------------------------------------------------------
+
+	let run: Span | undefined;
+	let runTrigger = "wakeup";
+	let runEntryResolved = false;
+	let turnCount = 0;
+	/** The run's first user/custom message is its trigger; later ones are steering or follow-up messages. */
+	let runMessagesSeen = 0;
+	let runEntryRole: "user" | "custom" = "custom";
+	let steerThisTurn = 0;
+	let steerEntryIds: string[] = [];
+	let previousAssistantIndex = -1;
+	let sawBeforeAgentStart = false;
+	let previousRunSettled = true;
+
+	let turn: Span | undefined;
+	let chat: Span | undefined;
+	let chatMessage: AssistantMessage | undefined;
+	let turnChats: Span[] = [];
+	const tools = new Map<string, Span>();
+	let turnTools: Array<{ span: Span; toolCallId: string }> = [];
+
+	let compaction: Span | undefined;
+	/** Set by an overflow compaction that pi retries: the next run is that retry and has no message of its own. */
+	let retryAfterCompaction: string | undefined;
+	// Public extension-to-extension integration. Each request names its own
+	// active tool call, so an overlapping sibling cannot replace its context.
+	// EventBus invokes handlers synchronously; reply does not cross an await.
+	pi.events.on("agent-trace:child-env", (data: unknown) => {
+		const request = data as {
+			toolCallId?: unknown;
+			env?: NodeJS.ProcessEnv;
+			reply?: (env: NodeJS.ProcessEnv | undefined) => void;
+		} | undefined;
+		if (!request || typeof request.reply !== "function") return;
+		const span = typeof request.toolCallId === "string" ? tools.get(request.toolCallId) : undefined;
+		request.reply(span ? {
+			...(request.env ?? process.env),
+			[TRACE_PARENT_ENV]: `${span.traceId}-${span.spanId}`,
+		} : undefined);
+	});
+
+	pi.on("session_start", async (_event, ctx) => {
+		bind(ctx.sessionManager);
+	});
+
+	pi.on("before_agent_start", async () => {
+		sawBeforeAgentStart = true;
+	});
+
+	pi.on("agent_start", async (_event, ctx) => {
+		bind(ctx.sessionManager);
+		const now = Date.now();
+		// A fresh prompt may follow an idle pre-prompt compaction whose willRetry
+		// flag describes the old response. That new prompt is not a retry run.
+		runTrigger = !previousRunSettled ? "continuation" : sawBeforeAgentStart ? "prompt" : retryAfterCompaction ? "continuation" : "wakeup";
+		const isOverflowRetry = runTrigger === "continuation" && retryAfterCompaction !== undefined;
+		runEntryRole = runTrigger === "prompt" ? "user" : "custom";
+		sawBeforeAgentStart = false;
+		previousRunSettled = false;
+		const known: Array<[string, AttributeValue]> = [["pi.run.trigger", runTrigger]];
+		if (isOverflowRetry) known.push(["pi.run.after_compaction", retryAfterCompaction!]);
+		run = start("pi.run", KIND_INTERNAL, undefined, now, known);
+		// An overflow retry resumes the existing context: no message of its own, no entry id.
+		runEntryResolved = isOverflowRetry;
+		retryAfterCompaction = undefined;
+		turnCount = 0;
+		runMessagesSeen = 0;
+		steerThisTurn = 0;
+		steerEntryIds = [];
+		previousAssistantIndex = -1;
+	});
+
+	pi.on("agent_settled", async () => {
+		previousRunSettled = true;
+	});
+
+	pi.on("turn_start", async (event) => {
+		turn = start("pi.turn", KIND_INTERNAL, run, event.timestamp, [["pi.turn.index", event.turnIndex]]);
+		turnChats = [];
+		turnTools = [];
+		chatMessage = undefined;
+		tools.clear();
+	});
+
+	pi.on("message_start", async (event) => {
+		if (event.message.role === "user" || event.message.role === "custom") {
+			// Messages the agent loop consumes: the first one of a run is its trigger, later ones steer it.
+			if (run) {
+				runMessagesSeen += 1;
+				if (runMessagesSeen === 1) runEntryRole = event.message.role;
+				if (runMessagesSeen > 1) steerThisTurn += 1;
+			}
+			return;
+		}
+		if (event.message.role !== "assistant") return;
+		chat = start(`chat ${event.message.model}`, KIND_CLIENT, turn, Date.now(), [
+			["gen_ai.operation.name", "chat"],
+			["gen_ai.system", event.message.provider],
+			["gen_ai.request.model", event.message.model],
+		]);
+		chatMessage = event.message;
+	});
+
+	/** Write ended chat spans once pi has persisted their assistant entry (the last assistant entry on the branch). */
+	function flushChats(ctx: ExtensionContext) {
+		if (turnChats.length === 0) return;
+		const branch = ctx.sessionManager.getBranch();
+		const assistantIndex = lastAssistantEntryIndex(branch);
+		for (const span of turnChats) {
+			if (assistantIndex >= 0) span.attributes.set("pi.session.entry_id", branch[assistantIndex].id);
+			write(span);
+		}
+		turnChats = [];
+	}
+
+	pi.on("message_end", async (event) => {
+		if (event.message.role !== "assistant" || !chat) return;
+		const message = event.message;
+		const usage = message.usage;
+		chat.name = `chat ${message.model}`;
+		chat.attributes.set("gen_ai.operation.name", "chat");
+		chat.attributes.set("gen_ai.system", message.provider);
+		chat.attributes.set("gen_ai.request.model", message.model);
+		chat.attributes.set("gen_ai.usage.input_tokens", usage.input);
+		chat.attributes.set("gen_ai.usage.output_tokens", usage.output);
+		chat.attributes.set("pi.usage.cache_read_tokens", usage.cacheRead);
+		chat.attributes.set("pi.usage.cache_write_tokens", usage.cacheWrite);
+		chat.attributes.set("gen_ai.response.finish_reasons", [message.stopReason]);
+		if (message.stopReason === "error") fail(chat, message.errorMessage ?? "aborted");
+		else if (message.stopReason === "aborted") fail(chat, message.errorMessage ?? "aborted");
+		end(chat);
+		turnChats.push(chat);
+		chatMessage = message;
+		// These facts are known before tools finish and turn_end is emitted.
+		// Retain them if quit interrupts the tool phase of this turn.
+		if (turn) {
+			turn.attributes.set("pi.turn.stop_reason", message.stopReason);
+			turn.attributes.set("pi.turn.tool_call_count", message.content.filter((part) => part.type === "toolCall").length);
+		}
+		chat = undefined;
+	});
+
+	pi.on("tool_execution_start", async (event, ctx) => {
+		flushChats(ctx);
+		const span = start(`execute_tool ${event.toolName}`, KIND_INTERNAL, turn, Date.now(), [
+			["gen_ai.operation.name", "execute_tool"],
+			["gen_ai.tool.name", event.toolName],
+			["gen_ai.tool.call.id", event.toolCallId],
+		]);
+		tools.set(event.toolCallId, span);
+	});
+
+	pi.on("tool_execution_end", async (event) => {
+		const span = tools.get(event.toolCallId);
+		if (!span) return;
+		tools.delete(event.toolCallId);
+		span.attributes.set("pi.tool.is_error", event.isError);
+		if (event.isError) fail(span, resultText(event.result));
+		end(span);
+		turnTools.push({ span, toolCallId: event.toolCallId });
+	});
+
+	pi.on("turn_end", async (event, ctx) => {
+		if (!turn) return;
+		const branch = ctx.sessionManager.getBranch();
+		const assistantIndex = lastAssistantEntryIndex(branch);
+		const assistantEntry = assistantIndex >= 0 ? branch[assistantIndex] : undefined;
+		const message = event.message.role === "assistant" ? event.message : chatMessage;
+		const chatFailed = turnChats.some((span) => span.status.code === STATUS_ERROR);
+
+		flushChats(ctx);
+		for (const { span, toolCallId } of turnTools) {
+			const entryId = toolResultEntryId(branch, assistantIndex, toolCallId);
+			if (entryId) span.attributes.set("pi.session.entry_id", entryId);
+			write(span);
+		}
+
+		if (steerThisTurn > 0 && assistantIndex >= 0) {
+			// The steering messages of this turn are the last ones between the previous assistant entry and this one
+			// (context-only custom messages pi flushed at the previous turn_end come before them).
+			const candidates: string[] = [];
+			for (let i = previousAssistantIndex + 1; i < assistantIndex; i++) {
+				const entry = branch[i];
+				if ((entry.type === "message" && entry.message.role === "user") || entry.type === "custom_message") {
+					candidates.push(entry.id);
+				}
+			}
+			steerEntryIds.push(...candidates.slice(-steerThisTurn));
+		}
+		steerThisTurn = 0;
+		previousAssistantIndex = assistantIndex;
+
+		turn.attributes.set("pi.turn.stop_reason", message?.stopReason ?? "unknown");
+		turn.attributes.set("pi.turn.tool_call_count", turnTools.length);
+		if (chatFailed || message?.stopReason === "error" || message?.stopReason === "aborted") {
+			fail(turn, message?.errorMessage ?? "aborted");
+		}
+		write(end(turn));
+		turnCount += 1;
+
+		if (run && !runEntryResolved && assistantIndex >= 0) {
+			const entryId = runEntryId(branch, assistantIndex, runEntryRole);
+			if (entryId) run.attributes.set("pi.session.entry_id", entryId);
+			runEntryResolved = true;
+		}
+		turn = undefined;
+		turnChats = [];
+		turnTools = [];
+	});
+
+	pi.on("agent_end", async () => {
+		if (!run) return;
+		run.attributes.set("pi.run.turn_count", turnCount);
+		run.attributes.set("pi.run.steer_count", steerEntryIds.length);
+		run.attributes.set("pi.run.steer_entry_ids", [...steerEntryIds]);
+		write(end(run));
+		run = undefined;
+	});
+
+	pi.on("session_before_compact", async (event, ctx) => {
+		bind(ctx.sessionManager);
+		compaction = start("pi.compaction", KIND_INTERNAL, undefined, Date.now(), [
+			["pi.compaction.reason", event.reason],
+			["pi.compaction.will_retry", event.willRetry],
+		]);
+	});
+
+	pi.on("session_compact", async (event) => {
+		if (!compaction) return;
+		compaction.attributes.set("pi.compaction.tokens_before", event.compactionEntry.tokensBefore);
+		compaction.attributes.set("pi.compaction.first_kept_entry_id", event.compactionEntry.firstKeptEntryId);
+		const usage = event.compactionEntry.usage;
+		if (usage) {
+			compaction.attributes.set("gen_ai.usage.input_tokens", usage.input);
+			compaction.attributes.set("gen_ai.usage.output_tokens", usage.output);
+		}
+		compaction.attributes.set("pi.session.entry_id", event.compactionEntry.id);
+		write(end(compaction));
+		compaction = undefined;
+		if (event.willRetry) retryAfterCompaction = event.compactionEntry.id;
+	});
+
+	pi.on("session_compact_failed", async (event) => {
+		if (!compaction) return;
+		fail(compaction, event.errorMessage ?? "aborted");
+		write(end(compaction));
+		compaction = undefined;
+	});
+
+	// pi's quit path can shut the runtime down while a run is still streaming:
+	// close whatever is open so the trace ends with an explicit reason.
+	pi.on("session_shutdown", async (_event, ctx) => {
+		const now = Date.now();
+		if (run && !runEntryResolved) {
+			const branch = ctx.sessionManager.getBranch();
+			const entryId = runEntryId(branch, branch.length, runEntryRole);
+			if (entryId) run.attributes.set("pi.session.entry_id", entryId);
+			runEntryResolved = true;
+		}
+		const closing: Span[] = [];
+		if (chat) closing.push(chat);
+		closing.push(...turnChats);
+		for (const span of tools.values()) closing.push(span);
+		closing.push(...turnTools.map((t) => t.span));
+		if (turn) closing.push(turn);
+		if (compaction) closing.push(compaction);
+		if (run) {
+			run.attributes.set("pi.run.turn_count", turnCount + (turn ? 1 : 0));
+			run.attributes.set("pi.run.steer_count", steerEntryIds.length);
+			run.attributes.set("pi.run.steer_entry_ids", [...steerEntryIds]);
+			closing.push(run);
+		}
+		for (const span of closing) end(span, now);
+		// Ended spans can still be waiting for their session entry. Write those
+		// before later shutdown closes; stable ties retain the child-first order.
+		closing.sort((a, b) => {
+			const left = BigInt(a.endTimeUnixNano!);
+			const right = BigInt(b.endTimeUnixNano!);
+			return left < right ? -1 : left > right ? 1 : 0;
+		});
+		for (const span of closing) {
+			fail(span, "shutdown");
+			write(span);
+		}
+		chat = undefined;
+		turnChats = [];
+		tools.clear();
+		turnTools = [];
+		turn = undefined;
+		compaction = undefined;
+		run = undefined;
+	});
+}
+
+function resultText(result: unknown): string {
+	const content = (result as { content?: unknown })?.content;
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "error";
+	return content
+		.flatMap((block) => (block && typeof block === "object" && "text" in block ? [String(block.text)] : []))
+		.join("\n");
+}
diff --git a/packages/coding-agent/test/agent-trace-extension.test.ts b/packages/coding-agent/test/agent-trace-extension.test.ts
