+it("reports an unwritable trace only once across reload in the same process", () => {
+	const root = mkdtempSync(join(tmpdir(), "pi-trace-process-failure-"));
+	const blocker = join(root, "not-a-directory");
+	writeFileSync(blocker, "blocked");
+	try {
+		// A dedicated process gives this test a fresh process lifetime without
+		// reading or resetting any implementation-specific singleton.
+		const result = spawnSync(process.execPath, ["--input-type=module", "-e", String.raw`
+import assert from "node:assert/strict";
+import { join } from "node:path";
+import { fauxAssistantMessage, fauxProvider, fauxText, fauxToolCall } from "@earendil-works/pi-ai/providers/faux";
+import { createAgentSession, DefaultResourceLoader, SessionManager, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+const root = process.env.TRACE_TEST_ROOT;
+const cwd = join(root, "project");
+const agentDir = join(root, "agent");
+const settingsManager = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+const faux = fauxProvider({ provider: "write-failure-test", api: "write-failure-api", models: [{ id: "test-model", contextWindow: 200000, maxTokens: 8192 }] });
+let toolCalls = 0;
+const loader = new DefaultResourceLoader({
+  cwd, agentDir, settingsManager,
+  additionalExtensionPaths: [process.env.TRACE_TEST_EXTENSION],
+  extensionFactories: [{ name: "offline-process-test", factory(pi) {
+    pi.registerProvider(faux.provider);
+    pi.registerTool({ name: "check_alive", label: "Check alive", description: "Prove tools survive tracing failure", parameters: Type.Object({}),
+      async execute() { toolCalls++; return { content: [{ type: "text", text: "still alive" }], details: {} }; }
+    });
+  } }],
+  noExtensions: true, noSkills: true, noPromptTemplates: true, noThemes: true,
+  noContextFiles: true, systemPrompt: "Offline write-failure regression."
+});
+await loader.reload();
+const sessionManager = SessionManager.create(cwd, join(root, "sessions"));
+const { session } = await createAgentSession({ cwd, agentDir, model: faux.getModel(), thinkingLevel: "off", noTools: "builtin", resourceLoader: loader, sessionManager, settingsManager });
+await session.bindExtensions({});
+const reports = () => sessionManager.getBranch().filter((entry) => entry.type === "custom_message" && entry.customType === "agent-trace");
+async function prompt(text) {
+  faux.setResponses([
+    fauxAssistantMessage(fauxToolCall("check_alive", {}), { stopReason: "toolUse" }),
+    fauxAssistantMessage(fauxText("done")),
+    fauxAssistantMessage(fauxText("unused ack")),
+  ]);
+  await session.prompt(text, { expandPromptTemplates: false, source: "interactive" });
+}
+try {
+  await prompt("first");
+  assert.equal(reports().length, 1, "first write failure must be reported");
+  const reportId = reports()[0].id;
+  await session.reload();
