+describe("agent-trace example extension (harness)", () => {
+	let harness: Harness | undefined;
+	let traceFile: string;
+	let tempDir: string;
+	const originalTraceFile = process.env.PI_AGENT_TRACE_FILE;
+
+	beforeEach(() => {
+		tempDir = mkdtempSync(join(tmpdir(), "pi-agent-trace-harness-"));
+		traceFile = join(tempDir, "trace.otlp.jsonl");
+		process.env.PI_AGENT_TRACE_FILE = traceFile;
+	});
+
+	afterEach(() => {
+		harness?.cleanup();
+		harness = undefined;
+		if (originalTraceFile === undefined) {
+			delete process.env.PI_AGENT_TRACE_FILE;
+		} else {
+			process.env.PI_AGENT_TRACE_FILE = originalTraceFile;
+		}
+		rmSync(tempDir, { recursive: true, force: true });
+	});
+
+	it("traces a real AgentSession prompt, including a tool turn", async () => {
+		const echoTool: AgentTool = {
+			name: "echo",
+			label: "Echo",
+			description: "Echo back",
+			parameters: Type.Object({ text: Type.String() }),
+			execute: async () => ({ content: [{ type: "text", text: "echoed" }], details: {} }),
+		};
+
+		harness = await createHarnessWithExtensions({
+			extensionFactories: [agentTrace],
+			responses: [{ toolCalls: [{ name: "echo", args: { text: "hi" } }] }, "done"],
+			tools: [echoTool],
+			baseToolsOverride: { echo: echoTool },
+		});
+
+		await harness.session.prompt("use echo");
+
+		const requests = readRequests(traceFile);
+		expect(requests.length).toBeGreaterThan(0);
+		const names = requests.map((request) => spanOf(request).name);
+		expect(names.filter((name) => name === "pi.run")).toHaveLength(2);
+		expect(names).toContain("execute_tool echo");
+		expect(names).toContain(`chat ${harness.session.model?.id ?? "faux-1"}`);
+
+		const chatStart = names.indexOf(`chat ${harness.session.model?.id ?? "faux-1"}`);
+		const chatEnd = names.indexOf(`chat ${harness.session.model?.id ?? "faux-1"}`, chatStart + 1);
+		const toolStart = names.indexOf("execute_tool echo");
+		expect(chatEnd).toBeGreaterThan(chatStart);
+		expect(toolStart).toBe(chatEnd + 1);
+
+		const latest = latestBySpanId(requests);
+		const run = latest.find((span) => span.name === "pi.run")!;
+		expect(stringAttr(run, "pi.run.trigger")).toBe("prompt");
+		expect(intAttr(run, "pi.run.turn_count")).toBe("2");
+
+		const branch = harness.sessionManager.getBranch();
+		const userEntry = branch.find((entry) => entry.type === "message" && entry.message.role === "user");
+		const assistantEntries = branch.filter((entry) => entry.type === "message" && entry.message.role === "assistant");
+		const toolEntry = branch.find((entry) => entry.type === "message" && entry.message.role === "toolResult");
+		expect(stringAttr(run, "pi.session.entry_id")).toBe(userEntry?.id);
+
+		const chatSpans = latest.filter((span) => span.name.startsWith("chat "));
+		expect(chatSpans.map((span) => stringAttr(span, "pi.session.entry_id")).sort()).toEqual(
+			assistantEntries.map((entry) => entry.id).sort(),
+		);
+		expect(stringAttr(latest.find((span) => span.name === "execute_tool echo")!, "pi.session.entry_id")).toBe(
+			toolEntry?.id,
+		);
+
+		const endTimes = requests
+			.map(spanOf)
+			.filter((span) => span.endTimeUnixNano)
+			.map((span) => BigInt(span.endTimeUnixNano!));
+		for (let i = 1; i < endTimes.length; i++) {
+			expect(endTimes[i]).toBeGreaterThanOrEqual(endTimes[i - 1]);
+		}
+
+		for (const request of requests) {
+			expect(request.resourceSpans[0].scopeSpans[0].spans).toHaveLength(1);
+		}
+	});
