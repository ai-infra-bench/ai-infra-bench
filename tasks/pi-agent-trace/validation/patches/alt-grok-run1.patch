+const { default: agentTrace } = await import("../examples/extensions/agent-trace/index.ts");
+
+type OtlpValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano: string;
+	attributes: Array<{ key: string; value: OtlpValue }>;
+	status: { code: number; message?: string };
+};
+
+type ExportTraceServiceRequest = {
+	resourceSpans: Array<{
+		resource: { attributes: Array<{ key: string; value: OtlpValue }> };
+		scopeSpans: Array<{
+			scope: { name: string; version: string };
+			spans: OtlpSpan[];
+		}>;
+	}>;
+};
+
+type Handler = ExtensionHandler<any>;
+
+const HEX_16 = /^[0-9a-f]{16}$/;
+const HEX_32 = /^[0-9a-f]{32}$/;
+
+function createTempDir(): string {
+	return mkdtempSync(join(tmpdir(), "pi-agent-trace-"));
+}
+
+function install(): { emit: (event: { type: string }, ctx: ExtensionContext) => Promise<void> } {
+	const handlers = new Map<string, Handler>();
+	agentTrace({
+		on(event: string, handler: Handler) {
+			handlers.set(event, handler);
+		},
+	} as ExtensionAPI);
+	return {
+		async emit(event, ctx) {
+			await handlers.get(event.type)?.(event, ctx);
+		},
+	};
+}
+
+function ctxFor(sessionManager: SessionManager): ExtensionContext {
+	return {
+		sessionManager,
+		mode: "print",
+		hasUI: false,
+		cwd: sessionManager.getCwd(),
+		ui: {} as ExtensionContext["ui"],
+		modelRegistry: {} as ExtensionContext["modelRegistry"],
+		model: undefined,
+		scopedModels: [],
+		isIdle: () => true,
+		isProjectTrusted: () => true,
+		signal: undefined,
+		abort: () => {},
+		hasPendingMessages: () => false,
+		shutdown: () => {},
+		getContextUsage: () => undefined,
+		compact: () => {},
+		getSystemPrompt: () => "",
+	} as ExtensionContext;
+}
+
+function userMessage(text: string): AgentMessage {
+	return { role: "user", content: text, timestamp: Date.now() };
+}
+
+function assistantMessage(
+	text: string,
+	options: {
+		stopReason?: "stop" | "toolUse" | "error" | "aborted";
+		errorMessage?: string;
+		usage?: { input: number; output: number; cacheRead: number; cacheWrite: number };
+	} = {},
+): AgentMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "test-model",
+		usage: {
+			input: options.usage?.input ?? 11,
+			output: options.usage?.output ?? 7,
+			cacheRead: options.usage?.cacheRead ?? 3,
+			cacheWrite: options.usage?.cacheWrite ?? 2,
+			totalTokens: 23,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: options.stopReason ?? "stop",
+		errorMessage: options.errorMessage,
+		timestamp: Date.now(),
+	} as AgentMessage;
+}
+
+function toolResultMessage(toolName: string, toolCallId: string, text: string, isError = false): AgentMessage {
+	return {
+		role: "toolResult",
+		toolCallId,
+		toolName,
+		content: [{ type: "text", text }],
+		isError,
+		timestamp: Date.now(),
+	} as AgentMessage;
+}
+
+function readRecords(file: string): ExportTraceServiceRequest[] {
+	if (!existsSync(file)) {
+		return [];
+	}
+	return readFileSync(file, "utf8")
+		.split("\n")
+		.filter((line) => line.length > 0)
+		.map((line) => JSON.parse(line) as ExportTraceServiceRequest);
+}
+
+function readSpans(file: string): OtlpSpan[] {
+	return readRecords(file).map((record) => {
+		expect(record.resourceSpans).toHaveLength(1);
+		expect(record.resourceSpans[0]!.scopeSpans).toHaveLength(1);
+		expect(record.resourceSpans[0]!.scopeSpans[0]!.spans).toHaveLength(1);
+		return record.resourceSpans[0]!.scopeSpans[0]!.spans[0]!;
+	});
+}
+
+function attr(span: OtlpSpan, key: string): OtlpValue | undefined {
+	const matches = span.attributes.filter((item) => item.key === key);
+	expect(matches.length).toBeLessThanOrEqual(1);
+	return matches[0]?.value;
+}
+
+function stringAttr(span: OtlpSpan, key: string): string {
+	const value = attr(span, key);
+	expect(value).toEqual({ stringValue: expect.any(String) });
+	return (value as { stringValue: string }).stringValue;
+}
+
+function intAttr(span: OtlpSpan, key: string): number {
+	const value = attr(span, key);
+	expect(value).toMatchObject({ intValue: expect.any(String) });
+	const raw = (value as { intValue: string }).intValue;
+	expect(raw).toMatch(/^-?\d+$/);
+	return Number(raw);
+}
+
+function boolAttr(span: OtlpSpan, key: string): boolean {
+	const value = attr(span, key);
+	expect(value).toEqual({ boolValue: expect.any(Boolean) });
+	return (value as { boolValue: boolean }).boolValue;
+}
+
+function nano(span: OtlpSpan, field: "startTimeUnixNano" | "endTimeUnixNano"): bigint {
+	expect(span[field]).toMatch(/^\d+$/);
+	return BigInt(span[field]);
+}
+
+async function runSingleTurn(options: {
+	emit: (event: { type: string }, ctx: ExtensionContext) => Promise<void>;
+	ctx: ExtensionContext;
+	sessionManager: SessionManager;
+	trigger: "prompt" | "continuation" | "wakeup";
+	userText?: string;
+	custom?: { customType: string; content: string };
+	assistant: AgentMessage;
+	tools?: Array<{ name: string; callId: string; text: string; isError?: boolean }>;
+	settle?: boolean;
+}): Promise<void> {
+	const { emit, ctx, sessionManager } = options;
+	if (options.trigger === "prompt") {
+		await emit(
+			{
+				type: "before_agent_start",
+				prompt: options.userText ?? "hi",
+				systemPrompt: "",
+				systemPromptOptions: {} as SessionBeforeCompactEvent["preparation"],
+			} as unknown as { type: string },
+			ctx,
+		);
+	}
+	await emit({ type: "agent_start" }, ctx);
+	await emit({ type: "turn_start", turnIndex: 0, timestamp: Date.now() } as { type: string }, ctx);
+
+	if (options.custom && options.trigger !== "prompt") {
+		const customMessage = {
+			role: "custom" as const,
+			customType: options.custom.customType,
+			content: options.custom.content,
+			display: true,
+			timestamp: Date.now(),
+		};
+		await emit({ type: "message_start", message: customMessage } as { type: string }, ctx);
+		await emit({ type: "message_end", message: customMessage } as { type: string }, ctx);
+		sessionManager.appendCustomMessageEntry(options.custom.customType, options.custom.content, true);
+	}
+
+	if (options.trigger === "prompt") {
+		const user = userMessage(options.userText ?? "hi");
+		await emit({ type: "message_start", message: user } as { type: string }, ctx);
+		await emit({ type: "message_end", message: user } as { type: string }, ctx);
+		sessionManager.appendMessage(user);
+	}
+
+	await emit({ type: "message_start", message: options.assistant } as { type: string }, ctx);
+	await emit({ type: "message_end", message: options.assistant } as { type: string }, ctx);
+	sessionManager.appendMessage(options.assistant);
+
+	const toolResults: AgentMessage[] = [];
+	for (const tool of options.tools ?? []) {
+		await emit(
+			{ type: "tool_execution_start", toolCallId: tool.callId, toolName: tool.name, args: {} } as { type: string },
+			ctx,
+		);
+		const result = { content: [{ type: "text" as const, text: tool.text }] };
+		await emit(
+			{
+				type: "tool_execution_end",
+				toolCallId: tool.callId,
+				toolName: tool.name,
+				result,
+				isError: tool.isError ?? false,
+			} as { type: string },
+			ctx,
+		);
+		const toolResult = toolResultMessage(tool.name, tool.callId, tool.text, tool.isError);
+		await emit({ type: "message_start", message: toolResult } as { type: string }, ctx);
+		await emit({ type: "message_end", message: toolResult } as { type: string }, ctx);
+		sessionManager.appendMessage(toolResult);
+		toolResults.push(toolResult);
+	}
+
+	await emit({ type: "turn_end", turnIndex: 0, message: options.assistant, toolResults } as { type: string }, ctx);
+	await emit({ type: "agent_end", messages: [] }, ctx);
+	if (options.settle !== false) {
+		await emit({ type: "agent_settled" }, ctx);
+	}
+}
