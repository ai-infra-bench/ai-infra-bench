+/**
+ * Agent Trace - Export the agent loop as an OpenTelemetry OTLP/JSONL trace.
+ *
+ * Writes one span per run, turn, provider request, tool execution, and compaction
+ * to `<sessionDir>/traces/<session id>.otlp.jsonl` (or PI_AGENT_TRACE_FILE).
+ *
+ * Usage:
+ *   pi -e packages/coding-agent/examples/extensions/agent-trace
+ */
+
+import { createHash, randomBytes } from "node:crypto";
+import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import {
+	type CompactionEntry,
+	type ExtensionAPI,
+	type ExtensionContext,
+	type MessageEndEvent,
+	type MessageStartEvent,
+	type SessionBeforeCompactEvent,
+	type SessionCompactEvent,
+	type SessionEntry,
+	type ToolExecutionEndEvent,
+	type ToolExecutionStartEvent,
+	type TurnEndEvent,
+	type TurnStartEvent,
+	VERSION,
+} from "@earendil-works/pi-coding-agent";
+
+const SCOPE_NAME = "pi.agent-trace";
+const SCOPE_VERSION = "1";
+const KIND_INTERNAL = 1;
+const KIND_CLIENT = 3;
+const STATUS_OK = 1;
+const STATUS_ERROR = 2;
+const NS_PER_MS = 1_000_000n;
+
+type OtlpValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type OtlpAttribute = { key: string; value: OtlpValue };
+
+type OtlpStatus = { code: typeof STATUS_OK } | { code: typeof STATUS_ERROR; message: string };
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano: string;
+	attributes: OtlpAttribute[];
+	status: OtlpStatus;
+};
+
+type AttrInput = {
+	key: string;
+	value: string | number | boolean | string[] | undefined;
+};
+
+type AssistantLike = AgentMessage & {
+	role: "assistant";
+	model: string;
+	provider: string;
+	stopReason: string;
+	errorMessage?: string;
+	usage?: {
+		input: number;
+		output: number;
+		cacheRead: number;
+		cacheWrite: number;
+	};
+};
+
+type ToolResultLike = AgentMessage & {
+	role: "toolResult";
+	toolCallId: string;
+	toolName: string;
+	isError: boolean;
+	content?: unknown;
+};
+
+type OpenChat = {
+	spanId: string;
+	start: bigint;
+	end?: bigint;
+	message: AssistantLike;
+};
+
+type OpenTool = {
+	spanId: string;
+	toolCallId: string;
+	toolName: string;
+	start: bigint;
+	end?: bigint;
+	isError?: boolean;
+	errorMessage?: string;
+};
+
+type OpenTurn = {
+	spanId: string;
+	index: number;
+	start: bigint;
+	entryIdsAtStart: Set<string>;
+	chat?: OpenChat;
+	tools: OpenTool[];
+};
+
+type OpenRun = {
+	spanId: string;
+	start: bigint;
+	trigger: "prompt" | "continuation" | "wakeup";
+	entryIdsAtStart: Set<string>;
+	turns: OpenTurn[];
+};
+
+type OpenCompaction = {
+	spanId: string;
+	start: bigint;
+	reason: SessionBeforeCompactEvent["reason"];
+	willRetry: boolean;
+};
+
+function isAssistant(message: AgentMessage): message is AssistantLike {
+	return message.role === "assistant";
+}
+
+function isToolResult(message: AgentMessage): message is ToolResultLike {
+	return message.role === "toolResult";
+}
+
+function isMessageEntry(entry: SessionEntry): entry is SessionEntry & { type: "message"; message: AgentMessage } {
+	return entry.type === "message";
+}
+
+function contentToText(content: unknown): string {
+	if (typeof content === "string") {
+		return content;
+	}
+	if (!Array.isArray(content)) {
+		return "";
+	}
+	const parts: string[] = [];
+	for (const part of content) {
+		if (part && typeof part === "object" && "type" in part && part.type === "text" && "text" in part) {
+			const text = (part as { text: unknown }).text;
+			if (typeof text === "string" && text.length > 0) {
+				parts.push(text);
+			}
+		}
+	}
+	return parts.join("\n");
+}
+
+function toolResultText(result: unknown): string {
+	if (!result || typeof result !== "object") {
+		return "";
+	}
+	return contentToText((result as { content?: unknown }).content);
+}
+
+function assistantErrorMessage(message: AssistantLike): string {
+	return message.errorMessage || "aborted";
+}
+
+function isAssistantError(stopReason: string): boolean {
+	return stopReason === "error" || stopReason === "aborted";
+}
+
+function traceIdFromSessionId(sessionId: string): string {
+	const digest = createHash("sha256").update(sessionId).digest("hex");
+	const id = digest.slice(0, 32);
+	return id === "0".repeat(32) ? "1".repeat(32) : id;
+}
+
+function attr(key: string, value: string | number | boolean | string[]): OtlpAttribute {
+	if (typeof value === "string") {
+		return { key, value: { stringValue: value } };
+	}
+	if (typeof value === "boolean") {
+		return { key, value: { boolValue: value } };
+	}
+	if (typeof value === "number") {
+		return { key, value: { intValue: String(Math.trunc(value)) } };
+	}
+	return {
+		key,
+		value: { arrayValue: { values: value.map((item) => ({ stringValue: item })) } },
+	};
+}
+
+function attributes(items: AttrInput[]): OtlpAttribute[] {
+	const seen = new Set<string>();
+	const out: OtlpAttribute[] = [];
+	for (const item of items) {
+		if (item.value === undefined || seen.has(item.key)) {
+			continue;
+		}
+		seen.add(item.key);
+		out.push(attr(item.key, item.value));
+	}
+	return out;
+}
+
+function okStatus(): OtlpStatus {
+	return { code: STATUS_OK };
+}
+
+function errorStatus(message: string): OtlpStatus {
+	return { code: STATUS_ERROR, message };
+}
+
+function lastMatching<T extends SessionEntry>(
+	branch: SessionEntry[],
+	used: Set<string>,
+	predicate: (entry: SessionEntry) => entry is T,
+): T | undefined {
+	for (let i = branch.length - 1; i >= 0; i--) {
+		const entry = branch[i]!;
+		if (used.has(entry.id)) {
+			continue;
+		}
+		if (predicate(entry)) {
+			return entry;
+		}
+	}
+	return undefined;
+}
+
+class AgentTrace {
+	private sessionId: string | undefined;
+	private filePath: string | undefined;
+	private resourceAttributes: OtlpAttribute[] = [];
+	private traceId = "";
+	private usedSpanIds = new Set<string>();
+	private referencedEntryIds = new Set<string>();
+	private lastEndTime = 0n;
+	private pendingPrompt = false;
+	private runActive = false;
+	private run: OpenRun | undefined;
+	private compaction: OpenCompaction | undefined;
+
+	bind(ctx: ExtensionContext): void {
+		const sessionId = ctx.sessionManager.getSessionId();
+		if (this.sessionId === sessionId && this.filePath) {
+			return;
+		}
+
+		this.sessionId = sessionId;
+		this.traceId = traceIdFromSessionId(sessionId);
+		this.resourceAttributes = attributes([
+			{ key: "service.name", value: "pi" },
+			{ key: "service.version", value: VERSION },
+			{ key: "pi.session.id", value: sessionId },
+			{ key: "process.pid", value: process.pid },
+		]);
+
+		const override = process.env.PI_AGENT_TRACE_FILE;
+		this.filePath =
+			override && override.length > 0
+				? override
+				: join(ctx.sessionManager.getSessionDir(), "traces", `${sessionId}.otlp.jsonl`);
+
+		this.usedSpanIds = new Set();
+		this.referencedEntryIds = new Set();
+		this.pendingPrompt = false;
+		this.runActive = false;
+		this.run = undefined;
+		this.compaction = undefined;
+		this.lastEndTime = 0n;
+		this.loadExistingFile();
+	}
+
+	private loadExistingFile(): void {
+		if (!this.filePath || !existsSync(this.filePath)) {
+			return;
+		}
+		const text = readFileSync(this.filePath, "utf8");
+		for (const line of text.split("\n")) {
+			if (!line) {
+				continue;
+			}
+			try {
+				const parsed = JSON.parse(line) as {
+					resourceSpans?: Array<{
+						scopeSpans?: Array<{ spans?: OtlpSpan[] }>;
+					}>;
+				};
+				const span = parsed.resourceSpans?.[0]?.scopeSpans?.[0]?.spans?.[0];
+				if (!span) {
+					continue;
+				}
+				if (span.spanId) {
+					this.usedSpanIds.add(span.spanId);
+				}
+				if (span.endTimeUnixNano) {
+					const end = BigInt(span.endTimeUnixNano);
+					if (end > this.lastEndTime) {
+						this.lastEndTime = end;
+					}
+				}
+			} catch {
+				// A crashed process may leave a truncated last line; skip it.
+			}
+		}
+	}
+
+	private tick(preferredMs?: number): bigint {
+		const wall = BigInt(preferredMs ?? Date.now()) * NS_PER_MS;
+		if (wall > this.lastEndTime) {
+			this.lastEndTime = wall;
+		} else {
+			this.lastEndTime += 1n;
+		}
+		return this.lastEndTime;
+	}
+
+	private newSpanId(): string {
+		let id = "";
+		do {
+			id = randomBytes(8).toString("hex");
+		} while (this.usedSpanIds.has(id) || id === "0".repeat(16));
+		this.usedSpanIds.add(id);
+		return id;
+	}
+
+	private writeSpan(span: OtlpSpan): void {
+		if (!this.filePath) {
+			return;
+		}
+		const request = {
+			resourceSpans: [
+				{
+					resource: { attributes: this.resourceAttributes },
+					scopeSpans: [
+						{
+							scope: { name: SCOPE_NAME, version: SCOPE_VERSION },
+							spans: [span],
+						},
+					],
+				},
+			],
+		};
+		mkdirSync(dirname(this.filePath), { recursive: true });
+		appendFileSync(this.filePath, `${JSON.stringify(request)}\n`);
+	}
+
+	private emitSpan(input: {
+		name: string;
+		kind: number;
+		parentSpanId?: string;
+		start: bigint;
+		end: bigint;
+		attributes: AttrInput[];
+		status: OtlpStatus;
+		spanId: string;
+	}): void {
+		const end = input.end < input.start ? input.start : input.end;
+		const span: OtlpSpan = {
+			traceId: this.traceId,
+			spanId: input.spanId,
+			name: input.name,
+			kind: input.kind,
+			startTimeUnixNano: input.start.toString(),
+			endTimeUnixNano: end.toString(),
+			attributes: attributes(input.attributes),
+			status: input.status,
+		};
+		if (input.parentSpanId) {
+			span.parentSpanId = input.parentSpanId;
+		}
+		this.writeSpan(span);
+	}
+
+	private currentTurn(): OpenTurn | undefined {
+		const turns = this.run?.turns;
+		return turns && turns.length > 0 ? turns[turns.length - 1] : undefined;
+	}
+
+	onBeforeAgentStart(ctx: ExtensionContext): void {
+		this.bind(ctx);
+		this.pendingPrompt = true;
+	}
+
+	onAgentStart(ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const trigger = this.pendingPrompt ? "prompt" : this.runActive ? "continuation" : "wakeup";
+		this.pendingPrompt = false;
+		this.runActive = true;
+		this.run = {
+			spanId: this.newSpanId(),
+			start: this.tick(),
+			trigger,
+			entryIdsAtStart: new Set(ctx.sessionManager.getBranch().map((entry) => entry.id)),
+			turns: [],
+		};
+	}
+
+	onTurnStart(event: TurnStartEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		if (!this.run) {
+			return;
+		}
+		this.run.turns.push({
+			spanId: this.newSpanId(),
+			index: event.turnIndex,
+			start: this.tick(event.timestamp),
+			entryIdsAtStart: new Set(ctx.sessionManager.getBranch().map((entry) => entry.id)),
+			tools: [],
+		});
+	}
+
+	onMessageStart(event: MessageStartEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.currentTurn();
+		if (!turn || !isAssistant(event.message)) {
+			return;
+		}
+		turn.chat = {
+			spanId: this.newSpanId(),
+			start: this.tick(),
+			message: event.message,
+		};
+	}
+
+	onMessageEnd(event: MessageEndEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.currentTurn();
+		if (!turn?.chat || !isAssistant(event.message)) {
+			return;
+		}
+		turn.chat.message = event.message;
+		turn.chat.end = this.tick();
+	}
+
+	onToolExecutionStart(event: ToolExecutionStartEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.currentTurn();
+		if (!turn) {
+			return;
+		}
+		turn.tools.push({
+			spanId: this.newSpanId(),
+			toolCallId: event.toolCallId,
+			toolName: event.toolName,
+			start: this.tick(),
+		});
+	}
+
+	onToolExecutionEnd(event: ToolExecutionEndEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.currentTurn();
+		if (!turn) {
+			return;
+		}
+		const tool = [...turn.tools]
+			.reverse()
+			.find((item) => item.toolCallId === event.toolCallId && item.end === undefined);
+		if (!tool) {
+			return;
+		}
+		tool.end = this.tick();
+		tool.isError = event.isError;
+		tool.errorMessage = event.isError ? toolResultText(event.result) : undefined;
+	}
+
+	onTurnEnd(event: TurnEndEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const run = this.run;
+		const turn = this.currentTurn();
+		if (!run || !turn) {
+			return;
+		}
+
+		if (isAssistant(event.message) && turn.chat) {
+			turn.chat.message = event.message;
+		}
+
+		const branch = ctx.sessionManager.getBranch();
+		const newEntries = branch.filter((entry) => !turn.entryIdsAtStart.has(entry.id));
+		const assistant = turn.chat?.message ?? (isAssistant(event.message) ? event.message : undefined);
+
+		if (turn.chat?.end !== undefined && assistant) {
+			const assistantEntry =
+				lastMatching(
+					newEntries,
+					this.referencedEntryIds,
+					(entry): entry is SessionEntry & { type: "message"; message: AssistantLike } =>
+						isMessageEntry(entry) && isAssistant(entry.message) && entry.message === assistant,
+				) ??
+				lastMatching(
+					newEntries,
+					this.referencedEntryIds,
+					(entry): entry is SessionEntry & { type: "message"; message: AssistantLike } =>
+						isMessageEntry(entry) && isAssistant(entry.message),
+				);
+			if (assistantEntry) {
+				this.referencedEntryIds.add(assistantEntry.id);
+			}
+			const stopReason = assistant.stopReason;
+			const errored = isAssistantError(stopReason);
+			this.emitSpan({
+				spanId: turn.chat.spanId,
+				parentSpanId: turn.spanId,
+				name: `chat ${assistant.model}`,
+				kind: KIND_CLIENT,
+				start: turn.chat.start,
+				end: turn.chat.end,
+				status: errored ? errorStatus(assistantErrorMessage(assistant)) : okStatus(),
+				attributes: [
+					{ key: "gen_ai.operation.name", value: "chat" },
+					{ key: "gen_ai.system", value: assistant.provider },
+					{ key: "gen_ai.request.model", value: assistant.model },
+					{ key: "gen_ai.usage.input_tokens", value: assistant.usage?.input ?? 0 },
+					{ key: "gen_ai.usage.output_tokens", value: assistant.usage?.output ?? 0 },
+					{ key: "pi.usage.cache_read_tokens", value: assistant.usage?.cacheRead ?? 0 },
+					{ key: "pi.usage.cache_write_tokens", value: assistant.usage?.cacheWrite ?? 0 },
+					{ key: "gen_ai.response.finish_reasons", value: [stopReason] },
+					{ key: "pi.session.entry_id", value: assistantEntry?.id },
+				],
+			});
+		}
+
+		const endedTools = turn.tools
+			.filter((tool) => tool.end !== undefined)
+			.sort((a, b) => (a.end! < b.end! ? -1 : a.end! > b.end! ? 1 : 0));
+		for (const tool of endedTools) {
+			const toolEntry = lastMatching(
+				newEntries,
+				this.referencedEntryIds,
+				(entry): entry is SessionEntry & { type: "message"; message: ToolResultLike } =>
+					isMessageEntry(entry) && isToolResult(entry.message) && entry.message.toolCallId === tool.toolCallId,
+			);
+			if (toolEntry) {
+				this.referencedEntryIds.add(toolEntry.id);
+			}
+			this.emitSpan({
+				spanId: tool.spanId,
+				parentSpanId: turn.spanId,
+				name: `execute_tool ${tool.toolName}`,
+				kind: KIND_INTERNAL,
+				start: tool.start,
+				end: tool.end!,
+				status: tool.isError ? errorStatus(tool.errorMessage ?? "") : okStatus(),
+				attributes: [
+					{ key: "gen_ai.operation.name", value: "execute_tool" },
+					{ key: "gen_ai.tool.name", value: tool.toolName },
+					{ key: "gen_ai.tool.call.id", value: tool.toolCallId },
+					{ key: "pi.tool.is_error", value: tool.isError === true },
+					{ key: "pi.session.entry_id", value: toolEntry?.id },
+				],
+			});
+		}
+
+		const stopReason = assistant?.stopReason ?? "";
+		const turnErrored = assistant !== undefined && isAssistantError(stopReason);
+		this.emitSpan({
+			spanId: turn.spanId,
+			parentSpanId: run.spanId,
+			name: "pi.turn",
+			kind: KIND_INTERNAL,
+			start: turn.start,
+			end: this.tick(),
+			status: turnErrored && assistant ? errorStatus(assistantErrorMessage(assistant)) : okStatus(),
+			attributes: [
+				{ key: "pi.turn.index", value: turn.index },
+				{ key: "pi.turn.stop_reason", value: stopReason },
+				{ key: "pi.turn.tool_call_count", value: event.toolResults.length },
+			],
+		});
+	}
+
+	onAgentEnd(ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const run = this.run;
+		if (!run) {
+			return;
+		}
+
+		const branch = ctx.sessionManager.getBranch();
+		const newEntries = branch.filter((entry) => !run.entryIdsAtStart.has(entry.id));
+		let entryId: string | undefined;
+		if (run.trigger === "prompt") {
+			const user = newEntries.find((entry) => isMessageEntry(entry) && entry.message.role === "user");
+			entryId = user?.id;
+		} else {
+			const custom = newEntries.find((entry) => entry.type === "custom_message");
+			entryId = custom?.id;
+		}
+		if (entryId) {
+			this.referencedEntryIds.add(entryId);
+		}
+
+		this.emitSpan({
+			spanId: run.spanId,
+			name: "pi.run",
+			kind: KIND_INTERNAL,
+			start: run.start,
+			end: this.tick(),
+			status: okStatus(),
+			attributes: [
+				{ key: "pi.run.trigger", value: run.trigger },
+				{ key: "pi.run.turn_count", value: run.turns.length },
+				{ key: "pi.session.entry_id", value: entryId },
+			],
+		});
+		this.run = undefined;
+	}
+
+	onAgentSettled(ctx: ExtensionContext): void {
+		this.bind(ctx);
+		this.runActive = false;
+		this.pendingPrompt = false;
+	}
+
+	onSessionBeforeCompact(event: SessionBeforeCompactEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		this.compaction = {
+			spanId: this.newSpanId(),
+			start: this.tick(),
+			reason: event.reason,
+			willRetry: event.willRetry,
+		};
+	}
+
+	onSessionCompact(event: SessionCompactEvent, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		this.finishCompaction(event, event.compactionEntry, false);
+	}
+
+	onSessionCompactFailed(
+		event: { reason: SessionBeforeCompactEvent["reason"]; willRetry: boolean; errorMessage?: string },
+		ctx: ExtensionContext,
+	): void {
+		this.bind(ctx);
+		this.finishCompaction(event, undefined, true, event.errorMessage || "aborted");
+	}
+
+	private finishCompaction(
+		event: { reason: SessionBeforeCompactEvent["reason"]; willRetry: boolean },
+		entry: CompactionEntry | undefined,
+		failed: boolean,
+		errorMessage?: string,
+	): void {
+		const open = this.compaction;
+		this.compaction = undefined;
+		const start = open?.start ?? this.tick();
+		const spanId = open?.spanId ?? this.newSpanId();
+		if (entry) {
+			this.referencedEntryIds.add(entry.id);
+		}
+		this.emitSpan({
+			spanId,
+			name: "pi.compaction",
+			kind: KIND_INTERNAL,
+			start,
+			end: this.tick(),
+			status: failed ? errorStatus(errorMessage ?? "aborted") : okStatus(),
+			attributes: [
+				{ key: "pi.compaction.reason", value: event.reason },
+				{ key: "pi.compaction.will_retry", value: event.willRetry },
+				{ key: "pi.compaction.tokens_before", value: entry?.tokensBefore },
+				{ key: "pi.session.entry_id", value: entry?.id },
+			],
+		});
+	}
+}
+
+export default function agentTrace(pi: ExtensionAPI): void {
+	const trace = new AgentTrace();
+
+	pi.on("session_start", (_event, ctx) => {
+		trace.bind(ctx);
+	});
+	pi.on("before_agent_start", (_event, ctx) => {
+		trace.onBeforeAgentStart(ctx);
+	});
+	pi.on("agent_start", (_event, ctx) => {
+		trace.onAgentStart(ctx);
+	});
+	pi.on("turn_start", (event, ctx) => {
+		trace.onTurnStart(event, ctx);
+	});
+	pi.on("message_start", (event, ctx) => {
+		trace.onMessageStart(event, ctx);
+	});
+	pi.on("message_end", (event, ctx) => {
+		trace.onMessageEnd(event, ctx);
+	});
+	pi.on("tool_execution_start", (event, ctx) => {
+		trace.onToolExecutionStart(event, ctx);
+	});
+	pi.on("tool_execution_end", (event, ctx) => {
+		trace.onToolExecutionEnd(event, ctx);
+	});
+	pi.on("turn_end", (event, ctx) => {
+		trace.onTurnEnd(event, ctx);
+	});
+	pi.on("agent_end", (_event, ctx) => {
+		trace.onAgentEnd(ctx);
+	});
+	pi.on("agent_settled", (_event, ctx) => {
+		trace.onAgentSettled(ctx);
+	});
+	pi.on("session_before_compact", (event, ctx) => {
+		trace.onSessionBeforeCompact(event, ctx);
+	});
+	pi.on("session_compact", (event, ctx) => {
+		trace.onSessionCompact(event, ctx);
+	});
+	pi.on("session_compact_failed", (event, ctx) => {
+		trace.onSessionCompactFailed(event, ctx);
+	});
+}
