+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentMessage, AgentTool } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import agentTrace from "../examples/extensions/agent-trace/index.ts";
+import type { ExtensionAPI, ExtensionContext, SessionEntry } from "../src/core/extensions/index.ts";
+import { VERSION } from "../src/index.ts";
+import { createHarnessWithExtensions, type Harness } from "./test-harness.ts";
+
+type OtlpValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Array<{ key: string; value: OtlpValue }>;
+	status?: { code: number; message?: string };
+};
+
+type ExportRequest = {
+	resourceSpans: Array<{
+		resource: { attributes: Array<{ key: string; value: OtlpValue }> };
+		scopeSpans: Array<{ scope: { name: string; version: string }; spans: OtlpSpan[] }>;
+	}>;
+};
+
+function usage(partial?: Partial<AssistantMessage["usage"]>): AssistantMessage["usage"] {
+	return {
+		input: partial?.input ?? 10,
+		output: partial?.output ?? 4,
+		cacheRead: partial?.cacheRead ?? 1,
+		cacheWrite: partial?.cacheWrite ?? 2,
+		totalTokens: partial?.totalTokens ?? 17,
+		cost: partial?.cost ?? { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function assistant(overrides: Partial<AssistantMessage> = {}): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text: "ok" }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "claude-test",
+		usage: usage(),
+		stopReason: "stop",
+		timestamp: Date.now(),
+		...overrides,
+	};
+}
+
+function user(text: string): AgentMessage {
+	return { role: "user", content: [{ type: "text", text }], timestamp: Date.now() };
+}
+
+function custom(customType: string, text: string): AgentMessage {
+	return {
+		role: "custom",
+		customType,
+		content: [{ type: "text", text }],
+		display: false,
+		timestamp: Date.now(),
+	} as AgentMessage;
+}
+
+function toolResult(toolCallId: string, toolName: string, text: string, isError = false): ToolResultMessage {
+	return {
+		role: "toolResult",
+		toolCallId,
+		toolName,
+		content: [{ type: "text", text }],
+		isError,
+		timestamp: Date.now(),
+	};
+}
+
+function attrMap(span: OtlpSpan): Record<string, OtlpValue> {
+	const out: Record<string, OtlpValue> = {};
+	for (const attr of span.attributes) out[attr.key] = attr.value;
+	return out;
+}
+
+function stringAttr(span: OtlpSpan, key: string): string | undefined {
+	const value = attrMap(span)[key];
+	return value && "stringValue" in value ? value.stringValue : undefined;
+}
+
+function intAttr(span: OtlpSpan, key: string): string | undefined {
+	const value = attrMap(span)[key];
+	return value && "intValue" in value ? value.intValue : undefined;
+}
+
+function boolAttr(span: OtlpSpan, key: string): boolean | undefined {
+	const value = attrMap(span)[key];
+	return value && "boolValue" in value ? value.boolValue : undefined;
+}
+
+function arrayAttr(span: OtlpSpan, key: string): string[] | undefined {
+	const value = attrMap(span)[key];
+	return value && "arrayValue" in value ? value.arrayValue.values.map((item) => item.stringValue) : undefined;
+}
+
+function spanOf(record: ExportRequest): OtlpSpan {
+	const spans = record.resourceSpans[0]?.scopeSpans[0]?.spans;
+	expect(spans).toHaveLength(1);
+	return spans![0];
+}
+
+function resourceAttrs(record: ExportRequest): Record<string, OtlpValue> {
+	const out: Record<string, OtlpValue> = {};
+	for (const attr of record.resourceSpans[0].resource.attributes) out[attr.key] = attr.value;
+	return out;
+}
+
+type Handler = (event: any, ctx: ExtensionContext) => unknown;
+
+function createDriver(options: { parent?: string; sessionId?: string; filePath?: string } = {}) {
+	const tempDir = mkdtempSync(join(tmpdir(), "pi-agent-trace-"));
+	const sessionDir = join(tempDir, "session");
+	mkdirSync(sessionDir, { recursive: true });
+	const filePath = options.filePath ?? join(tempDir, "trace.otlp.jsonl");
+	const sessionId = options.sessionId ?? "sess-trace-1";
+
+	vi.stubEnv("PI_AGENT_TRACE_FILE", filePath);
+	if (options.parent !== undefined) {
+		vi.stubEnv("PI_AGENT_TRACE_PARENT", options.parent);
+	} else {
+		vi.stubEnv("PI_AGENT_TRACE_PARENT", "");
+		delete process.env.PI_AGENT_TRACE_PARENT;
+	}
+
+	const handlers = new Map<string, Handler>();
+	const sendMessage = vi.fn();
+	const entries: SessionEntry[] = [];
+	let nextId = 1;
+
+	agentTrace({
+		on(event: string, handler: Handler) {
+			handlers.set(event, handler);
+		},
+		sendMessage,
+	} as unknown as ExtensionAPI);
+
+	const ctx = {
+		sessionManager: {
+			getSessionId: () => sessionId,
+			getSessionDir: () => sessionDir,
+			getBranch: () => entries,
+		},
+	} as unknown as ExtensionContext;
+
+	function persist(message: AgentMessage): void {
+		const id = `e${nextId++}`;
+		if (message.role === "custom") {
+			const customMessage = message as AgentMessage & { customType: string; content: unknown; display?: boolean };
+			entries.push({
+				type: "custom_message",
+				id,
+				parentId: entries.length > 0 ? entries[entries.length - 1].id : null,
+				timestamp: new Date().toISOString(),
+				customType: customMessage.customType,
+				content: customMessage.content as never,
+				display: customMessage.display ?? false,
+			});
+			return;
+		}
+		entries.push({
+			type: "message",
+			id,
+			parentId: entries.length > 0 ? entries[entries.length - 1].id : null,
+			timestamp: new Date().toISOString(),
+			message,
+		});
+	}
+
+	async function emit(event: { type: string } & Record<string, unknown>): Promise<void> {
+		await handlers.get(event.type)?.(event, ctx);
+		if (event.type === "message_end" && event.message) persist(event.message as AgentMessage);
+	}
+
+	function readRecords(): ExportRequest[] {
+		if (!existsSync(filePath)) return [];
+		return readFileSync(filePath, "utf8")
+			.split("\n")
+			.filter((line) => line.length > 0)
+			.map((line) => JSON.parse(line) as ExportRequest);
+	}
+
+	function readSpans(): OtlpSpan[] {
+		return readRecords().map(spanOf);
+	}
+
+	function endsByName(): Map<string, OtlpSpan> {
+		const map = new Map<string, OtlpSpan>();
+		for (const span of readSpans()) {
+			if (span.endTimeUnixNano) map.set(span.name, span);
+		}
+		return map;
+	}
+
+	return { tempDir, filePath, sessionDir, sessionId, sendMessage, entries, emit, readRecords, readSpans, endsByName };
+}
+
+const temps: string[] = [];
+const harnesses: Harness[] = [];
+
+afterEach(() => {
+	while (temps.length > 0) {
+		const dir = temps.pop();
+		if (dir && existsSync(dir)) rmSync(dir, { recursive: true, force: true });
+	}
+	while (harnesses.length > 0) {
+		harnesses.pop()?.cleanup();
+	}
+	delete process.env.PI_AGENT_TRACE_FILE;
+	delete process.env.PI_AGENT_TRACE_PARENT;
+});
+
+describe("agent-trace extension", () => {
+	it("writes start then end lines for a prompt run without tools", async () => {
