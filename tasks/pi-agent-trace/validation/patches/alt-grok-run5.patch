+		temps.push(tempDir);
+		const filePath = join(tempDir, "trace.otlp.jsonl");
+		vi.stubEnv("PI_AGENT_TRACE_FILE", filePath);
+
+		let release!: () => void;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const wait: AgentTool = {
+			name: "wait",
+			label: "Wait",
+			description: "Wait",
+			parameters: Type.Object({}),
