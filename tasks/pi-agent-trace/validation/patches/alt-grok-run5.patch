+/**
+ * Agent-trace extension.
+ *
+ * Exports the agent loop as a local OTLP/JSONL trace: one span per run, turn,
+ * provider chat, tool execution, and compaction. Each span is appended twice
+ * (start line, then end line) so a reader tailing the file sees in-flight work.
+ *
+ * File: <sessionDir>/traces/<session-id>.otlp.jsonl
+ * Override: PI_AGENT_TRACE_FILE
+ * Sub-agent parent: PI_AGENT_TRACE_PARENT=<traceId>-<spanId>
+ */
+
+import { createHash, randomBytes } from "node:crypto";
+import { appendFileSync, mkdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import {
+	type CompactionEntry,
+	type CustomMessageEntry,
+	type ExtensionAPI,
+	type ExtensionContext,
+	type SessionEntry,
+	VERSION,
+} from "@earendil-works/pi-coding-agent";
+
+const SCOPE_NAME = "pi.agent-trace";
+const SCOPE_VERSION = "1";
+const KIND_INTERNAL = 1;
+const KIND_CLIENT = 3;
+const STATUS_OK = 1;
+const STATUS_ERROR = 2;
+const TRACE_PARENT_RE = /^([0-9a-f]{32})-([0-9a-f]{16})$/;
+const NS_PER_MS = 1_000_000n;
+
+type OtlpValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type OtlpAttr = { key: string; value: OtlpValue };
+
+type OtlpStatus = { code: number; message?: string };
+
+type RunTrigger = "prompt" | "continuation" | "wakeup";
+
+interface SpanRec {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: bigint;
+	startAttrs: OtlpAttr[];
+	endTimeUnixNano?: bigint;
+	endAttrs?: OtlpAttr[];
+	status?: OtlpStatus;
+	endWritten: boolean;
+}
+
+interface ToolRec {
+	span: SpanRec;
+	toolCallId: string;
+	toolName: string;
+	endedAt?: bigint;
+	endOrder?: number;
+}
+
+interface ChatRec {
+	span: SpanRec;
+	message?: AssistantMessage;
+}
+
+interface TurnRec {
+	span: SpanRec;
+	index: number;
+	chat?: ChatRec;
+	tools: ToolRec[];
+	assistant?: AssistantMessage;
+}
+
+interface RunRec {
+	span: SpanRec;
+	trigger: RunTrigger;
+	turnCount: number;
+	afterCompaction?: string;
+	initialUsers: AgentMessage[];
+	initialCustoms: AgentMessage[];
+	steers: AgentMessage[];
+	seenAssistant: boolean;
+	turn?: TurnRec;
+}
+
+function str(key: string, value: string): OtlpAttr {
+	return { key, value: { stringValue: value } };
+}
+
+function int(key: string, value: number | bigint): OtlpAttr {
+	return { key, value: { intValue: String(value) } };
+}
+
+function bool(key: string, value: boolean): OtlpAttr {
+	return { key, value: { boolValue: value } };
+}
+
+function strs(key: string, values: string[]): OtlpAttr {
+	return { key, value: { arrayValue: { values: values.map((value) => ({ stringValue: value })) } } };
+}
+
+function attrKey(attr: OtlpAttr): string {
+	return attr.key;
+}
+
+function mergeAttrs(start: OtlpAttr[], extra: OtlpAttr[]): OtlpAttr[] {
+	const seen = new Set(start.map(attrKey));
+	const out = start.slice();
+	for (const attr of extra) {
+		if (seen.has(attr.key)) continue;
+		seen.add(attr.key);
+		out.push(attr);
+	}
+	return out;
+}
+
+function hexId(bytes: number): string {
+	return randomBytes(bytes).toString("hex");
+}
+
+function traceIdFromSessionId(sessionId: string): string {
+	return createHash("sha256").update(sessionId).digest("hex").slice(0, 32);
+}
+
+function parseTraceParent(value: string | undefined): { traceId: string; spanId: string } | undefined {
+	if (!value) return undefined;
+	const match = TRACE_PARENT_RE.exec(value);
+	if (!match) return undefined;
+	return { traceId: match[1], spanId: match[2] };
+}
+
+function nowNs(): bigint {
+	return BigInt(Date.now()) * NS_PER_MS;
+}
+
+function msToNs(ms: number): bigint {
+	return BigInt(ms) * NS_PER_MS;
+}
+
+function isAssistant(message: AgentMessage): message is AssistantMessage {
+	return message.role === "assistant";
+}
+
+function isCustom(message: AgentMessage): message is AgentMessage & { role: "custom"; customType: string } {
+	return message.role === "custom";
+}
+
+function extractText(value: unknown): string {
+	if (typeof value === "string") return value;
+	if (!value || typeof value !== "object") return value == null ? "" : String(value);
+	const record = value as { content?: unknown; text?: unknown };
+	if (typeof record.text === "string" && record.content === undefined) return record.text;
+	if (Array.isArray(record.content)) {
+		return record.content
+			.map((part) => {
+				if (typeof part === "string") return part;
+				if (
+					part &&
+					typeof part === "object" &&
+					"text" in part &&
+					typeof (part as { text: unknown }).text === "string"
+				) {
+					return (part as { text: string }).text;
+				}
+				return "";
+			})
+			.join("");
+	}
+	if (typeof record.text === "string") return record.text;
+	return "";
+}
+
+function assistantErrorMessage(message: AssistantMessage): string {
+	return message.errorMessage || "aborted";
+}
+
+function isAssistantError(message: AssistantMessage): boolean {
+	return message.stopReason === "error" || message.stopReason === "aborted";
+}
+
+class AgentTracer {
+	private readonly pi: ExtensionAPI;
+	private readonly originalParent = process.env.PI_AGENT_TRACE_PARENT;
+	private readonly inheritedParent = parseTraceParent(process.env.PI_AGENT_TRACE_PARENT);
+
+	private sessionId?: string;
+	private sessionDir?: string;
+	private filePath?: string;
+	private traceId?: string;
+	private resourceAttrs: OtlpAttr[] = [];
+	private lastEndNs = 0n;
+	private writeErrorReported = false;
+	private referencedIds = new Set<string>();
+
+	private seenBeforeAgentStart = false;
+	private settled = true;
+	private pendingAfterCompaction?: string;
+
+	private run?: RunRec;
+	private compaction?: { span: SpanRec; reason: string; willRetry: boolean };
+	private runningTools: ToolRec[] = [];
+	private toolEndSeq = 0;
+
+	constructor(pi: ExtensionAPI) {
+		this.pi = pi;
+	}
+
+	bind(ctx: ExtensionContext): void {
+		if (this.sessionId) return;
+		const sessionManager = ctx.sessionManager;
+		this.sessionId = sessionManager.getSessionId();
+		this.sessionDir = sessionManager.getSessionDir();
+		const inherited = this.inheritedParent;
+		this.traceId = inherited?.traceId ?? traceIdFromSessionId(this.sessionId);
+		const override = process.env.PI_AGENT_TRACE_FILE;
+		this.filePath =
+			override && override.length > 0 ? override : join(this.sessionDir, "traces", `${this.sessionId}.otlp.jsonl`);
+		this.resourceAttrs = [
+			str("service.name", "pi"),
+			str("service.version", VERSION),
+			str("pi.session.id", this.sessionId),
+			int("process.pid", process.pid),
+		];
+	}
+
+	onBeforeAgentStart(): void {
+		this.seenBeforeAgentStart = true;
+	}
+
+	onAgentStart(_event: unknown, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const trigger: RunTrigger = this.seenBeforeAgentStart ? "prompt" : this.settled ? "wakeup" : "continuation";
+		this.seenBeforeAgentStart = false;
+		this.settled = false;
+		const span = this.startSpan({
+			name: "pi.run",
+			kind: KIND_INTERNAL,
+			parentSpanId: this.rootParentId(),
+			attrs: [str("pi.run.trigger", trigger)],
+		});
+		this.run = {
+			span,
+			trigger,
+			turnCount: 0,
+			afterCompaction: trigger === "continuation" ? this.pendingAfterCompaction : undefined,
+			initialUsers: [],
+			initialCustoms: [],
+			steers: [],
+			seenAssistant: false,
+		};
+	}
+
+	onAgentEnd(_event: unknown, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const run = this.run;
+		if (!run) return;
+		if (run.turn) this.endTurn(ctx, run.turn);
+		const extra: OtlpAttr[] = [int("pi.run.turn_count", run.turnCount)];
+		const entryId = this.resolveRunEntryId(ctx, run);
+		if (entryId) extra.push(str("pi.session.entry_id", entryId));
+		else if (run.trigger === "continuation" && run.afterCompaction) {
+			extra.push(str("pi.run.after_compaction", run.afterCompaction));
+		}
+		const steerIds = this.resolveSteerIds(ctx, run);
+		extra.push(int("pi.run.steer_count", run.steers.length));
+		extra.push(strs("pi.run.steer_entry_ids", steerIds));
+		this.endSpan(run.span, extra, { code: STATUS_OK });
+		this.run = undefined;
+		this.pendingAfterCompaction = undefined;
+	}
+
+	onAgentSettled(): void {
+		this.settled = true;
+	}
+
+	onTurnStart(event: { turnIndex: number; timestamp: number }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const run = this.run;
+		if (!run) return;
+		run.turnCount += 1;
+		const startNs = this.clampStart(msToNs(event.timestamp), run.span.startTimeUnixNano);
+		const span = this.startSpan({
+			name: "pi.turn",
+			kind: KIND_INTERNAL,
+			parentSpanId: run.span.spanId,
+			attrs: [int("pi.turn.index", event.turnIndex)],
+			startNs,
+		});
+		run.turn = { span, index: event.turnIndex, tools: [] };
+	}
+
+	onTurnEnd(
+		event: { message: AgentMessage; toolResults: Array<{ toolCallId: string }> },
+		ctx: ExtensionContext,
+	): void {
+		this.bind(ctx);
+		const turn = this.run?.turn;
+		if (!turn) return;
+		if (isAssistant(event.message)) turn.assistant = event.message;
+		this.endTurn(ctx, turn);
+	}
+
+	onMessageStart(event: { message: AgentMessage }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const message = event.message;
+		if (!isAssistant(message)) return;
+		const turn = this.run?.turn;
+		if (!turn) return;
+		const model = message.model || "unknown";
+		const span = this.startSpan({
+			name: `chat ${model}`,
+			kind: KIND_CLIENT,
+			parentSpanId: turn.span.spanId,
+			attrs: [
+				str("gen_ai.operation.name", "chat"),
+				str("gen_ai.system", message.provider || "unknown"),
+				str("gen_ai.request.model", model),
+			],
+			notBefore: turn.span.startTimeUnixNano,
+		});
+		turn.chat = { span, message };
+	}
+
+	onMessageEnd(event: { message: AgentMessage }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const message = event.message;
+		if (!isAssistant(message)) {
+			this.trackUserOrCustom(message);
+			return;
+		}
+		const turn = this.run?.turn;
+		if (!turn?.chat) return;
+		if (this.run) this.run.seenAssistant = true;
+		turn.assistant = message;
+		turn.chat.message = message;
+		const extra = this.chatEndAttrs(message);
+		const status: OtlpStatus = isAssistantError(message)
+			? { code: STATUS_ERROR, message: assistantErrorMessage(message) }
+			: { code: STATUS_OK };
+		this.holdEnd(turn.chat.span, extra, status);
+	}
+
+	onToolExecutionStart(event: { toolCallId: string; toolName: string }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.run?.turn;
+		if (!turn) return;
+		this.flushChatEnd(ctx, turn);
+		const afterChat = turn.chat?.span.endTimeUnixNano;
+		const span = this.startSpan({
+			name: `execute_tool ${event.toolName}`,
+			kind: KIND_INTERNAL,
+			parentSpanId: turn.span.spanId,
+			attrs: [
+				str("gen_ai.operation.name", "execute_tool"),
+				str("gen_ai.tool.name", event.toolName),
+				str("gen_ai.tool.call.id", event.toolCallId),
+			],
+			notBefore: afterChat !== undefined ? afterChat + 1n : turn.span.startTimeUnixNano,
+		});
+		const tool: ToolRec = { span, toolCallId: event.toolCallId, toolName: event.toolName };
+		turn.tools.push(tool);
+		this.runningTools.push(tool);
+		this.syncTraceParentEnv();
+	}
+
+	onToolExecutionEnd(event: { toolCallId: string; result: unknown; isError: boolean }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const turn = this.run?.turn;
+		const tool = turn?.tools.find(
+			(item) => item.toolCallId === event.toolCallId && !item.span.endWritten && item.endedAt === undefined,
+		);
+		if (!tool) {
+			this.dropRunningTool(event.toolCallId);
+			this.syncTraceParentEnv();
+			return;
+		}
+		const extra: OtlpAttr[] = [bool("pi.tool.is_error", event.isError)];
+		const status: OtlpStatus = event.isError
+			? { code: STATUS_ERROR, message: extractText(event.result) }
+			: { code: STATUS_OK };
+		this.holdEnd(tool.span, extra, status);
+		tool.endedAt = tool.span.endTimeUnixNano;
+		tool.endOrder = this.toolEndSeq++;
+		this.dropRunningTool(event.toolCallId);
+		this.syncTraceParentEnv();
+	}
+
+	onSessionBeforeCompact(event: { reason: string; willRetry: boolean }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const span = this.startSpan({
+			name: "pi.compaction",
+			kind: KIND_INTERNAL,
+			parentSpanId: this.rootParentId(),
+			attrs: [str("pi.compaction.reason", event.reason), bool("pi.compaction.will_retry", event.willRetry)],
+		});
+		this.compaction = { span, reason: event.reason, willRetry: event.willRetry };
+	}
+
+	onSessionCompact(event: { compactionEntry: CompactionEntry; willRetry: boolean }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const compaction = this.compaction;
+		if (!compaction) return;
+		this.markReferenced(event.compactionEntry.id);
+		if (event.willRetry) this.pendingAfterCompaction = event.compactionEntry.id;
+		const extra: OtlpAttr[] = [
+			int("pi.compaction.tokens_before", event.compactionEntry.tokensBefore),
+			str("pi.compaction.first_kept_entry_id", event.compactionEntry.firstKeptEntryId),
+			str("pi.session.entry_id", event.compactionEntry.id),
+		];
+		const usage = event.compactionEntry.usage;
+		if (usage) {
+			extra.push(int("gen_ai.usage.input_tokens", usage.input));
+			extra.push(int("gen_ai.usage.output_tokens", usage.output));
+		}
+		this.endSpan(compaction.span, extra, { code: STATUS_OK });
+		this.compaction = undefined;
+	}
+
+	onSessionCompactFailed(event: { errorMessage?: string; aborted?: boolean }, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const compaction = this.compaction;
+		if (!compaction) return;
+		this.endSpan(compaction.span, [], {
+			code: STATUS_ERROR,
+			message: event.errorMessage || "aborted",
+		});
+		this.compaction = undefined;
+	}
+
+	onSessionShutdown(_event: unknown, ctx: ExtensionContext): void {
+		this.bind(ctx);
+		const shutdown: OtlpStatus = { code: STATUS_ERROR, message: "shutdown" };
+		const turn = this.run?.turn;
+		if (turn?.chat && !turn.chat.span.endWritten) {
+			turn.chat.span.endTimeUnixNano = undefined;
+			const entryId = turn.chat.message ? this.findAssistantEntryId(ctx, turn.chat.message) : undefined;
+			const extra = entryId ? [str("pi.session.entry_id", entryId)] : [];
+			this.endSpan(turn.chat.span, mergeAttrs(turn.chat.span.endAttrs ?? [], extra), shutdown);
+		}
+		if (turn) {
+			for (const tool of this.toolsInEndOrder(turn)) {
+				if (tool.span.endWritten) continue;
+				tool.span.endTimeUnixNano = undefined;
+				const entryId = this.findToolEntryId(ctx, tool.toolCallId);
+				const extra = entryId ? [str("pi.session.entry_id", entryId)] : [];
+				this.endSpan(tool.span, mergeAttrs(tool.span.endAttrs ?? [], extra), shutdown);
+			}
+			if (!turn.span.endWritten) this.endSpan(turn.span, this.turnEndAttrs(turn), shutdown);
+		}
+		if (this.compaction && !this.compaction.span.endWritten) {
+			this.compaction.span.endTimeUnixNano = undefined;
+			this.endSpan(this.compaction.span, [], shutdown);
+			this.compaction = undefined;
+		}
+		if (this.run && !this.run.span.endWritten) {
+			const extra: OtlpAttr[] = [int("pi.run.turn_count", this.run.turnCount)];
+			const entryId = this.resolveRunEntryId(ctx, this.run);
+			if (entryId) extra.push(str("pi.session.entry_id", entryId));
+			else if (this.run.trigger === "continuation" && this.run.afterCompaction) {
+				extra.push(str("pi.run.after_compaction", this.run.afterCompaction));
+			}
+			extra.push(int("pi.run.steer_count", this.run.steers.length));
+			extra.push(strs("pi.run.steer_entry_ids", this.resolveSteerIds(ctx, this.run)));
+			this.endSpan(this.run.span, extra, shutdown);
+			this.run = undefined;
+		}
+		this.runningTools = [];
+		this.restoreTraceParentEnv();
+	}
+
+	private trackUserOrCustom(message: AgentMessage): void {
+		const run = this.run;
+		if (!run) return;
+		if (message.role !== "user" && !isCustom(message)) return;
+		if (!run.seenAssistant) {
+			if (message.role === "user") run.initialUsers.push(message);
+			else run.initialCustoms.push(message);
+			return;
+		}
+		run.steers.push(message);
+	}
+
+	private chatEndAttrs(message: AssistantMessage, entryId?: string): OtlpAttr[] {
+		const usage = message.usage;
+		const attrs: OtlpAttr[] = [
+			int("gen_ai.usage.input_tokens", usage?.input ?? 0),
+			int("gen_ai.usage.output_tokens", usage?.output ?? 0),
+			int("pi.usage.cache_read_tokens", usage?.cacheRead ?? 0),
+			int("pi.usage.cache_write_tokens", usage?.cacheWrite ?? 0),
+			strs("gen_ai.response.finish_reasons", [message.stopReason]),
+		];
+		if (entryId) attrs.push(str("pi.session.entry_id", entryId));
+		return attrs;
+	}
+
+	private turnEndAttrs(turn: TurnRec): OtlpAttr[] {
+		const assistant = turn.assistant ?? turn.chat?.message;
+		const attrs: OtlpAttr[] = [int("pi.turn.tool_call_count", turn.tools.length)];
+		if (assistant) attrs.push(str("pi.turn.stop_reason", assistant.stopReason));
+		return attrs;
+	}
+
+	private endTurn(ctx: ExtensionContext, turn: TurnRec): void {
+		if (turn.span.endWritten) {
+			if (this.run?.turn === turn) this.run.turn = undefined;
+			return;
+		}
+		this.flushChatEnd(ctx, turn);
+		this.flushToolEnds(ctx, turn);
+		const assistant = turn.assistant ?? turn.chat?.message;
+		const extra = this.turnEndAttrs(turn);
+		const status: OtlpStatus =
+			assistant && isAssistantError(assistant)
+				? { code: STATUS_ERROR, message: assistantErrorMessage(assistant) }
+				: { code: STATUS_OK };
+		this.endSpan(turn.span, extra, status);
+		if (this.run?.turn === turn) this.run.turn = undefined;
+	}
+
+	private flushChatEnd(ctx: ExtensionContext, turn: TurnRec): void {
+		const chat = turn.chat;
+		if (!chat || chat.span.endWritten) return;
+		const message = chat.message ?? turn.assistant;
+		if (message && this.run) this.run.seenAssistant = true;
+		const entryId = message ? this.findAssistantEntryId(ctx, message) : undefined;
+		if (chat.span.endAttrs) {
+			if (entryId) chat.span.endAttrs = mergeAttrs(chat.span.endAttrs, [str("pi.session.entry_id", entryId)]);
+			this.writeEnd(chat.span);
+			return;
+		}
+		if (!message) {
+			this.endSpan(chat.span, [], { code: STATUS_OK });
+			return;
+		}
+		const extra = this.chatEndAttrs(message, entryId);
+		const status: OtlpStatus = isAssistantError(message)
+			? { code: STATUS_ERROR, message: assistantErrorMessage(message) }
+			: { code: STATUS_OK };
+		this.endSpan(chat.span, extra, status);
+	}
+
+	private toolsInEndOrder(turn: TurnRec): ToolRec[] {
+		return turn.tools
+			.slice()
+			.sort((a, b) => (a.endOrder ?? Number.MAX_SAFE_INTEGER) - (b.endOrder ?? Number.MAX_SAFE_INTEGER));
+	}
+
+	private flushToolEnds(ctx: ExtensionContext, turn: TurnRec): void {
+		const tools = this.toolsInEndOrder(turn);
+		for (const tool of tools) {
+			if (tool.span.endWritten) continue;
+			const entryId = this.findToolEntryId(ctx, tool.toolCallId);
+			if (tool.span.endAttrs) {
+				if (entryId) tool.span.endAttrs = mergeAttrs(tool.span.endAttrs, [str("pi.session.entry_id", entryId)]);
+				this.writeEnd(tool.span);
+			} else {
+				const extra: OtlpAttr[] = [bool("pi.tool.is_error", false)];
+				if (entryId) extra.push(str("pi.session.entry_id", entryId));
+				this.endSpan(tool.span, extra, { code: STATUS_OK });
+			}
+		}
+	}
+
+	private rootParentId(): string | undefined {
+		return this.inheritedParent?.spanId;
+	}
+
+	private startSpan(opts: {
+		name: string;
+		kind: number;
+		parentSpanId?: string;
+		attrs: OtlpAttr[];
+		startNs?: bigint;
+		notBefore?: bigint;
+	}): SpanRec {
+		const startNs = this.clampStart(opts.startNs ?? nowNs(), opts.notBefore);
+		const span: SpanRec = {
+			traceId: this.traceId!,
+			spanId: hexId(8),
+			parentSpanId: opts.parentSpanId,
+			name: opts.name,
+			kind: opts.kind,
+			startTimeUnixNano: startNs,
+			startAttrs: opts.attrs,
+			endWritten: false,
+		};
+		this.writeStart(span);
+		return span;
+	}
+
+	private holdEnd(span: SpanRec, extra: OtlpAttr[], status: OtlpStatus): void {
+		span.endTimeUnixNano = this.clampEnd(span.startTimeUnixNano, nowNs(), false);
+		span.endAttrs = extra;
+		span.status = status;
+	}
+
+	private endSpan(span: SpanRec, extra: OtlpAttr[], status: OtlpStatus): void {
+		if (span.endWritten) return;
+		span.endTimeUnixNano = this.clampEnd(span.startTimeUnixNano, span.endTimeUnixNano ?? nowNs(), true);
+		span.endAttrs = extra;
+		span.status = status;
+		this.writeEnd(span);
+	}
+
+	private clampStart(candidate: bigint, notBefore?: bigint): bigint {
+		let t = candidate;
+		if (notBefore !== undefined && t < notBefore) t = notBefore;
+		return t;
+	}
+
+	private clampEnd(start: bigint, candidate: bigint, commit: boolean): bigint {
+		let t = candidate;
+		if (t < start) t = start;
+		if (commit) {
+			if (t < this.lastEndNs) t = this.lastEndNs;
+			this.lastEndNs = t;
+		}
+		return t;
+	}
+
+	private writeStart(span: SpanRec): void {
+		this.appendSpan({
+			traceId: span.traceId,
+			spanId: span.spanId,
+			parentSpanId: span.parentSpanId,
+			name: span.name,
+			kind: span.kind,
+			startTimeUnixNano: span.startTimeUnixNano.toString(),
+			attributes: mergeAttrs(span.startAttrs, [str("pi.span.phase", "start")]),
+		});
+	}
+
+	private writeEnd(span: SpanRec): void {
+		if (span.endWritten) return;
+		const endNs = this.clampEnd(span.startTimeUnixNano, span.endTimeUnixNano ?? nowNs(), true);
+		span.endTimeUnixNano = endNs;
+		const payload: Record<string, unknown> = {
+			traceId: span.traceId,
+			spanId: span.spanId,
+			name: span.name,
+			kind: span.kind,
+			startTimeUnixNano: span.startTimeUnixNano.toString(),
+			endTimeUnixNano: endNs.toString(),
+			attributes: mergeAttrs(span.startAttrs, span.endAttrs ?? []),
+			status: span.status ?? { code: STATUS_OK },
+		};
+		if (span.parentSpanId) payload.parentSpanId = span.parentSpanId;
+		this.appendSpan(payload);
+		span.endWritten = true;
+	}
+
+	private appendSpan(span: Record<string, unknown>): void {
+		if (span.parentSpanId === undefined) delete span.parentSpanId;
+		const line = `${JSON.stringify({
+			resourceSpans: [
+				{
+					resource: { attributes: this.resourceAttrs },
+					scopeSpans: [
+						{
+							scope: { name: SCOPE_NAME, version: SCOPE_VERSION },
+							spans: [span],
+						},
+					],
+				},
+			],
+		})}\n`;
+		this.appendLine(line);
+	}
+
+	private appendLine(line: string): void {
+		const path = this.filePath;
+		if (!path) return;
+		try {
+			mkdirSync(dirname(path), { recursive: true });
+			appendFileSync(path, line);
+		} catch {
+			this.reportWriteError(path);
+		}
+	}
+
+	private reportWriteError(path: string): void {
+		if (this.writeErrorReported) return;
+		this.writeErrorReported = true;
+		try {
+			this.pi.sendMessage(
+				{
+					customType: "agent-trace",
+					content: `agent-trace: cannot write ${path}`,
+					display: false,
+				},
+				{ triggerTurn: false },
+			);
+		} catch {
+			// Reporting must never throw into pi.
+		}
+	}
+
+	private dropRunningTool(toolCallId: string): void {
+		const index = this.runningTools.findIndex((tool) => tool.toolCallId === toolCallId);
+		if (index >= 0) this.runningTools.splice(index, 1);
+	}
+
+	private syncTraceParentEnv(): void {
+		if (this.runningTools.length === 0) {
+			this.restoreTraceParentEnv();
+			return;
+		}
+		const current = this.runningTools[this.runningTools.length - 1];
+		process.env.PI_AGENT_TRACE_PARENT = `${this.traceId}-${current.span.spanId}`;
+	}
+
+	private restoreTraceParentEnv(): void {
+		if (this.originalParent === undefined) delete process.env.PI_AGENT_TRACE_PARENT;
+		else process.env.PI_AGENT_TRACE_PARENT = this.originalParent;
+	}
+
+	private branch(ctx: ExtensionContext): SessionEntry[] {
+		return ctx.sessionManager.getBranch();
+	}
+
+	private markReferenced(id: string): void {
+		this.referencedIds.add(id);
+	}
+
+	private takeEntry(
+		ctx: ExtensionContext,
+		predicate: (entry: SessionEntry) => boolean,
+		fromEnd = false,
+	): string | undefined {
+		const branch = this.branch(ctx);
+		const list = fromEnd ? [...branch].reverse() : branch;
+		for (const entry of list) {
+			if (this.referencedIds.has(entry.id)) continue;
+			if (!predicate(entry)) continue;
+			this.referencedIds.add(entry.id);
+			return entry.id;
+		}
+		return undefined;
+	}
+
+	private findAssistantEntryId(ctx: ExtensionContext, message: AssistantMessage): string | undefined {
+		return (
+			this.takeEntry(ctx, (entry) => entry.type === "message" && entry.message === message, true) ??
+			this.takeEntry(
+				ctx,
+				(entry) =>
+					entry.type === "message" &&
+					entry.message.role === "assistant" &&
+					(entry.message as AssistantMessage).timestamp === message.timestamp,
+				true,
+			)
+		);
+	}
+
+	private findToolEntryId(ctx: ExtensionContext, toolCallId: string): string | undefined {
+		return this.takeEntry(
+			ctx,
+			(entry) =>
+				entry.type === "message" &&
+				entry.message.role === "toolResult" &&
+				"toolCallId" in entry.message &&
+				entry.message.toolCallId === toolCallId,
+			true,
+		);
+	}
+
+	private findUserEntryId(ctx: ExtensionContext, message: AgentMessage): string | undefined {
+		return (
+			this.takeEntry(ctx, (entry) => entry.type === "message" && entry.message === message) ??
+			this.takeEntry(
+				ctx,
+				(entry) =>
+					entry.type === "message" &&
+					entry.message.role === "user" &&
+					entry.message.timestamp === message.timestamp,
+			)
+		);
+	}
+
+	private findCustomEntryId(
+		ctx: ExtensionContext,
+		message: AgentMessage & { customType: string },
+	): string | undefined {
+		return this.takeEntry(ctx, (entry) => {
+			if (entry.type !== "custom_message") return false;
+			const custom = entry as CustomMessageEntry;
+			return (
+				custom.customType === message.customType && extractText(custom.content) === extractText(message.content)
+			);
+		});
+	}
+
+	private resolveRunEntryId(ctx: ExtensionContext, run: RunRec): string | undefined {
+		if (run.trigger === "prompt") {
+			const user = run.initialUsers[0];
+			return user ? this.findUserEntryId(ctx, user) : undefined;
+		}
+		const custom = run.initialCustoms[0];
+		if (custom && isCustom(custom)) return this.findCustomEntryId(ctx, custom);
+		const user = run.initialUsers[0];
+		return user ? this.findUserEntryId(ctx, user) : undefined;
+	}
+
+	private resolveSteerIds(ctx: ExtensionContext, run: RunRec): string[] {
+		const ids: string[] = [];
+		for (const message of run.steers) {
+			const id = isCustom(message) ? this.findCustomEntryId(ctx, message) : this.findUserEntryId(ctx, message);
+			if (id) ids.push(id);
+		}
+		return ids;
+	}
+}
+
+export default function (pi: ExtensionAPI) {
+	const tracer = new AgentTracer(pi);
+
+	pi.on("session_start", (_event, ctx) => {
+		tracer.bind(ctx);
+	});
+	pi.on("before_agent_start", () => {
+		tracer.onBeforeAgentStart();
+	});
+	pi.on("agent_start", (event, ctx) => {
+		tracer.onAgentStart(event, ctx);
+	});
+	pi.on("agent_end", (event, ctx) => {
+		tracer.onAgentEnd(event, ctx);
+	});
+	pi.on("agent_settled", () => {
+		tracer.onAgentSettled();
+	});
+	pi.on("turn_start", (event, ctx) => {
+		tracer.onTurnStart(event, ctx);
+	});
+	pi.on("turn_end", (event, ctx) => {
+		tracer.onTurnEnd(event, ctx);
+	});
+	pi.on("message_start", (event, ctx) => {
+		tracer.onMessageStart(event, ctx);
+	});
+	pi.on("message_end", (event, ctx) => {
+		tracer.onMessageEnd(event, ctx);
+	});
+	pi.on("tool_execution_start", (event, ctx) => {
+		tracer.onToolExecutionStart(event, ctx);
+	});
+	pi.on("tool_execution_end", (event, ctx) => {
+		tracer.onToolExecutionEnd(event, ctx);
+	});
+	pi.on("session_before_compact", (event, ctx) => {
+		tracer.onSessionBeforeCompact(event, ctx);
+	});
+	pi.on("session_compact", (event, ctx) => {
+		tracer.onSessionCompact(event, ctx);
+	});
+	pi.on("session_compact_failed", (event, ctx) => {
+		tracer.onSessionCompactFailed(event, ctx);
+	});
+	pi.on("session_shutdown", (event, ctx) => {
+		tracer.onSessionShutdown(event, ctx);
+	});
+}
