+/**
+ * Agent-trace extension.
+ *
+ * Writes the agent loop as an OpenTelemetry OTLP/JSONL trace: one span per run,
+ * turn, provider chat, tool execution, and compaction. Each span is appended
+ * twice (start line, then end line) so a reader tailing the file sees in-progress
+ * work. Nothing is rewritten; reloads and later processes append to the same file.
+ *
+ * Usage: pi -e packages/coding-agent/examples/extensions/agent-trace
+ */
+
+import { createHash, randomBytes } from "node:crypto";
+import { appendFileSync, mkdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { type ExtensionAPI, type ExtensionContext, VERSION } from "@earendil-works/pi-coding-agent";
+
+const SCOPE_NAME = "pi.agent-trace";
+const SCOPE_VERSION = "1";
+const WRITE_FAILURE_TYPE = "agent-trace";
+
+const KIND_INTERNAL = 1;
+const KIND_CLIENT = 3;
+const STATUS_OK = 1;
+const STATUS_ERROR = 2;
+
+type AttrValue =
+	| { stringValue: string }
+	| { intValue: string }
+	| { boolValue: boolean }
+	| { arrayValue: { values: Array<{ stringValue: string }> } };
+
+type Attribute = { key: string; value: AttrValue };
+
+type OtlpStatus = { code: typeof STATUS_OK } | { code: typeof STATUS_ERROR; message: string };
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: typeof KIND_INTERNAL | typeof KIND_CLIENT;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Attribute[];
+	status?: OtlpStatus;
+};
+
+type AttrInput = string | number | boolean | string[];
+
+type OpenSpan = {
+	name: string;
+	kind: OtlpSpan["kind"];
+	spanId: string;
+	parentSpanId?: string;
+	startTimeUnixNano: bigint;
+	startAttributes: Attribute[];
+	endWritten: boolean;
+	/** Recorded when the span conceptually ends; the end line may be written later. */
+	endTimeUnixNano?: bigint;
+	status?: OtlpStatus;
+};
+
+type TrackedMessage = {
+	role: "user" | "custom";
+	message: {
+		role: string;
+		customType?: string;
+		content?: unknown;
+		timestamp?: number;
+	};
+	beforeFirstAssistant: boolean;
+};
+
+type AssistantMessageLike = {
+	role: string;
+	provider?: string;
+	model?: string;
+	usage?: { input?: number; output?: number; cacheRead?: number; cacheWrite?: number };
+	stopReason?: string;
+	errorMessage?: string;
+	timestamp?: number;
+};
+
+type ToolSpanState = {
+	span: OpenSpan;
+	toolCallId: string;
+	toolName: string;
+	isError?: boolean;
+	resultText?: string;
+};
+
+type TurnState = {
+	span: OpenSpan;
+	chat?: OpenSpan;
+	assistantMessage?: AssistantMessageLike;
+	tools: ToolSpanState[];
+	toolsEndedInOrder: ToolSpanState[];
+	toolCallCount: number;
+};
+
+type RunState = {
+	span: OpenSpan;
+	trigger: "prompt" | "continuation" | "wakeup";
+	currentTurn?: TurnState;
+	completedTurnCount: number;
+	consumed: TrackedMessage[];
+	sawAssistant: boolean;
+};
+
+type CompactionState = {
+	span: OpenSpan;
+};
+
+function attr(key: string, value: AttrInput): Attribute {
+	if (typeof value === "string") {
+		return { key, value: { stringValue: value } };
+	}
+	if (typeof value === "boolean") {
+		return { key, value: { boolValue: value } };
+	}
+	if (typeof value === "number") {
+		return { key, value: { intValue: String(Math.trunc(value)) } };
+	}
+	return {
+		key,
+		value: { arrayValue: { values: value.map((item) => ({ stringValue: item })) } },
+	};
+}
+
+function attributes(entries: Array<[string, AttrInput | undefined]>): Attribute[] {
+	const out: Attribute[] = [];
+	const seen = new Set<string>();
+	for (const [key, value] of entries) {
+		if (value === undefined || seen.has(key)) {
+			continue;
+		}
+		seen.add(key);
+		out.push(attr(key, value));
+	}
+	return out;
+}
+
+function withoutPhase(attrs: Attribute[]): Attribute[] {
+	return attrs.filter((item) => item.key !== "pi.span.phase");
+}
+
+function mergeAttributes(base: Attribute[], extra: Attribute[]): Attribute[] {
+	const seen = new Set(base.map((item) => item.key));
+	const out = [...base];
+	for (const item of extra) {
+		if (seen.has(item.key)) {
+			continue;
+		}
+		seen.add(item.key);
+		out.push(item);
+	}
+	return out;
+}
+
+function traceIdFromSessionId(sessionId: string): string {
+	return createHash("sha256").update(sessionId).digest("hex").slice(0, 32);
+}
+
+function newSpanId(): string {
+	return randomBytes(8).toString("hex");
+}
+
+function textFromContent(content: unknown): string {
+	if (typeof content === "string") {
+		return content;
+	}
+	if (!Array.isArray(content)) {
+		return "";
+	}
+	return content
+		.map((block) => {
+			if (block && typeof block === "object" && (block as { type?: string }).type === "text") {
+				return String((block as { text?: string }).text ?? "");
+			}
+			return "";
+		})
+		.join("");
+}
+
+function textFromToolResult(result: unknown): string {
+	if (typeof result === "string") {
+		return result;
+	}
+	if (result && typeof result === "object" && "content" in result) {
+		return textFromContent((result as { content?: unknown }).content);
+	}
+	return "";
+}
+
+function contentsEqual(a: unknown, b: unknown): boolean {
+	if (a === b) {
+		return true;
+	}
+	try {
+		return JSON.stringify(a) === JSON.stringify(b);
+	} catch {
+		return false;
+	}
+}
+
+function isUserOrCustom(role: string): role is "user" | "custom" {
+	return role === "user" || role === "custom";
+}
+
+class Clock {
+	private last = 0n;
+	private lastEnd = 0n;
+
+	now(): bigint {
+		return this.stamp(BigInt(Date.now()) * 1_000_000n);
+	}
+
+	fromMillis(ms: number): bigint {
+		return this.stamp(BigInt(ms) * 1_000_000n);
+	}
+
+	endNow(): bigint {
+		return this.markEnd(this.now());
+	}
+
+	markEnd(ts: bigint): bigint {
+		const end = ts > this.lastEnd ? ts : this.lastEnd + 1n;
+		this.lastEnd = end;
+		if (end > this.last) {
+			this.last = end;
+		}
+		return end;
+	}
+
+	private stamp(preferred: bigint): bigint {
+		const ts = preferred > this.last ? preferred : this.last + 1n;
+		this.last = ts;
+		return ts;
+	}
+}
+
+class AgentTracer {
+	private readonly clock = new Clock();
+	private sessionId: string | undefined;
+	private traceId: string | undefined;
+	private writeFailureReported = false;
+	private sawBeforeAgentStart = false;
+	private awaitingSettled = false;
+	private run: RunState | undefined;
+	private compaction: CompactionState | undefined;
+	private readonly pi: ExtensionAPI;
+
+	constructor(pi: ExtensionAPI) {
+		this.pi = pi;
+	}
+
+	subscribe(): void {
+		this.pi.on("before_agent_start", () => {
+			this.sawBeforeAgentStart = true;
+		});
+		this.pi.on("agent_start", (_event, ctx) => this.onAgentStart(ctx));
+		this.pi.on("agent_end", (_event, ctx) => this.onAgentEnd(ctx));
+		this.pi.on("agent_settled", () => {
+			this.awaitingSettled = false;
+		});
+		this.pi.on("turn_start", (event, ctx) => this.onTurnStart(event.turnIndex, event.timestamp, ctx));
+		this.pi.on("turn_end", (event, ctx) => this.onTurnEnd(event, ctx));
+		this.pi.on("message_start", (event, ctx) => this.onMessageStart(event.message, ctx));
+		this.pi.on("message_end", (event, ctx) => this.onMessageEnd(event.message, ctx));
+		this.pi.on("tool_execution_start", (event, ctx) => this.onToolStart(event, ctx));
+		this.pi.on("tool_execution_end", (event, ctx) => this.onToolEnd(event, ctx));
+		this.pi.on("session_before_compact", (event, ctx) => this.onCompactStart(event, ctx));
+		this.pi.on("session_compact", (event, ctx) => this.onCompactSuccess(event, ctx));
+		this.pi.on("session_compact_failed", (event, ctx) => this.onCompactFailed(event, ctx));
+		this.pi.on("session_shutdown", (_event, ctx) => this.onShutdown(ctx));
+	}
+
+	private ensureTrace(ctx: ExtensionContext): string | undefined {
+		if (!this.sessionId) {
+			this.sessionId = ctx.sessionManager.getSessionId();
+			this.traceId = traceIdFromSessionId(this.sessionId);
+		}
+		return this.traceId;
+	}
+
+	private tracePath(ctx: ExtensionContext): string {
+		const override = process.env.PI_AGENT_TRACE_FILE;
+		if (override) {
+			return override;
+		}
+		return join(ctx.sessionManager.getSessionDir(), "traces", `${ctx.sessionManager.getSessionId()}.otlp.jsonl`);
+	}
+
+	private resourceAttributes(ctx: ExtensionContext): Attribute[] {
+		this.ensureTrace(ctx);
+		return attributes([
+			["service.name", "pi"],
+			["service.version", VERSION],
+			["pi.session.id", this.sessionId],
+			["process.pid", process.pid],
+		]);
+	}
+
+	private writeSpan(ctx: ExtensionContext, span: OtlpSpan): void {
+		const line = JSON.stringify({
+			resourceSpans: [
+				{
+					resource: { attributes: this.resourceAttributes(ctx) },
+					scopeSpans: [
+						{
+							scope: { name: SCOPE_NAME, version: SCOPE_VERSION },
+							spans: [span],
+						},
+					],
+				},
+			],
+		});
+		const path = this.tracePath(ctx);
+		try {
+			mkdirSync(dirname(path), { recursive: true });
+			appendFileSync(path, `${line}\n`);
+		} catch {
+			this.reportWriteFailure(path);
+		}
+	}
+
+	private reportWriteFailure(path: string): void {
+		if (this.writeFailureReported) {
+			return;
+		}
+		this.writeFailureReported = true;
+		try {
+			this.pi.sendMessage(
+				{
+					customType: WRITE_FAILURE_TYPE,
+					content: `agent-trace: cannot write ${path}`,
+					display: true,
+				},
+				{ triggerTurn: false },
+			);
+		} catch {
+			// Reporting must never throw into the agent loop.
+		}
+	}
+
+	private startSpan(
+		ctx: ExtensionContext,
+		input: {
+			name: string;
+			kind: OtlpSpan["kind"];
+			parentSpanId?: string;
+			startTimeUnixNano: bigint;
+			startAttributes: Attribute[];
+		},
+	): OpenSpan {
+		const span: OpenSpan = {
+			name: input.name,
+			kind: input.kind,
+			spanId: newSpanId(),
+			parentSpanId: input.parentSpanId,
+			startTimeUnixNano: input.startTimeUnixNano,
+			startAttributes: input.startAttributes,
+			endWritten: false,
+		};
+		this.writeSpan(ctx, this.toOtlp(span, { phase: "start" }));
+		return span;
+	}
+
+	private toOtlp(span: OpenSpan, options: { phase: "start" } | { phase: "end"; attributes: Attribute[] }): OtlpSpan {
+		const encoded: OtlpSpan = {
+			traceId: this.traceId ?? "",
+			spanId: span.spanId,
+			name: span.name,
+			kind: span.kind,
+			startTimeUnixNano: span.startTimeUnixNano.toString(),
+			attributes:
+				options.phase === "start"
+					? mergeAttributes(span.startAttributes, [attr("pi.span.phase", "start")])
+					: options.attributes,
+		};
+		if (span.parentSpanId) {
+			encoded.parentSpanId = span.parentSpanId;
+		}
+		if (options.phase === "end") {
+			encoded.endTimeUnixNano = (span.endTimeUnixNano ?? span.startTimeUnixNano).toString();
+			encoded.status = span.status ?? { code: STATUS_OK };
+		}
+		return encoded;
+	}
+
+	private writeEnd(
+		ctx: ExtensionContext,
+		span: OpenSpan,
+		extra: Attribute[],
+		status: OtlpStatus,
+		endTime: bigint,
+	): void {
+		if (span.endWritten) {
+			return;
+		}
+		span.endTimeUnixNano = endTime < span.startTimeUnixNano ? span.startTimeUnixNano : endTime;
+		span.status = status;
+		span.endWritten = true;
+		this.writeSpan(
+			ctx,
+			this.toOtlp(span, { phase: "end", attributes: mergeAttributes(withoutPhase(span.startAttributes), extra) }),
+		);
+	}
+
+	private assistantStatus(message: { stopReason?: string; errorMessage?: string }): OtlpStatus {
+		if (message.stopReason === "error" || message.stopReason === "aborted") {
+			return { code: STATUS_ERROR, message: message.errorMessage || "aborted" };
+		}
+		return { code: STATUS_OK };
+	}
+
+	private findMessageEntryId(
+		ctx: ExtensionContext,
+		message: { role: string; timestamp?: number; toolCallId?: string },
+	): string | undefined {
+		const branch = ctx.sessionManager.getBranch();
+		for (let i = branch.length - 1; i >= 0; i--) {
+			const entry = branch[i];
+			if (entry.type !== "message") {
+				continue;
+			}
+			if (entry.message === message) {
+				return entry.id;
+			}
+		}
+		for (let i = branch.length - 1; i >= 0; i--) {
+			const entry = branch[i];
+			if (entry.type !== "message" || entry.message.role !== message.role) {
+				continue;
+			}
+			if (message.role === "toolResult") {
+				if ((entry.message as { toolCallId?: string }).toolCallId === message.toolCallId) {
+					return entry.id;
+				}
+				continue;
+			}
+			if (entry.message.timestamp === message.timestamp) {
+				return entry.id;
+			}
+		}
+		return undefined;
+	}
+
+	private findCustomEntryId(
+		ctx: ExtensionContext,
+		message: { customType?: string; content?: unknown },
+	): string | undefined {
+		const branch = ctx.sessionManager.getBranch();
+		for (let i = branch.length - 1; i >= 0; i--) {
+			const entry = branch[i];
+			if (entry.type !== "custom_message") {
+				continue;
+			}
+			if (entry.customType === message.customType && contentsEqual(entry.content, message.content)) {
+				return entry.id;
+			}
+		}
+		return undefined;
+	}
+
+	private findEntryIdForTracked(ctx: ExtensionContext, tracked: TrackedMessage): string | undefined {
+		if (tracked.role === "custom") {
+			return this.findCustomEntryId(ctx, tracked.message);
+		}
+		return this.findMessageEntryId(ctx, tracked.message);
+	}
+
+	private triggerMessage(run: RunState): TrackedMessage | undefined {
+		if (run.trigger === "prompt") {
+			return run.consumed.find((item) => item.role === "user");
+		}
+		return run.consumed.find((item) => item.role === "custom") ?? run.consumed[0];
+	}
+
+	private steerMessages(run: RunState): TrackedMessage[] {
+		const trigger = this.triggerMessage(run);
+		const steers: TrackedMessage[] = [];
+		for (const item of run.consumed) {
+			if (item === trigger) {
+				continue;
+			}
+			if (item.message.customType === WRITE_FAILURE_TYPE) {
+				continue;
+			}
+			// Prompt-run custom messages before the first assistant are before_agent_start
+			// injections, not steering.
+			if (run.trigger === "prompt" && item.role === "custom" && item.beforeFirstAssistant) {
+				continue;
+			}
+			steers.push(item);
+		}
+		return steers;
+	}
+
+	private currentTurn(run: RunState | undefined): TurnState | undefined {
+		return run?.currentTurn;
+	}
+
+	private flushChatEnd(ctx: ExtensionContext, turn: TurnState): void {
+		const chat = turn.chat;
+		if (!chat || chat.endWritten) {
+			return;
+		}
+		const message = turn.assistantMessage;
+		const extra = attributes([
+			["gen_ai.usage.input_tokens", message?.usage?.input ?? 0],
+			["gen_ai.usage.output_tokens", message?.usage?.output ?? 0],
+			["pi.usage.cache_read_tokens", message?.usage?.cacheRead ?? 0],
+			["pi.usage.cache_write_tokens", message?.usage?.cacheWrite ?? 0],
+			["gen_ai.response.finish_reasons", message?.stopReason ? [message.stopReason] : undefined],
+			["pi.session.entry_id", message ? this.findMessageEntryId(ctx, message) : undefined],
+		]);
+		const endTime = chat.endTimeUnixNano ?? this.clock.endNow();
+		this.writeEnd(ctx, chat, extra, this.assistantStatus(message ?? {}), endTime);
+	}
+
+	private onAgentStart(ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		let trigger: RunState["trigger"];
+		if (this.sawBeforeAgentStart) {
+			trigger = "prompt";
+		} else if (this.awaitingSettled) {
+			trigger = "continuation";
+		} else {
+			trigger = "wakeup";
+		}
+		this.sawBeforeAgentStart = false;
+		this.awaitingSettled = true;
+		const span = this.startSpan(ctx, {
+			name: "pi.run",
+			kind: KIND_INTERNAL,
+			startTimeUnixNano: this.clock.now(),
+			startAttributes: attributes([["pi.run.trigger", trigger]]),
+		});
+		this.run = {
+			span,
+			trigger,
+			completedTurnCount: 0,
+			consumed: [],
+			sawAssistant: false,
+		};
+	}
+
+	private onTurnStart(turnIndex: number, timestamp: number, ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		const run = this.run;
+		if (!run) {
+			return;
+		}
+		const span = this.startSpan(ctx, {
+			name: "pi.turn",
+			kind: KIND_INTERNAL,
+			parentSpanId: run.span.spanId,
+			startTimeUnixNano: this.clock.fromMillis(timestamp),
+			startAttributes: attributes([["pi.turn.index", turnIndex]]),
+		});
+		const turn: TurnState = {
+			span,
+			tools: [],
+			toolsEndedInOrder: [],
+			toolCallCount: 0,
+		};
+		run.currentTurn = turn;
+	}
+
+	private onMessageStart(message: { role: string; provider?: string; model?: string }, ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		if (message.role !== "assistant") {
+			return;
+		}
+		const run = this.run;
+		const turn = this.currentTurn(run);
+		if (!run || !turn) {
+			return;
+		}
+		run.sawAssistant = true;
+		turn.chat = this.startSpan(ctx, {
+			name: `chat ${message.model ?? "unknown"}`,
+			kind: KIND_CLIENT,
+			parentSpanId: turn.span.spanId,
+			startTimeUnixNano: this.clock.now(),
+			startAttributes: attributes([
+				["gen_ai.operation.name", "chat"],
+				["gen_ai.system", message.provider ?? ""],
+				["gen_ai.request.model", message.model ?? ""],
+			]),
+		});
+	}
+
+	private onMessageEnd(
+		message: {
+			role: string;
+			customType?: string;
+			content?: unknown;
+			timestamp?: number;
+			provider?: string;
+			model?: string;
+			usage?: { input?: number; output?: number; cacheRead?: number; cacheWrite?: number };
+			stopReason?: string;
+			errorMessage?: string;
+		},
+		_ctx: ExtensionContext,
+	): void {
+		const run = this.run;
+		if (!run) {
+			return;
+		}
+		if (isUserOrCustom(message.role) && message.customType !== WRITE_FAILURE_TYPE) {
+			run.consumed.push({
+				role: message.role,
+				message,
+				beforeFirstAssistant: !run.sawAssistant,
+			});
+			return;
+		}
+		if (message.role !== "assistant") {
+			return;
+		}
+		const turn = this.currentTurn(run);
+		if (!turn?.chat) {
+			return;
+		}
+		turn.assistantMessage = message;
+		turn.chat.endTimeUnixNano = this.clock.endNow();
+	}
+
+	private onToolStart(event: { toolCallId: string; toolName: string }, ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		const run = this.run;
+		const turn = this.currentTurn(run);
+		if (!run || !turn) {
+			return;
+		}
+		this.flushChatEnd(ctx, turn);
+		const span = this.startSpan(ctx, {
+			name: `execute_tool ${event.toolName}`,
+			kind: KIND_INTERNAL,
+			parentSpanId: turn.span.spanId,
+			startTimeUnixNano: this.clock.now(),
+			startAttributes: attributes([
+				["gen_ai.operation.name", "execute_tool"],
+				["gen_ai.tool.name", event.toolName],
+				["gen_ai.tool.call.id", event.toolCallId],
+			]),
+		});
+		turn.tools.push({ span, toolCallId: event.toolCallId, toolName: event.toolName });
+		turn.toolCallCount += 1;
+	}
+
+	private onToolEnd(
+		event: { toolCallId: string; toolName: string; result: unknown; isError: boolean },
+		_ctx: ExtensionContext,
+	): void {
+		const turn = this.currentTurn(this.run);
+		if (!turn) {
+			return;
+		}
+		const tool = turn.tools.find(
+			(item) => item.toolCallId === event.toolCallId && item.span.endTimeUnixNano === undefined,
+		);
+		if (!tool) {
+			return;
+		}
+		tool.isError = event.isError;
+		tool.resultText = textFromToolResult(event.result);
+		tool.span.endTimeUnixNano = this.clock.endNow();
+		turn.toolsEndedInOrder.push(tool);
+	}
+
+	private flushToolEnds(ctx: ExtensionContext, turn: TurnState): void {
+		const ended = turn.toolsEndedInOrder.length > 0 ? turn.toolsEndedInOrder : turn.tools;
+		for (const tool of ended) {
+			if (tool.span.endWritten) {
+				continue;
+			}
+			const extra = attributes([
+				["pi.tool.is_error", tool.isError ?? false],
+				["pi.session.entry_id", this.findMessageEntryId(ctx, { role: "toolResult", toolCallId: tool.toolCallId })],
+			]);
+			const status: OtlpStatus =
+				tool.isError === true ? { code: STATUS_ERROR, message: tool.resultText ?? "" } : { code: STATUS_OK };
+			this.writeEnd(ctx, tool.span, extra, status, tool.span.endTimeUnixNano ?? this.clock.endNow());
+		}
+	}
+
+	private onTurnEnd(
+		event: {
+			turnIndex: number;
+			message: {
+				role: string;
+				stopReason?: string;
+				errorMessage?: string;
+				timestamp?: number;
+				usage?: { input?: number; output?: number; cacheRead?: number; cacheWrite?: number };
+				provider?: string;
+				model?: string;
+			};
+			toolResults: Array<{ toolCallId: string; toolName: string; content?: unknown; isError?: boolean }>;
+		},
+		ctx: ExtensionContext,
+	): void {
+		this.ensureTrace(ctx);
+		const run = this.run;
+		const turn = this.currentTurn(run);
+		if (!run || !turn) {
+			return;
+		}
+		if (event.message.role === "assistant" && !turn.assistantMessage) {
+			turn.assistantMessage = event.message;
+			if (turn.chat && turn.chat.endTimeUnixNano === undefined) {
+				turn.chat.endTimeUnixNano = this.clock.endNow();
+			}
+		}
+		for (const result of event.toolResults) {
+			const tool = turn.tools.find((item) => item.toolCallId === result.toolCallId);
+			if (!tool) {
+				continue;
+			}
+			if (tool.isError === undefined) {
+				tool.isError = result.isError;
+				tool.resultText = textFromContent(result.content);
+			}
+			if (tool.span.endTimeUnixNano === undefined) {
+				tool.span.endTimeUnixNano = this.clock.endNow();
+				turn.toolsEndedInOrder.push(tool);
+			}
+		}
+		this.flushChatEnd(ctx, turn);
+		this.flushToolEnds(ctx, turn);
+		const extra = attributes([
+			["pi.turn.stop_reason", turn.assistantMessage?.stopReason ?? event.message.stopReason ?? ""],
+			["pi.turn.tool_call_count", turn.toolCallCount],
+		]);
+		this.writeEnd(
+			ctx,
+			turn.span,
+			extra,
+			this.assistantStatus(turn.assistantMessage ?? event.message),
+			this.clock.endNow(),
+		);
+		run.completedTurnCount += 1;
+		run.currentTurn = undefined;
+	}
+
+	private onAgentEnd(ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		const run = this.run;
+		if (!run) {
+			return;
+		}
+		const trigger = this.triggerMessage(run);
+		const steers = this.steerMessages(run);
+		const steerIds = steers
+			.map((item) => this.findEntryIdForTracked(ctx, item))
+			.filter((id): id is string => typeof id === "string");
+		const extra = attributes([
+			["pi.run.turn_count", run.completedTurnCount],
+			["pi.session.entry_id", trigger ? this.findEntryIdForTracked(ctx, trigger) : undefined],
+			["pi.run.steer_count", steers.length],
+			["pi.run.steer_entry_ids", steerIds],
+		]);
+		this.writeEnd(ctx, run.span, extra, { code: STATUS_OK }, this.clock.endNow());
+		this.run = undefined;
+	}
+
+	private onCompactStart(
+		event: { reason: "manual" | "threshold" | "overflow"; willRetry: boolean },
+		ctx: ExtensionContext,
+	): void {
+		this.ensureTrace(ctx);
+		this.compaction = {
+			span: this.startSpan(ctx, {
+				name: "pi.compaction",
+				kind: KIND_INTERNAL,
+				startTimeUnixNano: this.clock.now(),
+				startAttributes: attributes([
+					["pi.compaction.reason", event.reason],
+					["pi.compaction.will_retry", event.willRetry],
+				]),
+			}),
+		};
+	}
+
+	private onCompactSuccess(
+		event: {
+			compactionEntry: {
+				id: string;
+				tokensBefore: number;
+				firstKeptEntryId: string;
+				usage?: { input?: number; output?: number };
+			};
+		},
+		ctx: ExtensionContext,
+	): void {
+		this.ensureTrace(ctx);
+		const compaction = this.compaction;
+		if (!compaction) {
+			return;
+		}
+		const entry = event.compactionEntry;
+		const extra = attributes([
+			["pi.compaction.tokens_before", entry.tokensBefore],
+			["pi.compaction.first_kept_entry_id", entry.firstKeptEntryId],
+			["gen_ai.usage.input_tokens", entry.usage ? entry.usage.input : undefined],
+			["gen_ai.usage.output_tokens", entry.usage ? entry.usage.output : undefined],
+			["pi.session.entry_id", entry.id],
+		]);
+		this.writeEnd(ctx, compaction.span, extra, { code: STATUS_OK }, this.clock.endNow());
+		this.compaction = undefined;
+	}
+
+	private onCompactFailed(event: { errorMessage?: string; aborted: boolean }, ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		const compaction = this.compaction;
+		if (!compaction) {
+			return;
+		}
+		this.writeEnd(
+			ctx,
+			compaction.span,
+			[],
+			{ code: STATUS_ERROR, message: event.errorMessage || "aborted" },
+			this.clock.endNow(),
+		);
+		this.compaction = undefined;
+	}
+
+	private onShutdown(ctx: ExtensionContext): void {
+		this.ensureTrace(ctx);
+		const shutdownStatus: OtlpStatus = { code: STATUS_ERROR, message: "shutdown" };
+		const endTime = () => this.clock.endNow();
+		const run = this.run;
+		const turn = this.currentTurn(run);
+		const openTurn = Boolean(turn && !turn.span.endWritten);
+
+		if (turn?.chat && !turn.chat.endWritten) {
+			const message = turn.assistantMessage;
+			this.writeEnd(
+				ctx,
+				turn.chat,
+				attributes([
+					["gen_ai.usage.input_tokens", message?.usage?.input],
+					["gen_ai.usage.output_tokens", message?.usage?.output],
+					["pi.usage.cache_read_tokens", message?.usage?.cacheRead],
+					["pi.usage.cache_write_tokens", message?.usage?.cacheWrite],
+					["gen_ai.response.finish_reasons", message?.stopReason ? [message.stopReason] : undefined],
+					["pi.session.entry_id", message ? this.findMessageEntryId(ctx, message) : undefined],
+				]),
+				shutdownStatus,
+				turn.chat.endTimeUnixNano ?? endTime(),
+			);
+		}
+
+		if (turn) {
+			const toolsInEndOrder = [
+				...turn.toolsEndedInOrder,
+				...turn.tools.filter((tool) => !turn.toolsEndedInOrder.includes(tool)),
+			];
+			for (const tool of toolsInEndOrder) {
+				if (tool.span.endWritten) {
+					continue;
+				}
+				this.writeEnd(
+					ctx,
+					tool.span,
+					attributes([
+						["pi.tool.is_error", tool.isError],
+						[
+							"pi.session.entry_id",
+							this.findMessageEntryId(ctx, { role: "toolResult", toolCallId: tool.toolCallId }),
+						],
+					]),
+					shutdownStatus,
+					tool.span.endTimeUnixNano ?? endTime(),
+				);
+			}
+			if (!turn.span.endWritten) {
+				this.writeEnd(
+					ctx,
+					turn.span,
+					attributes([
+						["pi.turn.stop_reason", turn.assistantMessage?.stopReason],
+						["pi.turn.tool_call_count", turn.toolCallCount],
+					]),
+					shutdownStatus,
+					endTime(),
+				);
+			}
+		}
+
+		if (this.compaction && !this.compaction.span.endWritten) {
+			this.writeEnd(ctx, this.compaction.span, [], shutdownStatus, endTime());
+			this.compaction = undefined;
+		}
+
+		if (run && !run.span.endWritten) {
+			const trigger = this.triggerMessage(run);
+			const steers = this.steerMessages(run);
+			const steerIds = steers
+				.map((item) => this.findEntryIdForTracked(ctx, item))
+				.filter((id): id is string => typeof id === "string");
+			const turnCount = run.completedTurnCount + (openTurn ? 1 : 0);
+			this.writeEnd(
+				ctx,
+				run.span,
+				attributes([
+					["pi.run.turn_count", turnCount],
+					["pi.session.entry_id", trigger ? this.findEntryIdForTracked(ctx, trigger) : undefined],
+					["pi.run.steer_count", steers.length],
+					["pi.run.steer_entry_ids", steerIds],
+				]),
+				shutdownStatus,
+				endTime(),
+			);
+			this.run = undefined;
+		}
+	}
+}
+
+export default function (pi: ExtensionAPI) {
+	new AgentTracer(pi).subscribe();
+}
