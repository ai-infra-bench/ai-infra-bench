--- /dev/null
+++ b/packages/coding-agent/test/agent-trace-extension.test.ts
@@ -0,0 +1,913 @@
+import { createHash } from "node:crypto";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, Usage } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import agentTrace from "../examples/extensions/agent-trace/index.ts";
+import { VERSION } from "../src/config.ts";
+import type { ExtensionAPI, ExtensionContext } from "../src/core/extensions/index.ts";
+import { createHarnessWithExtensions, type Harness } from "./test-harness.ts";
+
+type Handler = (event: any, ctx: ExtensionContext) => unknown | Promise<unknown>;
+
+type OtlpSpan = {
+	traceId: string;
+	spanId: string;
+	parentSpanId?: string;
+	name: string;
+	kind: number;
+	startTimeUnixNano: string;
+	endTimeUnixNano?: string;
+	attributes: Array<{ key: string; value: Record<string, unknown> }>;
+	status?: { code: number; message?: string };
+};
+
+type OtlpLine = {
+	resourceSpans: Array<{
+		resource: { attributes: OtlpSpan["attributes"] };
+		scopeSpans: Array<{ scope: { name: string; version: string }; spans: OtlpSpan[] }>;
+	}>;
+};
+
+type SessionEntry = {
+	type: string;
+	id: string;
+	parentId: string | null;
+	timestamp: string;
+	message?: { role: string; [key: string]: unknown };
+	customType?: string;
+	content?: unknown;
+	display?: boolean;
+	summary?: string;
+	firstKeptEntryId?: string;
+	tokensBefore?: number;
+	usage?: Usage;
+};
+
+class FakeSession {
+	entries: SessionEntry[] = [];
+	private nextId = 1;
+
+	constructor(
+		readonly dir: string,
+		readonly id: string,
+	) {}
+
+	getSessionDir(): string {
+		return this.dir;
+	}
+
+	getSessionId(): string {
+		return this.id;
+	}
+
+	getBranch(): SessionEntry[] {
+		return this.entries;
+	}
+
+	persistMessage(message: { role: string; [key: string]: unknown }): string {
+		const id = `e${this.nextId++}`;
+		this.entries.push({
+			type: "message",
+			id,
+			parentId: null,
+			timestamp: new Date().toISOString(),
+			message,
+		});
+		return id;
+	}
+
+	persistCustom(message: { customType?: string; content?: unknown; display?: boolean }): string {
+		const id = `e${this.nextId++}`;
+		this.entries.push({
+			type: "custom_message",
+			id,
+			parentId: null,
+			timestamp: new Date().toISOString(),
+			customType: message.customType,
+			content: message.content,
+			display: message.display,
+		});
+		return id;
+	}
+
+	persistCompaction(entry: SessionEntry): void {
+		this.entries.push(entry);
+	}
+}
+
+function usage(partial: Partial<Usage> = {}): Usage {
+	const input = partial.input ?? 10;
+	const output = partial.output ?? 4;
+	const cacheRead = partial.cacheRead ?? 1;
+	const cacheWrite = partial.cacheWrite ?? 2;
+	return {
+		input,
+		output,
+		cacheRead,
+		cacheWrite,
+		totalTokens: partial.totalTokens ?? input + output + cacheRead + cacheWrite,
+		cost: partial.cost ?? { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function userMessage(text: string) {
+	return { role: "user" as const, content: [{ type: "text" as const, text }], timestamp: Date.now() };
+}
+
+function customMessage(customType: string, text: string) {
+	return {
+		role: "custom" as const,
+		customType,
+		content: text,
+		display: true,
+		timestamp: Date.now(),
+	};
+}
+
+function assistantMessage(overrides: Partial<AssistantMessage> & { text?: string } = {}): AssistantMessage {
+	const { text = "ok", ...rest } = overrides;
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: "anthropic-messages",
+		provider: "faux",
+		model: "faux-1",
+		usage: usage(),
+		stopReason: "stop",
+		timestamp: Date.now(),
+		...rest,
+	};
+}
+
+function toolResultMessage(toolCallId: string, toolName: string, text: string, isError = false) {
+	return {
+		role: "toolResult" as const,
+		toolCallId,
+		toolName,
+		content: [{ type: "text" as const, text }],
+		isError,
+		timestamp: Date.now(),
+	};
+}
+
+function readLines(file: string): OtlpLine[] {
+	if (!existsSync(file)) {
+		return [];
+	}
+	return readFileSync(file, "utf8")
+		.split("\n")
+		.filter((line) => line.length > 0)
+		.map((line) => JSON.parse(line) as OtlpLine);
+}
+
+function spanOf(line: OtlpLine): OtlpSpan {
+	const spans = line.resourceSpans[0]?.scopeSpans[0]?.spans;
+	expect(spans).toHaveLength(1);
+	return spans![0]!;
+}
+
+function attrMap(span: OtlpSpan): Map<string, Record<string, unknown>> {
+	const map = new Map<string, Record<string, unknown>>();
+	for (const attribute of span.attributes) {
+		expect(map.has(attribute.key)).toBe(false);
+		map.set(attribute.key, attribute.value);
+	}
+	return map;
+}
+
+function stringAttr(span: OtlpSpan, key: string): string | undefined {
+	const value = attrMap(span).get(key);
+	return value && "stringValue" in value ? String(value.stringValue) : undefined;
+}
+
+function intAttr(span: OtlpSpan, key: string): string | undefined {
+	const value = attrMap(span).get(key);
+	return value && "intValue" in value ? String(value.intValue) : undefined;
+}
+
+function boolAttr(span: OtlpSpan, key: string): boolean | undefined {
+	const value = attrMap(span).get(key);
+	return value && "boolValue" in value ? Boolean(value.boolValue) : undefined;
+}
+
+function arrayAttr(span: OtlpSpan, key: string): string[] | undefined {
+	const value = attrMap(span).get(key);
+	if (!value || !("arrayValue" in value)) {
+		return undefined;
+	}
+	const values = (value.arrayValue as { values?: Array<{ stringValue?: string }> }).values ?? [];
+	return values.map((item) => String(item.stringValue ?? ""));
+}
+
+function latestById(file: string): Map<string, OtlpSpan> {
+	const latest = new Map<string, OtlpSpan>();
+	for (const line of readLines(file)) {
+		const span = spanOf(line);
+		latest.set(span.spanId, span);
+	}
+	return latest;
+}
+
+function latestNamed(file: string, name: string | RegExp): OtlpSpan {
+	const matches = [...latestById(file).values()].filter((span) =>
+		typeof name === "string" ? span.name === name : name.test(span.name),
+	);
+	expect(matches.length).toBeGreaterThan(0);
+	return matches[matches.length - 1]!;
+}
+
+function setup(options: { envFile?: boolean; sessionId?: string } = {}) {
+	const tmp = mkdtempSync(join(tmpdir(), "pi-agent-trace-"));
+	const file = join(tmp, "trace.otlp.jsonl");
+	if (options.envFile === false) {
+		delete process.env.PI_AGENT_TRACE_FILE;
+	} else {
+		vi.stubEnv("PI_AGENT_TRACE_FILE", file);
+	}
+
+	const session = new FakeSession(tmp, options.sessionId ?? "session-abc");
+	const handlers = new Map<string, Handler>();
+	const sendMessage = vi.fn();
+	const api = {
+		on(event: string, handler: Handler) {
+			handlers.set(event, handler);
+		},
+		sendMessage,
+	} as unknown as ExtensionAPI;
+
+	agentTrace(api);
+
+	const ctx = {
+		sessionManager: session,
+	} as unknown as ExtensionContext;
+
+	async function fire(event: { type: string; [key: string]: unknown }): Promise<void> {
+		const handler = handlers.get(event.type);
+		await handler?.(event, ctx);
+		if (event.type === "message_end") {
+			const message = event.message as { role: string; customType?: string; content?: unknown; display?: boolean };
+			if (message.role === "custom") {
+				session.persistCustom(message);
+			} else if (message.role === "user" || message.role === "assistant" || message.role === "toolResult") {
+				session.persistMessage(message);
+			}
+		}
+	}
+
+	return { tmp, file, session, handlers, sendMessage, ctx, fire };
+}
+
+async function runPrompt(
+	fire: (event: { type: string; [key: string]: unknown }) => Promise<void>,
+	options: { user?: ReturnType<typeof userMessage>; assistant?: AssistantMessage } = {},
+) {
+	const user = options.user ?? userMessage("hi");
+	const assistant = options.assistant ?? assistantMessage();
+	await fire({
+		type: "before_agent_start",
+		prompt: "hi",
+		systemPrompt: "",
+		systemPromptOptions: { cwd: "/" },
+	});
+	await fire({ type: "agent_start" });
+	await fire({ type: "turn_start", turnIndex: 0, timestamp: Date.now() });
+	await fire({ type: "message_start", message: user });
+	await fire({ type: "message_end", message: user });
+	await fire({ type: "message_start", message: assistant });
+	await fire({ type: "message_end", message: assistant });
+	await fire({ type: "turn_end", turnIndex: 0, message: assistant, toolResults: [] });
+	await fire({ type: "agent_end", messages: [user, assistant] });
+	await fire({ type: "agent_settled" });
+	return { user, assistant };
+}
+
+describe("agent-trace example extension", () => {
+	const tmps: string[] = [];
+	const harnesses: Harness[] = [];
+
+	afterEach(() => {
+		while (harnesses.length > 0) {
+			harnesses.pop()?.cleanup();
+		}
+		while (tmps.length > 0) {
+			const dir = tmps.pop();
+			if (dir && existsSync(dir)) {
+				rmSync(dir, { recursive: true, force: true });
+			}
+		}
+		vi.unstubAllEnvs();
+	});
+
+	it("does not inject a context/system-prompt handler", () => {
+		const { handlers, tmp } = setup();
+		tmps.push(tmp);
+		expect(handlers.has("context")).toBe(false);
