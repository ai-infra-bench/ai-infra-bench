+			await handlers.get(event.type)?.(event, ctx);
+			if (event.type === "message_end") {
+				session.persistMessage(event.message as { role: string });
+			}
+		};
+		await runPrompt(fire2);
+		const lines = readLines(file);
+		expect(lines.length).toBeGreaterThan(firstCount);
+		const traceIds = new Set(lines.map((line) => spanOf(line).traceId));
+		expect(traceIds.size).toBe(1);
+	});
+});
