+import { afterEach, expect, it } from "vitest";
+import { nanos, traceIdFor } from "../examples/extensions/agent-trace/index.ts";
+import { DefaultResourceLoader } from "../src/core/resource-loader.ts";
+import { createAgentSession } from "../src/core/sdk.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+
+const roots: string[] = [];
+afterEach(() => {
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+it("agent-trace example: encodes ids and times", () => {
+	expect(traceIdFor("abc")).toMatch(/^[0-9a-f]{32}$/);
+	expect(traceIdFor("abc")).toBe(traceIdFor("abc"));
+	expect(nanos(1_700_000_000_123)).toBe("1700000000123000000");
+});
+
+it("agent-trace example: writes run, turn, chat and tool spans as OTLP/JSON lines", async () => {
+	const root = mkdtempSync(join(tmpdir(), "pi-agent-trace-"));
+	roots.push(root);
+	const cwd = join(root, "project");
+	const sessionDir = join(root, "sessions");
+	const faux = fauxProvider({
+		provider: "trace-faux",
+		api: "trace-faux-api",
+		models: [{ id: "trace-model", contextWindow: 200_000, maxTokens: 8_192 }],
+	});
+	const settingsManager = SettingsManager.inMemory({ retry: { enabled: false } });
+	const loader = new DefaultResourceLoader({
+		cwd,
+		agentDir: join(root, "agent"),
+		settingsManager,
+		additionalExtensionPaths: [join(import.meta.dirname, "../examples/extensions/agent-trace/index.ts")],
+		extensionFactories: [
+			{
+				name: "trace-test",
+				factory: (pi) => {
+					pi.registerProvider(faux.provider);
+					pi.registerTool({
+						name: "echo",
+						label: "Echo",
+						description: "echo",
+						parameters: Type.Object({ text: Type.String() }),
+						async execute(_id, params: { text: string }) {
+							return { content: [{ type: "text", text: params.text }], details: {} };
+						},
+					});
+				},
+			},
+		],
+		noExtensions: true,
+		noSkills: true,
+		noPromptTemplates: true,
+		noThemes: true,
+		noContextFiles: true,
+		systemPrompt: "test",
+	});
+	await loader.reload();
+	const sessionManager = SessionManager.create(cwd, sessionDir);
+	const { session } = await createAgentSession({
+		cwd,
+		agentDir: join(root, "agent"),
+		model: faux.getModel(),
+		thinkingLevel: "off",
+		noTools: "builtin",
+		resourceLoader: loader,
+		sessionManager,
+		settingsManager,
+	});
+	await session.bindExtensions({});
+	faux.setResponses([
+		fauxAssistantMessage(fauxToolCall("echo", { text: "hi" }), { stopReason: "toolUse" }),
+		fauxAssistantMessage(fauxText("done")),
+	]);
+	await session.prompt("go", { expandPromptTemplates: false, source: "interactive" });
+	session.dispose();
+
+	const file = join(sessionDir, "traces", `${sessionManager.getSessionId()}.otlp.jsonl`);
+	expect(existsSync(file)).toBe(true);
+	const lines = readFileSync(file, "utf8")
+		.trimEnd()
+		.split("\n")
+		.map((line) => JSON.parse(line));
+	const all = lines.map((line) => line.resourceSpans[0].scopeSpans[0].spans[0]);
+	// Start lines (no end time) make the file live; the end lines describe the finished spans.
+	const starts = all.filter((span) => !("endTimeUnixNano" in span));
+	const spans = all.filter((span) => "endTimeUnixNano" in span);
+	expect(starts.map((span) => span.name)).toEqual([
+		"pi.run",
+		"pi.turn",
+		"chat trace-model",
+		"execute_tool echo",
+		"pi.turn",
+		"chat trace-model",
+	]);
+	expect(new Set(starts.map((span) => span.spanId))).toEqual(new Set(spans.map((span) => span.spanId)));
+	expect(spans.map((span) => span.name)).toEqual([
+		"chat trace-model",
+		"execute_tool echo",
+		"pi.turn",
+		"chat trace-model",
+		"pi.turn",
+		"pi.run",
+	]);
+	const run = spans[5];
+	expect(run.parentSpanId).toBeUndefined();
+	expect(run.traceId).toBe(traceIdFor(sessionManager.getSessionId()));
+	expect(spans[2].parentSpanId).toBe(run.spanId);
+	expect(spans[0].parentSpanId).toBe(spans[2].spanId);
+	const attrs = Object.fromEntries(run.attributes.map((a: any) => [a.key, a.value]));
+	expect(attrs["pi.run.trigger"]).toEqual({ stringValue: "prompt" });
+	expect(attrs["pi.run.turn_count"]).toEqual({ intValue: "2" });
+	const entryIds = new Set(sessionManager.getBranch().map((entry) => entry.id));
+	for (const span of spans) {
+		const id = span.attributes.find((a: any) => a.key === "pi.session.entry_id");
+		if (span.name !== "pi.turn") expect(entryIds.has(id?.value.stringValue)).toBe(true);
+	}
+});
