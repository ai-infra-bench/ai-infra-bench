diff --git a/tests/v1/worker/gpu/test_block_table.py b/tests/v1/worker/gpu/test_block_table.py
new file mode 100644
index 0000000000..ffddcef429
--- /dev/null
+++ b/tests/v1/worker/gpu/test_block_table.py
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda(), reason="DCP slot mapping uses a Triton CUDA kernel"
+)
+
+
+@pytest.mark.parametrize("dcp_rank", [0, 1])
+def test_dcp_slot_mapping_across_requests_and_virtual_blocks(dcp_rank: int):
+    block_size = 16
+    dcp_world_size = 2
+    interleave_size = 2
+    block_tables = BlockTables(
+        block_sizes=[block_size],
+        max_num_reqs=2,
+        max_num_batched_tokens=80,
+        max_model_len=96,
+        device=torch.device("cuda"),
+        dcp_world_size=dcp_world_size,
+        dcp_rank=dcp_rank,
+        cp_kv_cache_interleave_size=interleave_size,
+    )
+
+    # V2 receives one scheduler block per virtual DCP block, not per rank-local
+    # physical block.
+    assert block_tables.block_tables[0].gpu.shape == (2, 3)
+
+    block_tables.append_block_ids(0, ([7, 11, 13],), overwrite=True)
+    block_tables.append_block_ids(1, ([17, 19, 23],), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    # Reverse request order to cover a changing batch, and cross the first
+    # virtual-block boundary at global position 32.
+    idx_mapping = torch.tensor([1, 0], dtype=torch.int32, device="cuda")
+    query_start_loc = torch.tensor([0, 40, 80], dtype=torch.int32, device="cuda")
+    positions = torch.arange(40, dtype=torch.int64, device="cuda").repeat(2)
+    actual = block_tables.compute_slot_mappings(
+        idx_mapping, query_start_loc, positions
+    )[0].cpu()
+
+    expected = []
+    for block_ids in ([17, 19, 23], [7, 11, 13]):
+        for position in range(40):
+            virtual_block_offset = position % (block_size * dcp_world_size)
+            owning_rank = (
+                virtual_block_offset // interleave_size
+            ) % dcp_world_size
+            if owning_rank != dcp_rank:
+                expected.append(-1)
+                continue
+            local_block_offset = (
+                virtual_block_offset // (dcp_world_size * interleave_size)
+                * interleave_size
+                + virtual_block_offset % interleave_size
+            )
+            block_id = block_ids[position // (block_size * dcp_world_size)]
+            expected.append(block_id * block_size + local_block_offset)
+
+    torch.testing.assert_close(actual, torch.tensor(expected, dtype=torch.int64))
+
+
+def test_non_dcp_slot_mapping_is_unchanged():
+    block_tables = BlockTables(
+        block_sizes=[16],
+        max_num_reqs=1,
+        max_num_batched_tokens=20,
+        max_model_len=32,
+        device=torch.device("cuda"),
+    )
+    block_tables.append_block_ids(0, ([3, 5],), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    idx_mapping = torch.tensor([0], dtype=torch.int32, device="cuda")
+    query_start_loc = torch.tensor([0, 20], dtype=torch.int32, device="cuda")
+    positions = torch.arange(20, dtype=torch.int64, device="cuda")
+    actual = block_tables.compute_slot_mappings(
+        idx_mapping, query_start_loc, positions
+    )[0].cpu()
+
+    expected = torch.tensor(
+        [3 * 16 + i for i in range(16)] + [5 * 16 + i for i in range(4)],
+        dtype=torch.int64,
+    )
+    torch.testing.assert_close(actual, expected)
