+@triton.jit
+def _compute_slot_mappings_dcp_kernel(
+    num_tokens,
+    max_num_tokens,
+    idx_mapping,  # [num_reqs]
+    query_start_loc,  # [num_reqs + 1]
+    pos,  # [num_tokens]
+    block_table_ptrs,  # [num_kv_cache_groups]
+    block_table_strides,  # [num_kv_cache_groups]
+    block_sizes,  # [num_kv_cache_groups]
+    slot_mappings_ptr,  # [num_kv_cache_groups, max_num_tokens]
+    slot_mappings_stride,
+    total_cp_world_size: tl.constexpr,
+    total_cp_rank: tl.constexpr,
+    cp_kv_cache_interleave_size: tl.constexpr,
+    PAD_ID: tl.constexpr,
+    TRITON_BLOCK_SIZE: tl.constexpr,
+):
+    """DCP-aware slot mapping computation with interleaved KV cache layout.
+
+    When DCP/PCP is enabled, KV cache is distributed across ranks in an
+    interleaved pattern based on cp_kv_cache_interleave_size:
+    - Virtual block size = block_size * total_cp_world_size
+    - Tokens are assigned to ranks in chunks of cp_kv_cache_interleave_size
+    - Non-local tokens get slot mapping = PAD_ID (-1)
+    """
+    group_id = tl.program_id(0)
+    batch_idx = tl.program_id(1)
+    slot_mapping_ptr = slot_mappings_ptr + group_id * slot_mappings_stride
+
+    if batch_idx == tl.num_programs(1) - 1:
+        # Pad remaining slots to PAD_ID. This is needed for CUDA graphs.
+        for i in range(num_tokens, max_num_tokens, TRITON_BLOCK_SIZE):
+            offset = i + tl.arange(0, TRITON_BLOCK_SIZE)
+            tl.store(slot_mapping_ptr + offset, PAD_ID, mask=offset < max_num_tokens)
+        return
+
+    block_table_ptr = _load_ptr(block_table_ptrs + group_id, tl.int32)
+    block_table_stride = tl.load(block_table_strides + group_id)
+    block_size = tl.load(block_sizes + group_id)
+
+    req_state_idx = tl.load(idx_mapping + batch_idx)
+    start_idx = tl.load(query_start_loc + batch_idx)
+    end_idx = tl.load(query_start_loc + batch_idx + 1)
+
+    # Virtual block size for DCP interleaving
+    virtual_block_size = block_size * total_cp_world_size
+
+    for i in range(start_idx, end_idx, TRITON_BLOCK_SIZE):
+        offset = i + tl.arange(0, TRITON_BLOCK_SIZE)
+        mask = offset < end_idx
+        positions = tl.load(pos + offset, mask=mask, other=0)
+
+        # Calculate block indices using virtual blocks
+        block_indices = positions // virtual_block_size
+        block_numbers = tl.load(
+            block_table_ptr + req_state_idx * block_table_stride + block_indices,
+            mask=mask,
+            other=0,
+        )
+
+        # Calculate virtual block offsets
+        virtual_block_offsets = positions % virtual_block_size
+
+        # Determine which tokens belong to this rank
+        # Token belongs to this rank if:
+        # (virtual_offset // interleave_size) % world_size == rank
+        chunk_id = virtual_block_offsets // cp_kv_cache_interleave_size
+        owner_rank = chunk_id % total_cp_world_size
+        is_local = owner_rank == total_cp_rank
+
+        # Calculate local block offsets for tokens on this rank
+        # Map virtual offset to local offset by removing gaps for other ranks
+        num_complete_cycles = chunk_id // total_cp_world_size
+        offset_in_chunk = virtual_block_offsets % cp_kv_cache_interleave_size
+        block_offsets = (
+            num_complete_cycles * cp_kv_cache_interleave_size + offset_in_chunk
+        )
+
+        # Calculate slot IDs
+        slot_ids = block_numbers * block_size + block_offsets
+
+        # Write PAD_ID for non-local tokens, actual slot for local tokens
+        slot_ids = tl.where(is_local, slot_ids, PAD_ID)
+        tl.store(slot_mapping_ptr + offset, slot_ids, mask=mask)
