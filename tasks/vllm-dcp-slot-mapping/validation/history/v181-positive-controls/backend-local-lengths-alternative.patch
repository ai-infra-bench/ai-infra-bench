diff --git a/tests/v1/worker/test_gpu_block_table_v2.py b/tests/v1/worker/test_gpu_block_table_v2.py
new file mode 100644
index 0000000000..71b5b5e653
--- /dev/null
+++ b/tests/v1/worker/test_gpu_block_table_v2.py
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="CUDA not available")
+@pytest.mark.parametrize(
+    ("dcp_rank", "expected"),
+    [
+        (0, [40, 41, -1, -1, 42, 43, -1, -1, 44, 45]),
+        (1, [-1, -1, 40, 41, -1, -1, 42, 43, -1, -1]),
+    ],
+)
+def test_dcp_slot_mapping_interleaves_local_cache(dcp_rank, expected):
+    block_tables = BlockTables(
+        block_sizes=[4],
+        max_num_reqs=3,
+        max_num_batched_tokens=16,
+        max_model_len=24,
+        device=torch.device("cuda"),
+        dcp_world_size=2,
+        dcp_rank=dcp_rank,
+        cp_kv_cache_interleave_size=2,
+    )
+    # Request state 2 is deliberately gathered into batch row 0. This covers
+    # the stable request-state mapping when batch membership/order changes.
+    block_tables.append_block_ids(2, ([10, 11, 12],), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    idx_mapping = torch.tensor([2], dtype=torch.int32, device="cuda")
+    query_start_loc = torch.tensor([0, 10], dtype=torch.int32, device="cuda")
+    positions = torch.arange(10, dtype=torch.int64, device="cuda")
+
+    gathered = block_tables.gather_block_tables(idx_mapping)[0]
+    slots = block_tables.compute_slot_mappings(
+        idx_mapping, query_start_loc, positions
+    )[0]
+
+    assert gathered[:, :3].tolist() == [[10, 11, 12]]
+    assert slots.tolist() == expected
+    assert slots[slots != PAD_SLOT_ID].tolist() == [x for x in expected if x >= 0]
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="CUDA not available")
+def test_non_dcp_slot_mapping_is_unchanged():
+    block_tables = BlockTables(
+        block_sizes=[4],
+        max_num_reqs=1,
+        max_num_batched_tokens=10,
+        max_model_len=12,
+        device=torch.device("cuda"),
+    )
+    block_tables.append_block_ids(0, ([10, 11, 12],), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    idx_mapping = torch.tensor([0], dtype=torch.int32, device="cuda")
+    query_start_loc = torch.tensor([0, 10], dtype=torch.int32, device="cuda")
+    positions = torch.arange(10, dtype=torch.int64, device="cuda")
+
+    slots = block_tables.compute_slot_mappings(
+        idx_mapping, query_start_loc, positions
+    )[0]
+    assert slots.tolist() == list(range(40, 50))
