@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from vllm.config import AttentionConfig, CompilationConfig
+from vllm.config.compilation import CUDAGraphMode
+from vllm.platforms import current_platform
+from vllm.v1.attention.backend import CommonAttentionMetadata
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+pytestmark = pytest.mark.skipif(not current_platform.is_cuda(), reason="Requires CUDA")
+
+
+@pytest.mark.parametrize("rank", [0, 1])
+def test_flash_attn_dcp_lengths_graph_replay(monkeypatch, rank):
+    from vllm.distributed import parallel_state
+    from vllm.v1.attention.backends import flash_attn
+
+    monkeypatch.setattr(
+        parallel_state,
+        "get_dcp_group",
+        lambda: SimpleNamespace(world_size=2, rank_in_group=rank),
+    )
+    # Isolate length-buffer lifetime from the FA scheduler and kernel version.
+    monkeypatch.setattr(flash_attn, "get_flash_attn_version", lambda: 2)
+    model = Mock()
+    model.get_num_attention_heads.return_value = 2
+    model.get_num_kv_heads.return_value = 1
+    model.get_head_size.return_value = 128
+    config = SimpleNamespace(
+        model_config=model,
+        parallel_config=SimpleNamespace(cp_kv_cache_interleave_size=2),
+        cache_config=SimpleNamespace(cache_dtype="auto"),
+        compilation_config=CompilationConfig(
+            cudagraph_mode=CUDAGraphMode.FULL_DECODE_ONLY,
+            max_cudagraph_capture_size=4,
+        ),
+        scheduler_config=SimpleNamespace(max_num_seqs=4),
+        attention_config=AttentionConfig(),
+    )
+    builder = flash_attn.FlashAttentionMetadataBuilder(
+        FullAttentionSpec(
+            block_size=16, num_kv_heads=1, head_size=128, dtype=torch.float16
+        ),
+        [],
+        config,
+        torch.device("cuda:0"),
+    )
+
+    def build(context_lens):
+        n = len(context_lens)
+        starts = torch.arange(n + 1, dtype=torch.int32)
+        return builder.build(
+            0,
+            CommonAttentionMetadata(
+                query_start_loc=starts.cuda(),
+                query_start_loc_cpu=starts,
+                seq_lens=(
+                    torch.tensor(context_lens, dtype=torch.int32, device="cuda") + 1
+                ),
+                num_reqs=n,
+                num_actual_tokens=n,
+                max_query_len=1,
+                max_seq_len=256,
+                block_table_tensor=torch.zeros(
+                    (n, 8), dtype=torch.int32, device="cuda"
+                ),
+                slot_mapping=torch.full((n,), -1, device="cuda"),
+            ),
+        )
+
+    captured = build([0, 1, 2, 3]).dcp_context_kv_lens
+    output = torch.empty_like(captured)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output.copy_(captured)
+    for contexts in [[31, 32, 33, 34], [63, 65], [128, 0, 7], [191]]:
+        metadata = build(contexts)
+        assert metadata.dcp_context_kv_lens.data_ptr() == captured.data_ptr()
+        graph.replay()
+        expected = [sum(p // 2 % 2 == rank for p in range(n)) for n in contexts]
+        expected += [0] * (4 - len(contexts))
+        assert output.tolist() == expected
+
+
+@pytest.mark.parametrize("rank", [0, 1])
+def test_flashinfer_dcp_page_metadata(monkeypatch, rank):
+    pytest.importorskip("flashinfer")
+    from vllm.v1.attention.backends import flashinfer
+
+    monkeypatch.setattr(
+        flashinfer,
+        "get_dcp_group",
+        lambda: SimpleNamespace(world_size=2, rank_in_group=rank),
+    )
+    monkeypatch.setattr(flashinfer, "can_use_trtllm_attention", lambda *a, **kw: False)
+    monkeypatch.setattr(flashinfer, "use_trtllm_attention", lambda *a, **kw: False)
+    monkeypatch.setattr(flashinfer, "get_per_layer_parameters", lambda *a: {})
+    monkeypatch.setattr(
+        flashinfer,
+        "infer_global_hyperparameters",
+        lambda *a: SimpleNamespace(
+            sm_scale=0.1,
+            window_left=-1,
+            logits_soft_cap=None,
+            has_sinks=False,
+            has_same_window_lefts=True,
+            has_same_all_params=True,
+        ),
+    )
+    config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            max_model_len=256,
+            dtype=torch.float16,
+            get_num_attention_heads=lambda _: 2,
+        ),
+        # The deprecated option deliberately differs from the canonical one.
+        parallel_config=SimpleNamespace(
+            cp_kv_cache_interleave_size=2,
+            dcp_kv_cache_interleave_size=1,
+            decode_context_parallel_size=2,
+        ),
+        cache_config=SimpleNamespace(cache_dtype="auto"),
+        compilation_config=CompilationConfig(cudagraph_mode=CUDAGraphMode.NONE),
+        scheduler_config=SimpleNamespace(max_num_seqs=4),
+        attention_config=AttentionConfig(),
+        speculative_config=None,
+        kv_transfer_config=None,
+    )
+    builder = flashinfer.FlashInferMetadataBuilder(
+        FullAttentionSpec(
+            block_size=16, num_kv_heads=1, head_size=128, dtype=torch.float16
+        ),
+        [],
+        config,
+        torch.device("cuda:0"),
+    )
+    # Exercise the actual page-index kernel but avoid attention planning here.
+    prefill = Mock(spec=flashinfer.BatchDCPPrefillWrapper)
+    monkeypatch.setattr(builder, "_get_prefill_wrapper", lambda: prefill)
+    monkeypatch.setattr(builder, "_get_decode_wrapper", lambda *a: Mock())
+    monkeypatch.setattr(flashinfer, "fast_plan_decode", Mock())
+    seq_lens_cpu = torch.tensor([65, 35, 8], dtype=torch.int32)
+    starts = torch.tensor([0, 1, 4, 12], dtype=torch.int32)
+    block_table = torch.arange(24, dtype=torch.int32, device="cuda").view(3, 8)
+    common = CommonAttentionMetadata(
+        query_start_loc=starts.cuda(),
+        query_start_loc_cpu=starts,
+        seq_lens=seq_lens_cpu.cuda(),
+        _seq_lens_cpu=seq_lens_cpu,
+        num_reqs=3,
+        num_actual_tokens=12,
+        max_query_len=8,
+        max_seq_len=65,
+        block_table_tensor=block_table,
+        slot_mapping=torch.full((12,), -1, device="cuda"),
+    )
+    for _ in range(2):
+        builder.build(0, common)
+        # Decode includes its new token; prefill's ragged tokens are excluded.
+        local = [sum(p // 2 % 2 == rank for p in range(n)) for n in [65, 32, 0]]
+        counts = [(n + 15) // 16 for n in local]
+        assert builder.paged_kv_indptr.cpu[:4].tolist() == [
+            0,
+            counts[0],
+            counts[0] + counts[1],
+            sum(counts),
+        ]
+        assert builder.paged_kv_last_page_len.cpu[:3].tolist() == [
+            (n - 1) % 16 + 1 if n else 0 for n in local
+        ]
+        expected_indices = [
+            i * 8 + j for i, count in enumerate(counts) for j in range(count)
+        ]
+        assert builder.paged_kv_indices.gpu[: sum(counts)].tolist() == expected_indices
+        assert seq_lens_cpu.tolist() == [65, 35, 8]
+
+
+@pytest.mark.parametrize("layout", ["NHD", "HND"])
+def test_flashinfer_dcp_prefill_merge(monkeypatch, layout):
+    pytest.importorskip("flashinfer")
+    from vllm.v1.attention.backends import flashinfer
+
+    context_factory = Mock()
+    ragged_factory = Mock()
+    monkeypatch.setattr(flashinfer, "get_kv_cache_layout", lambda: layout)
+    monkeypatch.setattr(
+        flashinfer, "BatchPrefillWithPagedKVCacheWrapper", context_factory
+    )
+    monkeypatch.setattr(
+        flashinfer, "BatchPrefillWithRaggedKVCacheWrapper", ragged_factory
+    )
+    monkeypatch.setattr(
+        flashinfer,
+        "get_dcp_group",
+        lambda: SimpleNamespace(all_gather=lambda x, dim: x),
+    )
+    monkeypatch.setattr(
+        flashinfer, "cp_lse_ag_out_rs", lambda output, lse, *a, **kw: (output, lse)
+    )
+    wrapper = flashinfer.BatchDCPPrefillWrapper()
+    context_factory.assert_called_once_with(None, layout)
+    ragged_factory.assert_called_once_with(None, "NHD")
+
+    context = torch.zeros((2, 2, 128), dtype=torch.float16, device="cuda")
+    query = torch.ones_like(context)
+    # First token: equal normalizers. Second token: context has four times
+    # the query's normalizer, so the merged output must be 1 / (4 + 1).
+    context_lse = torch.tensor([[0, 0], [2, 2]], dtype=torch.float32, device="cuda")
+    query_lse = torch.zeros_like(context_lse)
+    wrapper._context.run.return_value = context, context_lse
+    wrapper._new_tokens.run.return_value = query, query_lse
+    output = torch.empty_like(query)
+    wrapper.run(
+        SimpleNamespace(_k_scale_float=1.0, _v_scale_float=1.0),
+        query,
+        torch.empty(0, device="cuda"),
+        query,
+        query,
+        output,
+    )
+    expected = torch.empty_like(output)
+    expected[0] = 0.5
+    expected[1] = 0.2
+    torch.testing.assert_close(output, expected, atol=1e-3, rtol=0)
