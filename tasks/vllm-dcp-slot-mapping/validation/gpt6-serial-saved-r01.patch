+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+from vllm.utils.math_utils import cdiv
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+pytestmark = pytest.mark.skipif(not current_platform.is_cuda(), reason="Requires CUDA")
+
+
+@pytest.mark.parametrize("dcp_size,rank", [(1, 0), (2, 0), (2, 1)])
+@pytest.mark.parametrize("interleave", [1, 2, 16])
+def test_slot_mapping_batch_changes(dcp_size, rank, interleave):
+    device = torch.device("cuda:0")
+    block_sizes = [16, 32]
+    tables = BlockTables(
+        block_sizes,
+        4,
+        256,
+        193,
+        device,
+        dcp_world_size=dcp_size,
+        dcp_rank=rank,
+        cp_kv_cache_interleave_size=interleave,
+    )
+    blocks = {}
+    for req in [0, 2, 3]:
+        blocks[req] = tuple(
+            [100 * req + 10 * g + b + 1 for b in range(cdiv(193, bs * dcp_size))]
+            for g, bs in enumerate(block_sizes)
+        )
+        tables.append_block_ids(req, blocks[req], overwrite=True)
+    tables.apply_staged_writes()
+
+    def check(reqs, positions):
+        mapping = torch.tensor(reqs, dtype=torch.int32, device=device)
+        starts = [0]
+        for pos in positions:
+            starts.append(starts[-1] + len(pos))
+        flat_pos = [p for row in positions for p in row]
+        gathered = tables.gather_block_tables(mapping)
+        for group in range(2):
+            for row, req in enumerate(reqs):
+                assert gathered[group][row].tolist() == blocks[req][group]
+        slots = tables.compute_slot_mappings(
+            mapping,
+            torch.tensor(starts, dtype=torch.int32, device=device),
+            torch.tensor(flat_pos, dtype=torch.int64, device=device),
+        )
+        for group, bs in enumerate(block_sizes):
+            expected = []
+            for req, row in zip(reqs, positions):
+                for p in row:
+                    if p // interleave % dcp_size != rank:
+                        expected.append(-1)
+                    else:
+                        local_pos = (
+                            p // (interleave * dcp_size) * interleave + p % interleave
+                        )
+                        expected.append(
+                            blocks[req][group][local_pos // bs] * bs + local_pos % bs
+                        )
+            assert slots[group].tolist() == expected
+        assert (tables.slot_mappings[:, len(flat_pos) :] == -1).all()
+
+    # Prefill across multiple virtual blocks, then reorder and shrink the batch.
+    check([2, 0, 3], [list(range(67)), list(range(33)), list(range(49))])
+    check([3, 2], [[63, 64, 65], [127, 128, 129]])
+    # Reuse a finished request's row and append a new block to a surviving row.
+    blocks[0] = tuple([b + 500 for b in group] for group in blocks[0])
+    tables.append_block_ids(0, blocks[0], overwrite=True)
+    for g in range(2):
+        tables.num_blocks.np[g, 2] = len(blocks[2][g]) - 1
+    tables.append_block_ids(
+        2, tuple([group[-1]] for group in blocks[2]), overwrite=False
+    )
+    tables.apply_staged_writes()
+    check([2, 0], [[191, 192], list(range(35))])
