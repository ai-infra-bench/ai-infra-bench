+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline DCP regression: batch churn, chunked prefill, and cache boundaries.
+
+Run with two CUDA GPUs. VLLM_TEST_DCP_MODEL can select an existing tiny Qwen3
+checkpoint; otherwise the fixture creates a deterministic random-weight model.
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+
+
+def _run(model, backend, layout, eager, dcp, v2, output):
+    env = dict(
+        os.environ,
+        VLLM_USE_V2_MODEL_RUNNER=str(int(v2)),
+        VLLM_KV_CACHE_LAYOUT=layout,
+    )
+    args = [str(model), backend, str(int(eager)), str(dcp), str(output)]
+    with output.with_suffix(".log").open("w") as log:
+        result = subprocess.run(
+            [sys.executable, __file__, *args],
+            env=env,
+            stdout=log,
+            stderr=subprocess.STDOUT,
+            timeout=300,
+        )
+    assert result.returncode == 0, output.with_suffix(".log").read_text()
+    return json.loads(output.read_text())
+
+
+@pytest.fixture(scope="module")
+def model_path(tmp_path_factory):
+    if not current_platform.is_cuda() or torch.cuda.device_count() < 2:
+        pytest.skip("Requires two CUDA GPUs")
+    if model := os.environ.get("VLLM_TEST_DCP_MODEL"):
+        return Path(model)
+    from transformers import Qwen3Config, Qwen3ForCausalLM
+
+    path = tmp_path_factory.mktemp("dcp-model")
+    config = Qwen3Config(
+        vocab_size=256,
+        hidden_size=512,
+        intermediate_size=1024,
+        num_hidden_layers=2,
+        num_attention_heads=4,
+        num_key_value_heads=1,
+        head_dim=128,
+        max_position_embeddings=512,
+        tie_word_embeddings=False,
+    )
+    with torch.random.fork_rng(devices=[]):
+        torch.manual_seed(0)
+        Qwen3ForCausalLM(config).half().save_pretrained(path)
+    return path
+
+
+@pytest.fixture(scope="module")
+def reference(model_path, tmp_path_factory):
+    # Original runner without DCP provides an independent cache/attention oracle.
+    return _run(
+        model_path,
+        "FLASH_ATTN",
+        "NHD",
+        True,
+        1,
+        False,
+        tmp_path_factory.mktemp("dcp-reference") / "outputs.json",
+    )
+
+
+@pytest.mark.parametrize("backend", ["FLASH_ATTN", "FLASHINFER"])
+@pytest.mark.parametrize("layout", ["NHD", "HND"])
+@pytest.mark.parametrize("eager", [True, False])
+def test_dcp_v2(model_path, reference, tmp_path, backend, layout, eager):
+    result = _run(
+        model_path, backend, layout, eager, 2, True, tmp_path / "outputs.json"
+    )
+    _assert_outputs(result, reference)
+
+
+@pytest.mark.parametrize("backend", ["FLASH_ATTN", "FLASHINFER"])
+def test_v2_without_dcp(model_path, reference, tmp_path, backend):
+    result = _run(
+        model_path, backend, "NHD", False, 1, True, tmp_path / "outputs.json"
+    )
+    _assert_outputs(result, reference)
+
+
+def _assert_outputs(result, reference):
+    assert result.keys() == reference.keys()
+    for req_id in reference:
+        assert result[req_id]["tokens"] == reference[req_id]["tokens"]
+        torch.testing.assert_close(
+            torch.tensor(result[req_id]["logprobs"]),
+            torch.tensor(reference[req_id]["logprobs"]),
+            atol=2e-2,
+            rtol=0,
+        )
+
+
+def _generate(model, backend, eager, dcp, output):
+    from vllm import LLM, SamplingParams
+
+    llm = LLM(
+        model=model,
+        skip_tokenizer_init=True,
+        tensor_parallel_size=2,
+        decode_context_parallel_size=int(dcp),
+        cp_kv_cache_interleave_size=2,
+        dtype="float16",
+        max_model_len=256,
+        max_num_seqs=4,
+        max_num_batched_tokens=64,
+        block_size=16,
+        gpu_memory_utilization=0.1,
+        kv_cache_memory_bytes=16 * 1024 * 1024,
+        enable_prefix_caching=False,
+        enforce_eager=bool(int(eager)),
+        async_scheduling=True,
+        attention_config={
+            "backend": backend,
+            "flash_attn_max_num_splits_for_cuda_graph": 1,
+        },
+        compilation_config={
+            "mode": 0,
+            "cudagraph_mode": "FULL_DECODE_ONLY",
+            "cudagraph_capture_sizes": [1, 2, 4],
+        },
+    )
+    engine = llm.llm_engine
+    results = {}
+
+    def add(req_id, prompt_len, output_len):
+        engine.add_request(
+            req_id,
+            {
+                "prompt_token_ids": [
+                    (i * 13 + prompt_len) % 250 + 3 for i in range(prompt_len)
+                ]
+            },
+            SamplingParams(
+                temperature=0, max_tokens=output_len, ignore_eos=True, logprobs=5
+            ),
+        )
+
+    # Three decodes pad to a graph of four. Long generation crosses several
+    # physical and virtual block boundaries (16 and 32 tokens respectively).
+    add("short", 17, 5)
+    add("long", 61, 70)
+    add("middle", 29, 25)
+    added = False
+    while engine.has_unfinished_requests():
+        for request in engine.step():
+            if not request.finished:
+                continue
+            completion = request.outputs[0]
+            results[request.request_id] = {
+                "tokens": completion.token_ids,
+                "logprobs": [
+                    p[t].logprob
+                    for t, p in zip(completion.token_ids, completion.logprobs)
+                ],
+            }
+            if request.request_id == "short" and not added:
+                # The freed row is reused while the remaining requests decode.
+                add("new", 35, 40)
+                added = True
+    Path(output).write_text(json.dumps(results))
+
+
+if __name__ == "__main__":
+    _generate(*sys.argv[1:])
