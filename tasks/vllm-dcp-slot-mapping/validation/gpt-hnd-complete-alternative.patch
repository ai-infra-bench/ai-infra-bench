new file mode 100644
index 0000000000..a3c5958686
--- /dev/null
+++ b/tests/v1/attention/test_flashinfer_dcp.py
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+
+flashinfer = pytest.importorskip("vllm.v1.attention.backends.flashinfer")
+
+
+def test_dcp_prefill_uses_token_major_layout_for_ragged_kv(monkeypatch) -> None:
+    layouts = {}
+
+    def make_paged_wrapper(_workspace, layout):
+        layouts["paged"] = layout
+        return object()
+
+    def make_ragged_wrapper(_workspace, layout):
+        layouts["ragged"] = layout
+        return object()
+
+    monkeypatch.setattr(flashinfer, "get_kv_cache_layout", lambda: "HND")
+    monkeypatch.setattr(
+        flashinfer, "BatchPrefillWithPagedKVCacheWrapper", make_paged_wrapper
+    )
+    monkeypatch.setattr(
+        flashinfer, "BatchPrefillWithRaggedKVCacheWrapper", make_ragged_wrapper
+    )
+
+    flashinfer.BatchDCPPrefillWrapper()
+
+    assert layouts == {"paged": "HND", "ragged": "NHD"}
