diff --git a/tests/v1/worker/test_gpu_v2_block_table.py b/tests/v1/worker/test_gpu_v2_block_table.py
new file mode 100644
index 0000000000..36c9ce8ec7
--- /dev/null
+++ b/tests/v1/worker/test_gpu_v2_block_table.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="Requires CUDA")
+
+
+@pytest.mark.parametrize("dcp_rank", [0, 1])
+def test_dcp_slot_mapping(dcp_rank: int) -> None:
+    block_size = 16
+    dcp_world_size = 2
+    interleave_size = 2
+    block_ids = [10, 20, 30]
+    device = torch.device("cuda")
+
+    block_tables = BlockTables(
+        block_sizes=[block_size],
+        max_num_reqs=2,
+        max_num_batched_tokens=96,
+        max_model_len=96,
+        device=device,
+        dcp_world_size=dcp_world_size,
+        dcp_rank=dcp_rank,
+        cp_kv_cache_interleave_size=interleave_size,
+    )
+    block_tables.append_block_ids(0, (block_ids,), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    positions = torch.arange(96, dtype=torch.int64, device=device)
+    slot_mapping = block_tables.compute_slot_mappings(
+        idx_mapping=torch.tensor([0], dtype=torch.int32, device=device),
+        query_start_loc=torch.tensor([0, 96], dtype=torch.int32, device=device),
+        positions=positions,
+    )[0]
+
+    expected = []
+    virtual_block_size = block_size * dcp_world_size
+    for position in range(96):
+        virtual_offset = position % virtual_block_size
+        owner = virtual_offset // interleave_size % dcp_world_size
+        if owner != dcp_rank:
+            expected.append(PAD_SLOT_ID)
+            continue
+        local_offset = (
+            virtual_offset // (dcp_world_size * interleave_size) * interleave_size
+            + virtual_offset % interleave_size
+        )
+        expected.append(
+            block_ids[position // virtual_block_size] * block_size + local_offset
+        )
+
+    torch.testing.assert_close(
+        slot_mapping.cpu(), torch.tensor(expected, dtype=torch.int64)
+    )
+
+
+def test_non_dcp_slot_mapping_unchanged() -> None:
+    block_size = 16
+    block_ids = [3, 7, 11]
+    device = torch.device("cuda")
+    block_tables = BlockTables(
+        block_sizes=[block_size],
+        max_num_reqs=1,
+        max_num_batched_tokens=48,
+        max_model_len=48,
+        device=device,
+    )
+    block_tables.append_block_ids(0, (block_ids,), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    positions = torch.arange(48, dtype=torch.int64, device=device)
+    slot_mapping = block_tables.compute_slot_mappings(
+        idx_mapping=torch.tensor([0], dtype=torch.int32, device=device),
+        query_start_loc=torch.tensor([0, 48], dtype=torch.int32, device=device),
+        positions=positions,
+    )[0]
+    expected = torch.cat(
+        [
+            torch.arange(block_id * block_size, (block_id + 1) * block_size)
+            for block_id in block_ids
+        ]
+    )
+    torch.testing.assert_close(slot_mapping.cpu(), expected)
