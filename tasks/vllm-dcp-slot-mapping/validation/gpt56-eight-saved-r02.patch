+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("dcp_rank", [0, 1])
+def test_dcp_slot_mappings_cross_virtual_block(dcp_rank: int) -> None:
+    block_size = 16
+    dcp_world_size = 2
+    interleave_size = 2
+    block_ids = [3, 7]
+    num_positions = 40
+
+    block_tables = BlockTables(
+        block_sizes=[block_size],
+        max_num_reqs=1,
+        max_num_batched_tokens=num_positions,
+        max_model_len=64,
+        device=torch.device("cuda"),
+        dcp_world_size=dcp_world_size,
+        dcp_rank=dcp_rank,
+        cp_kv_cache_interleave_size=interleave_size,
+    )
+    block_tables.append_block_ids(0, (block_ids,), overwrite=True)
+    block_tables.apply_staged_writes()
+
+    idx_mapping = torch.tensor([0], dtype=torch.int32, device="cuda")
+    query_start_loc = torch.tensor(
+        [0, num_positions], dtype=torch.int32, device="cuda"
+    )
+    positions = torch.arange(num_positions, dtype=torch.int64, device="cuda")
+    actual = block_tables.compute_slot_mappings(
+        idx_mapping, query_start_loc, positions
+    )[0]
+
+    expected = []
+    virtual_block_size = block_size * dcp_world_size
+    for position in range(num_positions):
+        virtual_offset = position % virtual_block_size
+        owning_rank = (virtual_offset // interleave_size) % dcp_world_size
+        if owning_rank != dcp_rank:
+            expected.append(-1)
+            continue
+        local_offset = (
+            virtual_offset // (dcp_world_size * interleave_size) * interleave_size
+            + virtual_offset % interleave_size
+        )
+        block_id = block_ids[position // virtual_block_size]
+        expected.append(block_id * block_size + local_offset)
+
+    torch.testing.assert_close(actual.cpu(), torch.tensor(expected))
