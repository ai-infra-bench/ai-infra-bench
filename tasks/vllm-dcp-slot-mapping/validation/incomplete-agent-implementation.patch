@@ -529,6 +529,77 @@ class FlashAttentionMetadataBuilder(AttentionMetadataBuilder[FlashAttentionMetad
         new_metadata = copy.copy(metadata)
         new_metadata.block_table = blk_table
         new_metadata.slot_mapping = slot_mapping
+
+        # For DCP: recompute context KV lengths as seq_lens may have grown
+        # during successive decode steps (CUDA graph replay).
+        if self.dcp_world_size > 1 and metadata.dcp_context_kv_lens is not None:
+            # Extract current seq_lens from metadata (these reflect the current step)
+            seq_lens = metadata.seq_lens
+            num_reqs = seq_lens.shape[0]
+
+            # Compute query lengths from query_start_loc
+            query_start_loc = metadata.query_start_loc
+            query_kv_lens = query_start_loc[1:num_reqs+1] - query_start_loc[:num_reqs]
+
+            # Context length = total seq_len - new query tokens
+            dcp_context_kv_lens = seq_lens[:num_reqs] - query_kv_lens
+
+            # Distribute context across DCP ranks
+            dcp_context_kv_lens = get_dcp_local_seq_lens(
+                dcp_context_kv_lens,
+                self.dcp_world_size,
+                self.dcp_rank,
+                self.cp_kv_cache_interleave_size,
+            )
+
+            # Recompute max_dcp_context_kv_len
+            # ceil(L / (N * I)) * I where L is max_seq_len, N is dcp_world_size
+            num_partitions = self.dcp_world_size * self.cp_kv_cache_interleave_size
+            max_seq_len = metadata.max_seq_len
+            max_dcp_context_kv_len = (
+                (max_seq_len + num_partitions - 1) // num_partitions
+            ) * self.cp_kv_cache_interleave_size
+
+            new_metadata.dcp_context_kv_lens = dcp_context_kv_lens
+            new_metadata.max_dcp_context_kv_len = max_dcp_context_kv_len
+
+            # For FA3 with CUDA graphs: recompute scheduler_metadata with updated
+            # dcp_context_kv_lens. The scheduler_metadata tensor is pre-allocated
+            # and reused, so we update it in-place.
+            if self.aot_schedule and metadata.scheduler_metadata is not None:
+                cache_dtype = self.cache_config.cache_dtype
+                if cache_dtype.startswith("fp8"):
+                    qkv_dtype = FlashAttentionBackend.get_fp8_dtype_for_flashattn(
+                        cache_dtype
+                    )
+                else:
+                    qkv_dtype = self.kv_cache_dtype
+
+                scheduler_metadata = get_scheduler_metadata(
+                    batch_size=num_reqs,
+                    max_seqlen_q=metadata.max_query_len,
+                    max_seqlen_k=max_dcp_context_kv_len,
+                    num_heads_q=self.num_heads_q * self.dcp_world_size,
+                    num_heads_kv=self.num_heads_kv,
+                    headdim=self.headdim,
+                    cache_seqlens=dcp_context_kv_lens,
+                    qkv_dtype=qkv_dtype,
+                    cu_seqlens_q=query_start_loc,
+                    page_size=self.block_size,
+                    causal=False,
+                    window_size=self.aot_sliding_window,
+                    num_splits=self.max_num_splits,
+                )
+
+                # Update the pre-allocated scheduler_metadata buffer
+                if self.use_full_cuda_graph:
+                    n = scheduler_metadata.shape[0]
+                    self.scheduler_metadata[:n] = scheduler_metadata
+                    self.scheduler_metadata[n:] = 0
+                    new_metadata.scheduler_metadata = self.scheduler_metadata[:n]
+                else:
+                    new_metadata.scheduler_metadata = scheduler_metadata
+
         return new_metadata
 
